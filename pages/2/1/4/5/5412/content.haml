          #SliceOfPresheavesIsPresheavesOnSlice.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/slice+of+presheaves+is+presheaves+on+slice"}> slice of presheaves is presheaves on slice
                )
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    e \;\colon\;
                    PSh(C/c)
                    \\xrightarrow{\;\;\simeq\;\;}
                    PSh(C)/Y(c)
                    \\,.
          %p
            (
            %a{:href => "#SGA41"}> SGA4 I, Ex. 1 Prop. 5.11
            ,
            = succeed ";" do
              %a{:href => "http://www.cmls.polytechnique.fr/perso/laszlo/sga4/SGA4-1/sga41.pdf#page=27"} p. 27
            = succeed "," do
              %a{:href => "#KS06"} Kashiwara-Schapira 2006, Lemma 1.4.12
            = succeed ")" do
              %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/kashiwara2.pdf#page=26"} p. 26
          .proof
            %h6#proof_3 Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              to the presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F'
                    \\,\colon\,
                    d
                    \\;\mapsto\;
                    \\underset{
                    f \in C(d,c)
                    }{\sqcup}
                    F(f)
            %p
              which is equipped with the natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi F
                    %mo ′
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta : F' \to Y(c)
              with component map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi η
                              %mi d
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi f
                                %mo ∈
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi d
                                %mo ,
                                %mi c
                                %mo{:stretchy => "false"} )
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi θ
                            %mo ∈
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi f
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\eta_d
                    \&amp;
                    \\colon
                    \&amp;
                    \\underset
                    {f \in C(d,c)}
                    {\sqcup }
                    F(f)
                    \&amp;
                    \\longrightarrow
                    \&amp;
                    C(d,c)
                    \\\
                    \&amp;&amp;
                    \\theta \in F(f)
                    \&amp;\mapsto&amp;
                    f
                    \\,.
                    }
            %p
              One readily checks (for more details see
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/slice+of+presheaves+is+presheaves+on+slice"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is given by the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi e
                      %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\bar e \;\colon\; PSh(C)/Y(c) \to PSh(C/c)
            %p
              which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi F
                    %mo ′
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta \,\colon\, F' \to Y(c)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mo →
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; (f \,\colon\, d \to c) \mapsto F'(d)|_c
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi c
                  %annotation{:encoding => "application/x-tex"} F'(d)|_c
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                        %mtr
                          %mtd
                            %mi pt
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F'(d)|_c &amp;\to&amp; F'(d)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\eta_d}
                    \\\
                    pt &amp;\stackrel{f}{\to}&amp; C(d,c)
                    }
                    \\,.
          .num_lemma
            %h6#example Example
            %p
              Suppose the presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              does not actually depend on the morphisms to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F : (C/c)^{op} \to C^{op} \to Set
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F'(d) = \sqcup_{f \in C(d,c)} F(f)
                    \= \sqcup_{f \in C(d,c)} F(d)
                    \\simeq
                    C(d,c) \times F(d)
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo =
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F ' = Y(c) \times F
              with respect to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
          .num_lemma
            %h6#remark_3 Remark
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi C
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_C Y(c)
              , the
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Y(c):C^{op}\to Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_1,p_1)
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo ∈
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_1\in Y(c)(d_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              is just an arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} d_1\to c
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_1, p_1)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 2
                    %mo ,
                    %msub
                      %mi p
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_2, p_2)
              is just a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} u:d_1\to d_2
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                    %mo ∘
                    %mi u
                    %mo =
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_2\circ u =p_1
              but this is just a morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi c
                    %annotation{:encoding => "application/x-tex"} C/c
            %p
              Hence, the above Prop.
              %a.maruku-ref{:href => "#SliceOfPresheavesIsPresheavesOnSlice"}
              can be rephrased as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∫
                      %mi C
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\int_C Y(c))\simeq PSh(C)/Y(c)
              which is an instance of the following formula:
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} P:C^{op}\to Set
              be a presheaf. Then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∫
                      %mi C
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh(\int_C P) \simeq PSh(C)/P
                    \\,.
          %p
            On objects this takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mi C
                  %mi P
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F : (\int_C P)^{op} \to Set
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi p
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %msub
                    %mi Σ
                    %mrow
                      %mi p
                      %mo ∈
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i(F)(A \in C) = \{ (p,a) | p \in P(A), a \in F(A,p) \} = \Sigma_{p \in P(A)} F(A,p)
          %p
            with obvious projection to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Q
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} f : Q \to P
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi f
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} i^{-1}(f)(A, p \in P(A)) = f_A^{-1}(p)\;.
          %p
            %a{:href => "#KS06"}> Kashiwara-Schapira (2006, Lemma 1.4.12, p. 26)
            \. For a more general statement involving slices of Grothendieck toposes see
            = succeed "." do
              %a{:href => "#MacLaneMoerdijk"} Mac Lane-Moerdijk (1994, p.157)
          %p
            In particular, this equivalence shows that
            = succeed "." do
              %em slices of presheaf toposes are presheaf toposes
          %h3#GeometricMorphismBySlicing Geometric morphisms by slicing
          #SliceGeometricMorphism.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒯
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*) : \mathcal{T} \to \mathcal{E}
              a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              of toposes and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi f
                      %mo *
                    %mi X
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (f^*/X \dashv f_*/X) : \mathcal{T}/f^*X \to \mathcal{E}/X
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^*/X
              is the evident application of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              to diagrams in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .proof
            %h6#proof_4 Proof
            %p
              The slice adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^*/X \dashv f_*/X)
              is discussed
              = succeed ":" do
                %a{:href => "http://ncatlab.org/nlab/show/adjoint+(infinity%2C1)-functor#OnSlices"} here
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^*/X
              is the evident induced functor. Since
              %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#InOvercategories"} limits in an over-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
              are computed as limits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              of diagrams with a single bottom element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              adjoined,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^*/X
              preserves finite limits, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              does, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^*/X \dashv f_*/X)
              is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          %h3#Points Topos points
          %p
            We discuss
            %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} topos points
            of over-toposes.
          %p
          #points-from-pairs.num_lemma
            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mo *
                    %mo ⊣
                    %msub
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Set
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    (e^* \dashv e_*)  : Set \to \mathcal{E}
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} point
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in e^*(X)
              there is a point of the slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
              given by the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi x
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi x
                            %mo *
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi e
                            %mo *
                          %mo{:stretchy => "false"} /
                          %mi X
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi e
                            %mo *
                          %mo{:stretchy => "false"} /
                          %mi X
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (e,x)
                    \\;\colon\;
                    Set \stackrel{\overset{x^*}{\leftarrow}}{\underset{x_*}{\to}}
                    Set/e^*(X)
                    \\stackrel{\overset{e^*/X}{\leftarrow}}{\underset{e_*/X}{\to}}
                    \\mathcal{E}/X
                    \\,.
            %p
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mo *
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo ⊣
                  %msub
                    %mi e
                    %mo *
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e^*/X \dashv e_*/X)
            is the slice geometric morphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            discussed
            %a{:href => "#SliceGeometricMorphism"} above
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mo *
                  %mo ⊣
                  %msub
                    %mi x
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x^* \dashv x_*)
            is the étale geometric morphism discussed
            %a{:href => "#GeneralEtaleGeometricMorphism"} above
            induced from the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo →
                      %mi x
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} * \stackrel{x}{\to} e^*(X)
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e,x)
            sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \to X
            to the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi e
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e^*(A) \to e^*(X)
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .num_prop
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
              then so does the slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
              for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
          .proof
            %h6#proof_5 Proof
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has enough points means that a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              precisely if for every
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi Set
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} e : Set \to \mathcal{E}
              the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e^*(f) : e^*(A) \to e^*(B)
              is an isomorphism.
            %p A morphism in the slice topos, given by a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;&amp;\stackrel{f}{\to}&amp;&amp; B
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; X
                    }
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is an isomorphism precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is. By the above observation we have that under the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi x
                    %mo ∈
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,x \in e^*(X))
              this maps to the fibers of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi e
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mi e
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi e
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    e^*(A) &amp;&amp;\stackrel{e^*(f)}{\to}&amp;&amp; e^*(B)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; e^*(X)
                    }
            %p
              over all points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mover
                        %mo →
                        %mi x
                      %msup
                        %mi e
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} * \stackrel{x}{\to} e^*(X)
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of the point indexed over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≃
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi S
                    %mo *
                  %annotation{:encoding => "application/x-tex"} S \simeq \coprod_S *
              and using
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^* e^*(f)
              is an isomorphism for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in e^*(X)
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e^*(f)
              was already an isomorphism.
            %p
              The claim then follows with the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has enough points.
          %p
            It turns out that all points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
            correspond to pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e,x)
            as above, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            a
            %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} point
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi e
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \in e^*(X)
            an element. More precisely:
          .num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %a.existingWikiWord{:href => "/nlab/show/point"} points
              of the over-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
              is equivalent to the category with: as objects the pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,x)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              a
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi e
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in e^*(X)
              an element; and as morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ′
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,x) \to (e',x')
              the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msup
                      %mi e
                      %mo *
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \eta : e^* \to (e')^*
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \eta_X(x) = x'
          %p
            This is
            = succeed "," do
              %a{:href => "#SGA41"} SGA4 (1972, Exposé IV, Proposition 5.12, p. 382)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} E' = Set
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+transformation"} geometric transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo →
                  %mi e
                  %mo ′
                %annotation{:encoding => "application/x-tex"} e \to e'
            is a natural transformation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mo *
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} e^* \to (e')^*
            = succeed "." do
              %a{:href => "#SGA41"} SGA4 (1972, Exposé IV, 3.2, p. 328)
          %p
            The point corresponding the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
