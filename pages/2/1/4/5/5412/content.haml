          .proof
            %h6#proof_2 Proof
            %p
              By
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/universal+colimit"} universal colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves both
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              and using that the over-toposes are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              follows from the universality of the pullback: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
