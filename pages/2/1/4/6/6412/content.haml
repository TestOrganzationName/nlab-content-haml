                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a_n \in \{0, 1, \ldots, p-1\}
            %a.existingWikiWord{:href => "/nlab/show/carrying"} carrying
