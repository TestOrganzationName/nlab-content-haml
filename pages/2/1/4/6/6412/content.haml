            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                %annotation{:encoding => "application/x-tex"} x\in \mathbf{Q}_p
            that they can be uniquely written in the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
