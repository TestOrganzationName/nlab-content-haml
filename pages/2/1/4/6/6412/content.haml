          %p
            The distance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            satisfies the “ultrametric” inequality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi sup
                  %mo{:stretchy => "false"} {
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  d(x,z) \leq sup\{d(x,y),d(y,z)\}
          %p
            Concretely, a
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            may be written as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                    %msub
                      %mi a
                      %mi n
                    %msup
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sum_{n \geq k} a_n p^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            occurring. If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \lt 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi …
                  %msub
                    %mi a
                    %mn 1
                  %msub
                    %mi a
                    %mn 0
                  %mo .
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi …
                  %msub
                    %mi a
                    %mi k
                %annotation{:encoding => "application/x-tex"} x = \ldots a_1 a_0.a_{-1} \ldots a_k
          %p with finitely many terms to the “right” of the “decimal” point. Again such expressions are added and multiplied with carrying as in ordinary arithmetic.
          %h2#properties Properties
          %h3#basic_properties Basic properties
          #InvertiblepAdic.num_prop
            %h6#proposition Proposition
            %p
              An element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} x\in \mathbb{Z}_p
              is invertible precisely if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x_0 \neq 0
          %h3#as_a_field_completion As a field completion
          %p
            %a.existingWikiWord{:href => "/nlab/show/Ostrowski%27s+theorem"} Ostrowski's theorem
            implies there are precisely two kinds of
            %a.existingWikiWord{:href => "/nlab/show/complete+field"} completions
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            and the
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Ostrowski%27s+theorem"}> Ostrowski's theorem
                )
            %p
              Any non-trivial
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              on the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              is equivalent either to the standard real absolute value, or to the
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %h3#Disconnectedness Topological disconnectedness and G-topology
          %p
            While the
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+norm"} p-adic norm
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            is exotic:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_p
            is a locally compact, Hausdorff,
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected topological space
          %p
            For that reason the naive idea of formulating
            %a.existingWikiWord{:href => "/nlab/show/p-adic+geometry"} p-adic geometry
            in analogy to
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            as modeled on domains in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℚ
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_p^n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
          %p
            Instead there is (
            %a{:href => "#Tate71"}> Tate 71
            ) a suitable
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            on such
            %a.existingWikiWord{:href => "/nlab/show/affinoid+domains"} affinoid domains
            – the
            %em
              %a.existingWikiWord{:href => "/nlab/show/G-topology"} G-topology
            – with respect to which there is a good theory of
            %a.existingWikiWord{:href => "/nlab/show/non-archimedean+analytic+geometry"} non-archimedean analytic geometry
            (“
            %a.existingWikiWord{:href => "/nlab/show/rigid+analytic+geometry"}> rigid analytic geometry
            ”) and hence in particular of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+geometry"} p-adic geometry
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which
            %em is
            well behaved (in particular locally connected and even locally contractible), this is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            construction. The resulting topological space is equipped with covers by
            %a.existingWikiWord{:href => "/nlab/show/affinoid+domain"} affinoid domain
            under the
            %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            are called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Berkovich+spaces"} Berkovich spaces
          %h3#pontryagin_duality Pontryagin duality
          %p
            Earlier we observed that as an additive compact Hausdorff
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mi p
                  %mo =
                  %msub
                    %mi lim
                    %mrow
                      %mo ←
                      %mi n
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Z}_p = \lim_{\leftarrow n} \mathbb{Z}/(p^n)
            is
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+duality"} dual
            to the discrete
            %a.existingWikiWord{:href => "/nlab/show/Pruefer+group"} Prüfer group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbf{Z}(p^\infty) \coloneqq \mathbb{Z}[1/p]/\mathbb{Z}
            that is isomorphic to a direct limit of finite cyclic groups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mrow
                        %mo →
                        %mi n
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lim_{\to n} \mathbb{Z}/(p^n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p] \to \mathbf{Q}_p
            induces an isomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                      %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}(p^\infty) \to \mathbf{Q}_p/\mathbf{Z}_p
            = succeed "-modules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}_p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mi p
                  %mover
                    %mo ↪
                    %mi i
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                  %mover
                    %mo →
                    %mi q
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} 0 \to \mathbf{Z}_p \stackrel{i}{\hookrightarrow} \mathbf{Q}_p \stackrel{q}{\to} \mathbf{Z}(p^\infty) \to 0.
          %p
            This exact sequence is Pontrjagin self-dual in the sense that the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                  %mo →
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                    %mo ∧
                %annotation{:encoding => "application/x-tex"} \mathbf{Q}_p \to \mathbf{Q}_p^\wedge
            induced from the pairing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                  %mo ×
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                  %mover
                    %mo →
                    %mi mult
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mi p
                  %mover
                    %mo →
                    %mi q
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo ↪
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbf{Q}_p \times \mathbf{Q}_p \stackrel{mult}{\to} \mathbf{Q}_p \stackrel{q}{\to} \mathbb{Z}[1/p]/\mathbb{Z} \hookrightarrow \mathbb{R}/\mathbb{Z}
          %p fits into an isomorphism of exact sequences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Z
                            %mi p
                        %mtd
                          %mover
                            %mo →
                            %mi i
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                            %mi p
                        %mtd
                          %mover
                            %mo →
                            %mi q
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Z
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi p
                            %mn ∞
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Z
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi p
                            %mn ∞
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo ∧
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi q
                                %mo ∧
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                            %mi p
                            %mo ∧
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi i
                                %mo ∧
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Z
                            %mi p
                            %mo ∧
                        %mtd
                          %mo →
                        %mtd
                          %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  0 &amp; \to &amp; \mathbf{Z}_p &amp; \stackrel{i}{\to} &amp; \mathbf{Q}_p &amp; \stackrel{q}{\to} &amp; \mathbf{Z}(p^\infty) &amp; \to &amp; 0 \\
                  \&amp; &amp; \downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow &amp; &amp; \\
                  0 &amp; \to &amp; \mathbf{Z}(p^\infty)^\wedge &amp; \stackrel{q^\wedge}{\to} &amp; \mathbf{Q}_p^\wedge &amp; \stackrel{i^\wedge}{\to} &amp; \mathbf{Z}_p^\wedge &amp; \to &amp; 0
                  }
          %p
            where the commutativity of the squares can be traced to the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is a
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}_p
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+duality"} Pontrjagin duality
            %a.existingWikiWord{:href => "/nlab/show/short+five+lemma"} short five lemma
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
          %p
            This self-duality figures in Tate’s thesis; for more, see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
          %h3#function_field_analogy Function field analogy
