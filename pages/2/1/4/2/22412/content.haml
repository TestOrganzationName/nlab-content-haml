            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CSyn
                %annotation{:encoding => "application/x-tex"} CSyn
            and an associated tangent/cotangent program that is a morphism in
            = succeed "/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
