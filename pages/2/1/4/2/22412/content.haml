                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} L:C^{op}\to Cat
            satisfying these conditions a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
