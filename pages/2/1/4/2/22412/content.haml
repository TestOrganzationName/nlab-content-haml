              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T^* R'
              (the cotangent bundle of
