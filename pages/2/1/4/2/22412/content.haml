            %a.existingWikiWord{:href => "/nlab/show/linear+dependent+type+theory"} linear dependent type theory
            over the Cartesian type theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CSyn
                  %annotation{:encoding => "application/x-tex"} CSyn
          %p
            Indeed, as for any
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} S'
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} L:C^{op}\to Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi C
                  %mi L
                %annotation{:encoding => "application/x-tex"} \Sigma_C L
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi C
                  %msup
                    %mi L
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Sigma_C L^{op}
            are
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi CSyn
                  %mi LSyn
                %annotation{:encoding => "application/x-tex"} \Sigma_{CSyn} LSyn
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi CSyn
                  %msup
                    %mi LSyn
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Sigma_{CSyn} LSyn^{op}
            are, in particular,
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Syn
                %annotation{:encoding => "application/x-tex"} Syn
            is the initial
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-categories:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %ul
            %li
              forward AD:
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Df
                      %mo :
                      %mi Syn
                      %mo →
                      %msub
                        %mi Σ
                        %mi CSyn
                      %mi LSyn
                    %annotation{:encoding => "application/x-tex"} Df:Syn\to \Sigma_{CSyn} LSyn
            %li
              reverse AD:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Dr
                      %mo :
                      %mi Syn
                      %mo →
                      %msub
                        %mi Σ
                        %mi CSyn
                      %msup
                        %mi LSyn
                        %mi op
                    %annotation{:encoding => "application/x-tex"} Dr:Syn\to \Sigma_{CSyn} LSyn^{op}
          %h3#semantics_of_the_source_and_target_languages Semantics of the source and target languages
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            and functions gives another example of an
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (if we choose the sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi R
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[R]]
            and functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi op
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[op]]
            that we would like to denote with the types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi op
                %annotation{:encoding => "application/x-tex"} op
            in the structure part of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fam
                  %mo{:stretchy => "false"} (
                  %mi CMon
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Set
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Fam(CMon):Set^{op}\to Cat
            of
            %a.existingWikiWord{:href => "/nlab/show/families"} families
            of
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
            tends to give an example of an
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} S'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Syn
                %annotation{:encoding => "application/x-tex"} Syn
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LSyn
                    %mo :
                    %msup
                      %mi CSyn
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} LSyn:CSyn^{op}\to Cat
          %ul
            %li
              the semantics of the source language: the unique
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi Syn
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} [[-]]:Syn\to Set
            %li
              the semantics of the target language: the unique
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} S'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi CSyn
                    %mo ,
                    %mi LSyn
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mi Fam
                    %mo{:stretchy => "false"} (
                    %mi CMon
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [[-]]:(CSyn,LSyn)\to (Set,Fam(CMon))
              (with a slight abuse of notation).
          %p
            In particular, we see that source language programs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi Syn
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t\in Syn(A, B)
            get interpreted as a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [[t]]\in Set([[A]], [[B]])
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi CSyn
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t\in CSyn(A, B)
            in the target language with
            %em Cartesian
            type get interpreted as a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [[t]]\in Set([[A]], [[B]])
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi LSyn
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t\in LSyn(A)(B,C)
            in the target language with
            %em linear
            type get interpreted as a function
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Fam
                    %mo{:stretchy => "false"} (
                    %mi CMon
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [[t]] \in Fam(CMon)([[A]])([[B]],[[C]])
          %h3#correctness_of_chad Correctness of CHAD
          %p
            We say that CHAD calculates the correct derivative (resp. transposed derivative) of a program
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            if the
            %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi Df
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[Df(s)]]
            of the program
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Df
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Df(s)
            (resp.
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dr
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Dr(s)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi s
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[s]]
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and the derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi s
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} T[[s]]
            (resp. transposed derivative
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi s
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} T^*[[s]]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi s
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[s]]
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
            %a.existingWikiWord{:href => "/nlab/show/positive+type"} positive type
            formers), provided that it calculates the correct (transposed) derivatives of all primitive operations like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (*)
            that we used to generate the source language. That is, CHAD is a valid way for compositionally calculating (transposed) derivatives of composite computer programs, as long as we correctly implement the derivatives for all primitive operations (basic mathematical functions like multiplication, addition, sine, cosine) in the language.
          %p
            We can prove this by a standard
            %a.existingWikiWord{:href => "/nlab/show/logical+relations"} logical relations
            argument, relating smooth curves to their primal and (co)tangent curves. Viewed more abstractly, the proof follows automatically because the
            %a.existingWikiWord{:href => "/nlab/show/Artin+gluing"} Artin gluing
            along a representable functor (like the hom out of the real numbers) of an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/differential+programming"} differential programming
            %li
              %a.existingWikiWord{:href => "/nlab/show/backpropagation"} backpropagation
          %h2#references References
          %p Forward mode automatic differentiation was introduced by Robert Edwin Wengert in
          %ul
            %li
              %span.newWikiWord>
                Robert Edwin Wengert
                %a{:href => "/nlab/new/Robert+Edwin+Wengert"} ?
              , A simple automatic derivative evaluation program. Communications of the ACM 7.8. 1964.
          %p An early description of reverse mode automatic differentiation can be found in
          %ul
            %li
              %span.newWikiWord>
                Bert Speelpenning
                %a{:href => "/nlab/new/Bert+Speelpenning"} ?
              , Compiling fast partial derivatives of functions given by algorithms. Illinois Univ., Urbana (USA). Dept. of Computer Science. Technical report. 1980.
          %p but it was already described earlier by others such as Seppo Linnainmaa:
          %ul
            %li
              %span.newWikiWord>
                Seppo Linnainmaa
                %a{:href => "/nlab/new/Seppo+Linnainmaa"} ?
              , The representation of the cumulative rounding error of an algorithm as a Taylor expansion of the local rounding errors. Master’s Thesis (in Finnish), Univ. Helsinki. 1970.
          %p A categorical analysis of (non-interleaved) forward and reverse AD (CHAD) is given by
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthijs+V%C3%A1k%C3%A1r"}> Matthijs Vákár
                , Reverse AD at Higher Types: Pure, Principled and Denotationally Correct 2021.
                %a{:href => "https://arxiv.org/abs/2007.05283"} arXiv preprint 2007.05283
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fernando+Lucatelli+Nunes"}> Fernando Lucatelli Nunes
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthijs+V%C3%A1k%C3%A1r"} Matthijs Vákár
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2110.00446"} arXiv preprint 2110.00446
                = succeed "." do
                  %a{:href => "https://www.cambridge.org/core/journals/mathematical-structures-in-computer-science/article/chad-for-expressive-total-languages/930FC0D594612D06166D836FBA596F8F?utm_campaign=shareaholic&utm_medium=copy_link&utm_source=bookmark"} Math. Struct. Comput. Sci. 33, No. 4–5, 311–426 (2023)
          %p CHAD was extended to languages featuring non-termination (and iteration) in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fernando+Lucatelli+Nunes"}> Fernando Lucatelli Nunes
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Plotkin"} Gordon Plotkin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthijs+V%C3%A1k%C3%A1r"} Matthijs Vákár
              %a{:href => "https://www.arxiv.org/abs/2505.15002"} arXiv preprint 2505.15002
          %p A categorical analysis of (interleaved) forward mode (dual numbers) AD for calculating higher order derivatives is given by
          %ul
            %li
              %span.newWikiWord>
                Mathieu Huot
                %a{:href => "/nlab/new/Mathieu+Huot"} ?
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sam+Staton"} Sam Staton
              = succeed "," do
