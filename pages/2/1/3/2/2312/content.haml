              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MultiplicativeCohomologyTheory"}
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
