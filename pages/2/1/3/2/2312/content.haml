              be a multiplicative cohomology theory, def.
              = succeed "." do
                %a.maruku-ref{:href => "#MultiplicativeCohomologyTheory"}
            %ol
              %li
                %p
                  For every space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  the
                  %a{:href => "#InternalMultiplicationOfMultiplicativeCohomologyTheory"} cup product
                  gives
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^\bullet(X)
                  the structure of a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
