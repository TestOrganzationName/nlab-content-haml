          .proof
            %h6#proof Proof
            %p
              For the first point: Since
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              are (as discussed there) stable under
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              and composition, the fiber product is a subobject. Its
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              as a
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              then implies its universal property as a
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sub
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sub_C(X)
            %p
              For the second point: by the same kind of argument, it is sufficient to show that the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                    %msub
                      %mi U
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1 \coprod_{U_1 \cap U_2} U_2 \to X
              exhibits the coproduct as a subobject.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphisms
              (as discussed there) are characterized by the fact that the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along themselves is their domain, it is sufficient to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %msub
                              %mi U
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mi Id
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %msub
                              %mi U
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %msub
                              %mi U
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_1 \coprod_{U_1 \cap U_2} U_2 &amp;\stackrel{Id}{\to}&amp;  U_1 \coprod_{U_1 \cap U_2} U_2
                    \\\
                    {}^{\mathllap{id}}\downarrow &amp;&amp; \downarrow
                    \\\
                    U_1 \coprod_{U_1 \cap U_2} U_2 &amp;\stackrel{i}{\to}&amp; X
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram. For showing this we use that in a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              we have
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                    %msub
                      %mi U
                      %mn 2
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_1 \coprod_{U_1 \cap U_2} U_2
                    \\simeq
                    (i^* U_1) \coprod_{i^* (U_1 \cap U_2)} (i^* U_2)
                    \\,.
            %p
              To see this, again use
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              to get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi U
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi U
                              %mn 1
                            %msub
                              %mo ×
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %msub
                              %mo ×
                              %mi X
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %msub
                                  %mo ×
                                  %mi X
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %msub
                              %mo ×
                              %mi X
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %msub
                              %mo ×
                              %mi X
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi U
                              %mn 1
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi U
                                  %mn 1
                                %mo ∩
                                %msub
                                  %mi U
                                  %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi U
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    i^* U_1 &amp; \simeq U_1 \times_X (U_1 \coprod_{U_1 \cap U_2} U_2)
                    \\\
                    \&amp; \simeq (U_1 \times_X U_1) \coprod_{U_1 \times_X (U_1 \cap U_2)} (U_1 \times_X U_2)
                    \\\
                    \&amp; \simeq U_1 \coprod_{U_1 \cap U_2} (U_1 \times_X U_2)
                    \\\
                    \&amp; \simeq U_1 \coprod_{U_1 \cap U_2} (U_1 \cap U_2)
                    \\\
                    \&amp; \simeq U_1
                    \\end{aligned}
            %p and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi U
                      %mn 2
                    %mo ≃
                    %msub
                      %mi U
