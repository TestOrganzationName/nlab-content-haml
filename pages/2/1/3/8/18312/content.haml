          %h2#examples Examples
          %h3#ComplexProjectiveBundleOfQuaternionicTautologicalLineBundle Complex-projective bundle of quaternionic tautological line bundle
          #ComplexProjectiveBundleOfQuaternTautologicalLineBundleIsComplexProjSpace.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
                %a.existingWikiWord{:href => "/nlab/show/projective+bundle"} projective bundle
