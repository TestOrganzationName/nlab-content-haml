                        %mo ⇝
                    %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{V}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#DeRhamComplexOfSuperDifferentialForms Super differential forms
          %p
            We discuss the super-geometric analog of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          %p
            Recall from def.
            = succeed ":" do
              %a.maruku-ref{:href => "#SuperCartesianSpace"}
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
            is the
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            of the
            %a.existingWikiWord{:href => "/nlab/show/commutative+superalgebra"} commutative superalgebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi ℝ
                    %mi q
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}^{p|q})
                  \\coloneqq
                  C^\infty(\mathbb{R}^p)\otimes_{\mathbb{R}}\wedge^\bullet \mathbb{R}^q
          %p
            in that a smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi q
                        %mn 1
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi q
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p_1|q_1}\longrightarrow \mathbb{R}^{p_2|q_2}
            is equivalently (by definition!) a superalgebra homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi q
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟵
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi q
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}^{p_1|q_1})
                  \\longleftarrow
                  C^\infty(\mathbb{R}^{p_2|q_2})
                  \\,.
          %p
            Notice then that from knowledge of an
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
            one obtains the corresponding
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            by the idea of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differentials"} Kähler differentials
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            is the
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            whose underlying
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
