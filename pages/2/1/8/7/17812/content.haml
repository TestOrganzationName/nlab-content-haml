                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} X^{\mathbb{D}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
