                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              The progression of modalities follows with Prop.
              %a.maruku-ref{:href => "#SuperSmoothSetsSystemOfAdjunctions"}
              by
              = succeed "." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ProgressionOfModalitiesOnSolidTopos"} this Prop.
            %p
              The right
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              at the first stage says that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                      %mi ∅
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n\vert q} \times \mathbb{D}_V \in
              %a.existingWikiWord{:href => "/nlab/show/SuperFormalCartSp"} SuperFormalCartSp
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ,
                    %mo ♯
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{R}^{n\vert q} \times \mathbb{D}_V, \sharp \emptyset)
                    \\simeq
                    \\emptyset
            %p
              But by the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mo ⊣
                    %mo ♯
                  %annotation{:encoding => "application/x-tex"} \flat \dashv \sharp
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              hom-isomorphism (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#eq:HomIsomorphismForAdjointFunctors"}> here
              ) and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo =
                    %mi Disc
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \flat X = Disc X(\ast)
              (by the proof of
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#CategoriesOfSheavesOnCohesiveSiteIsCohesive"} this Prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n\vert q} \times \mathbb{D}_V(\ast) \neq \emptyset
              we have indeed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ,
                    %mo ♯
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{R}^{n\vert q} \times \mathbb{D}_V, \sharp \emptyset)
                    \\simeq
                    Hom( \flat \mathbb{R}^{n\vert q} \times \mathbb{D}_V , \emptyset)
                    \=
                    \\emptyset
                    \\,.
            %p
              The left
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              at the third stage says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                    %mi ℑ
                    %mo ≃
                    %mi ℑ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rightsquigarrow \Im \simeq \Im
                    \\,.
            %p
              This means equivalenty that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SuperFormalSmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SuperFormalSmoothSet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ∈
                    %mi SuperFormalCartSp
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n\vert q} \times \mathbb{D}_V \in SuperFormalCartSp
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ,
                    %mover
                      %mrow
                        %mi ℑ
                        %mi X
                      %mo ⇝
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ×
                    %msub
                      %mi 𝔻
                      %mi V
                    %mo ,
                    %mover
                      %mrow
                        %mi ℑ
                        %mi X
                      %mrow
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{R}^{n\vert q} \times \mathbb{D}_V, \overset{\rightsquigarrow}{\Im X})
                    \\simeq
                    Hom(\mathbb{R}^{n\vert q} \times \mathbb{D}_V, \overset{}{\Im X})
            %p Again by the adjunction isomorphisms we verify:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} |
                                %mi q
                            %mo ×
                            %msub
                              %mi 𝔻
                              %mi V
                            %mo ,
                            %mover
                              %mrow
                                %mi ℑ
                                %mi X
                              %mo ⇝
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi Hom
                            %mrow
                              %mo (
                              %mover
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mrow
                                      %mi n
                                      %mo{:stretchy => "false"} |
                                      %mi q
                                  %mo ×
                                  %msub
                                    %mi 𝔻
