          #ProgressionOfIdempotentEndofunctors.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (progression of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
            %p
              We have a system of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#AdjointModality"}> this Def.
              ) and their
              %a.existingWikiWord{:href => "/nlab/show/preordering"} preordering
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#PreorderOnModalities"}> this Def.
              ) on
              %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSets"}
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ModalOperatorsEquivalentToReflectiveSubcategories"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              in Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperSmoothSetsSystemOfAdjunctions"}
            #eq:ProgressionOfModalitiesOnSuperFormalSmoothSet.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
