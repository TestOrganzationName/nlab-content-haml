                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %p
                  (
                  %a{:href => "smooth+Serre-Swan+theorem#Nestruev03"}> Nestruev 03, theorem 11.32
                  )
                %p
                  Moreover, the
                  %a.existingWikiWord{:href => "/nlab/show/modules"} modules
                  over the
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  which arise this way as
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundles"} smooth vector bundles
                  over a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  are precisely the
                  %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
                  over
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\infty(X)
                %p
                  (
                  %a{:href => "smooth+Serre-Swan+theorem#Nestruev03"}> Nestruev 03, theorem 11.32
                  )
          %p There is a third such magic algebraic property of smooth functions, which plays a role now:
          #DerivationsOfSmoothFunctions.num_defn
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"}> derivations of smooth functions are vector fields
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi der
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    der_X \;\colon\; \Gamma(T X) \longrightarrow Der(C^\infty(X))
            %p
              for the function that sends a smooth
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
              to the
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              given by forming
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi der
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} der_X(v)(f) \coloneqq v(f)
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
            %p
              Then this function is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi CAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} C^\infty(X) \in CAlg_{\mathbb{R}}
              comes from
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              along some smooth vector field, which is uniquely defined thereby.
          .proof
            %h6#proof Proof
            %p
              By the existence of
              %a.existingWikiWord{:href => "/nlab/show/partitions+of+unity"} partitions of unity
              we may restrict to the situation where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
              every
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
              may be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mi g
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f(x) = f(0) + \sum_i x_i g_i(x)
            %p
              for
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{g_i \in C^\infty(X)\}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_i(0) = \frac{\partial f}{\partial x_i}(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta : C^\infty(X) \to C^\infty(X)
              by definition satisfies the Leibniz rule, it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi i
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta(f)(0) = \sum_i \delta(x_i) \frac{\partial f}{\partial x_i}(0)
                    \\,.
            %p
              Similarly, by translation, at all other points. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is already fixed by its action of the coordinate functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mi i
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x_i \in C^\infty(X)\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                    %mo ∈
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_\delta \in T \mathbb{R}^n
              be the
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi i
                  %annotation{:encoding => "application/x-tex"}
                    v_\delta \coloneqq \sum_i \delta(x_i) \frac{\partial}{\partial x_i}
            %p
              then it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is the derivation coming from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                  %annotation{:encoding => "application/x-tex"} v_\delta
              under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_X(T X) \to Der(C^\infty(X))
          %p
            Recall further from
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+superalgebra"} geometry of physics – superalgebra
            that the category of
            %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
            is related to that of ordinary
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            by an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"} adjoint cylinder
            (
            %a{:href => "geometry+of+physics+--+superalgebra#InclusionOfCAlgIntosCAlg"}> this prop.
            ):
          #AdjointCylinderOnSuperAffines.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
                of
                %a.existingWikiWord{:href => "/nlab/show/fermionic+modality"} even fermionic
                and
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/superalgebras"} superalgebras
            %p
              The canonical inclusion of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              into
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebras
              is part of an
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#AdjointModality"}> this Def.
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ι
                      %mi op
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi CAlg
                      %mi k
                    %munderover
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AAAA
                          %msup
                            %mi ι
                            %mi op
                          %mphantom
                            %mi AAAA
                      %munder
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi even
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi odd
                          %mphantom
                            %mi AA
                    %msub
                      %mi sCAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-)_{even}
                    \\;\dashv\;
                    \\iota^{op}
                    \\;\dashv\;
                    (-)/(-)_{odd}
                    \\;\;\colon\;\;
                    CAlg_k
                    \\underoverset
                    {\underset{\phantom{AA}(-)_{even}\phantom{AA}}{\longleftarrow}}
                    {\overset{\phantom{AA}(-)/(-)_{odd}\phantom{AA}}{\longleftarrow}}
                    {\overset{\phantom{AAAA}\iota^{op}\phantom{AAAA}}{\hookrightarrow}}
                    sCAlg_k
                    \\,.
            %p
              (Here and in the following we display pairs of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (
              %a{:href => "geometry+of+physics+–+basic+notions+of+category+theory#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}> this Def.
              ) such that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              is on top and the right adjoint is on the bottom.)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#OppositeCategory"}> this Def.
              ) of this statement is that
              %a.existingWikiWord{:href => "/nlab/show/affine+superschemes"} affine superschemes
              are related to ordinary
              %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              by an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi even
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi sup
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Disc
                      %mi sup
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AAA
                          %mi ι
                          %mphantom
                            %mi AAA
                      %munder
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mi Π
                            %mi sup
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi even
                          %mphantom
                            %mi AA
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    even
                    \\;\dashv\;
                    \\iota_{sup}
                    \\;\;\colon\;\;
                    Disc_{sup}
                    Aff(Vect_k)
                    \\underoverset
                    {\underset
                    {
                    \\phantom{AA}
                    \\Pi_{sup}
