            throughout.
          #SuperDeRhamComplex.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              on a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
              is the
              = succeed "-bigraded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} |
                                %mi q
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} |
                                %mi q
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mo ⊗
                              %mi ℝ
                          %mtd
                            %msup
                              %mo ∧
                              %mo •
                            %mo{:stretchy => "false"} ⟨
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mi p
                            %mo ,
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi θ
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi θ
                              %mi q
                          %mtd
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                            %mtext bidegree:
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mi even
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi even
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi odd
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;
                    \\Omega^\bullet(\mathbb{R}^{p|q})
                    \&amp;=&amp;
                    C^\infty(\mathbb{R}^{p|q})
                    \&amp;
                    \\otimes_{\mathbb{R}}
                    \&amp;
                    \\wedge^\bullet \langle
                    \&amp;
                    \\mathbf{d}x^1, \cdots, \mathbf{d}x^p,
                    \&amp;
                    \\mathbf{d}\theta^1, \cdots, \mathbf{d}\theta^q
                    \&amp;
                    \\rangle
                    \\\
                    \\text{bidegree:}
                    \&amp;
                    \&amp;&amp;
                    (0,even)
                    \&amp;&amp;&amp;
                    (1,even)
                    \&amp;
                    (1,odd)
                    }
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is defined in degree-0 by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi f
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi p
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d} f \coloneqq \sum_{i = 1}^p \frac{\partial f}{\partial x^i} \mathbf{d}x^i
            %p and extended from there to all degree by the graded Leibniz rule.
          .num_remark
            %h6#remark_6 Remark
            %p We may write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    (n,\sigma)\in \mathbb{Z} \times \mathbb{Z}_2
            %p for elements in this bigrading group.
            %p
              In this notation the grading of the elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              is all induced by the fact that the de Rham differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}
              itself is a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
            %table
              %thead
                %tr
                  %th generator
                  %th bi-degree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} x^a
                  %td{:style => "text-align: left;"} (0,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \theta^\alpha
                  %td{:style => "text-align: left;"} (0,odd)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}
                  %td{:style => "text-align: left;"} (1,even)
            %p Here the last line means that we have
            %table
              %thead
                %tr
                  %th generator
                  %th bi-degree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} x^a
                  %td{:style => "text-align: left;"} (0,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \theta^\alpha
                  %td{:style => "text-align: left;"} (0,odd)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}x^a
                  %td{:style => "text-align: left;"} (1,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}\theta^\alpha
                  %td{:style => "text-align: left;"} (1,odd)
            %p
              The formula for the “cohomologically- and super-graded commutativity” in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∧
                    %mi β
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mi α
                        %msub
                          %mi n
                          %mi β
                        %mo +
                        %msub
                          %mi σ
                          %mi α
                        %msub
                          %mi σ
                          %mi β
                    %mspace{:width => "thickmathspace"}
                    %mi β
                    %mo ∧
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \wedge \beta
                    \=
                    \\;
                    (- 1)^{n_\alpha n_\beta + \sigma_\alpha \sigma_\beta}
                    \\;
                    \\beta \wedge \alpha
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ,
                    %mi β
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha,  \beta \in \Omega^\bullet(\mathbb{R}^{p|q})
              of homogeneous
              = succeed "-degree." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ×
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\times \mathbb{Z}_2
              %em two
              contributions to the sign picked up when exchanging two super-differential forms in the wedge product:
            %ol
              %li
                %p
                  there is a “cohomological sign” which for commuting a
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} n_1
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} n_2
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                              %msub
                                %mi n
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} (-1)^{n_1 n_2}
              %li
                %p
                  in addition there is a “super-grading” which for commuting a
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \sigma_1
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \sigma_2
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi σ
                                %mn 1
                              %msub
                                %mi σ
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} (-1)^{\sigma_1 \sigma_2}
          .num_example
            %h6#example_10 Example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
