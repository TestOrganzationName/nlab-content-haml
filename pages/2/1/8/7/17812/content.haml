                  \\\
                  \\\
                  Sh(\mathcal{C}) =  &amp; Set &amp; SmoothSet &amp; FormalSmoothSet &amp; SuperFormalSmoothSet
                  }
                  \\,.
          %p
            Moreover, by prop.
            %a.maruku-ref{:href => "#SystemOfSites"}
            these four sites form a
            %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
            of the site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SuperFormalCartSp
                %annotation{:encoding => "application/x-tex"} SuperFormalCartSp
            by consecutively smaller subsites, where each inclusion is either
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
            or
            %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
            or both. The following states that this filtration of sites extends to their categories of sheaves.
          #SuperSmoothSetsSystemOfAdjunctions.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (progression of (
                %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"}> co-
                )
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSets"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/solid+topos"} solid topos
              over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/FormalSmoothSet"} FormalSmoothSet
            %p
              There exists an essentially unique system of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between the categories of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmoothSet"}
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
              and
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSets"}
            %ol
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of consecutive
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}> this Def.
                  ), with the functor above being
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  and the functor below being
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %li
                %p
                  on
                  %a.existingWikiWord{:href => "/nlab/show/representables"} representables
                  the top two functors on the left, the top two functors in the middle, and the top three functors on the right coincide with the corresponding functors between
                  %a.existingWikiWord{:href => "/nlab/show/sites"} sites
                  shown in the first row (from prop.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#SystemOfSites"}
            %center
              %img{:src => "https://ncatlab.org/nlab/files/AjunctionsForSuperCohesion.png", :width => "600"}/
            %p In such a situation we also say that in the third row
            %ol
              %li
                %p
                  the bottom four functors exhibit
                  %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#CohesiveTopos"}> this Def.
                  )
              %li
                %p
                  the middle four functors exhibit
                  %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmoothSet"} SuperFormalSmoothSet
                  as
                  %a.existingWikiWord{:href => "/nlab/show/differentially+cohesive+topos"} differentially cohesive topos
                  (elastic topos) relative to
                  %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
                  (
                  %a{:href => "https://ncatlab.org/nlab/show/geometry+of+physics+--+categories+and+toposes#DifferentialCohesion"}> this Def.
                  );
              %li
                %p
                  the top four functors exhibit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SuperFormalSmoothSet
                      %annotation{:encoding => "application/x-tex"} SuperFormalSmoothSet
                  as
                  %em solid topos
                  relative to
                  %a.existingWikiWord{:href => "/nlab/show/FormalSmoothSet"} FormalSmoothSet
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#SuperDifferentialCohesion"}> this Def.
                  )
