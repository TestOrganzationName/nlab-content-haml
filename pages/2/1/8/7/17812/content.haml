                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi θ
                      %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\theta^\alpha (\mathbf{d}x^a) = + (\mathbf{d}x^a) \theta^\alpha
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                    %mo{:stretchy => "false"} (
