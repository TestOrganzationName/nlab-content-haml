                            %mi Hom
                            %mrow
                              %mo (
                              %mi ℜ
                              %mrow
                                %mo (
                                %mover
                                  %mrow
                                    %msup
                                      %mi ℝ
                                      %mrow
                                        %mi n
                                        %mo{:stretchy => "false"} |
                                        %mi q
                                    %mo ×
                                    %msub
                                      %mi 𝔻
