              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
            %p
              and similarly for their supergeometric version (which we turn to below, def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSets"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
