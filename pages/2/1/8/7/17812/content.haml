              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              %a{:href => "geometry+of+physics+--+smooth+sets#SmoothSetsFormACohesiveTopos"} this Prop.
              in the chapter
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} on smooth sets
            %p
