            %h6#proof_11 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im
              is a
