              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              = succeed ":" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#HomotopyLocalizationOn1Categories"} this Def.
