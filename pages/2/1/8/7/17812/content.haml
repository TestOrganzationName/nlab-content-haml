                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi i
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi i
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi V
                          %mtd
                            %mi ℑ
                            %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\coprod}V_i  &amp;\longrightarrow&amp; \underset{i \in I}{\coprod} \Im V
                    \\\
                    {}^{{\mathllap{(id_i)_{i \in I}}}}\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{(id_i)_{i \in I}}}
                    \\\
                    V &amp;\underset{\eta_V}{\longrightarrow}&amp; \Im V
                    }
                    \\,.
            %p
              But, again because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im
              preserves colimits, this is manifestly the
              = succeed "-naturality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℑ
                    %annotation{:encoding => "application/x-tex"} \Im
          #VManifold.num_defn
            %h6#definition_10 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi SuperFormalSmoothSet
                  %annotation{:encoding => "application/x-tex"} V \in SuperFormalSmoothSet
              be given (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FormalSmoothSets"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/V-manifold"} V-manifold
              is an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SuperFormalSmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SuperFormalSmoothSet
              such that there exists a
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi et
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi et
                                  %mo ,
                                  %mi epi
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U
                    \\\
                    \&amp; {}^{\mathllap{et}}\swarrow &amp;&amp; \searrow^{\mathrlap{et, epi}}
                    \\\
                    V &amp;&amp; &amp;&amp; X
                    }
            %p
              with both morphisms being
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphisms"} local diffeomorphisms
              = succeed "," do
                %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            %p
              By prop.
              %a.maruku-ref{:href => "#ProjectioonOutOfCoproductIsFormllyEtale"}
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is in particular a
              %a.existingWikiWord{:href => "/nlab/show/V-manifold"} V-manifold
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and a morphism out of the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which is a locally diffeomorphic epimorphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi V
                        %mtr
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                              %mpadded{:width => "0"}
                                %mi et
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\coprod} V
                    \\\
                    \\downarrow^{\mathrlap{et}}_{\mathrlap{epi}}
                    \\\
                    X
                    }
            %p
              Specifically if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} V = \mathbb{R}^{p\vert q}
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              under a
              %a.existingWikiWord{:href => "/nlab/show/translation+supergroup"} translation supergroup
              action. Then we say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p\vert q)
              if there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} |
                                %mi q
                        %mtr
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                              %mpadded{:width => "0"}
                                %mi et
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\coprod} \mathbb{R}^{p\vert q}
                    \\\
                    \\downarrow^{\mathrlap{et}}_{\mathrlap{epi}}
                    \\\
                    X
                    }
          .num_remark
            %h6#remark_5 Remark
            %p
              There are in general several
              %a.existingWikiWord{:href => "/nlab/show/translation+supergroup"} translation supergroup
              structures carried by a super Cartesian space. For instance in the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
              we will consider
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski
              supergroup structure which exists for special pairs
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
              %a.maruku-ref{:href => "#VManifold"}
              does not depend on the choice of group structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              (and could be ignored for much of the present purpose). But later on the choice affects for instance the concept of
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/V-manifold"} V-manifold
          #OddTangentBundle.num_example
            %h6#example_9 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/odd+tangent+bundle"}> odd tangent bundle
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              a smooth
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VManifold"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} |
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n \vert k)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \Pi E
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mo ∧
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mo •
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ∧
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(\Pi E)
                    \\;\coloneqq\;
                    \\wedge^\bullet_{C^\infty(X)} \Gamma_X(E)
                    \=
                    C^\infty(X)
                    \\;\oplus\;
                    \\Gamma_X(E^\ast)
                    \\;\oplus\;
                    \\left(\Gamma_X(E^\ast) \wedge_{C^\infty(X)} \Gamma_X(E^\ast)\right)
                    \\;\oplus\;
                    \\cdots
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              which is the
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(x)
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_X(E^\ast)
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+sections"} smooth sections
              (as in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} smooth Serre-Swan theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#FirstTwoMagicPropertiesOfAlgebrasOfSmoothFunctions"}
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^\ast
            %p
              The underlying
              %a.existingWikiWord{:href => "/nlab/show/functor+of+points"} functor of points
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \Pi E
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#ASheafAsASpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi SuperCartSp
                      %mi op
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi E \;\colon\; SuperCartSp^{op} \longrightarrow Set
            %p
              is the one that is
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by this algebra:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ↦
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi sCalg
                          %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∧
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mo •
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi E \;\colon\; \mathbb{R}^{p \vert q}
                    \\mapsto
                    Hom_{sCalg_{\mathbb{R}}}(
                    \\wedge^\bullet_{C^\infty(X)} \Gamma_X(E) , \;
                    C^\infty(\mathbb{R}^n) \otimes_{\mathbb{R}} \wedge^\bullet_{\mathbb{R}} (\mathbb{R}^q)^\ast
                    )
                    \\,.
            %p
              For instance if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E = T X
              is the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msubsup
                      %mo ∧
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mo •
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(\Pi T X)
                    \\simeq
                    \\Omega^\bullet(X)
                    \\coloneqq
                    \\wedge^\bullet_{C^\infty(X)}\Gamma_X(T^\ast X)
            %p
              is the superalgebra of smooth
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to the wedge product, with any
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mspace{:width => "thinmathspace"}
                      %mi mod
                      %mspace{:width => "thinmathspace"}
                      %mn 2
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} p \,mod\, 2 \in \mathbb{Z}/2
            %p
              This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi T X
              is often called the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/odd+tangent+bundle"} odd tangent bundle
            %p
              Notice that generally we may think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \Pi E
              as being the
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
              which is obtained from the base manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by adding an (odd-graded) infinitesimal thickening where an “infinitesimal step” away from some point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is a
              %a.existingWikiWord{:href => "/nlab/show/vector"} vector
              in the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi x
                    %annotation{:encoding => "application/x-tex"} E_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the tangent bundle, because tangent vectors precisely want to be thought of as the infinitesimal paths in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Below we see that this is not a coincidence, and discuss the formal proof that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi T X
              is the superspace of (odd-graded) infinitesimal paths in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #BosonicModalityPreservesLocalDiffeomorphism.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
                preserves
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
              = succeed "," do
                %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ⇝
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi X
                      %mo ⇝
                    %mo ⟶
                    %mover
                      %mi Y
                      %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{f}\colon \stackrel{\rightsquigarrow}{X} \longrightarrow \stackrel{\rightsquigarrow}{Y}
              under the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
          .proof
            %h6#proof_12 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#SuperSmoothSetsSystemOfAdjunctions"}
              we have equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi ℑ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ⇝
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℑ
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ⇝
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{\Im(-)}
                    \\;\simeq\;
                    \\Im(-)
                    \\;\simeq\;
                    \\Im \overset{\rightsquigarrow}{(-)}
                    \\,.
            %p
              The first of these equivalences is the “left
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              = succeed "." do
                %a.maruku-ref{:href => "#SuperSmoothSetsSystemOfAdjunctions"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              equivalence”
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi ℜ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ⇉
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℜ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightrightarrows}{\Re(-)} \;\simeq\; \Re(-)
            %p
              which follows from the progression in Prop.
              %a.maruku-ref{:href => "#SuperSmoothSetsSystemOfAdjunctions"}
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇉
                  %annotation{:encoding => "application/x-tex"} \rightrightarrows
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow
              have the same
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalSmoothset
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi ι
                            %mi sup
                      %mi SuperFormalSmoothSet
                    %annotation{:encoding => "application/x-tex"} FormalSmoothset \overset{\iota_{sup}}{\hookrightarrow} SuperFormalSmoothSet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇝
                      %mo &gt;
                      %mi ℜ
                    %annotation{:encoding => "application/x-tex"} \rightsquigarrow \gt \Re
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ProgressionOfModalitiesOnSuperFormalSmoothSet"} (1)
            %p
              Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (being a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#AdjointsPreserveCoLimits"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℑ
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; \Im X
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;(pb)&amp; \downarrow^{\mathrlap{\Im f}}
                    \\\
                    Y &amp;\longrightarrow&amp; \Im Y
                    }
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow\;\;
              yields a pullback diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi X
                              %mo ⇝
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mover
                              %mi X
                              %mo ⇝
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi f
                                  %mo ⇝
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℑ
                                  %mover
                                    %mi f
                                    %mo ⇝
                        %mtr
                          %mtd
                            %mover
                              %mi Y
