                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} \cdots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                  %annotation{:encoding => "application/x-tex"} \{
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super smooth sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \}
              \.
          %p
            By the strategy of remark
            %a.maruku-ref{:href => "#GeneralizedSpaces"}
            we now pass to generalized spaces which are locally modeled not just on plain Cartesian spaces, but also on
            %a.existingWikiWord{:href => "/nlab/show/formal+Cartesian+spaces"} formal Cartesian spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/super+formal+Cartesian+spaces"} super formal Cartesian spaces
          #FormalSmoothSets.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"}> super formal smooth sets
                )
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on the categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalCartSp
                  %annotation{:encoding => "application/x-tex"} FormalCartSp
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalCartSp"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperFormalCartSp
                  %annotation{:encoding => "application/x-tex"} SuperFormalCartSp
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalCartSp"}
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              families of any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
              (hence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo ⊕
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\mathbb{D}) = (\mathbb{R} \oplus V)
              any infinitesimally thickened superpoint) to be those of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %mi 𝔻
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                          %mo ×
                          %mi id
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i \times \mathbb{D}
                    \\overset{\phi_i \times id}{\longrightarrow}
                    \\mathbb{R}^n \times \mathbb{D}
                    \\right\}
            %p for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                      %msup
                        %mi ℝ
                        %mi n
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i
                    \\overset{\phi_i }{\longrightarrow}
                    \\mathbb{R}^n
                    \\right\}
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#SiteCartSp"}
            %p
              In analogy with def.
              %a.maruku-ref{:href => "#SmoothSet"}
              we say that
            %ol
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalCartSp
                    %annotation{:encoding => "application/x-tex"} FormalCartSp
                is a
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+set"} formal smooth set
                or
                %strong
                  formal smooth
                  %a.existingWikiWord{:href => "/nlab/show/0-type"} 0-type
                and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmoothSet
                    %mo ≔
                    %mi FormalSmoothSet
                    %mo ≔
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi FormalCartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    FormalSmoothSet \coloneqq FormalSmoothSet \coloneqq Sh(FormalCartSp)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              of all of these;
            %ol
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalCartSp
                    %annotation{:encoding => "application/x-tex"} FormalCartSp
                is a
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super formal smooth set
                or
                %strong
                  super formal smooth
                  %a.existingWikiWord{:href => "/nlab/show/0-type"} 0-type
                and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperFormalSmoothSet
                    %mo ≔
                    %mi SuperFormalSmoothSet
                    %mo ≔
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi FormalCartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SuperFormalSmoothSet \coloneqq SuperFormalSmoothSet \coloneqq Sh(FormalCartSp)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              of all of these;
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
            from def.
            %a.maruku-ref{:href => "#FormalSmoothSets"}
            is often known as the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            = succeed ")" do
              %a{:href => "Cahiers+topos#Dubuc79"} Dubuc 79
            %a.existingWikiWord{:href => "/nlab/show/Kock-Lawvere+axioms"} Kock-Lawvere axioms
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
            from def.
            %a.maruku-ref{:href => "#FormalSmoothSets"}
            was considered in
            = succeed "," do
              %a{:href => "#Yetter88"} Yetter 88
            %em super Dubuc topos
            there.
          %p
            We have now defined four sites and considered the corresponding
            %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            (noticing that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                %annotation{:encoding => "application/x-tex"} Sh(\ast) =
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi 𝒞
                          %mo =
                        %mtd
                          %mo *
                        %mtd
                          %mi CartSp
                        %mtd
                          %mi FormalCartSp
                        %mtd
                          %mi SuperFormalCartSp
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mi Set
                        %mtd
                          %mi SmoothSet
                        %mtd
                          %mi FormalSmoothSet
                        %mtd
                          %mi SuperFormalSmoothSet
                  %mspace{:width => "thinmathspace"}
