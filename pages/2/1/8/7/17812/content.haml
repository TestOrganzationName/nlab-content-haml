                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\theta^{\alpha_1} (\mathbf{d}\theta^{\alpha_2})
                    \=
                    \- (\mathbf{d}\theta^{\alpha_2}) \theta^{\alpha_1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}x^{a_1}
                    \\wedge
