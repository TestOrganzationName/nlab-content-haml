                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2109.06493"} arXiv:2109.06493
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1201/9781003090052"} doi:10.1201/9781003090052
            %li
