            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ∈
                  %mn ∞
                  %msup
                    %mi{:mathvariant => "normal"} Grpd
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Delta^1 \in \infty\mathrm{Grpd}^{\Delta^{op}}
            (regarded under
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos#A1ExhibitingCohesion"} exhibits the cohesion
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %msup
