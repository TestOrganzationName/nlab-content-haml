                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \infty\mathrm{Grpd}^{\Delta^{op}}
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                  %annotation{:encoding => "application/x-tex"} \infty\mathrm{Grpd}
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi I
                %annotation{:encoding => "application/x-tex"} \Pi_I
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta^1
          .maruku-equation
