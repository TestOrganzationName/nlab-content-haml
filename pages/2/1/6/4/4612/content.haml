          %title
          %h2#definition Definition
          %p
            A
            %strong (graded) quadratic algebra
            is an
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            which as a
            %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
            admits a presentation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≅
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi I
                %annotation{:encoding => "application/x-tex"} A \cong T(V)/I
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            of a finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of degree 1, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a ideal generated by a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊆
                  %mi V
                  %mo ⊗
                  %mi V
                %annotation{:encoding => "application/x-tex"} R \subseteq V \otimes V
            of homogeneous elements of degree 2 in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            are uniquely determined by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V = A_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the kernel of the canonical algebra map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} T(A_1) \to A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %msub
                      %mi I
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} R = I_2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, R)
          %p
            A morphism of quadratic algebras is just a morphism as graded algebras. Alternatively, a morphism of quadratic algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \to B
            determines and is determined by a linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 1
                  %mo :
                  %msub
                    %mi A
                    %mn 1
                  %mo →
                  %msub
                    %mi B
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f_1: A_1 \to B_1
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msub
                      %mi R
                      %mi B
                  %annotation{:encoding => "application/x-tex"} f_2(R_A) \subseteq R_B
          %h2#examples Examples
          %ol
            %li
              %p
                The tensor algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(V)
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                finite-dimensional) is of course quadratic.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(V)
                is quadratic.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Lambda(V)
                is quadratic.
            %li
              %p
                Extrapolating from the first three examples, a
                %a.existingWikiWord{:href => "/nlab/show/Koszul+algebra"} Koszul algebra
                is quadratic.
            %li
              %p
                For many examples of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+group"} quantum groups
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi GL
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} GL_2
            %li
              %p
                The coproduct
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo +
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A + B
                (in the category of graded algebras) of two quadratic algebras is quadratic, with generators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo +
                      %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo =
                      %msub
                        %mi A
                        %mn 1
                      %mo ⊕
                      %msub
                        %mi B
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} (A + B)_1 = A_1 \oplus B_1
                and relations
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi R
                          %mi A
                        %mo ⊕
                        %msub
                          %mi R
                          %mi B
                        %mo ⊆
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi B
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi B
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R_A \oplus R_B \subseteq (A_1 \oplus B_1) \otimes (A_1 \oplus B_1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \otimes B
                is also quadratic, with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo =
                      %msub
                        %mi A
                        %mn 1
                      %mo ⊕
                      %msub
                        %mi B
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} (A \otimes B)_1 = A_1 \oplus B_1
                and taking the span of the coproduct relations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi A
                      %mo ⊕
                      %msub
                        %mi R
                        %mi B
                    %annotation{:encoding => "application/x-tex"} R_A \oplus R_B
                together with the commutation relations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⊗
                      %mi b
                      %mo −
                      %mi b
                      %mo ⊗
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a \otimes b - b \otimes a
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi A
                          %mn 1
                        %mo ,
                        %mi b
                        %mo ∈
                        %msub
                          %mi B
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} a \in A_1, b \in B_1
          %p
            There is also a filtered notion of quadratic algebra, where the homogeneity requirement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊆
                  %mi V
                  %mo ⊗
                  %mi V
                %annotation{:encoding => "application/x-tex"} R \subseteq V \otimes V
            is relaxed to allow inhomogeneous degree 2 terms, i.e.,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊆
                  %mi k
                  %mo ⊕
                  %mi V
                  %mo ⊕
                  %msup
                    %mi V
                    %mrow
                      %mo ⊗
                      %mn 2
                %annotation{:encoding => "application/x-tex"} R \subseteq k \oplus V \oplus V^{\otimes 2}
            in the tensor algebra, and this allows one to include more examples like universal enveloping algebras of finite-dimensional Lie algebras, and also Clifford algebras. But below we discuss only the graded case.
          %h2#quadratic_dual_and_manins_monoidal_products Quadratic dual and Manin’s monoidal products
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi i
                  %mo :
                  %mi R
                  %mo ↪
                  %mi V
                  %mo ⊗
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, i: R \hookrightarrow V \otimes V)
            defines a quadratic algebra, its
            %strong quadratic dual
            is defined by the pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %mo ,
                    %msup
                      %mi R
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V^*, R^\perp)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} R^\perp
            is the kernel of the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo *
                  %mo ⊗
                  %msup
                    %mi V
                    %mo *
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ⊗
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi i
                        %mo *
                  %msup
                    %mi R
                    %mo *
                %annotation{:encoding => "application/x-tex"} V^* \otimes V^* \cong (V \otimes V)^* \stackrel{i^*}{\to} R^*
          %p
            In the literature where it commonly appears, the dual of a quadratic algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is usually denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo !
                  %annotation{:encoding => "application/x-tex"} A^!
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≅
                    %msup
                      %mi A
                      %mrow
                        %mo !
                        %mo !
                  %annotation{:encoding => "application/x-tex"} A \cong A^{!!}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} autonomous
            structure on the category of quadratic algebras:
          %ul
            %li
              %p
                The monoidal product of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %msub
                        %mi R
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V, R_A)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo ,
                      %msub
                        %mi R
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (W, R_B)
                is defined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ⊗
                      %mi W
                      %mo ,
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mi A
                      %mo ⊗
                      %msub
                        %mi R
                        %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V \otimes W, \sigma(R_A \otimes R_B))
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                refers to the canonical interchange isomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi V
                      %mo ⊗
                      %mi W
                      %mo ⊗
                      %mi W
                      %mo ≅
                      %mi V
                      %mo ⊗
                      %mi W
                      %mo ⊗
                      %mi V
                      %mo ⊗
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V \otimes V \otimes W \otimes W \cong V \otimes W \otimes V \otimes W
              %p
                (writing as if the tensor product were strict, as justified by Mac Lane’s coherence theorem). Manin’s notation for this is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo •
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \bullet B
            %li
              %p
                The dual monoidal product, denoted
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∘
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \circ B
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∘
                      %mi B
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo !
                      %mo •
                      %msup
                        %mi B
                        %mo !
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo !
                    %annotation{:encoding => "application/x-tex"} A \circ B = (A^! \bullet B^!)^!
              %p Up to coherent isomorphism, this may be more explicitly defined by the pair
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ⊗
                  %mi W
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi R
                    %mi A
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %mi W
                      %mo ⊗
                      %mi W
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi V
                  %mo ⊗
                  %msub
                    %mi R
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (V \otimes W, \sigma(R_A \otimes 1_{W \otimes W}) + \sigma(1_{V \otimes V} \otimes R_B)).
          %p
            (To see this last more clearly, observe that for finite-dimensional
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊥
                  %mo :
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)^\perp: Sub(V) \to Sub(V^*)
          %p
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi R
                    %mi A
                    %mo ⊥
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %msup
                        %mi W
                        %mo *
                      %mo ⊗
                      %msup
                        %mi W
                        %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(R_{A}^\perp \otimes 1_{W^* \otimes W^*})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mrow
                      %msup
                        %mi V
                        %mo *
                      %mo ⊗
                      %msup
                        %mi V
                        %mo *
                  %mo ⊗
                  %msubsup
                    %mi R
                    %mi B
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(1_{V^* \otimes V^*} \otimes R_{B}^\perp)
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi R
                      %mi A
                      %mo ⊥
                    %mo ⊗
                    %msubsup
                      %mi R
                      %mi B
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma(R_{A}^\perp \otimes R_{B}^\perp)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} (-)^\perp
            to this, one obtains the join of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi R
                    %mi A
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %mi W
                      %mo ⊗
                      %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(R_A \otimes 1_{W \otimes W})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi V
                  %mo ⊗
                  %msub
                    %mi R
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(1_{V \otimes V} \otimes R_B)
            which is
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mi A
                    %mo ⊗
                    %msub
                      %mn 1
                      %mrow
                        %mi W
                        %mo ⊗
                        %mi W
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mrow
                        %mi V
                        %mo ⊗
                        %mi V
                    %mo ⊗
                    %msub
                      %mi R
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma(R_A \otimes 1_{W \otimes W}) + \sigma(1_{V \otimes V} \otimes R_B)
          .un_thm
            %h6#theorem Theorem
            %p
              There is a natural isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi QAlg
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo •
                      %mi B
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mi QAlg
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msup
                        %mi B
                        %mo !
                      %mo ∘
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} QAlg(A \bullet B, C) \cong QAlg(A, B^! \circ C)
          .proof
            %h6#proof Proof
            %p A preliminary comment is that the aforementioned Galois correspondence is induced by the equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi X
                        %mo ⊆
                        %msup
                          %mi Y
                          %mo ⊥
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi X
                        %mo ,
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} ⟩
                          %mi V
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \frac{X \subseteq Y^\perp}{\langle X, Y \rangle_V = 0}
            %p
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊆
                      %msup
                        %mi V
                        %mo *
                    %annotation{:encoding => "application/x-tex"} X \subseteq V^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ⊆
                    %mi V
                  %annotation{:encoding => "application/x-tex"} Y \subseteq V
              are subspaces and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mi V
                    %mo :
                    %msup
                      %mi V
                      %mo *
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \langle -, - \rangle_V: V^* \otimes V \to k
              is the usual pairing to the ground field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %msub
                        %mi R
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U, R_A)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %msub
                        %mi R
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V, R_B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ,
                    %msub
                      %mi R
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W, R_C)
              define the quadratic algebras, and suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi U
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} f: U \otimes V \to W
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi U
                    %mo →
                    %msup
                      %mi V
                      %mo *
                    %mo ⊗
                    %mi W
                  %annotation{:encoding => "application/x-tex"} g: U \to V^* \otimes W
              correspond to one another under the adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ⊗
                    %mi V
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msup
                      %mi V
                      %mo *
                    %mo ⊗
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Vect_k(U \otimes V, W) \cong Vect_k(U, V^* \otimes W).
            %p
              It then suffices to observe that the following statements are equivalent (below, each instance of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              denotes an appropriate middle-four interchange):
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  induces a (unique) graded algebra map
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo •
                          %mi B
                          %mo →
                          %mi C
                        %annotation{:encoding => "application/x-tex"} A \bullet B \to C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⊗
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mi A
                        %mo ⊗
                        %msub
                          %mi R
                          %mi B
                        %mo{:stretchy => "false"} )
                        %mo ⊆
                        %msub
                          %mi R
                          %mi C
                      %annotation{:encoding => "application/x-tex"} (f \otimes f)\sigma(R_A \otimes R_B) \subseteq R_C
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⊗
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mi A
                        %mo ⊗
                        %msub
                          %mi R
                          %mi B
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msubsup
                          %mi R
                          %mi C
                          %mo ⊥
                        %msub
                          %mo{:stretchy => "false"} ⟩
                          %mrow
                            %msup
                              %mi W
                              %mo *
                            %mo ⊗
                            %msup
                              %mi W
                              %mo *
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \langle (f \otimes f)\sigma(R_A \otimes R_B), R_{C}^\perp \rangle_{W^\ast \otimes W^\ast} = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ⊗
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mi A
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi R
                          %mi B
                        %mo ⊗
                        %msubsup
                          %mi R
                          %mi C
                          %mo ⊥
                        %msub
                          %mo{:stretchy => "false"} ⟩
                          %mrow
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ⊗
                            %msup
                              %mi W
                              %mo *
                            %mo ⊗
                            %msup
                              %mi W
                              %mo *
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \langle \sigma(g \otimes g)(R_A), R_B \otimes R_{C}^\perp \rangle_{V \otimes V \otimes W^\ast \otimes W^\ast} = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ⊗
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mi A
                        %mo{:stretchy => "false"} )
                        %mo ⊆
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mi B
                        %mo ⊗
                        %msubsup
                          %mi R
                          %mi C
                          %mo ⊥
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊥
                      %annotation{:encoding => "application/x-tex"} \sigma (g \otimes g)(R_A) \subseteq (R_B \otimes R_{C}^\perp)^\perp
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  induces a (unique) graded algebra map
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo →
                          %msup
                            %mi B
                            %mo !
                          %mo ∘
                          %mi C
                        %annotation{:encoding => "application/x-tex"} A \to B^! \circ C
          %p
            This result may be effectively summarized by saying that the category of quadratic algebras carries a
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous category
            structure, i.e., a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed symmetric monoidal category
            structure equipped with a dualizing object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \delta_A: A \to [[A, D], D]
            is a natural isomorphism. The monoidal unit is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo !
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi ε
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ε
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k[x]^! = k[\varepsilon]/(\varepsilon^2)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} algebra of Grassmann numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is the polynomial algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo !
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A^! \cong [A, D]
            for any quadratic algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %h2#references References
          %p
            Y. Manin,
            = succeed "," do
