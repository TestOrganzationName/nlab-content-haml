                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0412261"} arXiv:math/0412261
                %a{:href => "https://doi.org/10.1073/pnas.0409901102"} doi:10.1073/pnas.0409901102
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#Huang08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yi-Zhi+Huang"}> Yi-Zhi Huang
                ,
                = succeed "," do
                  %em Rigidity and modularity of vertex tensor categories
                %strong 10
                supp01 (2008) 871-911
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0502533"} arXiv:math/0502533
                %a{:href => "https://doi.org/10.1142/S0219199708003083"} doi:10.1142/S0219199708003083
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#HuangLepowskiZhang14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yi-Zhi+Huang"}> Yi-Zhi Huang
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/James+Lepowsky"} James Lepowsky
                = succeed "," do
                  %em Logarithmic tensor category theory for generalized modules for a conformal vertex algebra, I: Introduction and strongly graded algebras and their generalized modules
                %em Conformal Field Theories and Tensor Categories
                Mathematical Lectures from Peking University. Springer (2014)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1012.4193"} arXiv:1012.4193
                %a{:href => "https://doi.org/10.1007/978-3-642-39383-9_5"} doi:10.1007/978-3-642-39383-9_5
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#EGNO15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pavel+Etingof"}> Pavel Etingof
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shlomo+Gelaki"} Shlomo Gelaki
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Nikshych"} Dmitri Nikshych
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Victor+Ostrik"} Victor Ostrik
                = succeed "," do
                  %em Tensor Categories
                %strong 205
                (2015) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/surv-205"}> ISBN:978-1-4704-3441-0
                \&amp;rbrack;
          %p brief survey:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"}> Jürgen Fuchs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Simon+Wood"} Simon Wood
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yang+Yang"} Yang Yang
              = succeed "," do
                %em Algebraic structures in two-dimensional conformal field theory
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2305.02773"} arXiv:2305.02773
          %p
            and generalization to
            %a.existingWikiWord{:href => "/nlab/show/logarithmic+CFT"} logarithmic
            VOAs:
          %ul
            %li#CreutzigLentnerRupert21
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Creutzig"}> Thomas Creutzig
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Simon+Lentner"} Simon Lentner
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Rupert"} Matthew Rupert
              %em Characterizing braided tensor categories associated to logarithmic vertex operator algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "https://arxiv.org/abs/2104.13262"} arXiv:2104.13262
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            A list of examples (with an emphasis on
            %a.existingWikiWord{:href => "/nlab/show/representation+categories"} representation categories
            of rational
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebras"} vertex operator algebras
          %ul
            %li#GannonHoehn
              %a.existingWikiWord{:href => "/nlab/show/Terry+Gannon"}> Terry Gannon
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gerald+H%C3%B6hn"} Gerald Höhn
              %em
                %a{:href => "http://www.math.ksu.edu/~gerald/voas/"} The online database of Vertex Operator Algebras and Modular Categories
          %p Classification results
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+Rowell"}> Eric Rowell
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+Stong"} Richard Stong
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Zhenghan+Wang"} Zhenghan Wang
              = succeed "," do
                %em On classification of modular tensor categories
              %strong 292
              2 (2009) 343–389 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0712.1377"}> arXiv:0712.1377
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-009-0908-z"} doi:10.1007/s00220-009-0908-z
          %p
