            %a.existingWikiWord{:href => "/nlab/show/number+theory"} number theoretic
            aspects of modular tensor categories:
          %ul
            %li#DavidovichHaggeWang2013
              %a.existingWikiWord{:href => "/nlab/show/Orit+Davidovich"}> Orit Davidovich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Hagge"} Tobias Hagge
              = succeed "," do
