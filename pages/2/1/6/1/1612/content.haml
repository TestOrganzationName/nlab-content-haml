              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/DelaneyModularTensorCategories.pdf", :title => "pdf"} pdf
          %p
            Construction of modular tensor categories from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebras"} vertex operator algebras
          %ul
            %li#Huang05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yi-Zhi+Huang"}> Yi-Zhi Huang
                ,
                = succeed "," do
                  %em Vertex operator algebras, the Verlinde conjecture and modular tensor categories
                %strong 102
                (2005) 5352-5356
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
