                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} PSL(2,\mathbb{R})
                %li
                  %a{:href => "#ModularFormsAdAdelicAutomorphicForms"}
                    Modular forms as adelic automorphic forms on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi 𝔸
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} GL(2,\mathbb{A})
                %li
                  %a{:href => "#InNumberTheory"} General adelic automorphic forms
                %li
                  %a{:href => "#dirichlet_characters"} Dirichlet characters
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#function_field_analogy"} Function field analogy
                %li
                  %a{:href => "#application_in_string_theory"} Application in string theory
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#ReferencesInStringTheory"} In string theory
          %h2#Idea Idea
          %p
            Quite generally,
            %em automorphic forms
            are suitably well-behaved
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            on a
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo \
                  %mi X
                %annotation{:encoding => "application/x-tex"} K\backslash X
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is typically a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which are
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a discrete group. The precise definition has evolved a good bit through time.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Henri+Poincar%C3%A9"} Henri Poincaré
            considered
            %a.existingWikiWord{:href => "/nlab/show/analytic+functions"} analytic functions
            invariant under a discrete infinite group of
            %a.existingWikiWord{:href => "/nlab/show/fractional+linear+transformations"} fractional linear transformations
            and called them
            %em
              %a.existingWikiWord{:href => "/nlab/show/Fuchsian+functions"} Fuchsian functions
            (after his advisor
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lazarus+Fuchs"} Lazarus Fuchs
          %p
            More generally, automorphic forms in the modern sense are suitable functions on a
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo \
                    %mi G
                  %annotation{:encoding => "application/x-tex"} K \backslash G
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            which are
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} K \hookrightarrow G
            %a.existingWikiWord{:href => "/nlab/show/modular+forms"} modular forms
            regarded as functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo \
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K\backslash PSL(2,\mathbb{R})
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/congruence+subgroup"} congruence subgroup
            = succeed "." do
              %a{:href => "#ModularForms"} below
            %a.existingWikiWord{:href => "/nlab/show/modular+form"} modular form
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of some
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
            defined an automorphic form to be a section of a line bundle on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Shimura+variety"} Shimura variety
          %p
            By pullback of functions the linear space of such functions hence constitutes a
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and such representations are then called
            %em automorphic representations
            (e.g.
            = succeed ")" do
              %a{:href => "#Martin13"} Martin 13, p. 9
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = GL_n(\mathbb{A}_K)
            is the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in a
            %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
            of some
            %a.existingWikiWord{:href => "/nlab/show/global+field"} global field
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %msub
                      %mi GL
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K = GL_n(K)
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Langlands+program"} Langlands program
            %a.existingWikiWord{:href => "/nlab/show/unramified"} unramified
            such representations, which are constituted by functions that in addition are invariant under the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                %annotation{:encoding => "application/x-tex"} GL_n
            with coefficients in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
            = succeed "." do
              %a{:href => "#InNumberTheory"} below
          %h3#ModularForms
            Modular forms as classical automorphic forms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSL(2,\mathbb{R})
          %p
            By a standard definition, a
            %em
              %a.existingWikiWord{:href => "/nlab/show/modular+form"} modular form
            is a
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
            on the
            %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℌ
                %annotation{:encoding => "application/x-tex"} \mathfrak{H}
            satisfying a specified transformation property under the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a given
            %a.existingWikiWord{:href => "/nlab/show/congruence+subgroup"} congruence subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            of the
            %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = PSL(2,\mathbb{Z})
            (e.g.
            = succeed "," do
              %a{:href => "#Martin13"} Martin 13, definition 1
            = succeed ")." do
              %a{:href => "#Litt"} Litt, def. 1
          %p
            But the
            %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
            is itself the
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            of the
            %a.existingWikiWord{:href => "/nlab/show/projective+linear+group"} projective linear group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = PSL(\mathbb{R})
            by the subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo =
                  %msub
                    %mi Stab
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} {
                  %mo ±
                  %mi I
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} K = Stab_G(\{i\}) \simeq SO(2)/\{\pm I\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℌ
                  %mo ≃
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f\colon \mathfrak{H} \simeq PSL(2,\mathbb{R})/K
                  \\,.
          %p
            In view of this, one finds that every modular function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℌ
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} f \colon \mathfrak{H} \to \mathbb{C}
            lifts to a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Γ
                  %mo \
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\tilde f \colon \Gamma\backslash PSL(2,\mathbb{R})
                  \\longrightarrow \mathbb{C}
                  \\,,
          %p
            hence to a function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            which is actually
            %em invariant
            with respect to the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde f
            is the incarnation as an
            %em automorphic function
            of the modular function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (e.g.
            = succeed "," do
              %a{:href => "#Martin13"} Martin 13, around def. 3
            = succeed ")." do
              %a{:href => "#Litt"} Litt, section 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSL(2,\mathbb{R})
            equivalent to modular forms are called
            = succeed "." do
              %em classical modular forms
          %p
            This is where the concept of automorphic forms originates (for more on the history see e.g.
            %a{:href => "http://mathoverflow.net/a/124785/381"} this MO comment
            for the history of terminology)
            = succeed "." do
              %a{:href => "http://mathoverflow.net/a/21556/381"} and this one
          %h3#ModularFormsAdAdelicAutomorphicForms
            Modular forms as adelic automorphic forms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi 𝔸
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(2,\mathbb{A})
          %p
            Where by the
            %a{:href => "#ModularForms"} above
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/modular+form"} modular form
            is equivalently a suitably periodic function on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{R})
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            appearing as
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the latter are but one of many
            %a.existingWikiWord{:href => "/nlab/show/p-adic+number"} p-adic number
            completions of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %msub
                    %mi ℚ
                    %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{Q}_p)
            of all these completions at once. This means to consider functions on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝔸
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{A})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                %annotation{:encoding => "application/x-tex"} \mathbb{A}
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
            = succeed "." do
              %em adelic automorphic forms
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/level+structures"} level structures
            = succeed "," do
              %a{:href => "#Martin13"} Martin 13, p. 8
            = succeed "," do
              %a{:href => "#GoldfeldHundley11"} Goldfeld-Hundley 11, lemma 5.5.10
            = succeed "," do
              %a{:href => "#Bump"} Bump, section 3.6
            = succeed "):" do
              %a{:href => "#Gelbhart84"} Gelbhart 84, p. 22
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo \
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi 𝔸
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝔸
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma \backslash PSL(2,\mathbb{R})
                  \\simeq
                  Z(\mathbb{A}) GL_2(\mathbb{Q})\backslash GL_2(\mathbb{A})/ GL_2(\mathbb{A}_{\mathbb{Z}})
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔸
                    %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{A}_{\mathbb{Z}}
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
            %a.existingWikiWord{:href => "/nlab/show/double+coset"} double coset
            on the right is analogous to that which appears in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization+theorem"} Weil uniformization theorem
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            for more on this analogy.)
          %p
            This leads to the more general concept of
            %em adelic automorphic forms
            = succeed "." do
              %a{:href => "#InNumberTheory"} below
          %h3#InNumberTheory General adelic automorphic forms
          %p
            More generally, for the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi GL
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔸
                      %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = GL_n(\mathbb{A}_F)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in a
            %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔸
                    %mi F
                %annotation{:encoding => "application/x-tex"} \mathbb{A}_F
            of some
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_n(F)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_n(F)\backslash GL_n(\mathbb{A}_F)
            form
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_n(\mathbb{A}_{F})
            which are called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/automorphic+representations"} automorphic representations
          %ol
            %li
              %p
                %strong finiteness
                – the functions
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                under the
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of the
                %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                a
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %li
              %p
                %strong central character
                – the action by the
                %a.existingWikiWord{:href => "/nlab/show/center+of+a+group"} center
                is is controled by (…something…);
            %li
              %p
                %strong growth
                – the functions are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/bounded+functions"} bounded functions
            %li
              %p
                %strong cuspidality
                – (…)
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Frenkel05"} Frenkel 05, section 1.6
            = succeed "," do
              %a{:href => "#Loeffler11"} Loeffler 11, page 4
            = succeed "," do
              %a{:href => "#Martin13"} Martin 13, definition 4
            = succeed ")." do
              %a{:href => "#Litt"} Litt, def.4
          %p
            (These conditions are not entirely set in stone, they are being varied according to application (see e.g.
            = succeed "))." do
              %a{:href => "http://mathoverflow.net/a/66598/381"} this MO comment
          %p
            In particular one considers subspaces of “
            %a.existingWikiWord{:href => "/nlab/show/unramified"}> unramified
            ” such functions, namely those which are in addition trivial on the subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                %annotation{:encoding => "application/x-tex"} GL_n
            of the
            %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi F
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_F
            (
            %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, def. 2.1.12
            ). This means that that unramified automorphic representations are spaces of functions on a
            %a.existingWikiWord{:href => "/nlab/show/double+coset"} double coset
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi F
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  GL_n(F)\backslash GL_n(\mathbb{A}_F) / GL_n(\mathcal{O}_F)
                  \\,.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Langlands+correspondence"} Langlands correspondence
            for more on this. Such double cosets are
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogous
            to those appearing in the
            %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization+theorem"} Weil uniformization theorem
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
          %h3#dirichlet_characters Dirichlet characters
          %p
            For the special case of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            in the discussion of adelic automorphic forms
            = succeed "," do
              %a{:href => "#InNumberTheory"} above
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                  %mo =
                  %msub
                    %mi 𝕀
                    %mi F
                %annotation{:encoding => "application/x-tex"}
                  GL_1(\mathbb{A}_F) = (\mathbb{A}_F)^\times = \mathbb{I}_F
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/group+of+ideles"} group of ideles
            and the quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi F
                    %mo ×
                  %mo \
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                %annotation{:encoding => "application/x-tex"}
                  GL_1(F) \backslash GL_1(\mathbb{A}_F)
                  \=
                  F^\times \backslash (\mathbb{A}_F)^\times
          %p
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/idele+class+group"} idele class group
            %a.existingWikiWord{:href => "/nlab/show/Dirichlet+characters"} Dirichlet characters
            in disguise… (
            %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, theorem 2.1.9
