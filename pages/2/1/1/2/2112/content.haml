          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit+method"} orbit method
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Schubert+calculus"} Schubert calculus
          %h2#references References
          %ul
            %li
              %p
                Neil Chriss,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Victor+Ginzburg"} Victor Ginzburg
                = succeed "," do
                  %em Representation theory and complex geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
                ,
                %em
                  Représentations linéaires et espaces homogènes kählériens des groupes de Lie compacts (d’après Armand Borel et André Weil)“, Séminaire Bourbaki 100: 447–454, Paris: Soc. Math. France, 1953/54,
                  %a{:href => "http://www.numdam.org/item?id=SB_1951-1954__2__447_0"} numdam
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertram+Kostant"}> Bertram Kostant
                ,
                = succeed "," do
                  %em Lie algebra cohomology and the generalized Borel-Weil theorem
                = succeed "," do
                  %em 74
                %a{:href => "https://people.tamu.edu/~jml/kostant61.pdf"} pdf
            %li
              %p
