                ,
                = succeed "," do
                  %em Remarks on “Lie algebra cohomology and the generalized Borel-Weil theorem” by B. Kostant
                = succeed "," do
                  %em 74
                %a{:href => "http://www.math.tamu.edu/~jml/cartier61.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                %em A proof of the Borel-Weil-Bott theorem
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/bwb.pdf"}> pdf
                )
          %p Lecture notes include
          %ul#Kumar12
            %li
              %p
                Wilfried Schmid (notes by Matvei Libine),
                %em Geometric methods in representation theory
                (
                %a{:href => "http://www.math.harvard.edu/~schmid/articles/brussels_1_30_04.pdf"}> pdf
                )
            %li
              %p
                Shrawan Kumar,
                %em Borel-Weil-Bott theorem and geometry of Schubert varieties
                (
                %a{:href => "http://www.unc.edu/math/Faculty/kumar/notes/kumar_notes_03.pdf"}> pdf
                )
          %ul
            %li
              %p
                P. Woit,
                %em Topics in representation theory: the Borel-Weil theorem
                (
                %a{:href => "http://www.math.columbia.edu/~woit/notes16.pdf"}> pdf
                ),
                %em Highest Weight Theory: Borel-Weil
                (
                %a{:href => "http://www.math.columbia.edu/~woit/LieGroups-2012/borelweil.pdf"}> pdf
                ),
                %em Lie Algebra Cohomology and the Borel-Weil–Bott Theorem
                (
                %a{:href => "https://www.math.columbia.edu/~woit/LieGroups-2012/borelweilbott.pdf"}> pdf
                ),
                %em Quantum field theory and representation theory: A sketch
                (
                %a{:href => "http://www.math.columbia.edu/~woit/sketch.pdf"}> pdf
                )
            %li
              %p
                Lisa Jeffrey,
                %em Remarks on geometric quantization and representation theory
                %a{:href => "http://www.math.toronto.edu/~jeffrey/mat1312/lec14.gq.pdf"} pdf
          %p See also
          %ul
            %li
              %p
                eom:
                %a{:href => "http://eom.springer.de/b/b120400.htm"} Bott-Borel-Weil theorem
            %li
