                  %mo ×
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi
                  \\,\colon\,
                  f_! (f^*a \times c)
                  \\longrightarrow
                  a \times f_!(c)
          %p
            is an isomorphism for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒴
                %annotation{:encoding => "application/x-tex"} \mathcal{Y}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p
            This holds for instance for the
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            between
            %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi b
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/b}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi b
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/b'}
            of a
            %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            along a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi b
                  %mo ′
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} f \colon b' \to b
            – by the
            %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #eq:PastingLawForLexCategories.maruku-equation
