          %h2#definition Definition
          %p
            The term
            %em Frobenius reciprocity
            has a meaning
          %ul
            %li
              %p
                %a{:href => "#InRepresentationTheory"} In representation theory
            %li
              %p
                %a{:href => "#InCategoryTheory"}> In category theory
                \.
          %p
            (For different statements of a similar name see the disambiguation at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+theorem"} Frobenius theorem
          %h3#InRepresentationTheory In representation theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            %strong Frobenius reciprocity
            is the statement that the
            %a.existingWikiWord{:href => "/nlab/show/induction+functor"} induction functor
            for
            %a.existingWikiWord{:href => "/nlab/show/group+representation"} representations of groups
            (or in some other
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+categories"} algebraic categories
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            functor. Sometimes it is used for a
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorified
            version of this statement as well, on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characters"} characters
          %p
            Specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
            an
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            inclusion, there is an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ind
                  %mo ⊣
                  %mi Res
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Rep
                    %mi G
                  %mover
                    %munder
                      %mo ⟶
                      %mi Red
                    %mover
                      %mo ←
                      %mi Ind
                  %msub
                    %mi Rep
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  (Ind \dashv Res) \;\colon\;
                  Rep_G
                  \\stackrel{\overset{Ind}{\leftarrow}}{\underset{Red}{\longrightarrow}}
                  Rep_H
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            and
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            an
            = succeed "-representation," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ind(\rho) \in Rep(G)
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induced representation
          %p
            Sometimes also the
            %em
              %a.existingWikiWord{:href => "/nlab/show/projection+formula"} projection formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi Res
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi W
                  %mo ⊗
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Ind(Res(W) \otimes V) \cong W \otimes Ind(V)
          %p
            is referred to as
            %em Frobenius reciprocity
            in representation theory (e.g.
            = succeed ")." do
              %a{:href => "http://planetmath.org/frobeniusreciprocity"} here on PlanetMath
          %h3#InCategoryTheory In cartesian categories
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_! \dashv f^*
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed"} cartesian closed
            %strong Frobenius reciprocity
            if the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒴
                  %mo →
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} f^* \colon \mathcal{Y} \to \mathcal{X}
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi b
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^*(b^a) \to f^*(b)^{f^*(a)}
            is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            for all objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒴
                  %annotation{:encoding => "application/x-tex"} \mathcal{Y}
          %p
            Each of the functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                  %annotation{:encoding => "application/x-tex"} -^a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} -^{f^*(a)}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mates"} mates
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/projection+formula"} projection
          #eq:ProjectionMorphism.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
