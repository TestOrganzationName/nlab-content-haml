              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#related_notions"} Related notions
          %h2#idea Idea
          %p
            %strong Homotopy equalizers
            are a special case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limits"} homotopy limits
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/walking+parallel+pair"} walking parallel pair
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0\to 1
          %p
            Homotopy equalizers can be defined in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relative+category"} relative category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structures"} model structures
          %p
            In the absence of nontrivial
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            (in a bare
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
          %h2#properties Properties
          %h3#RelationToHomotopyPullbacks Relation to homotopy pullbacks
          %p
            In any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f,g\colon A\to B
            can be computed as follows.
          %p
            First, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is not
            %a.existingWikiWord{:href => "/nlab/show/fibrant"} fibrant
            and the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            is not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+proper"} right proper
            %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi R
                  %mi B
                %annotation{:encoding => "application/x-tex"} r\colon B\to R B
            and replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,g)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi f
                    %mo ,
                    %mi r
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (r f,r g)
          %p
            Assume now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is
            %a.existingWikiWord{:href => "/nlab/show/fibrant"} fibrant
            or the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+proper"} right proper
          %p In the special case when the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo ⟶
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  (f,g)
                  \\;\colon\;
                  A \longrightarrow B\times B
          %p
            happens to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p
            In the general case, factor the
            %a.existingWikiWord{:href => "/nlab/show/diagonal+map"} diagonal map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mo →
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Delta \;\colon\; B\to B\times B
            as a
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi P
                  %mi B
                %annotation{:encoding => "application/x-tex"} B \to P B
            followed by a
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi B
                    %mo ⟶
                    %mi B
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} P B \longrightarrow B\times B
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⟶
                  %mi B
                  %mo ×
                  %mi B
                  %mo ⟵
                  %mi P
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A \longrightarrow B\times B \longleftarrow P B
                  \\,.
          %p
            This is the homotopy equalizer of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p See also
          %ul
            %li
              %a{:href => "homotopy+pullback#HomotopyPullbackByFactorizationLemma"} this Prop.
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          %p and
          %ul
            %li
              %a{:href => "https://ncatlab.org/nlab/show/Mayer-Vietoris+sequence#SequenceFromDiagonal"} this Prop
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
          %h3#relation_to_homotopy_fibers Relation to homotopy fibers
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+model+categories"} pointed model categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            and the
            %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} 0\colon A\to B
            is known as the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h2#examples Examples
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+equivalences"} simplicial weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f,g\colon A\to B
            can be computed as the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ×
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                  %msup
                    %mi B
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} A\times_{B\times B}B^{\Delta^1}
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
            like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %msup
                    %mi Ex
                    %mn ∞
                  %mi B
                %annotation{:encoding => "application/x-tex"} B\to Ex^\infty B
            first.) The same formula works for
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta=[0,1]
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi B
                    %mo =
                    %msup
                      %mi B
                      %mrow
                        %mi{:mathvariant => "normal"} N
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P B =B^{\mathrm{N} \mathbf{Z} [\Delta^1]}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊕
                  %mi B
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} A\oplus B[-1],
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊕
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi d
                  %mi a
                  %mo ⊕
                  %mi d
                  %mi b
                  %mo +
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} d(a\oplus b)=d a\oplus d b+f(a)-g(a).
          %h2#related_notions Related notions
          %ul
            %li
