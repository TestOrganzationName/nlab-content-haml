                    \\underset{
                    {}^{\{1, \cdots, n\}}
                    }{
                    Conf
                    }
                    \\big(
                    \\mathbb{R}^D
                    \\big),
                    \\mathbb{R}
                    \\Big)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i, j \in \{1, \cdots, n\}
            %p
              subject to these three
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
            %ol
              %li
                %p
                  %strong (anti-)symmetry)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
