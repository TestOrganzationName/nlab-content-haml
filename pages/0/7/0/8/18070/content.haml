                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \omega_{i j} \wedge \omega_{i j} \;=\; 0
              %li
                %p
                  %strong 3-term relation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
