          #ScanningMapEquivalenceOverClosedFramedManifold.num_prop
            %h6#remark_4 Remark
            %p
              In the special case that the
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X^n
              in Prop.
              %a.maruku-ref{:href => "#ScanningMapEquivalenceOverClosedManifold"}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/parallelizable+manifold"} parallelizable
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivializable
              %a.maruku-ref{:href => "#ScanningMapEquivalenceOverClosedManifold"}
              reduces to this:
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X^n
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/parallelizable+manifold"} parallelizable
                  %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} 1 \leq k \in \mathbb{N}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Cohomotopy+charge+map"} Cohomotopy charge map
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mrow
                        %mi Maps
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %msup
                          %mi X
                          %mi n
                        %mspace{:width => "thickmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mi k
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mstyle{:mathcolor => "blue"}
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mphantom
                              %mi a
                          %mrow
                            %mtext Cohomotopy space
                    %munderover
                      %mo ⟵
                      %mo ≃
                      %mstyle{:mathcolor => "blue"}
                        %mtext Cohomotopy charge map
                    %munder
                      %mrow
                        %mi Conf
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi X
                          %mi n
                        %mo ,
                        %msup
                          %mi S
                          %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mpadded{:lspace => "-50%width", :width => "0"}
                        %mstyle{:mathcolor => "blue"}
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mphantom
                                %mi a
                            %mrow
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mtext configuration space
                                %mrow
                                  %mtext of points
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\color{blue}
                    { \phantom{a} \atop \text{ Cohomotopy space}}
                    }{
                    Maps
                    \\Big(
                    X^n
                    \\;,\;
                    S^{
                    n + k
                    }
                    \\Big)
                    }
                    \\underoverset
                    {\simeq}
                    {
                    \\color{blue}
                    \\text{Cohomotopy charge map}
                    }
                    {\longleftarrow}
                    \\underset{
                    \\mathclap{
                    \\color{blue}
                    {
                    \\phantom{a}
                    \\atop
                    {
                    \\text{configuration space}
                    \\atop
                    \\text{of points}
                    }
                    }
                    }
                    }{
                    Conf
                    \\big(
                    X^n,
                    S^k
                    \\big)
                    }
            %p between
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+k)
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
                  space of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mi n
                        %annotation{:encoding => "application/x-tex"} X^n
                  %a.existingWikiWord{:href => "/nlab/show/space+of+maps"} space of maps
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (n+k)-sphere
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X^n
                  with labels in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
