                            %mi k
                            %mi i
                        %mo +
                        %msub
                          %mi ω
                          %mrow
                            %mi k
                            %mi i
                        %mo ∧
                        %msub
                          %mi ω
                          %mrow
                            %mi i
                            %mi j
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\omega_{i j}
                        \\wedge
                        \\omega_{j k}
                        +
                        \\omega_{j k}
                        \\wedge
                        \\omega_{k i}
                        +
                        \\omega_{k i}
                        \\wedge
                        \\omega_{i j}
                        \=
                        0
            %p Hence:
            #eq:RealCohomologyOfUnorderedConfigurationSpaceInEuclideanSpace.maruku-equation
              %span.maruku-eq-number (18)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
