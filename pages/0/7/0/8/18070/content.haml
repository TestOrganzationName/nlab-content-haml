                  = succeed "," do
                    %em On algebraic equations satisfied by hypergeometric correlators in WZW models. I
                  %strong 163
                  (1994) 173–184
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
