                        %annotation{:encoding => "application/x-tex"} S^k
          %h3#rational_maps_to_complex_projective_space Rational maps to complex projective space
          %p
            A similar relation holds for mapping spaces not to spheres, but to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+spaces"} complex projective spaces
          %p
          #RationalMapsToCPnAsConfigurationsOfPoints.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+of+rational+maps"} homotopy type of the space of rational maps
              from the
              %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
              to
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"}
                complex projective
                = succeed "-space" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              of algebraic
              %a{:href => "homotopy+of+rational+maps#NotionsOfDegree"} degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is that of the configuration space of at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              with labels in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{2n-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Maps
                      %mi rat
                      %mrow
                        %mi deg
                        %mo =
                        %mi d
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Σ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mi htpy
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi Conf
                      %mrow
                        %mo ≤
                        %mi d
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ;
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Maps_{
                    {rat}
                    }^{deg = d}
                    \\big(
                    \\Sigma
                    ,\,
                    \\mathbb{C}P^n
                    \\big)
                    \\;\simeq_{htpy}\;
                    \\underset{ \leq d}{Conf}
                    \\big(
                    \\mathbb{R}^2;
                    S^{2k+1}
                    \\big)
            %p
          %p
            (
            %a{:href => "#CohenShimamoto91"}> Cohen &amp; Shimamoto 91, Theorem 1
            )
          %h3#knizhnikzamolodchicov_connection Knizhnik-Zamolodchicov connection
          %div
            %p
              For the Definition
              %a.maruku-ref{:href => "#KnizhnikZamolodchikovConnection"}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
              we need the following notation:
            %ol
              %li
                %p
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mi{:mathvariant => "normal"} f
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} N_{\mathrm{f}} \in \mathbb{N}
                  write
                #eq:OrderedConfigurationSpaceofnPointsinC.maruku-equation
                  %span.maruku-eq-number (11)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi Conf
                          %mrow
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi N
                                  %mi{:mathvariant => "normal"} f
                                %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mo \
                        %mi FatDiagonal
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{{}^{\{1,\cdots,N_{\mathrm{f}}\}}}{Conf}(\mathbb{R}^2)
                        \\;\coloneqq\;
                        (\mathbb{R}^2)^n \backslash FatDiagonal
                %p
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/ordered+configuration+space+of+n+points"} ordered configuration space of n points
                  in the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/plane"} plane
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %p
                  Identifying the plane with the
                  %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic
                  %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
                #eq:CoordinateFunctionsOnConfC.maruku-equation
                  %span.maruku-eq-number (12)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi z
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi z
                          %mrow
                            %msub
                              %mi N
                              %mi{:mathvariant => "normal"} f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mi Conf
                          %mrow
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %mi n
                                %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi ℂ
                          %mrow
                            %msub
                              %mi N
                              %mi{:mathvariant => "normal"} f
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (z_1, \cdots, z_{N_{\mathrm{f}}})
                        \\;\colon\;
                        \\underset{{}^{\{1,\cdots,n\}}}{Conf}(\mathbb{R}^2)
                        \\longrightarrow
                        \\mathbb{C}^{N_{\mathrm{f}}}
                        \\,.
              %li
                %p
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
                #eq:HorizontalChordDiagrams.maruku-equation
                  %span.maruku-eq-number (13)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝒜
                          %mrow
                            %msub
                              %mi N
                              %mi{:mathvariant => "normal"} f
                          %mrow
                            %msup
                              %mrow
                              %mi pb
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi Span
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msubsup
                          %mi 𝒟
                          %mrow
                            %msub
                              %mi N
                              %mi{:mathvariant => "normal"} f
                          %mrow
                            %msup
                              %mrow
                              %mi pb
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:stretchy => "false"} /
                        %mn 4
                        %mi T
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{A}^{{}^{pb}}_{N_{\mathrm{f}}}
                        \\;\coloneqq\;
                        Span\big(\mathcal{D}^{{}^{pb}}_{N_{\mathrm{f}}}\big)/4T
                %p
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} quotient vector space
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
                  of
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  strands by the
                  %a.existingWikiWord{:href => "/nlab/show/4T+relations"} 4T relations
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+relations"}> infinitesimal braid relations
                  ), regarded as an
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                  under
                  %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
                  of strands (
                  %a{:href => "horizontal+chord+diagram#AlgebraOfHorizontalChordDiagrams"}> here
                  ).
            #KnizhnikZamolodchikovConnection.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+form"}> Knizhnik-Zamolodchikov form
                  )
              %p
                The
                %em
                  universal
                  %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+form"} Knizhnik-Zamolodchikov form
                is the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagram"} horizontal chord diagram
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"} algebra valued differential form
                %a.maruku-eqref{:href => "#eq:HorizontalChordDiagrams"} (13)
                on the
                %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
                %a.maruku-eqref{:href => "#eq:OrderedConfigurationSpaceofnPointsinC"} (11)
              #eq:UniversalKnizhnikZamolodchikovForm.maruku-equation
                %span.maruku-eq-number (14)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi KZ
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Ω
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %munder
                        %mi Conf
                        %mrow
                          %msup
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi N
                                %mi{:mathvariant => "normal"} f
                              %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %msubsup
                        %mi 𝒜
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                        %mrow
                          %msup
                            %mrow
                            %mi pb
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\omega_{KZ}
                      \\;\in\;
                      \\Omega
                      \\big(
                      \\underset{{}^{\{1,\cdots,N_{\mathrm{f}}\}}}{Conf}(\mathbb{C})
                      \\,,
                      \\mathcal{A}^{{}^{pb}}_{N_{\mathrm{f}}}
                      \\big)
              %p
                given in the canonical
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                %a.maruku-eqref{:href => "#eq:CoordinateFunctionsOnConfC"} (12)
                by:
              #eq:DefineUniversalKnizhnikZamolodchikovForm.maruku-equation
                %span.maruku-eq-number (15)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi KZ
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo &lt;
                          %mi j
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi d
                        %mi dR
                      %mi log
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi z
                        %mi i
                      %mo −
                      %msub
                        %mi z
                        %mi j
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ⊗
                      %msub
                        %mi t
                        %mrow
                          %mi i
                          %mi j
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\omega_{KZ}
                      \\;\coloneqq\;
                      \\underset{ i \lt j \in \{1, \cdots, n\} }{\sum}
                      d_{dR} log\big( z_i - z_j \big)
                      \\otimes t_{i j}
                      \\,,
              %p where
              %center
                %img{:src => "https://ncatlab.org/nlab/files/HorizontalChordGenerator.jpg", :width => "500 /> "}/
              %p
                is the horizontal chord diagram with exactly one chord, which stretches between the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
              %p
                Regarded as a connection form for a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/connection+on+a+vector+bundle"} connection on a vector bundle
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mi KZ
                      %annotation{:encoding => "application/x-tex"} \nabla_{KZ}
                %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mi ϕ
                      %mo +
                      %msub
                        %mi ω
                        %mi KV
                      %mo ∧
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"}
                      \\nabla \phi
                      \\;\coloneqq\;
                      d \phi + \omega_{KV} \wedge \phi
              %p
                for any
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mi Conf
                        %mrow
                          %msup
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi N
                                %mi{:mathvariant => "normal"} f
                              %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msubsup
                        %mi 𝒜
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                        %mrow
                          %msup
                            %mrow
                            %mi pb
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\phi \;\colon\;
                      \\underset{{}^{\{1,\cdots,N_{\mathrm{f}}\}}}{Conf}(\mathbb{C})
                      \\longrightarrow
                      \\mathcal{A}^{{}^{pb}}_{N_{\mathrm{f}}} Mod
              %p
                with values in
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
                over the algebra of
                %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} modulo
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/4T+relations"} 4T relations
              %p The condition of covariant constancy
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi KZ
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\nabla_{KZ} \phi \;=\; 0
              %p
                is called the
                = succeed "." do
                  %em Knizhnik-Zamolodchikov equation
              %p
                Finally, given a
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebra"} metric Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                and a
                %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                of
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representations"} Lie algebra representations
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mi Rep
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mo ∼
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (
                      V_1,
                      \\cdots,
                      V_{N_{\mathrm{f}}}
                      )
                      \\;\in\; (\mathfrak{g} Rep_{/\sim})^{N_{\mathrm{f}}}
                      \\,,
              %p
                the corresponding
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} Lie algebra weight system
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mi V
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi 𝒜
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                        %mrow
                          %msup
                            %mrow
                            %mi pf
                      %mo ⟶
                      %msub
                        %mi End
                        %mi 𝔤
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi V
                        %mn 1
                      %mo ⊗
                      %mi ⋯
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      w_{V}
                      \\;\colon\;
                      \\mathcal{A}^{{}^{pf}}_{N_{\mathrm{f}}}
                      \\longrightarrow
                      End_{\mathfrak{g}}\big( V_1 \otimes \cdots V_{N_{\mathrm{f}}}  \big)
              %p
                turns the universal
                %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+form"} Knizhnik-Zamolodchikov form
                %a.maruku-eqref{:href => "#eq:UniversalKnizhnikZamolodchikovForm"} (14)
                into a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"} valued differential form
              #eq:LieKnizhnikZamolodchikovForm.maruku-equation
                %span.maruku-eq-number (16)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi KZ
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo &lt;
                          %mi j
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi d
                        %mi dR
                      %mi log
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi z
                        %mi i
                      %mo −
                      %msub
                        %mi z
                        %mi j
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ⊗
                      %msub
                        %mi w
                        %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Ω
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %munder
                        %mi Conf
                        %mrow
                          %msup
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi N
                                %mi{:mathvariant => "normal"} f
                              %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mi End
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi V
                        %mn 1
                      %mo ⊗
                      %mo ⋅
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi N
                            %mi{:mathvariant => "normal"} f
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\omega_{KZ}
                      \\;\coloneqq\;
                      \\underset{ i \lt j \in \{1, \cdots, n\} }{\sum}
                      d_{dR} log\big( z_i - z_j \big)
                      \\otimes w_V(t_{i j})
                      \\;\in\;
                      \\Omega
                      \\big(
                      \\underset{{}^{\{1,\cdots,N_{\mathrm{f}}\}}}{Conf}(\mathbb{C})
                      \\,,
                      End\big(V_1 \otimes \cdot V_{N_{\mathrm{f}}} \big)
                      \\big)
                      
                      \\,.
            %p
              The universal formulation
              %a.maruku-eqref{:href => "#eq:UniversalKnizhnikZamolodchikovForm"} (14)
              is highlighted for instance in
              = succeed "," do
                %a{:href => "Vassiliev+invariant#BarNatan95"} Bat-Natan 95, Section 4.2
              = succeed "." do
                %a{:href => "Kontsevich+integral#Lescop00"} Lescop 00, p. 7
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} Lie algebra weight system
              = succeed "." do
                %a{:href => "Kontsevich+integral#Kohno14"} Kohno 14, Section 5
            #KnizhnikZamolodchikovConnectionIsFlat.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi ZK
                    %annotation{:encoding => "application/x-tex"} \omega_{ZK}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#KnizhnikZamolodchikovConnection"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi ω
                        %mi ZK
                      %mo +
                      %msub
                        %mi ω
                        %mi ZK
                      %mo ∧
                      %msub
                        %mi ω
                        %mi ZK
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \omega_{ZK} + \omega_{ZK} \wedge \omega_{ZK}
                      \\;=\;
                      0
                      \\,.
            #KontsevichIntegralForBraids.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Kontsevich+integral"} Kontsevich integral
                  for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/braids"} braids
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Dyson+formula"} Dyson formula
                for the
                %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
                of the
                %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#KnizhnikZamolodchikovConnection"}
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Kontsevich+integral"} Kontsevich integral
                    on
                    %a.existingWikiWord{:href => "/nlab/show/braids"} braids
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "Kontsevich+integral#Lescop00"} Lescop 00, side-remark 1.14
          %h3#action_by_little_disk_operad_and_by_goodwillie_derivatives
            Action by little
            = succeed "-disk" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Under some conditions and with suitable degrees/shifts, configuration spaces of points canonically have the
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            over the
            %a.existingWikiWord{:href => "/nlab/show/little+n-disk+operad"} little n-disk operad
            and the
            = succeed "." do
              %span.newWikiWord
                Goodwillie derivatives of the identitity functor
                %a{:href => "/nlab/new/Goodwillie+derivatives+of+the+identitity+functor"} ?
          %p
            For more see
            %a{:href => "Goodwillie+derivatives+of+the+identity+functor#Properties"} there
          %p
            %br/
          %h3#HomologyAndStabilization Homology and stabilization in homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which is the
            %a.existingWikiWord{:href => "/nlab/show/interior"} interior
            of a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{X}
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mover
                    %mi X
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \partial \overline X
            as consisting of the “points at infinity” in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p In particular, there are then inclusion maps
          #eq:InclusionOfUnorderedConfigurationSpaces.maruku-equation
            %span.maruku-eq-number (17)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Conf
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi i
                        %mi n
                  %msub
                    %mi Conf
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Conf_n
                  \\big(
                  X
                  \\big)
                  \\overset{i_n}{\longrightarrow}
                  Conf_{n+1}
                  \\big(
                  X
                  \\big)
          %p
            of the unordered configuration space of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            points in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#UnorderedUnlabeledConfigurations"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n + 1
            points, formalizing the idea of “adding a point at infinity” to a configuration. More formally, these maps are given by pushing configuration points away from the boundary a little and then adding a new point near to a point on the boundary of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            (
            %a{:href => "#RandalWilliams13"}> Randal-Williams 13, Section 4
            )
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
            of these maps depends (just) on the
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
            of the
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mover
                    %mi X
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \partial \overline{X}
            at which one chooses to bring in the new point. But for any choice, they have the following effect on
            %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
          #HomologicalStabilizationForUnorderedConfigurationSpaces.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong (homological stabilization for unordered configuration spaces)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %li
                %p
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/interior"} interior
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
              %li
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≥
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} dim(X) \geq 2
            %p
              Then for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the inclusion
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
              %a.maruku-eqref{:href => "#eq:InclusionOfUnorderedConfigurationSpaces"} (17)
              are such that on
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              these maps induce
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphisms"} split monomorphisms
              in all degrees,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mi n
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Conf
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_\bullet
                    \\big(
                    Conf_n(X)
                    ,
                    \\mathbb{Z}
                    \\big)
                    \\overset{
                    H_\bullet( i_n, \mathbb{Z} )
                    }{\hookrightarrow}
                    H_\bullet
                    \\big(
                    Conf_{n+1}(X)
                    ,
                    \\mathbb{Z}
                    \\big)
            %p
              and in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \leq n/2
              these are even
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi p
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
