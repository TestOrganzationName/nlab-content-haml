                    Y^k
                    \\big)
                    \/\Sigma(k)
                    \\right)/\sim
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+spaces"} quotient topological spaces
              of the filter stages reproduces the above configuration spaces of a fixed number of points:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Conf
                      %mrow
                        %mo ≤
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Conf
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Conf_n(X,Y)
                    \\;\simeq\;
                    Conf_{\leq n}(X,Y) / Conf_{\leq (n-1)}(X,Y)
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              %strong (comparison to notation in the literature)
            %p
              The above Def.
              %a.maruku-ref{:href => "#ConfigurationSpacesOfnPoints"}
              is less general but possibly more suggestive than what is considered for instance in
              = succeed "." do
                %a{:href => "#Boedigheimer87"} Bödigheimer 87
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext here:
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mtext Segal 73,
                                %mtr
                                  %mtd
                                    %mtext Snaith 74
                                    %mo :
                          %mtd
                          %mtd
                            %mtext Bödigheimer 87:
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mi Conf
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi d
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
