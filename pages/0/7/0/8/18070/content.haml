                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.maruku-eqref{:href => "#eq:UnorderedLabeledFixednCOnfigurationSpace"} (6)
              by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              which regards points with vanishing label as absent.
          %center
            %img{:src => "https://ncatlab.org/nlab/files/UnorderedLabeledConfigurationOfPoints.jpg", :width => "700"}/
          #ConfigurationSpacesOfnPoints.num_defn
            %h6#definition_6 Definition
            %p
              %strong (unordered labeled configurations of a fixed number of points)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %strong
                  configuration space of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  unordered points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                disappearing at the boundary
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ∖
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_{n}(X)
                    \\;\coloneqq\;
                    \\Big(
                    \\big(
                    X^n \setminus \mathbf{\Delta}_X^n
                    \\big)
                    \/ \partial(X^n)
                    \\Big)
                    \/\Sigma(n)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} |
                    %munder
                      %mo ∃
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo =
                    %msup
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}_X^n : = \{(x^i) \in X^n | \underset{i,j}{\exists} (x^i = x^j) \}
              is the
              %a.existingWikiWord{:href => "/nlab/show/fat+diagonal"} fat diagonal
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X^n
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
              denotes the evident
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              by
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of factors of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X^n
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be another
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %strong
                  configuration space of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
                vanishing at the boundary and distinct as points in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ∖
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi Y
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ×
                    %msup
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_{n}(X,Y)
                    \\;\coloneqq\;
                    \\Big(
                    \\big(
                    (
                    X^n \setminus \mathbf{\Delta}_X^n
                    )
                    \\times
                    Y^n
                    \\big)
                    \/\Sigma(n)
                    \\Big)
                    \/ \partial(X^n \times Y^n)
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
              denotes the evident
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              by
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of factors of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi n
                      %mo ×
                      %msup
                        %mi Y
                        %mi n
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X^n \times Y^n \simeq (X \times Y)^n
            %p
              This more general definition reduces to the previous case for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mo *
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Y = \ast \coloneqq \mathbb{R}^0
              being the point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_n(X)
                    \\;=\;
                    \\mathrm{Conf}_n(X,\ast)
                    \\,.
            %p
              Finally the
              %em
                %strong configuration space of an arbitrary number of points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
                vanishing at the boundary and distinct already as points of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ⊔
                        %mrow
                          %mi n
                          %mo ∈
                          %mi 𝕟
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mi n
                      %mo ∖
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi Y
                        %mi k
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:stretchy => "false"} /
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Conf\left( X, Y\right)
                    \\;\coloneqq\;
                    \\left(
                    \\underset{n \in \mathbb{n}}{\sqcup}
                    \\big(
                    (
                    X^n \setminus \mathbf{\Delta}_X^n
                    )
                    \\times
                    Y^k
                    \\big)
                    \/\Sigma(n)
                    \\right)/\sim
            %p
              by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    (x_1, y_1), \cdots, (x_{n-1}, y_{n-1}), (x_n, y_n)
                    \\big)
                    \\;\sim\;
                    \\big(
                    (x_1, y_1), \cdots, (x_{n-1}, y_{n-1})
                    \\big)
                    \\;\;\;\; \Leftrightarrow
                    \\;\;\;\; (x_n, y_n) \in \partial (X \times Y)
                    \\,.
            %p
              This is naturally a
              %a.existingWikiWord{:href => "/nlab/show/filtered+topological+space"} filtered topological space
              with filter stages
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Conf
                      %mrow
                        %mo ≤
                        %mi n
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ⊔
                        %mrow
                          %mi k
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} }
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mi k
                      %mo ∖
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mi X
                        %mi k
                      %mo{:stretchy => "false"} )
