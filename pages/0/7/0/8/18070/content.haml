            of configuration spaces of points. See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
          %h4#Cohomology Rational cohomology
          #RealCohomologyOfConfigurationSpaceOfOrderedPointsInEuclideanSpace.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real cohomology
                of configuration spaces of ordered points in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the configuration spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Conf
                      %mrow
                        %msup
                          %mrow
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \underset{{}^{\{1,\cdots,n\}}}{Conf}\big( \mathbb{R}^D\big)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OrderedUnlabeledConfigurations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              ordered unlabeled points in
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^D
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              by elements in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} D-1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
