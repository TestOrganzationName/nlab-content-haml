                  %annotation{:encoding => "application/x-tex"}
                    Conf_{\leq n}\left( X, Y\right)
                    \\;\coloneqq\;
                    \\left(
                    \\underset{k \in \{1, \cdots, n\}}{\sqcup}
                    \\big(
