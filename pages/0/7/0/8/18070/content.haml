                  %strong 04
                  05 (1990) 1049-1057
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1142/S0217979290000528"} doi:10.1142/S0217979290000528
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
                %blockquote
                  %p
                    (for
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/sl%282%29"}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝔰𝔩
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"}> Atsushi Matsuo
                  ,
                  = succeed "," do
                    %em
                      An application of Aomoto-Gelfand hypergeometric functions to the
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} SU(n)
                      Knizhnik-Zamolodchikov equation
                  %strong 134
                  (1990) 65–77
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1007/BF02102089"} doi:10.1007/BF02102089
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
                %p
