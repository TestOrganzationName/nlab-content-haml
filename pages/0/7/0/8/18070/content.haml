              exhibits the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
