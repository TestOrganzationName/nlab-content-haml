                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "https://eudml.org/doc/143938"} dml:143938
                  %a.existingWikiWord{:href => "/nlab/files/SchechtmanVarchenko_HyperplaneArrangements.pdf", :title => "pdf"} pdf
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %p following precursor observations due to:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+S.+Dotsenko"}> Vladimir S. Dotsenko
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Vladimir+A.+Fateev"} Vladimir A. Fateev
                  = succeed "," do
                    %em Conformal algebra and multipoint correlation functions in 2D statistical models
                  %strong 240
                  3 (1984) 312-348
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1016/0550-3213(84)90269-4"} doi:10.1016/0550-3213(84)90269-4
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
