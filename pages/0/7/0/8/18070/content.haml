                  %strong 20
                  (1990) 279–283
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1007/BF00626523"} doi:10.1007/BF00626523
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"}> Vadim Schechtman
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                  = succeed "," do
