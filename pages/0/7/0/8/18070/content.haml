                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mi ℝ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mi ω
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} /
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi ω
                                %mrow
                                  %mi i
                                  %mi j
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi D
                              %msub
                                %mi ω
                                %mrow
                                  %mi j
                                  %mi i
                          %mtr
                            %mtd
                              %msub
                                %mi ω
                                %mrow
                                  %mi i
                                  %mi j
                              %mo ∧
                              %msub
                                %mi ω
                                %mrow
                                  %mi i
