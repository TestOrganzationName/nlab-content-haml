                  = succeed "," do
                    %em Integral representations of N-point conformal correlators in the WZW model
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "http://cds.cern.ch/record/1044951"} cds:1044951
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li#DateJimboMatsuoMiwa90
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Etsuro+Date"}> Etsuro Date
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Michio+Jimbo"} Michio Jimbo
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"} Atsushi Matsuo
                  = succeed "," do
