                            %annotation{:encoding => "application/x-tex"} \sigma
                %p
                  %strong 282
                  (1987) 466-494
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1016/0550-3213(87)90693-6"} doi:10.1016/0550-3213(87)90693-6
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %p
              The proof that for rational levels this construction indeed yields
              %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
              is due to:
            %ul
              %li#FeiginSchechtmanVarchenko90
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Boris+Feigin"}> Boris Feigin
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"} Vadim Schechtman
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                  = succeed "," do
                    %em On algebraic equations satisfied by correlators in Wess-Zumino-Witten models
                  %strong 20
                  (1990) 291–297
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1007/BF00626525"} doi:10.1007/BF00626525
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li#FeiginSchechtmanVarchenko94
                %p
