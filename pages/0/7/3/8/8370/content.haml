          %h3#classical Classical
          %h4#ClassicalPlain Plain
          %p Under the identifications
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"}> propositions as types
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/programs+as+proofs"}> programs as proofs
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} relation between type theory and category theory
          %p the following notions are equivalent:
          %table
            %thead
              %tr
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/intuitionistic+mathematics"} intuitionistic
                  %a.existingWikiWord{:href => "/nlab/show/logic"} logic
                  %br/
                  and
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/programming+languages"} programming languages
                  %br/
                  and
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/computation"} computation
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
                  %br/
                  and
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  A
                  %a.existingWikiWord{:href => "/nlab/show/proof"} proof
                  of a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
                  %br/
                  %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} or
                  a
                  %a.existingWikiWord{:href => "/nlab/show/term"} term
                  of some
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/type"} type
                %td{:style => "text-align: left;"}
                  A
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/program"} program
                  %a.existingWikiWord{:href => "/nlab/show/%CE%BB-term"} λ-term
                  with
                  %br/
                  output of some
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/data+type"} data type
                %td{:style => "text-align: left;"}
                  A
                  %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
                  %br/
                  of an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
