          %h3#Quantum Quantum
          %h4#QuantumPlain Plain
          %p An analogous trilogy is seen under passage:
          %ol
            %li
              %p
                from
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/logic"} logic
                %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
                to
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            %li
              %p
                from
                %a.existingWikiWord{:href => "/nlab/show/computation"} computation
                to
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            %li
              %p
                from
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
                to
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
          %p
            This is the main point of
            = succeed "," do
              %a{:href => "#Mellies06"} Melliès 06, Sec. 1
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/proof+nets"} proof nets
            = succeed ")" do
              %a{:href => "https://hal.archives-ouvertes.fr/hal-00154243/document#page=5"} p. 4
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            = succeed "," do
              %a{:href => "quantum+programming+language#AbramskyCoecke04"} Abramsky-Coecke 04
            = succeed "," do
              %a{:href => "quantum+programming+language#AbramskyDuncan05"} Abramsky &amp; Duncan 05
            = succeed ";" do
              %a{:href => "quantum+programming+language#Duncan06"} Duncan 06
            = succeed ":" do
              %a{:href => "quantum+programming+language#Pratt92"} Pratt 92
          %div{:style => "margin: -40px 0px 20px 10px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/MelliesQuantumComputationalTrilogy.jpg", :width => "510px"}/
              %figcaption{:style => "text-align: center"}
                From
                %a{:href => "#Mellies06"} Melliès 06, p. 4
          %p
            See also
            = succeed "." do
              %a{:href => "#BaezStay09"} Baez &amp; Stay 09
          %h4#QuantumParametrized Parametrized
          %p
            Combining the
            %a{:href => "#ClassicalParametrized"} classical parametrized trilogy
            with the
            = succeed "," do
              %a{:href => "#QuantumPlain"} plain quantum trilogy
          %ul
            %li
              %p
                from classical
                %a.existingWikiWord{:href => "/nlab/show/computation"} computation
                to
                %strong
                  %a{:href => "quantum+computation#ClassicalControlQuantumData"} classically controlled
                  %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
                on
                %a.existingWikiWord{:href => "/nlab/show/linear+spaces"} linear
                %a.existingWikiWord{:href => "/nlab/show/spaces+of+quantum+states"} spaces of quantum states
                parametrized over classical
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/data+types"} data types
            %li
              %p
                from
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent
                %a.existingWikiWord{:href => "/nlab/show/intuitionistic+type+theory"} intuitionistic
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
                to
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent
                  %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
                of dependent
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} stable homotopy types
            %li
              %p
                from
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+categories"} locally cartesian closed categories
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
                to
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/indexed+monoidal+categories"}> indexed monoidal categories
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/indexed+monoidal+%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/parametrized+spectra"} parametrized spectra
                %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
                is the context of
                = succeed "." do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/twisted+generalized+cohomology"} twisted
                    %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
          %p there appears the “classically controlled quantum computational tetralogy”:
          %blockquote
            %p
              (graphics from
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Topological+Quantum+Programming+in+TED-K"} SS22
          %table
            %thead
              %tr
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear
                  %br/
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
                %th
                  In
                  %a{:href => "quantum+computation#ClassicalControlQuantumData"} classically controlled
                  %br/
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/quantum+programming+languages"} quantum programming languages
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/indexed+monoidal+%28%E2%88%9E%2C1%29-categories"} indexed monoidal
                  %br/
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/parameterized+stable+homotopy+theory"} ∞-cats of par. spectra
                %th
                  In
                  %a.existingWikiWord{:href => "/nlab/show/Whitehead+generalized+cohomology+theory"} Whitehead-generalized
                  %br/
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology+theory"} twisted cohomology theory
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  A
                  %a.existingWikiWord{:href => "/nlab/show/term"} term
                  of some
                  %a.existingWikiWord{:href => "/nlab/show/type"} type
                  %br/
                  in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/context"} context
                %td{:style => "text-align: left;"}
                  A
                  %a.existingWikiWord{:href => "/nlab/show/quantum+circuit"} quantum circuit
                  %br/
                  controlled by
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/data+type"} classical data
                %td{:style => "text-align: left;"}
                  An
                  %a.existingWikiWord{:href => "/nlab/show/generalized+element"} element
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %br/
                  in a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-category"} slice
                %td{:style => "text-align: left;"}
                  A
                  %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                  %br/
                  in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
