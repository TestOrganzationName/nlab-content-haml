                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo =
                    %mi π
                    %mo ∘
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \pi_n=\pi\circ \Sigma^{-n}
          .num_example
            %h6#example_6 Example
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is arbitrary,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  is the category of
                  %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                  is taking the 0th
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0 \mathcal{C}(S,-)
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
                  out of some
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} S\in\mathcal{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is equipped with a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/t-structure"} t-structure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/heart+of+a+stable+%28%E2%88%9E%2C1%29-category"} heart
                  of the t-structure, and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                  is the canonical functor.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo =
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} = D(\mathcal{A})
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
                  of the abelian category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mo =
                        %msub
                          %mi H
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \pi=H_0
                  is the degree-0
                  %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                  functor.
              %li
                %p
                  Any of the above with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  replaced by their
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
          #GeneralizedFilteredObject.num_defn
            %h6#definition_10 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28%E2%88%9E%2C1%29-category"} filtered object in an (∞,1)-category
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is simply a
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequential diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo &lt;
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \colon (\mathbb{Z}, \lt) \to \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    X_{n-1} \to X_n \to X_{n+1} \to \cdots
                    \\,.
          %p
            This appears as (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, def. 1.2.2.9
            ).
          %p
            We will take the view that the object being filtered is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≔
                  %msub
                    %munder
                      %mi lim
                      %mo ←
                    %mi n
                  %msub
                    %mi X
                    %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \coloneqq \underset{\leftarrow}{\lim}_n X_n.
          %p
            We could also consider the sequential diagram as a filtering of its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
          #ChainComplexInStableInfinityCategory.num_defn
            %h6#definition_11 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linearly+ordered+set"} linearly ordered set
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi I
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; I^{\Delta[1]} \longrightarrow \mathcal{C}
            %p such that
            %ol
              %li
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi I
                        %annotation{:encoding => "application/x-tex"} n \in I
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} F(n,n) \simeq 0
                  is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ≤
                        %mi j
                        %mo ≤
                        %mi k
                      %annotation{:encoding => "application/x-tex"} i \leq j \leq k
                  the induced
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        F(i,j) &amp;\longrightarrow&amp; F(i,k)
                        \\\
                        \\downarrow &amp;&amp; \downarrow
                        \\\
                        F(j,j) &amp;\longrightarrow&amp; F(j,k)
                        }
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  square.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, def. 1.2.2.2
          .num_remark
            %h6#remark_10 Remark
            %p
              Given a
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#ChainComplexInStableInfinityCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mo ≔
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_n \coloneqq \Sigma^{-n} F(n,n+1)
            %p
              and defining a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              induced from the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphisms"} connecting homomorphisms
              of the defining
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(n-1,n) \to F(n-1, n+1) \to F(n,n+1)
            %p
              yields an ordinary
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, remark 1.2.2.3
            )
          #ChainComplexesFromFilteredObjects.num_prop
            %h6#proposition_3 Proposition
            %p
              Consider the inclusion of
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo ≤
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{Z}, \leq)
                    \\to
                    (\mathbb{Z}\cup \{\infty\}, \leq)^{\Delta[1]}
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    n \mapsto (n,\infty)
                    \\,.
            %p
              The induced
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo ≤
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Func((\mathbb{Z}\cup \{\infty\}, \leq)^{\Delta[1]} , \mathcal{C})
                    \\longrightarrow
                    Func((\mathbb{Z}, \leq), \mathcal{C})
            %p
              restricts to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
              between the (∞,1)-category of
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\cup \{\infty\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ChainComplexInStableInfinityCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, lemma 1.2.2.4
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mo ,
                  %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\bullet,\bullet)
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi n
                  %mo +
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} fib
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi n
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mi r
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} X(n, n+r) = \operatorname{fib}(X_n\to X_{n+r}).
          .num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
