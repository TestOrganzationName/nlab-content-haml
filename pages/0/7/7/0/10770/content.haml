                      %mi Spec
                    %annotation{:encoding => "application/x-tex"} E \in Spec
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msub
                      %mi L
                      %mi E
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow L_E X
              in prop.
              %a.maruku-ref{:href => "#LocalizationCofiber"}
              exhibit the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28infinity%2C1%29-category"} localization of an (infinity,1)-category
              called
              %strong Bousfield localization
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          #EModulesAreELocal.num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.maruku-ref{:href => "#AcyclicAndLocal"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie, Lecture 20, example 5
          .num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
              over an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %mi Spectra
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge_S^{\bullet+1}}\wedge_S X \;\colon\; \Delta \longrightarrow Spectra
                    \\,.
            %p
              By example
              %a.maruku-ref{:href => "#EModulesAreELocal"}
              each term is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %munder
                      %mi lim
                      %mo ←
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \underset{\leftarrow}{\lim} E^{\wedge_S^{\bullet+1}} \wedge_S X
            %p
              factors through the
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mo ⟶
                    %munder
                      %mi lim
                      %mo ←
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow
                    L_E X
                    \\longrightarrow
                    \\underset{\leftarrow}{\lim} E^{\wedge_S^{\bullet+1}} \wedge_S X
                    \\,.
            %p
              Under suitable condition the second map here is indeed an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              of the dual
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              exhibits the
              = succeed "-localization." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
          .num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mi H
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq H \mathbb{Z}/p\mathbb{Z}
            %p
              be the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              under the
              %a{:href => "module+spectrum#StableDoldKanCorrespondence"} stable Dold-Kan corespondence
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.maruku-ref{:href => "#AcyclicAndLocal"}
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              groups being
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[p^{-1}]
            %p
              The
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/p-localization"} p-localization
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie, Lecture 20, example 8
          %h3#chromatic_layers Chromatic layers
          %p Let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                be a
                %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfect field
                of
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                be a
                %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
                of
                %a.existingWikiWord{:href => "/nlab/show/height+of+a+formal+group"} height
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
          .num_defn
            %h6#definition_9 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ring+of+Witt+vectors"} ring of Witt vectors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ≔
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    R \coloneqq W(k)[ [ v_1, \cdots, v_{n-1} ] ]
            %p
              for the ring of
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              over this ring, in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+ring"} Lubin-Tate ring
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+formal+group"} Lubin-Tate formal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{f}
              is the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
              deformation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in that for every
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal thickening
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{f}
              induces a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Def
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{/k}(R,A) \stackrel{\simeq}{\longrightarrow} Def(A)
            %p
              between the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the
              %a.existingWikiWord{:href => "/nlab/show/deformations"} deformations
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie 10, lect 21, theorem 5
          %p
            By the discussion there, this is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Landweber+exactness"} Landweber exact
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/Landweber+exact+functor+theorem"} Landweber exact functor theorem
            there is an
            %a.existingWikiWord{:href => "/nlab/show/even+periodic+cohomology+theory"} even periodic cohomology theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} E(n)^\bullet
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented by
            a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(n)
            with the property that its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi β
                    %mrow
                      %mo ±
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\pi_\bullet(E(n))
                  \\simeq
                  W(k)[ [v_1, \cdots, v_{n-1} ] ] [ \beta^{\pm 1} ]
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            of degree 2. This is called alternatively
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E-theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+theory"} Lubin-Tate theory
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Johnson-Wilson+theory"} Johnson-Wilson theory
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie, lect 22
          %p
            For each
            %a.existingWikiWord{:href => "/nlab/show/prime"} prime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            and for each
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            there is a
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} Bousfield localization of spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi n
                  %mo ≔
                  %msub
                    %mi L
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  L_n \coloneqq L_{E(n)}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(n)
            is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E-theory
            (for the given
            %a.existingWikiWord{:href => "/nlab/show/prime"} prime
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
