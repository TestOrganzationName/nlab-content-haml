          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie, Lecture 20, example 4
          .num_defn
            %h6#definition_8 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
