          %h3#CanonicalCosimplicialResolutionOfEInfinityAlgebras
            Canonical cosimplicial resolution of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            We discuss now the special case of coskeletally filtered totalizations coming from the canonical cosimplicial objects induced from
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebras"} E-∞ algebras
            (dual
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerves"} Cech nerves
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Sweedler+corings"} Sweedler corings
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Amitsur+complexes"} Amitsur complexes
          %p
            In this form this appears as (
            %a{:href => "#LurieLecture"}> Lurie 10, theorem 2
            ). A review is in (
            %a{:href => "#Wilson13"}> Wilson 13, 1.3
            ). For the analog of this in the traditional formulation see (
            %a{:href => "#Ravenel"}> Ravenel, ch. 3, prop. 3.1.2
            ).
          #FiltrationOfTotalizationByTotalizationOfCoskeleta.num_defn
            %h6#definition_14 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} cosimplicial object in an (∞,1)-category
              with
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    Y \;\colon\; \Delta  \longrightarrow \mathcal{C}
            %p
              its
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mi Y
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Tot Y \simeq \underset{\leftarrow}{\lim}_n Y_n
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtered
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
              %a.existingWikiWord{:href => "/nlab/show/coskeleta"} coskeleta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mi Y
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 2
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 1
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 0
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tot Y
                    \\to
                    \\cdots
                    \\to
                    Tot (cosk_2 Y)
                    \\to
                    Tot (cosk_1 Y)
                    \\to
                    Tot (cosk_0 Y)
                    \\to 0
                    \\,.
          #SpectralSequenceOfSimplicialStableHomotopyType.num_defn
            %h6#definition_15 Definition
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} filtration spectral sequence
              = succeed "," do
                %a.maruku-ref{:href => "#FiltrationSpectralSequence"}
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              by
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleta
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiltrationOfTotalizationByTotalizationOfCoskeleta"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, prop. 1.2.4.5
            )
          #E2PageByMooreComplex.num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
              has as first page/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              \-term the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              associated with the
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+objects"} cosimplicial objects
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo −
                        %mi q
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_2^{p,q}
                    \=
                    H^p(\pi_q(Tot (cosk_\bullet(Y))))
                    \\Rightarrow
                    \\pi_{p-q} Tot(Y)
                    \\,.
          %p
            By the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dold-Kan+correspondence"} ∞-Dold-Kan correspondence
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, remark 1.2.4.4
            = succeed ")." do
              %a{:href => "#Wilson13"} Wilson 13, theorem 1.2.4
          .num_defn
            %h6#definition_16 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \longrightarrow E
                    \\,.
            %p
              The
              %em
                canonical
                %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
              associated to this (the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Amitsur+complex"} Amitsur complex
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo →
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge^{\bullet+1}_S} \;\colon\; \Delta \to \mathcal{C}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo →
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge^{\bullet+1}_S}\wedge_S X \;\colon\; \Delta \to \mathcal{C}
                    \\,.
          #FlatnessCondition.num_prop
            %h6#proposition_7 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is such that the self-
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ∧
                      %mi S
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(E) \coloneqq \pi_\bullet(E \wedge_S E)
              (the dual
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Steenrod+operations"} Steenrod operations
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo ≔
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet \coloneqq \pi_\bullet(E)
              it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mrow
                      %mo (
                      %msup
                        %mi E
                        %mrow
                          %msubsup
                            %mo ∧
                            %mi S
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                      %msub
                        %mo ∧
                        %mi S
                      %mi X
                      %mo )
                    %mo ≃
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi E
                          %mo •
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
