                    %msup
                      %mi d
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d^r\circ d^r = 0
              and there are natural (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo ≅
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{r+1}\cong \operatorname{ker}(d^r)/\operatorname{im}(d^r).
            %p
              Thus,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mo *
                        %mo ,
                        %mo *
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \{E^r_{*,*}\}_{r\geq 1}
              is a bigraded
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
