            ”.
          %h3#bousfield_localization_of_spectra Bousfield localization of spectra
          #AcyclicAndLocal.num_defn
            %h6#definition_7 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
