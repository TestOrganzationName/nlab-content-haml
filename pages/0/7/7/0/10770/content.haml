          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, construction 1.2.2.6
            )
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
