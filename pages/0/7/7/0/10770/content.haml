            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed ")" do
              %a{:href => "#LurieHigherAlgebra"} Lurie, Higher Algebra, section 1.2.2
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            which computes homotopy groups of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie 10, lectures 8 and 9
            %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            of the
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            filtration on the dual
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
            yields the
            = succeed "-localization." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                \-
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            = succeed ")." do
              %a{:href => "#Wilson13"} Wilson 13
          %p First we recall
          %ul
            %li
              %a{:href => "#SpectralSequencesForHomotopyGroupsOfFilteredObjects"} Spectral sequences computing homotopy groups of filtered objects
          %p
            for the general case of filtered objects in suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
          %ul
            %li
