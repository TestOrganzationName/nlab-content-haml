                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
