          %h3#chromatic_formulation Chromatic formulation
          %p
            The above tables, example
            = succeed "," do
              %a.maruku-ref{:href => "#TableOfPPrincipalComponentsInHomotopyGroups"}
            %a.existingWikiWord{:href => "/nlab/show/image+of+the+J-homomorphism"} image of the J-homomorphism
            is in some sense the “lowest order layer” of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            = succeed "." do
              %a{:href => "#ELocalStableHomotopyTheory"} below
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(1)
            for the first
            %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E-theory
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            at given
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} L_{E(1)}\mathbb{S}
            for the
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} Bousfield localization of spectra
