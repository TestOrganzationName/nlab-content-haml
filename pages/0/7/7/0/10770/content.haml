              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+model+structure"} cartesian closed
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on compactly generated topological spaces
              (and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
