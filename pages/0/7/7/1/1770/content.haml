                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{\underset{CartSp^{op}}{\longleftarrow}}{\lim}
                    C(\{U_i\}_i)
                    \&amp; \simeq
                    \\left(
                    \\array{
                    \\underset{\underset{CartSp^{op}}{\longleftarrow}}{\lim}
                    \\underset{i,j}{\coprod} y(U_i \underset{\mathbb{R}^n}{\cap} U_j)
                    \\\
                    \\big\downarrow \big\uparrow \big\downarrow
                    \\\
                    \\underset{\underset{CartSp^{op}}{\longleftarrow}}{\lim}
                    \\underset{i}{\coprod} y(U_i)
                    }
                    \\phantom{A}
                    \\right)
                    \\\
