                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
