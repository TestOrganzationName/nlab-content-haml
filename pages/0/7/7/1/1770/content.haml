                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %h3#distribution_theory Distribution theory
          %p
            Since a space of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is canonically a smooth set, it is natural to consider the
            %em smooth
            %a.existingWikiWord{:href => "/nlab/show/linear+functionals"} linear functionals
            on such
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functionals"} continuous linear functionals
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distributional+densities"} distributional densities
            %em
              %a.existingWikiWord{:href => "/nlab/show/distributions+are+the+smooth+linear+functionals"} distributions are the smooth linear functionals
            for details.
          %h2#VariantsAndGeneralizations Variants and generalizations
          %h3#synthetic_differential_geometry Synthetic differential geometry
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi smooth
                %annotation{:encoding => "application/x-tex"} {}_{smooth}
            may be replaced by the site
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi th
                %annotation{:encoding => "application/x-tex"} {}_{th}
            (see there) whose objects are products of smooth Cartesian spaces with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi CartSp
                    %mi th
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(CartSp_{th})
            is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            (a “
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"}> smooth topos
            ”), which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(CartSp)
            is not.
          %p
            The two toposes are related by an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            of functors that witness the fact that the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi CartSp
                    %mi th
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(CartSp_{th})
            are possiby infinitesimal extensions of objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"} synthetic differential ∞-groupoid
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"}> smooth groupoid
              ,
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"}
                smooth
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %div
