                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{\underset{CartSp^{op}}{\longrightarrow}}{\lim}
                    C(\{U_i\}_i)
                    \&amp; \simeq
                    \\left(
                    \\array{
                    \\underset{\underset{CartSp^{op}}{\longrightarrow}}{\lim}
                    \\underset{i,j}{\coprod} y(U_i \underset{\mathbb{R}^n}{\cap} U_j)
                    \\\
