          .num_lemma
            %h6#lemma_2 Lemma
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmthSet
                  %annotation{:encoding => "application/x-tex"} SmthSet
              has
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
