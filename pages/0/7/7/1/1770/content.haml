                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi CartSp
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0
                    \\underset{\underset{CartSp^{op}}{\longleftarrow}}{\lim}
                    C(\{U_i\}_i)
                    \\;\simeq\;
                    Hom_{CartSp}(\ast, \mathbb{R}^n)
                    \\,.
          %h3#topos_points_and_stalks Topos points and stalks
          .num_lemma
            %h6#lemma Lemma
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \in N
              there is a
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} topos point
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo :
                    %mi Set
                    %mover
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mi D
                            %mo *
                            %mi n
                      %mover
                        %mo ←
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi D
                            %mi n
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                    %mi SmthSet
                  %annotation{:encoding => "application/x-tex"}
                    D^n : Set \stackrel{\stackrel{(D^n)^*}{\leftarrow}}
                    {\stackrel{D^n_*}{\to}}
                    SmthSet
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              morphism – the
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              – is given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi SmthSet
                  %annotation{:encoding => "application/x-tex"} A \in SmthSet
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi A
                    %mo :
                    %mo =
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ⊃
                        %mi U
                        %mo ∋
                        %mn 0
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (D^n)^* A :=
                    \\colim_{\mathbb{R}^n \supset U \ni 0} A(U)
                    \\,,
            %p
              where the colimit is over all open neighbourhoods of the origin in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
