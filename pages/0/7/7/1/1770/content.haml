                    \\;\simeq\;
                    \\left(
                    \\array{
                    \\underset{i,j}{\coprod} y(U_i \underset{\mathbb{R}^n}{\cap} U_j)
                    \\\
                    \\big\downarrow \big\uparrow \big\downarrow
                    \\\
                    \\underset{i}{\coprod} y(U_i)
                    }
                    \\right)
                    \\,.
            %p
              where we used the defining property of
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              to identify
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi X
                      %mi y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo ∩
                        %mi X
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y(U_i) \times_X y(U_j) \simeq y( U_i \cap_X U_j )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CechGroupoidForCartSp"} (2)
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/reflexive+graph"} reflexive
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed
              %a.existingWikiWord{:href => "/nlab/show/graphs"} graphs
              (hence ignoring
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              for the moment), is readily seen to be the
              %a.existingWikiWord{:href => "/nlab/show/graph"} graph
              of the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of the components (the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              follows immediately from that of the component colimits):
            #eq:ColimitOfCechGroupoidOverCartSp.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
