                      %mi ℂ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mi k
                    %msub
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi MU
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} S^{2k} = Th(\mathbb{C}^{k}) \to Th( \mathbb{C}^k \times_{U(k)} E U(k) ) = MU_{2k}
              the canonical inclusion):
            #eq:InTermsOfHomotopyGroupsOfQuotientedThomSpace.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
