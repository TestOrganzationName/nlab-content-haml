                        %mn 1
                      %mrow
                        %mi U
                        %mo ,
                        %mi f
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi fr
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
