                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-manifold"} (U,fr)-manifold
          #EInvariantIsToddClassOnCoboundingUFrManifold.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/e-invariant+is+Todd+class+of+cobounding+%28U%2Cfr%29-manifold"}> e-invariant is Todd class of cobounding (U,fr)-manifold
                )
            %p
              Evaluation of the
              %a.existingWikiWord{:href => "/nlab/show/Todd+class"} Todd class
              on
              %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-manifolds"} (U,fr)-manifolds
              yields
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              which are
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              on actual
              = succeed "-manifolds." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %a.maruku-eqref{:href => "#eq:ShortExactSequenceOfUFrBordismRings"} (2)
              that assigning to
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
