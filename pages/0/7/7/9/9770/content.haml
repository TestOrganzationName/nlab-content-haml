              is represented by maps into the
              %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi MU
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} MU_{2k}/S^{2k}
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
