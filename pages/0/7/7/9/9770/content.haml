                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %mi E
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \phi_E \;\colon\; E(X) \overset{\simeq}{\to} E\big( Th(V)\big)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi H
                        %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Td
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{H\mathbb{Q}}
                    \\big(
                    Td(V)
                    \\big)
                    \\;=\;
                    ch\big( th(V) \big)
                    \\,.
            %p
              More generally , for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in K(X)
              any class, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi H
                        %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ch
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi Td
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi ϕ
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{H\mathbb{Q}}
                    \\big(
                    ch(x)
                    \\cup
                    Td(V)
                    \\big)
                    \\;=\;
                    ch\big( \phi_{K}(x) \big)
                    \\,,
            %p
              which specializes to the previous statement for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} x = 1
          %p
            (
            %a{:href => "#Karoubi78"}> Karoubi 78, Chapter V, Theorem 4.4
            )
          %h3#RelationToAdamsEInvariant Relation to the Adams e-invariant
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/e-invariant"} e-invariant
            in its
            = succeed "-incarnation" do
              %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
            = succeed ")" do
              %a{:href => "e-invariant#eInvariantInComplexTopologicalKtheoryAsRationalNumberModuloIntegers"} this Def.
            %a.existingWikiWord{:href => "/nlab/show/cobordism+theory"} cobordism theory
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66
            ), by evaluating Todd classes on
            %a.existingWikiWord{:href => "/nlab/show/coboundary"} cobounding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-manifolds"} (U,fr)-manifolds
          %p
            This is Prop.
            %a.maruku-ref{:href => "#EInvariantIsToddClassOnCoboundingUFrManifold"}
            below; but first to recall some background:
          .num_remark
            %h6#remark Remark
            %p
              In generalization to how the
              %a.existingWikiWord{:href => "/nlab/show/U-bordism+ring"} U-bordism ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
