              %p
                %a{:href => "https://ethz.ch/de/die-eth-zuerich/organisation/who-is-who/emeritierte-professorinnen-und-professoren/details.NzczMzA=.TGlzdC80MDEsMTk1NzY4MzcwOQ==.html"} institute page
            %li
