              %p
                %a{:href => "https://scholar.google.com/citations?user=y_wpkH8AAAAJ&hl=vi"} GoogleScholar page
          %h2#selected_writings Selected writings
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Jones+polynomial"} Jones polynomial
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
              , C. King,
              = succeed "," do
                %em The Chern-Simons theory and knot polynomials
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.cmp/1104179728"} euclid.cmp/1104179728
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/anyons"} anyons
            and
            %a.existingWikiWord{:href => "/nlab/show/braid+group+statistics"} braid group statistics
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+quantum+field+theory"} algebraic quantum field theory
          %ul
            %li#FroehlichMarchetti88
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pieralberto+Marchetti"} Pieralberto Marchetti
                = succeed "," do
                  %em Quantum field theory of anyons
                %strong 16
                (1988) 347–358 (reprinted in
                = succeed ")" do
                  %a{:href => "#Wilczek90"} Wilczek 1990, p. 202-213
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/BF00402043"} doi:10.1007/BF00402043
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fabrizio+Gabbiani"} Fabrizio Gabbiani
                = succeed "," do
                  %em Braid statistics in local quantum theory
                %strong 2
                03 (1990) 251-353
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1142/S0129055X90000107"} doi:10.1142/S0129055X90000107
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p
            and making explicit the role of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
          %ul
            %li#FroehlichGabbianiMarchetti90
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fabrizio+Gabbiani"} Fabrizio Gabbiani
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pieralberto+Marchetti"} Pieralberto Marchetti
              = succeed "," do
                %em Braid statistics in three-dimensional local quantum field theory
              %em Physics, Geometry and Topology
              NATO ASI Series,
              %strong 238
              Springer (1990) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/978-1-4615-3802-8_2"}> doi:10.1007/978-1-4615-3802-8_2
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/FroehlichGabbianiMarchetti-BraidStatistics.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/abelian+Chern-Simons+theory"} abelian Chern-Simons theory
            as an
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            for the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+effect"} fractional quantum Hall effect
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                , T. Kerler:
                = succeed "," do
                  %em Universality in quantum Hall systems
                %strong 354
                2–3 (1991) 369-417 [
                %a{:href => "https://doi.org/10.1016/0550-3213(91)90360-A"}> doi:10.1016/0550-3213(91)90360-A
                ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Anthony+Zee"} Anthony Zee
                = succeed "," do
                  %em Large scale physics of the quantum hall fluid
                %strong 364
                3 (1991) 517-540 [
                %a{:href => "https://doi.org/10.1016/0550-3213(91)90275-3"}> doi:10.1016/0550-3213(91)90275-3
                ]
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
          %ul
            %li#Froehlich92
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
              ,
              = succeed "," do
                %em Non-perturbative quantum field theory – Mathematical Aspects and Applications
              = succeed ")" do
                %a{:href => "https://doi.org/10.1142/1245"} doi:10.1142/1245
          %p
            Early discussion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/conformal+nets"} conformal nets
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fabrizio+Gabbiani"}> Fabrizio Gabbiani
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"} Jürg Fröhlich
              = succeed "," do
                %em Operator algebras and conformal field theory
              %strong 155
              3 (1993) 569–640 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF02096729"}> doi:10.1007/BF02096729
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/supersymmetric+quantum+mechanics"} supersymmetric quantum mechanics
            from the point of view of
            %a.existingWikiWord{:href => "/nlab/show/spectral+geometry"} spectral geometry
            (“
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"}> noncommutative geometry
            ”):
          %ul
            %li#FGR96
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
              , Oiver Grandjean,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andreas+Recknagel"} Andreas Recknagel
              = succeed "," do
                %em Supersymmetric quantum theory and (non-commutative) differential geometry
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9612205"} arXiv:hep-th/9612205
          %p
            and with an eye towards the
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2-spectral+triples"} 2-spectral triples
          %ul
            %li#FGR97
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
              , Oliver Grandjean,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andreas+Recknagel"} Andreas Recknagel
              %em Supersymmetric quantum theory, non-commutative geometry, and gravitation
              Lecture Notes Les Houches (1995) (
              %a{:href => "http://arxiv.org/abs/hep-th/9706132"}> arXiv:hep-th/9706132
              ).
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
            and
            %a.existingWikiWord{:href => "/nlab/show/BV-formalism"} BV-formalism
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+field+theories"} topological field theories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Juerg+Froehlich"} Juerg Froehlich
              = succeed "," do
                %em Topological Field Theory Interpretation of String Topology
              %strong 240
              (2003) 397–421 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00220-003-0917-2"}> doi:10.1007/s00220-003-0917-2
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/math/0202176"} arXiv:math/0202176
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} defects
            and
