                            %mn 7
                        %annotation{:encoding => "application/x-tex"} E_7
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cube"}> cube
                    ,
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/octahedron"} octahedron
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/octahedral+group"} octahedral group
                    %br/
