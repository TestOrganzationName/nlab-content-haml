                      %semantics
                        %mrow
                          %mi O
                        %annotation{:encoding => "application/x-tex"} O
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+octahedral+group"} binary octahedral group
                    %br/
