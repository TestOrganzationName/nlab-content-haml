                    }
            %p
              (This exists even without assuming
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial factorization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi β
                    %annotation{:encoding => "application/x-tex"} p_\beta
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi α
                    %annotation{:encoding => "application/x-tex"} j_\alpha
            %p
              Now consider the pullback of the right square above along the naturality square of
              = succeed "," do
