                    \\downarrow^{\mathrlap{Q(\tilde p)}}_{\mathrlap{}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{Q(p)}}
                    \\\
                    Y
                    \&amp;\underset{\eta_Y}{\longrightarrow}&amp;
                    Q(Y)
                    \&amp;\underoverset{Q(\eta_Y)}{\in W}{\longrightarrow}&amp;
                    Q(Q(Y))
                    }
                    \\,,
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi η
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} Q(p^\ast \eta_Y) \in W
              since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %msub
                        %mi η
                        %mi Y
                      %mo ∈
                      %msub
                        %mi W
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} p^\ast \eta_Y \in W_Q
              = succeed ")," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyPullbackOfWeakEquivalences"} prop.
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for homotopy pullbacks (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClosurePropertiesOfHomotopyPullbacks"}> prop.
              ).
            %p
              So far this establishes that the
              = succeed "-naturality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde p
              is a homotopy pullback. We still need to show that also the
              = succeed "-naturality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a homotopy pullback.
            %p
              Factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde i
              as a cofibration followed by an acyclic fibration. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde i
              is also a
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              for
              = succeed "-fibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
