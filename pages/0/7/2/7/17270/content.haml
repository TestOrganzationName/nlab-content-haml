                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi Cof
                              %mi i
                          %mtd
                            %mi Z
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi Fib
                              %mi p
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mrow
                                      %mi Q
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi Z
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mrow
                                      %mi Q
                                      %mo{:stretchy => "false"} (
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mi Q
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo{:stretchy => "false"} )
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f
                    \\colon
                    \&amp;
                    Q(X)
                    \&amp;\underoverset{\in W \cap Cof}{i}{\longrightarrow}&amp;
                    Z
                    \&amp;\underoverset{\in Fib}{p}{\longrightarrow}&amp;
                    Q(Y)
                    \\\
                    \&amp;
                    \\downarrow^{\mathrlap{\eta_{Q(X)}}}_{\mathrlap{\in W}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\eta_Z}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\eta_{Q(Y)}}}_{\mathrlap{\in W}}
                    \\\
                    \&amp;
                    Q(Q(X))
                    \&amp;\underoverset{Q(i)}{\in W}{\longrightarrow}&amp;
                    Q(Z)
                    \&amp;\underset{}{\longrightarrow}&amp;
