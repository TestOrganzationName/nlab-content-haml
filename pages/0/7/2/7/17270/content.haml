                  %annotation{:encoding => "application/x-tex"} f
              as a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              (in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RetractsOfMorphisms"} rmk.
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
