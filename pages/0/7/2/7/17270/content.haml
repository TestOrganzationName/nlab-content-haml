              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CategoryWithWeakEquivalences"}> def.
              ) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              and then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\pi,f)
              are weak equivalences.
          #BousfieldFriedlanderTheorem.num_prop
            %h6#proposition Proposition
            %p
              %strong (Bousfield-Friedlander theorem)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Q \colon \mathcal{C} \longrightarrow \mathcal{C}
              a Quillen idempotent monad according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_Q
              %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
          %p
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, theorem 8.7
            ,
            = succeed "," do
              %a{:href => "#Bousfield01"} Bousfield 01, theorem 9.3
            = succeed ")" do
              %a{:href => "#GoerssJardine96"} Goerss-Jardine 96, chapter X lemma 4.5, lemma 4.6
          .proof
            %h6#proof_3 Proof
            %p
              The existence of
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              is guaranteed since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is already assumed to be a model category. The
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              poperty for
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Moreover, according to lemma
              %a.maruku-ref{:href => "#FirstLemmaForBousfieldFriedlander"}
              the pair of classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cof_{Q}, W_Q \cap Fib_Q)
              equals the pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Cof
                      %mo ,
                      %mi W
                      %mo ∩
                      %mi Fib
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Cof, W \cap Fib)
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              by the model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Hence it remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_Q \cap Cof_Q, \; Fib_Q)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi Q
                    %mo =
                    %mi RLP
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib_Q = RLP(W_Q \cap Cof_Q)
              holds by definition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fib
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} Fib_Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} W_Q \cap Cof_Q
              followed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fib
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} Fib_Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo =
                    %mi LLP
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W_Q \cap Cof_Q = LLP(Fib_Q)
              follows from the
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              (and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} W_Q
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} Cof_Q
              are stable under retracts, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cof
                    %mo =
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} Cof = Cof_Q
              are).
            %p
              So we may conclude by showing the existence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_Q \cap Cof_Q, \; Fib_Q)
              factorizations:
            %p
              First we consider the case of a morphism of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \colon Q(Y) \to Q(Y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Cof
                      %mrow
                        %mo ∈
                        %mi i
                    %mi Z
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                      %mi p
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    Q(X)
                    \\underoverset{\in W \cap Cof}{\in i}{\longrightarrow}
                    Z
                    \\underoverset{\in Fib}{p}{\longrightarrow}
                    Q(Y)
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is already a
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi Q
