              replaced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_Q \cap Cof_Q, Fib_Q)
              and using lifting in the
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
