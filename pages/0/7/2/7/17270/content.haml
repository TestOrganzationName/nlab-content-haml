                                %mrow
                                  %msub
                                    %mi η
                                    %mi Y
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
