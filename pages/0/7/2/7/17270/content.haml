          %h2#idea Idea
          %p
            In
            = succeed "-theory," do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %em Bousfield-Friedlander theorem
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, theorem A.7
            ,
            = succeed ")" do
              %a{:href => "#Bousfield01"} Bousfield 01, theorem 9.3
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} Q \colon \mathcal{C} \to \mathcal{C}
            on a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            behaves like an
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
            in an appropriate model category theoretic sense, then the
            %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            at the
            = succeed "-equivalences" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          %p
            The original proof assumed that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} right-proper model category
            = succeed ")." do
              %a{:href => "#Stanculescu08"} Stanculescu 08, theorem 1.1
          %h2#statement Statement
          #QuillenIdempotentMonad.num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
              %strong Quillen idempotent monad
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ⟶
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Q \;\colon\;  \mathcal{C} \longrightarrow \mathcal{C}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi id
                          %mi 𝒞
                        %mo ⟶
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} \eta \colon id_{\mathcal{C}} \longrightarrow Q
            %p such that
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"}> homotopical functor
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  preserves weak equivalences;
              %li
                %p
                  (idempotency) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                  the morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi η
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %mi W
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Q(\eta_X) \;\colon\; Q(X) \overset{\in W}{\longrightarrow} Q(Q(X))
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mrow
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %mi W
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\eta_{Q(X)} \;\colon\; Q(X) \overset{\in W}{\longrightarrow} Q(Q(X))
                %p are weak equivalences;
              %li
                %p
                  (right-properness of the localization) if in a
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  square in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi f
                                  %mo *
                                %mi W
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                                    %mi h
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi f
                            %mtr
                              %mtd
                                %mi W
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi h
                              %mtd
                                %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        f^\ast W &amp;\stackrel{f^\ast h}{\longrightarrow}&amp; X
                        \\\
                        \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                        \\\
                        W &amp;\stackrel{h}{\longrightarrow}&amp; Y
                        }
                %p we have that
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
                      is a fibration;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi η
                              %mi X
                          %annotation{:encoding => "application/x-tex"} \eta_X
                      ,
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi η
                                %mi Y
                            %annotation{:encoding => "application/x-tex"} \eta_Y
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Q(h)
                      are weak equivalences
                %p
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mi h
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q(f^\ast h)
                  is a weak equivalence.
          %p
            (Here the formulation of the third item follows
            = succeed "." do
              %a{:href => "#Bousfield01"} Bousfield 01, def. 9.2
            %a.maruku-ref{:href => "#SecondLemmaForBousfieldFriedlander"}
            below this condition implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            = succeed "-fibration," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed ")." do
              %a{:href => "#BousfieldFriedlander78"} Bousfield-Friedlander 78 (A.6)
          #ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Q \colon \mathcal{C} \longrightarrow \mathcal{C}
              a Quillen idempotent monad according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
                    \-weak equivalence
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q(f)
                  is a weak equivalence;
              %li
                %p
                  %strong
                    a
                    = succeed "-cofibration" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                          %annotation{:encoding => "application/x-tex"} Q
                  if it is a cofibration.
              %li
                %p
                  %strong
                    a
                    = succeed "-fibration" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                          %annotation{:encoding => "application/x-tex"} Q
                  if it has the
                  %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                  against the morphisms that are both (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  \-)cofibrations as well as
                  = succeed "-weak" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_Q
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with these classes of morphisms.
          #FirstLemmaForBousfieldFriedlander.num_lemma
            %h6#lemma Lemma
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_Q
              precisely if it is an acyclic fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a fibration and a weak equivalence. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              preserves weak equivalences by condition 1 in def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is also a
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has right lifting against
              = succeed "-cofibrations," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibrations," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            %p
              In the other direction, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Cof
                      %mi i
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \colon \underoverset{\in Cof}{i}{\longrightarrow} \underoverset{\in W \cap Fib}{p}{\longrightarrow}
                    \\,.
            %p
              Now the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              preserves weak equivalences together with
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of the acyclic fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          #SecondLemmaForBousfieldFriedlander.num_lemma
            %h6#lemma_2 Lemma
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is a fibration, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                    %mo ,
                    %msub
                      %mi η
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \eta_X, \eta_Y
              are weak equivalences, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
          %p
            (e.g.
            = succeed ")." do
              %a{:href => "#GoerssJardine96"} Goerss-Jardine 96, chapter X, lemma 4.4
          .proof
            %h6#proof_2 Proof
            %p
              We need to show that for every
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %msub
                                    %mi W
                                    %mi Q
                                  %mo ∩
                                  %msub
                                    %mi Cof
                                    %mi Q
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mi β
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{i}}_{\mathllap{\in W_Q \cap Cof_Q}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f}}
                    \\\
                    B &amp;\underset{\beta}{\longrightarrow}&amp; Y
                    }
            %p there exists a lifting.
            %p
              To that end, first consider a factorization of the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              of this square as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi Q
                                %mo{:stretchy => "false"} (
                                %mi α
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi Q
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Q
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Q
                                %mo{:stretchy => "false"} (
                                %mi β
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
