                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi π
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi j
                                  %mi β
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi Cof
