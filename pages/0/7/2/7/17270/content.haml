                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                        %mtr
                          %mtd
                            %mi β
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
