                        %mo ∈
                        %msub
                          %mi Fib
                          %mi Q
                      %mi p
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
