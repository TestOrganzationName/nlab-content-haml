                    Z
                    \&amp;\underoverset{\in Fib}{p_\alpha}{\longrightarrow}&amp;
                    Q(X)
                    \\\
                    {}^{\mathllap{Q(i)}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\pi}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{Q(f)}}
                    \\\
