                  %annotation{:encoding => "application/x-tex"}
                    K_\alpha(X)^0
                    \\coloneqq
                    \\Gamma_X(P^\alpha \times_{P U(\mathcal{H})} (K U)_0)
                    \\,.
            %p
              Similarily the reduced
              = succeed "-twisted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
