          %h2#idea Idea
          %p
            %em Twisted K-theory
            is a
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            version of (
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"}> topological
            )
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
          %p
            The most famous twist is by a class in degree 3
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            (geometrically a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            or
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+2-group"} circle 2-group
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          %h2#definition Definition
          %h3#by_sections_of_associated_bundles
            By sections of associated
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi U
                  %annotation{:encoding => "application/x-tex"} K U
          %p
            Write
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            for the
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            of complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo ×
                  %mi ℤ
                  %mo =
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo →
                    %mi n
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  B U \times \mathbb{Z} = {\lim_\to}_n B U(n) \times \mathbb{Z}
          %p
            or the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fred
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fred(\mathcal{H})
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mi U
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo ≃
                  %mi B
                  %mi U
                  %mo ×
                  %mi ℤ
                  %mo ≃
                  %mi Fred
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (K U)_0 \simeq B U \times \mathbb{Z} \simeq Fred(\mathcal{H})
                  \\,.
          %p
            The ordinary
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            of a suitable
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is given by the set of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps from (the
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mi U
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  K(X)_\bullet \simeq [X, (K U)_\bullet]
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P U(\mathcal{H})
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mi U
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (K U)_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %msub
                    %mi U
                    %mn 0
                %annotation{:encoding => "application/x-tex"} K U_0
            with the space of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
            = succeed ")" do
              %a{:href => "#ByBundlesOfFredholmOperators"} below
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PU
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PU(\mathcal{H})
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mrow
                        %mi P
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi ℋ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mi U
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} P \times_{P U(\mathcal{H})} (K U)_0
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P U(\mathcal{H})
            is that of an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},2)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in H^3(X, \mathbb{Z})
          #SpectrumBundDefinition.num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong twisted K-theory
              with twist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
