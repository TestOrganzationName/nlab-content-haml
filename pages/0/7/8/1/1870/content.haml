                    %annotation{:encoding => "application/x-tex"} H_0
                for
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
                %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable Hilbert space
                whose even and odd part are both infinite-dimensional.
          #Fredn.num_defn
            %h6#definition_3 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred^{(n)}
              of
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                    %mo ⊗
                    %msub
                      %mi H
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S_n \otimes H_0
              is the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mi F
                      %mo ∈
                      %mi ℬ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mi n
                      %mo ⊗
                      %msub
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %mspace{:width => "thinmathspace"}
                      %mi odd
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %msup
                        %mi F
                        %mo *
                      %mo =
                      %mi F
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %msup
                        %mi F
                        %mn 2
                      %mo −
                      %mn 1
                      %mo ∈
                      %mi 𝒦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mi n
                      %mo ⊗
                      %msub
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi F
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mi for
                      %mspace{:width => "thinmathspace"}
                      %mi γ
                      %mo ∈
                      %msub
                        %mi Cl
                        %mi n
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{(n)}
                    \\coloneqq
                    \\left\{
                    F \in \mathcal{B}(S_n \otimes H_0)
                    \\;|\;
                    F \, odd\,,
                    F^\ast = F \,,
                    F^2 - 1 \in \mathcal{K}(S_n \otimes H_0)\,,
                    [F,\gamma] = 0 \, for\, \gamma \in Cl_n
                    \\right\}
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              denotes
              %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}
              denotes
              %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              denotes the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/graded+commutator"} graded commutator
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on this set is the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              induced by the embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi n
                    %mo ⊗
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi n
                    %mo ⊗
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{(n)}
                    \\hookrightarrow
                    \\mathcal{B}(S_n \otimes H_0)
                    \\times
                    \\mathcal{K}(S_n \otimes H_0)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %msup
                      %mi F
                      %mn 2
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F\mapsto (F, F^2 - 1)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              is equipped with the
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}
              with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/norm+topology"} norm topology
          %p
            (
            %a{:href => "#AtiyahSinger69"}> Atiyah-Singer 69, p. 7
            ,
            = succeed "," do
              %a{:href => "#AtiyahSegal04"} Atiyah-Segal 04, p. 21
            = succeed ")" do
              %a{:href => "#FreedHopkinsTeleman11"} Freed-Hopkins-Teleman 11, def. A.40
          %p
            These spaces indeed form a model for the
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
          .num_prop
            %h6#proposition Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              there are
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Ω
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{(n+1)} \stackrel{\simeq}{\longrightarrow} \Omega Fred^{(n)}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{(n+2)} \stackrel{\simeq}{\longrightarrow} Fred^{(n)}
            %p
              between the spaces of graded
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
              of def.
              %a.maruku-ref{:href => "#Fredn"}
              and their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
          %p
            (
            %a{:href => "#AtiyahSinger69"}> Atiyah-Singer 69, theorem B(k)
            ,
            = succeed "," do
              %a{:href => "#AtiyahSegal04"} Atiyah-Segal 04 (4.2)
            = succeed ")" do
              %a{:href => "#FreedHopkinsTeleman11"} Freed-Hopkins-Teleman 11, below def. A.40
          %p
            Regard the
            %a.existingWikiWord{:href => "/nlab/show/stable+unitary+group"} stable unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(H_0)
            as equipped with the
            %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
            induced by the inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ↪
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U(H_0) \stackrel{(id,(-)^{-1})}{\hookrightarrow} \mathcal{B}(H_0)\times\mathcal{B}(H_0)
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operators"} bounded linear operators
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+unitary+group"} stable unitary group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(H_0)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Fred
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Fred^{(n)}
              = succeed "," do
                %a.maruku-ref{:href => "#Fredn"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous
          %p
            This follows with (
            %a{:href => "#AtiyahSegal04"}> Atiyah-Segal 04, prop. A1.1
            ).
          .num_defn
            %h6#definition_4 Definition
            %p
              Given a class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo ∈
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi \in H^3(X,\mathbb{Z})
              represented by a
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PU
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PU(H_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              with
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              Fredholm bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi χ
                    %mo ≔
                    %mi P
                    %munder
                      %mo ×
                      %mrow
                        %mi PU
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi H
                          %mn 0
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{(n)+ \chi} \coloneqq P \underset{PU(H_0)}{\times} Fred^{(n)}
                    \\,,
            %p
              then the corresponding
              = succeed "-twisted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                    %annotation{:encoding => "application/x-tex"} \chi
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              is that consisting of the
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi χ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(X, Fred^{(n)+ \chi})
                    \\,.
          %p
            (
            %a{:href => "#FreedHopkinsTeleman11"}> Freed-Hopkins-Teleman 11, def. 3.14
            )
          %h3#by_twisted_vector_bundles_gerbe_modules By twisted vector bundles (gerbe modules)
          #TwBundDefinition.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in H^3(X, \mathbb{Z})
              be a class in degree-3
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in \mathbf{H}^3(X, \mathbf{B}^2 U(1))
              be any
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              representative, which we may think of either as giving a
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle
              or a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TwBund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} TwBund(X, P)
              for the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with twist given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi TwBund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K_\alpha(X) \coloneqq TwBund(X,P)
            %p
              be the set of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              classes of twisted bundles. Call this the
              %strong twisted K-theory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with twist
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
          %blockquote
            %p (Some technical details need to be added for the non-torsion case.)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              This definition of twisted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} K_0
              is equivalent to that of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SpectrumBundDefinition"}
          %p
            This is (
            %a{:href => "#CBMMS"}> CBMMS, prop. 6.4, prop. 7.3
            ).
          %h3#by_kktheory_of_twisted_convolution_algebras By KK-theory of twisted convolution algebras
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/circle+2-group"} circle 2-group
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            is also incarnated as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/centrally+extended+Lie+groupoid"} centrally extended Lie groupoid
            %a.existingWikiWord{:href => "/nlab/show/twisted+groupoid+convolution+algebra"} twisted groupoid convolution algebra
            has as its
            %a.existingWikiWord{:href => "/nlab/show/operator+K-theory"} operator K-theory
            the twisted K-theory of the base space (or base-
            %a.existingWikiWord{:href => "/nlab/show/stack"}> stack
            ). See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            for more on this.
          %h2#other_constructions Other constructions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"} Vectr
            be the
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vectorial+bundles"} vectorial bundles
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
          %p There is a canonical morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Vect
                  %mo ↪
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"}
                  \\rho : \mathbf{B} U(1) \to Vect \hookrightarrow Vectr
          %p
            coming from the standard
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ⊗
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"} \mathbf{B}_{\otimes} Vectr
            be the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"} Vectr
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal structure
            (not the additive structure).
          %p
            Then we have a
            %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} fibration sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vectr
                  %mo →
                  %mo *
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ⊗
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"}
                  Vectr \to {*} \to \mathbf{B}_\otimes Vectr
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-categories
            (instead of
            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} infinity-groupoid
          %p The entire morphism above deloops
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi ρ
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ⊗
                  %mi Vect
                  %mo ↪
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ⊗
                  %mi Vectr
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}\rho : \mathbf{B}^2 U(1) \to \mathbf{B}_\otimes Vect \hookrightarrow \mathbf{B}_{\otimes} Vectr
          %p
            being the standard representation of the
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
          %p
            From the general nonsense of
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            this induces canonically now for every
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            (for instance given by a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed "-cohomology:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vectr
                  %annotation{:encoding => "application/x-tex"} Vectr
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi c
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Vectr
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi ρ
                              %mo ∘
                              %mi c
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo ⊗
                          %mi Vectr
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}^c(X, Vectr)
                  \&amp;\to&amp;
                  {*}
                  \\\
                  \\downarrow
                  \&amp;&amp;
                  \\downarrow^{\mathbf{B}\rho \circ c}
                  \\\
                  {*} &amp;\to&amp; \mathbf{H}(X,\mathbf{B}_\otimes Vectr)
                  }
                  \\,.
          %p
            After unwrapping what this means, the result of (
            %a{:href => "#Gomi"}> Gomi
            ) shows that
            %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
            classes in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Vectr
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^c(X,Vectr)
            yield twisted K-theory.
          %h2#twists Twists
          %p
            By the general discussion of
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            for the twists of
            %a.existingWikiWord{:href => "/nlab/show/periodic+complex+K-theory"} periodic complex K-theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                %annotation{:encoding => "application/x-tex"} KU
            is the
            %a.existingWikiWord{:href => "/nlab/show/Picard+%E2%88%9E-group"} Picard ∞-group
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} KU Mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi bgl
                    %mn 1
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi KU
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} bgl_1^\ast(KU)
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
          %p
            A model for this in 4-truncation is given by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+line+2-bundles"} super line 2-bundles
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"}> topological K-theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/KR-theory"} KR-theory
            %li
              %p
                %strong twisted K-theory
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/twisted+equivariant+K-theory"} twisted equivariant K-theory
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/twisted+ad-equivariant+K-theory"} twisted ad-equivariant K-theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/twisted+differential+K-theory"} twisted differential K-theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+K-theory"} fiber integration in K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+ordinary+cohomology"} twisted ordinary cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+Bredon+cohomology"} twisted Bredon cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+Cohomotopy"} twisted Cohomotopy
          %h2#references References
          %h3#general General
          %p The concept of twisted K-theory originates in
          %ul
            %li#Karoubi68
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                ,
                %em Algèbres de Clifford et K-théorie.
                Ann. Sci. Ecole Norm. Sup. (4), pp. 161-270 (1968) (
                %a{:href => "http://www.numdam.org/item/ASENS_1968_4_1_2_161_0"}> numdam:ASENS_1968_4_1_2_161_0
                )
            %li#DonovanKaroubi70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Donovan"}> Peter Donovan
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"} Max Karoubi
                = succeed "," do
                  %em
                    Graded Brauer groups and
                    = succeed "-theory" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi K
                          %annotation{:encoding => "application/x-tex"} K
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item?id=PMIHES_1970__38__5_0"} numdam:PMIHES_1970__38__5_0
          %p
            which discusses twists of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KO
                %annotation{:encoding => "application/x-tex"} KO
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                %annotation{:encoding => "application/x-tex"} KU
            over some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by elements in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^0(X,\mathbb{Z}_2) \times H^1(X,\mathbb{Z}_2) \times H^3(X, \mathbb{Z})
          %p
            Including the twist in degree 1 (see also at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/PU%28%E2%84%8B%29"} PU(ℋ)
          %ul
            %li#Parker88
              %a.existingWikiWord{:href => "/nlab/show/Ellen+Maycock+Parker"}> Ellen Maycock Parker
              , around Prop. 2.2 of:
              = succeed "," do
                %em
                  The Brauer Group of Graded Continuous Trace
                  = succeed "-Algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
              %strong 308
              1 (1988) &amp;lbrack;
              %a{:href => "https://www.jstor.org/stable/2000953"}> jstor:2000953
              \&amp;rbrack;
          %p reviewed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alan+Carey"}> Alan Carey
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bai-Ling+Wang"} Bai-Ling Wang
              = succeed "," do
                %em Thom isomorphism and Push-forward map in twisted K-theory
              %strong 1
              2 (2008) 357-393 (
              %a{:href => "https://arxiv.org/abs/math/0507414"}> arXiv:math/0507414
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/is007011015jkt011"} doi:10.1017/is007011015jkt011
          %p The formulation in terms of sections of Fredholm bundles seems to go back to
          %ul
            %li#Rosenberg89
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"}> Jonathan Rosenberg
              ,
              = succeed "," do
                %em Continuous-trace algebras from the bundle theoretic point of view
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/S1446788700033097"} doi:10.1017/S1446788700033097
          %p and is expanded on in:
          %ul
            %li#FreedHopkinsTeleman02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
                = succeed "," do
                  %em Twisted equivariant K-theory with complex coefficients
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0206257"} arXiv:math/0206257
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1112/jtopol/jtm001"} doi:10.1112/jtopol/jtm001
            %li#AtiyahSegal04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                = succeed "," do
                  %em Twisted K-theory
                %strong 1
                3 (2004) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0407054"}> arXiv:math/0407054
                ,
                = succeed "," do
                  %a{:href => "http://iamm.su/en/journals/j879/?VID=10"} journal page
                = succeed "&rbrack;" do
                  %a{:href => "http://iamm.su/upload/iblock/45e/t1-n3-287-330.pdf"} published pdf
              %blockquote
                %p
                  (beware of the false claim in
                  %a{:href => "#AtiyahSegal04"} AS04 p 39
                  that
                  %a.existingWikiWord{:href => "/nlab/show/U%28H%29"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi ℋ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U(\mathcal{H})
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/compact+open+topology"} compact open topology
                  is not a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
                  = succeed "," do
                    %a{:href => "UH#Schottenloher13"} Schottenloher 2013
                  = succeed "," do
                    %a{:href => "UH#EspinozaUribe14"} Espinoza &amp; Uribe 2014
                  = succeed ")" do
                    %a{:href => "UH#Schottenloher95"} Schottenloher 1995
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Johann+Sigurdsson"} Johann Sigurdsson
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Parametrized+Homotopy+Theory"} Parametrized Homotopy Theory
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/surv-132"} ISBN:978-0-8218-3922-5
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0411656"} arXiv:math/0411656
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/EXTHEORY/MaySig.pdf"} pdf
            %li#AtiyahSegal05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                %em Twisted K-theory and cohomology
                (
                %a{:href => "http://arxiv.org/abs/math/0510674"}> arXiv:math/0510674
                )
            %li#AndoBlumbergGepner10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                = succeed "," do
                  %em Twists of K-theory and TMF
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                et al. (eds.),
                = succeed "," do
                  %em
                    Superstrings, Geometry, Topology, and
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
                = succeed "," do
                  %em Proceedings of Symposia in Pure Mathematics
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1002.3004"} arXiv:1002.3004
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1090/pspum/081"} doi:10.1090/pspum/081
          %p
            A comprehensive account of twisted K-theory with twists in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X, \mathbb{Z})
            is in:
          %ul
            %li#AtiyahSinger69
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed ":" do
