          %p
            (
            %a{:href => "#Duetsch18"}> Dütsch 18, def. 3.19
            )
          #ScalarFieldMassDimensionOnMinkowskiSpacetime.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi m
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,m}
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
              for
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameter
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m \in (0,\infty)
              %a.existingWikiWord{:href => "/nlab/show/Green+function"} Green function
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            %p
              Let the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mo +
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RG \coloneqq (\mathbb{R}_+, \cdots)
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
