            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \rho \in (0,\infty) \subset \mathbb{R}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ρ
                          %mtd
                            %mi Σ
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mi ρ
                            %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Sigma
                    \&amp;\overset{\rho}{\longrightarrow}&amp;
                    \\Sigma
                    \\\
                    x &amp;\mapsto&amp; \rho x
                    }
            %p
              for the operation of multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              using the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p+1}
              underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              this acts on
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              (
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi ρ
                                  %mo *
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Φ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} (
