              by
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \rho^{-1}
              followed by multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              taken to the negative power of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              as an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %p
              This constitutes an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mrow
                      %mo (
