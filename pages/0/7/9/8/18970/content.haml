              in the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                  %annotation{:encoding => "application/x-tex"} RG
              picks a different choice of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} normalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme around a given vacuum at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ρ
                        %mi vac
