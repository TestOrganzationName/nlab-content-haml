            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix+scheme"} S-matrix scheme
              around the vacuum labeled by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
