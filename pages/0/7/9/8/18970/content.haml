                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(E)
                    \&amp;\overset{\rho^\ast}{\longrightarrow}&amp;
                    \\Gamma_\Sigma(E)
                    \\\
                    \\Phi &amp;\mapsto&amp; \Phi(\rho(-))
                    }
                    \\,.
            %p Let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ↦
                    %msub
                      %mi vac
                      %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
