          #RGFlowScalingTransformations.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+group+flow"} renormalization group flow
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi vac
                    %mo ≔
                    %msub
                      %mi vac
                      %mi m
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mrow
                        %mi H
                        %mo ,
                        %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    vac \coloneqq vac_m
                    \\coloneqq (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_{H,m})
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacua"} vacua
              on that field bundle, according to
              %a{:href => "S-matrix#VacuumFree"} this def.
              equipped with a decomposition into a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                  %annotation{:encoding => "application/x-tex"} Spec
              of field species (
              %a{:href => "S-matrix#VerticesAndFieldSpecies"}> this def.
              ) such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sp
                    %mo ∈
                    %mi Spec
                  %annotation{:encoding => "application/x-tex"} sp \in Spec
              the collection of
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagators"} Feynman propagators
              the corresponding field species has a well-defined
              %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi sp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(sp)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mo +
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RG \coloneqq (\mathbb{R}_+, \cdot)
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
              %a.existingWikiWord{:href => "/nlab/show/renormalization+group+flow"} renormalization group flow
              in the sense of
              = succeed "." do
                %a{:href => "renormalization+group+flow#FlowRenormalizationGroup"} this prop.
          %p
            (
            %a{:href => "#Duetsch18"}> Dütsch 18, exercise 3.20
            )
          .proof
            %h6#proof_4 Proof
            %p
              It is clear that rescaling preserves
              %a.existingWikiWord{:href => "/nlab/show/causal+order"} causal order
              and the
              %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
              of “field indepencen”.
            %p
              The condition we need to check is that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
              two
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              we have for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ,
                    %msub
                      %mi ρ
                      %mi vac
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \rho, \rho_{vac} \in \mathbb{R}_+
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi ρ
                    %mrow
                      %mo (
                      %msub
                        %mi A
                        %mn 1
                      %msub
                        %mo ⋆
                        %mrow
                          %mi H
                          %mo ,
                          %msup
                            %mi ρ
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %msub
                            %mi ρ
                            %mi vac
                          %mi c
                      %msub
                        %mi A
                        %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi σ
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mrow
                        %mi H
                        %mo ,
                        %msub
                          %mi ρ
                          %mi vac
                    %msub
                      %mi σ
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_\rho
                    \\left(
                    A_1 \star_{H, \rho^{-1} \rho_{vac} c} A_2
                    \\right)
                    \\;=\;
                    \\sigma_\rho(A_1)
                    \\star_{H,\rho_{vac}}
                    \\sigma_\rho(A_2)
                    \\,.
            %p
              By the assumption of decomposition into free field species
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sp
                      %mo ∈
                      %mi Spec
                    %annotation{:encoding => "application/x-tex"} sp \in Spec
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mrow
                          %mi H
                          %mo ,
                          %mi sp
                    %annotation{:encoding => "application/x-tex"} \Delta_{H,sp}
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
            %p
              Observe that the scaling behaviour of the
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi H
                        %mo ,
                        %mi m
                  %annotation{:encoding => "application/x-tex"} \Delta_{H,m}
              is the same as the behaviour
              %a.maruku-eqref{:href => "#eq:FeynmanPropagatorScalingBehaviour"} (4)
              of the correspponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi σ
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %msub
                                  %mi ρ
                                  %mi vac
                                %mi m
                            %msub
                              %mi σ
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                                %mi dim
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %msub
                                  %mi ρ
                                  %mi vac
                                %mi m
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                                %mi dim
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %msub
                                  %mi ρ
                                  %mi vac
                                %mi m
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %msup
                                  %mi ρ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %msub
                                  %mi ρ
                                  %mi vac
                                %mi m
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi rg
                              %mi ρ
                            %mrow
                              %mo (
                              %msub
                                %mi Δ
                                %mrow
                                  %mi F
                                  %mo ,
                                  %msup
                                    %mi ρ
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %msub
                                    %mi ρ
                                    %mi vac
                                  %mi m
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mstyle{:mathvariant => "bold"}
                                %mn 1
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi rg
                              %mi ρ
                            %mrow
                              %mo (
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo ⋆
                                %mrow
                                  %mi F
                                  %mo ,
                                  %msup
                                    %mi ρ
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %msub
                                    %mi ρ
                                    %mi vac
                                  %mi m
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\sigma_\rho (\mathbf{\Phi}(x))
                    \\star_{F, \rho_{vac} m}
                    \\sigma_\rho (\mathbf{\Phi}(y)
                    \&amp; =
                    \\rho^{-2 dim }
                    \\mathbf{\Phi}(\rho^{-1} x)
                    \\star_{F, \rho_{vac} m}
                    \\mathbf{\Phi}(\rho^{-1} y)
                    \\\
                    \&amp; =
                    \\rho^{-2 dim }
                    \\Delta_{F, \rho_{vac} m}(\rho^{-1}(x-y))
                    \\\
                    \&amp; =
                    \\Delta_{F, \rho^{-1}\rho_{vac}m }(x,y) \mathbf{1}
                    \\\
                    \&amp; =
                    rg_{\rho}\left(
                    \\Delta_{F, \rho^{-1}\rho_{vac}m }(x,y) \mathbf{1}
                    \\right)
                    \\\
                    \&amp; =
                    rg_{\rho}
                    \\left(
                    \\mathbf{\Phi}(x)
                    \\star_{F, \rho^{-1} \rho_{vac} m}
                    \\mathbf{\Phi}(y)
                    \\right)
                    \\end{aligned}
                    \\,.
