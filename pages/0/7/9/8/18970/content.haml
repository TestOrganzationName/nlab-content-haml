          #CouplingRunning.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/running+coupling+constants"}> running coupling constants
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi vac
                    %mo ≔
                    %msub
                      %mi vac
                      %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    vac
                    \\coloneqq
                    vac_e
                    \\;\coloneqq\;
                    (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")" do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme around this vacuum and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
