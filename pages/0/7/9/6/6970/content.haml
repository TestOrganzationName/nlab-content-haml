          %h4#weak_function_types_2 Weak function types
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} A'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} B'
              and equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi A
                    %mo :
                    %mi A
                    %mo ≃
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} e_A:A \simeq A'
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi B
                      %mo :
                      %mi B
                      %mo ≃
                      %mi B
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} e_B:B \simeq B'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
