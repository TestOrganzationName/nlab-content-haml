                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} funsplit(c, \lambda x.g) \;\to_\beta c[g/b]
          %p
            and its
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi funsplit
