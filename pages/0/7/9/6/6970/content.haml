                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} /
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} funsplit(c[\lambda x.b / g], f) \;\to_\eta\; c[f/g].
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                  %mo ⊢
                  %mi c
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                %annotation{:encoding => "application/x-tex"} g\colon A\to B \vdash c\colon C
            is a term containing a free variable of type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi x
                  %mo .
                  %mi b
                %annotation{:encoding => "application/x-tex"} \lambda x.b
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            which depends on “a term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                %annotation{:encoding => "application/x-tex"} b\colon B
            containing a free variable
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\colon A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A\to B
            = succeed "-rule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
