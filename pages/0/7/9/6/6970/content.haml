                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi λ
                  %mi x
                  %mo .
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
