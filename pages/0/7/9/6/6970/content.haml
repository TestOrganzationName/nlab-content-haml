                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi p
                    %mo{:stretchy => "false"} (
