                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B)^{-1} \coloneqq \lambda (g:A' \to B').\lambda x:A.e_B^{-1}(g(e_A(x)))
            %p Now it suffices to construct homotopies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \prod_{f:A \to B} \mathrm{congform}(e_A, e_B)^{-1}(\mathrm{congform}(e_A, e_B)(f)) =_{A \to B} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi g
                        %mo :
                        %mi A
                        %mo ′
                        %mo →
                        %mi B
                        %mo ′
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo ′
                        %mo →
                        %mi B
                        %mo ′
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \prod_{g:A' \to B'} \mathrm{congform}(e_A, e_B)(\mathrm{congform}(e_A, e_B)^{-1}(g)) =_{A' \to B'} g
            %p
              from where it implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B)
              has a coherent inverse and contractible fibers and is thus an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %p To be finished…
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            are negative types, we first present the typal congruence rule for the elimination rule of function types
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g:A \to B
              and an identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi f
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                    %mi g
                  %annotation{:encoding => "application/x-tex"} p:f =_{A \to B} g
              there are families of identifications
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi{:mathvariant => "normal"} compelim
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi B
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:A \vdash \mathrm{compelim}(f, g, p)(x):f(x) =_B g(x)
          %p
          .proof
            %h6 Proof
            %p
              We simply define the dependent function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} compelim
                  %annotation{:encoding => "application/x-tex"} \mathrm{compelim}
              to be the canonical inductively defined function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} idtohomotopy
                  %annotation{:encoding => "application/x-tex"} \mathrm{idtohomotopy}
              which takes identifications between functions to homotopies between functions.
          %p The next is the typal congruence rule for the uniqueness rule of function types.
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
