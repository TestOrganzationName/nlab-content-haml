            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
