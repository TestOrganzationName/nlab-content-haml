                  %annotation{:encoding => "application/x-tex"} x:A \vdash (\lambda x:A'.e_B(f(e_A^{-1}(x))))(e_A(x)) \equiv e_B(f(e_A^{-1}(e_A(x))))
            %p
              and thus by the structural rules of
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
              and the judgmental congruence rules for function types, a judgmental equality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
