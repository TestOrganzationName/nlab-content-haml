                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo →
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B):(A \to B) \to (A' \to B')
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo ′
                    %mo .
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi e
                      %mi A
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B) \coloneqq \lambda (f:A \to B).\lambda x:A'.e_B(f(e_A^{-1}(x)))
            %p and the inverse function by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
                    %mo{:stretchy => "false"} (
