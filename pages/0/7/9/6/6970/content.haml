                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B):(A \to B) \to (A' \to B')
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
