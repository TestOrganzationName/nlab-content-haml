                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo →
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}(e_A, e_B):(A \to B) \simeq (A' \to B')
            %p
          %p
          .proof
            %h6 Proof
            %p
              We define the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} congform
