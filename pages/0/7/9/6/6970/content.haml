                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msubsup
                        %mo =
                        %mrow
                          %msub
                            %mi ℱ
                            %mrow
                              %mi A
                              %mo ,
                              %mi B
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi κ
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi u
                          %mo{:stretchy => "false"} )
                      %mi u
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type}}{\Gamma, f:A \to B, x:A, y:B,  u:\mathcal{F}_{A, B}(f, x, y) \vdash \eta(f, x, y, u):\beta(f, x) =_{\mathcal{F}_{A, B}(f, x)}^{\kappa(f, x, y, u)} u}
          %p
            By the rules for
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                      %mo ⊢
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi{:mathvariant => "normal"} isContr
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi y
                            %mo :
                            %mi B
                        %msub
                          %mi ℱ
                          %mrow
                            %mi A
                            %mo ,
                            %mi B
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type}}{\Gamma, f:A \to B \vdash \eta(f):\prod_{x:A} \mathrm{isContr}\left(\sum_{y:B} \mathcal{F}_{A, B}(f, x, y) \right)}
          %p
            which is precisely the statement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℱ
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{F}_{A, B}(f)
            is an
            %a.existingWikiWord{:href => "/nlab/show/anafunction"} anafunction
            for all functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
          %h2#properties Properties
          %h3#relation_to_dependent_product_types Relation to dependent product types
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            a function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \to B
            is the special case the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a : A
            for the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is regarded as an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                %annotation{:encoding => "application/x-tex"} x:A \vdash B
            that actually happens to be
            = succeed "-independent;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                %annotation{:encoding => "application/x-tex"} x:A \vdash B
            can always be constructed by the
            %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening rule
            of dependent type theory, which is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/admissible+rule"} admissible rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (X \to A)
                  \=
                  \\prod_{x \colon X} A
                  \\,.
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            this is the statement that a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of a product
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \times B \to A
            is equivalently just a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/function+monad"} function monad
          %h3#typal_congruence_rules_and_uniqueness_rules Typal congruence rules and uniqueness rules
          %p
            The typal computation rule for function types is provable from the other four typal type formers of function types. Given types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \lambda x:A.f(x):A \to B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi f
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta_{A \to B}(f):f =_{A \to B} \lambda x:A.f(x)
          %p
            By the inductively defined function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtohomotopy
                %annotation{:encoding => "application/x-tex"} \mathrm{idtohomotopy}
            which takes
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            between functions to
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            between functions]], we have that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtohomotopy
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi η
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtohomotopy}(f, \lambda x:A.f(x))(\eta_{A \to B}(f)):\prod_{x:A} f(x) =_{A \to B} (\lambda x:A.f(x))(x)
          %p which is the typal computation rule for function types.
          %h3#AsHomObjects Function types as hom-objects
          %p
            Function types play the role of
            %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
            in a kind of
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            whose objects are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/types"} types
            %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            this is a
            = succeed "-structure," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            = succeed ")." do
              %a{:href => "relation+between+type+theory+and+category+theory#LambekScott86"} Lambek &amp; Scott 1986
            %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
            and a
            = succeed "-operation" do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            and
            %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
            laws:
          %ul
            %li
              %p For strict function types, the associative and unital laws are represented by judgmental equality
            %li
              %p
                For weak function types, the associative and unital laws are represented by
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                and
                %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                and
                %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                %a.existingWikiWord{:href => "/nlab/show/coherence+laws"} coherence laws
                representing the
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                  \-categorical structure
                of function types by constructing the
                %a.existingWikiWord{:href => "/nlab/show/pentagonator"} pentagonator
                and so forth, but this isn’t demonstrated in this section, and is unnecessary in the presence of a
                %a.existingWikiWord{:href => "/nlab/show/set+truncation+axiom"} set truncation axiom
                like
                %a.existingWikiWord{:href => "/nlab/show/UIP"} UIP
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
          %h4#strict_function_types Strict function types
          %p
          .num_defn
            %h6 Definition
            %p
              Given a type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %strong identity function
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi A
                    %mo ≡
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi x
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{id}_A \equiv \lambda (x:A).x:A \to A
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              By the computation rules for strict function types, the identity function on a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              comes with a family of judgmental equalities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A \vdash \mathrm{id}_A(x) \equiv x:A
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              Given types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi B
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} g:B \to C
              %strong function composition
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mo ∘
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ,
                        %mi C
                    %mi f
                    %mo ≡
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g \circ_{A, B, C} f \equiv \lambda (x:A).g(f(x)):A \to C
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p By the computation rules for strict function types, function composition comes with a family of judgmental equalities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mo ∘
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ,
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x:A \vdash (g \circ_{A, B, C} f)(x) \equiv g(f(x)):C
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              For all types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi B
