                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda (x:A).p(x):\prod_{x:A} (\lambda x:A.b(x))(x) =_B (\lambda x:A.b'(x))(x)
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} funext
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
