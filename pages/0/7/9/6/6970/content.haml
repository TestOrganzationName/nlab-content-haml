                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} g:A \to B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi f
                      %msub
                        %mo =
                        %mrow
                          %mi A
                          %mo →
                          %mi B
