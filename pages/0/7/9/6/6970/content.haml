                    %mo .
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
