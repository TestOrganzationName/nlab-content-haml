              to be the
              %a.existingWikiWord{:href => "/nlab/show/dependent+function+application+to+identifications"} dependent function application to identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
