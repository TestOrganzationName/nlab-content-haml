                        %mo →
                        %msup
                          %mi S
                          %mi V
                      %annotation{:encoding => "application/x-tex"} LD(S) \colon S^V \to S^V
                %p
                  (which completely characterize the
                  = succeed "-class" do
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+Cohomotopy"} equivariant Cohomotopy
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+Hopf+degree+theorem"} equivariant Hopf degree theorem
                  = succeed ")" do
                    %a{:href => "Hopf+degree+theorem#EquivariantHopfDegreeTheorem"} this Prop.
