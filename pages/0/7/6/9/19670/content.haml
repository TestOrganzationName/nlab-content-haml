                  %a.existingWikiWord{:href => "/nlab/show/virtual+representation"} virtual
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                  %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
