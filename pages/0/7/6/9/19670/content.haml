          %h2#statement Statement
          #BurnsideRingIsEquivariantStableCohomotopyOfPoint.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                is
                %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              (for instance a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(G)
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_G(\ast)
              of the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              in degree 0, via the Lefschwetz-Dold index:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mi LD
                    %msub
                      %mi 𝕊
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(G)
                    \\underoverset{\simeq}{LD}{\longrightarrow}
                    \\mathbb{S}_G(\ast)
                    \\,.
            %p
              More in detail, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+character"} Burnside character
              on the left with the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degrees
              on the right, hence for all
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              it identifies
            %ol
              %li
                %p
                  the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %a.existingWikiWord{:href => "/nlab/show/Burnside+marks"} Burnside marks
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
