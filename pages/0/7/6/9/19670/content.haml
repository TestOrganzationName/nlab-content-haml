                  at
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
                  of representative
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+Cohomotopy"} equivariant Cohomotopy
                  %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LD
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
