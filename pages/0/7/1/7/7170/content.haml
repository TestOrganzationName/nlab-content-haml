                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Sq^k(-) : H^l(X, \mathbb{Z}_2) \to H^{k+l}(X, \mathbb{Z}_2)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+square"} Steenrod square
            operations.
          #WuClassesBySteenrodSquares.num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong Wu class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi k
                    %mo ∈
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\nu_k
                    \\in
                    H^k(X,\mathbb{Z}_2)
            %p
              is defined to be the class that “represents”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sq
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sq^k(-)
              under the cup product, in the sense that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in H^{n-k}(X, \mathbb{Z}_2)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is the dimension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sq
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ν
                      %mi k
                    %mo ∪
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sq^k(x) = \nu_k \cup x
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#MilnorStasheff74"} Milnor-Stasheff 74, p. 131-133
          .num_remark
            %h6#remark Remark
            %p
              In other words this says that the lifts of Wu classes to
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              (
              %a.existingWikiWord{:href => "/nlab/show/integral+Wu+structures"}> integral Wu structures
              ) are
              %em
                %a.existingWikiWord{:href => "/nlab/show/characteristic+element+of+a+bilinear+form"} characteristic elements
              of the
              %a.existingWikiWord{:href => "/nlab/show/intersection+product"} intersection product
              on integral cohomology, inducing
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quadratic+refinements"} quadratic refinements
          %h2#properties Properties
          %h3#relation_to_stiefelwhitney_classes Relation to Stiefel-Whitney classes
          %p
