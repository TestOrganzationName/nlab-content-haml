            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            is the total
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+square"} Steenrod square
            of the total Wu class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
