          %h2#idea Idea
          %p
            %em Wu classes
            are a type of
            %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+class"} universal characteristic class
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            that refine the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mi X
                  %mo →
                  %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E : X  \to B SO(n)
            (a real
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            of some
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mi k
                  %mo ∈
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  w_k \in H^k(X, \mathbb{Z}_2)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∪
                  %mo :
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi H
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi k
                      %mo +
                      %mi l
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\cup : H^k(X, \mathbb{Z}_2) \times H^l(X, \mathbb{Z}_2)
                  \\to
                  H^{k+l}(X, \mathbb{Z}_2)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Sq
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi H
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi k
                      %mo +
                      %mi l
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
