                        %mn 20
                        %msub
                          %mi p
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \nu_8 = \frac{1}{8}(11 p_1^2  - 20 p_2)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ν
                          %mn 12
                        %mo =
                        %mfrac
                          %mn 1
                          %mn 16
                        %mo{:stretchy => "false"} (
                        %mn 37
                        %msubsup
                          %mi p
                          %mn 1
                          %mn 3
                        %mo −
                        %mn 100
                        %msub
                          %mi p
                          %mn 1
                        %msub
                          %mi p
                          %mn 2
                        %mo +
                        %mn 80
                        %msub
                          %mi p
                          %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \nu_{12} = \frac{1}{16}(37 p_1^3 - 100 p_1 p_2 + 80 p_3)
                  \.
            %p
              (all products are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup products
          %p
            This is discussed in (
            %a{:href => "#HopkinsSinger"}> Hopkins-Singer, page 101
            ).
          #DivisibilityOfCupSquare.num_cor
            %h6#corollary Corollary
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is 8 dimensional. Then, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in H^4(X, \mathbb{Z})
              any integral 4-class, the expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi G
                    %mo −
                    %mi G
                    %mo ∪
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo ∈
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G \cup G - G \cup \frac{1}{2}p_1 \in H^4(X, \mathbb{Z})
            %p is always even (divisible by 2).
          .proof
            %h6#proof Proof
            %p
              By the basic properties of Steenrod squares, we have for the 4-class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi G
                    %mo =
                    %msup
                      %mi Sq
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G \cup G = Sq^4(G)
                    \\,.
            %p
              By the definition
              %a.maruku-ref{:href => "#WuClassesBySteenrodSquares"}
              of Wu classes, the image of this integral class in
              = succeed "-coefficients" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi G
                    %mo −
                    %mi G
                    %mo ∪
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo =
                    %msup
                      %mi Sq
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi G
                    %mo ∪
                    %msub
                      %mi ν
                      %mn 4
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G \cup G - G \cup \frac{1}{2}p_1
                    \=
                    Sq^4(G) - G \cup \nu_4
                    \=
                    0 \; mod \; 2.
                    \\,,
            %p
              where the first step is by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InTermsOfPontryagin"}
          %h2#applications Applications
          %h3#to_higher_dimensional_chernsimons_theory To higher dimensional Chern-Simons theory
          .num_remark
            %h6#remark_2 Remark
            %p
              The relation
              %a.maruku-ref{:href => "#DivisibilityOfCupSquare"}
              plays a central role in the definition of the
              %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} 7-dimensional Chern-Simons theory
              which is
              %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} dual
              to the
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              = succeed ")" do
                %a{:href => "#Witten"} Witten 1996
              = succeed ")." do
                %a{:href => "#HopkinsSinger"} Hopkins-Singer
            %p
              Specifically, in this context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is the 4-class of the
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle
              underlying the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 4
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G_4 = \frac{1}{2}(\frac{1}{2}p_1) + a
                    \\,,
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msup
                        %mi H
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in H^4(X, \mathbb{Z})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^4(X, \mathbb{Z})
              if the
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              happens to be such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
              is further divisible by 2, and can be made sense of more generally in terms of
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              (which was suggested in (
              %a{:href => "#Witten"}> Witten 1996
              ) and made precise sense of in (
              %a{:href => "#HopkinsSinger"}> Hopkins-Singer
              ) ).
            %p
              For simplicity, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is further divisible by 2 in the following. We then may consider direct refinements of the above ingredients to
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              and so we consider
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} differential cocycles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msup
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ^
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat a, \hat G \in \hat H^4(X)
              with
            #eq:DifferentialQuantizationCondition.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msup
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ^
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\hat G = \frac{1}{2}(\frac{1}{2}\hat \mathbf{p}_1) + \hat a
                    \\in \hat H^4(X)
                    \\,,
            %p
              where the differential refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1
              is discussed in detail at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
            %p
              Now, after
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+mechanism"} dimensional reduction
              on a 4-
              %a.existingWikiWord{:href => "/nlab/show/sphere"}> sphere
              , the
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              of
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              on the remaining 7-dimensional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              contains a
              %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher Chern-Simons term
              which up to prefactors is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ↦
                    %mi exp
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ∪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mn 1
                      %mn 4
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\hat G \mapsto
                    \\exp i
                    \\int_X
                    (
                    \\hat G \cup \hat G -
                    (\frac{1}{4}\hat \mathbf{p}_1)^2
                    )
                    \\,,
            %p where
            %ul
              %li
                %p
                  the cup product now is the differential
                  %a.existingWikiWord{:href => "/nlab/show/Beilinson-Deligne+cup+product"} Beilinson-Deligne cup product
                  refinement of the integral cup product;
              %li
                %p
                  the symbol
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %msub
                          %mo ∫
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exp(i \int_X (-))
                  denotes
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            %p
              Using
              %a.maruku-eqref{:href => "#eq:DifferentialQuantizationCondition"} (1)
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mi exp
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %mrow
                      %mo (
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ^
                      %mo ∪
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ^
                      %mo +
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ^
                      %mo ∪
                      %mfrac
                        %mn 1
                        %mn 2
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \=
                    \\exp i
                    \\int_X
                    \\left(
                    \\hat a \cup \hat a + \hat a \cup \frac{1}{2}\hat \mathbf{p}_1
                    \\right)
                    \\,.
            %p
              But by corollary
              %a.maruku-ref{:href => "#DivisibilityOfCupSquare"}
              this is further divisible by 2. Hence the generator of the group of higher Chern-Simons action functionals is one half of this
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ↦
                    %mi exp
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ∪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mn 1
                      %mn 4
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat G
                    \\mapsto
                    \\exp i
                    \\int_X
                    \\frac{1}{2}
                    (
                    \\hat G \cup \hat G -
                    (\frac{1}{4}\hat \mathbf{p}_1)^2
                    )
                    \\,.
            %p
              In (
              %a{:href => "#Witten"}> Witten 1996
              ) it is discussed that the space of
              %a.existingWikiWord{:href => "/nlab/show/states"} states
              of this “fractional” functional over a 6-dimensional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is the space of
              %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
              of the
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/integral+Wu+structure"}> integral Wu structure
                ,
                %a.existingWikiWord{:href => "/nlab/show/twisted+Wu+structure"} twisted Wu structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/shifted+C-field+flux+quantization"} shifted C-field flux quantization
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"}> Pontryagin class
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
                %a.existingWikiWord{:href => "/nlab/show/one-loop+anomaly+polynomial+I8"} one-loop anomaly polynomial I8
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
          %h2#references References
          %p The original reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Wen-Tsun+Wu"}> Wen-Tsun Wu
              ,
              %em On Pontrjagin classes: II
              Sientia Sinica 4 (1955) 455-490
          %p See also around p. 228 of
          %ul
            %li#MilnorStasheff74
              %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em Characteristic classes
          %p and section 2 of
          %ul
            %li
              Yanghyun Byun,
              = succeed "," do
                %em On vanishing of characteristic numbers in Poincaré complexes
              = succeed ")" do
                %a{:href => "http://www.ams.org/journals/tran/1996-348-08/S0002-9947-96-01495-X/S0002-9947-96-01495-X.pdf"} pdf
          %p and
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Robert+Stong"}> Robert Stong
              , Toshio Yoshida,
              %em Wu classes
              Proceedings of the American Mathematical Society Vol. 100, No. 2, (1987) (
              %a{:href => "http://www.jstor.org/pss/2045970"}> JSTOR
              )
          %p Details are reviewed in appendix E of
          %ul#HopkinsSinger
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Hopkins"}> Mike Hopkins
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
              %em
                %a.existingWikiWord{:href => "/nlab/show/Quadratic+Functions+in+Geometry%2C+Topology%2C+and+M-Theory"} Quadratic Functions in Geometry, Topology, and M-Theory
          %p This is based on or motivated from observations in
          %ul#Witten
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              %em Five-Brane Effective Action In M-Theory
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9610234"}> arXiv:hep-th/9610234
              )
          %p More discussion of Wu classes in this physical context is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              %em
                Twisted topological structures related to M-branes II: Twisted
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Wu
                    %annotation{:encoding => "application/x-tex"} Wu
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Wu
                        %mi c
                    %annotation{:encoding => "application/x-tex"} Wu^c
                structures
              (
              %a{:href => "http://arxiv.org/abs/1109.4461"}> arXiv:1109.4461
              )
          %p which also summarizes many standard properties of Wu classes.
