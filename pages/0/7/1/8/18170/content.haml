          %h2#idea Idea
          %p
            A
            %strong dyadic rational number
            is a
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
            such that the
            %a.existingWikiWord{:href => "/nlab/show/binary+number"} binary
            expansion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            has finitely many digits.
          %h2#definition Definition
          %h3#as_a_subset_of_the_rational_numbers As a subset of the rational numbers
          %p
            A
            %strong dyadic rational number
            is a
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
            such that there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} a \in \mathbb{Z}
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mfrac
                      %mi a
                      %mrow
                        %msup
                          %mn 2
                          %mi n
                  %annotation{:encoding => "application/x-tex"} r = \frac{a}{2^n}
          %h3#as_the_localisation_of_the_integers_at_2 As the localisation of the integers at 2
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            of dyadic rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/2]
            is the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization
            of the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/localisation+of+a+commutative+ring+away+from+an+element"} away from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %h3#as_an_initial_object_of_a_category As an initial object of a category
          %p
            For lack of a better name, let us define a
            %em set with dyadic rational numbers
            to be a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ∈
                    %mi ℤ
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \iota \in \mathbb{Z} \times \mathbb{N} \to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mo ∀
                  %mi c
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi d
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %msup
                    %mn 2
                    %mi d
                  %mo =
                  %mi c
                  %mo ⋅
                  %msup
                    %mn 2
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{N}. \forall c \in \mathbb{Z}. \forall d \in \mathbb{N}. (a \cdot 2^d = c \cdot 2^b) \implies (\iota(a, b) = \iota(c, d))
          %p
            The integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
            represents the integer if one ignores the separator in the
            %a.existingWikiWord{:href => "/nlab/show/binary+number"} binary numeral representation
            of the dyadic rational number, and the natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} b:\mathbb{N}
            represents the number of digits to the left of the final digit where the separator ought to be placed after in the binary numeral representation of the dyadic rational number. The axiom above is used to state that equivalent numeral representations are equal: i.e. 1.00 = 1.000 with binary numeral representations.
          %p
            A
            %em homomorphism of sets with dyadic rational numbers
            between two sets with dyadic rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi ι
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{N}. f(\iota_A(a, b)) = \iota_B(a, b)
          %p
            The
            %em category of sets with dyadic rational numbers
            is the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SwDRN
                %annotation{:encoding => "application/x-tex"} SwDRN
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwDF
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ob(SwDF)
            are sets with dyadic rational numbers and whose morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mor(A,B)
            for sets with dyadic rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi SwDRN
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Ob(SwDRN)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwDRN
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in Ob(SwDRN)
            are homomorphisms of sets with dyadic rational numbers. The set of
            = succeed "," do
              %strong dyadic rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/2]
          %h2#properties Properties
          %h3#algebraic_closure Algebraic closure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} ]
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\mathbb{Z}[1/2]}
            of the dyadic rational numbers is called the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+numbers"} algebraic numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℚ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\mathbb{Q}}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
          %h3#topologies Topologies
          %p
            There are several interesting
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologies
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/2]
            that make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/2]
            into a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            under addition, allowing us to define interesting fields by taking the
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} completion
            with respect to this topology:
          %ol
            %li
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                is the most obvious, which is already complete.
            %li
              %p
                The
                %em absolute-value topology
                is defined by the
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq {|x - y|}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %p
                (This topology is
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+space"} totally disconnected
            %li
              %p
                The
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                  \-adic topology
                is defined by the
                %a.existingWikiWord{:href => "/nlab/show/ultrametric"} ultrametric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi n
                    %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq 1/n
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is the highest exponent on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                in the
                %a.existingWikiWord{:href => "/nlab/show/prime+factorization"} prime factorization
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {|x - y|}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/adic+number"} adic numbers
