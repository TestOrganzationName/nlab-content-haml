            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quaternion"} quaternion
          %h2#references References
          %ul
            %li#Loday87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Loday"}> Jean-Louis Loday
                ,
                = succeed "," do
                  %em Homologies diédrale et quaternionique
                %strong 66
                (1987) pp.119-148.
            %li#Dunn89
              %p
                Gerald Dunn,
                = succeed "," do
                  %em Dihedral and Quaternionic Homology and Mapping Spaces
                %strong 3
                (1989) pp.141-161.
            %li#Spalinski95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jan+Spalinski"}> Jan Spaliński
                ,
                = succeed "," do
                  %em Homotopy theory of dihedral and quaternionic sets
                %strong 39
                (1995) pp.35-52.
            %li#Krasauskas87
              %p
                R. Krasauskas,
                = succeed "," do
                  %em Skew-simplicial groups
                %strong 27
                pp.47-54 (1987).
            %li#FL91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zbigniew+Fiedorowicz"}> Zbigniew Fiedorowicz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Loday"} Jean-Louis Loday
                = succeed "," do
                  %em Crossed simplicial groups and their associated homology
                %strong 326
                (1991) 57-87 &amp;lbrack;
                %a{:href => "https://doi.org/10.1090/S0002-9947-1991-0998125-4"}> doi:10.1090/S0002-9947-1991-0998125-4
                \&amp;rbrack;
            %li#BM11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                = succeed "," do
                  %em On an extension of the notion of Reedy category
                %strong 269
                (2011) pp.977-1004. (
                %a{:href => "http://arxiv.org/abs/0809.3341"}> arXiv:0809.3341
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Dyckerhoff"}> Tobias Dyckerhoff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"} Mikhail Kapranov
                = succeed "," do
                  %em Crossed simplicial groups and structured surfaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1403.5799"} abstract
            %li#Balchin18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Scott+Balchin"}> Scott Balchin
                ,
                = succeed "," do
                  %em Homotopy of planar Lie group equivariant presheaves
                %strong 13
                (2018) pp.555-580. (
                %a{:href => "https://doi.org/10.1007/s40062-017-0193-z"}> doi
                )
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  Since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} \Delta Q
                  encapsulates exactly the structure of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Q
                          %mo *
                      %annotation{:encoding => "application/x-tex"} Q_*
                  (i.e. the simplicial set that has fibers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Q
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} Q_{n+1}
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [n]
                  together with simplicially compatible actions) it is also referred to as the
                  = succeed "." do
                    %em quaternionic crossed simplicial group
                  %a.existingWikiWord{:href => "/nlab/show/crossed+group"} crossed group
                  would refer to it as the
                  %em total category
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} crossed simplicial group
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Q
                            %mo *
                        %annotation{:encoding => "application/x-tex"} Q_*
                  %a{:href => "#Loday87"} Loday
                  by taking
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Q
                          %mi n
                          %mi op
                      %annotation{:encoding => "application/x-tex"} Q_n^{op}
                  as automorphism group at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [n-1]
                  whereas other authors like Krasauskas or Dyckerhoff-Kapranov use
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Q
                            %mi n
                        %annotation{:encoding => "application/x-tex"} Q_n
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
