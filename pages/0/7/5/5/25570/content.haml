              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong quaternionic set
            is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            with a
            %a.existingWikiWord{:href => "/nlab/show/quaternion+group"} quarternionic
            symmetry, in other words it is a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on the quaternionic simplex category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi Q
                %annotation{:encoding => "application/x-tex"} \Delta Q
            which contains the ordinary
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            and an opposite
            %a.existingWikiWord{:href => "/nlab/show/quaternion+group"} quaternion group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Q
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %mi op
                %annotation{:encoding => "application/x-tex"} Q_{n+1}^{op}
            as the automorphism group at the objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} crossed simplicial object
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi n
                %annotation{:encoding => "application/x-tex"} Q_n
            be the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            given by the
            %a.existingWikiWord{:href => "/nlab/show/group+presentation"} presentation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi x
                      %mi n
                    %mo =
                    %msup
                      %mi y
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mi y
                    %mi x
                    %msup
                      %mi y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x,y| x^n  = y^2\;,y x y^{-1}=x^{-1}\}
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternion+group"} quaternion group
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/binary+dihedral+group"} binary dihedral group
          %p
          #Definition.num_defn
            %h6 Definition
            %p
              The
              %strong quaternionic simplex category
              %sup#fnref:1
                %a{:href => "#fn:1", :rel => "footnote"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \Delta Q
              has objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi n
                      %mo ≥
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} [n],\; n\geq 0\;
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              as a (non-
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"}> full
              )
              %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
              and each
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              has as
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              the (
              %a.existingWikiWord{:href => "/nlab/show/opposite+group"} opposite
              of the)
              = succeed "st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/quaternion+group"} quaternion group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Aut
                        %mrow
                          %mi Δ
                          %mi Q
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi Q
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                        %mi op
                    %annotation{:encoding => "application/x-tex"} Aut_{\Delta Q}([n]) = Q_{n+1}^{op}
            %p
              Furthermore, any
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \varphi:[m]\to [n]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \Delta Q
              can be uniquely factored as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo =
                    %mi s
                    %mo ∘
                    %mi q
                  %annotation{:encoding => "application/x-tex"} \varphi = s\circ q
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} s:[m]\to [n]\in \Delta
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %msubsup
                        %mi Q
                        %mrow
                          %mi m
                          %mo +
                          %mn 1
                        %mi op
                    %annotation{:encoding => "application/x-tex"} q\in Q_{m+1}^{op}
            %p
              A
              %strong quaternionic set
              is a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
          %h2#properties Properties
          %ul
            %li
              %p
                According to the classification of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/crossed+group"} crossed simplicial groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
                or, more precisely, the equivalent crossed group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Q_*
                corresponds to the
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
                of crossed groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo →
                      %msub
                        %mi Q
                        %mo *
                      %mo →
                      %msub
                        %mi D
                        %mo *
                      %mo →
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"} 1\to \mathbb{Z}/2\to Q_*\to D_*\to 1\; .
                Whence it is of
                %em dihedral type
                and, accordingly, the
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                techniques for planar crossed simplicial groups apply (cf.
                = succeed "," do
                  %a{:href => "#Spalinski95"} Spaliński
                = succeed ")." do
                  %a{:href => "#Balchin18"} Balchin
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Q_*
                is the normalizer of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} S^3
                (cf.
                = succeed ")." do
                  %a{:href => "#Loday87"} Loday
            %li
              %p
                Just like in the
                %a.existingWikiWord{:href => "/nlab/show/cyclic+set"} cyclic
                and
                %a.existingWikiWord{:href => "/nlab/show/dihedral+set"} dihedral
                cases,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
                is
                = succeed ":" do
                  %em self-dual
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                      %mo ≅
                      %mi Δ
                      %msup
                        %mi Q
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \Delta Q\cong \Delta Q^{op}
                (cf.
                = succeed "," do
                  %a{:href => "#Dunn89"} Dunn
            %li
              %p
                As usual for
                %a.existingWikiWord{:href => "/nlab/show/crossed+group"} crossed groups
                (or, more generally, for functors between small categories that are surjective on objects; cf.
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Moerdijk-Maclane
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi Δ
                      %mo →
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} i:\Delta\to \Delta Q
                induces by
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                an
                %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
                %a.existingWikiWord{:href => "/nlab/show/surjective+geometric+morphism"} surjective geometric morphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mo !
                        %mo ⊢
                        %msup
                          %mi i
                          %mo *
                        %mo ⊢
                        %msub
                          %mi i
                          %mo *
                        %mo :
                        %msup
                          %mi Set
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                        %mo →
                        %msup
                          %mi Set
                          %mrow
                            %mi Δ
                            %msup
                              %mi Q
                              %mi op
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"} i_!\vdash i^*\vdash i_*: Set^{\Delta^{op}}\to Set^{\Delta Q^{op}}\;
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mo :
                      %msup
                        %mi Set
                        %mrow
                          %mi Δ
                          %msup
                            %mi Q
                            %mi op
                      %mo →
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} i^*:Set^{\Delta Q^{op}}\to Set^{\Delta^{op}}
                restricts a presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
                to one on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                by pre-composition:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi P
                        %mo ∘
                        %msup
                          %mi i
                          %mi op
                        %mspace{:width => "thinmathspace"}
                      %annotation{:encoding => "application/x-tex"} i^*(P)=P\circ i^{op}\,
            %li
              %p
                Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo →
                      %msup
                        %mi Set
                        %mrow
                          %mi Δ
                          %msup
                            %mi Q
                            %mi op
                    %annotation{:encoding => "application/x-tex"} i:Set^{\Delta^{op}}\to Set^{\Delta Q^{op}}
                is surjective, it follows again by generalities that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %mi Δ
                          %msup
                            %mi Q
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\Delta Q^{op}}
                is (equivalent to) the category of algebras for the
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                induced by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi i
                        %mo !
                    %annotation{:encoding => "application/x-tex"} i^*i_!
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\Delta^{op}}
                whence quaternionic sets are indeed
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial sets
                enhanced with a quaternionic algebra structure. From this perspective,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mo !
                      %mo ⊢
                      %msup
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} i_!\vdash i^*
                is an
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                between a
                %a.existingWikiWord{:href => "/nlab/show/free+functor"} free algebra functor
                and an underlying (simplicial) set functor. (For an explicit description of the free
                %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} skew-simplicial set
                on a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                and the corresponding monad for general crossed groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mo *
                    %annotation{:encoding => "application/x-tex"} G_*
                see
                = succeed ".)" do
                  %a{:href => "#Krasauskas87"} Krasauskas
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
                is an
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+category"} Eilenberg-Zilber category
                with degree function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo :
                      %mi Δ
                      %mi Q
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} deg:\Delta Q\to \mathbb{N}
                inherited from
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \Delta
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} skew simplicial sets
                %a.existingWikiWord{:href => "/nlab/show/crossed+group"} crossed groups
                over a strict
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
                (cf.
                %a{:href => "#BM11"} Berger-Moerdijk
                ex. 6.8).
            %li
              %p
                Truncating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \Delta Q
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [1]
                and taking presheaves, one obtains a
                %em category of quaternionic graphs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %mi Δ
                          %msubsup
                            %mi Q
                            %mrow
                              %mo ≤
                              %mn 1
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\Delta Q_{\leq 1}^{op}}
                with a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} Q_2
                action, just like
                %a.existingWikiWord{:href => "/nlab/show/graphic+category"} reflexive graphs
                result from
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Delta_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \Delta S
                in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+set"} symmetric simplex category
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} skew-simplicial set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crossed+group"} crossed group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+set"} cyclic set
