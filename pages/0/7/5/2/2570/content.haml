              %a.existingWikiWord{:href => "/nlab/show/Barrett+O%27Neill"}> Barrett O'Neill
              , Lem. 2.24 (p. 50) of:
              = succeed "," do
                %em Semi-Riemannian Geometry With Applications to Relativity
              = succeed "," do
