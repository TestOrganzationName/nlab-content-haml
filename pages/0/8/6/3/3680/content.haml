          %h2#references References
          %ul
            %li#Hovey
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                , Item 9 of:
                %em Errata to Model Categories
                (1999) &amp;lbrack;
                %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/hovey-model-cats-errata.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Hovey-ModelCategories-Errata.pdf", :title => "pdf"} pdf
