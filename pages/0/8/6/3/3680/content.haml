                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    U\big(  (X,\phi_X) \big) \;=\; X
                    \\,,
                    \\;\;\;\;\;\;
                    U\big(  (B,\phi_B) \big) \;=\; B
                    \\,,
                    \\;\;\;\;\;\;
                    U\big(  (Y,\phi_Y) \big) \;=\; Y
                    \\,,
            %p we have:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %msub
                          %mi ϕ
                          %mi B
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi B
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U
                    \\Big(
                    \\;
                    (X,\phi_X)
                    \\underset{
                    (B,\phi_B)
                    }{\coprod}
                    (Y,\phi_Y)
                    \\;
                    \\Big)
                    \\;\;\;\simeq\;\;\;
                    X \underset{B}{\coprod} Y
                    \\,.
            %p
              In particular, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %msub
                      %mi id
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,\phi_B) \;\coloneqq\; (T,id_T)
              is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi T
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{T/}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo ,
                        %msub
                          %mi id
                          %mi T
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X,\phi_X)
                    \\coprod
                    (Y,\phi_Y)
                    \\;\;=\;\;
                    (X,\phi_X)
                    \\underset{
                    (T,id_T)
                    }{\coprod}
                    (Y,\phi_Y)
            %p we find that the coproduct in the co-slice category is the co-fiber product under the given tip object in the underlying category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi T
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U
                    \\Big(
                    \\;
                    (X,\phi_X)
                    \\coprod
                    (Y,\phi_Y)
                    \\;
                    \\Big)
                    \\;\;\;\simeq\;\;\;
                    X \underset{T}{\coprod} Y
                    \\,.
          %h3#OnCategoriesOfSimplices On categories of simplices
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} K \in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} \Delta_{/K}
              for its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+simplices"} category of simplices
              of the simplicial set:
            %p
              an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} \Delta_{/K}
              is a morphism of simplicial sets of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \Delta^n \to K
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              (hence an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mi Δ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta^{n_1}&amp;&amp;\to&amp;&amp; \Delta^{n_2}
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; K
                    }
                    \\,.
            %p Moreover, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi nd
                    %mo ↪
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{/K}^{nd} \hookrightarrow \Delta_{/K}
            %p for the non-full subcategory on the non-degenerate simplices.
          .num_remark
            %h6#remark_2 Remark
            %p
              When the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is non-singular, i.e. every face of a non-degenerate simplex is still non-degenerate, then the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi nd
                  %annotation{:encoding => "application/x-tex"} \Delta_{/K}^{nd}
              is a
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              and it coincides with the
              %a.existingWikiWord{:href => "/nlab/show/barycentric+subdivision"} barycentric subdivision
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a non-singular simplicial set. Then the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi nd
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N(\Delta_{/K}^{nd}) \hookrightarrow N(\Delta_{/K})
            %p
              is a cofinal morphism of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          %p
            This appears as (
            %a{:href => "#Lurie"}> Lurie, variant 4.2.3.15
            ).
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For every simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              there exists a cofinal map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N(\Delta_{/K}) \to K
                    \\,.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, prop. 4.2.3.14
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              If the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is singular, it is not in general true that the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi nd
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(\Delta_{/K}^{nd}) \hookrightarrow N(\Delta_{/K})
              is final. For a counter-example, see (
              %a{:href => "#Hovey"}> Hovey, 9
              ).
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For every simplicial set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N(\Delta_{/K})^{op} \to K
                    \\,.
            %p is both initial and final.
          %p
            This appears as (
            %a{:href => "#Shah"}> Shah, 12.2
            ) and also follows from the fact that this map is a weak localization (
            %a{:href => "#Cisinski"}> Cisinski, 7.3.15
            ).
          .num_remark
            %h6#remark_4 Remark
            %p
              This can be used to establish a
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+formula"} Bousfield-Kan formula
              for
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
              = succeed ")." do
                %a{:href => "#Shah"} Shah, 12.3
