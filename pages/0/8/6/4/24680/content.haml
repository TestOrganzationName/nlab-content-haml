                      %p
                        %a.existingWikiWord{:href => "/nlab/show/omega-graph"}> omega-graph
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/hypergraph"} hypergraph
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/quiver"}> quiver
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/n-quiver"} n-quiver
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/category+of+simple+graphs"} category of simple graphs
                  %h3#properties Properties
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/graph+distance"} graph distance
                  %h3#extra_properties Extra properties
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/reflexive+graph"}> reflexive
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/bipartite+graph"} bipartite
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar
                  %h3#extra_structure Extra structure
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/reflexive+graph"} reflexive
                        %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
                        +
                        %a.existingWikiWord{:href => "/nlab/show/unit+law"} unital
                        %a.existingWikiWord{:href => "/nlab/show/associative"} associative
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                        \=
                        %a.existingWikiWord{:href => "/nlab/show/category"} category
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/ribbon+graph"}> ribbon graph
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/combinatorial+map"} combinatorial map
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/topological+map"} topological map
                        %a.existingWikiWord{:href => "/nlab/show/child%27s+drawing"} child's drawing
                    %li
