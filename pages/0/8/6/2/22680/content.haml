                  %div
                    %p
                      %a{:href => "/nlab/edit/monoid+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#initial_and_terminal_absorption_monoids"} Initial and terminal absorption monoids
                %li
                  %a{:href => "#absorption_monoid_homomorphisms"} Absorption monoid homomorphisms
                %li
                  %a{:href => "#ideals_and_antiideals"} Ideals and anti-ideals
                %li
