          %h2#examples Examples
          %h3#the_multiplicative_monoid_of_the_natural_numbers The multiplicative monoid of the natural numbers
          %p
            The multiplicative monoid of the natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^\times
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free
            commutative absorption monoid on the natural numbers, the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            commutative absorption monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^\times
            with a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} prime
                    %mo :
                    %mi ℕ
                    %mo →
                    %msup
                      %mi ℕ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathrm{prime}:\mathbb{N} \to \mathbb{N}^\times
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^\times
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^\times
            at the image of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} prime
                  %annotation{:encoding => "application/x-tex"} \mathrm{prime}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
