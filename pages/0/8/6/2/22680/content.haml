                %li
                  %a{:href => "#integral_monoids"} Integral monoids
                %li
                  %a{:href => "#ore_sets_and_ore_absorption_monoids"} Ore sets and Ore absorption monoids
                %li
                  %a{:href => "#localization_and_group_completion"} Localization and group completion
                %li
