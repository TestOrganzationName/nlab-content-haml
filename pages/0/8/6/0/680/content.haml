                          %mi op
                    %mover
                      %mo →
                      %mo ←
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    N \;\colon\; A^{\Delta^{op}}
                    \\stackrel{\leftarrow}{\to} Ch_\bullet^+(A) \;\colon\; \Gamma
            %p between
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  the
