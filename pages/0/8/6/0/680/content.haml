                is the
                = succeed "/normalized" do
                  %a.existingWikiWord{:href => "/nlab/show/normalized+chains+complex"} normalized chains complex
                %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
                functor.
            %p
          %p
            (
            %a{:href => "#Dold58"}> Dold 58
            ,
            = succeed "," do
              %a{:href => "#Kan58"} Kan 58
            = succeed ")." do
              %a{:href => "#DoldPuppe61"} Dold-Puppe 61
          %p
          .num_theorem
            %h6 Theorem
            %p
              %strong (Kan)
              %br/
              For the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the category
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
