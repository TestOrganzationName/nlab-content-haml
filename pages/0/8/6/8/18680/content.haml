                %a{:href => "https://mvr.hosting.nyu.edu/pubs/translation.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Riley-QuantumCertification.pdf", :title => "pdf"} pdf
