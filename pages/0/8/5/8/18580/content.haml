          #FloorAndCeilingAsAdjointFunctors.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/floor"} floor
                and
                %a.existingWikiWord{:href => "/nlab/show/ceiling"} ceiling
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            %p Consider the canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mo ≤
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi AA
                        %mi ι
                        %mphantom
                          %mi AA
                    %msub
                      %mi ℝ
                      %mo ≤
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_{\leq}
                    \\overset{\phantom{AA}\iota \phantom{AA}}{\hookrightarrow}
                    \\mathbb{R}_{\leq}
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              into the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/preorders"} preorders
              in the standard way (“lower or equal”). Regarded as
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
              = succeed "," do
                %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                      %annotation{:encoding => "application/x-tex"} \iota
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/ceiling+function"} ceiling function
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                      %annotation{:encoding => "application/x-tex"} \iota
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/floor+function"} floor function
            #eq:AdjointTriple.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌈
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌉
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ι
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌋
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lceil(-)\rceil \;\;\dashv\;\; \iota \;\;\dashv\;\; \lfloor (-) \rfloor
                    \\,.
            %p
              Hence this induces an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              and
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              express that each real number is in between its floor and ceiling
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} ⌊
                    %mi x
                    %mo{:stretchy => "false"} ⌋
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi ι
                    %mo{:stretchy => "false"} ⌈
                    %mi x
                    %mo{:stretchy => "false"} ⌉
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \lfloor x \rfloor \;\leq\; x \;\leq\; \iota \lceil x \rceil
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
              in both cases are the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              among the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          .proof
            %h6#proof Proof
            %p
              First of all, observe that we indeed have
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌋
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⌈
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌉
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ⟶
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\lfloor(-)\rfloor \;,\;
                    \\lceil(-)\rceil
                    \\;\;\colon\;
                    \\mathbb{R}
                    \\longrightarrow
                    \\mathbb{Z}
            %p since floor and ceiling preserve the ordering relation.
            %p
              Now in view of the identification of
              %a.existingWikiWord{:href => "/nlab/show/preorders"} preorders
              with
              %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
              in Example
              = succeed "," do
                %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ⊣
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \iota \dashv \lfloor(-)\rfloor
              says for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mi n
                          %mo ≤
                          %mo{:stretchy => "false"} ⌊
                          %mi x
                          %mo{:stretchy => "false"} ⌋
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mi ℤ
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi n
                          %mo ≤
                          %mi x
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{ \in \mathbb{Z}}{\underbrace{n \leq \lfloor x \rfloor}}
                    \\;\Leftrightarrow\;
                    \\underset{ \in \mathbb{R}}{\underbrace{n \leq x }}
                    \\,.
            %p
              This is clearly already the defining condition on the
              %a.existingWikiWord{:href => "/nlab/show/floor"} floor
              function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⌊
                      %mi x
                      %mo{:stretchy => "false"} ⌋
                    %annotation{:encoding => "application/x-tex"} \lfloor x \rfloor
            %p
              Similarly, the hom-isomorphism defining
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌈
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⌉
                    %mo ⊣
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \lceil(-)\rceil \dashv \iota
              says that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} ⌈
                          %mi x
                          %mo{:stretchy => "false"} ⌉
                          %mo ≤
                          %mi n
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mi ℤ
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi x
                          %mo ≤
                          %mi n
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{ \in \mathbb{Z}}{\underbrace{\lceil x \rceil \leq n}}
                    \\;\Leftrightarrow\;
                    \\underset{ \in \mathbb{R}}{\underbrace{x \leq n }}
                    \\,.
            %p
              This is evidently already the defining condition on the
              %a.existingWikiWord{:href => "/nlab/show/floor"} floor
              function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⌊
                      %mi x
                      %mo{:stretchy => "false"} ⌋
                    %annotation{:encoding => "application/x-tex"} \lfloor x \rfloor
            %p
              Notice that in both cases the condition of a
              %em
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              in both variables, as required for an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x \leq x'
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ′
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n' \leq n
              = succeed "," do
                %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ≤
                            %mo{:stretchy => "false"} ⌊
                            %mi x
                            %mo{:stretchy => "false"} ⌋
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⇔
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ≤
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇓
                          %mtd
                          %mtd
                            %mo ⇓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ′
                            %mo ≤
                            %mo{:stretchy => "false"} ⌊
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} ⌋
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⇔
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ′
                            %mo ≤
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mo ∈
                            %mi ℤ
                          %mtd
                          %mtd
                            %mo ∈
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (n \leq \lfloor x \rfloor) &amp;\Leftrightarrow&amp; (n \leq x)
                    \\\
                    \\Downarrow &amp;&amp; \Downarrow
                    \\\
                    (n' \leq \lfloor x' \rfloor) &amp;\Leftrightarrow&amp; (n' \leq x')
                    \\\
                    \\\
                    \\in \mathbb{Z} &amp;&amp; \in \mathbb{R}
                    }
            %p
              where the logical implications are equivalently functions between
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              that are either
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              or
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
          %h2#references References
          %p Wikipedia summarizes the basic properties:
          %ul
            %li
              English Wikipedia. Floor and ceiling functions.
              = succeed "." do
                %a{:href => "https://en.wikipedia.org/wiki/Floor_and_ceiling_functions"} Web
          %p
            Chapter 6 of these notes uses the floor and ceiling functions throughout to relate
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            and
            %a.existingWikiWord{:href => "/nlab/show/series"} series
            when teaching
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+calculus"} infinitesimal calculus
          %ul
            %li
              Toby Bartels. One-variable Calculus.
              = succeed "." do
                %a{:href => "http://tobybartels.name/MATH-1600/2017FA/calcbook/"} Web
