                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⌊
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi x
                  %mo{:stretchy => "false"} ⌋
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \lceil{x}\rceil = -\lfloor{-x}\rfloor ,
          %p this is not actually a restriction.
          %p
            The floor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
