          %h2#idea Idea
          %p
            By the
            %em floor
            and
            %em ceiling
            of a
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            one means the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          %p
            When viewed as
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            to itself (or to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/continuity"} continuity
            %span.newWikiWord
              right-continuous
              %a{:href => "/nlab/new/right-continuous+map"} ?
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/upper+semicontinuous+map"} upper semicontinuous
            %span.newWikiWord
              left-continuous
              %a{:href => "/nlab/new/left-continuous+map"} ?
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lower+semicontinuous+map"} lower semicontinuous
            %a.existingWikiWord{:href => "/nlab/show/step+functions"} step functions
            used to approximate definite
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            and otherwise to relate integrals and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/series"} series
            = succeed "." do
              %span.newWikiWord
                rounding
                %a{:href => "/nlab/new/rounding"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/order+theory"} order theory
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            and
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            (respectively) of the
            %a.existingWikiWord{:href => "/nlab/show/inclusion+map"} inclusion map
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to
