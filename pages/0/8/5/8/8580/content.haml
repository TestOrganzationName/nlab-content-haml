              between two given
              %a.existingWikiWord{:href => "/nlab/show/gauge+equivalences"} gauge equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mn 1
                    %mo ,
                    %msub
                      %mi λ
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
