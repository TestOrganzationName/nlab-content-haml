                    %msub
                      %mo ∇
                      %mn 1
                    %mo ≃
                    %msub
                      %mo ∇
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda_1, \lambda_2 \colon (\nabla_1 \simeq \nabla_2)
              between two given
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
              = succeed "." do
