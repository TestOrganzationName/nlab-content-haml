              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              between
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
