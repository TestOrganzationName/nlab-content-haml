                %td{:style => "text-align: left;"}
          %p Suppose then that we have such a map between collections of gauge fields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi H
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\phi \colon [X, \mathbf{B}G_{conn}] \to [Y, \mathbf{B}H_{conn}]
          %p
            on two possibly different
            %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
            with two possibly different
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+groups"} gauge groups
          %p
            (For instance we might be looking at
            = succeed "/_" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Montonen-Olive+duality"} Montonen-Olive duality
            = succeed "_" do
              %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            %em
              %a.existingWikiWord{:href => "/nlab/show/Seiberg+duality"} Seiberg duality
            of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theory"} super Yang-Mills theory
          %p
            Then we should call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            \- in the physics literature often: a
            %em
              %a.existingWikiWord{:href => "/nlab/show/duality+in+physics"} duality
            – if, while not necessarily being a “
            %a.existingWikiWord{:href => "/nlab/show/bijection"}> bijection
            ”, it is such that the preimage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi^{-1}(\nabla) \in [X,\mathbf{B}G_{conn}]
            of a gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi H
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \nabla \in [Y, \mathbf{B}H_{conn}]
            consists of gauge fields that are all gauge equivalent to each other, with the gauge equivalences exhibiting this equivalence themselves all being gauge equivalent to each other, etc.
          %p
            If this is the case one says that all
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            –
            %em all gauge pre-images
            – of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            are
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            – are
            %em gauge equivalent to a single gauge field
            – and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          %p
            For consistency we should demand that the notion of equivalence is such that the space of direct equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi H
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X, \mathbf{B}G_{conn}] \simeq [Y, \mathbf{B}H_{conn}]
            is itself equivalent to the space of such weak homotopy equivalences (“
            %a.existingWikiWord{:href => "/nlab/show/duality+in+physics"}> dualities
            ”)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi H
                      %mi conn
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X, \mathbf{B}G_{conn}] \stackrel{\simeq}{\to} [Y, \mathbf{B}H_{conn}]
          %p
            This requirement is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
                %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            = succeed "-language" do
              %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %p
            We indicate now some central judgements that are expressible in homotopy type theory. This involves fundamental judgements in
            %em
              %a.existingWikiWord{:href => "/nlab/show/group+theory"} group theory
            and in
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+theory"} quantum theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
