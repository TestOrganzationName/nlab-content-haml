                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi UnderlyingBundle
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} UnderlyingBundle(\lambda) \colon UnderlyingBundle(\nabla_1) \simeq UnderlyingBundle(\nabla_2)
              between the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instanton"} instanton sectors
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/metalanguage"} formal language
            based of the
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            which we have so far that contains these statements is
