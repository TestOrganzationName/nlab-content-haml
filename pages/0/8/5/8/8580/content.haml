                  %annotation{:encoding => "application/x-tex"} \nabla_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \nabla_2
          %p
