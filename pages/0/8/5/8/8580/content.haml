            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundles"} associated ∞-bundles
            as in
            %em
              %a{:href => "#SectionsOfAssociatedBundles"} Sections of associated ∞-bundles
            is laid out in
          %ul
