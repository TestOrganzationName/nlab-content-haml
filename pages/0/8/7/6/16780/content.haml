          %p
            More in detail, there are variants of the tetrahedral group corresponding to the stages of the
            = succeed ":" do
              %a{:href => "Whitehead+tower#OfTheOrthogonalGroup"} Whitehead tower of O(3)
          %ul
            %li
              %p
                the full tetrahedral group is the
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                of
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} O(3)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi d
                      %mo ↪
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      T_d \hookrightarrow O(3)
              %p
                which is the
                %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer
                of the standard embedding of the
                %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedron
                into
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            %li
              %p
                the
                %em rotational tetrahedral group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ↪
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T \hookrightarrow SO(3)
                is the restriction to
                = succeed "-preserving" do
                  %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} SO(3)
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                to the
                %a.existingWikiWord{:href => "/nlab/show/alternating+group"} alternating group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} A_4
            %li
              %p
                next the
                %em binary tetrahedral group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi T
                    %annotation{:encoding => "application/x-tex"} 2T
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                to
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} Spin(3)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                    %annotation{:encoding => "application/x-tex"} \simeq
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU(2)
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                over the
                %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_3
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi T
                      %mo ≃
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %msub
                        %mi 𝔽
                        %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      2T \simeq SL(2,\mathbb{F}_3)
            %li
              %p
                then there is a
                %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
                lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi String
                        %mrow
                          %mn 2
                          %mi T
                      %mo ↪
                      %msub
                        %mi String
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} String_{2T} \hookrightarrow String_{SU(2)}
                of the tetrahedral group to a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Platonic+2-group"} Platonic 2-group
                (
                %a{:href => "#Epa10"}> Epa 10
                ,
                = succeed ")" do
                  %a{:href => "#EpaGanter16"} Epa-Ganter 16
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi String
                            %mrow
                              %mn 2
                              %mi T
                        %mtd
                          %mo ↪
                        %mtd
                          %msub
                            %mi String
                            %mrow
                              %mi SU
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mn 2
                          %mi T
                        %mtd
                          %mo ↪
                        %mtd
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi T
                          %mo ≃
                          %msub
                            %mi A
                            %mn 4
                        %mtd
                          %mo ↪
                        %mtd
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi T
                            %mi d
                          %mo ≃
                          %msub
                            %mi S
                            %mn 5
                        %mtd
                          %mo ↪
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
