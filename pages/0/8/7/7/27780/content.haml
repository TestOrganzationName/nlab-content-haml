                        \\;\simeq\;
                        O
                        \\;\simeq\;
                        KO_1
                        \\,.
            %p
          (
          %a{:href => "#AtiyahSinger1969"}> Atiyah &amp; Singer 1969 Cor. to Thm. A(k)
          ,
