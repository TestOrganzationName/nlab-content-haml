                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi T
                          %mo ^
                        %mn 2
                      %mo =
                      %mo ±
                      %mi id
                    %annotation{:encoding => "application/x-tex"} \widehat{T}^2 = \pm id
                (a
                %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
                or
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quaternionic+structure"} quaternionic structure
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi C
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{C}
                an odd complex
                %a.existingWikiWord{:href => "/nlab/show/anti-linear+operator"} anti-linear operator
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi C
                            %mo ^
                          %mn 2
                        %mo =
                        %mo ±
                        %mi id
                      %annotation{:encoding => "application/x-tex"} \widehat{C}^2 = \pm id
          %p according to the following table, where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %munder
                      %mrow
                        %msubsup
                          %mi ℤ
                          %mn 2
                          %mi t
                      %mo ⏟
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi{:mathvariant => "normal"} e
                      %mo ,
                      %mi T
                      %mo{:stretchy => "false"} }
                  %mo ×
                  %munder
                    %munder
                      %mrow
                        %msubsup
                          %mi ℤ
                          %mn 2
                          %mi c
                      %mo ⏟
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi{:mathvariant => "normal"} e
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  G
                  \\;\subset\;
                  \\underset{
                  \\{\mathrm{e}, T\}
                  }{
                  \\underbrace{
                  \\mathbb{Z}^{t}_2
                  }
                  }
                  \\times
                  \\underset{
                  \\{\mathrm{e}, C\}
                  }{
                  \\underbrace{
                  \\mathbb{Z}^{c}_2
                  }
                  }
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the
            %a.existingWikiWord{:href => "/nlab/show/Klein+4-group"} Klein 4-group
            which has generators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (with product
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≔
                    %mi T
                    %mi C
                  %annotation{:encoding => "application/x-tex"} P \coloneqq T C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{C}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi P
                    %mo ^
                  %mo =
                  %mover
                    %mi T
                    %mo ^
                  %mover
                    %mi C
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{P} = \widehat{T}\widehat{C}
            appears as a constraint, respectively:
          %div{:style => "margin: -30px 0px 20px 30px"}
            %img{:src => "/nlab/files/QSfixedFredholms-251109.png", :width => "800px"}/
          %p
            Here the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QS
                %annotation{:encoding => "application/x-tex"} QS
            of “
            %a{:href => "Wigner+theorem#PCTQuantumSymmetryDefinitionAndClassification"}> graded quantum symmetries
            ” is the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QS
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %mi{:mathvariant => "normal"} U
                        %mo{:stretchy => "false"} (
                        %mi.mathscript ℋ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                      %mrow
                        %mi{:mathvariant => "normal"} U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %mo ⋊
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi c
                  %mo ×
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi t
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  QS
                  \\;\coloneqq\;
                  \\tfrac{
                  \\mathrm{U}(\mathscr{H})^2
                  }{
                  \\mathrm{U}(1)
                  }
                  \\rtimes
                  \\big(
                  \\mathbb{Z}_2^c \times \mathbb{Z}_2^t
                  \\big)
                  \\,.
          %p of
          %ul
            %li
              the
              %em graded
              version of the stable
              %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
              %a.existingWikiWord{:href => "/nlab/show/PU%28%E2%84%8B%29"} PU(ℋ)
              (with the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/norm+topology"} norm topology
          %p with
          %ul
            %li
              the group generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              acting by
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              and in addition by swapping of the two Hilbert space summands, respectively.
          %p
            Hence a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{(-)}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mi T
                  %mi C
                %annotation{:encoding => "application/x-tex"} P = T C
            to this group is represented by an (anti-)linear operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi T
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{T}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{C}
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{P}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi T
                        %mo ^
                      %mn 2
                    %mo ,
                    %msup
                      %mover
                        %mi C
                        %mo ^
                      %mn 2
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mo ±
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \widehat{T}^2, \widehat{C}^2 \in \{\pm 1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{G}
            of subgroups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⊂
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi t
                  %mo ×
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi c
                %annotation{:encoding => "application/x-tex"} G \subset \mathbb{Z}_2^t \times \mathbb{Z}_2^c
            is equivalent, by the above discussion, to one of the ten constrains that lead to the 10 possible classifying spaces for K-theory, as shown in the above table.
          %p
            Tables of related or analogous structures are well-known in the discussion of the “
            %a.existingWikiWord{:href => "/nlab/show/10-fold+way"}> 10-fold way
            ” of
            %a.existingWikiWord{:href => "/nlab/show/topological+phases+of+matter"} topological phases of matter
            (cf.
            = succeed "," do
              %a{:href => "K-theory+classification+of+topological+phases+of+matter#SchnyderRyuFurusakiLudwig2008"} Schnyder, Ryu, Furusaki &amp; Ludwig 2008 Table 1
            = succeed "," do
              %a{:href => "K-theory+classification+of+topological+phases+of+matter"} Kitaev 2009 Table 1
            = succeed ")," do
              %a{:href => "K-theory+classification+of+topological+phases+of+matter#FreedMoore13"} Freed &amp; Moore 2013 Prop. B.4 &amp; 6.4
            %a{:href => "Wigner+theorem#TenFoldWayOfPCTQuantumSymmetries"} classication of PCT quantum symmetries
            (see there); the concrete relation to the Atiyah-Jänich theorem as per the above table was made more explicit by
            = succeed "." do
              %a{:href => "#SatiSchreiber2023"} Sati &amp; Schreiber 2023 around Table 3
          %p
            %br/
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              For discussion of the
              %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"} basic complex line bundle on the 2-sphere
              realized as a Fredholm index bundle see
              = succeed "." do
                %a{:href => "basic+complex+line+bundle+on+the+2-sphere#AsAFredholmIndexBundle"} there
          %h2#references References
          %h3#general General
          %p The original articles:
          %ul
            %li{:id => "Jänich65"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaus+J%C3%A4nich"}> Klaus Jänich
                \:
                = succeed "," do
                  %em Vektorraumbündel und der Raum der Fredholm-Operatoren
                %strong 161
                (1965) 129–142 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01360851"}> doi:10.1007/BF01360851
                \&amp;rbrack;
            %li#Atiyah67
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                , Thm. A.1 in:
                = succeed "," do
                  %em K-theory
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/atiyahk.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/AtiyahKTheory.pdf", :title => "pdf"} pdf
            %li#Atiyah69
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                , §2 in:
                = succeed "," do
                  %em Algebraic Topology and Operators in Hilbert Space
                = succeed "," do
                  %em Lectures in Modern Analysis and Applications I
                = succeed "," do
                  %strong 103
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/BFb0099987"} doi:10.1007/BFb0099987
                = succeed "," do
                  %a{:href => "https://webhomes.maths.ed.ac.uk/~v1ranick/papers/atiyah002.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Atiyah-AlgTopAndOperators.pdf", :title => "pdf"} pdf
          %p
            Generalization to general degree and to
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/KO-theory"} KO-theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/KSp-theory"} KSp-theory
          %ul
            %li#AtiyahSinger1969
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+F.+Atiyah"}> Michael F. Atiyah
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+M.+Singer"} Isadore M. Singer
                = succeed "," do
                  %em Index theory for skew-adjoint Fredholm operators
                %strong 37
                (1969) 5-26 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF02684885"}> doi:10.1007/BF02684885
                ,
                = succeed "," do
                  %a{:href => "https://www.numdam.org/item/PMIHES_1969__37__5_0"} numdam:PMIHES_1969__37__5_0
                = succeed "&rbrack;" do
                  %a{:href => "https://webhomes.maths.ed.ac.uk/~v1ranick/papers/askew.pdf"} pdf
            %li#Karoubi1970
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                \:
                = succeed "," do
                  %em Espaces Classifiants en K-Théorie
                %strong 147
                (1970) 75-115 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/1995218"}> doi:10.2307/1995218
                ,
                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/1995218"} jstor:1995218
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Karoubi-EspacesClassifiants-English-251105.pdf", :title => "pdf"} pdf
          %p In monographs:
          %ul
            %li#Karoubi78
              %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
              , §I.7.10 in:
              = succeed "," do
                %em K-Theory – An Introduction
              = succeed "," do
                %strong 226
              = succeed "," do
                %a{:href => "https://webusers.imj-prg.fr/~max.karoubi/K.book/MK.book.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007%2F978-3-540-79890-3"} doi:10.1007%2F978-3-540-79890-3
              %blockquote
                %p (related discussion)
          %p Lecture notes:
          %ul
            %li#Sheth
              Arshay Sheth:
              %em The Atiyah-Jänich Theorem
              \&amp;lbrack;
              %a{:href => "https://warwick.ac.uk/fac/sci/maths/people/staff/sheth/report_talk12_arshaysheth.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Sheth-AtiyahJanich.pdf", :title => "pdf"} pdf
          %p
            As the basis of a definition of
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            and
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+equivariant+K-theory"} twisted equivariant K-theory
          %ul
            %li#AtiyahSegal04
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
              = succeed "," do
                %em Twisted K-theory
              %strong 1
              3 (2004) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0407054"}> arXiv:math/0407054
              ,
              = succeed "," do
                %a{:href => "http://iamm.su/en/journals/j879/?VID=10"} journal page
              = succeed "&rbrack;" do
                %a{:href => "http://iamm.su/upload/iblock/45e/t1-n3-287-330.pdf"} published pdf
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Byungdo+Park"}> Byungdo Park
              \:
              = succeed "," do
                %em The Atiyah-Jänich theorem and its twisted refinement – An introduction to category theory for freshmen
              = succeed "," do
                %a{:href => "https://byungdo.github.io/slides/2018-03-13_incheonU_printerfriendly.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Park-AJTheorem.pdf", :title => "pdf"} pdf
          %p Further development:
          %ul
            %li
              Kamran Sharifi:
              %em
                Atiyah-Jänich theorem for
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1612.03287"}> arXiv:1612.03287
              \&amp;rbrack;
          %h3#in_topological_quantum_physics In topological quantum physics
          %p
            Identifying the
            %a.existingWikiWord{:href => "/nlab/show/tachyon"} tachyon
            field in the argument for
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charge+quantization+in+topological+K-theory"} D-brane charge quantization in topological K-theory
            with the
            %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
            in the Atiyah-Jänich presentation of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li#Witten00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , p. 7 in:
                = succeed "," do
                  %em Overview Of K-Theory Applied To Strings
                %strong 16
                (2001) 693-706 &amp;lbrack;
                %a{:href => "https://doi.org/10.1142/S0217751X01003822"}> doi:10.1142/S0217751X01003822
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0007175"} arXiv:hep-th/0007175
            %li#Szabo2002
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"}> Richard Szabo
                , §3.1 in:
                = succeed "," do
                  %em D-Branes, Tachyons and K-Homology
                %strong 17
                (2002) 2297-2316 [
                %a{:href => "https://doi.org/10.1142/S0217732302009015"}> doi:10.1142/S0217732302009015
                ,
                = succeed "]" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0209210"} arXiv:hep-th/0209210
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dongfeng+Gao"}> Dongfeng Gao
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kentaro+Hori"} Kentaro Hori
                %em On The Structure Of The Chan-Paton Factors For D-Branes In Type II Orientifolds
                [
                %a{:href => "https://arxiv.org/abs/1004.3972"}> arXiv:1004.3972
                ]
          %p
            Discussion in the context of the
            %a.existingWikiWord{:href => "/nlab/show/10-fold+way"} 10-fold way
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+symmetries"} quantum symmetries
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+topological+phases+of+matter"} K-theory classification of topological phases of matter
          %ul
            %li#SatiSchreiber23
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Anyonic+topological+order+in+TED+K-theory"} Anyonic topological order in TED K-theory
              %strong 35
              03 (2023) 2350001 [
              %a{:href => "https://doi.org/10.1142/S0129055X23500010"}> doi:10.1142/S0129055X23500010
              ,
              = succeed "]" do
