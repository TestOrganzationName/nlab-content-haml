                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{P}
                an odd-graded complex
                %a.existingWikiWord{:href => "/nlab/show/linear+operator"} linear operator
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mn 2
                      %mo =
                      %mo ±
                      %mi id
                    %annotation{:encoding => "application/x-tex"} P^2 = \pm id
                (enforcing self-adjointness),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
