                    %mo{:stretchy => "false"} (
                    %msub
                      %mi.mathscript ℋ
                      %mi ℍ
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Fred^{sa}(\mathscr{H}_{\mathbb{H}})
                    \\;\simeq\;
                    Fred_+^{sa}(\mathscr{H}_{\mathbb{H}})
                    \\,\sqcup\,
                    Fred_-^{sa}(\mathscr{H}_{\mathbb{H}})
                    \\,\sqcup\,
                    Fred_\ast^{sa}(\mathscr{H}_{\mathbb{H}})
                    \\mathrlap{\,,}
            %p
              corresponding to those Fredholm operators whose
              %a.existingWikiWord{:href => "/nlab/show/essential+spectrum"} essential spectrum
              (which is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi Fred
                          %mo +
                          %mi sa
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi.mathscript ℋ
                          %mi ℍ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Fred_+^{sa}(\mathscr{H}_{\mathbb{H}})
                  \: purely
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi Fred
                          %mo −
                          %mi sa
                        %mo{:stretchy => "false"} (
