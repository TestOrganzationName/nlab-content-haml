                                      %mi z
                                      %mn 1
                                %mtr
                                  %mtd
                                    %msub
                                      %mi z
                                      %mn 2
                            %mo )
                        %mtd
                          %mo ↦
                        %mtd
                          %mrow
                            %mo (
                            %mrow
                              %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                %mtr
                                  %mtd
                                    %mo −
                                    %mover
                                      %mrow
                                        %msub
                                          %mi z
                                          %mn 2
                                      %mo ¯
                                %mtr
                                  %mtd
                                    %mover
                                      %mrow
                                        %msub
                                          %mi z
                                          %mn 1
                                      %mo ¯
                            %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbb{C}^2
                    \&amp;\xrightarrow{\; \widehat{T} \;}&amp;
                    \\mathbb{C}^2
                    \\\
                    \\left(
                    \\begin{matrix}
                    z_1
                    \\\
                    z_2
                    \\end{matrix}
                    \\right)
                    \&amp;\mapsto&amp;
                    \\left(
                    \\begin{matrix}
                    \-\overline{z_2}
                    \\\
                    \\overline{z_1}
                    \\end{matrix}
                    \\right)
                    \\end{array}
            %p
              is anti-self-adjoint (cf. Lem.
              = succeed "):" do
                %a.maruku-ref{:href => "#SelfAdjointAntiLinearOperator"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                            %mover
                              %mi T
                              %mo ^
                            %mover
                              %mi z
                              %mo{:stretchy => "false"} →
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mi w
                              %mo{:stretchy => "false"} →
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                          %mtd
                            %mo =
                            %mrow
                              %mo ⟨
                              %mrow
                                %mo (
                                %mrow
                                  %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                    %mtr
                                      %mtd
                                        %mo −
                                        %mover
                                          %mrow
                                            %msub
                                              %mi z
                                              %mn 2
                                          %mo ¯
                                    %mtr
                                      %mtd
                                        %mover
                                          %mrow
                                            %msub
                                              %mi z
                                              %mn 1
                                          %mo ¯
                                %mo )
                              %mo ,
                              %mrow
                                %mo (
                                %mrow
                                  %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                    %mtr
                                      %mtd
                                        %msub
                                          %mi w
                                          %mn 1
                                    %mtr
                                      %mtd
                                        %msub
                                          %mi w
                                          %mn 2
                                %mo )
                              %mo ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi z
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi w
                              %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mo +
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi z
                              %mn 1
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi w
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mover
                                  %mrow
                                    %msub
                                      %mi z
                                      %mn 2
                                  %mo ¯
                                %mspace{:width => "thinmathspace"}
                                %mover
                                  %mrow
                                    %msub
                                      %mi w
                                      %mn 1
                                  %mo ¯
                                %mo +
                                %mover
                                  %mrow
                                    %msub
                                      %mi z
                                      %mn 1
                                  %mo ¯
                                %mspace{:width => "thinmathspace"}
                                %mover
                                  %mrow
                                    %msub
                                      %mi w
                                      %mn 2
                                  %mo ¯
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mrow
                                %mo ⟨
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                      %mtr
                                        %mtd
                                          %msub
                                            %mi z
                                            %mn 1
                                      %mtr
                                        %mtd
                                          %msub
                                            %mi z
                                            %mn 2
                                  %mo )
                                %mo ,
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                      %mtr
                                        %mtd
                                          %mover
                                            %mrow
                                              %msub
                                                %mi w
                                                %mn 2
                                            %mo ¯
                                      %mtr
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mover
                                            %mrow
                                              %msub
                                                %mi w
                                                %mn 1
                                            %mo ¯
                                  %mo )
                                %mo ⟩
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                            %mover
                              %mi z
                              %mo{:stretchy => "false"} →
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mi T
                              %mo ^
                            %mover
                              %mi w
                              %mo{:stretchy => "false"} →
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Big\langle
                    \\widehat{T}\vec z
                    ,\,
                    \\vec w
                    \\Big\rangle
                    \&amp; =
                    \\left\langle
                    \\left(
                    \\begin{matrix}
                    \-\overline{z_2}
                    \\\
                    \\overline{z_1}
                    \\end{matrix}
                    \\right)
                    ,
                    \\left(
                    \\begin{matrix}
                    w_1
                    \\\
                    w_2
                    \\end{matrix}
                    \\right)
                    \\right\rangle
                    \\\
                    \&amp; =
                    \- z_2 \, w_1 \;+\; z_1 \, w_2
                    \\\
                    \&amp; =
                    \\overline{
                    \- \overline{z_2} \, \overline{w_1}
                    +
                    \\overline{z_1} \, \overline{w_2}
                    }
                    \\\
                    \&amp; =
                    \\overline{
                    \\left\langle
                    \\left(
                    \\begin{matrix}
                    z_1
                    \\\
                    z_2
                    \\end{matrix}
                    \\right)
                    ,
                    \\left(
                    \\begin{matrix}
                    \\overline{w_2}
                    \\\
                    \-\overline{w_1}
                    \\end{matrix}
                    \\right)
                    \\right\rangle
                    }
                    \\\
                    \&amp; =
                    \-
                    \\Big\langle
                    \\vec z
                    ,\,
                    \\widehat{T} \vec w
                    \\Big\rangle
                    \\mathrlap{\,.}
                    \\end{aligned}
            %p
          %p Now:
          %p
          #KaroubiModelForKO2.num_prop
            %h6 Proposition
            %p
              The space of
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
              on the complex Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              which are
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/anti-linear+maps"}> anti-linear
                  ,
              %li
                %p
                  (skew)
                  %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint
                  (cf. Lem.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#SelfAdjointAntiLinearOperator"}
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo †
                        %mo =
                        %mo ±
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F^\dagger = \pm F
            %p
              is a classifying space for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %msup
                      %mi{:mathvariant => "normal"} O
                      %mrow
                        %mo ±
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} K\mathrm{O}^{\pm 2}
              (where
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %msup
                        %mi{:mathvariant => "normal"} O
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 2
                      %mo ≃
                      %mi K
                      %msup
                        %mi{:mathvariant => "normal"} O
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} K\mathrm{O}^{-2} \simeq K \mathrm{O}^6
          (
          %a{:href => "#Karoubi1970"}> Karoubi 1970 Props. 1.9, 1.12
          )
          %p
            It is useful to reformulate Prop.
            %a.maruku-ref{:href => "#KaroubiModelForKO2"}
            as follows:
          %p
          .num_prop
            %h6 Proposition
            %p
              On the complex Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              consider a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/real+structure"} real
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+structure"} quaternionic structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi T
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat T
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi T
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{T}
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/anti-linear+map"} anti-linear
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi T
                            %mo ^
                          %mn 2
                        %mo =
                        %mo ±
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \widehat{T}^2 = \pm 1
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi T
                            %mo ^
                          %mo †
                        %mo =
                        %mo ±
                        %mover
                          %mi T
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{T}^\dagger = \pm \widehat{T}
                  (cf. Lem.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SelfAdjointAntiLinearOperator"}
            %p
              On the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                    %mo ⊕
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H} \oplus \mathscr{H}
              (cf. Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheSpaceOfGradedFredholmOperators"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                          %mtr
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                            %mtd
                              %mn 0
                      %mo )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{C}
                    \\,\coloneqq\,
                    \\left(
                    \\begin{matrix}
                    0 &amp; \widehat{T}
                    \\\
                    \\widehat{T} &amp; 0
                    \\end{matrix}
                    \\right)
                    \\mathrlap{\,.}
            %p Then the space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} {
                    %mi F
                    %mo ∈
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo ⊕
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} |
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable{:columnalign => "center", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi F
                            %mspace{:width => "thickmathspace"}
                            %mtext is odd
                            %mo ,
                        %mtr
                          %mtd
                            %msup
                              %mi F
                              %mo †
                            %mo =
                            %mi F
                            %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ∘
                    %mover
                      %mi C
                      %mo ^
                    %mo =
                    %mover
                      %mi C
                      %mo ^
                    %mo ∘
                    %mi F
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\bigg\{
                    F \in Fred(\mathscr{H} \oplus \mathscr{H})
                    \\;\bigg\vert\;
                    \\substack{
                    F\;\text{is odd},
                    \\\
                    F^\dagger = F,
                    }
                    \\;\;
                    F \circ \widehat{C} = \widehat{C} \circ F
                    \\bigg\}
            %p
              is a classifying space for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %msup
                        %mi{:mathvariant => "normal"} O
                        %mrow
                          %mo ±
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} K\mathrm{O}^{\pm 2}
          .proof
            %h6 Proof
            %p
              The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in our space is odd and self-adjoint implies that it is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi f
                                %mo †
                          %mtr
                            %mtd
                              %mi f
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \=
                    \\left(
                    \\begin{matrix}
                    0 &amp; f^\dagger
                    \\\
                    f &amp; 0
                    \\end{matrix}
                    \\right)
                    \\,.
            %p
              From this, the further condition that it commutes with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi C
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                          %mtr
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                            %mtd
                              %mn 0
                      %mo )
                    %mo ⋅
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi f
                                %mo †
                          %mtr
                            %mtd
                              %mi f
                            %mtd
                              %mn 0
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi f
                                %mo †
                          %mtr
                            %mtd
                              %mi f
                            %mtd
                              %mn 0
                      %mo )
                    %mo ⋅
                    %mrow
                      %mo (
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                          %mtr
                            %mtd
                              %mover
                                %mi T
                                %mo ^
                            %mtd
                              %mn 0
                      %mo )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\begin{matrix}
                    0 &amp; \widehat{T}
                    \\\
                    \\widehat{T} &amp; 0
                    \\end{matrix}
                    \\right)
                    \\cdot
                    \\left(
                    \\begin{matrix}
                    0 &amp; f^\dagger
                    \\\
                    f &amp; 0
                    \\end{matrix}
                    \\right)
                    \=
                    \\left(
                    \\begin{matrix}
                    0 &amp; f^\dagger
                    \\\
                    f &amp; 0
                    \\end{matrix}
                    \\right)
                    \\cdot
                    \\left(
                    \\begin{matrix}
                    0 &amp; \widehat{T}
                    \\\
                    \\widehat{T} &amp; 0
                    \\end{matrix}
                    \\right)
                    \\mathrlap{\,,}
            %p means equivalently that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mo †
                    %mo ∘
                    %mover
                      %mi T
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{T} \circ f
                    \\;=\;
                    f^\dagger \circ \widehat{T}
                    \\,,
            %p and hence our space is equivalently given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                    %mi f
                    %mo ∈
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mo †
                    %mo ∘
                    %mover
                      %mi T
                      %mo ^
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Big\{
                    f \in Fred(\mathscr{H})
                    \\;\Big\vert\;
                    \\widehat{T} \circ f
                    \\;=\;
                    f^\dagger \circ \widehat{T}
                    \\Big\}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of this form, notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \widehat{T} \circ f
              is (anti-linear and) self-adjoint/anti-self-adjoint:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo †
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mo †
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo ±
                    %mo{:stretchy => "false"} )
                    %mover
                      %mi T
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo ±
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\widehat{T} \circ f
                    \\big)^\dagger
                    \\;=\;
                    f^\dagger \circ (\pm)\widehat{T}
                    \\;=\;
                    \\pm
                    \\widehat{T} \circ f
                    \\mathrlap{\,.}
            %p
              Therefore this space is homeomorphic to the space from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#KaroubiModelForKO2"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi T
                      %mo ^
                    %mo ∘
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    f \;\mapsto\; \widehat{T} \circ f
                    \\,,
            %p
              and hence the claim follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#KaroubiModelForKO2"}
          %h3#StatementForKO1andKO7
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %msup
                    %mi{:mathvariant => "normal"} O
                    %mrow
                      %mo ±
                      %mn 1
                %annotation{:encoding => "application/x-tex"} K \mathrm{O}^{\pm 1}
          %p
          .num_prop
            %h6 Proposition
            %p
              The space of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
            #eq:SpaceOfSelfAdjointFredholmOperators.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mi sa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi.mathscript ℋ
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                    %mi f
                    %mo ∈
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi.mathscript ℋ
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
