              has three
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mi sa
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Fred
                      %mo +
                      %mi sa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi.mathscript ℋ
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ⊔
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Fred
                      %mo −
                      %mi sa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi.mathscript ℋ
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ⊔
