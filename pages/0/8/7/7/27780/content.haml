                          %mi.mathscript ℋ
                          %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Fred_+^{sa}(\mathscr{H}_{\mathbb{R}})
                  \: purely
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %li
                %p
