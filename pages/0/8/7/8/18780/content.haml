                    %annotation{:encoding => "application/x-tex"} \;
                %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+in+terms+of+dagger-compact+categories"} in terms of dagger-compact categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
          %h2#references References
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinDimVect
                %annotation{:encoding => "application/x-tex"} FinDimVect
            as
