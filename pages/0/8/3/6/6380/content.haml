                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/formal+Picard+group"} formal Picard group
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
