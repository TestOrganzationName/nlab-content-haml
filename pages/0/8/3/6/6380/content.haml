          %h3#OfCalabiYauVarieties Of Calabi-Yau varieties
          #AMfgOfStrictCalabiYau.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a strict
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+variety"} Calabi-Yau variety
              in
              %a.existingWikiWord{:href => "/nlab/show/positive+characteristic"} positive characteristic
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (strict meaning that the
              %a.existingWikiWord{:href => "/nlab/show/Hodge+numbers"} Hodge numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mrow
                        %mn 0
                        %mo ,
                        %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} h^{0,r} = 0
              vanish for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi r
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \lt r \lt n
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              that the
              %a.existingWikiWord{:href => "/nlab/show/holonomy+group"} holonomy group
              exhausts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(n)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+Calabi-Yau+manifolds"} supersymmetry and Calabi-Yau manifolds
            %p
              By prop.
              %a.maruku-ref{:href => "#SufficientConditionsForRepresentability"}
              this means that the Artin-Mazur formal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Φ
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Phi^n_X
              exists. Since moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mrow
                        %mn 0
                        %mo ,
                        %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} h^{0,n} = 1
              it follows by remark
              %a.maruku-ref{:href => "#Dimension"}
              that it is of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              1
          %p
            For discussion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Φ
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Phi_X^n
            for
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+varieties"} Calabi-Yau varieties
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and in
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            see (
            %a{:href => "#GeerKatsura03"}> Geer-Katsura 03
            ).
