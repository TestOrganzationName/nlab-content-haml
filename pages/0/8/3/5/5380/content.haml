          #nSphereAsCoveringSpaceOverRealProjectiveSpace.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                projecting to real projective space is
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
                projection)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p \;\colon\; S^n \to \mathbb{R}P^n
              from prop.
              %a.maruku-ref{:href => "#QuotientOfnSphereTopologicalProjectiveSpace"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              projection.
          .proof
            %h6#proof_4 Proof
            %p
              We need to produce an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset \mathbb{R}P^n\}_{i \in I}
              such that the restrictions of the projection to this cover are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              over the base to a
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mi n
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_i \times Disc(\mathbb{Z}_2)
                    \&amp;&amp; \overset{\simeq}{\longrightarrow} &amp;&amp;
                    S^n|_{U_i}
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; U_i
                    }
                    \\,.
            %p
              Consider the standard open cover from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, n+1\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              consists of those lines through the origin in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              which do not lie in the subspace defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x_i = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^n \subset \mathbb{R}^{n+1}
              is an
              %a.existingWikiWord{:href => "/nlab/show/equator"} equator
              of the
              = succeed "-sphere," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of this equator is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of the two open
              %a.existingWikiWord{:href => "/nlab/show/hemispheres"} hemispheres
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi D
                        %mi i
                        %mo ±
                      %mo ⊂
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_i^\pm \subset S^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mi n
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi D
                              %mi i
                              %mo +
                            %mo ⊔
                            %msubsup
                              %mi D
                              %mi i
                              %mo −
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^n\vert_{U_i} &amp; \simeq D_i^+ \sqcup D_i^-
                    }
                    \\,.
            %p
              Moreover, each line in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              which corresponds to an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              intersects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi D
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} D^+_i
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi D
                      %mi i
                      %mo −
                  %annotation{:encoding => "application/x-tex"} D^-_i
              exactly once. In particular therefore the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              restricts over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              to the interchange of these two hemispheres, and hence prop.
              %a.maruku-ref{:href => "#QuotientOfnSphereTopologicalProjectiveSpace"}
              gives the required homeomorphism as above.
          #ProjectiveSpaceOpenCoverIsAtlas.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (standard open cover is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %p
              The charts of the standard open cover of def.
              %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              are
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homeomorphic
              to
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
          .proof
            %h6#proof_5 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
