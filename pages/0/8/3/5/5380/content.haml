                      (def.
                      = succeed ")" do
                        %a.maruku-ref{:href => "#TopologicalProjectiveSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi S
                          %mn 1
                        %mo ≃
                        %mi ℂ
                        %msup
                          %mi P
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^{2n+1}/S^1 \simeq \mathbb{C}P^{n}
                %p between
                %ol
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2n+2)-sphere
                      %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi ℝ
                                %mrow
                                  %mn 2
                                  %mi n
                                  %mo +
                                  %mn 2
                              %mo ≃
                              %msup
                                %mi ℂ
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                            %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n+2} \simeq \mathbb{C}^{n+1}
                      %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                      which identifies two points
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi p
                              %mo{:stretchy => "false"} →
                            %mo ∈
                            %msup
                              %mi ℂ
