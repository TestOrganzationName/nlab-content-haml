                    k P^n \;\coloneqq\; \left(k^{n+1} \setminus \{0\}\right) / \sim
                    \\,.
          #CanonicalInclusionOfProjectiveSpaces.num_lemma
            %h6#lemma Lemma
            %p
              %strong (canonical inclusion of projective spaces)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
