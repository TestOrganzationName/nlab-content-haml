          .proof
            %h6#proof_3 Proof
            %p
              We discuss the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} k = \mathbb{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
              works verbatim the same, with the evident substitutions.
            %p
              Given
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+coordinates"} homogeneous coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 0
                    %mo ,
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi z
                      %mi n
                    %mo ,
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} (z_0,  z_1,  \cdots,  z_n,  z_{n+1},  z_{n+2}) \in \mathbb{C}^{n+2}
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi arg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \coloneqq -arg(z_{n+2})
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/phase"} phase
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} z_{n+2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              these coordinates represent the same element as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi z
