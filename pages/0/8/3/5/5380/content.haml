                            %mo ,
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^n &amp;\overset{\hat \phi_i}{\longrightarrow}&amp; \mathbb{R}^{n+1} \setminus \{x_i = 0\}
                    \\\
                    (x_1, \cdots, x_{i-1}, x_{i+1}, \cdots, x_{n+1})
                    \&amp;\mapsto&amp;
                    (x_1, \cdots, 1, \cdots ,x_n+1)
                    }
            %p
              with the quotient projection. Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ϕ
                        %mo{:stretchy => "false"} ^
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \hat \phi_i
              is a
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              function and since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous"} polynomials are continuous
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              is continuous, and since composites of continuous functions are continuous, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i
              is continuous.
            %p
              It remains to see that also the
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_i^{-1}
              is continuous. Since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi x
                              %mi i
                            %mo =
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi U
                              %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ↦
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mfrac
                              %mrow
                                %msub
                                  %mi x
                                  %mn 1
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mfrac
                              %mrow
                                %msub
                                  %mi x
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mn 1
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                            %mo ,
                            %mfrac
                              %mrow
                                %msub
                                  %mi x
                                  %mrow
                                    %mi i
                                    %mo +
                                    %mn 1
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mfrac
                              %mrow
                                %msub
                                  %mi x
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{n+1} \setminus \{x_i = 0\}
                    \&amp;\overset{}{\longrightarrow}&amp;
                    U_i
                    \&amp;\overset{\phi_i^{-1}}{\longrightarrow}&amp;
                    \\mathbb{R}^n
                    \\\
                    (x_1, \cdots, x_{n+1})
                    \&amp;&amp; \mapsto &amp;&amp;
                    ( \frac{x_1}{x_i}, \cdots, \frac{x_{i-1}}{x_i}, \frac{x_{i+1}}{x_i}, \cdots , \frac{x_{n+1}}{x_i})
                    }
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+functions+are+continuous"} rational functions are continuous
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i
              takes open subsets to open subsets, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_i^{-1}
              is continuous.
          #SmoothManifoldRealComplexProjectiveSpace.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (real/complex projective space is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} k \in \{\mathbb{R}, \mathbb{C}\}
              the topological projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalProjectiveSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            %p
              Equipped with the standard open cover of def.
              %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi kP
                      %mi n
                  %annotation{:encoding => "application/x-tex"} kP^n
              admits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CellComplexStructureOnTopologicalProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              since
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes+are+paracompact+Hausdorff+spaces"} CW-complexes are paracompact Hausdorff spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            %p
              It remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              of this atlas are
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              and in fact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              they are even
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
