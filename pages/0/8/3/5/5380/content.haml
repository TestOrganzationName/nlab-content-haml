                            %mi x
                            %mn 1
                        %mrow
                          %msub
                            %mi x
                            %mi i
                      %mo :
                      %mi ⋯
                      %mo :
                      %mn 1
                      %mo :
                      %mi ⋯
                      %mfrac
                        %mrow
