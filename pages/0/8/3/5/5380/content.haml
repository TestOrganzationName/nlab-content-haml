                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    [x_1 : \cdots : x_i : \cdots : x_{n+1}]
                    \=
                    \\left[
                    \\frac{x_1}{x_i} : \cdots : 1 : \cdots \frac{x_{n+1}}{x_i}
                    \\right]
            %p
              and the representatives of the form on the right are
              = succeed "." do
