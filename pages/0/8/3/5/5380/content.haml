              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %mi ⋯
                    %mo :
                    %msub
                      %mi x
                      %mi i
                    %mo :
                    %mi ⋯
                    %mo :
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mrow
                      %mo [
                      %mfrac
                        %mrow
