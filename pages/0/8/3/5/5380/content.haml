            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
