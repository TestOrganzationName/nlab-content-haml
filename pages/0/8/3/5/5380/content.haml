                            %mo{:stretchy => "false"} [
                            %msub
                              %mi z
                              %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo :
                            %mi r
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    q_{D^{2n+2}} \colon &amp; D^{2n+2} &amp;\overset{\phantom{AAA}}{\hookrightarrow}&amp; \mathbb{C}^{n+2} \setminus \{0\} &amp;\overset{q_{\mathbb{C}^{n+2}}}{\longrightarrow}&amp;  \mathbb{C}P^{n+1}
                    \\\
                    \&amp; (Re(z_1), Im(z_1),  \cdots, Re(z_{n+1}), Im(z_{n+1}), r) &amp;\mapsto&amp; (z_1, \cdots, z_{n+1}, r)  &amp;\mapsto&amp; [ z_1 : \cdots : z_{n+1} : r ]
                    }
            %p
              and here the first map is the
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding
              of the disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{2n+2}
              as a
              %a.existingWikiWord{:href => "/nlab/show/hemisphere"} hemisphere
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 2
                      %mo ≃
                      %msup
                        %mi ℂ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n+1} \hookrightarrow \mathbb{R}^{2n+2} \simeq \mathbb{C}^{2n+2}
            %p
              The only remaining part of the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}-\{0\}
              which fixes the conditions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo ′
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\vert z'\vert} = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %msub
                      %mo ′
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} z'_{n+2}
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ⊂
                    %mi ℂ
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^1 \subset \mathbb{C} \setminus \{0\}
              acting on the elements with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %msub
                      %mo ′
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = \{z'_{n+2}\} = 0
              by phase shifts on the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} z_0, \cdots, z_{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^{2(n+1)}
              identifies its boundary
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{2n+1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n}
              = succeed "." do
                %a.maruku-ref{:href => "#QuotientOfnSphereTopologicalProjectiveSpace"}
            %p
              This shows that the above square is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram of underlying sets.
            %p
              By the nature of
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (
              %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"}> this prop.
              ) it remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              induced by the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} D^{2n+2} \to \mathbb{C}P^{n+1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo →
                      %mi ℂ
                      %msup
                        %mi P
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n \to \mathbb{C}P^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is open precisely if its pre-images under these two functions are open.
            %p
              We saw above that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}
              is continuous. Moreover, also the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} i_n \colon \mathbb{C}P^n \to \mathbb{C}P^{n+1}
              is continuous (by
              = succeed ")." do
                %a{:href => "projective+space#CanonicalInclusionOfProjectiveSpaces"} this lemma
            %p
              This shows that if a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is open, then its pre-images under these functions are open. It remains to see that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^{n+1}
              is a subset with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{S^{2n+2}}^{-1}(S) \subset D^{2n+2}
              open and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i_n^{-1}(S) \subset \mathbb{C}P^n
              open, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^{n+1}
              is open.
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+2}}^{-1}(S)
              contains with every point also its
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              under the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{C} \setminus \{0\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{2n+2}
              is a unions of open balls. By the above factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}
              this means that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}^{-1}(S)
              is open, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+2}}^{-1}(S)
              is a union of open cyclinders, hence is open. By the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^n
              is open.
          #TopologicalProjectiveSpaceStandardOpenCover.num_defn
            %h6#definition_3 Definition
            %p
              %strong (standard open cover of topological projective space)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %em standard open cover
              of the projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi k
                        %msup
                          %mi P
                          %mi n
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i \subset k P^n
                    \\right\}_{i \in \{1, \cdots, n+1\}}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo :
                      %mi ⋯
                      %mo :
                      %msub
                        %mi x
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi k
                      %msup
                        %mi P
                        %mi n
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi x
                        %mi i
                      %mo ≠
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_i
                    \\coloneqq
                    \\left\{
                    [x_1 : \cdots : x_{n+1}] \in k P^n
                    \\;\vert\;
                    x_i \neq 0
                    \\right\}
                    \\,.
            %p To see that this is an open cover:
            %ol
              %li
                %p
                  This is a cover because with the orgin removed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mi n
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} k^n \setminus \{0\}
                  at every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mn 1
                        %mo :
                        %mi ⋯
                        %mo :
                        %msub
                          %mi x
                          %mrow
                            %mi n
