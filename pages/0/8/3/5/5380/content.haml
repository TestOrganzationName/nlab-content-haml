                        %mo ′
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} z'_{n+2} \in [0,1]
              %a.existingWikiWord{:href => "/nlab/show/n-disk"} 2n+2-disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{2n+2}
              with
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r = 0
            %p
              The resulting function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q \colon D^{2n+2} \to \mathbb{C}P^{n+1}
              is continuous: It may be factored as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi q
                              %mrow
                                %msup
                                  %mi D
                                  %mrow
                                    %mn 2
                                    %mi n
                                    %mo +
                                    %mn 2
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msup
                              %mi D
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 2
                          %mtd
                            %mover
                              %mo ↪
                              %mphantom
                                %mi AAA
                          %mtd
                            %msup
                              %mi ℂ
                              %mrow
                                %mi n
                                %mo +
                                %mn 2
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi q
                                  %mrow
                                    %msup
                                      %mi ℂ
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mn 2
                          %mtd
                            %mi ℂ
                            %msup
                              %mi P
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi r
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ,
                            %mi r
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
