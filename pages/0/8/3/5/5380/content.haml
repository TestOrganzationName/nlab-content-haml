          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be an abelian
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            (one containing the theory of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            for its canonical
            %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            for the corresponding
            = succeed "-object." do
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
          %p
            The
            %strong projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℙ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{P}_n
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℙ
                    %mi n
                  %mo ≔
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi 𝔸
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ∖
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{P}_n
                  \\coloneqq
                  \\big(
                  \\mathbb{A}^{n+1} \setminus \{0\}
                  \\big)/\mathbb{G}_m
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of the origin inside the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of the line with itself by the canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
          %p
            Any point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi 𝔸
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (x_0,x_1,\ldots,x_n)\in \mathbb{A}^{n+1} - \{0\}
            gives
            %em homogeneous coordinates
            for its image under the quotient map. When considered in this fashion, one often writes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 0
                    %mo :
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %mi …
                    %mo :
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x_0:x_1:\ldots:x_n]
            %a{:href => "#Mobius27"} Möbius 27
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,0)
            a
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            with (pointed)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ∖
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{P}(X)
                  \\;\coloneqq\;
                  \\big(
                  X \setminus\{0\}
                  \\big)
                  \/
                  \\mathbb{G}_m
          %p is the corresponding projective space.
          %p
            If instead of forming the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            one forms the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %a.existingWikiWord{:href => "/nlab/show/projective+stack"} projective stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℙ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ∖
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⫽
                  %msub
                    %mi 𝔾
                    %mi m
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbb{P}(X)
                  \\coloneqq
                  \\big(
                  X\setminus\{0\}
                  \\big) \sslash \mathbb{G}_m
                  \\,.
          %h2#examples Examples
          %h3#ForCommutativeRings For commutative rings and algebras
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            the theory of commutative
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            or more generally commutative
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔸
                    %mi k
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}_k^1
            is the standard
            %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℙ
                    %mi k
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^n_k
            is (…) A closed sub
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℙ
                    %mi k
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^n_k
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+scheme"} projective scheme
          .un_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a commutative
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} gradings
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi m
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/action"}> action
                  s on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spec
                          %mi R
                        %annotation{:encoding => "application/x-tex"} Spec R
          %p
            The proof is spelled out at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
          %h3#as_the_dimension_ranges As the dimension ranges
          %p
            By the
            %a{:href => "#ForCommutativeRings"} above
            perspective of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔽
                %annotation{:encoding => "application/x-tex"} \mathbb{F}
            a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            one also says that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔽
                      %msup
                        %mi P
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}P^1
                is its
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/projective+line"} projective line
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔽
                      %msup
                        %mi P
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}P^2
                is its
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/projective+plane"} projective plane
          %p
            Finally, there is the
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of all
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi mathbb
                    %mi F
                    %msup
                      %mi P
                      %mi n
                    %mo ↪
                    %mi 𝔽
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} mathbb{F}P^n  \hookrightarrow \mathbb{F}P^{n+1}
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝔽
                    %msup
                      %mi P
                      %mn ∞
                    %mo ≔
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi n
                          %mo →
                          %mn ∞
                    %mi 𝔽
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}P^\infty \coloneqq \underset{\underset{n \to \infty}{\longrightarrow}}{\lim} \mathbb{F}P^n
              , called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinite+projective+space"} infinite projective space
          %h3#RealComplexProjectiveOctonionicProjectiveSpace Real, complex, quaternionic, octonionic projective space
          %p
            In particular, as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            ranges over the four finite-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+normed+division+algebras"} real normed division algebras
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                    %annotation{:encoding => "application/x-tex"} k =
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}P^n
              %p
                including the
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %msup
                        %mi P
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}P^1 \,\simeq\, S^1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                    %annotation{:encoding => "application/x-tex"} k =
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              %p
                including the
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1 \,\simeq\, S^2
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                    %annotation{:encoding => "application/x-tex"} k =
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+space"} quaternionic projective space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}P^n
              %p
                including the
                %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                      %msup
                        %mi P
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}P^1 \,\simeq\, S^4
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                    %annotation{:encoding => "application/x-tex"} k =
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                %a.existingWikiWord{:href => "/nlab/show/octonionic+projective+space"} octonionic projective space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}P^n
              %p
                (for
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≤
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \leq 2
              %p
                including the
                %a.existingWikiWord{:href => "/nlab/show/8-sphere"} 8-sphere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                      %msup
                        %mi P
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi S
                        %mn 8
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}P^1 \,\simeq\, S^8
          %p
            %br/
          #TopologicalProjectiveSpace.num_defn
            %h6#definition_2 Definition
            %p
              %strong (topological projective space)
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{n+1}
              equipped with its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{n+1} \setminus \{0\} \subset k^{n+1}
              be the
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              which is the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the origin, and consider on its underlying set the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              which identifies two points if they differ by
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
              with some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} c \in k
              (necessarily non-zero):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mn 1
                    %mo ∼
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %mi c
                          %mo ∈
                          %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mn 2
                      %mo =
                      %mi c
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\vec x_1 \sim \vec x_2)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{c \in k}{\exists}
                    ( \vec x_2 = c \vec x_1 )
                    \\right)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\vec x]
              is traditionally denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %msub
                      %mi x
                      %mn 2
                    %mo :
                    %mi ⋯
                    %mo :
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
