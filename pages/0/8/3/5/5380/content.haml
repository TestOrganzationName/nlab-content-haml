            %p
              where the two vertical functions are the defining quotient co-projections, which are continuous functions by nature of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous"} polynomials are continuous
            %p
              This implies that the bottom function is continuous by the nature (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
          #QuotientOfnSphereTopologicalProjectiveSpace.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (projective space as quotient space of an
                = succeed "-sphere)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{C}
              there are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi ℝ
                        %msup
                          %mi P
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^{n}/(\mathbb{Z}/2) \simeq \mathbb{R}P^n
                %p between
                %ol
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                      %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi ℝ
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                            %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
                      %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                      which identifies two points
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi p
