                    }
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
          .proof
            %h6#proof Proof
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of functions of underlying sets of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
