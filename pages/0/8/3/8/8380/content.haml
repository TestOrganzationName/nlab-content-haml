                %annotation{:encoding => "application/x-tex"} Type
            of
            %a.existingWikiWord{:href => "/nlab/show/data+types"} data types
            with programs between them:
          #eq:TheKleisliCategory.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
