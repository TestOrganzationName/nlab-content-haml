                      %mo ⊔
                      %mi String
                    %annotation{:encoding => "application/x-tex"} Excep(D) \,\coloneqq\, D \sqcup String
          %p
            Given such an
            = succeed "-effectful" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi prog
                    %mn 12
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi D
                    %mn 1
                  %mo →
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} prog_{12} \;\colon\; D_1 \to \mathcal{E}(D_2)
            and given a subsequent program
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi prog
                    %mn 23
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi D
                    %mn 2
                  %mo →
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} prog_{23} \,\colon\, D_2 \to \mathcal{E}(D_3)
            accepting nominal input data of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 2
                %annotation{:encoding => "application/x-tex"} D_2
            and itself possibly involved in further effects of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}(-)
            %em naïve
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of the two programs makes no sense (unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                %annotation{:encoding => "application/x-tex"} \mathcal{E}(D) = D
            is actually the trivial sort of effect), but their evident
            %em intended
            composition is, clearly, obtained by:
          %ol
            %li
              %p
                first adjusting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi prog
                        %mn 23
                    %annotation{:encoding => "application/x-tex"} prog_{23}
                via a given prescription
              #eq:BindingLawInIntroduction.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mi prog
                      %mspace{:width => "thickmathspace"}
                      %mo ↦
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi bind
                        %mi ℰ
                      %mi prog
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!\!
                      prog \;\mapsto\; bind^{\mathcal{E}} prog
                      \\,,
              %p
                such that
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi bind
                          %mi ℰ
                        %msub
                          %mi prog
                          %mn 23
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi ℰ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ℰ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} bind^{\mathcal{E}} prog_{23} \,\colon\, \mathcal{E}(D_2) \to \mathcal{E}(D_3)
              %ol
                %li
                  %p
                    does accept data of type
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℰ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{E}(D_2)
                    and
                %li
                  %p
                    “acts as
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi prog
                            %mn 23
                        %annotation{:encoding => "application/x-tex"} prog_{23}
                    while
                    %em carrying
                    any previous
                    = succeed "-effects" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ℰ
                          %annotation{:encoding => "application/x-tex"} \mathcal{E}
                    = succeed ");" do
                      %a.maruku-eqref{:href => "#eq:FreeEffectHandlingIsBinding"} (9)
            %li
              %p
                then forming the naive
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi bind
                        %mi ℰ
                      %msub
                        %mi prog
                        %mn 23
                      %mspace{:width => "thickmathspace"}
                      %mo ∘
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi prog
                        %mn 12
                    %annotation{:encoding => "application/x-tex"} bind^{\mathcal{E}} prog_{23} \;\circ\;  prog_{12}
          %p#BindAndReturnGraphics as follows:
          %div{:style => "margin: -20px 0px 20px 10px"}
            %img{:src => "/nlab/files/KleisliCompositionOfEffectfulPrograms-230927.jpg", :width => "840px"}/
          %blockquote
            %p
              (Beware that we are denoting by “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi bind
                      %mi ℰ
                    %mi prog
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} bind^{\mathcal{E}} prog (-)
              ” what in
              %a.existingWikiWord{:href => "/nlab/show/programming+languages"} programming languages
              like
              %a.existingWikiWord{:href => "/nlab/show/Haskell"} Haskell
              %a{:href => "https://wiki.haskell.org/Monad#The_Monad_class"} is denoted by
              “
              %code> (-) &gt;&gt;= prog
              ” aka “fish notation”, eg.
              = succeed "," do
                %a{:href => "#Milewski19"} Milewski 2019 p. 321
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi prog
                        %mo *
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"} prog^\ast\,
              = succeed ";" do
                %a{:href => "#Moggi91"} Moggi (1991)
              = succeed "," do
                %a{:href => "#Uustalu21Lecture1"} Uustalu (2021), lecture 1
              = succeed ".)" do
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs1.pdf#page=12"} p. 12
          %p
            Depending on the intended behaviour of these programs, it remains to specify how exactly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi bind
                    %mi ℰ
                  %msub
                    %mi prog
                    %mn 23
                %annotation{:encoding => "application/x-tex"} bind^{\mathcal{E}} prog_{23}
            “carries
            = succeed "-effects" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}(-)
            %a.maruku-eqref{:href => "#eq:BindingLawInIntroduction"} (2)
            does concretely.
          %blockquote
            %p
              For instance, in the above example of a logging-effect, where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Write
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi D
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi D
                        %mn 2
                      %mo ×
                      %mi String
                    %annotation{:encoding => "application/x-tex"} Write(D_2) \,\coloneqq\, D_2 \times String
              %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                    %mo ×
                    %mi String
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi concat
                        %mspace{:width => "thickmathspace"}
                    %mi String
                  %annotation{:encoding => "application/x-tex"} String \times String \xrightarrow{\; concat \;} String
              and set:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi bind
                      %mi Write
                    %msub
                      %mi prog
                      %mn 23
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi D
                      %mn 2
                    %mo ×
                    %mi String
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi prog
                          %mn 23
                        %mo ×
                        %msub
                          %mi Id
                          %mi String
                    %msub
                      %mi D
                      %mn 3
                    %mo ×
                    %mi String
                    %mo ×
                    %mi String
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Id
                          %mrow
                            %msub
                              %mi D
                              %mn 3
                        %mo ×
                        %mi concat
                    %msub
                      %mi D
                      %mn 3
                    %mo ×
                    %mi String
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} bind^{Write} prog_{23}\;\coloneqq\; D_2 \times String \xrightarrow{ prog_{23} \times Id_{String} } D_3 \times String \times String \xrightarrow{ Id_{D_3} \times concat } D_3 \times String \,.
            %p
              In the other example above, where the effect is the possible throwing of an
              %a.existingWikiWord{:href => "/nlab/show/exception"} exception
              message, the evident way to carry this kind of effect along is to use the
              %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi String
                      %mo ⊔
                      %mi String
                      %mo →
                      %mi String
                    %annotation{:encoding => "application/x-tex"} \nabla \,\colon\, String \sqcup String \to String
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi bind
                      %mi Excep
                    %msub
                      %mi prog
                      %mn 23
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi D
                      %mn 2
                    %mo ⊔
                    %mi String
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi prog
                          %mn 23
                        %mo ⊔
                        %msub
                          %mi Id
                          %mi String
                    %msub
                      %mi D
                      %mn 3
                    %mo ⊔
                    %mi String
                    %mo ⊔
                    %mi String
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi D
                              %mn 3
                        %mo ⊔
                        %mo ∇
                    %msub
                      %mi D
                      %mn 3
                    %mo ⊔
                    %mi String
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} bind^{Excep} prog_{23} \;\coloneqq\; D_2 \sqcup String \xrightarrow{ prog_{23} \sqcup Id_{String} } D_3 \sqcup String \sqcup String \xrightarrow{ id_{D_3} \sqcup \nabla } D_3 \sqcup String \,.
          %p
            Whatever design choice one makes for how to “carry along effects”, it must be consistent in that applying the method to a
            %a.existingWikiWord{:href => "/nlab/show/triple"} triple
            of
            = succeed "-effectful" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative"} associative
            %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            – here called the the first “monad law”:
          #eq:AssociativityConditionInIntroduction.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi bind
                    %mi ℰ
                  %msub
                    %mi prog
                    %mn 34
                  %mspace{:width => "thickmathspace"}
                  %mo ∘
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi bind
                    %mi ℰ
                  %msub
                    %mi prog
                    %mn 23
                  %mspace{:width => "thickmathspace"}
                  %mo ∘
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi prog
                    %mn 12
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi bind
                    %mi ℰ
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi bind
                    %mi ℰ
                  %msub
                    %mi prog
                    %mn 34
                  %mspace{:width => "thickmathspace"}
                  %mo ∘
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi prog
                    %mn 23
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∘
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi prog
                    %mn 12
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  bind^{\mathcal{E}} prog_{34}
                  \\;\circ\;
                  \\Big(
                  bind^{\mathcal{E}}
                  prog_{23}
                  \\;\circ\;
                  prog_{12}
                  \\Big)
                  \\;\;\;=\;\;\;
                  bind^{\mathcal{E}}
                  \\Big(
                  bind^{\mathcal{E}}
                  prog_{34}
                  \\;\circ\;
                  prog_{23}
                  \\Big)
                  \\;\circ\;
                  prog_{12}
                  \\,.
          %p
            Finally, for such a notion of effectful programs to be usefully connected to “pure” programs without effects, it ought to be the case that for any program
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi prog
                    %mn 01
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi D
                    %mn 0
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %msub
                    %mi D
                    %mn 1
                %annotation{:encoding => "application/x-tex"} prog_{01} \,\colon\, D_0 \xrightarrow{\;} D_1
            that happens to have no
            = succeed "-effects," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            = succeed "-effectful" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          #eq:ReturnMapInIntroduction.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ret
                    %mi D
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi D
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ret_{D} \;\colon\; D \xrightarrow{\;} \mathcal{E}(D)
          %p
            which does nothing but “return” data of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-data" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}(D)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ret
                      %mrow
                        %msub
                          %mi D
                          %mn 1
                      %mi 𝒟
                    %msub
                      %mi prog
                      %mn 01
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi D
                      %mn 0
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ret^{\mathcal{D}}_{D_1} prog_{01} \;\colon\; D_0 \xrightarrow{\;} \mathcal{E}(D_1)
          %blockquote
            %p
              For instance, in the above example of log-message effects this would be the operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi D
                    %mo ×
                    %mi String
                  %annotation{:encoding => "application/x-tex"} D \to D \times String
              which assigns the
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              %a.existingWikiWord{:href => "/nlab/show/string+%28computer+science%29"} string
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ret
                        %mi Write
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mo ∅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ret^{Write} \;\colon\; d \mapsto (d, \varnothing)
            %p
              In the other example above, of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exception+handling"} exception handling
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
