                encode
                %em computational contexts
                (
                %em> co-effects
                ),
            %li
              %p
                their
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                operation is the
                %em duplication
                (
                %em> co-join
                ) of contexts which serves to
                %em extend
                (
                %em> co-bind
                ) contexts over consecutive programs,
            %li
              %p
