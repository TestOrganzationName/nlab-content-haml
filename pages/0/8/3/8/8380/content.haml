            %li#Riehl17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %em A categorical view of computational effects
                %em
                  %a{:href => "https://www.composeconference.org/2017/"}
                    C
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo ∘
                        %annotation{:encoding => "application/x-tex"} \circ
                    mp
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo ∘
                        %annotation{:encoding => "application/x-tex"} \circ
                    se
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "negativethinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                        %annotation{:encoding => "application/x-tex"} \colon\!\colon
                    Conference
                (2017) &amp;lbrack;
                %a{:href => "http://www.math.jhu.edu/~eriehl/compose.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Riehl-ComputationalEffects.pdf", :title => "pdf"} pdf
            %li
              %p
                Rob Norris,
                = succeed "," do
                  %em Functional Programming with Effects
                %em Scala Days 2018
                \&amp;lbrack;video:
                = succeed "&rbrack;" do
                  %a{:href => "https://youtu.be/30q6BkBv5MY"} YT
            %li#Uustalu21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"}> Tarmo Uustalu
                , lecture notes for
                %a{:href => "https://staffwww.dcs.shef.ac.uk/people/G.Struth/mgs21.html"} MGS 2021
                (2021):
              %p#Uustalu21Lecture1
                %em Monads and Interaction Lecture 1
                \&amp;lbrack;
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs1.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Uustalu-Monads1.pdf", :title => "pdf"} pdf
              %p#Uustalu21Lecture2
                %em Monads and Interaction Lecture 2
                \&amp;lbrack;
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs2.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Uustalu-Monads2.pdf", :title => "pdf"} pdf
              %p#Uustalu21Lecture3
                %em Monads and Interaction Lecture 3
                \&amp;lbrack;
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs3.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Uustalu-Monads3.pdf", :title => "pdf"} pdf
              %p#Uustalu21Lecture4
                %em Monads and Interaction Lecture 4
                \&amp;lbrack;
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs4.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Uustalu-Monads4.pdf", :title => "pdf"} pdf
            %li
              %p
                Christina Kohl, Christina Schwaiger,
                %em Monads in Computer Science
                (2021) &amp;lbrack;
                %a{:href => "https://www.uibk.ac.at/mathematik/algebra/staff/fritz-tobias/ct2021_course_projects/category_theory.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/KohlSchwaiger-Monads.pdf", :title => "pdf"} pdf
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Monad_(functional_programming)"} Monad (functional programming)
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Side_effect_(computer_science)"} Side_effect_(computer_science)
          %p
            The specification of
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            in
            %a.existingWikiWord{:href => "/nlab/show/Haskell"} Haskell
            is at:
          %ul
            %li
              %p
                %a{:href => "http://www.haskell.org/haskellwiki/Haskell"}> The Haskell programming language
                ,
              %ul
                %li
                  %p
                    %em
                      %a{:href => "https://wiki.haskell.org/Monad"} Monad
                %li
                  %p
                    %em
                      %a{:href => "http://www.haskell.org/haskellwiki/Monad_laws"} Monad laws
          %p
            and an exposition of
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            and monads in terms of Haskell is in
          %ul
            %li
              WikiBooks,
              %em
                %a{:href => "http://en.wikibooks.org/wiki/Haskell/Category_theory"} Haskell/Category
          %p
            Further on the issue of the CS-style monads really being
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/strong+monads"} strong monads
          %ul
            %li#GLLN08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+Goubault-Larrecq"}> Jean Goubault-Larrecq
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Slawomir+Lasota"} Slawomir Lasota
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Nowak"} David Nowak
                = succeed "," do
                  %em Logical Relations for Monadic Types
                %strong 18
                6 (2008) 1169-1217 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/cs/0511006"}> arXiv:cs/0511006
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/S0960129508007172"} doi:10.1017/S0960129508007172
            %li#McDermottUustalu22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"}> Dylan McDermott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"} Tarmo Uustalu
                = succeed "," do
                  %em What Makes a Strong Monad?
                %strong 360
                (2022) 113-133 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2207.00851"}> arXiv:2207.00851
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.4204/EPTCS.360.6"} doi:10.4204/EPTCS.360.6
          %p
            A comparison of monads with
            %a.existingWikiWord{:href => "/nlab/show/applicative+functors"} applicative functors
            (also known as idioms) and with
            %a.existingWikiWord{:href => "/nlab/show/arrows+%28in+computer+science%29"} arrows (in computer science)
            is in
          %ul
            %li
              Exequiel Rivas,
              = succeed "," do
                %em Relating Idioms, Arrows and Monads from Monoidal Adjunctions
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1807.04084"} arXiv:1807.04084
          %h3#in_quantum_computation In quantum computation
          %p
            Discussion of aspects of
            %a.existingWikiWord{:href => "/nlab/show/quantum+computing"} quantum computing
            in terms of monads:
          %ul
            %li
              %p
                J. K. Vizzotto,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"} Thorsten Altenkirch
                = succeed "," do
                  %em Structuring quantum effects: superoperators as arrows
                %strong 16
                3 (2006) 453-468 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/quant-ph/0501151"}> arXiv:quant-ph/0501151
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/S0960129506005287"} doi:10.1017/S0960129506005287
              %blockquote
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/superoperators"} superoperators
                  as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/arrows+in+computer+science"} arrows in computer science
          %p
            The
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+IO+monad"} quantum IO monad
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"}> Thorsten Altenkirch
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Green"} Alexander Green
              = succeed "," do
                %em The quantum IO monad
              %em Semantic Techniques in Quantum Computation
              (2010) 173-205 &amp;lbrack;
              %a{:href => "http://www.cs.nott.ac.uk/~txa/publ/qio-chapter.pdf"}> pdf
              ,
              = succeed "," do
                %a{:href => "http://www.cs.nott.ac.uk/~txa/talks/qnet06.pdf"} talk slides
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/CBO9781139193313.006"} doi:10.1017/CBO9781139193313.006
          %p Exposition:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Green"}> Alexander Green
              ,
              = succeed "," do
                %em The Quantum IO Monad
              = succeed "," do
                %a{:href => "http://drinkupthyzider.co.uk/asg/pdfs/bctcs07.pdf"} pdf
              %a.existingWikiWord{:href => "/nlab/files/Green-QIOMonad.pdf", :title => "pdf"} pdf
              \&amp;rbrack;
          %p
            Implementation in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Haskell"} Haskell
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Green"}> Alexander Green
              ,
              %em
                %a{:href => "https://hackage.haskell.org/package/QIO"} hackage.haskell.org/package/QIO
          %p Much of the text and the diagrams in the entry above follow
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/The+Quantum+Monadology"} The Quantum Monadology
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2310.15735"}> arXiv:2310.15735
              \&amp;rbrack;
