                    = succeed "\u201D" do
                      %em context
                    = succeed "," do
                      %a{:href => "#UustaluVene08"} Uustalu &amp; Vene (2008)
                    = succeed ")" do
                      %a{:href => "#POM13"} POM13
                  %p
                    (a
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    = succeed ")." do
                      %em cause
                %li
                  %p
                    A co-Kleisli co-module for a comonad
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
