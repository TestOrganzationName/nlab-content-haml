              %a{:href => "#McDermottUustalu22"} McDermott &amp; Uustalu (2022)
          %p
            On such an
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+monad"} enriched
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/strong+monad"} strong monad
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℰ
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mn 1
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi strength
                        %mi ℰ
                      %mspace{:width => "thickmathspace"}
                  %mi ℰ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi D
                    %mn 1
                  %mo ×
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mn 1
                  %mo ,
