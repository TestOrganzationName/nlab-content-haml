              %ul
                %li
                  %a{:href => "#idempotents_form_a_subsemigroup"} Idempotents form a subsemigroup
                %li
                  %a{:href => "#_is_an_antiinvolution"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    is an anti-involution
                %li
