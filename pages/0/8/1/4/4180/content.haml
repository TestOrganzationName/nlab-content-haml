              %a.existingWikiWord{:href => "/nlab/show/semigroups"} semigroups
              with a unary operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ⋅
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo =
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s \cdot i(s) \cdot s = s
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi s
                      %mo ⋅
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i(s) \cdot s \cdot i(s) = i(s)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/invertible+semigroup"} invertible semigroup
          %hr/
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
