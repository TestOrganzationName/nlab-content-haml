          #SimplicialSetsPointedAndFinite.num_defn
            %h6#definition_2 Definition
            %p Write
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sSet
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
                  for the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
                  simplicial sets;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi sSet
                          %mi fin
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo ≃
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi FinSet
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo ↪
                        %msup
                          %mi sSet
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} sSet_{fin}^{\ast/}\simeq s(FinSet)^{\ast/} \hookrightarrow sSet^{\ast/}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mover
                      %munder
                        %mo ⟶
                        %mi u
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    sSet^{\ast/}
                    \\stackrel{\overset{(-)_+}{\longleftarrow}}{\underset{u}{\longrightarrow}}
                    sSet
            %p
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} (-)_+
              freely adjoins a base point.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo{:lspace => "verythinmathspace"} :
