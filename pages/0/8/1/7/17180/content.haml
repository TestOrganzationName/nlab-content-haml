                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              of def.
              %a.maruku-ref{:href => "#CategoriesOfStandardSpheres"}
              and by left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \iota_\ast
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                    %annotation{:encoding => "application/x-tex"} \iota
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
