                      %mi seq
                  %annotation{:encoding => "application/x-tex"} (-)^{seq}
              of prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SequentialSpectraAsSimplicialFunctorsOnStandardSpheres"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              and in fact a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
              on sequential prespectra and Lydakis’ model structure for excisive functors, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LydakisModelStructure"}
          %h3#SmashProduct Symmetric monoidal smash product
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/excisive+functors"} excisive functors
            naturally carry a
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, def. 5.1
            ) making the model structure for 1-excisive functors a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+model+category"} symmetric monoidal model category
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, section 12
            ). Via the translation to
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            of prop.
            %a.maruku-ref{:href => "#LydakisModelStructure"}
            this is a model for the
            %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, theorem 12.5
            ); hence it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+on+spectra"} symmetric smash product on spectra
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            with respect to this smash product (hence a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %a.existingWikiWord{:href => "/nlab/show/functor+with+smash+products"} functor with smash products
            (“FSP”) as earlier considered in (
            %a{:href => "#B&#246;kstedt86"}> Bökstedt 86
            ).
          #DayConvolutionStructureOnExcisiveFunctors.num_defn
            %h6#definition_6 Definition
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mo ∧
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (sSet^{\ast/}, \wedge)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SimplicialSetsPointedAndFinite"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mo *
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [sSet^{\ast}_{fin}, sSet^{\ast/}]
              canonically becomes symmetric monoidal itself via the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution+product"} Day convolution product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∧
                        %mi Say
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\, [sSet^{\ast/}_{fin}, sSet^{\ast/}], \; \wedge_{Say} \right)
            %p
              for this
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          #LydakisTensorProductIsDayConvolution.num_prop
            %h6#proposition_5 Proposition
            %p
              The smash product on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [sSet^{\ast/}_{fin}, sSet^{\ast/}]
              considered (
              %a{:href => "#Lydakis98"}> Lydakis 98, def. 5.1
              ) coincides with the
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution+product"} Day convolution product
              of def.
              = succeed "." do
                %a.maruku-ref{:href => "#DayConvolutionStructureOnExcisiveFunctors"}
          .proof
            %h6#proof Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              product is characterized (see
              = succeed ")" do
                %a{:href => "Day+convolution#DayConvolutionViaNaturalIsosInvolvingExternalTensorAndTensor"} this proposition
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ×
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ∧
                      %mo{:stretchy => "false"} ˜
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo ∘
                    %mo ∧
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [sSet^{\ast/}_{fin}, sSet^{\ast/}](X \wedge Y, Z) \simeq [sSet^{\ast/}_{fin} \times sSet^{\ast/}_{fin}, sSet^{\ast/}](X \tilde{\wedge} Y, Z \circ \wedge)
            %p
              where the
              %em external smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∧
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde {\wedge}
              on the right is defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ∧
                        %mo{:stretchy => "false"} ˜
                      %mi Y
                      %mo ≔
                      %mo ∧
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \tilde{\wedge} Y  \coloneqq  \wedge \circ (X,Y)
              = succeed ")" do
                %a{:href => "#Lydakis98"} Lydakis 98, def. 5.1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ≔
                    %msub
                      %mo ∧
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ∧
                      %mo{:stretchy => "false"} ˜
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \wedge Y \coloneqq \wedge_\ast (X \tilde{\wedge} Y)
            %p
              where, by (
              %a{:href => "#Lydakis98"}> Lydakis 98, prop. 3.23
              ),
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∧
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge_\ast
              is the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mo ∧
                    %annotation{:encoding => "application/x-tex"} \wedge^\ast(-) \coloneqq (-)\circ \wedge
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              isomorphism gives the above characterization.
          #SmashProductCompatibleWithTheOneOnSpectra.num_prop
            %h6#proposition_6 Proposition
            %p
              Under the Quillen equivalence of prop.
              %a.maruku-ref{:href => "#QuillenEquivalenceBetweenSequentialSpectraAndExcisiveFunctors"}
              the symmetric monoidal
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution+product"} Day convolution product
              on excisive simplicial functors (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LydakisTensorProductIsDayConvolution"}
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              realized on sequential spectra by the
              = succeed "." do
                %a{:href => "sequential+spectrum#SmashProductByDoublingDegrees"} standard formula
          %p
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, theorem 12.5
            )
          %p
            This implies that any incarnation of the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mo *
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [sSet^{\ast}_{fin}, sSet^{\ast/}]
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            up to stable weak equivalence. The following says that the canonical incarnation of the sphere spectrum actually is the genuine (1-categorical) tensor unit:
          #StandardSphereSpectrum.num_defn
            %h6#definition_7 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi std
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{std}\in [sSet^{\ast/}_{fin}, sSet^{\ast/}]
            %p
              for the canonical inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ↪
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} sSet^{\ast/}_{fin} \hookrightarrow sSet^{\ast/}
            %p
              (the standard incarnation of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              in the model structure for excisive functors).
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi std
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{std}
              of def.
              %a.maruku-ref{:href => "#StandardSphereSpectrum"}
              is (up to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi sSet
                        %mo *
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %msub
                        %mo ∧
                        %mi Day
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([sSet^{\ast/}_{fin}, sSet^{\ast}], \wedge_{Day})
          .proof
            %h6#proof_2 Proof
            %p
              This is (
              %a{:href => "#Lydakis98"}> Lydakis 98, theorem 5.9
              ), but it is immediate with prop.
              = succeed "," do
                %a.maruku-ref{:href => "#LydakisTensorProductIsDayConvolution"}
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by the tensor unit in the underlying site (
              %a{:href => "Day+convolution#DayConvolutionYieldsMonoidalCategoryStructure"}> this proposition
              ).
          #LydakisModelCategoryIsMonoidal.num_prop
            %h6#proposition_8 Proposition
            %p
              Equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              tensor product (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LydakisTensorProductIsDayConvolution"}
              %a.maruku-ref{:href => "#LydakisModelStructure"}
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Ly
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∧
                        %mi Day
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    [sSet^{\ast/}_{fin}, sSet^{\ast/}]_{Ly}, \; \wedge_{Day}
                    \\right)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout+product+axiom"} pushout product axiom
              is (
              %a{:href => "#Lydakis98"}> Lydakis 98, theorem 12.3
              ). Moreover (
              %a{:href => "#Lydakis98"}> Lydakis 98, theorem 12.4
              ), shows that tensoring with cofibrant objects preserves all stable weak equivalences, hence in particular preserves cofibrant resolution of the tensor unit.
          %p
            This means that (
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"}> commutative
            )
            %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            in the monoidal Lydakis model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Ly
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∧
                      %mi Day
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left( [sSet^{\ast/}_{fin}, sSet^{\ast/}]_{Ly}, \; \wedge_{Day} \right)
            are good models for
            %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
            (
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+rings"}> E-infinity rings
            \/
            %a.existingWikiWord{:href => "/nlab/show/A-infinity+rings"}> A-infinity rings
            ).
          #MonoidsInLydakisModelStructureAreFSP.num_prop
            %h6#proposition_9 Proposition
            %p
              Monoids (commutative monoids) in the Lydakis monoidal model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Ly
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∧
                        %mi Day
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( [sSet^{\ast/}_{fin}, sSet^{\ast/}]_{Ly}, \; \wedge_{Day} \right)
              of prop.
              %a.maruku-ref{:href => "#LydakisModelCategoryIsMonoidal"}
              are equivalently (
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"}> symmetric
              )
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} lax monoidal functors
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    sSet^{\ast/}_{fin} \longrightarrow sSet^{\ast/}
            %p
              also known as “
              %a.existingWikiWord{:href => "/nlab/show/functors+with+smash+product"}> functors with smash product
              ” (
              %a.existingWikiWord{:href => "/nlab/show/FSP"}> FSP
              s).
          %p
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, remark 5.12
            )
          .proof
            %h6#proof_4 Proof
            %p
              Since the tensor product is
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              of the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} sSet^{\ast/}_{fin}
              = succeed "," do
                %a.maruku-ref{:href => "#DayConvolutionStructureOnExcisiveFunctors"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              = succeed "." do
                %a{:href => "Day+convolution#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"} this proposition
          %h2#related_concepts Related concepts
          %p
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
          %p
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+spectra"} model structure on spectra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"}> sequential spectrum
              ,
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sequential+spectra"} model structure on sequential spectra
          %p
            with
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectrum"}> symmetric spectrum
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+symmetric+spectra"} model structure on symmetric spectra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectrum"}> orthogonal spectrum
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+orthogonal+spectra"} model structure on orthogonal spectra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S-module"}> S-module
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+S-modules"} model structure on S-modules
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/excisive+functor"}> excisive functor
                ,
                %strong model structure on excisive functors
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
          %p
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+n-excisive+functors"} model structure for n-excisive functors
          %h2#references References
          %p
            Model structure for
            %a.existingWikiWord{:href => "/nlab/show/excisive+functors"} excisive functors
            on
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            (hence also a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+spectra"} model structure for spectra
          %ul
            %li#Lydakis98
              %a.existingWikiWord{:href => "/nlab/show/Manos+Lydakis"}> Manos Lydakis
              ,
              %em Simplicial functors and stable homotopy theory
              Preprint, 1998 (Hopf archive
              = succeed "," do
                %a{:href => "http://hopf.math.purdue.edu/Lydakis/s_functors.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/LydakisSimplicialFunctors.pdf", :title => "pdf"} pdf
          %p A similar model structure on functors on topological spaces was given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %em Localizations
              = succeed "," do
                %em Axiomatic, enriched and motivic homotopy theory
              = succeed "," do
                %strong 131
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-94-007-0948-5"} doi:10.1007/978-94-007-0948-5
          %p
            and also excisive functors modeled on topological spaces are the
            = succeed "-spectra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
          %ul
            %li#MandellMaySchwedeShipley01
              %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"}> Michael Mandell
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
              %strong 82
              (2001) 441-512 &amp;lbrack;
              %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/mmssLMSDec30.pdf"}> pdf
              \&amp;rbrack;
          %p
            Discussion of the restriction from excisive functors to
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            includes
          %ul
            %li#Schwede12
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              , chapter I, section 7.3 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Symmetric spectra
              (2012)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/functors+with+smash+products"} functors with smash products
            (“FSP”s) appearing in (
            %a{:href => "#Lydakis98"}> Lydakis 98, remark 5.12
            ) had earlier been considered in
          %ul
            %li{:id => "B&#246;kstedt86"}
              %a.existingWikiWord{:href => "/nlab/show/Marcel+B%C3%B6kstedt"}> Marcel Bökstedt
              ,
              = succeed "." do
                %em Topological Hochschild homology
          %p
            Further generalization of the model structure for excisive functor, in particular to
            %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
            and to a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+n-excisive+functors"} model structure for n-excisive functors
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \geq 1
            is discussed in
          %ul
            %li#BiedermannChornyRondings06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georg+Biedermann"}> Georg Biedermann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Boris+Chorny"} Boris Chorny
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+R%C3%B6ndigs"} Oliver Röndigs
                = succeed "," do
                  %em Calculus of functors and model categories
                %strong 214
                (2007) 92-115 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0601221"}> arXiv:math/0601221
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2006.10.009"} doi:10.1016/j.aim.2006.10.009
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georg+Biedermann"}> Georg Biedermann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+R%C3%B6ndigs"} Oliver Röndigs
                = succeed "," do
                  %em Calculus of functors and model categories II
                %strong 14
                (2014) 2853-2913 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1305.2834"}> arXiv:1305.2834v2
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2014.14.2853"} doi:10.2140/agt.2014.14.2853
        .revisedby
