                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  C\left(c, \int_J F \right)
                  \\simeq
                  \\int_J C(c, F)
                  \\simeq
                  \\infty Gpd^{J^{op} \times J}
                  \\big(
                  J(-,-), C(c, F(-,-))
                  \\big)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mrow
                    %mo (
                    %msup
                      %mo ∫
                      %mi J
                    %mi F
                    %mo ,
                    %mi c
                    %mo )
                  %mo ≃
                  %msub
