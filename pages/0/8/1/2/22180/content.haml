          %h3#end_of_a_spacevalued_functor End of a space-valued functor
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi J
                    %mi op
                  %mo ×
                  %mi J
                  %mo →
                  %mn ∞
                  %mi Gpd
                %annotation{:encoding => "application/x-tex"} F \colon J^{op} \times J \to \infty Gpd
            to
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGroupoids"} ∞Groupoids
            from the
            %a.existingWikiWord{:href => "/nlab/show/product+category"} product
            of a
            %a.existingWikiWord{:href => "/nlab/show/locally+small+%28%E2%88%9E%2C1%29-category"} locally small (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            with its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
            %em end
            to be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom-space"} (∞,1)-categorical hom-space
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            from the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
