                    %mi J
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
