                            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/lattice"}> lattice
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/meet"}> meet
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} logical conjunction
                            %a.existingWikiWord{:href => "/nlab/show/and"} and
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/join"}> join
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/logical+disjunction"} logical disjunction
                            %a.existingWikiWord{:href => "/nlab/show/or"} or
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/compact+element"} compact element
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/lattice+of+subobjects"} lattice of subobjects
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/complete+lattice"}> complete lattice
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/algebraic+lattice"} algebraic lattice
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"}> distributive lattice
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/completely+distributive+lattice"} completely distributive lattice
                        %a.existingWikiWord{:href => "/nlab/show/canonical+extension"} canonical extension
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/first-order+hyperdoctrine"}> first-order
                          ,
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+hyperdoctrine"} Boolean
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/coherent+hyperdoctrine"} coherent
                          %a.existingWikiWord{:href => "/nlab/show/tripos"} tripos
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/frame"}> frame
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                  %h2#theorems Theorems
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
          %h1#implication Implication
          .maruku_toc
            %ul
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#relations_between_the_definitions"} Relations between the definitions
              %li
                %a{:href => "#in_various_formalizations"} In various formalizations
              %ul
                %li
                  %a{:href => "#in_heyting_algebras"} In Heyting algebras
                %li
                  %a{:href => "#in_natural_deduction"} In natural deduction
                %li
                  %a{:href => "#in_type_theory"} In type theory
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#definitions Definitions
          %p
            An
            %em implication
            may be either an
            %em entailment
            or a
            %em conditional
            statement; these are closely related but not quite the same thing.
          %ol
            %li
              %p
                %strong Entailment
                is a
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
                on
                %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
                within a given
                %a.existingWikiWord{:href => "/nlab/show/context"} context
                in a given
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/logic"} logic
              %p
                We say that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                entails
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/syntax"} syntactically
                %a.existingWikiWord{:href => "/nlab/show/sequent"} sequent
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ⊢
                        %mi q
                      %annotation{:encoding => "application/x-tex"} p \vdash q
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                can be
                %a.existingWikiWord{:href => "/nlab/show/proof"} proved
                from the assumption
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              %p
                We say that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                entails
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/semantics"} semantically
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ⊨
                        %mi q
                      %annotation{:encoding => "application/x-tex"} p \vDash q
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                holds in every
                %a.existingWikiWord{:href => "/nlab/show/model"} model
                in which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                holds.
              %p
                (These relations are often equivalent, by various
                %span.newWikiWord
                  soundness
                  %a{:href => "/nlab/new/soundness+theorem"} ?
                and
                %a.existingWikiWord{:href => "/nlab/show/completeness+theorem"} completeness
                theorems.)
            %li
              %p
                A
                %strong conditional
                statement is the result of a
                %a.existingWikiWord{:href => "/nlab/show/binary+operation"} binary operation
                on
                %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
                within a given
                %a.existingWikiWord{:href => "/nlab/show/context"} context
                in a given
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/logic"} logic
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                are propositions in some context, then so is the conditional statement
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo →
                        %mi q
                      %annotation{:encoding => "application/x-tex"} p \to q
          %p
            Notice that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo →
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \to q
            are all statements in the
            %em object
            language (the language that we are talking about), whereas the
            %a.existingWikiWord{:href => "/nlab/show/hypothetical+judgements"} hypothetical judgements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⊢
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \vdash q
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⊨
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \vDash q
            are statements in the
            %em
              %a.existingWikiWord{:href => "/nlab/show/metalanguage"} metalanguage
            (the language that we are using to talk about the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/object+language"} object language
          %h3#relations_between_the_definitions Relations between the definitions
          %p
            Depending on what logic one is using,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo →
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \to q
            might be anything, but it's probably not fair to consider it a conditional statement unless it is related to entailment as follows:
          .standout
            %p
              If, in some context,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              entails
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              (either syntactically or semantically), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo →
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p \to q
              is a
              %a.existingWikiWord{:href => "/nlab/show/theorem"} theorem
              (syntactically) or a
              %a.existingWikiWord{:href => "/nlab/show/tautology"} tautology
              (semantically) in that context, and conversely.
          %p
            In particular, this holds for
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
          %p
            You can think of entailment as being an
            %a.existingWikiWord{:href => "/nlab/show/external+hom"} external hom
            (taking values in the poset of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            (taking values in the poset of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi q
                    %mo →
                    %mi r
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo →
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo →
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q \to r \vdash (p \to q) \to (p \to r)
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                    %mo ≡
                    %mo ⊤
                    %mo →
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p \equiv \top \to p
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊤
                    %mo ⊢
                    %mi p
                    %mo →
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \top \vdash p \to p
              ,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            is an appropriate constant statement (often satisfying
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⊢
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} p \vdash \top
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊸
                %annotation{:encoding => "application/x-tex"} \multimap
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \to
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
          %p
            Most kinds of logic used in practice have a notion of entailment from a
            %a.existingWikiWord{:href => "/nlab/show/list"} list
            of multiple premises; then we expect entailment and the conditional to be related as in a closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
          %p
            Just as we may identify the internal and external hom in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
            = succeed "Lab," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊢
                  %annotation{:encoding => "application/x-tex"} \vdash
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊨
                  %annotation{:encoding => "application/x-tex"} \vDash
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \rightarrow
          %h2#in_various_formalizations In various formalizations
          %h3#in_heyting_algebras In Heyting algebras
          %p
            Although
            %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
            were first developed as a way to discuss
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            %strong Heyting implication
            and denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \rightarrow
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \to
            and replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                %annotation{:encoding => "application/x-tex"} \vdash
            above with the Heyting algebra's partial order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
          %h3#in_natural_deduction In natural deduction
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            the
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            for implication are given as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo →
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo →
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo →
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash P \; \mathrm{prop} \quad \Gamma \vdash Q \; \mathrm{prop}}{\Gamma \vdash P \to Q \; \mathrm{prop}} \qquad \frac{\Gamma \vdash P \; \mathrm{prop} \quad \Gamma, P \; \mathrm{true} \vdash Q \; \mathrm{true}}{\Gamma \vdash P \to Q \; \mathrm{true}} \qquad \frac{\Gamma \vdash P \to Q \; \mathrm{true}}{\Gamma, P \; \mathrm{true} \vdash Q \; \mathrm{true}}
          %h3#in_type_theory In type theory
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
          %ul
            %li
              %p
                a
                %em conditional statement
                is, under
                %a.existingWikiWord{:href => "/nlab/show/propositions-as-types"} propositions-as-types
                a
                %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo →
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p \to q
                (or the
                %a.existingWikiWord{:href => "/nlab/show/bracket+type"} bracket type
                thereof).
            %li
              %p
                an
                %em entailment
                is a
                %a.existingWikiWord{:href => "/nlab/show/hypothetical+judgement"} hypothetical judgement
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/sequent"} sequent
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hypothetical+judgement"} hypothetical judgement
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/linear+implication"} linear implication
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/contrapositive"} contrapositive
          %div
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %annotation{:encoding => "application/x-tex"} \phantom{-}
                    symbol
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
