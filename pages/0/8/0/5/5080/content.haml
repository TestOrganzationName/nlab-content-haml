          %h2#idea Idea
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            has a
            %a.existingWikiWord{:href => "/nlab/show/shape+of+an+%28%E2%88%9E%2C1%29-topos"} shape
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Shape
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Pro
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Shape(E) \in Pro\infty Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
            then this is a genuine
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \Pi(E) \in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
          %p
            But also every
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
            has an
            %em internal
            notion of
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            for objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi E
                    %mo :
                    %mi E
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi_E : E \to \infty Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:lspace => "verythinmathspace"} :
                  %mn ∞
                  %mi Grpd
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} \Delta \colon \infty Grpd \to E
            is
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful+%28%E2%88%9E%2C1%29-functor"} fully faithful
            then we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            the
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            this does agree with the fundamental ∞-groupoid of the topos:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Π
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(E) \simeq \Pi_E(*)
                  \\,.
          %p
            Conversely, for an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X\in E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_E(X)
            internal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            can be identified with the fundamental ∞-groupoid of the locally ∞-connected (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E/X
          %h2#definition Definition
          .num_def
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi E
                    %mo ⊣
                    %msub
                      %mi Γ
                      %mi E
                    %mo ⊣
                    %msub
                      %mi LConst
                      %mi E
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi E
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} (\Pi_E \dashv \Gamma_E \dashv LConst_E) :  E \to \infty Grpd
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              we say its
              %strong
                fundamental
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Π
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(E) := \Pi_E(*)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              In other words, it is the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} internal fundamental ∞-groupoid
              of the terminal object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %h2#properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a locally
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            is locally
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We have then two different definitions of the fundamental
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_{\mathbf{H}}(X)
            – the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            – and once as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(\mathbf{H}/X)
          .num_prop
            %h6#proposition Proposition
            %p These agree:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_{\mathbf{H}}(X) \simeq \Pi(\mathbf{H}/X)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi Id
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \stackrel{Id}{\to} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              we have by definition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Π
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Id
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(\mathbf{H}/X) = \Pi_{\mathbf{H}/X}(Id_X)
                    \\,.
            %p
              Now observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo =
                    %msub
                      %mi Π
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo ∘
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathbf{H}/X} = \Pi_{\mathbf{H}} \circ X_!
              since the terminal
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              geometric morphism of the over-topos is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi X
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi Γ
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                        %mover
                          %mo ←
                          %mrow
                            %msub
                              %mi LConst
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi Π
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}/X
                    \\stackrel{\overset{X_!}{\to}}{\stackrel{\overset{X^*}{\leftarrow}}{\underset{X_*}{\to}}}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi_{\mathbf{H}}}{\to}}{\stackrel{\overset{LConst_{\mathbf{H}}}{\leftarrow}}{\underset{\Gamma_{\mathbf{H}}}{\to}}}
                    \\infty Grpd
            %p
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} X_!
              in the
              %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              is the projection map that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mover
                      %mo →
                      %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \stackrel{}{\to} X
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          .num_def
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LC
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"} LC(\infty,1)Topos
              denote the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Topos"} (∞,1)Topos
              determined by the locally ∞-connected objects.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} \infty Gpd
              (as the category of local homeomorphisms over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Gpd
                    %annotation{:encoding => "application/x-tex"} \infty Gpd
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LC
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Topos
                    %annotation{:encoding => "application/x-tex"} LC(\infty,1)Topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mi Π
                    %mi LC
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd
                    \\stackrel{\overset{\Pi}{\leftarrow}}{\hookrightarrow}
                    LC(\infty,1)Topos
            %p
              with the reflector given by forming the fundamental
              = succeed "-groupoid." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .proof
            %h6#proof_2 Proof
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              gives rise to an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-presheaf (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi G
                        %mi op
                      %mo ,
                      %mn ∞
                      %mi Gpd
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} PSh(G) = [G^{op},\infty Gpd]
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Gpd
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \infty Gpd / G
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} \infty Gpd
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+homeomorphism+of+toposes"} local homeomorphism of toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} \infty Gpd
              as a full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Topos"} (∞,1)Topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mi LC
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh(-) : \infty Grpd \hookrightarrow LC(\infty,1)Topos
                    \\,.
            %p
              since in particular the
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(G)
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
            %p
              To show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(-)
              we demonstrate a natural hom-equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LC
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    LC(\infty,1)Topos(E,(\infty,1)PSh(A)) \simeq \infty Grpd(\Pi_E(*), A)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi LC
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"} E\in LC(\infty,1)Topos
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} A \in \infty Grpd
            %p
              At
              %a.existingWikiWord{:href => "/nlab/show/shape+of+an+%28%E2%88%9E%2C1%29-topos"} shape of an (∞,1)-topos
              it is shown that we have a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Γ
                      %mi E
                    %msub
                      %mi LConst
                      %mi E
                    %mi G
                    %mo =
                    %mo :
                    %mi Shape
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\infty,1)Topos(E, PSh(A)) \simeq \Gamma_E LConst_E G =: Shape(E)(A)
                    \\,.
            %p Now observe that furthermore we have a sequence of natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Shape
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi LConst
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mn ∞
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi LConst
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
