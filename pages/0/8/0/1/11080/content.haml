                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  are precisely the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
          %p
            We discuss a standard structure of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            on the category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Johnstone – Sketches of an Elephant
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/small+site"} small
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
          .num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the standard
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open n-ball
              is the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} |
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo &lt;
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D^n = \{ (x_i)_{i =1}^n \in \mathbb{R}^n | \sum_{i = 1}^n (x_i)^2 \lt 1 \}  \hookrightarrow \mathbb{R}^n
                    \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi D
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \stackrel{\simeq}{\to} D^n
                    \\,.
          #DifferentiallyGoodOpenCover.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (differentially
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
            %p
              A
              %strong
                differentially
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              of a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow \mathbb{R}^n\}
              of
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              inclusions of Cartesian spaces such that these
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and such for each non-empty finite
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                    %mo ∩
                    %mi ⋯
                    %mo ∩
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \stackrel{\simeq}{\to} U_{i_1} \cap \cdots \cap U_{i_k}
            %p
              that identifies the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          .num_remark
            %h6#remark_4 Remark
            %p
              Differentiably good covers are useful for computations. Their full impact is however on the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+homotopy+types"} smooth homotopy types
          #DiffGoodOpenCoversRefineOpenCovers.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (every
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                has refinement by a differentially
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              has a refinement by a differentially good open cover, according to Def.
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
          %p
            For proof see
            = succeed "," do
              %a{:href => "https://ncatlab.org/schreiber/show/Cech+Cocycles+for+Differential+characteristic+Classes"} FSS10, Prop. A1
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          .num_remark
            %h6#remark_5 Remark
            %p
              Lemma
              %a.maruku-ref{:href => "#DiffGoodOpenCoversRefineOpenCovers"}
              is not quite a classical statement. The classical statement is only that every open cover is refined by a
              %em topologically
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %em
                %a{:href => "ball#References"} here in the references-section
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              for the situation concerning this statement in the literature.
          .num_remark
            %h6#remark_6 Remark
            %p
              The
              %em good
              open covers do not yet form a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family also its
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along any morphism in the category is a covering family. But while the pullback of every
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              is again an open cover, and hence open covers form a Grothendieck topology on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %em
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good
              open cover is again
              = succeed "." do
                %em good
          #ExampleThatGoodOpenCoversAreNotPullbackStable.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mn 2
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msup
                      %mi ℝ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^2\stackrel{\phi_{i}}{\hookrightarrow}\mathbb{R}^2\}_{i \in \{1,2\}}
              be the
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of the
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
              by an open left half space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mn 1
                    %mo &lt;
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi ϕ
                          %mn 1
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^2 \simeq \{ (x_1,x_2) \in \mathbb{R}^2 | x_1 \lt 1 \} \stackrel{\phi_1}{\hookrightarrow} \mathbb{R}^2
            %p and a right open half space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mn 1
                    %mo &gt;
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi ϕ
                          %mn 2
                    %msup
                      %mi ℝ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^2 \simeq \{ (x_1,x_2) \in \mathbb{R}^2 | x_1 \gt -1 \} \stackrel{\phi_2}{\hookrightarrow} \mathbb{R}^2
                    \\,.
            %p The intersection of the two is the open strip
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mn 1
                    %mo &lt;
                    %msub
                      %mi x
                      %mn 1
                    %mo &lt;
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^2 \simeq \{ (x_1, x_2) \in \mathbb{R}^2 | -1 \lt x_1 \lt 1 \}
                    \\hookrightarrow
                    \\mathbb{R}^2
                    \\,.
            %p
              So this is a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %p But consider then the smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo{:stretchy => "false"} (
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    2(\cos(2 \pi (-)), \sin(2 \pi (-))) \colon \mathbb{R}^1 \to \mathbb{R}^2
            %p
              which sends the line to a curve in the plane that periodically goes around the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              of radius 2 in the plane.
            %p
              Then the pullback of the above good open cover on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              along this function is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              by two open subsets, each being a disjoint union of countably many open
              %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              %em
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              is not
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
              (it does not contract to the point, but to many points!).
            %p
              So the pullback of the good open cover that we started with is an open cover which is not
              %em good
              anymore. But it has an evident
              %em refinement
              by a good open cover.
          %p This is a special case of what the following statement says in generality.
          #TheDifferentiallyGoodOpenCoverCoverage.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                of
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                with differentially
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
            %p
              The differentially
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Coverage"}> this Def.
              ) on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              (from Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CartSpCategory"}
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              equipped with this coverage is a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Coverage"}> this def.
              ).
          .proof
            %h6#proof Proof
            %p
              By definition of
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              we need to check that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow \mathbb{R}^n\}_{i \in I}
              any
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi k
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^k \to \mathbb{R}^n
              any smooth function, we can find a good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mi j
                    %mo →
                    %msup
                      %mi ℝ
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{K_j \to \mathbb{R}^k\}_{j \in J}
              and a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \to I
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              there is a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi K
                      %mi j
                    %mo →
                    %msub
                      %mi U
                      %mrow
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \colon K_j \to U_{\rho(j)}
              that makes this
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi K
                              %mi j
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi k
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    
                    K_j &amp;\stackrel{\phi}{\to}&amp; U_{i(j)}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbb{R}^k &amp;\stackrel{f}{\to}&amp; \mathbb{R}^n
                    }
                    \\,.
            %p
              To obtain this, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f^* U_i \to \mathbb{R}^k\}
              be the pullback of the original covering family, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi U
                      %mi i
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^* U_i \coloneqq \{ x \in \mathbb{R}^k | f(x) \in U_i \}
                    \\hookrightarrow \mathbb{R}^k
                    \\,.
            %p
              This is evidently an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %a.maruku-ref{:href => "#DiffGoodOpenCoversRefineOpenCovers"}
              there does exist a good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mover
                        %mi j
                        %mo{:stretchy => "false"} ˜
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ˜
                        %mo ∈
                        %mover
                          %mi J
                          %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \{\tilde K_{\tilde j} \hookrightarrow \mathbb{R}^k\}_{\tilde j \in \tilde J}
              %em refining
              it, which in turn means that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde j
              there is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mover
                                %mi j
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi K
                              %mrow
                                %mi j
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi j
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi k
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %msup
                              %mi ℝ
                              %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tilde K_{\tilde j} &amp;\to&amp; K_{j(\tilde j)}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbb{R}^k &amp;\stackrel{=}{\to}&amp; \mathbb{R}^k
                    }
                    \\,.
            %p
              Therefore then the
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite of these commuting squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mover
                                %mi j
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi K
                              %mrow
                                %mi j
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi j
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi j
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi k
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %msup
                              %mi ℝ
                              %mi k
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tilde K_{\tilde j} &amp;\to&amp; K_{j(\tilde j)} &amp;\to&amp; U_{i(j(\tilde j))}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbb{R}^k &amp;\stackrel{=}{\to}&amp; \mathbb{R}^k
                    \&amp;\stackrel{f}{\to}&amp; \mathbb{R}^n
                    }
            %p
              solves the condition required in the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          %p
            By example
            %a.maruku-ref{:href => "#ExampleThatGoodOpenCoversAreNotPullbackStable"}
            this
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            is not a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
          #CompletingGoodOpenCoversToAllOpenCovers.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (completing
                %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
                to all
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              induced on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              by the differentially good open cover coverage of def.
              %a.maruku-ref{:href => "#TheDifferentiallyGoodOpenCoverCoverage"}
              has as covering families the ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
            %p
              Hence if we explicitly write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi good
                  %annotation{:encoding => "application/x-tex"} CartSp_{good}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi Groth
                  %annotation{:encoding => "application/x-tex"} CartSp_{Groth}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              equipped with the coverage of differentially good open covers as and that of all open covers, respectively, then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#EquivalenceOfCategories"}> this Def.
              ) between their
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Sheaf"}> this Def.
              )
            #eq:SheavesOnGoodOpenCoversCoincideWithThosOnALlOpenCovers.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mtext good open cov
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mtext all open cov
                    %mo{:stretchy => "false"} )
                    %mi \
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(CartSp_{\text{good open cov}})
                    \\;\simeq\;
                    Sh(CartSp_{\text{all open cov}})
                    \\.
          .num_remark
            %h6#remark_7 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#CompletingGoodOpenCoversToAllOpenCovers"}
              means that for every sheaf-theoretic construction to follow we may just as well consider the Grothendieck topology of open covers on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SheavesOnGoodOpenCoversCoincideWithThosOnALlOpenCovers"} (1)
            %p
              While the sheaves of the open cover topology are the same as those of the good open cover coverage. But the latter is (more) useful for several computational purposes in the following. It is the
              %em good
              open cover coverage that makes manifest, below, that sheaves on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              form a
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected topos
              and in consequence then a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              %a{:href => "#SmoothnGroupoids"} further below
              to
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %em
                %a{:href => "#InfinityConnectednessOfSmoothInfinityGrpd"} Smooth n-groupoids – Semantic Layer – Local Infinity-Connectedness
                below.
          %p
            There are further
            %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            in use, which induce the same categories of sheaves:
          #SiteOfSmoothManifolds.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                and
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p We write
            %ul
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                  of any finite
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  between them;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi EuclOp
                      %annotation{:encoding => "application/x-tex"} EuclOp
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
                  of any finite
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  between them.
            %p
              Both of these carry the respective
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              of
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              and as such become
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Coverage"}> this Def.
              )
          %h2#SmoothSpacesLayerMod Smooth sets
          %p
            In the section
            %em
              %a{:href => "#CoordinateSystems"} Coordinate systems
            we have set up the archetypical
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            that differential geometry can deal with.
          %h3#PlotsOfSmoothSpacesAndTheirGluing Plots of smooth sets and their gluing
          %p
            The general kind of “
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"}> smooth space
            ” that we want to consider is a
            %a.existingWikiWord{:href => "/nlab/show/type"} something
            that can be
            %em probed
            by laying out
            %a.existingWikiWord{:href => "/nlab/show/coordinate+systems"} coordinate systems
            inside it, as in
            = succeed "," do
              %a{:href => "geometry+of+physics+--+coordinate+systems#CartesianSpaces"} this definition
            %em gluing
            all the possible coordinate systems in it together.
          %p
            At this point we want to impose no further conditions on a “space” than this. In particular we do not assume that we know beforehand a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/points"} points
            underlying
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (Def.
            = succeed "," do
              %a.maruku-ref{:href => "#SmoothSpace"}
            %em operationally
            as something about which we may ask “Which ways are there to lay out
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            inside
            = succeed "?\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            By the discussion in the chapter
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+categories+and+toposes"} categories and toposes
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            to be a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            on a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
          %p The idea of the following definitions may be summarized like this:
          %ol
            %li
              %p
                a generalized
                %em smooth set
                is something that may be probed by laying out coordinate systems into it, in a way that respects transformation of coordinate patches and gluing of coordinate patches;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                (
                %a{:href => "geometry+of+physics+--+categories+and+toposes#YonedaLemma"}> this prop
                ) says that this is consistent in that coordinate systems themselves as well as
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                may naturally be regarded as generalized smooth sets themselves and that under this identification “laying out a coordinate system” in a smooth set means having a map of smooth sets from the coordinate system to the smooth set.
          %p
            The first set of consistency conditions on plots of a space is that they respect
            = succeed "." do
              %em coordinate transformations
          #SmoothPreSpace.num_defn
            %h6#definition_8 Definition
            %p
              %strong (pre-smooth set)
            %p
              A
              %strong pre-smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  a collection of sets: for each
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  (hence for each
                  %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi Set
                      %annotation{:encoding => "application/x-tex"}
                        X(\mathbb{R}^n) \in Set
                %p
                  – to be thought of as the
                  = succeed "," do
                    %em
                      set of ways of laying out
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                      inside
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                  %em plots
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  (to be thought of as an abstract coordinate transformation) a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  between the corresponding sets of plots
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        X(f) \;\colon\; X(\mathbb{R}^{n_2}) \longrightarrow X(\mathbb{R}^{n_1})
                %p
                  – to be thought of as the function that sends a
                  %em plot
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
                  to the correspondingly transformed plot by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
                  induced by laying out
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
                  inside
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
            %p such that this is compatible with coordinate transformations:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                  coordinate transformation does not change the plots:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        X(id_{\mathbb{R}^n}) = id_{X(\mathbb{R}^n)}
                        \\,,
              %li
                %p
                  changing plots along two consecutive coordinate transformations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f_1 \colon \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
