                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothFunctionSpace"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              of forming the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} ev \colon  [\Sigma, X] \times \Sigma \to X
              with
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              This construction manifestly extends to the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
          #EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces.num_prop
            %h6#proposition_22 Proposition
            %p
              The two definitions of
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
              to mapping spaces from def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpaces"}
              and def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              are equivalent.
          .proof
            %h6#proof_13 Proof
            %p
              We need to check that for all plots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma \colon U \to [\Sigma, X]
              the pullbacks of the two forms to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              coincide.
            %p
              For def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi γ
                      %mo *
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi Σ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma^\ast \int_\Sigma \mathrm{ev}^\ast A
                    \=
                    \\int_\Sigma (\gamma,\mathrm{id}_\Sigma)^\ast \mathrm{ev}^\ast A
                    \\;
                    \\in \Omega^n(U)
            %p
              Here we recognize in the integrand the pullback along the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Σ
                      %mo ⊣
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (-)\times \Sigma \dashv [\Sigma,-])
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \tilde \gamma : U \times \Sigma \to \Sigma
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} (-)\times \Sigma
              and then postcomposing with the adjunction counit
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
