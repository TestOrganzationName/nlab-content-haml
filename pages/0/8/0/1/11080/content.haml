                      %mi{:mathvariant => "normal"} ev
                    %annotation{:encoding => "application/x-tex"} \mathrm{ev}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
