                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \phi \in \mathbf{X}(U)
              %li
                %p
                  for all plots
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
