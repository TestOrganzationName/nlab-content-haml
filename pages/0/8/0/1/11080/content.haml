                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mn 2
                        %mo ∘
                        %msub
                          %mi f
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        X(f_1) \circ X(f_2)  = X(f_2 \circ f_1)
                        \\,.
          %p But there is one more consistency condition for a collection of plots to really be probes of some space: it must be true that if we glue small coordinate systems to larger ones, then the plots by the larger ones are the same as the plots by the collection of smaller ones that agree where they overlap. We first formalize this idea of “plots that agree where their coordinate systems overlap.”
          #DifferentiallyGoodOpenCover.num_prop
            %h6#definition_9 Definition
            %p
              %strong
                (differentially
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ↪
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\{U_i \hookrightarrow X\}_{i \in I}
                %p
                  is a set of
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  is
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi U
                            %mi i
                          %mo =
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} U_i = X
              %li
                %p
                  this is a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                  if all the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  as well as all their
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  finite
                  %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                  are
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
                  to
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  itself;
              %li
                %p
                  this is a
                  %em differentially good open cover
                  if all the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  as well as all their
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  finite
                  %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                  are
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
                  to
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  itself.
          #MatchingFamiliesOfPlots.num_defn
            %h6#definition_10 Definition
            %p
              %strong (glued plots)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a pre-smooth set, def.
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothPreSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \to \mathbb{R}^n\}_{i \in I}
              a differentially
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GluedPlots
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    GluedPlots(\{U_i \to \mathbb{R}^n\}, X) \in Set
            %p
              be the set of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which coincide on all double
              %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi i
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi j
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U_i \cap U_j
                    \\\
                    \&amp; {}^{\mathllap{\iota_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{\iota_j}}
                    \\\
                    U_i &amp;&amp;&amp;&amp; U_j
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbb{R}^n
                    }
            %p
              (also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over the given cover):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GluedPlots
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msub
                            %mi p
                            %mi i
                          %mo ∈
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∀
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ∈
                          %mi I
                      %mspace{:width => "thickmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    GluedPlots(\{U_i \to \mathbb{R}^n\}, X)
                    \\;\;\coloneqq\;\;
                    \\left\{
                    \\;
                    \\left(p_i \in X(U_i)\right)_{i \in I}
                    \\;|\;\;
                    \\forall_{i,j \in I} \;:\; X(\iota_i)(p_i) = X(\iota_j)(p_j)
                    \\;
                    \\right\}
                    \\,.
          .num_remark
            %h6#remark_8 Remark
            %p
              %strong (interpretation of the gluing condition)
            %p
              In def.
              %a.maruku-ref{:href => "#MatchingFamiliesOfPlots"}
              the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X(\iota_i)(p_i) = X(\iota_j)(p_j)
            %p says in words:
            %blockquote
              %p
                The plot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by the coordinate system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                inside the bigger coordinate system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                coincides with the plot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi j
                    %annotation{:encoding => "application/x-tex"} p_j
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by the other coordinate system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_j
                inside
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                when both are restricted to the
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_j
                inside
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          #NaiveDescentMorphism.num_remark
            %h6#remark_9 Remark
            %p
              %strong (comparing global plots to glued plots)
            %p
              For each differentially good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \to \mathbb{R}^n\}_{i \in I}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothPreSpace"}
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi GluedPlots
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X(\mathbb{R}^n)
                    \\longrightarrow
                    GluedPlots(\{U_i \to \mathbb{R}^n\}, X)
            %p
              from the set of
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the set of tuples of glued plots, which sends a plot
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \in X(\mathbb{R}^n)
              to its restriction to all the
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mi i
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi_i \colon U_i \hookrightarrow \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p \mapsto (X(\phi_i)(p))_{i \in I}
                    \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is supposed to be consistently probable by coordinate systems, then it must be true that the set of ways of laying out a coordinate system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            inside it coincides with the set of ways of laying out tuples of glued coordinate systems inside it, for each good cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to \mathbb{R}^n\}
            as above. Therefore:
          #SmoothSpace.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"}> smooth set
                )
            %p
              A pre-smooth set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.maruku-ref{:href => "#SmoothPreSpace"}
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              if for all differentially good open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to \mathbb{R}^n\}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
              %a.maruku-ref{:href => "#NaiveDescentMorphism"}
              from plots to glued plots is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            #eq:ConditionSmoothSet.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi GluedPlots
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X(\mathbb{R}^n) \stackrel{\simeq}{\longrightarrow} GluedPlots(\{U_i \to \mathbb{R}^n\}, X)
                    \\,.
          #OnTheNotionOfSmoothSpaces.num_remark
            %h6#remark_10 Remark
            %p
              We may think of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              as being a kind of
              %a.existingWikiWord{:href => "/nlab/show/space"} space
              whose
              %em local models
              (in the general sense discussed at
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %p#AmalgamatingSmoothSetsFromCoordinateCharts
              While definition
              %a.maruku-ref{:href => "#SmoothSpace"}
              explicitly says that a smooth set is something that is
              %em consistently probeable
              by such local models, a
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} general abstract
              fact sometimes called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              – which we discuss in more detail below in
              %em
                %a{:href => "#SmoothSpacesLayerSem"} smooth sets - Semantic Layer
              – implies that smooth sets are also precisely the objects that are obtained by
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/amalgamation"} amalgamating
                  coordinate systems
            %p
              For instance, we will see that two open 2-balls
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %msup
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \simeq D^2
              along a common rim yields the smooth set version of the
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S^2
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "." do
                %em
                  %a{:href => "#SmoothSpacesOutlook"} smooth sets - Outlook
          %p But the following most basic example we consider right now:
          #CartesianSpaceAsSmoothSpace.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                and
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{R}^n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              is the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    CartSp(\mathbb{R}^k, \mathbb{R}^n) \in Set
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %p
              Clearly this is the rule for plots that characterize
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              itself as a smooth set, and so we will just denote this smooth set by the same symbols “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              ”:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ↦
                    %mi CartSp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \colon \mathbb{R}^k \mapsto CartSp(\mathbb{R}^k, \mathbb{R}^n)
                    \\,.
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is this way itself a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            %p
              More generally, if the reader already knows what a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is; these become smooth sets by taking their plots to be the ordinary
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              between smooth manifolds, from Cartesian spaces:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi SmthMfd
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X(\mathbb{R}^n) \coloneqq Hom_{SmthMfd}(\mathbb{R}^n, X)
                    \\,.
          %p Some smooth sets are far from being like smooth manifolds:
          #SmoothSetOfDifferentialForms.num_example
            %h6#example_4 Example
            %p
              %strong
                (smooth
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^k
              given as follows:
            %ol
              %li
                %p
                  The set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^k(\mathbb{R}^n)
                  of plots from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  is the set of smooth
                  %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential k-forms
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msup
                          %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{\Omega}^k(\mathbb{R}^n) \coloneqq \Omega^k(\mathbb{R}^n)
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  a smooth function, then the corresponding change-of-plots function is the operation of
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
                  along
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi f
                              %mo *
                        %msup
                          %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\Omega^{k}(\mathbb{R}^{n_2}) \overset{f^\ast}{\longrightarrow} \Omega^k(\mathbb{R}^{n_1})
                        \\,.
            %p
              We introduce and discuss this example in detail in more detail
              %a{:href => "#DifferentialForms"} below
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SmoothSpace"}
            = succeed "," do
              %em underlying set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^k
            from example
            %a.maruku-ref{:href => "#SmoothSetOfDifferentialForms"}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k \geq 1
            has only a single plot from the point (corresponding to the zero differential form on the point), and yet it is far from being the point. If a smooth set does have an underlying set, then it is called a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            %a.maruku-ref{:href => "#DiffeologicalSpacesAreTheConcreteSmoothSets"}
            below.
          #DiscreteSmoothSpace.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              a set, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi S
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    Disc S \in SmoothSet
            %p
              for the smooth set whose set of
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              is always
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi S
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo ↦
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    Disc S \colon U \mapsto S
            %p
              and which sends every coordinate transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
              to the identity function on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              A smooth set of this form we call a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete smooth set
          %p
            More examples of smooth sets can be built notably by
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersecting
            %a.existingWikiWord{:href => "/nlab/show/images"} images
            of two smooth sets inside a bigger one. In order to say this we first need a formalization of
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of smooth sets. This we turn to now.
          %h3#HomomorphismsOfSmoothSpaces Homomorphisms of smooth sets
          %p
            We discuss “functions” or “maps” between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            = succeed "," do
              %a.maruku-ref{:href => "#SmoothSpace"}
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            in a suitable sense. As with any notion of function that preserves structure, we refer to them as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
          %p
            The idea of the following definition is to say that whatever a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            between two smooth sets is, it has to take the plots of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            to a corresponding plot of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          #HomomorphismOfSmoothSpaces.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                – smooth functions)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothSpace"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              between them is
            %ul
              %li
                %p
                  for each abstract coordinate system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  (hence for each
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f_{\mathbb{R}^n} : X(\mathbb{R}^n) \to Y(\mathbb{R}^n)
                %p
                  that sends
                  = succeed "-plots" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  to
                  = succeed "-plots" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %p such that
            %ul
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} \phi : \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi f
                          %mrow
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                        %mo =
                        %msub
                          %mi f
                          %mrow
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mo ∘
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Y(\phi) \circ f_{\mathbb{R}^{n_1}} = f_{\mathbb{R}^{n_2}} \circ X(\phi)
                %p
                  hence a
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi f
                                      %mrow
                                        %msup
                                          %mi ℝ
                                          %mrow
                                            %msub
                                              %mi n
                                              %mn 1
                              %mtd
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi X
                                      %mo{:stretchy => "false"} (
                                      %mi ϕ
                                      %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Y
                                      %mo{:stretchy => "false"} (
                                      %mi ϕ
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi X
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi f
                                      %mrow
                                        %msup
                                          %mi ℝ
                                          %mrow
                                            %msub
                                              %mi n
                                              %mn 2
                              %mtd
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X(\mathbb{R}^{n_1}) &amp;\stackrel{f_{\mathbb{R}^{n_1}}}{\to}&amp; Y(\mathbb{R}^{n_1})
                        \\\
                        \\downarrow^{\mathrlap{X(\phi)}} &amp;&amp; \downarrow^{\mathrlap{Y(\phi)}}
                        \\\
                        X(\mathbb{R}^{n_2}) &amp;\stackrel{f_{\mathbb{R}^{n_2}}}{\to}&amp; Y(\mathbb{R}^{n_1})
                        }
                        \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f_1 : X \to Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f_2 : X \to Y
              two homomorphisms of smooth sets, their
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f_2 \circ f_1 \colon X \to Y
              is defined to be the homomorphism whose component over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is the composite of functions of the components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mo ≔
                    %msub
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mo ∘
                    %msub
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_2\circ f_1)_{\mathbb{R}^n} \coloneqq {f_2}_{\mathbb{R}^n} \circ {f_1}_{\mathbb{R}^n}
                    \\,.
          #CategoryOfSmoothSets.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %em
                  %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                with
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} SmoothSet
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Categories"}> this def.
              ) whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothSpace"}
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are homomorphisms of smooth sets according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
          %p
            At this point it may seem that we have now
            %em two different
            notions for how to lay out a coordinate system in a smooth set
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            comes by definition with a rule for what the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\mathbb{R}^n)
            of its
            = succeed "-plots" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            itself as a smooth set, by example
            = succeed "," do
              %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
            = succeed "-plot" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            should be a homomorphism of smooth sets of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \to X
          %p The following proposition says that these two superficially different notions actually naturally coincide.
          #YonedaForSmoothSpaces.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              as a smooth set, by example
              = succeed "." do
                %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi SmoothSet
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X(\mathbb{R}^n) \simeq Hom_{SmoothSet}(\mathbb{R}^n, X)
            %p
              between the
              %em postulated
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the
              %em actual
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \to X
          .proof
            %h6#proof_2 Proof
            %p
              This is a special case of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#YonedaLemma"}> this prop.
              ), as will be made more explicit below in
              = succeed "." do
                %em
                  %a{:href => "#ToposOfSmoothSpaces"} The topos of smooth sets
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              in def.
              %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
              to deduce that a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^n \to X
              is uniquely fixed by the image of the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi CartSp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n(\mathbb{R}^n) \coloneqq CartSp(\mathbb{R}^n, \mathbb{R}^n)
              under the component function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                      %mo :
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_{\mathbb{R}^n} : \mathbb{R}^n(\mathbb{R}^n) \to X(\mathbb{R}^n)
          #SmoothFunctionOnSmoothSpace.num_example
            %h6#example_6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \in SmoothSet
              denote the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              by example
              = succeed "." do
                %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SmoothSet
              any smooth set, a homomorphism of smooth sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \to \mathbb{R}
            %p
              is a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %a.maruku-ref{:href => "#YonedaForSmoothSpaces"}
              says here that when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              happens to be an abstract coordinate system regarded as a smooth set by def.
              = succeed "," do
                %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
          #PointsOfASmoothSpace.num_defn
            %h6#definition_14 Definition
            %p
              The 0-
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              abstract coordinate system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
              we also call the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              and regarded as a smooth set we will often write it as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi SmoothSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    * \in SmoothSet
                    \\,.
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SmoothSet
                    %annotation{:encoding => "application/x-tex"} X \in SmoothSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    x \colon * \to X
            %p
              is a
              = succeed "." do
                %strong
                  point of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          .num_remark
            %h6#remark_11 Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#YonedaForSmoothSpaces"}
              the points of a smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are naturally identified with its 0-dimensional plots, hence with the “ways of laying out a 0-dimensional coordinate system” in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(*, X) \simeq X(\mathbb{R}^0)
                    \\,.
          %h3#ProductsAndFiberProductsOfSmoothSpaces Products and fiber products of smooth sets
          #ProductOfSmoothSpaces.num_defn
            %h6#definition_15 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X, Y \in SmoothSet
              by two smooth sets. Their
              %strong
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              is the smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X \times Y \in SmoothSet
              whose plots are pairs of plots of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X\times Y (\mathbb{R}^n) \coloneqq X(\mathbb{R}^n) \times Y(\mathbb{R}^n)
                    \\;\;
                    \\in Set
                    \\,.
            %p
              The
              %strong projection on the first factor
              is the homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    p_1 \colon X \times Y \to X
            %p
              which sends
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              to those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by forming the projection of the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              of sets:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {p_1}_{\mathbb{R}^n} \colon X(\mathbb{R}^n) \times Y(\mathbb{R}^n) \stackrel{p_1}{\to} X(\mathbb{R}^n)
                    \\,.
            %p
              Analogously for the
              %strong projection to the second factor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_2 \colon X \times Y \to Y
                    \\,.
          #ProductOfSmoothSpaceWithThePoint.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo =
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} * = \mathbb{R}^0
              be the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              = succeed "." do
                %a.maruku-ref{:href => "#PointsOfASmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SmoothSet
              any smooth set the canonical projection homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \times * \to X
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .num_defn
            %h6#definition_16 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Z
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g \colon Y \to Z
              be two
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of smooth sets, def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Z
                    %mi Y
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    X \times_Z Y \in SmoothSet
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              understood), called the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            %p
              the set of
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Z
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times_Z Y
              is the set of pairs of plots of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              which become the same plot of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo ×
                      %mi Z
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi X
                      %mo ∈
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi p
                        %mi Y
                      %mo ∈
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi f
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi g
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X \times_Z Y)(\mathbb{R}^n)
                    \=
                    \\left\{
                    (p_X \in X(\mathbb{R}^n), p_Y \in Y(\mathbb{R}^n))
                    \\; |\;
                    f_{\mathbb{R}^n}(p_X) = g_{\mathbb{R}^n}(p_Y)
                    \\right\}
                    \\,.
          %h3#SmoothMappingSpaces Smooth mapping spaces and smooth moduli spaces
          #SmoothFunctionSpace.num_defn
            %h6#definition_17 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} \Sigma, X \in SmoothSet
              be two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothSpace"}
              %strong
                smooth
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    [\Sigma,X] \in SmoothSet
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              defined by saying that its set of
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Sigma, X](\mathbb{R}^n)
                    \\coloneqq
                    Hom(\Sigma \times \mathbb{R}^n, X)
                    \\,.
          %p
            Here in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Sigma \times \mathbb{R}^n
            we first regard the abstract coordinate system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            as a smooth set by example
            %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
            and then we form the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            smooth set by def.
            = succeed "." do
              %a.maruku-ref{:href => "#ProductOfSmoothSpaces"}
          #NatureOfPlotsOfMappingSpace.num_remark
            %h6#remark_12 Remark
            %p
              This means in words that a
              = succeed "-plot" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is a smooth
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %em family
              of homomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
          #UniversalPropertyOfMappingSpace.num_prop
            %h6#proposition_8 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ×
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(K, [\Sigma, X])
                    \\simeq
                    Hom(K \times \Sigma, X)
            %p
              for every smooth set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .proof
            %h6#proof_3 Proof
            %p
              With a bit of work this is straightforward to check explicitly by unwinding the definitions. It follows however from
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} general abstract
              results once we realize that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              is of course the
              %em
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of smooth sets. This we come to below in
              = succeed "." do
                %em
                  %a{:href => "#SmoothSpacesLayerSem"} Smooth sets - Semantic Layer
          #MappingSpaceAsModuliSpace.num_remark
            %h6#remark_13 Remark
            %p
              This says in words that a smooth function from any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              into the mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is equivalently a smooth function from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} K \times \Sigma
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                \-parameterized smooth family
              of smooth functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
              %a.maruku-ref{:href => "#NatureOfPlotsOfMappingSpace"}
              this says that smooth mapping spaces have a
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              not just over abstract coordinate systems, but over all smooth sets.
            %p
              We will therefore also say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is the
              %strong
                smooth
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              of smooth functions from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K \to [\Sigma,X]
              into it
              = succeed "," do
                %em modulate
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma\to X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          %p
            First interesting examples of such smooth moduli spaces are discussed in
            %em
              %a{:href => "#DifferentialFormsLayerMod"} Differential forms – Model Layer
            below. Many more interesting examples follow once we pass from smooth 0-types to smooth
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %em
                %a{:href => "#SmoothnGroupoids"} Smooth n-groupoids
          %p
            We will see many more examples of smooth moduli spaces, starting below in
            = succeed "." do
              %em
                %a{:href => "#DifferentialFormsLayerMod"} Differential forms - Model Layer
          #UnderlyingSetOfSmoothMappingSpace.num_prop
            %h6#proposition_9 Proposition
            %p
              The set of points, def.
              = succeed "," do
                %a.maruku-ref{:href => "#PointsOfASmoothSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is the bare set of homomorphism
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(*, [\Sigma, X]) \simeq Hom(\Sigma, X)
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              Combine prop.
              %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
              with prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ProductOfSmoothSpaceWithThePoint"}
          #SmoothPathSpace.num_example
            %h6#example_7 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SmoothSet
                    %annotation{:encoding => "application/x-tex"} X \in SmoothSet
              %strong
                %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              is the smooth mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mi X
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{P}X \coloneqq [\mathbb{R}^1, X]
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#UnderlyingSetOfSmoothMappingSpace"}
              the points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P X
              are indeed precisely the smooth trajectories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^1 \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P X
              also knows how to
              %em smoothly vary
              such smooth trajectories.
            %p
              This is central for
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              which determines
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              = succeed "." do
                %em
                  %a{:href => "#VariationalCalculus"} Variational calculus
          .num_remark
            %h6#remark_14 Remark
            %p
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a model for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P X
              may notably be interpreted as the smooth set of
              %a.existingWikiWord{:href => "/nlab/show/worldlines"} worldlines
              %em in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em trajectories
              of a
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #SmoothLoopSpace.num_example
            %h6#example_8 Example
            %p
              If in the above example
              %a.maruku-ref{:href => "#SmoothPathSpace"}
              the path is constraind to be a
              %a.existingWikiWord{:href => "/nlab/show/loop"} loop
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi X
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}X \coloneqq [S^1, X]
                    \\,.
          %p
            In example
            %a.maruku-ref{:href => "#SmoothFunctionOnSmoothSpace"}
            we saw that a smooth function on a general
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a homomorphism of smooth sets, def.
            %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f \colon X \to \mathbb{R}
                  \\,.
          %p
            The collection of these forms the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SmoothSet
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{SmoothSet}(X, \mathbb{R})
            %em
              %a{:href => "#SmoothMappingSpaces"} Smooth mapping spaces
            such hom-sets are naturally refined to smooth sets themselves.
          #SmoothSpaceOfSmoothFunctions.num_defn
            %h6#definition_18 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SmoothSet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %strong moduli space of smooth functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the smooth mapping space (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmoothFunctionSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into the standard
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi SmoothSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X, \mathbb{R}] \in SmoothSet
                    \\,.
            %p We will also denote this by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{C}^\infty(X) \coloneqq [X, \mathbb{R}]
                    \\,,
            %p
              since in the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              this is the smooth refinement of the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_remark
            %h6#remark_15 Remark
            %p
              We call this a
              %em
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              because by prop.
              %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
              above and in the sense of remark
              %a.maruku-ref{:href => "#MappingSpaceAsModuliSpace"}
              it is such that smooth functions into it
              %em modulate
              smooth functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} X \to \mathbb{R}
            %p
              By prop.
              %a.maruku-ref{:href => "#UnderlyingSetOfSmoothMappingSpace"}
              a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} * \to [X,\mathbb{R}^1]
              of the moduli space is equivalently a smooth function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X \to \mathbb{R}^1
          %h3#SmoothSpacesLayerSem The cohesive topos of smooth sets
          %p
            In the language of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+categories+and+toposes"} categories and toposes
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            by saying that they form the
            %em
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            over the
            %em
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            of
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            (Prop.
            %a.maruku-ref{:href => "#SmoothSetsAreSheavesOnCartSp"}
            below).
          %p
            This perspective allows to see good abstract properties enjoyed by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            which they form is a
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            (Prop.
            %a.maruku-ref{:href => "#SmoothSetsFormACohesiveTopos"}
            below).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #SmoothSetsAreSheavesOnCartSp.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                between
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                and
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#EquivalenceOfCategories"}> this def.
              ) between the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %em
                %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfSmoothSets"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Sheaf"}> this def.
              ) on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              (
              %a{:href => "geometry+of+physics+--+coordinate+systems#CartSpCategory"}> this def.
              ) equipped with the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Coverage"}> this def.
              ) of differentiably
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSet
                    \\;\simeq\;
                    Sh(CartSp)
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p This is a straightforward matter of matching definitions. We spell it out:
            %ul
              %li
                %p
                  A
                  = succeed "," do
                    %em pre-smooth set
                  %a.maruku-ref{:href => "#SmoothPreSpace"}
                  is equivalently a
                  %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                  (
                  %a{:href => "geometry+of+physics+--+Categories+and+Toposes#CategoryOfPresheaves"}> this Example
                  ) on
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                  (
                  %a{:href => "geometry+of+physics+--+coordinate+systems#CartSpCategory"}> this prop.
                  ), hence a
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  (
                  %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Functors"}> this def.
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo :
                        %msup
                          %mi CartSp
                          %mi op
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} X : CartSp^{op} \to Set
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                  (
                  %a{:href => "geometry+of+physics+--+Categories+and+Toposes#CategoryOfSets"}> this Example
                  );
              %li
                %p
                  a
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
                  = succeed "," do
                    %a.maruku-ref{:href => "#SmoothSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                  (
                  %a{:href => "geometry+of+physics+--+coordinate+systems#CartSpCategory"}> this prop.
                  ) which is a
                  %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                  (
                  %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Sheaf"}> this def.
                  ) with respect to the
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                  (
                  %a{:href => "geometry+of+physics+--+Categories+and+Toposes#Coverage"}> this def.
                  ) of differentially
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#DifferentiallyGoodOpenCover"}
                %ul
                  %li
                    %p
                      the set of “glued plots” (def.
                      = succeed ")" do
                        %a.maruku-ref{:href => "#MatchingFamiliesOfPlots"}
                      %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                      (
                      %a{:href => "geometry+of+physics+--+Categories+and+Toposes#CompatibleElements"}> this def.
                      )
                  %li
                    %p
                      the comparison morphism from global plots to glued plots of remark
                      %a.maruku-ref{:href => "#NaiveDescentMorphism"}
                      is the comparison map from to
                      %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                      (
                      %a{:href => "geometry+of+physics+--+categories+and+toposes#eq:SheafComparison"}> here
                      );
                  %li
                    %p
                      the condition
                      %a.maruku-eqref{:href => "#eq:ConditionSmoothSet"} (2)
                      that this be a
                      %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                      is the
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
                      (
                      %a{:href => "geometry+of+physics+--+Categories+and+Toposes#eq:SheafCondition"}> here
                      ).
          #EquivalentSitesForCartSp.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong
                (equivalent
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p
              Consider the canonical
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi EuclOp
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi SmthMfd
                  %annotation{:encoding => "application/x-tex"}
                    CartSp
                    \\overset{\phantom{AAA}}{\hookrightarrow}
                    EuclOp
                    \\overset{\phantom{AAA}}{\hookrightarrow}
                    SmthMfd
            %p
              which regard, in turn, a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartSpCategory"}
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of itself, and regard every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SiteOfSmoothManifolds"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (
              %a{:href => "differentiable+manifold#DifferentiableManifoldCartesianSpace"}> this Example
              [this Example] and (differentiable+manifold#OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds)).
            %p
              Then the induced pre-composition functors induce
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#EquivalenceOfCategories"}> this Def.
              ) between the corresponding
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi EuclOp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SmthMfd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSet
                    \\;\simeq\;
                    Sh(CartSp)
                    \\;\simeq\;
                    Sh(EuclOp)
                    \\;\simeq\;
                    Sh(SmthMfd)
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#CompletingGoodOpenCoversToAllOpenCovers"}
              we may identify
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi CartSp
                        %mtext good open cov
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(CartSp) = Sh(CartSp_{\text{good open cov}})
              = succeed "-inclusions" do
                %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#DenseSubsite"} this Def.
              %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"} comparison lemma
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#ComparisonLemma"}> this prop.
              ).
          %p As a corollary we obtain:
          #InclusionOfSmoothManifoldsIntoSmoothSets.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
                inside
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %p
              Regarding
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              as
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              via Example
              %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              yields a
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothManifold
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi AA
                        %mi ι
                        %mphantom
                          %mi AA
                    %mi SmoothSet
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    SmoothManifold
                    \\overset{\phantom{AA}\iota\phantom{AA}}{\hookrightarrow}
                    SmoothSet
                    \\,,
            %p
              meaning that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi SmoothManifold
                  %annotation{:encoding => "application/x-tex"} X, Y \in SmoothManifold
              any two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              regarded in the sense of smooth manifolds, and regarded in the sense of
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SmoothManifold
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi SmoothSet
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SmoothManifold}(X,Y)
                    \\;\simeq\;
                    Hom_{SmoothSet}(\iota(X), \iota(Y))
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#EquivalentSitesForCartSp"}
              we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SmoothManifold
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSet
                    \\;\simeq\;
                    Sh(SmoothManifold)
                    \\,.
            %p
              With this the statement is given by the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#YonedaLemma"}> this prop.
              ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #SmoothSetsFormACohesiveTopos.num_prop
            %h6#proposition_13 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                form a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheDifferentiallyGoodOpenCoverCoverage"}
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#OneCohesiveSite"}> this Def.
              ), hence its
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              (by
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#CategoriesOfSheavesOnCohesiveSiteIsCohesive"} this Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothSetsAreSheavesOnCartSp"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfSmoothSets"}
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#CohesiveTopos"}> this Def.
              ):
            #eq:SheafToposAdjointQuadruple.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %msub
                                  %mi Π
                                  %mn 0
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi Disc
                                %mphantom
                                  %mi AA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Γ
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi coDisc
                                %mphantom
                                  %mi AA
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSet
                    \\array{
                    \\overset{\phantom{AAA} \Pi_0 \phantom{AAA}}{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} Disc \phantom{AA} }{\longleftarrow}
                    \\\
                    \\overset{\phantom{AAA} \Gamma \phantom{AAA} }{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} coDisc \phantom{AA} }{\longleftarrow}
                    }
                    Set
            %p
              Moreover, this cohesive topos satisfies the following equivalent conditions (from
              = succeed "):" do
                %a{:href => "geometry+of+physics+-+cohesive+toposes#PiecesHavePoints"} this Prop.
            %ol
              %li
                %p
                  %em>
                    %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
                  ,
              %li
                %p
                  %em>
                    %a.existingWikiWord{:href => "/nlab/show/discrete+objects+are+concrete"} discrete objects are concrete
                  \.
          .proof
            %h6#proof_8 Proof
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              clearly has
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo =
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\ast = \mathbb{R}^0
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of two
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              is the Cartesian space whose
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              is the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the two separate dimensions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
