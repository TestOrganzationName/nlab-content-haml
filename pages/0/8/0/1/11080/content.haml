                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi ℝ
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{\Omega}^0(X)
                    \&amp; \coloneqq Conc [X, \Omega^0]
                    \\\
                    \&amp; \simeq Conc [X, \mathbb{R}]
                    \\\
                    \&amp; \simeq [X, \mathbb{R}]
                    \\end{aligned}
                    \\,,
            %p
              by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SpaceOf0FormsIsRealLine"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#integration_and_transgression Integration and transgression
          %p
            The traditional concept of
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            over a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            applies in smooth families of differential forms and hence constitutes in fact a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            from the
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on the given manifold, this is Def.
            %a.maruku-ref{:href => "#ParameterizedIntegrationOfDifferentialForms"}
            below.
          %p
            Using this,
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
            may be defined as the application of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            to the
            %a.existingWikiWord{:href => "/nlab/show/modulating+morphisms"} modulating morphisms
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            and applying
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            to the result (Def.
            %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpaces"}
            below). This simple construction turns out to be equivalent to the traditional definition (Prop.
            %a.maruku-ref{:href => "#EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces"}
            below).
          #ParameterizedIntegrationOfDifferentialForms.num_defn
            %h6#definition_29 Definition
            %p
              %strong
                (parameterized
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
                  via Example
                  = succeed "." do
                    %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Σ
                      %mi k
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma_k, \mathbf{\Omega}^n]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothFunctionSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Sigma_k
              into the universal
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^n
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#SmoothModuliSpaceOfnForms"}
            %p Then we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Σ
                      %mi k
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma}
                    \\;\colon\;
                    [\Sigma_k, \mathbf{\Omega}^n]
                    \\longrightarrow
                    \\mathbf{\Omega}^{n-k}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \omega_{(-)} \colon U \to [\Sigma, \mathbf{\Omega}^k]
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_{(-)}(-)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} U \times \Sigma
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma} \omega_{(-)}(-) \coloneqq \int_\Sigma \omega_{(-)}
                    \\,.
          #TransgressionOfDifferentialFormsToMappingSpaces.num_defn
            %h6#definition_30 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
                  via Example
                  = succeed "." do
                    %a.maruku-ref{:href => "#CartesianSpaceAsSmoothSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Σ
                      %mi k
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma_k, \mathbf{\Omega}^n]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothFunctionSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Sigma_k
              into the universal
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^n
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#SmoothModuliSpaceOfnForms"}
            %p
              Then the operation of
              %em
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+n-forms"} transgression of differential n-forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Sigma_k
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma
                    \\;\coloneqq\;
                    \\int_\Sigma [\Sigma,-]
                    \\;\colon\;
                    \\Omega^n(X) \to \Omega^{n-k}([\Sigma,X])
            %p
              from
              %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Σ
                      %mi k
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma_k,X]
              spring which takes the differential form corresponding to the smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mi ω
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \stackrel{\omega}{\to} \Omega^n) \in \Omega^n(X)
            %p to the differential form corresponding to the following composite smooth function:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mi ω
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mo ,
                        %mi ω
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∫
                          %mi Σ
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma \omega
                    \\coloneqq
                    \\int_{\Sigma} [\Sigma,\omega]
                    \\;\colon\;
                    [\Sigma, X]
                    \\stackrel{[\Sigma, \omega]}{\longrightarrow}
                    [\Sigma, \Omega^n]
                    \\stackrel{\int_{\Sigma}}{\longrightarrow}
                    \\Omega^{n-k}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,\omega]
              is the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \int_{\Sigma}
              is the parameterized integration of differential forms from def.
              = succeed "." do
                %a.maruku-ref{:href => "#ParameterizedIntegrationOfDifferentialForms"}
            %p More explicitly in terms of plots this means equivalently the following
            %p
              A plot of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{(-)} \;\colon\; U \to [\Sigma, X]
            %p
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
