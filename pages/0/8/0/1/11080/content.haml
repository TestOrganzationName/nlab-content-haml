          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#CoordinateSystemsLayerMod"} Abstract coordinate systems
              %ul
                %li
                  %a{:href => "#TheContinuumRealWorldLine"} The continuum real line
                %li
                  %a{:href => "#CartesianSpaces"} Cartesian spaces and smooth functions
                %li
                  %a{:href => "#PropertiesOfSmoothFunctions"} The magic properties of smooth functions
                %li
