                        %annotation{:encoding => "application/x-tex"} \phi\vert_{U_i} \in \mathbf{X}(U_i)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
