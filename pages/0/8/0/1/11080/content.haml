                    \\big\downarrow \big\uparrow \big\downarrow
                    \\\
                    \\underset{i}{\coprod}
                    Hom_{CartSp}( \ast, U_i )
                    }
                    \\right)
                    \\end{aligned}
                    \\,.
            %p
              Here we used that
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (here
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              are computed objectwise, and then the definition of the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            %p
              But the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              induced by this graph on its set of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi Hom
                      %mi CartSp
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{i}{\coprod}  Hom_{CartSp}( \ast, U_i )
              precisely identifies pairs of points, one in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              the other in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              being covered. Hence the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              is the set of points of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %munder
                      %mi lim
                      %munder
                        %mo ⟵
                        %mrow
                          %msup
                            %mi CartSp
                            %mi op
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi CartSp
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0
                    \\underset{\underset{CartSp^{op}}{\longleftarrow}}{\lim}
                    C(\{U_i\}_i)
                    \\;\simeq\;
                    Hom_{CartSp}(\ast, \mathbb{R}^n)
                    \\,.
            %p
              Finally to see that
              %em
                %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/discrete+objects+are+concrete"} discrete objects are concrete
              is satisfied, it is sufficient to observe, by
              %a{:href => "geometry+of+physics+-+cohesive+toposes#CohesiveSiteSuchThatDiscreteObjectsAreConcrete"} this prop.
              that for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi CartSp
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{CartSp}(\ast, \mathbb{R}^n)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
          %p
            The following statement is a
            %a.existingWikiWord{:href => "/nlab/show/0-truncated+object"} 0-truncated
            shadow of the
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometric
            analog of the concept of
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-localization
          #ShapeModalityOnSmoothSetsIsR1Localization.num_prop
            %h6#proposition_14 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                on
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                is
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} localization
            %p
              The
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              %a.maruku-ref{:href => "#SmoothSetsFormACohesiveTopos"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi A
                          %mi Disc
                          %mphantom
                            %mi A
                      %mover
                        %mo ⟵
                        %mi Π
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    Set
                    \\underoverset
                    {\underset{ \phantom{A}Disc\phantom{A} }{\hookrightarrow}}
                    {\overset{\Pi}{\longleftarrow}}
                    {\bot}
                    SmoothSet
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              as the
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              %em
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
                on
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#LocalizationAtACollectionOfMorphisms"}> this Def.
              ) for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/localization+at+an+object"} localization at an object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi L
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi \;\simeq\; L_{\mathbb{R}^1}
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              Since we already know that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              exists, we need to show that the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mover
                      %mo ↪
                      %mi Disc
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} Set \overset{Disc}{\hookrightarrow} SmoothSet
              is equivalently that of
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (
              %a{:href => "geometry+of+physics+–+basic+notions+of+category+theory#LocalObjects"}> this Def.
              ) with respect to the class of morphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \times \mathbb{R}^1 \overset{ p_1 }{\longrightarrow} X
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SmoothSet
                    %annotation{:encoding => "application/x-tex"} SmoothSet
            %p
              We claim that a
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              with respect to this class, already if it is a local object with respect to just the
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
            #eq:RnTimesR1Projections.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ×
                        %msup
                          %mi ℝ
                          %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                        %msup
                          %mi ℝ
                          %mi n
                        %mo }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n \times \mathbb{R}^1
                    \\overset{p_1}{\longrightarrow}
                    \\mathbb{R}^n
                    \\right\}_{n \in \mathbb{N}}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %p
              To see this, we identify
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SmoothSet \simeq Sh(CartSp)
              via Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#EquivalentSitesForCartSp"}
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#TopologicalCoYonedaLemma"}> this Prop.
              ) to express any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SmoothSet
              as a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %msup
                        %mo ∫
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ∈
                          %mi Cartsp
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ⋅
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \simeq \int^{\mathbb{R}^n \in Cartsp} \mathbb{R}^n \cdot X(\mathbb{R}^n)
            %p
              Assuming then that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is local with respect to the
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              %a.maruku-eqref{:href => "#eq:RnTimesR1Projections"} (7)
              we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi SmoothSet
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi X
                            %mo ×
                            %msup
                              %mi ℝ
                              %mn 1
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                            %mi X
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thickmathspace"}
                            %mi A
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                                %mo ∈
                                %mi CartSp
                            %msub
                              %mi Hom
                              %mi Set
                            %mrow
                              %mo (
                              %mi X
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %munder
                                %munder
                                  %mrow
                                    %msub
                                      %mi Hom
                                      %mi SmoothSet
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %msup
                                      %mi ℝ
                                      %mi n
                                    %mo ×
                                    %msup
                                      %mi ℝ
                                      %mn 1
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi p
                                          %mn 1
                                    %msup
                                      %mi ℝ
                                      %mi n
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thinmathspace"}
                                    %mo ,
                                    %mspace{:width => "thickmathspace"}
                                    %mi A
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mo ⏟
                                %mtext bijection
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{SmoothSet}\big(
                    X \times \mathbb{R}^1 \overset{p_1}{\to} X
                    \\;\,,\;
                    A
                    \\big)
                    \&amp; \simeq
                    \\int_{\mathbb{R}^n \in CartSp}
                    Hom_{Set}\left( X(\mathbb{R}^n),
                    \\,
                    \\underset{\text{bijection}}{
                    \\underbrace{
                    Hom_{SmoothSet}\big(
                    \\mathbb{R}^n \times \mathbb{R}^1 \overset{p_1}{\to} \mathbb{R}^n
                    \\;\,,\;
                    A
                    \\big)
                    }}
                    \\right)
                    \\end{aligned}
            %p where we used that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} (-) \times \mathbb{R}^1
                  preserves
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#PropertiesOfSheafToposes"}> this Prop.
                  ) and since
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} left adjoints preserve colimits
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#AdjointsPreserveCoLimits"}> this Prop.
                  ),
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} hom-functor preserves limits
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#HomFunctorPreservesLimits"}> this Prop.
                  ), hence sends colimits in the first argument to limits.
            %p
              But on the right this is now a morphisms of
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              induced by morphism of
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              which is objectwise an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              Hence we are reduced to showing that the
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              with respect to
              %a.maruku-eqref{:href => "#eq:RnTimesR1Projections"} (7)
              are the discrete smooth sets. But by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.maruku-eqref{:href => "#eq:RnTimesR1Projections"} (7)
              means equivalently locality with respect to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mi ℝ
                        %mi n
                      %mover
                        %mo →
                        %mrow
                          %mo ∃
                          %mo !
                      %msup
                        %mi ℝ
                        %mn 0
                      %mo =
                      %mo *
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n \overset{\exists !}{\to} \mathbb{R}^0 = \ast
                    \\right\}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              with respect to this set are manifestly exactly the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/constant+presheaves"} constant presheaves
              %a.maruku-ref{:href => "#SmoothSetsFormACohesiveTopos"}
              (proceeding via the proof of
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#CategoriesOfSheavesOnCohesiveSiteIsCohesive"} this Prop.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mover
                        %mo ↪
                        %mi Disc
                      %mi SmoothSet
                    %annotation{:encoding => "application/x-tex"} Set \overset{Disc}{\hookrightarrow} SmoothSet
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#concrete_smooth_sets_diffeological_spaces Concrete smooth sets: Diffeological spaces
          %p
            The cohesiveness of smooth sets (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SmoothSetsFormACohesiveTopos"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/concrete+objects"} concrete objects
            among the smooth sets (
            %a{:href => "geometry+of+physics+--+categories+and+toposes#CohesiveModalities"}> this Def.
            ). We show here (Prop.
            %a.maruku-ref{:href => "#DiffeologicalSpacesAreTheConcreteSmoothSets"}
            below) that these concrete smooth sets are
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to a kind of
            %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+spaces"} generalized smooth spaces
            that are known as
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chen+smooth+spaces"} Chen smooth spaces
            (
            %a{:href => "diffeological+space#Chen77"}> Chen 77
            ) or
            %em
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            (
            %a{:href => "diffeological+space#Souriau79"}> Souriau 79
            ,
            = succeed ")," do
              %a{:href => "diffeological+space#IglesiasZemmour85"} Iglesias-Zemmour 85
            %a.maruku-ref{:href => "#DiffeologicalSpace"}
            below.
          %p
            A comprehensive development of
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            is spelled out in (
            %a{:href => "diffeological+space#PIZ"}> Iglesias-Zemmour 13
            ).
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/concrete+objects"} concrete objects
            in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            among all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            (
            %a{:href => "geometry+of+physics+--+categories+and+toposes#QuasitoposOfConcreteObjects"}> This prop.
            ), every smooth set has a
            %em
              %a.existingWikiWord{:href => "/nlab/show/concretification"} concretification
            to a concrete smooth set, hence to a diffeological space. An important example of this construction are
            %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            %a.maruku-ref{:href => "#SmoothSpaceOfFormsOnSmoothSpace"}
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
