                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 3
                      %annotation{:encoding => "application/x-tex"} f_2 \colon \mathbb{R}^{n_2} \to \mathbb{R}^{n_3}
                  is the same as changing them along the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                  coordinate transformation
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                          %mo ∘
                          %msub
                            %mi f
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} f_2 \circ f_1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
