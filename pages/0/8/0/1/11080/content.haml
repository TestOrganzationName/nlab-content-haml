                  %mrow
                    %mi DiffeologicalSpace
                  %annotation{:encoding => "application/x-tex"} DiffeologicalSpace
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Categories"}> this def.
              ) whose
