                      %a{:href => "/nlab/edit/foundations+-+contents"} Edit this sidebar
          %h1#paraconsistent_logic Paraconsistent logic
          .maruku_toc
            %ul
              %li
                %a{:href => "#overview"} Overview
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#AristotelianSyllogistic"} Aristotelian syllogistic
                %li
                  %a{:href => "#minimal_logic"} Minimal logic
                %li
                  %a{:href => "#dual_intuitionistic_logic"} Dual intuitionistic logic
                %li
                  %a{:href => "#linear_logic"} Linear logic
                %li
                  %a{:href => "#relevance_logics"} Relevance logics
                %li
                  %a{:href => "#other_paraconsistent_logics"} Other paraconsistent logics
              %li
                %a{:href => "#applications"} Applications
              %ul
                %li
                  %a{:href => "#paraconsistent_set_theory"} Paraconsistent set theory
              %li
                %a{:href => "#see_also"} See also
              %li
                %a{:href => "#links"} Links
          %h2#overview Overview
          %p
            A
            %strong paraconsistent logic
            is a
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            in which it can happen that a
            %a.existingWikiWord{:href => "/nlab/show/contradiction"} contradiction
            is true, in the sense that both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} \neg A
            hold for some
            %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %em trivial
            in the sense that
            %em all
            propositions are true. Put differently, a paraconsistent logic is one in which the schema
            = succeed ":" do
              %em ex contradictione quodlibet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo ¬
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"} A,\, \neg{A} \;\vdash\; B
          %p
            (for all formulas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed ":" do
              %strong explosive
          %p
            Two related schemata are
            = succeed ":" do
              %em ex falso quodlibet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"} \bot\; \vdash\; B
          %p
            and the
            %em
              %a.existingWikiWord{:href => "/nlab/show/law+of+non-contradiction"} law of non-contradiction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo ¬
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo ⊥
                  %mo .
                %annotation{:encoding => "application/x-tex"} A,\, \neg{A} \;\vdash\; \bot.
          %p Either of these may hold in a paraconsistent logic, but of course (assuming transitivity of entailment) not both.
          %p
            Another pair of schemata which cannot both hold in a paraconsistent logic are
            %em additivity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo ∨
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \;\vdash\; A \vee B
          %p
            and the
            = succeed ":" do
              %em disjunctive syllogism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo ∨
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mo .
                %annotation{:encoding => "application/x-tex"} \neg A ,\, A \vee B \;\vdash\; B.
          %p
            The fact that the two of these together imply
            %em ex contradictione quodlibet
            is known the
            = succeed "." do
              %em Lewis independent argument
          %h2#examples Examples
          %p Here we survey some paraconsistent logics. In-depth development of particular paraconsistent logics should be done on separate individual pages.
          %h3#AristotelianSyllogistic Aristotelian syllogistic
          %p
            Paraconsistent logic may seem bizarre to a modern mathematician, but the universal adoption of
            %em ex contradictione quodlibet
            is actually quite recent, dating roughly to the invention in the 19th century of what is now called (clearly inappropriately)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
          %p
            One of the oldest formalizations of logic is Aristotelian syllogistic, which is not as expressive as modern predicate logic, but could be regarded as paraconsistent. A syllogistic analogue of
            %em ex contradictione quodlibet
            would be a “syllogism” such as
          %ul
            %li All men are mortal.
            %li Some men are not mortal.
            %li Therefore, some pigs can fly.
          %p But this is not one of the valid forms of syllogism.
          %h3#minimal_logic Minimal logic
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/minimal+logic"} minimal logic
            %em ex falso quodlibet
            from any of the usual presentations of intuitionistic logic. The law of non-contradiction remains valid. Minimal logic satisfies the law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo ¬
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo ¬
                  %mi B
                %annotation{:encoding => "application/x-tex"} A,\, \neg A \;\vdash\; \neg B
          %p
            for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %em ex contradictione quodlibet
          %h3#dual_intuitionistic_logic Dual intuitionistic logic
          %p
            In a certain sense,
            %em ex contradictione quodlibet
            is “dual” to the law of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∧
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \wedge \neg A
            is the least truth value (it implies everything else), while the latter asserts that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} A\vee \neg A
            is the greatest truth value (namely “true”).
          %p
            In particular, just as
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            is classical logic without LEM (but with ECQ), the
            %em formal dual of intuitionistic logic
            satisfies LEM but not ECQ. Specifically, here is the law of non-contradiction which fails:
            %em ex falso quodlibet
            is still valid because it is the dual of the intuitionistically valid sequent
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊢
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} A \vdash \top
          %p
            Dual intuitionistic logic may be presented as a
            %a.existingWikiWord{:href => "/nlab/show/sequent+calculus"} sequent calculus
            with the restriction that the left-hand side of any sequent has at most one formula. It can be modeled by the
            %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
            of any topological space, in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                %annotation{:encoding => "application/x-tex"} \vee
            are intersection and union, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            is the closure of the complement. Thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \vee \neg A
            holds because
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∪
                    %mover
                      %mrow
                        %mi X
                        %mo ∖
                        %mi A
                      %mo ¯
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \cup \overline{X\setminus A} = X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∩
                  %mover
                    %mrow
                      %mi X
                      %mo ∖
                      %mi A
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} A\cap \overline{X\setminus A}
            need not be empty (it is one definition of the
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h3#linear_logic Linear logic
          %p
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} Linear logic
            is also paraconsistent, although the analysis becomes complicated because connectives such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                %annotation{:encoding => "application/x-tex"} \vee
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
          %ul
            %li
              %p
                %em Ex falso quodlibet
                holds for the positive false,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ⊢
                        %mi B
                      %annotation{:encoding => "application/x-tex"} 0\vdash B
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} \bot
            %li
              %p
                The law of non-contradiction holds for the negative false,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo ¬
                        %mi A
                        %mspace{:width => "thickmathspace"}
                        %mo ⊢
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} A,\, \neg A \;\vdash\; \bot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \neg A
                is equivalent to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊸
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} A\multimap \bot
                %a.existingWikiWord{:href => "/nlab/show/modus+ponens"} modus ponens
                for the linear implication. However, LNC fails for the positive false.
            %li
              %p
                The additivity property holds for the positive disjunction,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊢
                        %mi A
                        %mo ⊕
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \vdash A\oplus B
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⅋
                      %annotation{:encoding => "application/x-tex"} \parr
            %li
              %p
                The disjunctive syllogism holds for the negative disjunction,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mi A
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi A
                        %mo ⅋
                        %mi B
                        %mspace{:width => "thickmathspace"}
                        %mo ⊢
                        %mspace{:width => "thickmathspace"}
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \neg A,\, A \parr B \;\vdash\; B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi A
                      %mo ⅋
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \neg A \parr B
                is equivalent to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊸
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A\multimap B
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊕
                      %annotation{:encoding => "application/x-tex"} \oplus
          %p
            Thus, both ways to deduce
            %em ex contradictione quodlibet
            founder precisely on the finer analysis of connectives provided by linearity. From a linear point of view, one could say that
            %em ex contradictione quodlibet
            arises from a failure to appreciate that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊕
                %annotation{:encoding => "application/x-tex"} \oplus
            is different from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⅋
                  %annotation{:encoding => "application/x-tex"} \parr
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is different from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
          %p
            Note that linear logic does include an alternative negation which
            %em is
            explosive, namely
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊸
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A\multimap 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi A
                  %mo =
                  %mi A
                  %mo ⊸
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \neg A = A\multimap\bot
            is involutive,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                    %mi A
                    %mo ⊣
                    %mo ⊢
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \neg \neg A \dashv\vdash A
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            for the negative disjunction,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊢
                    %mi A
                    %mo ⅋
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \vdash A \parr \neg A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊸
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A\multimap 0
          %p
            Also worth noting is that
            %em ex contradictione quodlibet
            can alternatively be stated in terms of a conjuction as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∧
                    %mo ¬
                    %mi A
                    %mo ⊢
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \wedge \neg A \vdash B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            is positive or negative. The comma separating multiple formulas in a linear sequent is equivalent to a positive conjunction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi &amp;
                  %annotation{:encoding => "application/x-tex"} \&amp;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mi &amp;
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A\&amp; (A\multimap 0)
            doesn’t entail
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊸
                  %mn 0
                %annotation{:encoding => "application/x-tex"} A\multimap 0
            but not both.
          %h3#relevance_logics Relevance logics
          %p
            One goal of
            %a.existingWikiWord{:href => "/nlab/show/relevance+logic"} relevance logic
            is to ensure that no sequent can be valid unless the hypothesis and conclusion have a variable in common. Thus,
            %em ex contradictione quodlibet
            is invalid in general, but special cases such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mo ¬
                  %mi p
                  %mo ⊢
                  %mi p
                %annotation{:encoding => "application/x-tex"} p, \neg{p} \vdash p
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∧
                  %mi q
                  %mo ,
                  %mo ¬
                  %mrow
                    %mi p
                    %mo ∧
                    %mi q
                  %mo ⊢
                  %mi p
                  %mo ∨
                  %mi r
                %annotation{:encoding => "application/x-tex"} p \wedge q, \neg{p \wedge q} \vdash p \vee r
            are valid. Many relevance logics turn out to also be paraconsistent (although this is not a proof).
          %h3#other_paraconsistent_logics Other paraconsistent logics
          %p (There are many other paraconsistent logics one could discuss…)
          %h2#applications Applications
          %h3#paraconsistent_set_theory Paraconsistent set theory
          %p
            One potential application of paraconsistent logic would be to give a
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            in which the
            %a.existingWikiWord{:href => "/nlab/show/unrestricted+comprehension+rule"} unrestricted comprehension rule
            is valid, but which is nontrivial. For instance, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo ∉
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} R = \{ x \mid x\notin x \}
            is the set from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Russell%27s+paradox"} Russell's paradox
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} R\in R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∉
                  %mi R
                %annotation{:encoding => "application/x-tex"} R\notin R
            without trivializing.
          %p
            It should be noted, however, that not all paraconsistent logics remain nontrivial in the presence of full comprehension. If the
            %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction rule
            is permitted (as it is in many
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relevance+logics"} relevance logics
            %a.existingWikiWord{:href => "/nlab/show/Curry%27s+paradox"} Curry's paradox
            in the following form. For any statement
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} C = \{ x \mid (x\in x) \to P \}
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C\in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} (C\in C)\to P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} C\in C
            again, by contraction) we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} (C\in C) \to P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C\in C
            %a.existingWikiWord{:href => "/nlab/show/modus+ponens"} modus ponens
            we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
