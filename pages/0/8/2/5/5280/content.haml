                (eds.),
                = succeed "," do
                  %em Gesammelte mathematische Werke
                %a{:href => "http://gdz.sub.uni-goettingen.de/dms/load/img/?PPN=PPN23569441X"} Göttinger Digitalisierungszentrum
            %li
              %p
