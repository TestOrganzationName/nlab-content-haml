            in
            %a.existingWikiWord{:href => "/nlab/show/VectorSpaces"} VectorSpaces
            — namely of
            %em
              %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
