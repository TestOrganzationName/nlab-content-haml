          %p
            In fact, the induced joint
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on this functor are compatible to jointly make the quantum reader be a
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
          %p
            An organized way to see this
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on the quantum reader monad over a finite parameter set is to observe (which is a straightforward inspection, but we spell it out
            = succeed ")" do
              %a{:href => "#Details"} below
            = succeed "-reader" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
