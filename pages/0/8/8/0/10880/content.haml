          %p
            (The other specialization of the
            %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo ≃
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_\ast \simeq f_!
            is called the
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+context"} Grothendieck context
          %p
            Often one is interested in the case that there is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} C \in \mathcal{X}
            and an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %msub
                    %mn 1
                    %mi X
                  %mo ≃
                  %msub
                    %mi f
                    %mo !
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f_\ast 1_{X} \simeq f_! C
                  \\,.
          %p
            If this induces a
            %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi A
                  %mo ≃
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ⊗
                    %mi X
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f_\ast A  \simeq f_!(A \otimes_X C)
          %p
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{X}
            = succeed "," do
              %em Wirthmüller isomorphism
            = succeed ")." do
              %a{:href => "#Wirthmueller74"} Wirthmueller 74
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi A
                  %mo ⟶
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ⊗
                    %mi X
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f_\ast A  \longrightarrow f_!(A \otimes_X C)
          %p
            and one can ask this to be an equivalence, hence a Wirthmüller isomorphism (
            %a{:href => "#May05"}> May 05
            ).
          %h2#definition Definition
          #WirthmullerContext.num_defn
            %h6#definition_2 Definition
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒳
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi X
                      %mo ,
                      %msub
                        %mn 1
                        %mi X
                      %mo{:stretchy => "false"} )
