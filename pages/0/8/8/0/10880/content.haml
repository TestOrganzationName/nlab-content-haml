                      %annotation{:encoding => "application/x-tex"} f^\ast
                  is a
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              %li
                %p
                  a
                  %em Wirthmüller context
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
