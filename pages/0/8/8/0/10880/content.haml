          %h2#idea Idea
          %p
            A
            %em Wirthmüller context
            is a pair of two
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi X
                    %mo ,
                    %msub
                      %mn 1
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{X}, \otimes_X, 1_{X})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒴
                  %mo ,
                  %msub
                    %mo ⊗
                    %mi Y
                  %mo ,
                  %msub
                    %mn 1
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{Y}, \otimes_Y, 1_Y)
            which are connected by an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            such that the middle one is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+functor"} closed monoidal functor
          %p
            This is the variant/special case of the
            %a.existingWikiWord{:href => "/nlab/show/yoga+of+six+operations"} yoga of six operations
            consisting of two
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo !
                  %mo ⊣
                  %msup
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f_! \dashv f^!)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
                  %mo ⊣
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f^\ast \dashv f_\ast)
            and the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi B
                    %mo ⊣
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((-)\otimes B \dashv [B,-])
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo !
                    %mo ≃
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^! \simeq f^\ast
