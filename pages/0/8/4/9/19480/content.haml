                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    y &amp; \colon &amp;
                    \\mathcal{C}
                    \&amp;\longrightarrow&amp;
                    [\mathcal{C}^{op}, Set]
                    \\\
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; c_1 &amp;\overset{g}{\longrightarrow}&amp; c_2
                    \\\
