            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              on
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              according to Def.
              = succeed "," do
                %a.maruku-ref{:href => "#PreorderOnModalities"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◯
