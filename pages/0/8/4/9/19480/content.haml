                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\bigcirc_1}, \mathcal{C}_{\bigcirc}_2 \hookrightarrow \mathcal{C}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
            %p
              There is an evident
