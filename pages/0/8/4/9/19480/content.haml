              has as
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,d)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi Obj
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in Obj_{\mathcal{C}}
