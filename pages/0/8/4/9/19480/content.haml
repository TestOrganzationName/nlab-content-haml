                    \&amp;\phantom{AA}\colon\phantom{AA}&amp;
                    Hom_{\mathcal{C}}(c_1,Y)
                    \&amp;\overset{Hom_{\mathcal{C}}( g, Y ) }{\longleftarrow}&amp;
                    Hom_{\mathcal{C}}(c_2, Y)
                    }
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(X) \coloneqq Hom_{\mathcal{C}}(-,X)
              in the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of this functor are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/representable+presheaves"} representable presheaves
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Obj
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in Obj_{\mathcal{C}}
              is called their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representing+object"} representing object
            %p
              The functor
              %a.maruku-eqref{:href => "#eq:YonedaFunctor"} (7)
              is also called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %a.maruku-ref{:href => "#YonedaEmbedding"}
              below.
          #PresaheavesAsGeneralizedSpaces.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+spaces"} generalized spaces
            %p
              If a given
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Categories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              of sorts, as those in Example
              = succeed "," do
                %a.maruku-ref{:href => "#SpacesViaAlgebrasOfFunctions"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/generalized+spaces"} generalized spaces
                probe-able by
              the test spaces in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (
              %a{:href => "space+and+quantity#Lawvere86"}> Lawvere 86, p. 17
              ).
            %p
              Namely, imagine a
              %a.existingWikiWord{:href => "/nlab/show/generalized+space"} generalized space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              which is at least probe-able by spaces in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              there is some
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of geometric maps “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi c
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} c \to \mathbf{X}
              ”. Here the quotation marks are to warn us that,
              = succeed "," do
                %em at this point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is not defined yet; and even if it were, it is not expected to be an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is not definable. But we may anyway consider some
              %em abstract set
            #eq:WouldBeMapsIntoGeneralizedSpace.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mtext "=
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mi "
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{X}(c)  \; \text{"=}  Hom(c,\mathbf{X})"
            %p
              whose elements we do want to think of maps (homomorphisms of spaces) from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
            %p
              That this is indeed consistent, in that we may actually remove the quotation remarks on the right of
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:WouldBeMapsIntoGeneralizedSpace"} (8)
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %a.maruku-ref{:href => "#YonedaLemma"}
              below.
            %p
              A minimum consistency condition for this to make sense (we will consider further conditions later on when we discuss
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              with actual morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mover
                      %mo →
                      %mi f
                    %mi c
                  %annotation{:encoding => "application/x-tex"} d \overset{f}{\to} c
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi X
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                                  %mspace{:width => "thinmathspace"}
                                  %mtext "=
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo ∘
                                  %mi f
                                  %mtext "
                        %mtr
                          %mtd
                            %mi d
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c &amp;&amp; \mathbf{X}(c)
                    \\\
                    {}^{\mathllap{ f }}\big\downarrow
                    \&amp;&amp;
                    \\big\uparrow{}^{\mathrlap{ \mathbf{X}(f) \, \text{"=}(-)\circ f\text{"}}}
                    \\\
                    d &amp;&amp; \mathbf{X}(d)
                    }
            %p
              which respects composition and identity morphisms. But in summary, this says that what we have defined thereby is actually a
              %em
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ⟶
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{X} \;\colon\; \mathcal{C}^{op} \longrightarrow Set
                    \\,.
            %p
              For consistency of regarding this presheaf as a
              = succeed "," do
                %em presheaf of sets of plots of a generalized space
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} c \to X
              are already defined.
            %p
              Hence the incarnation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              as a generalized space probe-able by objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              should be the presheaf
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(-,X)
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} presheaf represented
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (Example
              = succeed ")," do
                %a.maruku-ref{:href => "#RepresentablePresheaves"}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:YonedaFunctor"} (7)
            %p
              At this point, however, a serious consistency condition arises: The “ordinary spaces” now exist as objects of two different categories: on the one hand there is the original
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} y(X) \in [\mathcal{C}^{op}, Set]
              in the category of generalized spaces. Hence we need to know that these two perspectives are compatible, notably that maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              between ordinary spaces are the same whether viewed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              or in the more general context of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
            %p
              That this, too, holds true, is the statement of the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %a.maruku-ref{:href => "#YonedaEmbedding"}
              below.
            %p
              Eventually one will want to impose one more consistency condition, namely that plots are determined by their
              = succeed "." do
                %em local behaviour
              %em
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
              (Def.
              %a.maruku-ref{:href => "#Sheaf"}
              below) and is what leads over from
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              to
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
              = succeed "." do
                %a{:href => "#BasicNotionsOfToposTheory"} below
          #YonedaLemma.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"}> Yoneda lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Categories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              any object, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
              a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi 𝒞
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi η
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi η
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{[\mathcal{C}^{op},Set]}( y(X), \mathbf(Y) )
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\mathbf{Y}(X)
                    \\\
                    \\eta
                    \&amp;\mapsto&amp;
                    \\eta_X(id_X)
                    }
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              from the
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} presheaf represented
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %a.maruku-eqref{:href => "#eq:YonedaFunctor"} (7)
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof Proof
            %p
              By Example
              = succeed "," do
                %a.maruku-ref{:href => "#FunctorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#NaturalTransformations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                    %munderover
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ⇓
                        %mpadded{:width => "0"}
                          %mi η
                        %mphantom
                          %mi AA
                      %munder
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                      %mover
                        %mo ⟶
                        %mrow
                          %mi y
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^{op}
                    \\underoverset
                    {\underset{\mathbf{Y}}{\longrightarrow}}
                    {\overset{y(X)}{\longrightarrow}}
                    {\phantom{AA} \Downarrow \mathrlap{\eta}  \phantom{AA}}
                    Set
            %p
              hence given by component functions
              %a.maruku-eqref{:href => "#eq:NaturalTransformationComponent"} (3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi c
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(c,X)
                    \\overset{\eta_c}{\longrightarrow}
                    \\mathbf{Y}(X)
            %p
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} c = X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi X
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi X
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi η
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{C}}(X,X)
                    \&amp;\overset{\eta_X}{\longrightarrow}&amp;
                    \\mathbf{Y}(X)
                    \\\
                    id_X &amp;\mapsto&amp; \eta_X(id_X)
                    }
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} id_X
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a canonical element in the set on the left. The statement to be proven is hence equivalently that for every element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}(X)
              there is precisely one
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              such that this element equals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_X(id_X)
            %p
              Now the condition to be satisfied by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is that it makes its
              %a.existingWikiWord{:href => "/nlab/show/naturality+squares"} naturality squares
              %a.maruku-eqref{:href => "#eq:Naturality"} (4)
              commute (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CommutingDiagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi X
                            %mo ∈
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi X
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi X
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Y
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi Y
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi id
                              %mi X
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi η
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi f
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                            %msub
                              %mi η
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi η
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id_X
                    \\in
                    \&amp;
                    Hom_{\mathcal{C}}(X,X)
                    \&amp;\overset{\eta_X}{\longrightarrow}&amp;
                    \\mathbf{Y}(X)
                    \\\
                    \&amp;
                    {}^{\mathllap{ Hom_{\mathcal{C}}(f,X) }}
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow{}^{\mathrlap{\mathbf{Y}(f)}}
                    \\\
                    \&amp;
                    Hom_{\mathcal{C}}(Y,X)
                    \&amp;\underset{\eta_Y}{\longrightarrow}&amp;
                    \\mathbf{Y}(Y)
                    }
                    \\phantom{AAAA}
                    \\array{
                    \\{id_X\}
                    \&amp;\longrightarrow&amp;
                    \\{\eta_X(id_X)\}
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\\
                    \\{f\}
                    \&amp;\longrightarrow&amp;
                    \\big\{ \eta_Y(f) = \mathbf{Y}(f)( \eta_X(id_X) ) \big\}
                    }
            %p
              for any
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mover
                      %mo ⟶
                      %mi f
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Y \overset{f}{\longrightarrow} X)
                    \\;\in\;
                    Hom_{\mathcal{C}}(Y,X)
                    \\,.
            %p
              As the diagram chase of elements on the right shows, this commutativity (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutingDiagram"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_Y(f)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
              and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Hom_{\mathcal{C}}(Y,X)
              uniquely in terms of the element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_{X}(id_X)
            %p
              It remains only to see that there is no condition on the element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_X(id_X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_Y(f)
              defined this way, the commutativity of all the remaining naturality squares is implies: The general naturality square for a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 2
                    %mover
                      %mo ⟶
                      %mi g
                    %msub
                      %mi Y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Y_2 \overset{g}{\longrightarrow} Y_1
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mrow
                                    %msub
                                      %mi Y
                                      %mn 1
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo ,
                                  %mi X
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Y
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mn 2
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mrow
                                    %msub
                                      %mi Y
                                      %mn 2
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
