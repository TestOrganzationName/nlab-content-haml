          .num_example
            %h6#example_27 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/top"} top
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
                provides
                %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
                of all oppositions)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/top"} top
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo ⊣
                    %mi id
                  %annotation{:encoding => "application/x-tex"} id \dashv id
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialAndFinalAdjointModality"}
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Aufhebung"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
          %p
            But already
            %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
            of the
            %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            is a non-trivial and interesting condition. We consider this below in Prop.
            = succeed "." do
              %a.maruku-ref{:href => "#PiecesHavePoints"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We now re-consider the concept of
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
            from the point of view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/localization+of+categories"} localization of categories
          #CategoryWithWeakEquivalences.num_defn
