                      %mi ϵ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi η
                          %mi X
                        %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi L
                    %mo{:stretchy => "false"} (
