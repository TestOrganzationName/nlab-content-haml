                  are
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#NaturalTransformations"}
            %p
              with the evident
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operations.
          %p
            With a concept of
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            in hand, we may phrase Prop.
            %a.maruku-ref{:href => "#AdjointnessInTermsOfHomIsomorphismEquivalentToAdjunctionInCat"}
            more abstractly:
          #AdjunctionInA2Category.num_defn
            %h6#definition_15 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                in a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Strict2Categories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo ,
                          %mi 𝒟
                          %mo ∈
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D} \in Obj_{\mathcal{C}}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                        %munderover
                          %mrow
                          %munder
                            %mo ⟶
                            %mrow
                              %mphantom
                                %mi AA
                              %mi R
                              %mphantom
                                %mi AA
                          %mover
                            %mo ⟵
                            %mi L
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{D}
                        \\underoverset
                        {\underset{\phantom{AA}R\phantom{AA}}{\longrightarrow}}
                        {\overset{L}{\longleftarrow}}
                        {}
                        \\mathcal{C}
                %p
                  called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  and
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mi 𝒞
                        %mover
                          %mo ⇒
                          %mi η
                        %mi R
                        %mo ∘
                        %mi L
                      %annotation{:encoding => "application/x-tex"} id_{\mathcal{C}} \overset{\eta}{\Rightarrow} R \circ L
                  , called the
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi L
                        %mo ∘
                        %mi R
                        %mover
                          %mo ⇒
                          %mi ϵ
                        %msub
                          %mi id
                          %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} L \circ R \overset{\epsilon}{\Rightarrow} id_{\mathcal{D}}
                  , called the
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            %p
              such that the following
              %em
                %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              hold:
            %center
              %img{:src => "https://ncatlab.org/nlab/files/Adjointness.jpg", :width => "380"}/
            %p We denote this situation by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi R
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mi L
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}
                    \\underoverset
                    {\underset{\phantom{AA}R\phantom{AA}}{\longrightarrow}}
                    {\overset{L}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
          %p
            Hence via Example
            = succeed "," do
              %a.maruku-ref{:href => "#2CategoryOfCategories"}
            %a.maruku-ref{:href => "#AdjointnessInTermsOfHomIsomorphismEquivalentToAdjunctionInCat"}
            says that an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            is equivalente an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            in the general sense of Def.
            = succeed "," do
              %a.maruku-ref{:href => "#AdjunctionInA2Category"}
            %a.existingWikiWord{:href => "/nlab/show/very+large+category"} very large
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
          %p
            This more abstract perspecive on
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            allow us now to understand “duality of dualities” as
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            in a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
          #2CategoryOfCategoriesWithAdjointFunctorsBetweenThem.num_example
            %h6#example_22 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
                of
                %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                with
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                between them)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi Adj
                  %annotation{:encoding => "application/x-tex"} Cat_{Adj}
              be the
              %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
              which is defined just as
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#2CategoryOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              being
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              that are required to be
              %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            %p
              Since adjoints are unique up to natural isomorphism (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#UniquenessOfAdjoints"}
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              are
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
          #AdjunctionofAdjunction.num_example
            %h6#example_23 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
                of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+triples"} adjoint triples
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjunctionInA2Category"}
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi Adj
                  %annotation{:encoding => "application/x-tex"} Cat_{Adj}
              of
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              with
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              between them (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#2CategoryOfCategoriesWithAdjointFunctorsBetweenThem"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of functors (Remark
              = succeed "):" do
                %a.maruku-ref{:href => "#AdjointTriples"}
            %p
              The adjunction says that two
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint+functors"} left adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} L_2
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ⊣
                    %msub
                      %mi R
                      %mn 1
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi L
                      %mn 2
                    %mo ⊣
                    %msub
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    L_1 \dashv R_1
                    \\phantom{AAAA}
                    L_2 \dashv R_2
            %p
              form themselves an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ⊣
                    %msub
                      %mi L
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_1 \dashv L_2
                    \\,.
            %p
              By essentiall uniqueness of adjoints (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniquenessOfAdjoints"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 1
                    %mo ≃
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} R_1 \simeq L_2
              and hence an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %mo ⊥
                                %mphantom
                                  %mrow
                                    %mo ≃
                                    %msub
                                      %mi A
                                      %mi a
                              %mrow
                                %msub
                                  %mi L
                                  %mn 1
                                %mphantom
                                  %mrow
                                    %mo ≃
                                    %msub
                                      %mi A
                                      %mi a
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mrow
                                    %msub
                                      %mi A
                                      %mi a
                                    %mo ≃
                                %mo ⊥
                              %mrow
                                %msub
                                  %mi R
                                  %mn 1
                                %mo ≃
                                %msub
                                  %mi L
                                  %mn 2
                        %mtr
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %mphantom
                                  %mrow
                                    %msub
                                      %mi A
                                      %mi a
                                    %mo ≃
                                %msub
                                  %mi R
                                  %mn 2
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}
                    \\array{
                    \\underoverset{\bot \phantom{\simeq A_a}}{ L_1 \phantom{\simeq A_a} }{\longleftarrow}
                    \\\
                    \\underoverset{\phantom{A_a \simeq}\bot}{R_1 \simeq L_2}{\longrightarrow}
                    \\\
                    \\overset{ \phantom{A_a \simeq} R_2 }{\longleftarrow}
                    }
                    \\mathcal{C}
          %p
            Example
            %a.maruku-ref{:href => "#AdjunctionofAdjunction"}
            suggest to consider a slight variant of the concept of
            %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
            which allows to make the duality between
            %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
            and
            %a.existingWikiWord{:href => "/nlab/show/right+adjoints"} right adjoints
            explicit:
          #DoubleCategory.num_defn
            %h6#definition_16 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/double+category"}> double category
                )
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒞
                            %mi h
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}_h
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi v
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_v
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Categories"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Obj
                            %mrow
                              %msub
                                %mi 𝒞
                                %mn 1
                          %mo =
                          %msub
                            %mi Obj
                            %mrow
                              %msub
                                %mi 𝒞
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}_1} = Obj_{\mathcal{C}_2}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
                  of
                  %em
                    objects of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %p
                  where the
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi h
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_h
                  are to be called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+morphisms"} horizontal morphisms
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %p
                  while the
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi v
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_v
                  are to be called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/vertical+morphisms"} vertical morphisms
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/quadruple"} quadruple
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo ,
                        %mi d
                        %mo ,
                        %mi e
                        %mo ∈
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} a,b,c,d,e \in Obj_{\mathcal{C}}
                  and
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  of horizontal/vertical morphisms of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi f
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi h
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mtd
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %msup
                                  %mrow
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi k
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                            %mtr
                              %mtd
                                %mi c
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mi g
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        a &amp;\overset{f \in \mathcal{C}_h}{\longrightarrow}&amp; b
                        \\\
                        {}^{\mathllap{h \in \mathcal{C}_v}}\big\downarrow &amp;&amp; \big\downarrow{}^{\mathrlap{k \in \mathcal{C}_v}}
                        \\\
                        c &amp;\underset{g \in \mathcal{C}_h}{\longrightarrow}&amp;
                        }
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi Hom
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi g
                          %mo ,
                          %mi h
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} 2Hom(f,g,h,k)
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  between the given
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi f
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi h
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mtd
                                %mo ⇙
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %msup
                                  %mrow
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi k
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                            %mtr
                              %mtd
                                %mi c
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mi g
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                                %mi d
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        a &amp;\overset{f \in \mathcal{C}_h}{\longrightarrow}&amp; b
                        \\\
                        {}^{\mathllap{h \in \mathcal{C}_v}}\big\downarrow
                        \&amp;\swArrow&amp; \big\downarrow{}^{\mathrlap{k \in \mathcal{C}_v}}
                        \\\
                        c &amp;\underset{g \in \mathcal{C}_h}{\longrightarrow}&amp; d
                        }
              %li
                %p
                  a horizontal and a vertical
                  %a.existingWikiWord{:href => "/nlab/show/composition+operation"} composition operation
                  of 2-morphisms which is
                  %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
                  and
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                  in both directions in the evident way, which respects composition in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi h
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_h
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒞
                            %mi v
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}_v
          #DoubleCategoryOfSquares.num_example
            %h6#example_24 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/double+category+of+squares"} double category of squares
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Strict2Categories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/double+category+of+squares"} double category of squares
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sq
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sq(\mathcal{C})
              is the
              %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DoubleCategory"}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are those of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+morphisms"} horizontal morphisms
                  and
                  %a.existingWikiWord{:href => "/nlab/show/vertical+morphisms"} vertical morphisms
                  are both the
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi f
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi h
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi ϕ
                                %mo ⇙
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %msup
                                  %mrow
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi k
                                      %mo ∈
                                      %msub
                                        %mi 𝒞
                                        %mi v
                            %mtr
                              %mtd
                                %mi c
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mi g
                                    %mo ∈
                                    %msub
                                      %mi 𝒞
                                      %mi h
                              %mtd
                                %mi d
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        a &amp;\overset{f \in \mathcal{C}_h}{\longrightarrow}&amp; b
                        \\\
                        {}^{\mathllap{h \in \mathcal{C}_v}}\big\downarrow
                        \&amp;{}^{\mathllap{\phi}}\swArrow&amp;
                        \\big\downarrow{}^{\mathrlap{k \in \mathcal{C}_v}}
                        \\\
                        c &amp;\underset{g \in \mathcal{C}_h}{\longrightarrow}&amp; d
                        }
                %p
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  between the evident composites of 1-morphisms:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ∘
                        %mi f
                        %mover
                          %mo ⇒
                          %mi ϕ
                        %mi g
                        %mo ∘
                        %mi h
                      %annotation{:encoding => "application/x-tex"}
                        k \circ f \overset{\phi}{\Rightarrow} g\circ h
            %p
              and composition is given by the evident compositions in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #StrictAndWeak2Functors.num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/strict+2-functor"} strict
                and
                %a.existingWikiWord{:href => "/nlab/show/weak+2-functor"} weak
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
            %p
              Given two
              %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Strict2Categories"}
              %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DoubleCategory"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo ,
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D}
              %em
                %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/double+functor"} double functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ⟶
                      %mi F
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \overset{F}{\longrightarrow} \mathcal{D}
            %p
              between them, namely
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              and
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              which respect all the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operations and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
            %p
              These are also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-functors"} strict 2-functors
            %p
              This is in contrast to a more flexible concept of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/weak+2-functors"} weak 2-functors
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/pseudofunctors"} pseudofunctors
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              only up to invertible
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              (which themselves are required to satisfy some
              %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
              condition):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %mo ⇓
                            %msubsup
                              %mrow
                              %mrow
                              %mi ρ
                            %mo ≃
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi G
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo ∘
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp; {}^{\mathllap{ F(f) }}\nearrow
                    \&amp;\Downarrow{}^{\rho}_{}\simeq&amp;
                    \\searrow^{\mathrlap{F(G)}}
                    \\\
                    X &amp;&amp; \underset{F(g \circ f)}{\longrightarrow} &amp;&amp; Z
                    }
          %p
            We will see an important example of a weak double functor in the construction of
            %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+functors"} Quillen functors
            = succeed "." do
              %a.maruku-ref{:href => "#HomotopyDoublePseudofunctor"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#Equivalences Equivalences
          %p
            We have seen
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Functors"}
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            between
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            (Def.
            = succeed ")." do
              %a.maruku-ref{:href => "#Categories"}
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            (Def.
            = succeed ")," do
              %a.maruku-ref{:href => "#NaturalTransformations"}
            %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
            in a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of categories (Example
            = succeed ")." do
              %a.maruku-ref{:href => "#2CategoryOfCategories"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            between them, hence for a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between them that has a strict
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
          %p
            This is called an
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            (Def.
            %a.maruku-ref{:href => "#EquivalenceOfCategories"}
            below). A particularly well-behaved equivalence of categories is an equivalence exhibited by an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            of functors, called an
            %em
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence+of+categories"} adjoint equivalence of categories
            (Def.
            %a.maruku-ref{:href => "#AdjointEquivalenceOfCategories"}
            below). In fact every
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            may be improved to an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            (Prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#EveryEquivalenceOfCategoriesComesFromAnAdjointEquivalence"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #AdjointEquivalenceOfCategories.num_defn
            %h6#definition_17 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence+of+categories"}> adjoint equivalence of categories
                )
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Categories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence+of+categories"} adjoint equivalence of categories
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %munderover
                              %mrow
                                %mphantom
                                  %mi A
                                %mphantom
                                  %mrow
                                    %msub
                                      %mrow
                                      %mo ⊥
                                %msub
                                  %mo ≃
                                  %mo ⊥
                                %mphantom
                                  %mi A
                              %munder
                                %mo ⟶
                                %mi R
                              %mover
                                %mo ⟵
                                %mi L
                            %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{L}{\longleftarrow}}
                    {\phantom{A} \phantom{{}_{\bot}}\simeq_{\bot} \phantom{A}}
                    \\mathcal{D}
                    }
            %p
              such that their
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              and
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
              (as opposed to just being
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi 𝒟
                    %mover
                      %mo ⇒
                      %mo ≃
                    %mi R
                    %mo ∘
                    %mi L
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi ϵ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo ∘
                    %mi R
                    %mover
                      %mo ⇒
                      %mo ≃
                    %msub
                      %mi id
                      %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta\;\colon\; id_{\mathcal{D}} \overset{\simeq}{\Rightarrow} R \circ L
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\epsilon\;\colon\;
                    L \circ R \overset{\simeq}{\Rightarrow} id_{\mathcal{C}}
                    \\,.
          %p There is also the following, seemingly weaker, notion:
          #EquivalenceOfCategories.num_defn
            %h6#definition_18 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"}> equivalence of categories
                )
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Categories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %munderover
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ≃
                                %mphantom
                                  %mi AA
                              %munder
                                %mo ⟶
                                %mi R
                              %mover
                                %mo ⟵
                                %mi L
                            %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{L}{\longleftarrow}}
                    {\phantom{AA} \simeq \phantom{AA}}
                    \\mathcal{D}
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              back and forth, as shown (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Functors"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#NaturalTransformations"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              and the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi 𝒟
                    %mover
                      %mo ⇒
                      %mo ≃
                    %mi R
                    %mo ∘
                    %mi L
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi L
                    %mo ∘
                    %mi R
                    %mover
                      %mo ⇒
                      %mo ≃
                    %msub
                      %mi id
                      %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_{\mathcal{D}} \overset{\simeq}{\Rightarrow} R \circ L
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    L \circ R \overset{\simeq}{\Rightarrow} id_{\mathcal{C}}
                    \\,.
          %p
            If a functor participates in an equivalence of categories, that functor alone is usually already called an equivalence of categories. If there is any equivalence of categories between two categories, these categories are called
            = succeed "." do
              %em equivalent
          #EveryEquivalenceOfCategoriesComesFromAnAdjointEquivalence.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong
                (every
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                comes from an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence+of+categories"} adjoint equivalence of categories
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Categories"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence+of+categories"} adjoint equivalence of categories
              between them (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdjointEquivalenceOfCategories"}
            %p
              Moreover, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} R \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L \;\colon\; \mathcal{D} \to \mathcal{C}
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi 𝒟
                    %mover
                      %mo ⇒
                      %mo ≃
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\eta
                    \\;\colon\;
                    id_{\mathcal{D}}
                    \\overset{\simeq}{\Rightarrow}
                    R \circ L
            %p
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
