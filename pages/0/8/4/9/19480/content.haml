          #FullyFaithfulFunctor.num_defn
            %h6#definition_9 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/full+functor"}> full
                ,
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functors"} fully faithful functors
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{C} \to \mathcal{D}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
            %ul
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
                  if all its hom-functions are
                  %a.existingWikiWord{:href => "/nlab/show/surjective+functions"} surjective functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mo ⟶
                          %mi surj
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi X
                                %mo ,
                                %mi Y
                        %msub
                          %mi Hom
                          %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}(X,Y)
                        \\underoverset{surj}{F_{X,Y}}{\longrightarrow}
                        Hom_{\mathcal{D}}(F(X), F(Y))
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
                  if all its hom-functions are
                  %a.existingWikiWord{:href => "/nlab/show/injective+functions"} injective functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mo ⟶
                          %mi inj
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi X
                                %mo ,
                                %mi Y
                        %msub
                          %mi Hom
                          %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}(X,Y)
                        \\underoverset{inj}{F_{X,Y}}{\longrightarrow}
                        Hom_{\mathcal{D}}(F(X), F(Y))
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                  if all its hom-functions are
                  %a.existingWikiWord{:href => "/nlab/show/bijective+functions"} bijective functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mo ⟶
                          %mi bij
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi X
                                %mo ,
                                %mi Y
                        %msub
                          %mi Hom
                          %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}(X,Y)
                        \\underoverset{bij}{F_{X,Y}}{\longrightarrow}
                        Hom_{\mathcal{D}}(F(X), F(Y))
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              is also called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"}> full subcategory
                  \-inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi A
                        %mi F
                        %mphantom
                          %mi A
                    %mi 𝒟
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \overset{\phantom{A}F\phantom{A}}{\hookrightarrow} \mathcal{D}
                    \\,.
          #FullSubcategoryOnClassOfObjects.num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                on a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Categories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msub
                      %mi Obj
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} S \subset Obj_{\mathcal{C}}
              be a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_S
              whose class of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are precisely the morphisms of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mn 1
                    %mo ,
                    %msub
                      %mi s
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mn 1
                    %mo ,
                    %msub
                      %mi s
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}_S}(s_1, s_2)
                    \\;\coloneqq\;
                    Hom_{\mathcal{C}}(s_1, s_2)
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              and
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              defined as in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi S
                          %mtd
                            %mover
                              %mo ↪
                              %mphantom
                                %mi AAAA
                          %mtd
                            %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}_S &amp;\overset{\phantom{AAAA}}{\hookrightarrow}&amp; \mathcal{C}
                    }
            %p
              which is the evident inclsuion on objects, and the
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  on the objects in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            %p
              Beware that not every
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              is, in components, exactly of this form, but, assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %em
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
          %p
            The concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            from Def.
            %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
            allows to make precise the idea of
            %em
              %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            from Example
            = succeed ":" do
              %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
          #StructuredSetsAndFaithfulFunctors.num_example
            %h6#example_11 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/structured+sets"} structured sets
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functors"} faithful functors
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a kind of
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} mathematical structure
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathcal{S} Set
              be the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/structured+sets"} structured sets
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mi Set
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}Set \longrightarrow Set
            %p
              which sends each
              %a.existingWikiWord{:href => "/nlab/show/structured+set"} structured set
              to the underlying set (“forgetting” the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              that it carries), and which sends
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              of sets to themselves. That a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/structured+sets"} structured sets
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between the underlying sets satisfying a
              %em special condition
              implies that this is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
            %p
              Conversely, it makes sense to
              %em define
              %a.existingWikiWord{:href => "/nlab/show/structured+sets"} structured sets
              in general to be the
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              which is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ⟶
                      %mi faithful
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{faithful}{\longrightarrow} Set
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              %em
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              for more on this.
          #SpacesViaAlgebrasOfFunctions.num_example
            %h6#example_12 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
                seen via their
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
            %p
              In any given context of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which sends any
              %a.existingWikiWord{:href => "/nlab/show/space"} space
              of the given kind to its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              given by precomposition with that map (a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              = succeed ")." do
                %a.maruku-ref{:href => "#HomFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                            %mtext geometric spaces
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mtext algebra of functions
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                            %mtext algebras
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                              %mi op
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mo ↦
                          %mtd
                            %mi FunctionsOn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                              %mrow
                                %mi ϕ
                                %mo ↦
                                %mi ϕ
                                %mo ∘
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mo ↦
                          %mtd
                            %mi FunctionsOn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 2
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\big\{
                    \\text{geometric spaces}
                    \\big\}
                    \&amp;
                    \\overset{
                    \\text{algebra of functions}
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    \\big\{
                    \\text{algebras}
                    \\big\}^{op}
                    \\\
                    \\\
                    X_1 &amp;\mapsto&amp; FunctionsOn(X_1)
                    \\\
                    {}^{\mathllap{f}}\big\downarrow &amp;&amp; \big\uparrow^{ \phi \mapsto \phi \circ f }
                    \\\
                    X_2 &amp;\mapsto&amp; FunctionsOn(X_2)
                    }
            %p
              Since the precomposition operation reverses the direction of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              to the
              %em
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
            %p
              In broad generality, there is a
              %a.existingWikiWord{:href => "/nlab/show/duality"} duality
              (“
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"}> Isbell duality
              ”) between
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              and
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
              = succeed "\u201D," do
                %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
              = succeed ")." do
                %a{:href => "space+and+quantity#Lawvere86"} Lawvere 86
            %p We now mention some concrete examples of this general pattern:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                and
                %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            %p Consider
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi cpt
                      %annotation{:encoding => "application/x-tex"} {}_{cpt}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+spaces"} Hausdorff spaces
                  with
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  between them;
              %li
                %p
                  the category
                  %a.existingWikiWord{:href => "/nlab/show/C%2AAlg"} C*Alg
                  of
                  %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %p
              from Example
              = succeed "." do
                %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Top
                      %mrow
                        %mi H
                        %mo ,
                        %mi cpt
                    %mo ⟶
                    %msup
                      %mi C
                      %mo *
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    C(-)
                    \\;\colon\;
                    Top_{H,cpt}
                    \\longrightarrow
                    C^\ast Alg^{op}
            %p
              from the former to the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the latter (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to its
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(X)
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi ϕ
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} X \overset{\phi}{\to} \mathbb{C}
              with values in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between compact spaces to the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              that is given by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ↦
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
