                    \\;\colon\;
                    SmthMfd
                    \\longrightarrow
                    Alg_{\mathbb{R}}^{op}
            %p
              from the former to the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the latter (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#OppositeCategory"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to its
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi ϕ
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} X \overset{\phi}{\to} \mathbb{R}
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              between smooth manifolds to the
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
              that is given by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
