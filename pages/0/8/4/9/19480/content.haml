          #Functors.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/functor"}> functor
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Categories"}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ⟶
                      %mi F
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \overset{F}{\longrightarrow} \mathcal{D}
            %p is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  between the classes of
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi Obj
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Obj
                          %mi 𝒞
                        %mo ⟶
                        %msub
                          %mi Obj
                          %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
                        F_{Obj} \;\colon\; Obj_{\mathcal{C}} \longrightarrow Obj_{\mathcal{D}}
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ∈
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X,Y \in Obj_{\mathcal{C}}
                  of objects a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi Hom
                          %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi F
                          %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_{X,Y}
                        \\;\colon\;
                        Hom_{\mathcal{C}}(X,Y)
                        \\longrightarrow
                        Hom_{\mathcal{D}}(F_{Obj}(X), F_{Obj}(Y))
            %p such that
            %ol
              %li
                %p
                  For each
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in Obj_{\mathcal{C}}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                  is respected:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi X
                            %mo ,
                            %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi F
                              %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        F_{X,X}(id_X) \;=\; id_{F_{Obj}(X)}
                        \\,;
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/triple"} triple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi X
                          %mn 3
                        %mo ∈
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X_1, X_2, X_3 \in Obj_{\mathcal{C}}
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  is respected: given
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mover
                          %mo ⟶
                          %mi f
                        %msub
                          %mi X
                          %mn 2
                        %mover
                          %mo ⟶
                          %mi g
                        %msub
                          %mi X
                          %mn 3
                      %annotation{:encoding => "application/x-tex"}
                        X_1 \overset{f}{\longrightarrow} X_2 \overset{g}{\longrightarrow} X_3
                %p we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %msub
                              %mi X
                              %mn 1
                            %mo ,
                            %msub
                              %mi X
                              %mn 3
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi F
                          %mrow
                            %msub
                              %mi X
                              %mn 2
                            %mo ,
                            %msub
                              %mi X
                              %mn 3
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi F
                          %mrow
                            %msub
                              %mi X
                              %mn 1
                            %mo ,
                            %msub
                              %mi X
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        F_{X_1, X_3}(g \circ f ) \;=\;  F_{X_2, X_3}(g) \circ F_{X_1,X_2}(f)
                        \\,.
