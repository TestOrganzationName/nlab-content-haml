              %a.maruku-ref{:href => "#InitialAndTerminalObjectInTermsOfAdjunction"}
              there is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
