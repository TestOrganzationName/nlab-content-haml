                    %mtext and
                    %mphantom
                      %mi AA
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϵ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon_{L(\eta_X)} \circ L(\eta_X)
                    \\;=\;
                    id_{L(X)}
                    \\phantom{AA} \text{and} \phantom{AA}
                    \\iota( \epsilon_Y )\circ \eta_{\iota(Y)}
                    \\;=\;
                    id_{\iota(Y)}
                    \\,.
            %p
              But by Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FullyFaithfulAndInvertibleAdjoints"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
