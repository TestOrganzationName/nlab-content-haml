                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒟
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Im(\bigcirc)
                    \\underoverset
                    {\underset{\phantom{AA}\iota \phantom{AA}}{\hookrightarrow}}
                    {\overset{\phantom{AA}L \phantom{AA} }{\longleftarrow}}
                    {\bot}
                    \\mathcal{D}
                    \\,.
            %p
              and its unit is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi X
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \overset{\eta_X}{\longrightarrow} \iota(L(X))
                    \\,.
            %p
              Hence it is sufficient to show that the morphisms and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L( \eta_X )
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi ι
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} \eta_{\iota Y}
              are isomorphisms.
            %p
              Now, the
              %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              %a.maruku-eqref{:href => "#eq:TriangleIdentities"} (18)
              for the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊣
                      %mi ι
                    %annotation{:encoding => "application/x-tex"} L \dashv \iota
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralAdjunctsInTermsOfAdjunctionUnitCounit"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
