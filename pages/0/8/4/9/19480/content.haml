                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/local+object"} local
              %li
                %p
                  every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  %a.existingWikiWord{:href => "/nlab/show/local+object"} local
                  precisely if it is
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                  to an object in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                          %mover
                            %mo ↪
                            %mi ι
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
            %p
              The first statement follows directly with the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction isomorphism
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi W
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(w, \iota(X))
                    \\simeq
                    Hom_{\mathcal{C}[W^{-1}]}(L(w), X)
            %p
              and the fact that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              to
              %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#YonedaCharacterizationOfIsomorphism"}
            %p
              For the second statement, consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is also local with respect to the class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi sat
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Isos
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    W_{sat} \;\coloneqq\; L^{-1}(Isos)
            %p
              of
              %em all
              morphisms that are inverted by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (the “
              %a.existingWikiWord{:href => "/nlab/show/saturated+class+of+morphisms"}> saturated class of morphisms
              ”): For consider the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Set
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{Hom_{\mathcal{C}}(-,Y)}{\longrightarrow} Set^{op}
              to the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              this takes elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              to isomorphisms. Hence, by the defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %p
              Since, by
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ModalOpIdempotent"}
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \eta_Y
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} W_{sat}
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mi Y
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( \eta_Y, Y )
                    \\;\colon\;
                    Hom_{\mathcal{C}}( \iota L(Y), Y )
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{\mathcal{C}}(Y, Y)
                    \\,.
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} id_Y
              has a
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_Y^{-1}
              under this function, hence a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msub
                      %mi η
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_Y^{-1} \circ \eta_Y \;=\; id_Y
                    \\,.
            %p
              But by
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              this implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∈
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} \eta_Y^{-1} \in W_{sat}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota L(Y)
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} W_{sat}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( \eta^{-1}_Y, \iota L(Y) )
                    \\;\colon\;
                    Hom_{\mathcal{C}}( Y, \iota L(Y) )
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{\mathcal{C}}( \iota L(Y) , \iota L(Y))
                    \\,,
            %p
              to deduce that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_Y^{-1}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∘
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (\eta_Y^{-1})^{-1} \circ \eta_Y^{-1}
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              that itself has a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              is in fact an
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphisms"} inverse morphisms
              (
              %a{:href => "retract#LeftInverseWithLeftInverseIsLeftInverse"}> this Lemma
              ), this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta^{-1}_Y
              is an
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \eta_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo →
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_Y \;\colon\; Y \to \iota L (Y)
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is isomorphic to an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi W
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ↪
                        %mi ι
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
            %p
              Conversely, if there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to a morphism in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              hence, by the first item, to a
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              to
              %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
              and since bijections satisfy
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
          #ReflectionOntoLocalObjectsIsLocalizationWithRespectToLeftAdjoints.num_prop
            %h6#proposition_19 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
                onto
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
                is
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                with respect to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Categories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msub
                      %mi Mor
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} S \subset Mor_{\mathcal{C}}
              be a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
              onto the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationAtACollectionOfMorphisms"}
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of a
              %a.existingWikiWord{:href => "/nlab/show/localization+of+categories"} localization of categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationOfACategory"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functors inverting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .proof
            %h6#proof_18 Proof
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi S
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_S
                    \\underoverset
                    {\underset{ \phantom{AA}\iota\phantom{AA} }{\hookrightarrow}}
                    {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              for the
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            %p
              Say that a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                \-
                %a.existingWikiWord{:href => "/nlab/show/local+morphism"} local morphism
              if for every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#HomFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              yields a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(f,A)
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_S
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#YonedaEmbedding"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
              are precisely the morphisms that are taken to isomorphisms by the reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (via Example
              = succeed ")." do
                %a.maruku-ref{:href => "#YonedaCharacterizationOfIsomorphism"}
            %p Now let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mi G
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi F
                          %mphantom
                            %mi AA
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G)
                    \\;\colon\;
                    \\mathcal{C}
                    \\underoverset
                    {\underset{G}{\longleftarrow}}
                    {\overset{ \phantom{AA} F \phantom{AA} }{\longrightarrow}}
                    {\bot}
                    \\mathcal{D}
            %p
              be a pair of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              inverts the morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              takes values in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              inverts all
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %p
              Thus the essentially unique factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              now follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ReflectiveSubcategoriesAreLocalizations"}
