                    \\;\;\;\colon\;\;\;
                    \\array{
                    X &amp;\mapsto &amp; C(X)
                    \\\
                    {}^{\mathllap{ f }}\big\downarrow
                    \&amp;&amp;
                    \\big\uparrow^{\mathrlap{ f^\ast : \phi \mapsto \phi \circ f }}
                    \\\
                    Y &amp;\mapsto&amp; C(Y)
                    }
            %p
              Part of the statement of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+duality"} Gelfand duality
              is that this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              = succeed ")," do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commutative+C%2A-algebras"} commutative C*-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mrow
                        %mi H
                        %mo ,
                        %mi cpt
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %msup
                      %mi C
                      %mo *
                    %msup
                      %mi Alg
                      %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top_{H,cpt}
                    \\overset{\phantom{AAA}}{\hookrightarrow}
                    C^\ast Alg^{op}
                    \\,.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
                and
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
            %p
              The starting point of
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
              is to consider
              %em
                %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
              as the
              %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over some
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
            #eq:FormalDualsOfCommutativeRings.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aff
                      %mi 𝕂
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi CAlg
                      %mi 𝕂
                      %mi fin
                    %msup
                      %mo
                      %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aff_{\mathbb{K}}
                    \\;\;\coloneqq\;\;
                    CAlg^{fin}_{\mathbb{K}}^{op}
                    \\,.
            %p
              Beware that the immediate identification
              %a.maruku-eqref{:href => "#eq:FormalDualsOfCommutativeRings"} (2)
              is often obscured by the definition of
              %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
              as
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+ringed+spaces"} locally ringed spaces
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Def.
              %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              below) to the simple
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dualization
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:FormalDualsOfCommutativeRings"} (2)
              = succeed "." do
                %a{:href => "affine+scheme#AffineSchemesFullSubcategoryOfOppositeOfRings"} here
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
              had urged to abandon, as a foundational concept, the more complicated definition in favor of the simpler one in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:FormalDualsOfCommutativeRings"} (2)
              = succeed "." do
                %a{:href => "functorial+geometry#Lawvere16Quote"} Lawvere 03
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                and
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
                %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
            %p Consider
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                  with
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  between them;
              %li
                %p
                  the category
                  %a.existingWikiWord{:href => "/nlab/show/Alg"} Alg
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi ℝ
                      %annotation{:encoding => "application/x-tex"} {}_{\mathbb{R}}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %p
              from Example
              = succeed "." do
                %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SmthMfd
