          #CollectionOfUniversalArrowsEquivalentToAdjointFunctor.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (collection of
                %a.existingWikiWord{:href => "/nlab/show/universal+morphisms"} universal morphisms
                equivalent to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R \;\colon\; \mathcal{D} \to \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Functors"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} L \colon \mathcal{C} \to \mathcal{D}
                  according to Def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              %li
                %p
                  For every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/universal+morphism"} universal morphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi η
                                %mi c
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} c \overset{\eta_c}{\longrightarrow} R(L(c))
                  = succeed "." do
                    %a.maruku-ref{:href => "#UniversalArrow"}
          .proof
            %h6#proof_7 Proof
            %p
              In one direction, assume a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is given. Define the would-be universal arrow at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              to be the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \eta_c
              via Def.
              = succeed "." do
                %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralAdjunctsInTermsOfAdjunctionUnitCounit"}
            %p
              In the other direction, assume that universal arrows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \eta_c
              are given. The uniqueness clause in Def.
              %a.maruku-ref{:href => "#UniversalArrow"}
              immediately implies
              %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo →
                                %mover
                                  %mi f
                                  %mo ˜
                              %mi d
                              %mo )
                          %mtd
                            %mo ↦
                          %mtd
                            %mrow
                              %mo (
                              %mi c
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi η
                                    %mi c
                              %mi R
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo →
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mi f
                                    %mo ˜
                                  %mo{:stretchy => "false"} )
                              %mi R
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{D}}(L(c),d)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c,R(d))
                    \\\
                    \\left(
                    L(c) \overset{\widetilde f}{\to} d
                    \\right)
                    \&amp;\mapsto&amp;
                    \\left(
                    c \overset{\eta_c}{\to} R(L(c)) \overset{ R(\widetilde f) }{\to} R(d)
                    \\right)
                    }
            %p
              Hence to satisfy
              %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
              it remains to show that these are
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in both variables. In fact, by Prop.
              %a.maruku-ref{:href => "#AdjointFunctorFromObjectwiseRepresentingObject"}
              it is sufficient to show naturality in the variable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              applied in
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:UniversalArrowFactorization"} (21)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h \colon d_1 \to d_2
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi c
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi c
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi f
                                  %mo ˜
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi h
                                  %mo ∘
                                  %mover
                                    %mi f
                                    %mo ˜
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi h
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 2
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; c
                    \\\
                    \&amp; {}^{\mathllap{\eta_c}}\swarrow &amp;&amp; \searrow^{\mathrlap{f}}
                    \\\
                    R (L(c)) &amp;&amp;\underset{R (\widetilde f)}{\longrightarrow}&amp;&amp; R(d_1)
                    \\\
                    \&amp;&amp; {}_{\mathllap{ R( h\circ \widetilde f ) }}\searrow &amp;&amp; \downarrow^{\mathrlap{R(h)}}
                    \\\
                    \&amp;&amp; &amp;&amp; R(d_2)
                    }
          %p
            The following equivalent formulation (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#UniversalMorphismsAreInitialObjectsInCommaCategory"}
            %a.existingWikiWord{:href => "/nlab/show/universal+morphisms"} universal morphisms
            is often useful:
          #CommaCategoryWithOneSideConstant.num_example
            %h6#example_20 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/comma+category"}> comma category
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{D} \to \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %ol
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} /
                        %mi F
                      %annotation{:encoding => "application/x-tex"} c/F
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  consisting of an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
                  and
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo →
                          %mi f
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} F(d)
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi f
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 2
                        %mo ,
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi f
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (d_1,X_1,f_1) \to (d_2,X_2,f_2)
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mover
                          %mo ⟶
                          %mi g
                        %msub
                          %mi X
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} X_1 \overset{g}{\longrightarrow} X_2
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  that make a commuting triangle (Def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#CommutingDiagram"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                        %mo ∘
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi f
                          %mn 1
                        %mphantom
                          %mi AAAAAA
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi X
                                  %mn 1
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mphantom
                                      %mi AA
                                    %mi g
                                    %mphantom
                                      %mi AA
                              %mtd
                              %mtd
                                %msub
                                  %mi X
                                  %mn 2
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi X
                                  %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mphantom
                                      %mi AA
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %mo{:stretchy => "false"} )
                                    %mphantom
                                      %mi AA
                              %mtd
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi X
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi f
                                        %mn 1
                                %mo ↘
                              %mtd
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi f
                                        %mn 2
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi c
                      %annotation{:encoding => "application/x-tex"}
                        f_2\circ F(g)
                        \\;=\;
                        f_1
                        \\phantom{AAAAAA}
                        \\array{
                        X_1 &amp;&amp; \overset{\phantom{AA} g \phantom{AA}}{\longrightarrow} &amp;&amp; X_2
                        \\\
                        F(X_1)
                        \&amp;&amp;
                        \\overset{\phantom{AA} F(g) \phantom{AA}}{\longrightarrow}
                        \&amp;&amp;
                        F(X_2)
                        \\\
                        \&amp; {}_{\mathllap{f_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{f_2}}
                        \\\
                        \&amp;&amp; c
                        }
                %p
                  There is a canonical
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} /
                                %mi c
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                              %mtd
                                %mi 𝒟
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        F/c
                        \&amp;\overset{}{\longrightarrow}&amp;
                        \\mathcal{D}
                        }
                        \\,.
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} /
                        %mi c
                      %annotation{:encoding => "application/x-tex"} F/c
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  consisting of an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mi f
                        %mi X
                      %annotation{:encoding => "application/x-tex"} F(d) \overset{f}{\to} X
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi f
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 2
                        %mo ,
                        %msub
