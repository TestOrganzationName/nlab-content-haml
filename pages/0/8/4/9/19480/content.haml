              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mo ◯
                    %mo{:stretchy => "false"} )
