            %h6#proof_13 Proof
            %p
              We discuss the first case, the second is
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#OppositeCategory"}
            %p
              By Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ModalOperatorsEquivalentToReflectiveSubcategories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \iota \circ L
              obtained from the
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              = succeed ")" do
                %a.maruku-ref{:href => "#ReflectiveSubcategory"}
