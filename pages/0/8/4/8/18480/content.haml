                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \exists t:[0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi t
                    %mo &lt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0\lt t \lt 1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                      %mi t
                      %mo ′
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \exists t':[0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi t
                    %mo ′
                    %mo &lt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \lt t' \lt 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a(t)=a'(t')
              ), then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi a
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} a=a'
          %p
            Note that plane digraphs are often introduced into a context like (abstract) digraphs are, i.e. by writing
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
          %ul
            %li
              %p
                the type of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D=(V,A)
                is invisible from this notation (it may be a
                %em digraph
                or a
                = succeed ")" do
                  %em plane digraph
            %li
              %p
                for a plane digraph
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D=(V,A)
                we do not in general have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊆
                        %mi V
                        %mo ×
                        %mi V
                      %annotation{:encoding => "application/x-tex"} A\subseteq V\times V
          %p
            We make use of the treatment of
            %em undirected
            plane graphs given in (
            %a{:href => "#DiestelGraphTheoryFourthEd"}> Diestel
            , Chapter 4), with some adaptations made for the present purposes:
          %ul
            %li
              %p
                here,
                %em arc
                means arc in the usual topological sense, without exception, while, since the author focuses on undirected graphs, in
                = succeed "," do
                  %a{:href => "#DiestelGraphTheoryFourthEd"} Diestel
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/plane"} plane
                %em directional information
                (compare def.
                %a.maruku-ref{:href => "#AbstractDigraphOfAPlaneDigraph"}
                where said information is used).
            %li
              %p
                in (
                %a{:href => "#DiestelGraphTheoryFourthEd"}> Diestel
                , Chapter 4), both
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                in the definition of plane graphs are required to be
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
                = succeed ")." do
                  %a.maruku-ref{:href => "#ExamplePlaneDigraph"}
            %li
              %p
                for ease of reference, we calibrate the point-set topological terminology according to
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Topology"} Introduction to Topology
                (example: we will say “component” instead of “region”) when defining
                = succeed "," do
                  %em faces
                = succeed "." do
                  %a{:href => "#Munkres2000"} Munkres 2000
          #ExamplePlaneDigraph.num_example
            %h6#example_4 Example
            %p
              An example of a plane digraph with countably infinite vertex set, and whose satisfying the axioms of plane digraphs is evident, is given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi φ
                      %mo ∈
                      %mi ℝ
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 0
                      %mo ≤
                      %mi φ
                      %mo &lt;
                      %mn 2
                      %mi π
                      %mo ,
                      %mspace{:width => "1em"}
                      %mi φ
                      %mo ∈
                      %mi ℚ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} T:=\{\varphi\in\mathbb{R}\colon 0\le \varphi\lt 2\pi,\quad \varphi\in\mathbb{Q} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi φ
                    %mo ∈
                    %mi M
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V:=\{(0,0)\} \cup \{   (  \cos( \varphi )  , \sin( \varphi  ) ) \colon  \varphi\in M    \}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a(\varphi)\colon [0,1]\rightarrow\mathbb{R}^2
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ⋅
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi t
                    %mo ⋅
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a(\varphi)(t) =   (  t\cdot\cos(\varphi), t\cdot \sin(\varphi)   )
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi φ
                      %mo ∈
                      %mi M
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A:= \{  a(\varphi)\colon     \varphi\in M      \}
              %a.existingWikiWord{:href => "/nlab/show/pasting+scheme"} pasting scheme in the sense of Power
              (already for the strong reason that in it there does not exist any
              = succeed "-coking)," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
            %p
              In combinatorics, this is sometimes referred to as an
              = succeed "." do
                %em infinite star
          %p
            Applications of the following standard concept are e.g. the study of
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
            = succeed ")" do
              %a{:href => "#Power1990"} proof
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pasting+schemes"} pasting schemes
          #Face.num_defn
            %h6#definition_15 Definition
            %p
              %strong (face of a plane digraph)
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a plane digraph. The
              = succeed "," do
                %em
                  set of faces of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Fa
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Fa}(D)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              = succeed "," do
                %a{:href => "Introduction+to+Topology+--+1#subspaces"} Section 7
              %a.existingWikiWord{:href => "/nlab/show/relative+complement"} relative complement
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo ∖
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mo{:stretchy => "false"} {
                      %mi{:mathvariant => "normal"} im
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi a
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2\setminus\bigcup\{   \mathrm{im}(a) \colon a\in A        \}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} im
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 0
                      %mo ≤
                      %mi t
                      %mo ≤
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathrm{im}(a)=\{   a(t)\colon 0\leq t\leq 1    \}
            %p
              A
              %em
                face of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              is a
              = succeed "." do
                %em
                  member of the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Fa
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Fa}(D)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is an open connected subspace of the plane.
          %p
            Of course one needs a map from
            %em plane digraphs
            to (abstract)
            = succeed ":" do
              %em digraphs
          #AbstractDigraphOfAPlaneDigraph.num_defn
            %h6#definition_16 Definition
            %p
              %strong (the (abstract) digraph of a plane digraph)
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a plane digraph. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Dig
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ′
                    %mo ,
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Dig}(D)=(V',A')
              is the digraph defined as follows: it has vertex set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ′
                    %mo :
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V':=V
              and arc set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ′
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi a
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A' :=      \{    ( a(0)  ,   a(1) )  \colon    a\in A           \}
          %p
            Note that by axiom (v.connect),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            is a subset of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V\times V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is an topological arc, and, as such, injective,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            is moreover disjoint from the diagonal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi v
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(v,v)\colon v\in V\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            has the type required by def.
            = succeed "." do
              %a.maruku-ref{:href => "#Digraph"}
          #DigraphTheoreticTermsForPlaneDigraph.num_defn
            %h6#definition_17 Definition
            %p
              All digraph-theoretic technical terms like
              = succeed "," do
                %em out-neighborhood
              %em outdegree
              which are defined for
              %em digraphs
              are defined for
              %em plane digraphs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              by first applying the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Dig
                  %annotation{:encoding => "application/x-tex"} \mathrm{Dig}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Dig
                    %annotation{:encoding => "application/x-tex"} \mathrm{Dig}
          %p
            A central technical tool in
            %a{:href => "#Power1990"} Power’s proof
            are
            = succeed ":" do
              %em boundary walks
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"} red herring principle
            = succeed "," do
              %em weak walk
          %p
            The boundary walks one works with when using A.J. Power’s
            %a{:href => "#Power1990"} application
            of plane digraphs to category theory are often weak
            = succeed "," do
              %em trails
            %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            one encounters in practice do not have any arc-repetitions. Equivalently, the 1-cells of usual pasting diagrams have an underlying undirected graphs with is
            = succeed "." do
              %em bridgeless
            %em walks
            and
            %em trails
            is not futile but necessary: a typical example of a pasting diagram occurring naturally in category theory are
            %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            diagrams: the
            %em boundary trail
            of the
            %em exterior
            face of the typical whiskering diagram
            %em does
            have arc-repetions, hence is not a trail but only a walk.
          %h2#remarks_on_the_definitions Remarks on the definitions
          %p
            The
            %em convention
            to have digraph imply that there be no loops and no parallel arcs, and resort to other terms such as
            %em directed pseudograph
            to signal loops or parallel arcs, is widespread in modern combinatorics. For example, see p. 2 of (
            %a{:href => "#DG2nd"}> Gutin and Bang-Jensen
            ), and Section 1.2 of (
            %a{:href => "#DecompositionProof"}> Csaba et al
            ).
          %p
            Unsurprisingly, while the convention that digraph implies that there be no parallel arrows has been widely adopted nowadays, there is a generous disregard for whether a digraph may contain loops. In this set-theoretical definition given above, this corresponds to the decision whether to allow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to contain elements of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v,v)
          %p
            The terms
            = succeed "," do
              %em walk
            %em trail
            and
            %em path
            are standard in modern combinatorics. They are in particular compatible with standard usage in the theory of
            %em undirected
            graphs, in that upon forgetting (so to speak) the directions in the various definitions, one obtains the standard notions of walk, trail and path in (undirected) graph theory (for example
            %a{:href => "#BondyMurtyFirstEdition"} Figure 1.8
            illustrates precisely this convention).
          %p
            Many (e.g.
            %a{:href => "#DG2nd"} p. 11
            and
            = succeed ")" do
              %a{:href => "#BondyMurtyFirstEdition"} Chapter 1
            %em only
            because digraphs cannot have any parallel arcs: for digraphs, our definition and the vertex-arc-alternating definition of
            %a{:href => "#DG2nd"} p. 11
            are equivalent to all intents and purposes. There is, however a good reason why e.g.
            %a{:href => "#BondyMurtyFirstEdition"} Bondy and Murty
            use the latter definition: for them, a
            %em directed graph
            is (cf.
            = succeed "," do
              %a{:href => "#BondyMurtyFirstEdition"} 10.1
            %a.existingWikiWord{:href => "/nlab/show/quivers"} quivers
            and a rare hybrid between purely functional and purely relation-theoretic formalizations: they use maps with codomain set
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V\times V
            %em digraph
            but a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quiver"} quiver
            = succeed "." do
              %em then a vertex-sequence does not contain enough information to define a “walk”
          %p
            Needless to say (since given by the definitions),
            = succeed "," do
              %em in a trail, arc-repetitions are forbidden
          %p
            The perhaps oddly hybrid concept of
            %em trail
            has a crucial role in A. J. Power’s (
            %a{:href => "#Power1990"}> proof
            ) of unique interpretability of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pasting+schemes"} pasting schemes
            %em face
            of a
            %em plane digraph
            determines a
            %em boundary trail
            which always is a
            = succeed "." do
              %em weak trail
          %p
            Generically, such a
            %em boundary trail
            has many vertex-repetitions, but it never has any arc-repetition.
          %p
            The terminology “king” above is standard in modern digraph theory; the term “coking” is not, but in tune with category-theoretic usages. The term “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            \-king” appears not to be attested but is in tune with a standard notion of
            = succeed "-king" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            signal that some parameter is unconstrained (cf.
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/omega-groupoid"} omega-groupoid
          %p
            The choice of definitions documented here is biased towards (one of) the
            %em uses
            digraphs are put to in category theory, in particular in giving a rigorous justification of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            %em plane digraphs
            in this article.
          %p
            A reason for treating the concept of
            = succeed "-kings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed ")" do
              %a{:href => "#Power1990"} Power 1990
            = succeed "," do
              %em pasting theorem
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            = succeed "-kings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "-cokings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "-kings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "-cokings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            Moreover, Power makes crucial use of a concept of
            = succeed "," do
              %em
                addition of
                = succeed "\u2013" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                = succeed "-paths" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
            = succeed "\u2013" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h2#uses_of_digraphs_in_category_theory Uses of digraphs in category theory
          %p
            One example of why digraphs are relevant to category theory are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pasting+schemes"} pasting schemes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            %a.existingWikiWord{:href => "/nlab/show/pasting+scheme"} pasting scheme
            in the literature. E.g. there are M. Johnson’s pasting schemes ((
            %a{:href => "#Johnson1987"}> Johnson 1987
            , Chapter 2), (
            %a{:href => "#Johnson1989"}> Johnson 1989
            , Section 2)) and Power’s pasting schemes (
            %a{:href => "#Power1990"}> Power 1990
            ). The definition which is strictly relevant to the present article is Power’s. He defines defines pasting schemes as a special kind of digraph (
            %a{:href => "#Power1990"}> Power 1990
            , Section 3), details will be found at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pasting+scheme"} pasting scheme
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+shape+for+higher+structures"} geometric shape for higher structures
            %li
