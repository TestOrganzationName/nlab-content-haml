                      %mo ¬
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg\,(a(t)\in V)
            %p
              (not.par) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,a'\in A
              and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
