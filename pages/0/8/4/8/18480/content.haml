                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (z(P),u)\in A
          %p
            The following concept appears (under another name) in
            = succeed ":" do
              %a{:href => "#Power1990"} Power’s proof
          #King.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (king, coking,
                = succeed "-king," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
