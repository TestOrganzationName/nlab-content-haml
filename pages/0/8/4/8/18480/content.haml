          %h2#definition_and_basic_notions Definition and basic notions
          %p In this section we collect some definitions that are fundamental to digraph theory, but presented largely from the point of view of category theory.
          #Digraph.num_defn
            %h6#definition Definition
            %p
              %strong (digraph)
            %p
              A
              %em digraph
              is a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,A)
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ×
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi v
                      %mo ∈
                      %mi V
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A\subseteq (V\times V)\setminus\{ (v,v)\colon v\in V\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V\times V
              denotes the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                    %mo ∖
                    %mrow
                  %annotation{:encoding => "application/x-tex"} {}\setminus{}
              the
              %a.existingWikiWord{:href => "/nlab/show/relative+complement"} relative complement
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are called
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are called
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/arcs"} arcs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a = (v, w)
              an arc, we call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              the
              %em source
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              the
              %em target
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(a)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t(a)
              respectively.
            %p
              A
              %em morphism
              from a digraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, A)
              to a digraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ′
                    %mo ,
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V', A')
              is a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi V
                    %mo →
                    %mi V
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f: V \to V'
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} (f(v), f(w)) \in A'
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (v, w) \in A
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Dgr
                    %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
          %p
            A digraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, A)
            may be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/quiver"} quiver
            in an evident way, with source and target functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ,
                    %mi t
                    %mo :
                    %mi A
                    %mo ⇉
                    %mi V
                  %annotation{:encoding => "application/x-tex"} s, t: A \rightrightarrows V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            is (equivalent to) a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the category of quivers
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quiv"} Quiv
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a, b
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s(a) = s(b)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t(a) = t(b)
          %p
            Some useful examples of digraphs are based on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ordinals"} ordinals
          #ExampleDigraph.num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is an ordinal, we may form a digraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, A)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the relation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi i
                      %mo ,
                      %mi i
                      %mo +
                      %mn 1
                      %mo ∈
                      %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{(i, i+1): i, i+1 \in \alpha\}
              %em ordinal digraph
              and denote it by the ordinal itself.
          #Walk.num_defn
            %h6#definition_2 Definition
            %p
              %strong (walk in a digraph)
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a digraph. A
              %em
                walk in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              is a digraph-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \alpha \to D
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is an ordinal digraph.
          %p
            Notice that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(1, D)
            may be identified with the set of vertices of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U = \mathsf{Dgr}(1, -): \mathsf{Dgr} \to Set
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \alpha = 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, D)
            may be identified with the set of arcs of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, -): \mathsf{Dgr} \to Set
            is very far from being faithful.
          %p
            If we let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            denote the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            consisting of the ordinal digraphs
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ,
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1, 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi C
                  %mo ↪
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} i: C \hookrightarrow \mathsf{Dgr}
            induces a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo =
                  %mi Quiv
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr} \to Set^{C^{op}} = Quiv
            according to the usual “
            %a.existingWikiWord{:href => "/nlab/show/nerve"}> nerve
            ” construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr} \to Set^{C^{op}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ↦
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi c
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D \mapsto (c \mapsto \mathsf{Dgr}(i c, D))
          %p
            and this nerve functor is exactly the full embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo →
                    %mi Quiv
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr} \to Quiv
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi D
                  %mo →
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f: D \to D'
            is an isomorphism iff the vertex-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(1, f)
            and arc-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, f)
            are isomorphisms (which is in any case obvious from the definition of digraph morphism, but this underscores the general importance of walks).
          %p
            Generally we will only be interested in walks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha \to D
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ≤
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \alpha \leq \omega
            in the sense of ordinals; here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is of course the first infinite ordinal. Unwinding the definitions, here is an elementary description of such walks:
          #WalkElementary.num_defn
            %h6#definition_3 Definition
            %p
              %strong (walk in a digraph; elementary definition)
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a digraph. A
              %em walk
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              consists of
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:lspace => "verythinmathspace"} :
                        %mi α
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} P\colon\alpha\rightarrow V
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ≤
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \alpha\leq\omega
            %p such that
            %ul
              %li
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi α
                      %annotation{:encoding => "application/x-tex"} i\in\alpha
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                        %mo ∈
                        %mi α
                      %annotation{:encoding => "application/x-tex"} i+1\in\alpha
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (P(i),P(i+1))\in A
            %p
              The phrase
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                \-vertex path
              means any
              = succeed "." do
                %em
                  path whose domain is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
          %p
            Some special cases: If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \alpha=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is called
            = succeed "." do
              %em the empty walk
            = succeed "-walk" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \omega \to D
            a
            %em ray
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          #cycle.num_example
            %h6#example_2 Example
            %p
              Another useful example of a digraph is a finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+order"} cyclic order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Z_n
              whose vertex set is the underlying set of the finite cyclic group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi i
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{(i, i+1): i \in \mathbb{Z}/n\}
          %h2#categorical_properties_of_
            Categorical properties of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            is not especially well-behaved for a category theorist. For example, it doesn’t have a terminal object (no, the ordinal digraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is not terminal), and it does not admit all coequalizers. In both cases the culprit is the irreflexivity condition.
          %p
            It does however have products indexed over nonempty sets, and equalizers. These limits are computed as they are in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Quiv"} Quiv
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Quiv
                  %annotation{:encoding => "application/x-tex"} Quiv
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{C^{op}}
          %p
            It follows from these observations that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            has pullbacks which are simply
            = succeed "-pullbacks;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Quiv
                  %annotation{:encoding => "application/x-tex"} Quiv
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 1
                    %mo ,
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} c = 1, 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            at each of the vertex and edge levels.
          %p
            In our development, it will be useful to characterize various classes of
            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
          #Mono.num_prop
            %h6#proposition Proposition
            %p
              A morphism of digraphs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f: D \to D'
              is monic iff its underlying function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(f)
              is monic (
              %a.existingWikiWord{:href => "/nlab/show/injective+function"}> injective
              ).
          .proof
            %h6#proof Proof
            %p
              It is well-known that faithful functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              reflect monomorphisms and epimorphisms. For suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(f)
              is monic. Given a diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %munderover
                      %mo ⇉
                      %mi h
                      %mi g
                    %mi D
                    %mover
                      %mo →
                      %mi f
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C \underoverset{h}{g}{\rightrightarrows} D \stackrel{f}{\to} D'
            %p
              if we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi g
                    %mo =
                    %mi f
                    %mo ∘
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f \circ g = f \circ h
              then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(f) \circ U(g) = U(f) \circ U(h)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(g) = U(h)
              by monicity of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is faithful, it follows that
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %mi h
                    %annotation{:encoding => "application/x-tex"} g = h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is monic. The argument for epimorphisms is dual.
            %p
              For the other direction, use the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U = \mathsf{Dgr}(1, -)
              is representable. It follows immediately from the definition of monomorphism that representable functors preserve monomorphisms, so if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is monic, then so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(f)
          %p (Still to come: characterization of regular monomorphisms.)
          %h2#paths_trails_and_cycles Paths, trails, and cycles
          #Path.num_defn
            %h6#definition_4 Definition
            %p
              %strong (path in a digraph)
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a digraph. A
              %em path
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a walk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi α
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} P: \alpha \to D
              whose underlying function is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injection"} injective
          %p
            Or what is the same, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(1, P)
            is a
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "," do
              %a.maruku-ref{:href => "#Mono"}
            %a.existingWikiWord{:href => "/nlab/show/path"} path
            in topology which is simply a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} [0, 1] \to X
            into a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          #Trail.num_defn
            %h6#definition_5 Definition
            %p
              %strong (trail in a digraph)
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D=(V,A)
              is a digraph. A
              %em trail
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a walk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mover
                      %mo ⟶
                      %mi P
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \alpha\overset{P}{\longrightarrow}V
              such that the
              %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi P
                    %mo :
                    %mi α
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} e_P: \alpha\rightarrow A
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_P(i)=(P(i),P(i+1))
              is injective.
          %p
            The domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi P
                %annotation{:encoding => "application/x-tex"} e_P
            is canonically identified with the arc set of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, P)
            (which we again denote as
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi P
                  %annotation{:encoding => "application/x-tex"} e_P
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, \alpha) \to \mathsf{Dgr}(2, D)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p We have the following easy result.
          #PathsAreTrails.num_prop
            %h6#proposition_2 Proposition
            %p
              In a digraph
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          .proof
            %h6#proof_2 Proof
            %p
              Since we just observed that a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the same as a monic walk, and since representable functors like
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, -)
              preserve monomorphisms, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi P
                    %mo =
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_P = \mathsf{Dgr}(2, P)
              is a monomorphism.
          %p Continuing the theme of monic digraph morphisms, we introduce the notion of cycle:
          .num_defn
            %h6#definition_6 Definition
            %p
              An
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %em cycle
              in a digraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a monic morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} P: Z_n \to D
              (see Example
              = succeed ")." do
                %a.maruku-ref{:href => "#cycle"}
              %em cycle
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is just an
              = succeed "-cycle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is
              %em acyclic
              if it admits no cycles.
          %p
            There is a natural bijection between digraph morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msub
                    %mi Z
                    %mi n
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C: Z_n \to D
            and walks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} P: \{0, \ldots, n\} \to D
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(0) = P(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo →
                  %msub
                    %mi Z
                    %mi n
                %annotation{:encoding => "application/x-tex"} q: \{0, \ldots, n\} \to Z_n
            defined as the mapping
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ↦
                    %mi i
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \mapsto i \mod n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msub
                    %mi Z
                    %mi n
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C: Z_n \to D
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi C
                    %mo ∘
                    %mi q
                  %annotation{:encoding => "application/x-tex"} P = C \circ q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            induces a bijection on arcs:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∼
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %msub
                    %mi Z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, q): \mathsf{Dgr}(2, \{0, \ldots, n\}) \stackrel{\sim}{\to} \mathsf{Dgr}(2, Z_n).
          %p
            Thus if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msub
                    %mi Z
                    %mi n
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C: Z_n \to D
            is
            = succeed "," do
              %em monic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %munderover
                    %mo →
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Dgr
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %mo ∼
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %msub
                    %mi Z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %munder
                    %mo →
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Dgr
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}(2, \{0, \ldots, n\}) \underoverset{\mathsf{Dgr}(2, q)}{\sim}{\to} \mathsf{Dgr}(2, Z_n) \underset{\mathsf{Dgr}(2, C)}{\to} \mathsf{Dgr}(2, D),
          %p
            which implies that the walk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            associated with a cycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msub
                    %mi Z
                    %mi n
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C: Z_n \to D
            is a trail.
          %h2#symmetrizing_and_weak_notions Symmetrizing and “weak” notions
          %p
            For various digraph (directed graph) notions above, it can be useful to consider parallel notions for
            %em undirected
            graphs. A slick method for doing this is by invoking a “symmetrizing”
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            construction.
          .num_defn
            %h6#definition_7 Definition
            %p
              For a digraph
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Symm(D)
              to have the same vertices as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v, w)
              is an arc of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Symm(D)
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v, w)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (w, v)
              is an arc of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
            Clearly the symmetric closure of an irreflexive relation remains irreflexive, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Symm
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Symm(D)
            is again a digraph, and the assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ↦
                  %mi Symm
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D \mapsto Symm(D)
            is the object part of an obvious functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                    %mo :
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                  %annotation{:encoding => "application/x-tex"} Symm: \mathsf{Dgr} \to \mathsf{Dgr}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo →
                  %mi Symm
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D \to Symm(D)
            that is the identity on vertices is the component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi D
                %annotation{:encoding => "application/x-tex"} u_D
            of a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %msub
                    %mn 1
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Dgr
                  %mo →
                  %mi Symm
                  %mo .
                %annotation{:encoding => "application/x-tex"} u: 1_\mathsf{Dgr} \to Symm.
          .num_theorem
            %h6#theorem Theorem
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                  %annotation{:encoding => "application/x-tex"} Symm
              carries an
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              structure.
          .proof
            %h6#proof_3 Proof
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mrow
                        %mi Symm
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mo :
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Symm
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_{Symm(D)}: Symm(D) \to Symm^2(D)
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (and even an identity map) because the operation of taking the symmetric closure of a relation is itself idempotent. Similarly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Symm(u_D)
              is also an identity map:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mrow
                          %mi Symm
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                      %mo =
                      %mi Symm
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u_{Symm(D)} = Symm(u_D)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %msup
                      %mi Symm
                      %mn 2
                    %mo →
                    %mi Symm
                  %annotation{:encoding => "application/x-tex"} m: Symm^2 \to Symm
              of the monad is defined by taking the inverse:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo =
                      %msubsup
                        %mi u
                        %mi Symm
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} m = u_{Symm}^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is natural and the unit law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∘
                    %msub
                      %mi u
                      %mi Symm
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} m \circ u_{Symm} = 1
              is automatic; the other unit law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∘
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m \circ Symm(u_D)
              follows. The associativity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              follows by inverting a naturality square for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
          %p
            Morally we may consider the category of undirected graphs to be the category of algebras over the monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                  %annotation{:encoding => "application/x-tex"} Symm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Dgr
                %annotation{:encoding => "application/x-tex"} \mathsf{Dgr}
            consisting of digraphs of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Symm(D)
          %p
            We proceed to “weaken” various of the notions above to take into account the undirected graph context, simply by applying the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Symm
                  %annotation{:encoding => "application/x-tex"} Symm
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is an ordinal digraph, a
              %em weak walk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \alpha \to D
              is defined to be a walk
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo →
                      %mi Symm
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \to Symm(D)
          %p
            (Obviously, a weak walk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha \to D
            need not be literally a walk
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \alpha \to D
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"} red herring principle
          %p
            Alternatively, we could define a weak walk to be a digraph morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Symm
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Symm
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Symm(\alpha) \to Symm(D)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is an ordinal digraph: the two ways of defining weak walks are (naturally) equivalent.
          %p Similarly,
          %ul
            %li
              %p
                A
                %em weak trail
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} \alpha \to D
                is defined to be a trail
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo →
                        %mi Symm
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha \to Symm(D)
            %li
              %p
                A
                %em weak cycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mi n
                      %mo →
                      %mi D
