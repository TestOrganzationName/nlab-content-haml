              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (w,v)\in A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ∈
                      %mi V
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi v
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} w\in V\setminus\{v\}
            %p
              For any finite
              %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
