                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                \-coking
              if and only if for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} u\in V
              there is at least one path of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
