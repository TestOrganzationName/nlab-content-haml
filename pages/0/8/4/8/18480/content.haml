                        %annotation{:encoding => "application/x-tex"} P\in \mathrm{WeCy}(D)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ∈
                        %mi{:mathvariant => "normal"} image
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} u\in \mathrm{image}(P)
                  %a.existingWikiWord{:href => "/nlab/show/and"} and
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (u,z(P))\in A
                  %a.existingWikiWord{:href => "/nlab/show/or"} or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (z(P),u)\in A
                  ) ) , then
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi A
                        %annotation{:encoding => "application/x-tex"} (u,z(P))\in A
          %p
            In words, the axioms mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            gives us one vertex on any given weak cycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            whose out-degree
            %em
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            is two. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z(P)
            witnesses
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %em made
            a cDAG in many ways: there usually are many functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            one can specify and that satisfy the axioms. We are here not interested in describing or counting these possibilities, rather in doing things with a given cDAG.
          %p
            There is an apparently inescapable arbitrariness in whether to favor out-neighbors or in-neighbor when defining
            = succeed "." do
              %em constructive DAG
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} (
