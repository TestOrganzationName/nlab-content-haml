            %p
              %strong (plane digraph)
            %p
              A
              %em plane digraph
              consists of the data
            %ul
              %li
                a subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
