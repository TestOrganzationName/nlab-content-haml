                  is the unique map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi colim
                          %mrow
                            %mi γ
                            %mo &lt;
                            %mi α
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi G
                        %mo{:stretchy => "false"} (
