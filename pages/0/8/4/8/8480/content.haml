                  %annotation{:encoding => "application/x-tex"} \kappa
          %p An arguably more elegant viewpoint on this is given in the following theorem and proof.
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
              %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible
              and
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon C \to C
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+an+endofunctor"} algebras
              is also locally presentable. In particular, there exists an initial
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for which the structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F X \to X
              is an isomorphism is also locally presentable (in particular, cocomplete and complete).
          .proof
            %h6#proof_4 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi F
                  %annotation{:encoding => "application/x-tex"} Alg_F
              is an
              %a.existingWikiWord{:href => "/nlab/show/inserter"} inserter
              construction, i.e., the data consisting of the evident 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Alg
                      %mi F
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \colon Alg_F \to C
              and 2-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F \circ U \to U
              is universal among all such data in the 2-category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Acc
                  %annotation{:encoding => "application/x-tex"} Acc
              is closed under 2-limits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
              such as inserters (see
              = succeed "," do
                %a{:href => "#MakkaiPare"} Makkai-Paré
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi F
                  %annotation{:encoding => "application/x-tex"} Alg_F
              is accessible. It is also complete since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is complete (being locally presentable) and the underlying functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Alg
                      %mi F
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} U \colon Alg_F \to F
              reflects limits. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi F
                  %annotation{:encoding => "application/x-tex"} Alg_F
              is accessible and complete, it is also cocomplete, hence contains an initial object.
            %p
              Similarly, the category of fixed points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} i \colon Fix(F) \to C
              is formed as an iso-inserter construction and is therefore accessible. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:lspace => "verythinmathspace"} :
                    %mi J
                    %mo →
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D \colon J \to Fix(F)
              is a diagram of fixed points and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in Ob(C)
              is the colimit of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∘
                      %mi D
                    %annotation{:encoding => "application/x-tex"} i \circ D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              induces a functor (which we give the same name)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi c
                      %mo{:stretchy => "false"} ↓
                      %mi C
                      %mo →
                      %mi c
                      %mo{:stretchy => "false"} ↓
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F\colon c \downarrow C \to c \downarrow C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} c \to d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} ↓
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \downarrow C
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∘
                      %mi D
                      %mo ≅
                      %mi F
                      %mo ∘
                      %mi i
                      %mo ∘
                      %mi D
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \circ D \cong F \circ i \circ D \to F(d)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \to F(d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} ↓
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \downarrow C
              is a locally presentable category, the accessible functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              acting on it has an initial algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo →
                      %mi c
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo →
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c \to c', (c \to F(c')) \to (c \to c'))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fix
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Fix(F)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix(F)
              is cocomplete and accessible.
          %p
            Boundedness conditions, such as those given as hypotheses in the previous two theorems, are generally required to establish existence of categorical fixed points. The example of the covariant power-set functor on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            shows that a naive generalization of the Knaster-Tarski theorem from complete lattices to complete/cocomplete categories is hopelessly false.
          %p Paul Taylor has built an elegant theory of locating certain initial algebras inside final coalgebras, via his notion of well-founded coalgebras. This too can be “categorified” (to be continued).
          %h3#fixed_points_of_left_exact_idempotent_endofunctors Fixed points of left exact idempotent endofunctors
          .num_theorem
            %h6#theorem_par_rosebrugh_wood Theorem (Paré, Rosebrugh, Wood)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a topos, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} F \colon E \to E
              be a left-exact idempotent
              = succeed "." do
                %em functor
              = succeed "-coalgebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose structure maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta \colon X \to F(X)
              are isomorphisms is a topos.
          %p Here “idempotent” involves a coassociativity condition.
          %p
            This theorem is a special case of a general theorem about categories of dialgebras for a
            = succeed "." do
              %span.newWikiWord
                diad
                %a{:href => "/nlab/new/diad"} ?
          .query
            %p Todd: To be related to structures over a modal operator, as at my web, or to diads a la Toby Kenney.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"}> fixed point of an adjunction
                ,
              %p
                including fixed points of
                %a.existingWikiWord{:href => "/nlab/show/Galois+correspondences"} Galois correspondences
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+group"} fixed point group
          %p
            %strong Theorems
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawvere%27s+fixed+point+theorem"} Lawvere's fixed point theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lefschetz+fixed+point+theorem"} Lefschetz fixed point theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kleene%27s+fixed+point+theorem"} Kleene's fixed point theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ad%C3%A1mek%27s+fixed+point+theorem"} Adámek's fixed point theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brouwer%27s+fixed+point+theorem"} Brouwer's fixed point theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-Bott+fixed+point+theorem"} Atiyah-Bott fixed point theorem
          %h2#references References
          %ul
            %li#Hermida97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Hermida"}> Claudio Hermida
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"} Bart Jacobs
                = succeed "," do
                  %em Structural induction and coinduction in a fibrational setting
                = succeed ")" do
                  %a{:href => "http://citeseer.ist.psu.edu/viewdoc/summary?doi=10.1.1.36.7400"} citeseer
            %li#MakkaiPare
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"}> Michael Makkai
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"} Robert Paré
                = succeed "," do
                  %em Accessible Categories: The Foundations of Categorical Model Theory
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Fixed_point_(mathematics%29"} Fixed point (mathematics)
          %p A version of the Knaster-Tarski fixed-point theorem is proved in constructive (and even predicative) set theory in
          %ul
            %li
              Giovanni Curi,
              = succeed "," do
                %em On Tarski’s fixed point theorem
              %strong 143
              (2015), 4439-4455 doi:
              %a{:href => "http://dx.doi.org/10.1090/proc/12569"} 10.1090/proc/12569
          %p
            as well as in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            in
          %ul
            %li
              Ian Ray,
              %em Tarski’s Least Fixed Point Theorem: A Type Theoretic Formulation
              (
              %a{:href => "https://arxiv.org/abs/2401.00841"}> arXiv:2401.00841
              )
          %p
            A relation to
            %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framed
            %a.existingWikiWord{:href => "/nlab/show/cobordism+classes"} cobordism classes
            and fixed points:
          %ul
            %li#Prieto03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carlos+Prieto"}> Carlos Prieto
                ,
                = succeed "," do
                  %em Fixed point theory and framed cobordism
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.tmna/1475266278"} Euclid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"}> Robert Paré
                ,
                %a.existingWikiWord{:href => "/nlab/show/R.+Rosebrugh"} R. Rosebrugh
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/R.+J.+Wood"} R. J. Wood
                = succeed "," do
                  %em Idempotents in bicategories
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/S0004972700003336"} doi:10.1017/S0004972700003336
            %li
              %p
                Toby Kenney,
                = succeed "," do
                  %em Diads and their Application to Topoi
