                  %annotation{:encoding => "application/x-tex"} F
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+algebra"} initial algebra
              (which by
              %a.existingWikiWord{:href => "/nlab/show/Lambek%27s+theorem"} Lambek's theorem
              is a fixed point of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          .proof
            %h6#proof_3 Proof
            %p
              Regarding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              as an ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi α
                    %mo &lt;
                    %mi κ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\alpha \lt \kappa\}
              (hence a poset, hence a category), define a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mi κ
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} G \colon \kappa \to C
              recursively: on objects, put
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} G(\emptyset) = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G(\alpha + 1) = F(G(\alpha))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi colim
                      %mrow
                        %mi α
                        %mo &lt;
                        %mi β
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(\beta) = colim_{\alpha \lt \beta} G(\alpha)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              a limit ordinal. On morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo &lt;
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \alpha \lt \beta
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi ∅
                        %mo &lt;
                        %mi β
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G(\emptyset \lt \beta)
                  is the unique map
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
