              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
                  a limit ordinal,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo &lt;
                        %mi β
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G(\alpha \lt \beta)
                  is a component of the cocone diagram that defines
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G(\beta)
                  as a colimit;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo +
                        %mn 1
                        %mo &lt;
                        %mi β
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi F
                        %mo{:stretchy => "false"} (
