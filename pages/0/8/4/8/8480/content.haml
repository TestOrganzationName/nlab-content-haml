                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/directed+diagrams"} directed diagrams
              for some
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon C \to C
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/directed+colimits"} directed colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
