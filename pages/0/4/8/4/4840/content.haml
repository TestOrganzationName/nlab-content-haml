              over the boundary of the simplex equals the integral of its
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              over the simplex itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo ∂
                        %mi σ
                    %mi ω
                    %mo =
                    %msub
                      %mo ∫
                      %mi σ
                    %mi d
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\partial \sigma} \omega = \int_\sigma d \omega
                    \\,.
          %p
            It follows that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/chain"} chain
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi C
                %annotation{:encoding => "application/x-tex"} \partial C
            its boundary
            = succeed "-chain," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mo ∂
                      %mi C
                  %mi ω
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi d
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\partial C} \omega = \int_{C} d \omega
                  \\,.
          %p More generally:
          #StokesTheoremForFiberIntegration.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (Stokes theorem for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is any
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^\bullet(U \times \Sigma)
              is a differential form on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber-wise
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_\Sigma \;\colon\;
                    \\Omega^{\bullet + dim(\Sigma)}(U \times \Sigma)
                    \\longrightarrow
                    \\Omega^\bullet(U)
            %p
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi Σ
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U \times \Sigma \overset{pr_1}{\to} U
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi d
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mo ∂
                          %mi Σ
                    %mi ω
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                    %mi d
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_\Sigma d \omega
                    \\;=\;
                    \\int_{\partial_\Sigma} \omega
                    +
                    (-1)^{dim(\Sigma)} d \int_\Sigma \omega
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GomiTerashima00"} Gomi &amp; Terashima 2000, remark 3.1
          %h3#FormulationInCohesiveHomotopyTypeTheory Abstract formulation in cohesive homotopy-type theory
          %p
            We discuss here a general abstract formulation of differential forms, their integration and Stokes theorem in the axiomatics of
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
            (following
            = succeed ")." do
              %a{:href => "#BunkeNikolausVoelkl13"} Bunke-Nikolaus-Völkl 13, theorem 3.2
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T \mathbf{H}
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+cohesive+%28%E2%88%9E%2C1%29-topos"} tangent cohesive (∞,1)-topos
          %p
            Assume that there is an
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo ∪
                  %mo *
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %msub
                        %mi i
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi Δ
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\ast \cup \ast \stackrel{(i_0, i_1)}{\longrightarrow}  \Delta^1
          %p
            “exhibiting the cohesion” (see at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            between the
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            and the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} L_{\Delta^1}
            at the the
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            maps out of
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            with this line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta^1\times (-) \to (-)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo ≃
                  %msub
                    %mi L
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi \simeq L_{\Delta^1}
                  \\,.
          %p
            This is the case for instance for the “standard
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p
            It follows in particular that there is a chosen
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi L
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\flat(\mathbf{H})\simeq L_{\Delta^1}\mathbf{H}
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat
            %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal homotopy-types
            and the
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+type"} stable homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mo ∈
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \hat E \in Stab(\mathbf{H})\hookrightarrow T \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            provides two objects
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi dR
                  %mi Ω
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ♭
                    %mi dR
                  %mi Σ
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Pi_{dR} \Omega \hat E \,,\;\;  \flat_{dR}\Sigma \hat E
                  \\;\;
                  \\in Stab(\mathbf{H})
          %p
            which may be interpreted as
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complexes"} de Rham complexes
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ♭
                      %mi dR
                    %mi Σ
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(\flat_{dR} \Sigma \hat E)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Π
                            %mi dR
                          %mi Ω
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                        %mtd
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %mi Σ
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ι
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi θ
                                  %mover
                                    %mi E
                                    %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Pi_{dR}\Omega \hat E &amp;&amp; \stackrel{\mathbf{d}}{\longrightarrow} &amp;&amp; \flat_{dR}\Sigma \hat E
                  \\\
                  \&amp; {}_{\mathllap{\iota}}\searrow &amp;&amp; \nearrow_{\mathrlap{\theta_{\hat E}}}
                  \\\
                  \&amp;&amp;
                  \\hat E
                  }
          %p
            which interprets as the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}
            %em
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+diagram"} differential cohomology diagram
            for details.
          %p
            Throughout in the following we leave the “inclusion”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                %annotation{:encoding => "application/x-tex"} \iota
            of “differential forms regarded as
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat E
            = succeed "-bundles\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          #CohesiveIntegrationOfDifferentialForms.num_defn
            %h6#definition Definition
            %p
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} Integration of differential forms
              is the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %msub
                      %mo ♭
                      %mi dR
                    %mi Σ
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msub
                      %mi Π
                      %mi dR
                    %mi Ω
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^1} \;\colon\;  [\Delta^1, \flat_{dR}\Sigma \hat E] \longrightarrow \Pi_{dR}\Omega \hat E
            %p
              which is induced via the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ♭
                      %mi dR
                    %mi Ω
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \flat_{dR}\Omega \hat E
              from the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              naturality square of the
              %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mo *
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %msub
                            %mi i
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [(\ast \coprod \ast \stackrel{(i_0, i_1)}{\to} \Delta ^1 ), -]
              %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null homotopy
              due to the
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta^1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \flat \hat E
          .num_prop
            %h6#proposition_2 Proposition
            %p Stokes’ theorem holds:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mo ∘
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi i
                      %mn 1
