                = succeed ")" do
                  %a{:href => "http://www.math.rochester.edu/people/faculty/doug/otherpapers/GM-Tate-543.pdf"} pdf
            %li
              %p
                D. Tambara,
                = succeed "," do
                  %em The Drinfeld center of the category of Mackey functors
                = succeed "," do
                  %strong 319
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1016/j.jalgebra.2008.02.011"} doi:10.1016/j.jalgebra.2008.02.011
            %li
              %p
                Elango Panchadcharam,
                = succeed "," do
                  %em Categories of Mackey Functors
            %li#Kronholm10
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Kronholm"}> William Kronholm
                ,
                = succeed "," do
                  %em
                    The
                    = succeed "-graded" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi RO
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} RO(G)
                = succeed "," do
                  %a{:href => "http://www.swarthmore.edu/NatSci/wkronho1/serre.pdf"} pdf
                = succeed ")," do
                  %a{:href => "https://projecteuclid.org/euclid.hha/1296223823"} Euclid
          %p
            For Mackey functors
            %a.existingWikiWord{:href => "/nlab/show/enriched"} enriched
            over
            %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Niles+Johnson"}> Niles Johnson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Donald+Yau"} Donald Yau
              %em Homotopy Theory of Enriched Mackey Functors
              (
              %a{:href => "https://arxiv.org/abs/2212.04276"}> arXiv:2212.04276
              )
          %p
            Relation of Mackey functors to
            %a.existingWikiWord{:href => "/nlab/show/sheaves+with+transfer"} sheaves with transfer
            in the theory of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/motives"} motives
          %ul
            %li#KahnYamazaki11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Kahn"}> Bruno Kahn
                , Takao Yamazaki,
                = succeed "," do
                  %em Voevodsky’s motives and Weil reciprocity
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1108.2764"} arXiv:1108.2764
            %li#Weibel05
              %p
                Weibel, Charles.
                %em Transfer functors on k-algebras.
                Journal of Pure and Applied Algebra 201.1-3 (2005): 340-366
            %li#Voevodsky00
              %p
                Voevodsky, Vladimir.
                %em Triangulated categories of motives over a field.
                Cycles, transfers, and motivic homology theories 143 (2000): 188-238.
          %p
            %a.existingWikiWord{:href => "/nlab/show/categorification"} Categorification
            to Mackey
            %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
            is discussed found in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Balmer"}> Paul Balmer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ivo+Dell%27Ambrogio"} Ivo Dell'Ambrogio
              = succeed "," do
                %em Mackey 2-functors and Mackey 2-motives
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1808.04902"} arXiv:1808.04902
          %h3#spectral_mackey_functors Spectral Mackey functors
          %p
            See the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Spectral+Mackey+functor+theorem"} Spectral Mackey functor theorem
          %ul
            %li#Barwick14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
                ,
                = succeed "," do
                  %em Spectral Mackey functors and equivariant algebraic K-theory (I)
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/j.aim.2016.08.043"} doi:10.1016/j.aim.2016.08.043
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1404.0108"} arXiv:1404.0108
            %li#Barwick15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Saul+Glasman"} Saul Glasman
                %em Spectral Mackey functors and equivariant algebraic K-theory (II)
                (
                %a{:href => "http://arxiv.org/abs/1505.03098"}> arXiv:1505.03098
                )
            %li#Glasman15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+Glasman"}> Saul Glasman
                ,
                %em Stratified categories, geometric fixed points and a generalized Arone-Ching theorem
                (
                %a{:href => "https://arxiv.org/abs/1507.01976"}> arXiv:1507.01976
                ,
                = succeed ")" do
                  %a{:href => "http://www-users.math.umn.edu/~sglasman/strattalk.pdf"} talk notes pdf
          %h4#in_equivariant_stable_homotopy_theory In equivariant stable homotopy theory
          %p
            The construction of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+homotopy+theory"} equivariant stable homotopy theory
            in terms of spectral Mackey functors is originally due to
          %ul
            %li#GuillouMay11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Guillou"}> Bert Guillou
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                %em
                  Models of
                  = succeed "-spectra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/1110.3571"} arXiv:1110.3571
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Guillou"}> Bert Guillou
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em
                    Permutative
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi G
                          %annotation{:encoding => "application/x-tex"} G
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1207.3459"} arXiv:1207.3459
            %li#Nardin12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis+Nardin"}> Denis Nardin
                , section 2.6 and appendix A of
                = succeed "," do
                  %em Stability and distributivity over orbital ∞-categories
                = succeed "," do
                  %a{:href => "http://hdl.handle.net/1721.1/112895"} hdl.handle.net/1721.1/112895
                = succeed ")" do
                  %a{:href => "https://www.math.univ-paris13.fr/~nardin/thesis.pdf"} pdf
          %p
            The generalization of
            %a.existingWikiWord{:href => "/nlab/show/K-theory+of+permutative+categories"} K-theory of permutative categories
            to spectral Mackey functors is discussed in
          %ul
            %li#BohmannOsorno14
              %a.existingWikiWord{:href => "/nlab/show/Anna+Marie+Bohmann"}> Anna Marie Bohmann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ang%C3%A9lica+Osorno"} Angélica Osorno
              = succeed "," do
                %em Constructing equivariant spectra via categorical Mackey functors
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1405.6126"} arXiv:1405.6126
          %h4#in_goodwillie_calculus In Goodwillie calculus
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
            via
            %a.existingWikiWord{:href => "/nlab/show/spectral+Mackey+functors"} spectral Mackey functors
          %ul
            %li#Glasman16
              %a.existingWikiWord{:href => "/nlab/show/Saul+Glasman"}> Saul Glasman
              ,
              %em Goodwillie calculus and Mackey functors
              (
              %a{:href => "https://arxiv.org/abs/1610.03127"}> arXiv:1610.03127
              )
