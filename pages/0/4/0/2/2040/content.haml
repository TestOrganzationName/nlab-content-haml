                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  \-algebras and modular representation theory
                (
                %a{:href => "https://infoscience.epfl.ch/server/api/core/bitstreams/403da7d5-c09b-40a9-9fd3-609d43f67517/content"}> pdf
                )
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "," do
                  %em Transformation groups
            %li
              %p
                Serge Bouc, chapter 1 of
                = succeed "," do
                  %em Green Functors and G-sets
                %a{:href => "http://dx.doi.org/10.1007/BFb0095821"} doi:10.1007/BFb0095821
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                , Equivariant homology and Mackey functors, Mathematische Annalen
                = succeed "," do
                  %strong 206
                %a{:href => "http://dx.doi.org/10.1007/BF01431529"} doi:10.1007/BF01431529
            %li#GreenleesMay95
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
