                %em A remark on Mackey-functors
              = succeed ")" do
                %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/lindner.pdf"} pdf
          %p Reviews and surveys:
          %ul
            %li#Blumberg17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
                , section 3.2 of
                = succeed "," do
                  %em The Burnside category
                = succeed "," do
                  %a{:href => "https://www.ma.utexas.edu/users/a.debray/lecture_notes/m392c_EHT_notes.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://github.com/adebray/equivariant_homotopy_theory"} GitHub
            %li#tomDieck87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                , Section II.9 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Transformation+Groups"} Transformation Groups
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/9783110858372"} doi:10.1515/9783110858372
            %li#GreenleesMay95
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Equivariant stable homotopy theory
                %em Handbook of Algebraic Topology
                , pp. 279-325. 1995. (
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/Newthird.pdf"}> pdf
                )
            %li#May96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , section IX.4 of
                %em Equivariant homotopy and cohomology theory
                CBMS Regional Conference Series in Mathematics, vol. 91, Published for the Conference Board of the Mathematical Sciences, Washington, DC, 1996. With contributions by M. Cole, G. Comezana, S. Costenoble, A. D. Elmenddorf, J. P. C. Greenlees, L. G. Lewis, Jr., R. J. Piacenza, G. Triantafillou, and S. Waner. (
                %a{:href => "http://www.math.rochester.edu/u/faculty/doug/otherpapers/alaska1.pdf"}> pdf
                )
            %li#Schwede15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                , around p. 16 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Lectures+on+Equivariant+Stable+Homotopy+Theory"} Lectures on Equivariant Stable Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.uni-bonn.de/people/schwede/equivariant.pdf"} pdf
            %li
              %p
                Peter Webb,
                %em A Guide to Mackey Functors
                (
                %a{:href => "http://www.math.rochester.edu/people/faculty/doug/otherpapers/WebbMF.pdf"}> pdf
                )
            %li
