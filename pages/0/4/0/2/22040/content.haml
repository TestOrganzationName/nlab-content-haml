                  \\overset{ cofib }{\longrightarrow}
                  Th(\mathcal{V}_X)
                  \\,.
          %p
            Finally, since the
            %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
            of the unit disk bundle is manifestly the
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            that exibits this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
          #eq:ZeroSectionIntoTheThomSpace.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 0
                    %mi X
