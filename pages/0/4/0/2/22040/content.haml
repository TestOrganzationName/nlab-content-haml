                            %mi 𝒱
                            %mi X
                          %mo{:stretchy => "false"} )
                  %mi D
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒱
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mi cofib
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi i
