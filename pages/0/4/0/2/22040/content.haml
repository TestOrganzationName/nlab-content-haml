            %p
              (Here the left vertical map picks any point of the sphere bundle. There is then a unique horizontal map on the left to make the left square
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            %p
              Now, since the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(S(\mathbb{K}))
              does have the structure of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (given, for instance, by its realization as infinite
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+space"} quaternionic
              %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}P^\infty
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/cell+structure+of+projective+space"} cell structure of projective space
              %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
              here represents, as in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ThomSpaceAsActualCofiber"} (5)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofibers"} homotopy cofibers
              are preserved, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              = succeed ")," do
                %a{:href => "Introduction+to+Homotopy+Theory#FiberOfFibrationIsCompatibleWithWeakEquivalences"} this Prop.
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %p
              This is the statement that was to be shown. Or more explicitly: By
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              also the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              vertical morphism on the right is a weak homotopy equivalence, which is the desired morphism in the form
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ZeroSectionIntoTheThomSpace"} (6)
          %p
          .num_prop
            %h6 Proposition
            %p
              The composition of the above canonical
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              inclusion with the above
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi S
                      %mrow
                        %mi dim
                        %mi 𝕂
                    %mo →
                    %mi B
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Th(\mathbb{K})
                    \=S^{dim\mathbb{K}}
                    \\rightarrow B S(\mathbb{K})
                    \\rightarrow Th(E S(\mathbb{K})\times_{S(\mathbb{K})}\mathbb{K})
            %p
              is homotopic to a map induced on Thom spaces by a fiber inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                      %mo ↪
                      %mi E
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mrow
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}\hookrightarrow E S(\mathbb{K})\times_{S(\mathbb{K})}\mathbb{K}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mi dim
                          %mi 𝕂
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mrow
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{dim\mathbb{K}}Th(E S(\mathbb{K})\times_{S(\mathbb{K})}\mathbb{K})
