                  {cofib\big(  i_{S_X(\mathcal{V}_X)} \big)}
                  {\longrightarrow}
                  Th(\mathcal{V}_X)
          %p
            the zero-section
            %em into
            the Thom spaces.
          %h2#statement Statement
          %p
          #TheStatement.num_prop
            %h6 Proposition
            %p
              The zero-section
              %a.maruku-eqref{:href => "#eq:ZeroSectionIntoTheThomSpace"} (6)
              into the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the universal
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              %a.maruku-eqref{:href => "#eq:UniversalKLineBundle"} (3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Th
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi S
                                %mo{:stretchy => "false"} (
                                %mi 𝕂
                                %mo{:stretchy => "false"} )
                            %mi 𝕂
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mn 0
                                        %mrow
                                          %mi B
                                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                          %mi S
                                          %mo{:stretchy => "false"} (
                                          %mi 𝕂
                                          %mo{:stretchy => "false"} )
                                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mrow
                                  %mpadded{:width => "0"}
                                    %mo ≃
                        %mtr
                          %mtd
                            %mi B
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Th
                    \\Big(
                    E (S(\mathbb{K}))
                    \\underset{
                    S(\mathbb{K})
                    }{\times}
                    \\mathbb{K}
                    \\Big)
                    \\\
                    {}^{{}_{\mathllap{
                    0_{
                    B \big(
                    S(\mathbb{K})
                    \\big)
                    }
                    }}}
                    \\big\uparrow
                    {}^{{}_{
                    \\mathrlap{\simeq}}
                    }
