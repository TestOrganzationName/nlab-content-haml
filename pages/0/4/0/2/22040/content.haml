                    }
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          %p
          .proof
            %h6 Proof
            %p
              The point is that for the universal
              %em line
              bundle, the associated
              %a.existingWikiWord{:href => "/nlab/show/sphere+bundle"} sphere bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalent"} homotopy equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              and hence
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"} weakly contractible
            %p One way to see it is to unwind the definition of the unit sphere bundle in the universal line bundle as follows:
            #eq:SphereBundleOfUniversalLineBundleIsContractible.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi B
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi E
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi I
                    %munder
                      %mo ×
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                    %mi 𝕂
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi E
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{B \big(S(\mathbb{K})\big)}
                    \\Big(
                    E\big(S(\mathbb{K})\big)
                    I       \underset{S(\mathbb{K})}{\times}
                    \\mathbb{K}
                    \\Big)
                    \\;=\;
                    \\Big(
                    E\big(S(\mathbb{K})\big)
                    \\underset{S(\mathbb{K})}{\times}
                    S(\mathbb{K})
                    \\Big)
                    \\;=\;
                    E\big(S(\mathbb{K})\big)
                    \\;\simeq\;
                    \\ast
                    \\,.
            %p#ViaContractibleInfiniteDimensionalSpheres
              Another way to see the same is to observe that the sphere bundle associated to the universal line bundle is the
              %a.existingWikiWord{:href => "/nlab/show/sequential+colimit"} sequential colimit
              over the
              %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              over the finite-dimensional
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              (see
              = succeed ")." do
                %a{:href => "tautological+line+bundle#eq:TautologicalPrincipalBundleOverProjectiveSpace"} there
              %a.maruku-eqref{:href => "#eq:SphereBundleOfUniversalLineBundleIsContractible"} (7)
              follows from the fact that
              %a.existingWikiWord{:href => "/nlab/show/the+infinite-dimensional+sphere+is+weakly+contractible"} the infinite-dimensional sphere is weakly contractible
              (see
              = succeed "):" do
