                %annotation{:encoding => "application/x-tex"} D_X(\mathcal{V}_X)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
