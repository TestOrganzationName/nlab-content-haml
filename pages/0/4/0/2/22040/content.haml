          %h3#thom_spaces Thom spaces
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of a
            %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
