            via the above action
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:KAsSKRepresentation"} (2)
          #eq:UniversalKLineBundle.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
