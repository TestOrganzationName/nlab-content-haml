                          %mo +
                          %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                      %mo →
                      %msub
                        %mi M
                        %mrow
                          %mi α
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi_{\alpha + 1}\colon T \to M_{\alpha + 1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \phi_\alpha
              at limit ordinals, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi α
                  %annotation{:encoding => "application/x-tex"} M_\alpha
              is a limit monad, is clear. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T \to M
