          %h3#idempotent_strong_monads_are_commutative Idempotent strong monads are commutative
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, I)
              be a monoidal category and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T, \mu, \eta)
              be an idempotent monad on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with compatible left and right
              %a.existingWikiWord{:href => "/nlab/show/strong+monad"} strengths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                    %mo :
                    %mi TA
                    %mo ⊗
                    %mi B
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t_{A, B} : TA \otimes B \to T(A \otimes B)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %msub
                        %mo ′
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mo :
                      %mi A
                      %mo ⊗
                      %mi TB
                      %mo →
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t'_{A, B} : A \otimes TB \to T(A \otimes B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative monad
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+monad"} monoidal monad
          %p
          .proof
            %h6 Proof
            %p
