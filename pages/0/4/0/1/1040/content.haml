          %p
            Alternatively we can deduce this from the fact that that
            %a.existingWikiWord{:href => "/nlab/show/thunk-force+category"} thunkable
            morphisms are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/premonoidal+category"} central
            = succeed ".)" do
              %a{:href => "https://www.cs.bham.ac.uk/~pbl/papers/thunkcentral.pdf"} there
          %p
          .num_theorem
            %h6 Theorem
            %p
              If furthermore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category+with+diagonals"} monoidal category with diagonals
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi A
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %mo ⊗
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Delta_A : A \to A \otimes A
              %a.existingWikiWord{:href => "/nlab/show/monoidal+monad"} monoidal monad
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monoidal+functor"} idempotent
