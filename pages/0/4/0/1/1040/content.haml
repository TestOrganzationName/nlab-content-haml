            %p as required.
            %p
              Finally we must check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ↦
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \mapsto E(M)
              satisfies the appropriate universal property. Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is an idempotent monad with unit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \phi\colon T \to M
              be a monad map. We define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %msub
                      %mi M
                      %mi α
                  %annotation{:encoding => "application/x-tex"} T \to M_\alpha
              by induction: given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                      %mo →
                      %msub
                        %mi M
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \phi_\alpha\colon T \to M_\alpha
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi α
                    %msub
                      %mi M
                      %mi α
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi ϕ
                      %mi α
                    %mo =
                    %msub
                      %mi ϕ
                      %mi α
                    %msub
                      %mi ϕ
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi α
                    %msub
                      %mi ϕ
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mi α
                    %msub
                      %mi u
                      %mi α
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi ϕ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} (u_\alpha M_\alpha)\phi_\alpha = \phi_\alpha \phi_\alpha (v T) = \phi_\alpha \phi_\alpha (T v) = (M_\alpha u_{\alpha})\phi_\alpha
            %p
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \phi_{\alpha}
              factors uniquely through the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
