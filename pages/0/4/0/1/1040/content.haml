                          %mo +
                          %mn 1
                      %mo ↪
                      %msub
                        %mi M
                        %mi α
                    %annotation{:encoding => "application/x-tex"} M_{\alpha + 1} \hookrightarrow M_\alpha
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
