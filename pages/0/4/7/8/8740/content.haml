                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\pi(f \otimes g)
                  \\;=\;
                  \\pi^{i j}
                  (\partial_i f) \otimes (\partial_j g)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi i
                  %mi f
                  %mo ≔
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi f
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                %annotation{:encoding => "application/x-tex"} \partial_i f \coloneqq \frac{\partial f}{\partial x^i}
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
