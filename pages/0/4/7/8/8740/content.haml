                            %mi prod
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %mi prod
                            %mo ⊗
                            %mi id
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi π
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} (
