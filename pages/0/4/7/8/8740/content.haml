                                    %mi l
                                %msub
                                  %mo ∂
                                  %mi k
                                %mo ⊗
                                %msub
                                  %mo ∂
                                  %mi l
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mo ⊗
                              %mi id
                              %mo )
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ⊗
                            %mi g
                            %mo ⊗
                            %mi g
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi prod
                            %mo ∘
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi π
                              %mrow
                                %mi i
                                %mi j
                            %msub
                              %mo ∂
                              %mi i
                            %mo ⊗
                            %msub
                              %mo ∂
                              %mi j
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %mi prod
                            %mo ⊗
                            %mi id
                            %mo{:stretchy => "false"} )
