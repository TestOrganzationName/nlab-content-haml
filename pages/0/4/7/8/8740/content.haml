                              %mo ⋆
                              %mi π
                            %mi g
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⋆
                              %mi π
                            %mi h
                          %mtd
                            %mo =
                            %mi prod
                            %mo ∘
                            %mi exp
