                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J = (J^i{}_j)
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\,.
            %p Moreover let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ω
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = (\omega_{i j}) \coloneqq \left( \array{0 &amp; 1 \\ -1 &amp; 0} \right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = (g_{i j}) \coloneqq \left( \array{ 1 &amp; 0 \\ 0 &amp; 1}  \right)
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi J
                    %mo ,
                    %mi ω
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, J, \omega, g)
              is a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlmostKaehlerVectorSpace"}
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              in the standard way and equipped with the
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ,
                    %mi ω
                    %mi g
                  %annotation{:encoding => "application/x-tex"} J, \omega g
              extended as constant rank-2
              %a.existingWikiWord{:href => "/nlab/show/tensors"} tensors
              over this manifold.
            %p If we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x,y \;\colon\; \mathbb{R}^2 \longrightarrow \mathbb{R}
            %p
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ≔
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    z \coloneqq x + i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi z
                      %mo ¯
                    %mo ≔
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{z} \coloneqq x - i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p for the corresponding complex coordinates, then this translates to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\in
                    \\Omega^2(\mathbb{R}^2)
            %p
              being the
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                          %mtd
                            %mo =
                            %mi d
                            %mi x
                            %mo ∧
                            %mi d
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi i
                            %mi d
                            %mi z
                            %mo ∧
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega
                    \&amp; =
                    d x \wedge d y
                    \\\
                    \&amp; =
                    \\tfrac{1}{2i} d z \wedge d \overline{z}
                    \\end{aligned}
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi d
                    %mi x
                    %mo ⊗
                    %mi d
                    %mi x
                    %mo +
                    %mi d
                    %mi y
                    %mo ⊗
                    %mi d
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = d x \otimes d x + d y \otimes d y
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi h
                          %mtd
                            %mo =
                            %mi g
                            %mo −
                            %mi i
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mi z
                            %mo ⊗
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h
                    \&amp; =
                    g - i \omega
                    \\\
                    \&amp; =
                    d z \otimes d \overline{z}
                    \\end{aligned}
          %p
            (for more see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            = succeed ")." do
              %a{:href => "Kähler+vector+space#StandardAlmostKaehlerVectorSpaces"} this example
          #WickAlgebraOfAlmostKaehlerVectorSpace.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %mi σ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^{2n},\sigma, g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlmostKaehlerVectorSpace"}
              %em Wick algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}[ [ \mathbb{R}^{2n}  ] ] [ [ \hbar ] ]
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarPoduct"}
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            #eq:InStarProductTensorInvertingHermitianForm.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \coloneqq \tfrac{i}{2} \omega^{-1} + \tfrac{1}{2} g^{-1}
                    \\,,
            %p hence:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %msub
                              %mo ⋆
                              %mi π
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi exp
                            %mrow
                              %mo (
                              %mi ℏ
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %msub
                                    %mi k
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mi k
                                    %mn 2
                                  %mo =
                                  %mn 1
                                %mrow
                                  %mn 2
                                  %mi n
                              %msup
                                %mi π
                                %mrow
                                  %mi a
                                  %mi b
                              %msub
                                %mo ∂
                                %mi a
                              %mo ⊗
                              %msub
                                %mo ∂
                                %mi b
                              %mo )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi A
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi A
                              %mn 1
                            %mo ⋅
                            %msub
                              %mi A
                              %mn 2
                            %mo +
                            %mi ℏ
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi k
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi k
                                  %mn 2
                                %mo =
                                %mn 1
                              %mrow
                                %mn 2
                                %mi n
                            %msup
                              %mi π
                              %mrow
                                %msub
                                  %mi k
                                  %mn 1
                                %msub
                                  %mi k
                                  %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi k
                                  %mn 1
                            %msub
                              %mi A
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi k
                                  %mn 2
                            %msub
                              %mi A
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_1 \star_\pi A_2
                    \&amp; \coloneqq
                    ((-)\cdot (-)) \circ \exp \left( \hbar\underoverset{k_1, k_2 = 1}{2 n}{\sum}\pi^{a b} \partial_a \otimes  \partial_b \right)  (A_1 \otimes A_2)
                    \\\
                    \&amp; =
                    A_1 \cdot A_2 + \hbar \underoverset{k_1, k_2 = 1}{2n}{\sum}\pi^{k_1 k_2}(\partial_{k_1} A_1) \cdot (\partial_{k_2} A_2)
                    + \cdots
                    \\end{aligned}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Collini16"} Collini 16, def. 1
          #StarProductAlgebraOfKaehlerVectorSpaceIsStarAlgebra.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi π
                  %annotation{:encoding => "application/x-tex"} \star_\pi
              of a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              structure (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathbb{C}[ [\mathbb{R}^{2n}] ][ [\hbar] ]
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mi A
                          %mn 1
                        %msub
                          %mo ⋆
                          %mi π
                        %msub
                          %mi A
                          %mn 2
                        %mo )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi A
                      %mn 2
                      %mo *
                    %msub
                      %mo ⋆
                      %mi π
                    %msubsup
                      %mi A
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\left( A_1 \star_\pi A_2 \right)^\ast
                    \\;=\;
                    A_2^\ast \star_\pi A_1^\ast
          .proof
            %h6#proof_5 Proof
            %p
              This follows directly from that fact that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi = \tfrac{i}{2} \omega^{-1} + \tfrac{1}{2} g^{-1}
              the
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              coincides with the skew-symmetric part, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi π
                              %mo *
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi i
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi i
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi b
                                %mi a
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi b
                                %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi π
                              %mrow
                                %mi b
                                %mi a
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\pi^\ast)^{a b}
                    \&amp; =
                    \-\tfrac{i}{2} (\omega^{-1})^{a b}
                    + \tfrac{1}{2} (g^{-1})^{a b}
                    \\\
                    \&amp; =
                    \\tfrac{i}{2} (\omega^{-1})^{b a}
                    +
                    \\tfrac{1}{2} (g^{-1})^{b a}
                    \\\
                    \&amp; = \pi^{b a}
                    \\,.
                    \\end{aligned}
          #WickAlgebraOfASingleMode.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                of a single mode)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \coloneqq \mathbb{R}^2 \simeq Span(\{x,y\})
              be the standard
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              according to example
              = succeed "," do
                %a.maruku-ref{:href => "#StandardAlmostKaehlerVectorSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
              and show that this reproduces the traditional definition of products of “normal ordered” operators as
              = succeed "." do
                %a{:href => "#Idea"} above
            %p To that end, consider the complex linear combination of the coordinates to the canonical complex coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mover
                      %mi z
                      %mo ¯
                    %mo ≔
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                  %annotation{:encoding => "application/x-tex"}
                    z \;\coloneqq\; x + i y
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\overline{z} \coloneqq x - i y
            %p which we use in the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    a^\ast \;\coloneqq\; \tfrac{1}{\sqrt{2}}(x + i y)
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    a \;\coloneqq\; \tfrac{1}{\sqrt{2}}(x - i y)
            %p
              (with “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              ” the traditional symbol for the
              %em
                %a.existingWikiWord{:href => "/nlab/show/amplitude"} amplitude
              of a field mode).
            %p Now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo −
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\omega^{-1}
                    \=
                    \\frac{\partial}{\partial y} \otimes \frac{\partial}{\partial x}
                    \-
                    \\frac{\partial}{\partial x} \otimes \frac{\partial}{\partial y}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo +
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    g^{-1}
                    \=
                    \\frac{\partial}{\partial x}
                    \\otimes
                    \\frac{\partial}{\partial x}
                    +
                    \\frac{\partial}{\partial y}
                    \\otimes
                    \\frac{\partial}{\partial y}
            %p so that with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi z
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi x
                      %mo −
                      %mi i
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi y
                      %mo )
                    %mphantom
                      %mi AAAA
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mover
                          %mi z
                          %mo ¯
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mrow
                      %mo (
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi x
                      %mo +
                      %mi i
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial}{\partial z}
                    \=
                    \\tfrac{1}{2}
                    \\left(
                    \\frac{\partial}{\partial x}
                    \-i
                    \\frac{\partial}{\partial y}
                    \\right)
                    \\phantom{AAAA}
                    \\frac{\partial}{\partial \overline{z}}
                    \=
                    \\frac{1}{2}
                    \\left(
                    \\frac{\partial}{\partial x}
                    +
                    i
                    \\frac{\partial}{\partial y}
                    \\right)
            %p we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi i
                                  %mi ℏ
                                %mn 2
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi ℏ
                                %mn 2
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                            %mo =
                            %mn 2
                            %mi ℏ
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mover
                                  %mi z
                                  %mo ¯
                            %mo ⊗
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mi z
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ℏ
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mi a
                            %mo ⊗
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi a
                                  %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tfrac{i \hbar}{2}\omega^{-1} + \tfrac{\hbar}{2} g^{-1}
                    \&amp; =
                    2 \hbar
                    \\frac{\partial}{\partial \overline{z}}
                    \\otimes
                    \\frac{\partial}{\partial z}
                    \\\
                    \&amp; =
                    \\hbar \frac{\partial}{\partial a} \otimes \frac{\partial }{\partial a^\ast}
                    \\end{aligned}
            %p
              Using this, we find the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⋆
                      %mi π
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %mi ℏ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi a
                      %mo ⊗
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi a
                            %mo *
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    A \star_\pi B
                    \\;=\;
                    prod \circ \exp\left( \hbar \frac{\partial}{\partial a} \otimes \frac{\partial }{\partial a^\ast}  \right)
            %p
              to be as follows (where we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\cdot (-)
              for the plain commutative product in the
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi a
                            %msub
                              %mo ⋆
                              %mi π
                            %mi a
                          %mtd
                            %mo =
                            %mi a
                            %mo ⋅
                            %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi a
                              %mo *
                            %msub
                              %mo ⋆
                              %mi π
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo =
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %msup
                              %mi a
                              %mo *
                        %mtr
                          %mtd
                            %msup
                              %mi a
                              %mo *
                            %msub
                              %mo ⋆
                              %mi π
                            %mi a
                          %mtd
                            %mo =
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %mi a
                        %mtr
                          %mtd
                            %mi a
                            %msub
                              %mo ⋆
                              %mi π
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo =
                            %mi a
                            %mo ⋅
                            %msup
                              %mi a
                              %mo *
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi ℏ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    a \star_\pi a &amp; = a \cdot a
                    \\\
                    a^\ast \star_\pi a^\ast &amp; = a^\ast \cdot a^\ast
                    \\\
                    a^\ast \star_\pi a &amp; = a^\ast \cdot a
                    \\\
                    a \star_\pi a^\ast
                    \&amp; =
                    a \cdot a^\ast + \hbar
                    \\end{aligned}
            %p and so forth, for instance
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⋅
                            %mi a
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⋆
                              %mi π
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %msup
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %mi a
                            %mo ⋅
                            %mi a
                            %mo +
                            %mn 4
                            %mi ℏ
                            %msup
                              %mi a
                              %mo *
                            %mo ⋅
                            %mi a
                            %mo +
                            %msup
                              %mi ℏ
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (a \cdot a ) \star_\pi (a^\ast \cdot a^\ast)
                    \&amp; =
                    a^\ast \cdot a^\ast \cdot a \cdot a
                    +
                    4 \hbar a^\ast \cdot a
                    +
                    \\hbar^2
                    }
            %p If we instead indicate the commutative pointwise product by colons and the star product by plain juxtaposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo :
                    %mi f
                    %mi g
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ⋅
                    %mi g
                    %mphantom
                      %mi AAAA
                    %mi f
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %msub
                      %mo ⋆
                      %mi π
                  %annotation{:encoding => "application/x-tex"}
                    \:f g: \;\coloneqq\; f \cdot g
                    \\phantom{AAAA}
                    f g \;\coloneqq\; f \star_\pi
            %p then this reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo :
                            %mi a
                            %mi a
                            %mo :
                            %mspace{:width => "thinmathspace"}
                            %mo :
                            %msup
                              %mi a
                              %mo *
                            %msup
                              %mi a
                              %mo *
                            %mo :
                          %mtd
                            %mo =
                            %mo :
                            %msup
                              %mi a
                              %mo *
                            %msup
                              %mi a
                              %mo *
                            %mi a
                            %mi a
                            %mo :
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 4
                            %mi ℏ
                            %mspace{:width => "thinmathspace"}
                            %mo :
                            %msup
                              %mi a
                              %mo *
                            %mi a
                            %mo :
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msup
                              %mi ℏ
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \:a a: \, :a^\ast a^\ast:
                    \&amp; =
                    \: a^\ast a^\ast a  a :
                    +
                    4 \hbar \, : a^\ast a :
                    +
                    \\hbar^2
                    }
            %p
              This is the way the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              with its
              %em
                %a.existingWikiWord{:href => "/nlab/show/operator+product"} operator product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi π
                  %annotation{:encoding => "application/x-tex"} \star_\pi
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/normal-ordered+product"} normal-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo :
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                  %annotation{:encoding => "application/x-tex"} :-:
              is traditionally presented.
          %h4#infinitedimensional Infinite-dimensional
          #WickAlgebras.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/normal-ordered+products"} normal-ordered products
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            %p
              In cases where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is
              %em not
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              of a linear
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %a.maruku-ref{:href => "#StarPoduct"}
              still may be interpreted as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              %a.existingWikiWord{:href => "/nlab/show/wavefront+sets"} wavefront sets
              satisfy
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            %p
              In these situations it happens that the star product for some Poisson tensor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}\pi
              is not defined due to
              %a.existingWikiWord{:href => "/nlab/show/wavefront+set"} wavefront set
              collision (violation of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mi π
                        %mo +
                        %mi α
                  %annotation{:encoding => "application/x-tex"} \star_{\tfrac{1}{2}\pi + \alpha}
              for the tensor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mi π
                    %mo +
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}\pi + \alpha
              shifted by a symmetric contribition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              as in prop.
              %a.maruku-ref{:href => "#SymmetricContribution"}
              is defined, and serves as the proper stand-in for the non-existing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
