              for the unique pointwise product of three functions.
            %p The last expression above is manifestly independent of the choice of order of the arguments in the triple star product, and hence it is clear that an analogous computation yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mi f
                    %msub
                      %mo ⋆
                      %mi π
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mo ⋆
                      %mi π
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots = f \star_\pi (g \star_\pi h)
                    \\,.
          %h3#on_polynomial_observables_in_field_theory On polynomial observables in field theory
          #PropagatorStarProduct.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
                on
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
                induced from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ⊠
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta \in \Gamma'_\Sigma((E \boxtimes E)^\ast)
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution+of+two+variables"} distribution of two variables
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              with a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal paramater
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              adjoined consider the bilinear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ⋆
                          %mi Δ
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E)_{reg}[ [\hbar] ]
                    \\otimes
                    PolyObs(E)_{reg} [ [ \hbar ] ]
                    \\overset{\star_{\Delta}}{\longrightarrow}
                    PolyObs(E)_{reg}[ [\hbar] ]
            %p
              given as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#StarPoduct"}
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              replaced by
              %a.existingWikiWord{:href => "/nlab/show/functional+derivatives"} functional derivatives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi Δ
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %msub
                        %mo ∫
                        %mi Σ
                      %msup
                        %mi Δ
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi b
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_{\Delta} A_2
                    \\;\coloneqq\;
                    ((-)\cdot(-))
                    \\circ
                    \\exp\left(
                    \\int_\Sigma \Delta^{a b}(x,y)
                    \\frac{\delta}{\delta \mathbf{\Phi}^a(x)}
                    \\otimes
                    \\frac{\delta}{\delta \mathbf{\Phi}^b(y)}
                    \\right)
                    (A_1 \otimes A_2)
            %p
              As in prop.
              %a.maruku-ref{:href => "#AssociativeAndUnitalStarProduct"}
              this defines a
              %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
              and
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              are
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic differential equations
              and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
