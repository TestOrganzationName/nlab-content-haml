                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\infty(V) \otimes C^\infty(V)
                  \&amp;\overset{prod}{\longrightarrow}&amp;
                  C^\infty(V)
                  \\\
                  f \otimes g &amp;\mapsto&amp; f \cdot g
                  }
          %p for the pointwise product of smooth functions.
          #StarPoduct.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                induced by constant rank-2
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
