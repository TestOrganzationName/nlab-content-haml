            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"}> Kähler vector space
                )
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              is a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/linear+complex+structure"} linear complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              as well as two
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ,
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi V
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \omega, g \;\colon\; V \otimes_{\mathbb{R}} V \longrightarrow \mathbb{R}
              such that the following equivalent conditions hold:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mi v
                        %mo ,
                        %mi J
                        %mi w
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi w
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega(J v, J w) = \omega(v,w)
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
