              as above, then the star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mi π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-) \star_\pi (-)
              from def.
              %a.maruku-ref{:href => "#StarPoduct"}
              is
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              with unit the
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} 1 \in C^\infty(V) \hookrightarrow C^\infty(V)[ [ \hbar ] ]
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(V)
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is a
              %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          .proof
            %h6#proof Proof
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/product+rule"} product rule
              of
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi i
                    %mo ∘
                    %mi prod
                    %mo =
                    %mi prod
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi i
                    %mo ⊗
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mo ⊗
                    %msub
                      %mo ∂
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_i \circ prod
                    \=
                    prod \circ ( \partial_i \otimes id \;+\; id \otimes \partial_i  )
                    \\,.
            %p Using this we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
