                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbb{R}^{2n} \times \mathbb{R}^{2n}
                    \\\
                    \&amp; {}^{\mathllap{pr_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{pr_2}}
                    \\\
                    \\mathbb{R}^{2n} &amp;&amp; &amp;&amp; \mathbb{R}^{2n}
                    }
            %p inherits the symplectic structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi pr
                        %mn 1
                        %mo *
                      %mi ω
                      %mo −
                      %msubsup
                        %mi pr
                        %mn 2
                        %mo *
                      %mi ω
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega
                    \\;\coloneqq\;
                    \\left(
                    pr_1^\ast \omega - pr_2^\ast \omega
                    \\right)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Ω
                          %mtd
                            %mo =
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mi j
                            %mi d
                            %msup
                              %mi x
                              %mi i
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mi j
                            %mo −
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mi j
                            %mi d
                            %msup
                              %mi y
                              %mi i
                            %mo ∧
                            %mi d
                            %msup
                              %mi y
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msup
                              %mi x
                              %mi i
                            %mo −
                            %mi d
                            %msup
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msup
                              %mi x
                              %mi j
                            %mo +
                            %mi d
                            %msup
                              %mi y
                              %mi j
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Omega
                    \&amp; =
                    \\omega_{i j} d x^i \wedge d x^j - \omega_{i j} d y^i \wedge d y^j
                    \\\
                    \&amp; =
                    \\omega_{i j} ( d x^i - d y^i ) \wedge ( d x^j +  d y^j )
                    \\end{aligned}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n}
              equipped with this
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on its space of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            %p
              A choice of potential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                  %annotation{:encoding => "application/x-tex"} \Theta
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo =
                      %mi d
                      %mi Θ
                    %annotation{:encoding => "application/x-tex"} \Omega = d \Theta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi ω
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo +
                    %msup
                      %mi y
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi j
                    %mo −
                    %msup
                      %mi y
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta
                    \\coloneqq
                    \-\omega_{i j} ( x^i + y^i ) d (x^j - y^j) )
            %p
              Choosing the
              %a.existingWikiWord{:href => "/nlab/show/real+polarization"} real polarization
              spanned by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %msup
                          %mi x
                          %mi i
                    %mo −
                    %msub
                      %mo ∂
                      %mrow
                        %msup
                          %mi y
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \partial_{x^i} - \partial_{y^i}
              a polarized section is function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F = F(x,y)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %msup
                              %mi x
                              %mi j
                        %mo −
                        %msub
                          %mo ∂
                          %mrow
                            %msup
                              %mi y
                              %mi j
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi F
                    %mo −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi i
                          %mi ℏ
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 4
                    %mi Θ
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\partial_{x^j} - \partial_{y^j}}(d F - \tfrac{1}{i \hbar} \tfrac{1}{4} \Theta F) = 0
            %p hence
            #eq:PolarizedSectionOnMorphismsOfSymplecticGroupoid.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi x
                            %mo +
                            %mi y
                          %mn 2
                      %mo )
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi i
                              %mi ℏ
                        %mi ω
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi x
                                %mo −
                                %mi y
                              %mn 2
                          %mo ,
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi x
                                %mo +
                                %mi y
                              %mn 2
                          %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(x,y)
                    \=
                    f\left( \tfrac{x + y}{2} \right) e^{ \tfrac{1}{i \hbar} \omega\left(  \tfrac{x - y}{2} , \tfrac{x + y}{2} \right)}
                    \\,.
          #PolarizedSymplecticGroupoidConvolutionProductOfSymplecticVectorSpaceIsMoyalStarProduct.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (polarized
                %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic
                %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+product"} groupoid convolution product
                of
                %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
                is given by
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Moyal+star+product"} Moyal star product
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{R}^{2n}, \omega)
              %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+product"} groupoid convolution product
              on polarized sections
              %a.maruku-eqref{:href => "#eq:PolarizedSectionOnMorphismsOfSymplecticGroupoid"} (1)
              on its
              %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymplecticGroupoidOfSymplecticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
              followed by averaging (
              %a.existingWikiWord{:href => "/nlab/show/integration"}> integration
              ) over the polarization
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarPoduct"}
              %a.existingWikiWord{:href => "/nlab/show/Poisson+tensor"} Poisson tensor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo ≔
                      %msup
                        %mi ω
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \pi \coloneqq \omega^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ∫
                            %mo ∫
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
                                %mn 2
                                %mi n
                            %mi t
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
                                %mn 2
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo ⋆
                              %mi π
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo +
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\int \int
                    F(x,t) G(t,y) \, d^{2n} t \, d^{2n} (x-y)
                    \&amp; =
                    (f \star_\pi g)((x+y)/2)
                    \\end{aligned}
                    \\,.
          %p
            (
            %a{:href => "Moyal+deformation+quantization#Weinstein91"}> Weinstein 91, p. 446
            ,
            = succeed ")" do
              %a{:href => "Moyal+deformation+quantization#GBV"} Garcia-Bondia &amp; Varilly 94, section V
          .proof
            %h6#proof_4 Proof
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ∫
                            %mo ∫
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
                                %mn 2
                                %mi n
                            %mi t
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
                                %mn 2
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo ∫
                            %mo ∫
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo +
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo +
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mrow
                                      %mi i
                                      %mi ℏ
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 4
                                %mi ω
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi t
                                %mo ,
                                %mi x
                                %mo +
                                %mi t
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mrow
                                      %mi i
                                      %mi ℏ
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 4
                                %mi ω
                                %mo{:stretchy => "false"} (
                                %mi t
                                %mo −
                                %mi y
                                %mo ,
                                %mi t
                                %mo +
                                %mi y
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
                                %mn 2
                                %mi n
                            %mi t
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mrow
