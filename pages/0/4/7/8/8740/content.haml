                            %mo ⊗
                            %mi g
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi prod
                              %mn 3
                            %mo ∘
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi π
                              %mrow
                                %mi i
