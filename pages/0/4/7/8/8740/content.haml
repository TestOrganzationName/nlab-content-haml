                      %mfrac
                        %mn 1
                        %mn 2
                    %mi π
                    %mo +
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \pi = \tfrac{1}{2}\pi + \alpha
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
