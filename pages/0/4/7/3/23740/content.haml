            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/field"} field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/torsion-free+module"} torsion-free module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/GCD+ring"} GCD ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/prefield+ring"} prefield ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasiregular+element"} quasiregular element
          %h2#references References
          %ul
            %li{:id => "LombardiQuitté2010"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Lombardi"}> Henri Lombardi
                ,
                %a.existingWikiWord{:href => "/nlab/show/Claude+Quitt%C3%A9"} Claude Quitté
                (2010):
                %em Commutative algebra: Constructive methods (Finite projective modules)
                Translated by Tania K. Roblo, Springer (2015) (
                %a{:href => "https://link.springer.com/book/10.1007/978-94-017-9944-7"}> doi:10.1007/978-94-017-9944-7
                ,
                = succeed ")" do
                  %a{:href => "http://hlombardi.free.fr/CACM.pdf"} pdf
            %li#Quinn2009
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Quinn"}> Frank Quinn
                ,
                %em Proof Projects for Teachers
                (2009) &amp;lbrack;
                %a{:href => "https://personal.math.vt.edu/fquinn/education/pfs4teachers0.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Quinn-ProofProjects.pdf", :title => "pdf"} pdf
        .revisedby
