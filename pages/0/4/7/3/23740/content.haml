                      %mi a
                      %mo ′
                      %mo ,
                      %mi b
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a, b) # (a', b')
          %h3#relation_with_zerodivisors  Relation with zero-divisors
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given a commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} e \in R
              is a cancellative element, then it is a non-
              %a.existingWikiWord{:href => "/nlab/show/zero-divisor"}> zero-divisor
              , where non-zero-divisor is defined as an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              such that for every element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo :
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b:R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⋅
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b \cdot a = 0
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \cdot b = 0
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} b = 0
          %p
          .proof
            %h6 Proof
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} e \in R
              is cancellative. This means that for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi e
                    %mo =
                    %mi b
                    %mo ⋅
                    %mi e
                  %annotation{:encoding => "application/x-tex"} a \cdot e = b \cdot e
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⋅
                    %mi a
                    %mo =
                    %mi e
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"} e \cdot a = e \cdot b
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a = b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⋅
                    %mi e
                  %annotation{:encoding => "application/x-tex"} b \cdot e
              from both sides of the equation leads to
              = succeed "," do
