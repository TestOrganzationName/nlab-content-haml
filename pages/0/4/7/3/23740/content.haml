              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi e
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (a - b) \cdot e = 0
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (a - b) = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} e \cdot (a - b) = 0
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo −
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} (a - b) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⋅
                    %mi e
                  %annotation{:encoding => "application/x-tex"} b \cdot e
              to each side of the first equation,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"} e \cdot b
              to each side of the second equation, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              to each side fo the third equation leads to the statement that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi e
                    %mo =
                    %mi b
                    %mo ⋅
                    %mi e
                  %annotation{:encoding => "application/x-tex"} a \cdot e = b \cdot e
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⋅
                    %mi a
                    %mo =
                    %mi e
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"} e \cdot a = e \cdot b
              implies that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a = b
          %p
            Thus, we have established that cancellative elements and non-zero-divisors are the same thing in a commutative ring. However, the proof relies on the
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            structure of commutative rings, and this property does not necessarily hold in other algebraic structures where the concepts of cancellative element and non-zero-divisor make sense, such as in
            %a.existingWikiWord{:href => "/nlab/show/rigs"} rigs
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absorption+monoids"} absorption monoids
          %p
            Since a
            %a.existingWikiWord{:href => "/nlab/show/zero-divisor"} zero-divisor
            is defined in the nLab as not being a non-zero-divisor,
          %p
          .num_theorem
            %h6 Theorem
            %p
              In a commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} e \in R
              is a
              %a.existingWikiWord{:href => "/nlab/show/zero-divisor"} zero-divisor
              if and only if it is non-cancellative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} isZeroDivisor
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo ¬
                    %mi{:mathvariant => "normal"} isCancellative
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{isZeroDivisor}(e) \iff \neg \mathrm{isCancellative}(e)
            %p
          %h3#integral_domains Integral domains
          %p
            The theorems relating cancellative elements to zero-divisors provide alternative definition of the various (commutative)
            %a.existingWikiWord{:href => "/nlab/show/integral+domains"} integral domains
            in constructive mathematics in terms of cancellative elements, in analogy with the definition of
            %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            in terms of invertible elements:
          %p
          .num_defn
            %h6 Definition
            %p
              A commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %strong integral domain
              if an element is non-cancellative (or equivalently, a zero-divisor) iff it is zero. In addition to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≠
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0\neq 1
          %p
          .num_defn
            %h6 Definition
            %p
              A commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %strong Heyting integral domain
              if it is an integral domain and additionally, for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a + b
              is cancellative, then either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is cancellative or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is cancellative.
          %p
          .num_theorem
            %h6 Theorem
            %p
              In addition to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo #
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \# 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              is cancellative.
          %p
          .num_defn
            %h6 Definition
            %p
              A commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %strong discrete integral domain
              if all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} e \in R
              are cancellative
              %a.existingWikiWord{:href => "/nlab/show/xor"} xor
              equal to zero. This condition means that every element is either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              or cancellative, and it also implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≠
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \neq 1
          %h3#fields Fields
          %p
            Given the above definitions of an integral domain, a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            could be defined as an integral domain where every cancellative element is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
          %h3#ring_of_fractions Ring of fractions
          %p
            For every commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/ring+of+fractions"} ring of fractions
            is defined in
            %a{:href => "#Quinn2009"} Quinn2009
            to be the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            at the multiplicative subset of cancellative elements,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi{:mathvariant => "normal"} Can
                    %mo{:stretchy => "false"} (
                    %mi R
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\mathrm{Can}(R)^{-1}]
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            construction of a general
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cancellative+monoid"} cancellative monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} Can
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[\mathrm{Can}(R)^{-1}]
            is the
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} Can
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo ×
                %annotation{:encoding => "application/x-tex"} R[\mathrm{Can}(R)^{-1}]^\times
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi{:mathvariant => "normal"} Can
                    %mo{:stretchy => "false"} (
                    %mi R
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\mathrm{Can}(R)^{-1}]
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} Can
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[\mathrm{Can}(R)^{-1}]
            is the
            %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#unique_factorization_domains Unique factorization domains
          %p
            In
            = succeed "," do
              %a{:href => "#LombardiQuitté2010"} Lombardi &amp; Quitté 2010
            %a.existingWikiWord{:href => "/nlab/show/unique+factorization+domain"} unique factorization domain
            is defined as a
            %a.existingWikiWord{:href => "/nlab/show/GCD+domain"} GCD domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            for which the
            %a.existingWikiWord{:href => "/nlab/show/quotient+object"} quotient
            monoid of the multiplicative subset of cancellative elements by the group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Can
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi R
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathrm{Can}(R)/R^\times
            admits a complete factorization.
          %h2#see_also See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+subset"} multiplicative subset
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/filter+of+a+ring"} filter of a ring
            %li
