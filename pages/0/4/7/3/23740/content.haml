                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⋅
                    %mi c
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} e \cdot c = 0
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
