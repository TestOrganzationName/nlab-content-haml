            %p
              For multiplication, for all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ′
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a' \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ′
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b' \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⋅
