                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#relation_with_zerodivisors"}  Relation with zero-divisors
                %li
                  %a{:href => "#integral_domains"} Integral domains
                %li
                  %a{:href => "#fields"} Fields
                %li
                  %a{:href => "#ring_of_fractions"} Ring of fractions
                %li
                  %a{:href => "#unique_factorization_domains"} Unique factorization domains
              %li
                %a{:href => "#see_also"} See also
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} e \in R
            is
            %em left cancellative
            or
            %em left regular
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ⋅
                  %mi a
                  %mo =
                  %mi e
                  %mo ⋅
                  %mi b
                %annotation{:encoding => "application/x-tex"} e \cdot a = e \cdot b
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a \in R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} b \in R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isLeftCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi R
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ⋅
                  %mi a
                  %mo =
                  %mi e
                  %mo ⋅
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo =
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isLeftCancellative}(e) \coloneqq \forall a,b \in R.(e \cdot a = e \cdot b) \implies (a = b)
          %p
            An element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} e \in R
            is
            %em right cancellative
            or
            %em right regular
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⋅
                  %mi e
                  %mo =
                  %mi b
                  %mo ⋅
                  %mi e
                %annotation{:encoding => "application/x-tex"} a \cdot e = b \cdot e
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a \in R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} b \in R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isRightCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi M
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %mi e
                  %mo =
                  %mi b
                  %mo ⋅
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo =
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isRightCancellative}(e) \coloneqq \forall a,b \in M.(a \cdot e = b \cdot e) \implies (a = b)
          %p
            An element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} e \in R
            is
            %em cancellative
            or
            %em regular
            if it is both left cancellative and right cancellative.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi{:mathvariant => "normal"} isLeftCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi{:mathvariant => "normal"} isRightCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isCancellative}(e) \coloneqq \mathrm{isLeftCancellative}(e) \wedge \mathrm{isRightCancellative}(e)
          %h2#multiplicative_subset_of_cancellative_elements Multiplicative subset of cancellative elements
          %p
            The
            %strong multiplicative subset of cancellative elements
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+subset"} multiplicative subset
            of all cancellative elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Can
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi e
                  %mo ∈
                  %mi M
                  %mo{:stretchy => "false"} |
                  %mi{:mathvariant => "normal"} isCancellative
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathrm{Can}(R) \coloneqq \{e \in M \vert \mathrm{isCancellative}(e)\}
          %p
            The term ‘cancellative element’ could be replaced with the synonym ‘regular element’. If the synonym ‘regular element’ is used in place of ‘cancellative element’, such as in
            = succeed "," do
              %a{:href => "#LombardiQuitté2010"} Lombardi &amp; Quitté 2010
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Reg
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Reg}(R)
          %p
            This is also called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/filter+of+a+ring"} filter
              of regular elements
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %a{:href => "#LombardiQuitté2010"} Lombardi &amp; Quitté 2010
          %p
            Since the multiplicative identity element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is always cancellative, the multiplicative subset of all cancellative elements forms a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cancellative+monoid"} cancellative monoid
          %h2#properties Properties
          %p
          .num_prop
            %h6 Proposition
            %p
              For a commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a, b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \cdot b
              is cancellative, then both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              are cancellative.
          %p
            By this proposition, a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/approximate+integral+domain"} strict approximate integral domain
            if the following condition holds:
          %ul
            %li
              For all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a, b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a + b
              is cancellative, then either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is cancellative or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is cancellative.
          %p
          .num_theorem
            %h6 Theorem
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/approximate+integral+domain"} strict approximate integral domain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              are strongly extensional with respect to the canonical apartness relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
              defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \# y
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x - y
              is cancellative.
            %p
              In this way
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              becomes an internal commutative
              %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
              in the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Apart
                    %annotation{:encoding => "application/x-tex"} \mathrm{Apart}
          %p
          .proof
            %h6 Proof
            %p
              Recall that products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              in the category of sets with apartness relations is the cartesian product of the underlying sets equipped with the apartness relation defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo #
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, y) \# (x', y')
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x \# x'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %em or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo #
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y \# y'
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              between sets with apartness relations is
              %em strongly extensional
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo #
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) \# f(y)
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo #
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \# y
            %p
              For addition, for all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ′
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} a' \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ′
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b' \in R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo #
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi b
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a + b) \# (a' + b')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a + b - (a' + b') = (a - b') + (a - b')
              is cancellative, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo −
                    %mi a
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} a - a'
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo −
                    %mi b
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} b - b'
              is cancellative since for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} b \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a + b
              is cancellative, then either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is cancellative or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is cancellative, whence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo #
                      %mo{:stretchy => "false"} (
