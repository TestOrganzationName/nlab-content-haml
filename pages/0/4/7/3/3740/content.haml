          %h2#order_relations Order relations
          %p
            We define
            %a.existingWikiWord{:href => "/nlab/show/order"} order
            relations between extended lower reals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            as follows:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
              if and only if there exists a rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} a \lt y
              but not
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi x
                    %annotation{:encoding => "application/x-tex"} a \lt x
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \leq y
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} a \lt y
              for every rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi x
                    %annotation{:encoding => "application/x-tex"} a \lt x
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊆
                %annotation{:encoding => "application/x-tex"} \subseteq
            on lower sets, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊊
                %annotation{:encoding => "application/x-tex"} \subsetneq
            (in an appropriate sense).
          %p
            We define order relations between extended upper reals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            as follows:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
              if and only if there exists a rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x \lt b
              but not
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} y \lt b
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \leq y
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x \lt b
              for every rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
