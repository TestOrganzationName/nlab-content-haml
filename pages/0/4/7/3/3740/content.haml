                      %mi b
                    %annotation{:encoding => "application/x-tex"} y \lt b
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊇
                %annotation{:encoding => "application/x-tex"} \supseteq
            on upper sets, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            is
