          %title One-sided real numbers
          %h1#onesided_real_numbers One-sided real numbers
          .maruku_toc
            %ul
              %li
                %a{:href => "#summary"} Summary
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#lower_reals"} Lower reals
                %li
                  %a{:href => "#upper_reals"} Upper reals
              %li
                %a{:href => "#order_relations"} Order relations
              %li
                %a{:href => "#suprema_and_infima"} Suprema and infima
              %li
                %a{:href => "#arithmetic"} Arithmetic
              %li
