          %h2#Definition Definition
          %p We define general non-linear differential operators.
          %h3#DefinitionInDifferentialGeometry In differential geometry
          %p Depending on which definition of differential operators one regards as fundamental, the following are either definitions or are propositions.
          #DifferentialOperatorViaJetBundles.num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E\to X)
              a smooth
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Jet(E)\to X)
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 1
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_1 \to X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_2 \to X)
              two
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em differential operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    D \colon \Gamma_X(E_1) \to \Gamma_X(E_2)
            %p
              between their
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
              is equivalently a map of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ↦
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo ∘
                    %msub
                      %mi j
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \mapsto \tilde D \circ j_\infty(\phi)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_\infty(\phi) \in \Gamma_X(Jet(E_1))
              is the jet prolongation of the section
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
