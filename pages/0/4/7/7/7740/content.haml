                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi \in \Gamma_X(E_1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde D \colon Jet(E_1) \to E_2
            %p
              is a bundle morphism from the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              to the bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
          %p
            In this form this appears for instance as (
            %a{:href => "#Saunders89"}> Saunders 89, def. 6.2.22
            ). Discussion showing the equivalence of this definition with the maybe more traditional definition is in (
            %a{:href => "#KrasilshchikVerbovetsky98"}> Krasil’shchikVerbovetsky 98, def. 1.1, prop. 1.1, prop. 1.9
            ,
            = succeed ")." do
              %a{:href => "#Krasilshchik99"} Krasilshchik 99, theorem 10
          .num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
