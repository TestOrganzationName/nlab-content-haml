            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
          %h3#in_algebraic_geometry__dgeometry In algebraic geometry / D-geometry
          %p
            For the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Im X
            is known as the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+stack"} de Rham stack
            of a
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} i^\ast i_\ast X
            are the
            %a.existingWikiWord{:href => "/nlab/show/D-modules"} D-modules
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            for more on this), this statement is implicit in (
            %a{:href => "#Saito89"}> Saito 89, def. 1.3
            ).
          %h2#properties Properties
          #RetainsOrShrinksWaveFrontSetDifferentialOperator.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                preserves or shrinks
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              (with
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of the
              %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} derivative of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi u
                  %annotation{:encoding => "application/x-tex"} P u
              is contained in the original wave front set of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF(P u) \subset WF(u)
                    \\,.
          %p
            (
            %a{:href => "#Hoermander90"}> Hörmander 90, (8.1.11)
            )
