                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D_1 \colon \Gamma_X(E_1) \to \Gamma_X(E_2)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
