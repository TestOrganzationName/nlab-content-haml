                  %annotation{:encoding => "application/x-tex"} D_2 \colon \Gamma_X(E_2)\to \Gamma_X(E_3)
              , def.
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentialOperatorViaJetBundles"}
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentialOperatorViaJetBundles"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
