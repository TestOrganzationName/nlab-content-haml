                        %annotation{:encoding => "application/x-tex"} J(X)
                    IV
                %strong 5
                21 (1966) &amp;lbrack;
                %a{:href => "http://math.unice.fr/~cazanave/Gdt/ImJ/J-IV.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/0040-9383(66)90004-8"} doi:10.1016/0040-9383(66)90004-8
          %p
            and made use of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
          %p Review:
          %ul
            %li
