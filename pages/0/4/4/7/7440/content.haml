                      %mi X
                    %annotation{:encoding => "application/x-tex"} (const X) : [n] \mapsto X
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              has
              %a.existingWikiWord{:href => "/nlab/show/small+%28%E2%88%9E%2C1%29-category"} small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              = succeed "," do
