                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of objects. If, however,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is equipped with a notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "-enriched" do
