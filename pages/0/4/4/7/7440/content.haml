                              %mi X
                              %mn 0
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} }
                        %mo ∈
                        %mn ∞
                        %mi Grpd
                        %mo →
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mi Grpd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        h X(x_0,X1) \coloneqq \{x_0\} \underset{X_0}{\times} X_1 \underset{X_0}{\times} \{x_1\}
                        \\in \infty Grpd \to Ho(\infty Grpd)
              %li
                %p
                  the
