              %a{:href => "https://arxiv.org/abs/2402.01396"} arXiv:2402.01396
              (2024).
          %h3#ReferencesInternalToInfinityTopos
            Internal to an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
