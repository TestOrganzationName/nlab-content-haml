          %p
            (In (
            %a{:href => "#Lurie"}> Lurie
            ) this is def. 1.1.6.)
          #Equivalences.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in \infty Grpd^{\Delta^{op}}
              a pre-category object, we say that a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f \colon * \to X_1
              in the degree-1 object is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              if it is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mi X
                    %annotation{:encoding => "application/x-tex"} h X
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyCategoryOfPreCategoryObject"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    Equiv(X_n) \hookrightarrow X_n
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
              that includes the full-sub-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid on the sequences of equivalences. Write furthermore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"}
                    Core(X)_\bullet \in Grpd(\infty Grpd) \hookrightarrow \infty Grpd^{\Delta^{op}}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo ≔
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Core(X)_0 \coloneqq X_0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Core(X)_n \coloneqq Equiv(X_n)
                    \\,.
            %p
              This is evidently a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidObject"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/core"} core
              of the pre-category object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
          .num_remark
            %h6#remark_6 Remark
            %p
              This is a more abstract formulation of what equivalently is
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
              by the corresponding discussion for
              %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
              = succeed "." do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/complete+Segal+space#Definition"} complete Segal space – Definition
          %p
            In order to state the completeness condition on pre-category objects that make them be genuine category objects, we need this
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/core"} core
            %a.existingWikiWord{:href => "/nlab/show/coreflective+sub-%28%E2%88%9E%2C1%29-category"} coreflective sub-(∞,1)-category
            of pre-category objects.
          #CoreOnPreCategoryObjects.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is canonically an internal pre-category. Under this inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PreCat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \colon Grpd(\mathbf{H}) \hookrightarrow PreCat(\mathbf{H})
              the groupoid objects form a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+sub-%28%E2%88%9E%2C1%29-category"} coreflective sub-(∞,1)-category
              of that of pre-catgegory objects,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ⊣
                    %mi core
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mi Core
                      %mo ↪
                    %mi PreCat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (i \dashv core)
                    \\colon
                    Grpd(\mathbf{H})
                    \\underoverset
                    {\underset{Core}{\longleftarrow}}
                    {\hookrightarrow}
                    {\bot}
                    PreCat(\mathbf{H})
                    \\,.
            %p
              The coreflection is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/core"} core
              operation that discards non-invertible morphisms.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, prop. 1.1.14
            ).
          .proof
            %h6#proof Proof
            %p
              With def.
              %a.maruku-ref{:href => "#Equivalences"}
              it is direct to establish the statement for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \simeq
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              = succeed ")," do
                %a{:href => "#Lurie"} Lurie, cor. 1.1.11
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≃
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \simeq PSh_\infty(\mathcal{D})
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              by arguing objectwise over objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
              of such,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo ↪
                      %msub
                        %mi PSh
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \hookrightarrow PSh_\infty(\mathcal{D})
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi PSh
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi Core
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mrow
                                %msub
                                  %mpadded{:width => "0"}
                                    %mi Core
                                  %mi PSh
                        %mtr
                          %mtd
                            %mi PreCat
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PreCat
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi PSh
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Grpd(\mathbf{H}) &amp;\hookrightarrow&amp; Grpd(PSh_\infty(\mathcal{D}))
                    \\\
                    \\downarrow \uparrow^{\mathrlap{Core}} &amp;&amp; \downarrow \uparrow^{\mathrlap{Core}_{PSh}}
                    \\\
                    PreCat(\mathbf{H}) &amp;\hookrightarrow&amp; PreCat(PSh_\infty(\mathcal{D}))
                    }
                    \\,.
            %p
              This means that we need to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is degreewise in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow PSh_\infty(\mathcal{D})
              and is a pre-category object, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core_{PSh}(X_\bullet)
              is degreewise in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              and hence preserves the fiber products, for this it is sufficient that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Core_{Psh}(X)_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Core_{PSh}(X)_1
              are in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              and (again since the inclusion preserves limits) the second is equivalent to the
              %a{:href => "simplicial%20object%20in%20an%20%28infinity,1%29-category#Powering"} powering
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X(K)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≔
                    %msup
                      %mi Δ
                      %mn 0
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi Δ
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo{:stretchy => "false"} }
                    %msup
                      %mi Δ
                      %mn 3
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi Δ
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                    %msup
                      %mi Δ
                      %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    K \coloneqq \Delta^0 \coprod_{\Delta^{\{0,2\}}} \Delta^3 \coprod_{\Delta^{\{1,3\}}} \Delta^
                    \\;\;\;
                    \\in
                    sSet
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              obtained from the
              %a.existingWikiWord{:href => "/nlab/show/simplex"} 3-simplex
              by collapsing the
              = succeed "-edge" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0,2)
              = succeed "-edge." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1,3\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mn 0
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K^0 \coloneqq \{1,2\} \hookrightarrow K
              for the image of the
              = succeed "-edge" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,2)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \Delta^3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msup
                                    %mi K
                                    %mn 0
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mi id
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo →
                            %mtd
                              %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msup
                                    %mi K
                                    %mn 0
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mi id
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo →
                            %mtd
                              %mn 1
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K =
                    \\left\{
                    \\array{
                    1 &amp;\stackrel{K^0}{\to}&amp; 0
                    \\\
                    \\uparrow &amp;\nearrow_{\mathrlap{id}}&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; 1
                    }
                    \\;\;\; \Rightarrow \;\;\;
                    \\array{
                    1 &amp;\stackrel{K^0}{\to}&amp; 0
                    \\\
                    \\uparrow &amp;\searrow^{\mathrlap{id}}&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; 1
                    }
                    \\right\}
                    \\,.
            %p We claim generally that
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi PreCat
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \in PreCat(\mathbf{H})
                  the canonical morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Core(X)(K) \to X(K)
                  is an equivalence;
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi Grpd
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y \in Grpd(\mathbf{H})
                  the canonical morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi K
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y(K) \to Y(K^0)
                  is an equivalence.
            %p
              (This is (
              %a{:href => "#Lurie"}> Lurie, prop. 1.1.13
              ).)
            %p Here
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi X
                      %mn 0
                    %munder
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi X
                      %mn 3
                    %munder
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X(K) \simeq  X_0 \underset{X(\{0,2\})}{\times} X_3 \underset{X(\{1,3\})}{\times} X_0
            %p
              etc. By construction,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core(X)(K) \to X(K)
              is fully faithful. Hence to see that it is an equivalence, hence in addition essentially surjective, it is sufficient to observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi X
                      %mn 0
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                    %msub
                      %mi X
                      %mn 3
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X(K)
                    \\simeq
                    X_0 \underset{X_{\{0,1\}}}{\times} X_3 \underset{X_{\{1,3\}}}{\times} X_0
            %p
              is the space of those 3-simplices in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              for which the
              = succeed "-edges" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
              = succeed "-edge." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 2
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{2,3\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core(X)(K) \to X(K)
              is an equivalence. Moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mn 0
                    %mo ↪
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K^0 \hookrightarrow K
              is a weak equivalence, and hence so is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mrow
                        %msup
                          %mi K
                          %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Core(X)(K) \to Core(X)({K^0}) \simeq Core(X)_1
              %a{:href => "simplicial+object+in+an+%28infinity%2C1%29-category#SlicingOverPoweringOfSimplicialObjects"} this proposition
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object in an (∞,1)-category
          %h3#category_objects Category objects
          %h4#CategoryObjectInTopos
            In an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            may already be thought of as being an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} internal groupoid
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is discussed further
            = succeed "." do
              %a{:href => "#InAnInfinity1Category"} below
          #CategoryObject.num_defn
            %h6#definition_8 Definition
            %p
              An
              %strong internal category
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is an internal pre-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo ∈
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} X_\bullet \in \mathbf{H}^{\Delta^{op}}
              = succeed "," do
                %a.maruku-ref{:href => "#PreCategoryObject"}
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core(X)
              is in the image of the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} const \colon \mathbf{H} \hookrightarrow Grpd(\mathbf{H})
              of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#EmbeddingOfConstantGroupoidObjects"}
          %p
            This is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
              object
            in (
            %a{:href => "#Lurie"}> Lurie, def. 1.2.10
            ).
          .num_remark
            %h6#remark_7 Remark
            %p
              A groupoid object, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidObject"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Const
                      %mo{:lspace => "verythinmathspace"} :
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo →
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Const \colon \mathbf{H} \to Grpd(\mathbf{H})
            %p
              In a sense these are the genuine groupoid objects, while the others are groupoid objects
              %em equipped with an atlas
              (…).
          %p
            For internalizing in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            which is not an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            are supposed to be. This is the topic of
          %ul
            %li
              %a{:href => "#ChoiceOfGroupoidObjects"}> Relative core – Choice of groupoid objects
              \.
          %p Once one has this, the definition of
          %ul
            %li
              %a{:href => "#CategoryObjectsInC"} Category objects
          %p
            works essentially as before in an
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            serves itself naturally as the collection of groupoid objects inside its
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of inernal categories and so this yields a natural notion of
          %ul
            %li
              %a{:href => "#InternalnCategories"}> Iterated internalization – Internal n-categories
              \.
          %p
            Internal to the archetypical base
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            these are, externally, the bare
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            over some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-sheaves"} (∞,n+1)-sheaves
            on that site. More on this is in the
          %ul
            %li
              %em
                %a{:href => "#Examples"} Examples
          %p below.
          %h4#ChoiceOfGroupoidObjects Relative core – Choice of groupoid objects
          %p
            The structure necessary to formulate the
            %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} completeness
            condition, which in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is def.
            = succeed "," do
              %a.maruku-ref{:href => "#CategoryObject"}
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is the following.
          #ChoiceOfInternalGroupoids.num_defn
            %h6#definition_9 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              %strong choice of internal groupoids
              is a choice of
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow \mathcal{C}
              of an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              such that
            %ul
              %li
                %p
                  the inclusion is closed under small
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
                  and
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor+theorem"} adjoint (∞,1)-functor theorem
                  = succeed "\u201D," do
                    %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo ⊣
                        %mi Disc
                        %mo ⊣
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mover
                          %mover
                            %munder
                              %mo →
                              %mi Γ
                            %mover
                              %mo ↩
                              %mi Disc
                          %mover
                            %mo →
                            %mi Π
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        (\Pi \dashv Disc \dashv \Gamma)
                        \\colon
                        \\mathcal{C}
                        \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{Disc}{\hookleftarrow}}{\underset{\Gamma}{\to}}}
                        \\mathbf{H}
                        \\,;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mo :
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Y
                      %annotation{:encoding => "application/x-tex"} f^* : \mathbf{H}_{/X} \to \mathcal{C}_{/Y}
                  along morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Y
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} f : Y \to X
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  preserves
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-sheaf"} (∞,2)-sheaf
                  when restricted to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} classifying functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo :
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo →
                      %annotation{:encoding => "application/x-tex"} \chi : \mathcal{C}^{op} \to
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
                  when restricted along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo ↪
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow \mathcal{C}
                %p
                  (a
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimit"}> van Kampen colimit
                      \-condition
                  %a{:href => "van+Kampen+colimit#InHigherCategories"} there
                  for more)
          %p
            This is the definition of “distributor” in (
            %a{:href => "#Lurie"}> Lurie, def. 1.2.1
            ), where we are making use of (
            %a{:href => "#Lurie"}> Lurie, remark 1.2.6
            ) which identifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            here as being necessarily an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Giraud+theorem"} (∞,1)-Giraud theorem
          .num_example
            %h6#example Example
            %p
              The identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≃
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \simeq \mathcal{C}
              is a choice of internal groupoids in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Giraud+theorem"} (∞,1)-Giraud theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              reduces to that of category objects in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              = succeed "." do
                %a{:href => "#CompleteCategoryInTopos"} above
          %p
            For the discussion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
            = succeed "," do
              %em choices of internal groupoids
            %a.maruku-ref{:href => "#ChoiceOfInternalGroupoids"}
            is that they behave well with forming internal categories, this is cor.
            %a.maruku-ref{:href => "#InductiveChoicesOfInternalGroupoids"}
            below.
          %p
            This corresponds to (
            %a{:href => "#Lurie"}> Lurie, notation 1.2.9
            ).
          %h4#CategoryObjectsInC
            In a general
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            In the following, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
            eqipped with a choice of internal groupoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow \mathcal{C}
            = succeed "." do
              %a.maruku-ref{:href => "#ChoiceOfInternalGroupoids"}
          #PreCategoryObject.num_defn
            %h6#definition_10 Definition
            %p
              An
              %strong internal precategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              relative to the choice of internal groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    X : \Delta^{op} \to \mathcal{C}
            %p such that
            %ol
              %li
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X_n
                as the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
                \/ iterated
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X([n]) \simeq X(\{0,1\}) \times_{X([0])} \cdots \times_{X[0]} X(\{n-1,n\})
            %ol
              %li
                %p
                  such that the object of objects lies in the inclusion of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo ↪
                        %mi 𝒞
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"} X_0 \in \mathbf{H} \hookrightarrow \mathcal{C}\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PreCat
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PreCat_{\mathbf{H}}(\mathcal{C})
              for the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              relative to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              on the internal precategories.
          %p
            This is the definition of
            %em Segal object
            in (
            %a{:href => "#Lurie"}> Lurie, def. 1.2.7
            ).
          #HCore.num_prop
            %h6#proposition_3 Proposition
            %p The inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PreCat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi PreCat
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Grpd(\mathbf{H}) \hookrightarrow PreCat(\mathbf{H}) \hookrightarrow
                    PreCat_{\mathbf{H}}(\mathcal{C})
            %p
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo :
                    %msub
                      %mi PreCat
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Core_{\mathbf{H}} : PreCat_{\mathbf{H}}(\mathcal{C}) \to Grpd(\mathbf{H})
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              The left morphism has a right adjoint by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CoreOnPreCategoryObjects"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo{:lspace => "verythinmathspace"} :
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo ↪
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} Disc \colon \mathbf{H} \hookrightarrow \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              has a right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              and is itself a right adjoint. This means that their prolongations to simplicial objects both preserve pre-category objects and hence induce an adjunction of pre-category objects. Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is in addition fully faithful,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              takes objects in the inclusion back to themselves, and hence this preserves also
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
