                          %mo{:stretchy => "false"} )
                          %mo :
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo ,
                              %mi B
                              %mo ,
                              %mi C
                              %mo{:stretchy => "false"} )
                              %mo :
                              %msub
                                %mi Type
                                %mi κ
                              %mo ×
                              %msub
                                %mi Type
                                %mi κ
                              %mo ×
                              %msub
                                %mi Type
                                %mi κ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo →
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⊣
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi f
                          %mo =
                          %mi h
                          %mo{:stretchy => "false"} )
                          %mo :
                          %msub
                            %mi Type
                            %mi κ
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒯𝓎𝓅ℯ
                            %mn 1
                        %mtd
                          %mo ≔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo :
                          %msub
                            %mi Type
                            %mi κ
                        %mtd
                          %mo ⊢
                          %mi A
                          %mo →
                          %mi B
                          %mo :
                          %msub
                            %mi Type
                            %mi κ
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒯𝓎𝓅ℯ
                            %mn 0
                        %mtd
                          %mo ≔
                        %mtd
                          %mo{:stretchy => "false"} [
                        %mtd
                          %mo ⊢
                          %msub
                            %mi Type
                            %mi κ
                          %mo :
                          %msub
                            %mi Type
                            %mi λ
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\vdots &amp;&amp;  \vdots &amp; \vdots
                  \\\
                  \\downarrow \downarrow \downarrow \downarrow
                  \\\
                  \\mathcal{Type}_2 &amp; \coloneqq &amp; [ (f,g,h) : \sum_{(A,B,C) : Type_\kappa \times Type_\kappa \times Type_\kappa} (A \to B)\times (B \to C) \times (A \to C)  &amp; \dashv (g\circ f = h) : Type_\kappa ]
                  \\\
