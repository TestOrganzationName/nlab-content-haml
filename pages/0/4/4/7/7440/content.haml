              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \infty Grpd \to \mathbf{H}
              is a
              = succeed "," do
                %em choice of internal groupoids
              = succeed "," do
                %a.maruku-ref{:href => "#ChoiceOfInternalGroupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} globally ∞-connected
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
