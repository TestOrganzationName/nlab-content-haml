                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-Chern-Simons+theory+-+contents"} Edit this sidebar
          %blockquote
            %p
              This is a sub-entry of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          %hr/
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#exposition_of_secondquantization_of_sigmamodels"} Exposition of second-quantization of sigma-models
          %h2#exposition_of_secondquantization_of_sigmamodels Exposition of second-quantization of sigma-models
          %p
            Low dimensional
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            subject to the forces exerted by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            = succeed "," do
              %a{:href => "#ExpositionClassical"} above
            %em
              on
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            \: one is interested in describing a
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            (or possibly some higher analog, such as a
            %em
              %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
            ) on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %em quanta
            of the fields on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/worldvolumes"} worldvolumes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is supposed to induce, in turn, another quantum field theory, or something similar, but now on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/second+quantization"} second quantization
            \. We shall try to indicate below in which sense this should indeed be a direct iteration of the (“first”) quantization of the original
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a{:href => "ExpositionQuantization"} above
          %p
            Assume now that we started with a classical
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/FQFT"} functorial QFT
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi S
                  %mo →
                  %mi Vect
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Z : Bord_n^S \to Vect
                  \\,,
          %p
            which we take here to be 1-categorical (un-
            %a.existingWikiWord{:href => "/nlab/show/extended+quantum+field+theory"}> extended
            ), not to overburden the discussion. Assume also for simplicity that the corresponding
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            is of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Y
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} X = Y \times \mathbb{R}
          %p
            Using this, we define a space of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/state"} state
            %em second quantization
            to be the
            %em Fock space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi Sym
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ⊕
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi Σ
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %mo{:stretchy => "false"} ]
                          %mi Z
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Σ
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo :
                          %mo =
                          %msup
                            %mi Sym
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi 𝒱
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mstyle{:mathvariant => "bold"}
                            %mn 1
                          %mo ⊕
                          %mi 𝒱
                          %mo ⊕
                          %mo{:stretchy => "false"} (
                          %mi 𝒱
                          %mo ⊗
                          %mi 𝒱
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi sym
                          %mo ⊕
                          %mo{:stretchy => "false"} (
                          %mi 𝒱
                          %mo ⊗
                          %mi 𝒱
                          %mo ⊗
                          %mi 𝒱
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi sym
                          %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Sym^\bullet(\oplus_{[\Sigma_{n-1}]} Z(\Sigma_{n-1}) )
                  \&amp; :=
                  Sym^\bullet( \mathcal{V} )
                  \\\
                  \&amp; \simeq
                  \\mathbf{1}
                  \\oplus
                  \\mathcal{V}
                  \\oplus
                  (\mathcal{V} \otimes \mathcal{V})_{sym}
                  \\oplus
                  (\mathcal{V} \otimes \mathcal{V} \otimes \mathcal{V})_{sym}
                  \\cdots
                  \\end{aligned}
                  \\,,
          %p
            the free commutative
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            over the vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/state"} state
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            or, generally,
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Sigma_{n-1}]
            of connected shapes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma_{n-1}
            of this brane. For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            there is just the point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 0
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Sigma_0 = *
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            there is one contribution from the closed string
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 1
                  %mo =
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma_1 = S^1
            and one contribution from the open string
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Sigma_1 = [0,1]
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            labels. (In the presence of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            %a.existingWikiWord{:href => "/nlab/show/super+algebra"} super algebra
            version.)
          %p
            This space of states is that of a quantum theory whose
            %em classical
            field configurations are given by
            %em many
            states of the original quantum
            = succeed "-model." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma_{n-1}
            is a
            %em quantum
            or a
            %em single excitation
            of the field theory that it induces on target space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Of course
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Vect
                  %mo →
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Sym^\bullet(-) : Vect \to Vect
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a{:href => "#ExpositionQuantization"} above
            – also is a functor (what is not functorial is the quantization of a random
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-construction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sym
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Sym^\bullet
            %em interaction
            of the many branes:
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi Y
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi t
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X = Y \times (-t,t)
            a piece of target space, the would-be second quantized theory on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            should assign a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S : Sym^\bullet(\mathcal{V}) \to Sym^\bullet(\mathcal{V})
          %p
            between the space of states of the incoming
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} t = \infty
            and calls
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            the
            %em
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            of the theory, where “S” is for
            %em scattering
            \: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi v
                    %mn 1
                    %mi in
                  %mo ⊗
                  %mi …
                  %msubsup
                    %mi v
                    %mi r
                    %mi in
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Sym
                    %mi r
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} (v^{in}_1 \otimes \dots v^{in}_r) \in Sym^r \mathcal{V}
            the state of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            incoming brane quanta and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi v
                    %mn 1
                    %mi out
                  %mo ⊗
                  %mi …
                  %msubsup
                    %mi v
                    %mi s
                    %mi out
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Sym
                    %mi s
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} (v^{out}_1 \otimes \dots v^{out}_s) \in Sym^s \mathcal{V}
            a state of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            outgoing brane quanta, the
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mo (
                      %msubsup
                        %mi v
                        %mn 1
                        %mi out
                      %mo ⊗
                      %mi …
                      %msubsup
                        %mi v
                        %mi s
                        %mi out
                      %mo )
                    %mo ,
                    %mi S
                    %mrow
                      %mo (
                      %msubsup
                        %mi v
                        %mn 1
                        %mi in
                      %mo ⊗
                      %mi …
                      %msubsup
                        %mi v
                        %mi r
                        %mi in
                      %mo )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left( \left(v^{out}_1 \otimes \dots v^{out}_s\right) , S \left(v^{in}_1 \otimes \dots v^{in}_r\right) \right)
          %p
            (using an
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/probability+amplitude"} probability amplitude
            for
            = succeed "-many" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em scattering off each other
            – and eventually emerging again in the state
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi v
                      %mn 1
                      %mi out
                    %mo ⊗
                    %mi …
                    %msubsup
                      %mi v
                      %mi s
                      %mi out
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v^{out}_1 \otimes \dots v^{out}_s)
          %p
            The idea is that this scattering happens in all possible ways that it can happen, with each way weighted by the probability amplitude for it to happen as seen by the quantum
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ":" do
