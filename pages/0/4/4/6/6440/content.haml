                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
