                      %mi j
                %annotation{:encoding => "application/x-tex"} \mu_{i j}
            by definition and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
