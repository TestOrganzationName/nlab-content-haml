                                      %mo ,
                                      %mrow
                                        %mo [
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo ,
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo ]
                                      %mo ]
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi 𝔤
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathfrak{g} \otimes_k \mathfrak{g} \otimes_k \mathfrak{g}
                        \&amp;&amp;
                        \\overset{\tau^{super}_{\mathfrak{g}, \mathfrak{g}} \otimes_k id }{\longrightarrow}
                        \&amp;&amp;
                        \\mathfrak{g} \otimes_k \mathfrak{g} \otimes_k \mathfrak{g}
                        \\\
                        \&amp; {}_{\mathllap{\left[-,\left[-,-\right]\right]} - \left[\left[-,-\right],-\right] }\searrow &amp;&amp; \swarrow_{\mathrlap{\left[-,\left[-,-\right]\right]}}
                        \\\
                        \&amp;&amp; \mathfrak{g}
                        }
                        \\,.
          %h3#as_supergraded_lie_algebras As super-graded Lie algebras
          %p Externally this means the following:
          #SuperLieAlgebraTraditional.num_prop
            %h6#proposition Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              according to def.
              %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              is equivalently
            %ol
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔤
                            %mi even
                          %mo ⊕
                          %msub
                            %mi 𝔤
                            %mi odd
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{even} \oplus \mathfrak{g}_{odd}
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                  (the
                  = succeed ")" do
                    %em super Lie bracket
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mi 𝔤
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝔤
                        %mo →
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        [-,-] : \mathfrak{g}\otimes_k \mathfrak{g} \to \mathfrak{g}
                %p
                  which is
                  %em graded
                  skew-symmetric: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x,y \in \mathfrak{g}
                  two elements of homogeneous degree
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi x
                        %annotation{:encoding => "application/x-tex"} \sigma_x
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi y
                        %annotation{:encoding => "application/x-tex"} \sigma_y
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        [x,y] = -(-1)^{\sigma_x \sigma_y} [y,x]
                        \\,,
              %li
                %p
                  that satisfies the
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  in that for any three elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x,y,z \in \mathfrak{g}
                  of homogeneous super-degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi x
                        %mo ,
                        %msub
                          %mi σ
                          %mi y
                        %mo ,
                        %msub
                          %mi σ
                          %mi z
                        %mo ∈
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_x,\sigma_y,\sigma_z\in \mathbb{Z}_2
                  then
                #eq:GradedJacobiIdentity.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %mo ⋅
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [x, [y, z] ] = [ [x,y],z] + (-1)^{\sigma_x \cdot \sigma_y} [y, [x,z] ]
                        \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of super Lie algebras is a homomorphisms of the underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              which preserves the Lie bracket. We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    sLieAlg
            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of super Lie algebras.
          %h3#as_formal_duals_of_a_chevalleyeilenberg_superalgebras As formal duals of a Chevalley-Eilenberg super-algebras
          #CEAlgebraofSuperLieAlgebra.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              is the super-
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual
              super vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet  \mathfrak{g}^\ast
            %p
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              that on generators is the linear dual of the super Lie bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo →
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    d_{\mathfrak{g}} \;\coloneqq\; [-,-]^\ast \;\colon\; \mathfrak{g}^\ast \to \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
            %p
              and which is extended to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
              by the graded Leibniz rule (i.e. as a graded
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Here all elements are
              = succeed "-bigraded," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z} \times \mathbb{Z}/2)
              %em cohomological grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} n
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\n \mathfrak{g}^\ast
              %em super-grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              (even/odd).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi i
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_i \in CE(\mathfrak{g})
              two elements of homogeneous bi-degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mi i
                      %mo ,
                      %msub
                        %mi σ
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_i, \sigma_i)
              %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} sign rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mn 2
                    %mo ∧
                    %msub
                      %mi α
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_1 \wedge \alpha_2 = (-1)^{n_1 n_2} (-1)^{\sigma_1 \sigma_2}\; \alpha_2 \wedge \alpha_1
                    \\,.
            %p
              (See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              for discussion of this sign rule and of an alternative sign rule that is also in use. )
          %p
            We may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            equivalently as the
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/invariant+differential+form"} left-invariant
            %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} corresponding
            simply connected
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
            \.
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            is traditionally introduced as a means to define
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          #SuperLieAlgebraCohomology.num_defn
            %h6#definition_4 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %ol
              %li
                %p
                  an
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-cocycle
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n,even)
                  in its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi 𝕘
                      %annotation{:encoding => "application/x-tex"} d_{\mathbb{g}}
                  closed.
              %li
                %p
                  the cocycle is non-trivial if it is not
                  = succeed "-exact" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              %li
                %p
                  hene the
                  %em
                    super-
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H^\bullet(\mathfrak{g}, \mathbb{R}) = H^\bullet(CE(\mathfrak{g}))
                        \\,.
          %p
            The following says that the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            is an equivalent incarnation of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          .num_prop
            %h6#proposition_2 Proposition
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi sLieAlg
                      %mi fin
                    %mo ↪
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    CE \;\colon\; sLieAlg^{fin}  \hookrightarrow dgAlg^{op}
            %p
              that sends a finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              to its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              which hence exibits
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              as a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential-graded+algebras"} differential-graded algebras
          %h3#AsSuperRepresentableLieAlgebrasOverSuperpoints As super-representable Lie algebras in the topos over superpoints
          %p
            Equivalently, a super Lie algebra is a “super-representable”
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+object"} Lie algebra object
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to the
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Super%E2%88%9EGrpd"} Super∞Grpd
            over the site of
            %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
            (
            %a{:href => "#Sachse08"}> Sachse 08, Section 3.2, towards cor. 3.3
            ).
          %p
            See the discussion at
            %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
            for details on this.
          %h2#properties Properties
          %h3#Classification Classification
          %p
            (
            %a{:href => "Kac77a"}> Kac 77a
            ,
            = succeed ")" do
              %a{:href => "#Kac77b"} Kac 77b
          %ol
            %li
              %p finite dimensional
            %li
              %p simple
            %li
              %p
                over a
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
          %p
