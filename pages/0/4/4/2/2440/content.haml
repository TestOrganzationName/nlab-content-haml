                              %mi v
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Θ
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big( \tfrac{1}{2} [Q,Q](v_1) \big)(v_2)
                    \&amp; =
                    [Q, Q(v_1)](v_2)
                    \\\
                    \&amp; =
                    [Q,
                    \\underset{
                    \\mathclap{
                    \= \rho_{\Theta(v_1)}(v_2)
                    }
                    }
                    {
                    \\underbrace{
                    (Q(v_1))(v_2)
                    }
                    }
                    ]
                    \-
                    [Q(v_1), Q(v_2)]
                    \\\
                    \&amp; =
                    \\Theta( \rho_{\Theta(v_1)}(v_2) )
                    \-
                    [ \Theta(v_1), \Theta(v) ]
                    \\end{aligned}
          #EmbeddingTensorsInduceTensorHierarchies.num_prop
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/embedding+tensors"} embedding tensors
                induce
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+hierarchies"} tensor hierarchies
            %p
              In view of the relation between
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              and
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              (
              %a{:href => "#RelationToDGLieAlgebras"}> above
              ), Prop.
              %a.maruku-ref{:href => "#EmbeddingTensorViaSuperLieAlgebraInducedFromVectorSpace"}
              says that every choice of an
              %a.existingWikiWord{:href => "/nlab/show/embedding+tensor"} embedding tensor
              for a
              %a.existingWikiWord{:href => "/nlab/show/faithful+representation"} faithful representation
              on a
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              induces a
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi V
                        %mo ^
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo ∂
                      %mo ≔
                      %mo{:stretchy => "false"} [
                      %mi Θ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\widehat V, [-,-], \partial \coloneqq [\Theta, -])
            %p
              According to
              = succeed "," do
                %a{:href => "tensor+hierarchy#Palmkvist13"} Palmkvist 13, 3.1
              %a{:href => "tensor+hierarchy#LavauPalmkvist19"} Lavau-Palmkvist 19, 2.4
              this
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              (or some extension of some sub-algebra of it) is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/tensor+hierarchy"} tensor hierarchy
              associated with the embedding tensor.
