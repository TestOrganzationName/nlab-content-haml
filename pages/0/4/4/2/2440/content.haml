                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(n)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ⊕
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} C_{n-1} \oplus \mathbb{C}
                %td{:style => "text-align: left;"}
                  vector
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            reviewed e.g. in (
            %a{:href => "#Farmer84"}> Farmer 84, p. 25,26
            ,
            = succeed ")." do
              %a{:href => "#Minwalla98"} Minwalla 98, section 4.1
          %h3#RelationToDGLieAlgebras Relation to dg-Lie algebras
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, \partial, [-,-])
            may be understood equivalently as a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo =
                  %msub
                    %mi 𝔤
                    %mi even
                  %mo ⊕
                  %msub
                    %mi 𝔤
                    %mi odd
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\mathfrak{g} = \mathfrak{g}_{even} \oplus \mathfrak{g}_{odd}, [-,-,])
          %p equipped with
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
                of the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} grading
                of the underlying
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                to a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                %a{:href => "graded+vector+space#SpecialCaseOfZGradedVectorSpaces"} -graded vector space
                through the projection
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo →
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mi ℤ
                        %mo =
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to \mathbb{Z}/2\mathbb{Z} = \mathbb{Z}_2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mi even
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⊕
                        %mi n
                      %msub
                        %mi 𝔤
                        %mrow
                          %mn 2
                          %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mphantom
                        %mi AAA
                      %msub
                        %mi 𝔤
                        %mi odd
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⊕
                        %mi n
                      %msub
                        %mi 𝔤
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\mathfrak{g}_{even}
                      \\;\simeq\;
                      \\underset{n }{\oplus} \mathfrak{g}_{2n}
                      \\,,
                      \\phantom{AAA}
                      \\mathfrak{g}_{odd}
                      \\;\simeq\;
                      \\underset{n }{\oplus} \mathfrak{g}_{2n+1}
              %p such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ⊗
                      %msub
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ⟶
                      %msub
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      [-,-] \;\colon\; \mathfrak{g}_{n_1} \otimes \mathfrak{g}_{n_2} \longrightarrow \mathfrak{g}_{n_1 + n_2}
            %li
              %p
                an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ∈
                      %msub
                        %mi 𝔤
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} Q \in \mathfrak{g}_{-1}
              %p such that
              #eq:NilpotencyOfQ.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Q
                      %mo ,
                      %mi Q
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      [Q,Q] = 0
          %p
            (See also at “
            %a.existingWikiWord{:href => "/nlab/show/NQ-supermanifold"}> NQ-supermanifold
            ”.)
          %p
            Given this, define the
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            to be the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
            by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial \;\coloneqq\; [Q,-]
                  \\,.
          %p
            That this differential squares to 0 follows by the super-Jacobi identity
            %a.maruku-eqref{:href => "#eq:GradedJacobiIdentity"} (1)
            and by the nilpotency
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:NilpotencyOfQ"} (2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %munder
                    %munder
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Q
                        %mo ,
                        %mi Q
                        %mo{:stretchy => "false"} ]
                      %mo ⏟
                    %mrow
                      %mo =
                      %mn 0
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mphantom
                    %mi AA
                  %mo ⇒
                  %mphantom
                    %mi AA
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  [Q,[Q,-] ]
                  \\;=\;
                  [ \underset{= 0}{\underbrace{[Q,Q]}}, -  ] - [  Q, [Q, -]  ]
                  \\phantom{AA}
                  \\Rightarrow
                  \\phantom{AA}
                  [ Q,[Q,-] ] = 0
          %p
            and the
            = succeed "-property" do
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:GradedJacobiIdentity"} (1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Q
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [Q,[x,y] ]
                  \\;=\;
                  [ [Q,x],y]
                  + (-1)^{deg(x)} [x, [Q,y] ]
                  \\,.
          %h2#Examples Examples
          %h3#basic_examples Basic examples
          %p Some obvious but important classes of examples are the following:
          #SuperVectorSpaceAsAbelianSuperLieAlgebra.num_example
            %h6#example Example
            %p
              every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [-,-] = 0
                    \\,.
            %p These may be called the “abelian” super Lie algebras.
          #OrdinaryLieAlgebraAsSuperLieAlgebra.num_example
            %h6#example_2 Example
            %p
              Every ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %mo ↪
                    %mi sLieAlg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg \hookrightarrow sLieAlg
                    \\,.
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              inclusion in that it has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ⇝
                      %mo ↪
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg
                    \\underoverset
                    {\underset{ \overset{ \rightsquigarrow}{(-)} }{\longleftarrow}}
                    {\hookrightarrow}
                    {\bot}
                    sLieAlg
            %p given on the underlying super vector spaces by restriction to the even graded part
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔰
                      %mo ⇝
                    %mo =
                    %msub
                      %mi 𝔰
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{\mathfrak{s}} = \mathfrak{s}_{even}
                    \\,.
          %h3#superpoincar_super_lie_algebras_supersymmetry Super-Poincaré super Lie algebras (supersymmetry)
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
                and various of its polyvector extension are super-extension of the ordinary
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Poincare+Lie+algebra"} Poincare Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry+algebras"} supersymmetry algebras
                in the strict original sense of the word. For more on this see at
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+q-Schur+algebra"} super q-Schur algebra
            %li
              %p
                For every
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
                makes its
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                into a super Lie algebra over the
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                of
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                – the
                = succeed "." do
                  %a{:href => "Whitehead+product#SuperLieAlgebraStructure"} Whitehead super Lie algebra
            %li
              %p higher super Lie algebras
              %p
                Just as
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
                are
                %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorified
                to
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroid"} L-infinity algebroid
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/super+L-infinity+algebra"} super L-infinity algebra
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"}> supergravity Lie 3-algebra
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+6-algebra"} supergravity Lie 6-algebra
          %h3#SuperLieAlgebraInducedFromVectorSpace Embedding tensors and tensor hierarchy
          %p
            The following example is highlighted in
            %a{:href => "tensor+hierarchy#Palmkvist13"} Palmkvist 13, 3.1
            (reviewed more clearly in
            = succeed ")" do
              %a{:href => "tensor+hierarchy#LavauPalmkvist19"} Lavau-Palmkvist 19, 2.4
          #TheSuperLieAlgebraInducedFromVectorSpace.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional vector space
              over some
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Define a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi V
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Vect
                      %mi k
                      %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat V \;\in \; Vect_k^{\mathbb{Z}}
                    \\,,
            %p
              concentrated in degrees
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \leq 1
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
              as follows:
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n =1
              we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat V_{1}
                    \\;\coloneqq\;
                    V
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mn 0
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \leq 0 \in \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              is taken to be the vector space of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              to the component space in degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat V_{n-1}
                    \\;\coloneqq\;
                    Hom_k( V, \widehat V_n )
                    \\,.
            %p Hence:
            #eq:ExplicitComponentSpacesOfSuperLieAlgebraInducedFromVectorSpace.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi V
                                %mo ^
                              %mn 1
                          %mtd
                            %mo =
                            %mi V
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi V
                                %mo ^
                              %mn 0
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi 𝔤𝔩
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi V
                                %mo ^
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi V
                                %mo ^
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi ⋮
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat V_1 &amp; = V
                    \\\
                    \\widehat V_0 &amp; = Hom_k(V,V) = \mathfrak{gl}(V)
                    \\\
                    \\widehat V_{-1} &amp; =  Hom_k(V, Hom_k(V,V)) \simeq  Hom_k(V \otimes V, V)
                    \\\
                    \\widehat V_{-2} &amp; = Hom_k(V, Hom_k(V, Hom_k(V,V))) \simeq  Hom_k(V \otimes V \otimes V, V)
                    \\\
                    \\vdots
                    \\end{aligned}
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these component spaces as a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              with the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/even+number"} even number
              = succeed "-degrees" do
                %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd number
            %p
              On this
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              consider a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+bracket"} super Lie bracket
              defined
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recusively
              as follows:
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo ∈
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mn 1
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_1, v_2 \in \widehat V_1 = V
              we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [v_1, v_2] \;=\; 0
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mrow
                        %mi n
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} f \in \widehat V_{n \leq 0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mn 1
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in \widehat V_1 = V
              we set
            #eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [f, v]
                    \\;\coloneqq\;
                    f(v)
            %p
              Finally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} f\in \widehat V_{ deg(f) \leq 0 }
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msub
                      %mover
                        %mi V
                        %mo ^
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} g\in \widehat V_{deg(g) \leq 0}
              we set
            #eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mi v
                            %mspace{:width => "thickmathspace"}
                            %mo ↦
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mi g
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [f, g]
                    \&amp;
                    \\colon\;
                    v
                    \\;\mapsto\;
                    [f, g(v)]
                    \-
                    (-1)^{
                    deg(f) deg(g)
                    }
                    [ g, f(v) ]
                    \\\
                    \\end{aligned}
          #ConstraintsOnBracketInSuperLieAlgebraInducedByVectorSpace.num_remark
            %h6#remark Remark
            %p
              By
              %a.maruku-eqref{:href => "#eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace"} (4)
              the definition
              %a.maruku-eqref{:href => "#eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace"} (5)
              is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [ [f,g],v ]
                    \\;=\;
                    [f, [g,v] ]
                    \-
                    (-1)^{
                    deg(f) deg(g)
                    }
                    [ g, [f,v] ]
            %p
              Hence
              %a.maruku-eqref{:href => "#eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace"} (5)
              is already implied by
              %a.maruku-eqref{:href => "#eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace"} (4)
              if the bracket is to satisfy the super Jacobi identity
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GradedJacobiIdentity"} (1)
          %p It remains to show that:
          #SuperJacobiForSuperLieAlgebraInducedFromVectorSpace.num_prop
            %h6#proposition_3 Proposition
            %p
              Def.
              %a.maruku-ref{:href => "#TheSuperLieAlgebraInducedFromVectorSpace"}
              indeed gives a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              in that the bracket
              %a.maruku-eqref{:href => "#eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace"} (5)
              satisfies the super Jacobi identity
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GradedJacobiIdentity"} (1)
          .proof
            %h6#proof Proof
            %p
              We proceed by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              By Remark
              %a.maruku-ref{:href => "#ConstraintsOnBracketInSuperLieAlgebraInducedByVectorSpace"}
              we have that the super Jacobi identity holds for for all
              %a.existingWikiWord{:href => "/nlab/show/triples"} triples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mo ,
                    %msub
                      %mi f
                      %mn 3
                    %mo ∈
                    %mover
                      %mi V
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} f_1, f_2, f_3 \in \widehat{V}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} deg(f_3) \geq 0
            %p
              Now assume that the super Jacobi identity has been shown for triples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mo ,
                    %msub
                      %mi f
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_1, f_2, f_3(v))
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 3
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f_1, f_3, f_2(v))
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} v \in V
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo ,
                      %msub
                        %mi f
                        %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f_1, f_2, f_3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 2
                            %mo ,
                            %msub
                              %mi f
                              %mn 3
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 2
                            %mo ,
                            %msub
                              %mi f
                              %mn 3
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 3
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 2
                            %mo ,
                            %msub
                              %mi f
                              %mn 3
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %msub
                              %mi f
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi f
                              %mn 2
                            %mo ,
                            %msub
                              %mi f
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mphantom
                              %mo =
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %msub
