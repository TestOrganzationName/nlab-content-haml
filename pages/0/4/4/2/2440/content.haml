          %h2#idea Idea
          %p
            A
            %em super Lie algebra
            is the analog of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
          %h2#definition Definition
          %p
            There are various equivalent ways to state the definition of super Lie algebras. Here are a few (for more discussion see at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+superalgebra"} geometry of physics – superalgebra
          %h3#AsLieAlgebrasInternalToSuperVectorSpaces As Lie algebras internal to super vector spaces
          #SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces.num_defn
            %h6#definition_2 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+object"} Lie algebra object
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sVect
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sVect = (Vect^{\mathbb{Z}/2}, \otimes_k, \tau^{super} )
              of
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              (a
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+object"} Lie algebra object
                  in
                  %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %li
                %p a homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
