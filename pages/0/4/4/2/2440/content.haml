            %blockquote
              %p (Fine, but is this sufficient to induct over the full range of all three degrees?)
          #LieBracketOnglInsideSuperLieAlgebraInducedFromVectorSpace.num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
