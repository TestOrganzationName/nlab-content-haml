                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\iota} G
              has
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/index+of+a+subgroup"} index
              (in particular if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is already a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.maruku-eqref{:href => "#eq:LeftInducedRepresentation"} (2)
              and right induced representation functors
              %a.maruku-eqref{:href => "#eq:RightInducedRepresentation"} (5)
              are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mo !
                      %mo ≃
                      %msub
                        %mi ι
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \iota_! \simeq \iota_{\ast}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \iota^\ast
              an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous adjunction
          .proof
            %h6 Proof
            %p
              By Lem.
              = succeed "." do
