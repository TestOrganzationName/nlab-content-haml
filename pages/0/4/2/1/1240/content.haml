          #RightAdjunctionConit.num_cor
            %h6 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \epsilon^{R}
              of the right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                    %mo ⊣
                    %msub
                      %mi ι
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \iota^\ast \dashv \iota_\ast
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#RightInductionAdjunction"}
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              at the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi hom
                            %mi H
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi V
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mphantom
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo −
                              %msubsup
                                %mi ϵ
                                %mi V
                                %mi R
                              %mphantom
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo −
                        %mtd
                          %mi V
                      %mtr
                        %mtd
                          %mi ϕ
                        %mtd
                          %mo ↦
                        %mtd
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} e
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcc}
                    hom_H\big(
                    \\mathbb{K}[G]
                    ,\,
                    V
                    \\big)
                    \&amp;\xrightarrow{\phantom{--} \epsilon^R_V \phantom{--}}&amp;
                    V
                    \\\
                    \\phi &amp;\mapsto&amp; \phi(\mathrm{e})
                    \\end{array}
            %p
          .proof
            %h6 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              is (see
              = succeed ")" do
                %a{:href => "adjoint+functor#AdjunctionUnitFromHomIsomorphism"} there
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi hom
                            %mi H
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi V
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mphantom
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo −
                              %mi id
                              %mphantom
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo −
                        %mtd
                          %msub
                            %mi hom
                            %mi H
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi V
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    hom_H\big(
                    \\mathbb{K}[G]
                    ,\,
                    V
                    \\big)
                    \&amp;\xrightarrow{\phantom{--} id \phantom{--}}&amp;
                    hom_H\big(
                    \\mathbb{K}[G]
                    ,\,
                    V
                    \\big)
                    \\mathrlap{\,,}
                    \\end{array}
            %p
              hence is its image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi id
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{id}
              under the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:RightHomIso"} (7)
              %a.maruku-eqref{:href => "#eq:RightHomIso"} (7)
              we have indeed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi id
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{id}(\phi)
                    \\;=\;
                    id(\phi)(\mathrm{e})
                    \\;=\;
                    \\phi(\mathrm{e})
                    \\,.
            %p
          %p
            %br/
          %h3#GroupoidFormulation Groupoid formulation
          %p
            A first step towards a deeper understanding for what’s going on with induced representations
            %a{:href => "#TraditionalFormulation"} above
            is to
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolve
            the subgroup inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mover
                    %mo ↪
                    %mi ι
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\iota} G
            to a (
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"}> Kan
            )
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %em sums/products
            of contributions over the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\iota
          %p
            To that end, recall for any
            %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ↷
                  %mi S
                %annotation{:encoding => "application/x-tex"} G \curvearrowright S
            on a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
          %div{:style => "margin: -30px 0px 20px 30px"}
            %img{:src => "/nlab/files/InducedRep-ActionGroupid.png", :width => "700px"}/
          %p
            Examples are
            %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            and “
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy
            %a.existingWikiWord{:href => "/nlab/show/double+coset"} double coset
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo \
                    %mspace{:width => "negativethinmathspace"}
                    %mo \
                    %mi G
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "negativethinmathspace"}
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \backslash\!\backslash G\!/\!H
          %div{:style => "margin: -30px 0px 20px 30px"}
            %img{:src => "/nlab/files/InducedRep-DeloopingGroupoid.png", :width => "760px"}/
          %p
            where our variance convention is such that
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \xrightarrow{\;} \mathcal{C}
            are equivalent to
            %em left
            %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
            %a.existingWikiWord{:href => "/nlab/show/action+object"} in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi Vec
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \xrightarrow{\;} Vec
            are directly identified with
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi Vec
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi G
                  %mi Rep
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Func(\mathbf{B}G,\, Vec)
                  \\;\simeq\;
                  G Rep
                  \\,.
          %p
            Accordingly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ∈
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Grpd
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi Vec
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \xrightarrow{\;} Vec
            are linear
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/groupoid+representations"} groupoid representations
          %p
          #ResolvingHRepsToGroupoidReps.num_lemma
            %h6 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mover
                      %mo ↪
                      %mi ι
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\iota} G
              a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              inclusion:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy
                  %a.existingWikiWord{:href => "/nlab/show/double+coset"} double coset
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo \
                        %mspace{:width => "negativethinmathspace"}
                        %mo \
                        %mi G
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mi H
                      %annotation{:encoding => "application/x-tex"} G \backslash\!\backslash G\!/\!H
                  is
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %mi G
                        %mo \
                        %mspace{:width => "negativethinmathspace"}
                        %mo \
                        %mi G
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{B}H \,\simeq\, G \backslash\!\backslash G\!/\!H
                        \\,,
              %li
                %p such that the canonical functor
                #eq:ResolutionOfBIota.maruku-equation
                  %span.maruku-eq-number (8)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo \
                        %mspace{:width => "negativethinmathspace"}
                        %mo \
                        %mi G
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mi H
                        %mover
                          %mo →
                          %mphantom
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo −
                              %mover
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mi ι
                                %mo ^
                              %mo −
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi G
                        %mo \
                        %mspace{:width => "negativethinmathspace"}
                        %mo \
                        %mo{:stretchy => "false"} {
                        %mo *
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"}
                        G \backslash\!\backslash G\!/\!H
                        \\xrightarrow{\phantom{--\widehat{\mathbf{B}\iota}--}}
                        G \backslash\!\backslash \{\ast\}
                        \\,\simeq\,
                        \\mathbf{B}G
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi ι
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi H
                        %mover
                          %mo →
                          %mspace{:width => "thickmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}\iota \,\colon\, \mathbf{B}H \xrightarrow{\;} \mathbf{B}G
                  by a
                  %a{:href => "Kan+fibration#SurjectiveKanFibrations"} surjective
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                %p
                  %a{:href => "fiber+sequence#HomotopyFiber"} thus
                  exhibiting its ordinary
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mi H
                      %annotation{:encoding => "application/x-tex"} G\!/\!H
                  as the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi ι
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}\iota
              %li
                %p
                  the induced
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
                  of
                  %a.existingWikiWord{:href => "/nlab/show/groupoid+representation"} representation
                  %a.existingWikiWord{:href => "/nlab/show/representation+categories"} -categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mi Rep
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Func
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi H
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Vect
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Func
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo \
                        %mspace{:width => "negativethinmathspace"}
                        %mo \
                        %mi G
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mi H
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Vect
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        H Rep
                        \\;\simeq\;
                        Func(\mathbf{B}H,\,Vect)
                        \\;\simeq\;
                        Func(G \backslash\!\backslash G\!/\!H,\,Vect)
                %p
                  is exhibited by sending a given
                  = succeed "-representation" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi.mathscript 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathscr{V}
                  to the groupoid representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi.mathscript 𝒱
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{\mathscr{V}}
                  given by
            %div{:style => "margin: -30px 0px 20px 30px"}
              %img{:src => "/nlab/files/InducedRep-ResolvingHRep.png", :width => "230px"}/
            %p
          %blockquote
            %p
              Note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi H
                  %annotation{:encoding => "application/x-tex"} g \cdot H
              on the left is (the name of) an object of the groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo \
                      %mspace{:width => "negativethinmathspace"}
                      %mo \
                      %mi G
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G \backslash\!\backslash G\!/\!H
              = succeed "-translates" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p
          .proof
            %h6 Proof
            %p
              The following functor is evidently both
              %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              as well as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              %a{:href => "equivalence+of+categories#ViaEssentiallySurjectiveAndFullyFaithful"} therefore
              is an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            %div{:style => "margin: -30px 0px 20px 30px"}
              %img{:src => "/nlab/files/InducedRep-ResolvingBH.png", :width => "240px"}/
            %p
              The claim that this factors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\iota
              through a
              %a{:href => "Kan+fibration#SurjectiveKanFibrations"} surjective
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              is now immediate from inspection.
            %p
              Moreover, the following inspection shows that the claimed operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{(-)}
              extends to a functor which is a strict
              %a.existingWikiWord{:href => "/nlab/show/right+inverse"} right inverse
              to precomposition with the previous resolution functor:
            %div{:style => "margin: -30px 0px 20px 30px"}
              %img{:src => "/nlab/files/InducedRep-ProofOfResolvingHRep.png", :width => "540px"}/
            %blockquote
              %p
                (To note here that the
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                in the middle is indeed well-defined, due to the
                = succeed "-property" do
                  %a.existingWikiWord{:href => "/nlab/show/intertwiner"} intertwining
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                of
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            %p
              Hence by the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+groupoids"} equivalences of groupoids
              (cf. the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure+on+groupoids"} canonical model structure on groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{(-)}
              is an equivalence, as claimed.
          %p
            With this in hand we have an equivalent but “more obvious” re-statement of the existence of left induced representations
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:LeftInducedRepresentation"} (2)
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong (resolved left induced representation)
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
