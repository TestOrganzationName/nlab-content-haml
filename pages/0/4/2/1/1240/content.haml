                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} End_G(Ind_i E)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ind
                    %mi i
                  %mi E
                %annotation{:encoding => "application/x-tex"} Ind_i E
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Rep
                %annotation{:encoding => "application/x-tex"} G Rep
            is called the
            %em centralizer algebra
            or also the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Hecke+algebra"} Hecke algebra
            or
            %em
              %span.newWikiWord
                Iwahori-Hecke algebra
                %a{:href => "/nlab/new/Iwahori-Hecke+algebra"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hecke
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hecke(E,i)
            of the induced representation. (Basics are in
            = succeed "," do
              %a{:href => "#Woit"} Woit, def. 2
            = succeed "," do
              %a{:href => "#CurtisReiner81"} Curtis &amp; Reiner 1981, section 67
            = succeed "." do
              %a{:href => "#Srinivasan"} Srinivasan
          %p
            In terms of the notation in
            %em
              %a{:href => "#GeneralAbtractDefinition"} General abstract formulation
            above and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi H
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} i \colon H \to G
            any homomorphism of
            = succeed "-groups," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-monoid"} ∞-monoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hecke
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mrow
                        %mo [
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi i
                        %mi E
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi i
                        %mi E
                        %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Hecke(E,i)
                  \\;\coloneqq\;
                  \\textstyle{
                  \\underset{\mathbf{B}G}{\prod}
                  \\left[
                  \\underset{\mathbf{B}i}{\sum} E
                  ,\,
                  \\underset{\mathbf{B}i}{\sum} E
                  \\right]
                  }
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            is the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo ≃
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G} \simeq G Act(\mathbf{H})
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi Act
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \in Act(G)
            any other representation, there is a canonical
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hecke
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hecke(E,i)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mrow
                      %mo [
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi i
                      %mi E
                      %mo ,
                      %mi V
                      %mo ]
                  %annotation{:encoding => "application/x-tex"} \underset{\mathbf{B}G}{\prod} \left[\underset{\mathbf{B}i}{\sum} E , V \right]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the trivial representation then by adjointness this is the
            %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi G
                %annotation{:encoding => "application/x-tex"} V^G
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and hence the Hecke algebra acts on the invariants. (See for instance
            = succeed ")." do
              %a{:href => "#Woit"} Woit, def. 2
            %em Hecke algebra action on the Iwahori fixed vectors
            (
            %a{:href => "#http://sporadic.stanford.edu/bump/bbf.pdf"}> e.g. here, p. 9
            )
          %h3#zuckerman_functors_coinduction_on_harishchandra_modules Zuckerman functors: Coinduction on Harish-Chandra modules
          %p
            Coinduction on
            %a.existingWikiWord{:href => "/nlab/show/Harish-Chandra+modules"} Harish-Chandra modules
            is referred to as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Zuckerman+induction"} Zuckerman induction
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                The identification of representation induction as the extra left adjoint in a
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                morphism, as discussed in the
                %em
                  %a{:href => "#GeneralAbtractDefinition"} General abstract discussion
                above, puts induced representations in the same general abstract framework as
                %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
                in
                %a.existingWikiWord{:href => "/nlab/show/logic"} logic
                and generally of
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
                in
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
                (see there for more details). This relation has first been amplified in (
                %a{:href => "#Lawvere"}> Lawvere
                ).
            %li
              %p
                If the modules over a group are considered as comodules over the function Hopf algebra over the group, then one can instead consider the induction for comodules. See
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                of the representation induction functor is often referred to as
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cohomological+induction"} cohomological induction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mackey+theory"} Mackey theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac+induction"} Dirac induction
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/character"} character
                of an induced representation is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/induced+character"} induced character
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Artin+induction+theorem"} Artin induction theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brauer+induction+theorem"} Brauer induction theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Artin-Lam+induction+exponent"} Artin-Lam induction exponent
          %div
            %p
              %strong
