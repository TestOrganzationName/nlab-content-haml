            = succeed "." do
              %a{:href => "#Lawvere70"} 1970 p. 5
          %h2#properties Properties
          %h3#Ambidexterity Norm map &amp; Ambidexterity
          %p
            We show that for subgroup inclusions of
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %a.existingWikiWord{:href => "/nlab/show/index+of+a+subgroup"} index
            the left and right induced representations (
            %a{:href => "#TraditionalFormulation"}> above
            ) agree.
          %p
          #ComparisonBetweenLeftAndRightInducedRepresentations.num_lemma
            %h6 Lemma
            %p
              %strong (comparison map between left and right induced representations)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\;} G
              a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              inclusion and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi H
                      %mi Rep
                    %annotation{:encoding => "application/x-tex"} V \in H Rep
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant"} equivariant
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              from the left
              %a.maruku-eqref{:href => "#eq:LeftInducedRepresentation"} (2)
              into the right induced representation
              %a.maruku-eqref{:href => "#eq:RightInducedRepresentation"} (5)
            #eq:NormMap.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mo !
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi 𝕂
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo ⊗
                      %mrow
                        %mi 𝕂
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                    %mi V
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo −
                        %mi ϕ
                        %mphantom
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo −
                    %msub
                      %mi hom
                      %mi H
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi V
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mo *
                    %mi V
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_! V
                    \\,\equiv\,
                    \\mathbb{K}[G] \otimes_{\mathbb{K}[H]} V
                    \\xhookrightarrow{\phantom{--}\phi\phantom{--}}
                    hom_H\big(
                    \\mathbb{K}[G]
                    ,\,
                    V
                    \\big)
                    \\,\equiv\,
                    \\iota_\ast V
                    \\mathrlap{\,,}
            %p
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              if the subgroup inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
              has
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/index+of+a+subgroup"} index
            %p
          .proof
            %h6 Proof
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              to take homogeneous elements of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [g,v]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                      %mo ⊂
                      %mi 𝕂
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} g \in G \subset \mathbb{K}[G]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝕂
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \phi[g,v] \,\colon\, \mathbb{K}[G] \to V
              which, in turn, is given on basis elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo ∈
                    %mi G
                    %mo ⊂
                    %mi 𝕂
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} g' \in G \subset \mathbb{K}[G]
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ′
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi h
                            %mo ⋅
                            %mi v
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi g
                            %mo ′
                            %mo =
                            %mi h
                            %mo ⋅
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\phi[g,v]
                    \\;\colon\;
                    g'
                    \\;\mapsto\;
                    \\left\{
                    \\begin{array}{lll}
                    h \cdot v &amp;\vert&amp; g' = h \cdot g^{-1}
                    \\\
                    0 &amp;\vert&amp; \text{otherwise}
                    \\end{array}
                    \\right.
            %p First to observe that this construction is well defined, in that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} [
                        %mi g
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \phi[g,v]
                  is
                  = succeed "-equivariant," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                %p which is immediate from the form of the above formula;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
                  is independent of the choice of representative
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi g
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mi g
                          %mo ⋅
                          %mi k
                          %mo ,
                          %msup
                            %mi k
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo ⋅
                          %mi v
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [g,v] = [g \cdot k, k^{-1}\cdot v]
                %p which is seen from
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} [
                        %mi g
                        %mo ⋅
                        %mi k
                        %mo ,
                        %msup
                          %mi k
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %mi v
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi g
                        %mo ′
                        %mspace{:width => "thickmathspace"}
                        %mo ↦
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo {
                          %mtable{:columnalign => "left left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                            %mtr
                              %mtd
                                %mi h
                                %mo ⋅
                                %msup
                                  %mi k
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo ⋅
                                %mi v
                              %mtd
                                %mo{:stretchy => "false"} |
                              %mtd
                                %mi g
                                %mo ′
                                %mo =
                                %mi h
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo ⋅
                                %mi k
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo =
                                %mi h
                                %mo ⋅
                                %msup
                                  %mi k
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo ⋅
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mo{:stretchy => "false"} |
                              %mtd
                                %mtext otherwise
                      %annotation{:encoding => "application/x-tex"}
                        \\phi[g \cdot k, k^{-1} \cdot v]
                        \\;\colon\;
                        g'
                        \\;\mapsto\;
                        \\left\{
                        \\begin{array}{lll}
                        h \cdot k^{-1} \cdot v
                        \&amp;\vert&amp;
                        g'
                        \=
                        h \cdot (g \cdot k)^{-1}
                        \=
                        h \cdot k^{-1} \cdot g^{-1}
                        \\\
                        0 &amp;\vert&amp; \text{otherwise}
                        \\end{array}
                        \\right.
                %p
                  whence indeed
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} [
                        %mi g
                        %mo ⋅
                        %mi k
                        %mo ,
                        %msup
                          %mi k
                          %mrow
