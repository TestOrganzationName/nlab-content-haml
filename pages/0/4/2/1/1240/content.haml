              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mover
                    %mo ↪
                    %mi ι
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\iota} G
            then the evident operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                %annotation{:encoding => "application/x-tex"} \iota^\ast
            of
            %a.existingWikiWord{:href => "/nlab/show/restricted+representation"} restricting
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to
            = succeed "-representations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
