          %p Hence:
          %p
          #AmbidexterityForFiniteIndexSubgroups.num_prop
            %h6 Proposition
            %p
              %strong (induction along finite-index inclusions is ambidextrous)
              %br/
              When the subgroup inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
