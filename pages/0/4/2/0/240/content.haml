          %h2#definition Definition
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is
            %strong well-pointed
            if
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                1 is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/separator"} generator
              %ul
                %li
                  %p
                    equivalently: the
                    %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
                    functor
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo :
                          %mi E
                          %mo →
                          %mi Set
                          %mo =
                          %mi E
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Gamma : E \to Set = E(1, -)
                    is a
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
                %li
                  %p
                    equivalently: if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                          %mo :
                          %mi a
                          %mo →
                          %mi b
                        %annotation{:encoding => "application/x-tex"} f, g: a \rightarrow b
                    are morphisms such that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mi x
                          %mo =
                          %mi g
                          %mi x
                        %annotation{:encoding => "application/x-tex"} f x = g x
                    for all
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo :
                            %mn 1
                            %mo →
                            %mi a
                          %annotation{:encoding => "application/x-tex"} x: 1 \to a
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                            %mo =
                            %mi g
                          %annotation{:encoding => "application/x-tex"} f = g
                %li
                  %p
                    equivalently: the family of all global elements
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo :
                          %mn 1
                          %mo →
                          %mi a
                        %annotation{:encoding => "application/x-tex"} x: 1 \to a
                    is a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/jointly+epimorphic+family"} jointly epimorphic family
            %li
              %p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is nondegenerate, i.e., 1 is not an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          %h2#examples Examples
          %ul
            %li
              %p
                The category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
                functor is even (isomorphic to) the identity functor.
            %li
              %p
                Any model of
                = succeed "." do
