            in prop.
            = succeed "," do
              %a.maruku-ref{:href => "#AdelicIntegralIncarnationOfCompletedZeta"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi n
                  %mo ∈
                  %msub
                    %mi ℤ
                    %mi p
