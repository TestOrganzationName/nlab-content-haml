          %p
            This way the inner integration is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℚ
                          %mo ×
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi d
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \int_{\mathbb{Q}^\times} \exp(-S(x n))  d n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
