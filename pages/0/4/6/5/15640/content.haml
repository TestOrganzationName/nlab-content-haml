            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            (by the
            = succeed ")," do
              %a{:href => "fracture+theorem#ArithmeticFractureSquares"} arithmetic fracture square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mo ∫
                            %mrow
                              %msup
                                %mi ℚ
                                %mo ×
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mi d
                          %mi n
                        %mtd
                          %mo =
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi n
                              %mo ∈
                              %msup
                                %mi ℤ
                                %mo ×
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi π
                          %msup
                            %mi n
