                  \\alpha=x n
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            runs through representatives of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mo ×
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ℚ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^\times/\mathbb{Q}^\times
            and can be chosen as
            %a.existingWikiWord{:href => "/nlab/show/ideles"} ideles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
