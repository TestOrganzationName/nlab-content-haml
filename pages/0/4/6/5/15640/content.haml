                            %mn ∞
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\int_{\mathbb{Q}^\times}\exp(-S(x n))  d n
                  \&amp; =
                  \\sum_{n\in \mathbb{Z}^\times} exp(-\pi n^2 x_\infty^2)
                  \\\
                  \&amp; = \theta(x_\infty^2)-1
                  \\end{aligned}
          %p
            Therefore the full integral becomes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
