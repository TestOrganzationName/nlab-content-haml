                    %mi x
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x=(x_2,x_3,...x_\infty)
            with non-archimedean coordinates being units in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
