          %h3#TheCompletedZetaFunction The completed zeta function
          %p The following slight variant of the actual Riemann zeta function typically exhibits its special properties more explicitly.
          #CompletedRiemannZetaFunction.num_defn
            %h6#definition Definition
            %p
              The
              %em completed
              Riemann zeta function is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ζ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mi ζ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \zeta(s) \coloneqq \pi^{-s/2}\Gamma(s/2)\zeta(s)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(-)
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Gamma+function"} Gamma function
          #AdelicIntegralIncarnationOfCompletedZeta.num_prop
            %h6#proposition Proposition
            %p
              The completed Riemann zeta function, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompletedRiemannZetaFunction"}
              %a.existingWikiWord{:href => "/nlab/show/adelic+integral"} adelic integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ζ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %msubsup
                          %mi 𝔸
                          %mi ℚ
                          %mo ×
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo{:stretchy => "false"} |
                      %mi s
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %msub
                      %mi μ
                      %mrow
                        %msubsup
                          %mi 𝔸
                          %mi ℚ
                          %mo ×
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \zeta(s)
                    \=
                    \\int_{\mathbb{A}_{\mathbb{Q}}^\times }
                    \\exp(-S(x))
                    \\;
                    {\vert x\vert}^s
                    \\;
                    d \mu_{\mathbb{A}_{\mathbb{Q}}^\times}(x)
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msubsup
                          %mi 𝔸
                          %mi ℚ
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} \exp(-S(-))\colon \mathbb{A}_{\mathbb{Q}}^\times
                  denotes the function which sends an
                  %a.existingWikiWord{:href => "/nlab/show/idele"} idele
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msubsup
                          %mi 𝔸
                          %mi ℚ
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{A}_{\mathbb{Q}}^\times
                  with canonical components
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn ∞
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi x
                          %mi p
                        %mo ,
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x = (x_\infty, x_2, \cdots, x_p, \cdots)
                %p to the product
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi π
                        %msubsup
                          %mi x
                          %mn ∞
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi p
                            %mspace{:width => "thickmathspace"}
                            %mi prime
                        %msub
                          %mi χ
                          %mrow
                            %msub
                              %mi ℤ
                              %mi p
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi p
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\exp(-S(x)) \coloneqq \exp(-\pi x_\infty^2)\prod_{p \; prime} \chi_{\mathbb{Z}_p}(x_p)
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi χ
                          %mrow
                            %msub
                              %mi ℤ
                              %mi p
                      %annotation{:encoding => "application/x-tex"} \chi_{\mathbb{Z}_p}
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic function
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
                  inside the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
                %p
                  (
                  %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, def. 2.2.5
                  ).
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/measure"} measure
                  is essentially the
                  %a.existingWikiWord{:href => "/nlab/show/Haar+measure"} Haar measure
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/idele+group"} idele group
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi μ
                          %mrow
                            %msubsup
                              %mi 𝔸
                              %mi ℚ
                              %mo ×
                        %mo ≔
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi p
                            %mo ≤
                            %mn ∞
                        %msup
                          %mi d
                          %mo ×
                        %msub
                          %mi x
                          %mi p
                      %annotation{:encoding => "application/x-tex"}
                        d \mu_{\mathbb{A}_{\mathbb{Q}}^\times}
                        \\coloneqq
                        \\underset{p \leq \infty}{\prod}
                        d^\times x_p
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi d
                          %mo ×
                        %msub
                          %mi x
                          %mi p
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mfrac
                                    %mrow
                                      %mi d
                                      %msub
                                        %mi x
                                        %mn ∞
                                    %mrow
                                      %msub
                                        %mrow
                                          %mo{:stretchy => "false"} |
                                          %msub
                                            %mi x
                                            %mn ∞
                                          %mo{:stretchy => "false"} |
                                        %mn ∞
                                %mtd
                                  %mi if
                                  %mspace{:width => "thickmathspace"}
                                  %mi p
                                  %mo =
                                  %mn ∞
                              %mtr
                                %mtd
                                  %mfrac
                                    %mn 1
                                    %mrow
                                      %mn 1
                                      %mo −
                                      %msup
                                        %mi p
                                        %mrow
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                  %mfrac
                                    %mrow
                                      %mi d
                                      %msub
                                        %mi x
                                        %mi p
                                    %mrow
                                      %msub
                                        %mrow
                                          %mo{:stretchy => "false"} |
                                          %msub
                                            %mi x
                                            %mi p
                                          %mo{:stretchy => "false"} |
                                        %mi p
                                %mtd
                                  %mi if
                                  %mspace{:width => "thickmathspace"}
                                  %mi p
                                  %mspace{:width => "thickmathspace"}
                                  %mi finite
                                  %mspace{:width => "thickmathspace"}
                                  %mi prime
                      %annotation{:encoding => "application/x-tex"}
                        d^\times x_p
                        \\coloneqq
                        \\left\{
                        \\array{
                        \\frac{d x_\infty}{{\vert x_\infty\vert}_\infty} &amp; if \; p = \infty
                        \\\
                        \\frac{1}{1-p^{-1}}\frac{d x_p}{{\vert x_p\vert}_p} &amp; if\; p \; finite \; prime
                        }
                        \\right.
                %p
                  (
                  %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, def. 2.2.3
                  )
          %p
            (reviewed e.g. in
            = succeed "," do
              %a{:href => "#Fesenko08"} Fesenko 08 0.1
            = succeed "," do
              %a{:href => "#Garrett11"} Garrett 11, section 1
            = succeed ")." do
              %a{:href => "#GoldfeldHundley11"} Goldfeld-Hundley 11 (2.2.6)
          %h3#RelationToThetaFunctions Relation to the Jacobi theta function
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The completed zeta function, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompletedRiemannZetaFunction"}
              %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
              of the
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+theta+function"} Jacobi theta function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %msup
                      %mi n
                      %mn 2
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta(x)\coloneqq \underset{n \in \mathbb{Z}}{\sum} \exp(- \pi n ^2 x)
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi ζ
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi x
                              %mi s
                            %mfrac
                              %mrow
                                %mi d
                                %mi x
                              %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo =
                              %mrow
                                %mi τ
                                %mo :
                                %mo =
                                %msup
                                  %mi x
                                  %mn 2
                            %mfrac
                              %mn 1
                              %mn 2
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %mi τ
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi τ
                              %mrow
                                %mi s
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mfrac
                              %mrow
                                %mi d
                                %mi τ
                              %mi τ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\hat \zeta(s)
                    \&amp;=
                    \\int_0^\infty (\theta(x^2)-1) x^s  \frac{d x}{x}
                    \\\
                    \&amp; \stackrel{\tau := x^2}{=}
                    \\frac{1}{2} \int_0^\infty (\theta(\tau)-1) \tau^{s/2}  \frac{d \tau}{\tau}
                    \\end{aligned}
                    \\,.
            %p
              e.g. (
              %a{:href => "#Fesenko08"}> Fesenko 08, section 0.1
              ,
              = succeed ")" do
                %a{:href => "#Kowalski"} Kowalski, example 2.2.5
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/idelic+integral"} idelic integral
            expression for the complete zeta-function of prop.
            = succeed "," do
              %a.maruku-ref{:href => "#AdelicIntegralIncarnationOfCompletedZeta"}
          %p
            We compute the integral
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi 𝔸
                        %mo ×
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi α
                  %msup
                    %mo{:stretchy => "false"} |
                    %mi s
                  %mi d
                  %msub
                    %mi μ
                    %mrow
                      %msup
                        %mi 𝔸
                        %mo ×
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_{\mathbb{A}^\times} \exp(-S(\alpha))) |\alpha|^s d\mu_{\mathbb{A}^\times}(\alpha)
            – as in (
            %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, pages 47-50
            ) and the remarks by
            %a.existingWikiWord{:href => "/nlab/show/Ivan+Fesenko"} Ivan Fesenko
            in (
            %a{:href => "#GoldfeldHundley11"}> Goldfeld-Hundley 11, pages 51-51
            ).
          %p
            We decompose by the
            %a{:href => "group+of+ideles#StrongApproximationTheorem"} strong approximation theorem for ideles
            the integration domain into the
            %a.existingWikiWord{:href => "/nlab/show/idele+class+group"} idele class group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℚ
                    %mo ×
                  %mo \
                  %msubsup
                    %mi 𝔸
                    %mi ℚ
                    %mo ×
                  %mo =
                  %mo{:stretchy => "false"} (
