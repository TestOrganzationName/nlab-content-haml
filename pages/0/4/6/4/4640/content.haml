                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \subset \mathbb{Z}
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi k
                  %mo{:stretchy => "false"} [
