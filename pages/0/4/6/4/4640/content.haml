                  \\,.
          %p The quotient by the multiplicative group action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                  %msubsup
                    %mi P
                    %mi k
                    %mi n
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔸
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
