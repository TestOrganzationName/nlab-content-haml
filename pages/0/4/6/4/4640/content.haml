          %h2#examples Examples
          %h3#projective_space Projective space
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the multiplicative group on the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo :
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                      %mi ⋯
                      %mi n
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^n := \prod_{i = 1 \cdots n} \mathbb{A}^1
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo ×
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo →
                  %msup
                    %mi 𝔸
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{A}^n \times \mathbb{G}_m \to \mathbb{A}^n
          %p is dually the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo ,
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi t
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ←
                  %mi k
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi t
                    %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  k[t, t_1, \cdots, t_n] \leftarrow k[t_1, \cdots, t_n]
          %p given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                  %mo ↦
                  %mi t
                  %mo ⋅
                  %msub
                    %mi t
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  t_i \mapsto t \cdot t_i
                  \\,.
          %p
            This makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[t,\{t_i\}]
            the free
            %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            generators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
