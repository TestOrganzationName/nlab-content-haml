                    %mi t
                    %mn 1
                  %mo ,
                  %msubsup
                    %mi t
                    %mn 1
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi t
                    %mi n
                  %mo ,
                  %msubsup
                    %mi t
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
