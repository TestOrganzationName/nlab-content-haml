                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+Lawvere+theory"} algebras over a Lawvere theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                  %mo =
                  %msub
                    %mi Alg
                    %mi k
                %annotation{:encoding => "application/x-tex"} T Alg = Alg_k
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .num_defn
            %h6#definition_2 Definition
            %p
              The canonical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
              is the
              %strong affine line
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔸
                      %mi k
                    %mo :
                    %mo =
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{A}_k := Spec(F_T(*))  = Spec (k[t])
                    \\,.
          %p
            Here the
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_T(*)
            is the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msub
                    %mi Alg
                    %mi k
                %annotation{:encoding => "application/x-tex"} k[t] \in Alg_k
            on a single generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo =
                  %mi t
                %annotation{:encoding => "application/x-tex"} * = t
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Spec k[t]
            may be regarded as the corresponding object in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Aff
                    %mi k
                  %mo :
                  %mo =
                  %msubsup
                    %mi Alg
                    %mi k
                    %mi op
                %annotation{:encoding => "application/x-tex"} Aff_k := Alg_k^{op}
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi k
                  %annotation{:encoding => "application/x-tex"} Spec  k
          %h3#MultiplicativeGroup Multiplicative group
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ring
                    %mi op
                %annotation{:encoding => "application/x-tex"} Ring^{op}
            corresponding to the affine line – usually just called the
            %strong multiplicative group
            – is the
            %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group scheme
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
          %ul
            %li
              %p whose underlying affine scheme is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo −
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mi Spec
                      %mrow
                        %mo (
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi t
                        %mo ,
                        %msup
                          %mi t
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbb{A}^1 - \{0\}) := Spec \left(k[t,t^{-1}]\right)
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo ,
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[t,t^{-1}]
                is the
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                of the ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[t]
                at the element
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo −
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} t = (t-0)
            %li
              %p whose multiplication operation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋅
                      %msub
                        %mi 𝔾
                        %mi m
                      %mo ×
                      %msub
                        %mi 𝔾
                        %mi m
                      %mo →
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"}
                      \\cdot \mathbb{G}_m \times \mathbb{G}_m \to \mathbb{G}_m
              %p
                is the morphism in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ring
                        %mi op
                    %annotation{:encoding => "application/x-tex"} Ring^{op}
                corresponding to the morphism in
                %a.existingWikiWord{:href => "/nlab/show/Ring"} Ring
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi t
                        %mn 1
                      %mo ,
                      %msubsup
                        %mi t
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo ⊗
                        %mi k
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi t
                        %mn 2
                      %mo ,
                      %msubsup
                        %mi t
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ←
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo ,
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      k[t_1,t_1^{-1}] \otimes_k k[t_2, t_2^{-1}] \leftarrow k[t,t^{-1}]
              %p
                given by
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ↦
                        %msub
                          %mi t
                          %mn 1
                        %mo ⋅
                        %msub
                          %mi t
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} t \mapsto t_1 \cdot t_2
            %li
              %p
                whose unit map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mi k
                      %mo →
                      %mi Spec
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo ,
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Spec k \to Spec k[t,t^{-1}]
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      t \mapsto 1
            %li
              %p
                and whose inversion map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo ,
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Spec
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo ,
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Spec k[t,t^{-1}] \to Spec[t,t^{-1}]
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %msup
                        %mi t
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      t \mapsto t^{-1}
                      \\,.
          %p
            Therefore for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            any
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                  %mo ⟶
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
                  Spec R \longrightarrow \mathbb{G}_m
          %p is equivalently a ring homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ←
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo ,
                  %msup
                    %mi t
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  R \leftarrow k[t,t^{-1}]
          %p
            which is equivalently a choice of multiplicatively invertible element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi R
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi R
                    %mo ×
                  %mo =
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom(Spec R , \mathbb{G}_m) \simeq R^\times = GL_1(R)
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#AdditiveGroup Additive group
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/additive+group"} additive group
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ring
                    %mi op
                %annotation{:encoding => "application/x-tex"} Ring^{op}
            corresponding to the affine line – usually just called the
            %strong additive group
            – is the
            %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group scheme
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi a
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_a
          %ul
            %li
              %p
                whose underlying object is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                itself;
            %li
              %p
                whose addition operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔾
                        %mi a
                      %mo ×
                      %msub
                        %mi 𝔾
                        %mi a
                      %mo →
                      %msub
                        %mi 𝔾
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}_a \times \mathbb{G}_a \to \mathbb{G}_a
                is dually the ring homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi t
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo ⊗
                        %mi k
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi t
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ←
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      k[t_1] \otimes_k k[t_2] \leftarrow k[t]
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %msub
                        %mi t
                        %mn 1
                      %mo +
                      %msub
                        %mi t
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      t \mapsto t_1 + t_2
                      \\,;
            %li
              %p whose unit map is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      t \mapsto 0
                      \\,;
            %li
              %p whose inversion map is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi t
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      t \mapsto -t
                      \\,.
          %h3#group_of_roots_of_unity Group of roots of unity
          %p
            The group of
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/roots+of+unity"} roots of unity
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi n
                  %mo =
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi t
                    %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu_n = Spec(k[t](t^n -1))
                  \\,.
          %p
            This sits inside the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            via the
            %a.existingWikiWord{:href => "/nlab/show/Kummer+sequence"} Kummer sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi n
                  %mo ⟶
                  %msub
                    %mi 𝔾
                    %mi m
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                  %msub
                    %mi 𝔾
                    %mi m
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu_n \longrightarrow \mathbb{G}_m \stackrel{(-)^n}{\longrightarrow}\mathbb{G}_m
                  \\,.
          %h2#Properties Properties
          %h3#Grading Grading
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} gradings
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi m
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/action"}> action
                  s on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spec
                          %mi R
                        %annotation{:encoding => "application/x-tex"} Spec R
          .proof
            %h6#proof Proof
            %p
              For the first direction, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded commutative algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} X = Spec R
              comes with a
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi X
                    %mo ×
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\rho :  X \times \mathbb{G}_m \to X
            %p is dually the ring homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mo ⊗
                      %mi k
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo ,
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ←
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    R \otimes_k \mathbb{Z}[t,t^{-1}] \leftarrow R
            %p
              defined on homogeneous elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ↦
                    %mi r
                    %mo ⋅
                    %msup
                      %mi t
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    r \mapsto r \cdot t^n
                    \\,.
            %p The action property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %msub
                              %mi 𝔾
                              %mi m
                            %mo ×
                            %msub
                              %mi 𝔾
                              %mi m
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi Id
                                %mo ×
                                %mo ⋅
                          %mtd
                            %mi X
                            %mo ×
                            %mi 𝔾
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi ρ
                                %mo ×
                                %mi Id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %msub
                              %mi 𝔾
                              %mi m
                          %mtd
                            %mover
                              %mo →
                              %mi ρ
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times \mathbb{G}_m \times \mathbb{G}_m &amp;\stackrel{Id \times \cdot}{\to}&amp; X \times \mathbb{G}
                    \\\
                    {}^{\mathllap{\rho} \times Id}\downarrow &amp;&amp; \downarrow^{\mathrlap{\rho}}
                    \\\
                    X \times \mathbb{G}_m &amp;\stackrel{\rho}{\to}&amp; X
                    }
            %p is equivalently the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mi r
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi t
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    r (t_1)^n \cdot (t_2)^n = r (t_1 \cdot t_2)^n
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
              of the action is the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (1)^n = 1
                    \\,.
            %p
              Conversely, given an action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Spec R
              we have some morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo ,
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ←
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    R[t,t^{-1}] \leftarrow R
            %p that sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %msub
                      %mi r
                      %mi n
                    %msup
                      %mi t
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    r \mapsto \sum_{n \in \mathbb{Z}} r_n t^n
                    \\,.
            %p By the action property we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi n
                    %msub
                      %mi r
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %msub
                      %mi t
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msubsup
                      %mi t
                      %mn 1
                      %mi n
                    %msubsup
                      %mi t
                      %mn 2
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_n r_n (t_1 t_2)^n = \sum_{n,k} (r_n)_k t_1^n t_2^k
                    \\,.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi r
                                %mi n
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mi k
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    (r_n)_k =
                    \\left\{
                    \\array{
                    r_n &amp; if \; n = k
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p
              and so the morphism gives a decomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              into pieces labeled by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %p
              One sees that these two constructions are
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              to each other.
          %h3#tale_homotopy_type Étale homotopy type
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              0, then the affine line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔸
                      %mi k
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1_k
              has a
              %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"} contractible
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+homotopy+type"} étale homotopy type
              \. This is no longer the case in
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
          %p
            (
            %a{:href => "#HSS13"}> HSS 13, section 1
            )
          %h3#InternalFormulation Internal formulation
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Sch
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(Sch/X)
              the
              %a.existingWikiWord{:href => "/nlab/show/Zariski+site"} big Zariski topos
              associated to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
              %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ↦
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ,
                      %msub
                        %mi 𝒪
                        %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T \mapsto \Gamma(T,\mathcal{O}_T)
              = succeed "-scheme" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝔸
                        %mi X
                        %mn 1
                      %mo ≔
                      %mi X
                      %mo ×
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1_X \coloneqq X \times Spec(\mathbb{Z}[t])
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                  is
                  %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internally
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                  is internally a
                  %a.existingWikiWord{:href => "/nlab/show/field"} field
                  in the sense that any nonzero element is invertible.
              %li
                %p
                  Internally, any
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msup
                          %mi 𝔸
                          %mn 1
                        %mo →
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} f : \mathbb{A}^1 \to \mathbb{A}^1
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
                  function, i.e. of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi a
                          %mi i
                        %msup
                          %mi x
                          %mi i
                      %annotation{:encoding => "application/x-tex"} f(x) = \sum_i a_i x^i
                  for some coefficients
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi a
                            %mi i
                          %mo :
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} a_i : \mathbb{A}^1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi Sch
                        %mo{:stretchy => "false"} /
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊧
                        %mo ∀
                        %mi f
                        %mo :
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝔸
                          %mn 1
                        %mo ,
                        %msup
                          %mi 𝔸
                          %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo .
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                        %mo ∃
                        %msub
                          %mi a
                          %mn 0
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi a
                          %mi n
                        %mo :
                        %msup
                          %mi 𝔸
                          %mn 1
                        %mo .
                        %mo ∀
                        %mi x
                        %mo :
                        %msup
                          %mi 𝔸
                          %mn 1
                        %mo .
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi a
                          %mi i
                        %msup
                          %mi x
                          %mi i
                        %mo .
                      %annotation{:encoding => "application/x-tex"} Sh(Sch/X) \models \forall f : [\mathbb{A}^1,\mathbb{A}^1]. \bigvee_{n \in \mathbb{N}} \exists a_0,\ldots,a_n : \mathbb{A}^1. \forall x : \mathbb{A}^1. f(x) = \sum_i a_i x^i.
                %p Furthermore, these coefficients are uniquely determined.
          .proof
            %h6#proof_2 Proof
            %p
              Since the internal logic is local, we can assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X = Spec(R)
              is affine. The interpretations of the asserted statements using the
              %a.existingWikiWord{:href => "/nlab/show/Zariski+site#KripkeJoyal"} Kripke–Joyal semantics
              are:
            %ul
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  be an
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} f, g \in S
                  be elements such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo +
                          %mi g
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} f + g = 1
