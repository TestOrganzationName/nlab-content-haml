          %h2#idea Idea
          %p
            Noncommutative symmetric functions are a generalisation of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
          %p Noncommutative symmetric functions also arise in their own right as interesting objects of study.
          %h2#definition Definition
          #nsymm.num_defn
            %h6#definition_2 Definition
            %p
              The graded
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              of
              = succeed "," do
                %strong noncommutative symmetric functions
              = succeed "," do
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} NSymm
                    %annotation{:encoding => "application/x-tex"} \NSymm
            %ol
              %li
                As an algebra, it is
                = succeed "," do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi Z
                          %mn 1
                        %mo ,
                        %msub
                          %mi Z
                          %mn 2
                        %mo ,
                        %mi …
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}\langle Z_1, Z_2, \dots \rangle
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %li
                The comultiplication is given by
                = succeed "," do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %msub
                          %mi Z
                          %mi n
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                            %mo =
                            %mi n
                        %msub
                          %mi Z
                          %mi i
                        %mo ⊗
                        %msub
                          %mi Z
                          %mi j
                      %annotation{:encoding => "application/x-tex"} \Delta Z_n = \sum_{i + j = n} Z_i \otimes Z_j
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Z
                          %mn 0
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} Z_0 = 1
              %li
                The counit is
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Z
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon(Z_n) = 0
                for
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n \ge 1
              %li
                The antipode is
                = succeed "," do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Z
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi wt
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi n
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi length
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi Z
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \iota(Z_n) = \sum_{wt(\alpha) = n} (-1)^{length(\alpha)} Z_\alpha
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi α
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi α
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \alpha = [\alpha_1, \cdots, \alpha_k]
                is a word in
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1,2,\dots\}
                with
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi length
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} length(\alpha) = k
                and
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi wt
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %msub
                          %mi α
                          %mi i
                      %annotation{:encoding => "application/x-tex"} wt(\alpha) = \sum \alpha_i
              %li
                The degree of
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Z_n
                is
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %h2#properties Properties
          %ol
            %li
              %p
                The object
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} NSymm
                    %annotation{:encoding => "application/x-tex"} \NSymm
                represents a functor from not-necessarily-commutative rings to groups given by sending
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                to formal power series in
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                with leading term
                = succeed "," do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ↦
                        %mn 1
                        %mo +
                        %mi t
                        %mi B
                        %mo{:stretchy => "false"} [
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} [
                        %mi t
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} B \mapsto 1 + t B[\![t]\!]
            %li
              %p
                It is dual to the Hopf algebra of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quasi-symmetric+functions"} quasi-symmetric functions
            %li
              %p
                The Hopf algebra of
                %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
                is a quotient of
                = succeed "." do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} NSymm
                      %annotation{:encoding => "application/x-tex"} \NSymm
                %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mi i
                    %annotation{:encoding => "application/x-tex"} Z_i
                to the
                = succeed "th" do
                  %math#mathml_11f14bc54cb344130115ab6946d35fae55409262_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
