          %h1#noncommutative_symmetric_functions Noncommutative symmetric functions
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
