          %h2#idea Idea
          %p
            The term
            %em class equation
            (or
            = succeed "," do
              %em class formula
            %em orbit decomposition
            formula) refers to a basic type of counting argument that comes about by decomposing a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
            as a
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+theory"} group theory
          %h2#statement Statement
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a
            %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
            (given by a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %msub
                    %mi hom
                    %mi Set
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to \hom_{Set}(A, A)
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi G
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \alpha: G \times A \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected
            in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+G-sets"} category of G-sets
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            and the action is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            of
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} G \to A
            sending
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ↦
                    %mi a
                  %annotation{:encoding => "application/x-tex"} 1 \mapsto a
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi A
                %annotation{:encoding => "application/x-tex"} G/Stab(a) \cong A
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(a)
            is the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer"} stabilizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G/Stab(a)
            is the
            = succeed "-set" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/cosets"} cosets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab(a)
          %p
            More generally, each
            = succeed "-set" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            admits a canonical decomposition as a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of its connected components; the components are usually called the
            %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
            of the action. Choosing a representative element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi x
                %annotation{:encoding => "application/x-tex"} a_x
            in each orbit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi orbits
                      %mi x
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} A \cong \sum_{orbits x} G/Stab(a_x).
          %p
            By taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to be
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            and counting elements, we get an equation of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi orbits
                      %mi x
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Stab
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %mo .
                %annotation{:encoding => "application/x-tex"} {|A|} = \sum_{orbits x} \frac{{|G|}}{{|Stab(a_x)|}}.
          %p
            This is sometimes called
            = succeed "," do
              %em Burnside’s lemma
            = succeed "," do
              %em Burnside’s counting theorem
            = succeed "," do
              %em Cauchy–Frobenius lemma
            = succeed "." do
              %em orbit-counting theorem
            = succeed "." do
              %em class equation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/number+theory"} number-theoretic
            arguments, one can derive many useful consequences; some sample applications are given below.
          %p Notice that reading the class equation equivalently as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi orbits
                      %mi x
                  %mfrac
                    %mn 1
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Stab
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi A
                      %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \sum_{orbits x} \frac{{1}}{{|Stab(a_x)|}} = \frac{|A|}{|G|}
          %p
            it expresses the
            %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
            of the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            acting on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#applications Applications
          %h3#centers_of_groups
            Centers of
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} group
            is a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            whose
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            is a power of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          #pgroup.num_prop
            %h6#proposition Proposition
            %p
              A non-trivial
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              has a nontrivial
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(G)
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              act on itself by the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ×
                      %mi G
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G \times G \to G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi g
                      %mi h
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (g, h) \mapsto g h g^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Orb
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Orb(h)
              is usually called the
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+class"} conjugacy class
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Orb
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Orb(h)
              is trivial (consists of exactly one element
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Orb
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|Orb(h)|} = \frac{{|G|}}{{|Stab(h)|}}
              divides
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msup
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} {|G|} = p^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Orb
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|Orb(h)|}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is noncentral. In this case the class equation takes the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi nontrivial
                        %mspace{:width => "thickmathspace"}
                        %mi orbits
                        %mi x
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|G|} = {|Z(G)|} \; + \sum_{nontrivial\; orbits x} \frac{{|G|}}{{|Stab(a_x)|}}
            %p
              and now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|G|}
              as well as each term in the sum over nontrivial orbits, it must also divide
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Z
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|Z(G)|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z(G)
              has more than one element.
          %p
            It follows by
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            that
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/solvable+group"} solvable
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            and the quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G/Z(G)
            is also a
            = succeed "-group." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+group"} nilpotent
          %h3#number_of_fixed_points Number of fixed points
          %p
            An elementary observation that is frequently useful is that the number of
            %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
            of an
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            on a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            has the same parity as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-sets;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(2)
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-set" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #pparity.num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi A
                        %mo{:stretchy => "false"} |
                      %mo ≡
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Fix
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mi p
                    %annotation{:encoding => "application/x-tex"} {|A|} \equiv {|Fix(A)|} \; mod p
                \.
            %p
              As special cases, if there is just one fixed point, then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi A
                        %mo{:stretchy => "false"} |
                      %mo ≡
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mi p
                    %annotation{:encoding => "application/x-tex"} {|A|} \equiv 1 \; mod p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi A
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|A|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Fix
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|Fix(A)|}
          .proof
            %h6#proof_2 Proof
            %p The class equation takes the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi A
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Fix
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi nontrivial
                        %mspace{:width => "thickmathspace"}
                        %mi orbits
                        %mi x
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|A|} = {|Fix(A)|} \; + \sum_{nontrivial\; orbits x} \frac{{|G|}}{{|Stab(a_x)|}}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides each summand over nontrivial orbits on the right, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              = succeed "-group." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %h3#wedderburns_theorem Wedderburn’s theorem
          %p
            In the theory of finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/projective+planes"} projective planes
          .num_theorem
            %h6#theorem Theorem
            %p
              A finite
              %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is commutative.
          .proof
            %h6#proof_3 Proof
            %p
              %strong (Witt)
              The center of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is of characteristic
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p \gt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %msup
                      %mi p
                      %mi f
                  %annotation{:encoding => "application/x-tex"} q = p^f
              elements for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as an
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} D^\times
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi q
                        %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q^n-1
            %p
              The conjugation action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} D^\times
              on itself yields a decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ×
                    %mo ≅
                    %msup
                      %mi F
                      %mo ×
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi nontrivial
                        %mspace{:width => "thickmathspace"}
                        %mi orbits
                        %mi x
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi D
                          %mo ×
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} D^\times \cong F^\times \; + \sum_{nontrivial\; orbits x} \frac{{|D^\times|}}{{|Stab(a_x)|}}
            %p
              where again the elements of the center
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo ×
                    %mo =
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^\times = Z(D^\times)
              correspond to the trivial orbits. The stabilizer of any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi x
                    %annotation{:encoding => "application/x-tex"} a_x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %a.existingWikiWord{:href => "/nlab/show/centralizer"} centralizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(a_x)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi x
                    %annotation{:encoding => "application/x-tex"} a_x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi x
                      %mo =
                      %msub
                        %mi dim
                        %mi F
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_x = dim_F(C(a_x))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(a_x)
              has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mrow
                        %msub
                          %mi d
                          %mi x
                  %annotation{:encoding => "application/x-tex"} q^{d_x}
              elements, and notice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi x
                  %annotation{:encoding => "application/x-tex"} d_x
              divides
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi d
                      %mi x
                  %annotation{:encoding => "application/x-tex"} n/d_x
              is just the dimension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              seen as a vector space (module) over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(a_x)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msup
                        %mi q
                        %mrow
                          %msub
                            %mi d
                            %mi x
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} {|Stab(a_x)|} = q^{d_x} - 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mi n
                    %mo −
                    %mn 1
                    %mo =
                    %mi q
                    %mo −
                    %mn 1
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi x
                    %mfrac
                      %mrow
                        %msup
                          %mi q
                          %mi n
                        %mo −
                        %mn 1
                      %mrow
                        %msup
                          %mi q
                          %mrow
                            %msub
                              %mi d
                              %mi x
                        %mo −
                        %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} q^n - 1 = q - 1 + \sum_x \frac{q^n - 1}{q^{d_x} - 1}.
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \zeta \in \mathbb{C}
              be any primitive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} root of unity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo −
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} z - \zeta
              divides each polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi z
                      %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} z^n-1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %msup
                            %mi z
                            %mi n
                          %mo −
                          %mn 1
                        %mrow
                          %msup
                            %mi z
                            %mrow
                              %msub
                                %mi d
                                %mi x
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \frac{z^n - 1}{z^{d_x} - 1}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi prim
                          %mo .
                          %mspace{:width => "thickmathspace"}
                          %mi ζ
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi ζ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \prod_{prim.\; \zeta} (z-\zeta)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi prim
                        %mo .
                        %mspace{:width => "thickmathspace"}
                        %mi ζ
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi ζ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{prim.\; \zeta} (q - \zeta)
              divides each of the integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q^n-1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %msup
                            %mi q
                            %mi n
                          %mo −
                          %mn 1
                        %mrow
                          %msup
                            %mi q
                            %mrow
                              %msub
                                %mi d
                                %mi x
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \frac{q^n - 1}{q^{d_x} - 1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q-1
              according to the class equation. But also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi q
                      %mo −
                      %mi ζ
                      %mo{:stretchy => "false"} |
                    %mo ≥
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi q
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|q - \zeta|} \geq {|q-1|}
              for any root of unity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ζ
                    %annotation{:encoding => "application/x-tex"} \zeta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi q
                      %mo −
                      %mi ζ
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi q
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|q - \zeta|} = {|q-1|}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F = Z(D)
              is all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as was to be shown.
          %h3#sylow_theorems Sylow theorems
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a finite group of order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a prime that divides
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %msup
                    %mi p
                    %mi f
                  %mi u
                %annotation{:encoding => "application/x-tex"} n = p^f u
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            does not divide
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
            %a.existingWikiWord{:href => "/nlab/show/Sylow+p-subgroup"} Sylow p-subgroup
            is a
            = succeed "-subgroup" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi f
                  %annotation{:encoding => "application/x-tex"} p^f
          %p
            A fundamental fact of group theory is that Sylow
            = succeed "-subgroups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-subgroups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≡
                    %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \equiv 1 \; mod p
          %p
            Existence of Sylow
            = succeed "-subgroups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed ":" do
              %a.maruku-ref{:href => "#pgroup"}
          #ppower.num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              has order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p^k
              is a prime power dividing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p^k
          .proof
            %h6#proof_4 Proof
            %p
              First we show that Sylow subgroups exist. We start by observing that if a group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              has a
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              act on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} H/P
              by left translation, then the stabilizer of any element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi P
                  %annotation{:encoding => "application/x-tex"} h P
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∩
                      %mi h
                      %mi P
                      %msup
                        %mi h
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} G \cap h P h^{-1}
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi P
                    %msup
                      %mi h
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} h P h^{-1}
              is. Then note that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} H/P
              has cardinality prime to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G/Stab(a_x)
              in its
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} /
                    %mi P
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi orbits
                        %mspace{:width => "thickmathspace"}
                        %mi x
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} H/P \cong \sum_{orbits\; x} G/Stab(a_x),
            %p
              and this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab(a_x)
              a
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Then, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo ↪
                      %mi Cayley
                    %mi Perm
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi S
                      %mi n
                    %mo ↪
                    %msub
                      %mi GL
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \stackrel{Cayley}{\hookrightarrow} Perm({|G|}) \cong S_n \hookrightarrow GL_n(\mathbb{Z}/(p)) = H
            %p
              where we embed the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S_n
              via
              %a.existingWikiWord{:href => "/nlab/show/permutation+matrices"} permutation matrices
              into the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              invertible matrices over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              has order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo −
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mi …
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo −
                      %msup
                        %mi p
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p^n - 1)(p^n - p)\ldots (p^n - p^{n-1})
              = succeed "-factor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} p^{n(n-1)/2}
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "'s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              exist for any finite group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Finally, note that by Proposition
              = succeed "," do
                %a.maruku-ref{:href => "#pgroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is solvable and therefore has a
              %a.existingWikiWord{:href => "/nlab/show/composition+series"} composition series
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mi P
                      %mn 0
                    %mo ⊂
                    %msub
                      %mi P
                      %mn 1
                    %mo ⊂
                    %mi …
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \{1\} = P_0 \subset P_1 \subset \ldots \subset P
            %p
              where each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi k
                  %annotation{:encoding => "application/x-tex"} P_k
              has order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p^k
          #SylowConj.num_theorem
            %h6#theorem_3 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a
              = succeed "-subgroup" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a Sylow
              = succeed "-subgroup," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi H
                    %mi g
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} g^{-1} H g \subseteq P
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
              = succeed "-subgroups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          .proof
            %h6#proof_5 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts on the set of cosets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} G/P
              as usual by left translation, and we may restrict the action to the
              = succeed "-subgroup" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi P
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|G/P|}
              is prime to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %a.maruku-ref{:href => "#pparity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi Fix
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|Fix_H(G/P)|}
              is also prime to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fix
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix_H(G/P)
              has at least one element, say
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi P
                    %annotation{:encoding => "application/x-tex"} g P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi g
                    %mi P
                    %mo =
                    %mi g
                    %mi P
                  %annotation{:encoding => "application/x-tex"} h g P = g P
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %mi H
                    %annotation{:encoding => "application/x-tex"} h \in H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi h
                    %mi g
                    %mi P
                    %mo =
                    %mi P
                  %annotation{:encoding => "application/x-tex"} g^{-1} h g P = P
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %mi H
                    %annotation{:encoding => "application/x-tex"} h \in H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mi H
                      %mi g
                      %mo ⊆
                      %mi P
                    %annotation{:encoding => "application/x-tex"} g^{-1} H g \subseteq P
          #numberSylow.num_theorem
            %h6#theorem_4 Theorem
            %p
              The number of Sylow
              = succeed "-subgroups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≡
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \equiv 1 \; mod p
          .proof
            %h6#proof_6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be the set of Sylow
              = succeed "-subgroups;" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              by conjugation. As all Sylow
              = succeed "-subgroups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} P \in Y
              is just the
              %a.existingWikiWord{:href => "/nlab/show/normalizer"} normalizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_G(P)
              (by definition of normalizer). Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ≅
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi N
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \cong G/N_G(P)
              as
              = succeed "-sets." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Restrict the action to the subgroup
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} P \in Y
              is a fixed point of this restricted action, and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is any other fixed point, it means
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi Q
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} x Q x^{-1} = Q
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi P
                    %annotation{:encoding => "application/x-tex"} x \in P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ⊆
                      %msub
                        %mi N
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P \subseteq N_G(Q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P, Q
              are both Sylow
              = succeed "-subgroups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_G(Q)
              and are therefore conjugate to each other (as seen within the group
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N_G(Q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is already fixed by the conjugation action in its stabilizer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N_G(Q)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} P = Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fix
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix_P(Y)
              has exactly one element. From
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Y
                      %mo{:stretchy => "false"} |
                    %mo ≡
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi Fix
                        %mi P
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mi p
                  %annotation{:encoding => "application/x-tex"} {|Y|} \equiv {|Fix_P(Y)|} \; mod p
              (Proposition
              = succeed ")," do
                %a.maruku-ref{:href => "#pparity"}
          #numbertwoSylow.num_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a group of order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %msup
                      %mi p
                      %mi k
                    %mi m
                  %annotation{:encoding => "application/x-tex"} n = p^k m
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is prime to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi p
                  %annotation{:encoding => "application/x-tex"} n_p
              of
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
          .proof
            %h6#proof_7 Proof
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts transitively on
              = succeed "-Sylow" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a.maruku-ref{:href => "#SylowConj"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi p
                  %annotation{:encoding => "application/x-tex"} n_p
              divides
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msup
                        %mi p
                        %mi k
                      %mi m
                    %annotation{:encoding => "application/x-tex"} {|G|} = p^k m
              = succeed "," do
                %a.maruku-ref{:href => "#numberSylow"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mi n
                      %mi p
                    %mo +
                    %mi b
                    %msup
                      %mi p
                      %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a n_p + b p^k = 1
              for some integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a, b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi p
                  %annotation{:encoding => "application/x-tex"} n_p
              divides both terms of the left side of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msub
                        %mi n
                        %mi p
                      %mi m
                      %mo +
                      %mi b
                      %msup
                        %mi p
                        %mi k
                      %mi m
                      %mo =
                      %mi m
                    %annotation{:encoding => "application/x-tex"} a n_p m + b p^k m = m
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
          %p
            The Sylow theorems are routinely used throughout group theory. As a sample application: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                %annotation{:encoding => "application/x-tex"} p, q
            are distinct primes, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mn 2
                  %mo ≢
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                  %mi q
                %annotation{:encoding => "application/x-tex"} p^2 \nequiv 1\; \mod q
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≢
                    %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi p
                  %annotation{:encoding => "application/x-tex"} q \nequiv 1\; \mod p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mn 2
                  %mi q
                %annotation{:encoding => "application/x-tex"} p^2 q
            is abelian. (For example, a group of order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2023
                  %mo =
                  %mn 7
                  %mo ⋅
                  %msup
                    %mn 17
                    %mn 2
                %annotation{:encoding => "application/x-tex"} 2023 = 7 \cdot 17^2
            must be commutative.)
          .proof
            %h6#proof_8 Proof
            %p
              We have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi p
                    %mo{:stretchy => "false"} |
                    %mi q
                  %annotation{:encoding => "application/x-tex"} n_p|q
              by Corollary
              = succeed "," do
                %a.maruku-ref{:href => "#numbertwoSylow"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi p
                    %mo ≠
                    %mi q
                  %annotation{:encoding => "application/x-tex"} n_p \neq q
              (using Theorem
              %a.maruku-ref{:href => "#numberSylow"}
              and
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ≢
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                      %mi p
                    %annotation{:encoding => "application/x-tex"} q \nequiv 1\; \mod p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mi p
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n_p = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
