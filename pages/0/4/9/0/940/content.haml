                    %mo ⊗
                    %mi A
                  %mi C
                  %mover
                    %mo →
                    %mrow
                      %mi ρ
                      %mo ⊗
                      %mi C
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                %annotation{:encoding => "application/x-tex"} M\stackrel{\rho}\to M\otimes_A C \stackrel{\rho\otimes C}\to (M\otimes_A C)\otimes_A C
            after rebracketing becomes identical to the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mover
                    %mo →
                    %mi ρ
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                  %mover
                    %mo →
                    %mrow
