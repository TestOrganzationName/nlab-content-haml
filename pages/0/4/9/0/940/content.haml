                      %mo ⊗
                      %msub
                        %mi Δ
                        %mi C
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M\stackrel{\rho}\to M\otimes_A C \stackrel{M\otimes \Delta_C}\to M\otimes_A (C \otimes_A C)
            and the counitality axiom holds.
          %p
            A morphism of left
            = succeed "-comodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi ρ
                    %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %msup
                    %mi ρ
                    %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(M,\rho^M)\to(N,\rho^N)
            is a morphism of underlying
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi M
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} f:M\to N
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %msub
                      %mo ⊗
                      %mi A
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi ρ
                      %mi M
                    %mo =
                    %msup
                      %mi ρ
                      %mi N
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} (M\otimes_A f)\circ\rho^M = \rho^N\circ f
            = succeed "-comodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi M
                  %mo ↦
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                %annotation{:encoding => "application/x-tex"} F: M\mapsto M\otimes_A C
            is canonically a comonad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi A
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} {}_A Mod
            with comultiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi F
                  %mo =
                  %mi Id
                  %msub
                    %mo ⊗
                    %mi A
                  %msub
                    %mi Δ
                    %mi C
                  %mo :
                  %mi F
                  %mo →
                  %mi F
                  %mi F
                %annotation{:encoding => "application/x-tex"} \Delta^F = Id\otimes_A\Delta_C : F\to F F
            and the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            of the comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is isomorphic to the category of
            = succeed "-comodules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Analogously, one considers right
            = succeed "-comodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-comodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-coactions." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#examples Examples
          %h3#canonical_sweedler_coring Canonical (Sweedler) coring
          %p
            The classical example of a coring is the canonical or
            %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
            corresponding to an extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ↪
                  %mi S
                %annotation{:encoding => "application/x-tex"} R\hookrightarrow S
            of unital rings. The category of
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            data for this ring extension is equivalent to the category of
            %a.existingWikiWord{:href => "/nlab/show/comodule"} comodules
            over the canonical coring.
          %p
            Corings are in general useful for the treatment of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/descent+in+noncommutative+algebraic+geometry"} descent in noncommutative algebraic geometry
          %h3#coring_of_a_projective_module Coring of a projective module
          %p
            Suppose we are given ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ,
                  %mi S
                %annotation{:encoding => "application/x-tex"} R,S
            and an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-bimodule," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %msub
                      %mrow
                      %mi S
                    %msub
                      %mi M
                      %mi R
                  %annotation{:encoding => "application/x-tex"} M = {}_S M_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mo *
                  %mo =
                  %msub
                    %mi Hom
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M^* = Hom_R(M,R)
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-bimodule." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be given as a direct summand of a free module
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %msub
                      %mo ⊕
                      %mi i
                    %msub
                      %mi R
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F = \oplus_i R_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mi M
                  %mo ⊕
                  %mi L
                %annotation{:encoding => "application/x-tex"} F = M\oplus L
            induces projection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi F
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} p:F\to M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi r
                      %mi i
                    %mo ↦
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi r
                      %mi i
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sum_i r_i\mapsto \sum_i r_i x_i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi M
                    %mo ↪
                    %mi F
                  %annotation{:encoding => "application/x-tex"} s: M\hookrightarrow F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msubsup
                      %mi x
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mo ⊕
                      %mi i
                    %msub
                      %mi R
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s(m) = \sum_i x_i^*(m)\in\oplus_i R_i
            %a.existingWikiWord{:href => "/nlab/show/dual+basis"} dual basis
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x_1,\ldots,x_n\in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi x
                    %mn 1
                    %mo *
                  %mo ,
                  %mi …
                  %mo ,
                  %msubsup
                    %mi x
                    %mi n
                    %mo *
                  %mo ∈
                  %msub
                    %mi Hom
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x_1^*,\ldots,x_n^*\in Hom_R(M,R)
            characterized by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msubsup
                    %mi x
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} m = \sum_i x_i^*(m) x_i
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m\in M
            = succeed "-coring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            as
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mo *
                  %msub
                    %mo ⊗
                    %mi S
                  %mi M
                %annotation{:encoding => "application/x-tex"} M^*\otimes_S M
            with comultiplication
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %msup
                    %mi M
                    %mo *
                  %msub
                    %mo ⊗
                    %mi S
                  %mi M
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi M
                    %mo *
                  %msub
                    %mo ⊗
                    %mi S
                  %mi M
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi R
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi M
                    %mo *
                  %msub
                    %mo ⊗
                    %mi S
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta : M^*\otimes_S M\to (M^*\otimes_S M)\otimes_R(M^*\otimes_S M)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⊗
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %mi f
                  %mo ⊗
                  %msubsup
                    %mi x
                    %mi i
                    %mo *
                  %mo ⊗
                  %msub
                    %mi x
                    %mi i
                  %mo ⊗
                  %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\Delta(f\otimes m) = \sum_{i=1}^n f\otimes x_i^*\otimes x_i\otimes m
          %p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %msup
                      %mi M
                      %mo *
                    %msub
                      %mo ⊗
                      %mi S
                    %mi M
                    %mo ,
                    %mi f
                    %mo ⊗
                    %mi m
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \epsilon:M^*\otimes_S M, f\otimes m\mapsto f(m)\in R
          %h3#matrix_coring Matrix coring
          %p
            Another major class of examples are the so-called
            = succeed "." do
              %span.newWikiWord
                matrix corings
                %a{:href => "/nlab/new/matrix+coring"} ?
          %h2#references References
          %p
            The notion of an
            = succeed "-coring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"} T. Brzeziński
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/G.+B%C3%B6hm"} G. Böhm
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocategory"} cocategories
          %p There is already a monograph:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
              , R. Wisbauer,
              = succeed "," do
                %em Corings and comodules
              = succeed "," do
                %strong 309
          %p Special topics:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                ,
                = succeed "," do
                  %em Descent cohomology and corings
                %a{:href => "http://arxiv.org/abs/math.RA/0601491"} arxiv:math.RA/0601491
            %li
              %p
                L. El Kaoutit, J. Gomez-Torrecillas,
                = succeed "," do
                  %em On the set of grouplikes of a coring
                %a{:href => "http://arxiv.org/abs/0901.4291"} arxiv/0901.4291
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                ,
                = succeed "," do
                  %em Flat connections and (co)modules
                %a{:href => "http://arxiv.org/abs/math.QA/0608170"} arxiv:math.QA/0608170
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                ,
                = succeed "," do
                  %em The structure of corings. Induction functors, Maschke-type theorem, and Frobenius and Galois-type properties
                %strong 5
                (2002) 389-410,
                %a{:href => "http://arxiv.org/abs/math.QA/0002105"} math.QA/0002105
            %li
              %p
                Lars Kadison,
                = succeed "," do
                  %em Depth two and Galois coring
                %a{:href => "http://arxiv.org/abs/math.RA/0408155"} math.RA/0408155
            %li#BergmanHausknecht96
              %p
                %a.existingWikiWord{:href => "/nlab/show/George+M.+Bergman"}> George M. Bergman
                , Adam O. Hausknecht,
                = succeed "," do
                  %em Cogroups and co-rings in categories of associative rings
                %strong 45
                (1996) &amp;lbrack;ISBN 0-8218-0495-2,
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/surv-45"} ams:surv-45
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=97k:16001"} MR 97k:16001
                = succeed "&rbrack;" do
                  %a{:href => "http://math.berkeley.edu/~gbergman/papers/updates/coalg.html"} errata and updates
              %blockquote
                %p
                  (discussion
                  %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
                  the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                , L. Kadison,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/R.+Wisbauer"} R. Wisbauer
                = succeed "," do
                  %em On coseparable and biseparable corings
            %li
              %p
                T. Brzeziński, L. El Kaoutit, J. Gómez-Torrecillas,
                = succeed "," do
                  %em The bicategories of corings
                = succeed ":3" do
                  %strong 205
                %a{:href => "https://doi.org/10.1016/j.jpaa.2005.07.013"} doi:10.1016/j.jpaa.2005.07.013
                %a{:href => "https://arxiv.org/abs/math/0408042"} math.RA/0408042
          %p There is a generalization of corings:
          %ul
            %li
              Jawad Y. Abuhlail,
              = succeed "," do
                %em Semicorings and semicomodules
              %a{:href => "http://arxiv.org/abs/1303.3924"} arxiv/1303.3924
          .property
