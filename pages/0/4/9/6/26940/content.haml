          .proof
            %h6 Proof
            %p
              There is a ring homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi H
                    %mo ↪
                    %msub
                      %mi ℝ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_H \hookrightarrow \mathbb{R}_\Sigma
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_\Sigma
              is Cauchy complete and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_H
              is initial in the category of Cauchy complete Archimedean ordered fields, and there is a ring homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                    %mo ↪
                    %msub
                      %mi ℝ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C \hookrightarrow \mathbb{R}_H
              because the rational numbers are a subset of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mi H
