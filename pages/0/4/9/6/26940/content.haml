          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be any Archimedean ordered field extension of the Cauchy real numbers. The analytic LPO also makes sense for any
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+local+ring"} Archimedean ordered
            %a.existingWikiWord{:href => "/nlab/show/local+Artinian+algebra"}
              local Artinian
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
