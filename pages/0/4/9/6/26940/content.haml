                    %msub
                      %mi{:mathvariant => "normal"} R
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathrm{R}_\Sigma
              are isomorphic fields, which implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_H
              is isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
