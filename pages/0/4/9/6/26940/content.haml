                    %annotation{:encoding => "application/x-tex"} \mathrm{R}_\Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} R
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathrm{R}_C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
