            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/decidable+relation"} decidable relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            by its
            %a.existingWikiWord{:href => "/nlab/show/nilradical"} nilradical
            is the field of real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            satisfying the analytic LPO.
          %h2#properties Properties
          %p
          .num_theorem
            %h6 Theorem
            %p
              The analytic LPO for the (sequential, modulated)
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
              implies the LPO for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a function from the
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              on the rationals as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo =
                        %mn 0
                      %mi k
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mn 2
                          %mi x
                  %annotation{:encoding => "application/x-tex"} u(n) = \sum_{x = 0}^k \frac{f(n)}{2^x}
            %p
              This sequence is a
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              with a modulus of continuity, so taking the limit of this Cauchy sequence yields a Cauchy real number
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi u
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [u]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi u
                    %mo{:stretchy => "false"} ]
                    %mo #
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [u] \# 0
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi u
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [u] = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi u
                    %mo{:stretchy => "false"} ]
                    %mo &gt;
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mn 2
                          %mi k
                  %annotation{:encoding => "application/x-tex"} [u] \gt \frac{1}{2^k}
              for some natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              so there exists an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f(n) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(n) = 0
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that there is an Archimedean ordered field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              which is a
              %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is isomorphic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
          %p
          .proof
            %h6 Proof
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
              is a subfield of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
              %a.existingWikiWord{:href => "/nlab/show/coercion"} coercion
              one can consider the elements of any Archimedean ordered field to be Dedekind real numbers, which are Dedekind cuts. Theorem 10.6.3 of
              %a{:href => "#Booij20"} Booij 2020
              says that any Dedekind real number (i.e. Dedekind cut) for which there exists a
              %a.existingWikiWord{:href => "/nlab/show/locator"} locator
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+number"} Cauchy real number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              there exists a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locator"} locator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a Cauchy real number, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/subfield"} subfield
              of the Cauchy real numbers. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is also a field extension of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
              to the Cauchy real numbers, since the
              %a.existingWikiWord{:href => "/nlab/show/Cantor-Schroeder-Bernstein+theorem"} Cantor-Schroeder-Bernstein theorem
              holds for
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+fields"} Archimedean ordered fields
              and
              %a.existingWikiWord{:href => "/nlab/show/ring+homomorphisms"} ring homomorphisms
              in the category of Archimedean ordered fields.
            %p
              The analytic LPO implies that corollary 11.4.3 of
              %a{:href => "#UFP13"} UFP 2013
              can be proven: If analytic LPO holds then “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \lt y) \to (x \lt z) + (z \lt y)
              can be proved: either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \lt z
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo &lt;
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(x \lt z)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} z \lt y
              because
              = succeed ".\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ≤
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} z \leq x \lt y
              %a.existingWikiWord{:href => "/nlab/show/locator"} locator
              for every element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is isomorphic to the Cauchy real numbers.
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that there are two Archimedean ordered fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              such that both are
              %a.existingWikiWord{:href => "/nlab/show/field+extensions"} field extensions
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              is a
              %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              implies the analytic LPO for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
          .proof
            %h6 Proof
            %p
              Analytic LPO for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
