            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is the evident inclusion, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              is restriction to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %p
              (By
              %a{:href => "MUFr#AShortExactSequenceOfUFrBordismRings"} this Prop.
              at
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/MUFr"} MUFr
