                      %mi i
                    %msubsup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                      %mrow
                        %mi U
                        %mo ,
                        %mi fr
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi fr
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\Omega^U_{\bullet+1}
                    \\overset{i}{\longrightarrow}
                    \\Omega^{U,fr}_{\bullet+1}
                    \\overset{\partial}{
                    \\longrightarrow
