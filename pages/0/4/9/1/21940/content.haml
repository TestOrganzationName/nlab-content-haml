              and the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group+of+spheres"} stable homotopy group of spheres
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
