              %a.maruku-eqref{:href => "#eq:ShortExactSequenceOfUFrBordismRings"} (2)
              that assigning to
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi fr
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U,fr)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+isomorphism"} Pontrjagin-Thom isomorphism
              between the
