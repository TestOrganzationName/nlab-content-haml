          %p
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66, p. 97
            )
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/bordism+rings"} bordism rings
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/MUFr"} MUFr
              and
              %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
              sit in a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            #eq:ShortExactSequenceOfUFrBordismRings.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mo •
