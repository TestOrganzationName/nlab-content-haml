                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(E)
              for the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              regarded in the opposite category.)
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ho(Spectra)
              any spectrum, then there is the corresponding augmented cosimiplicial spectrum
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo ∧
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E^\bullet \wedge X
          #ENilpotentCompletionIsHolimOverTotTower.num_prop
            %h6#proposition Proposition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring+spectrum"} E-infinity ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and any spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-nilpotent" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mi E
                      %mo ∧
                  %annotation{:encoding => "application/x-tex"} X^\wedge_E
              (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ENilpotentCompletion"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi X
                              %mi E
                              %mo ∧
                          %mtd
                            %mo ≃
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mo •
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %munder
                                %mi holim
                                %mo ←
                              %mrow
                                %mi n
                                %mo ∈
                                %mi Δ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mi n
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi holim
                                %mo ←
                              %mrow
                                %mi n
                                %mo ∈
                                %mi ℕ
                            %msup
                              %mi Tot
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mo •
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    X^\wedge_E
                    \&amp;\simeq
                    Tot(E^\bullet \wedge X)
                    \\\
                    \&amp; =
                    \\underset{\leftarrow}{holim}_{n \in \Delta} (E^n\wedge X)
                    \\\
                    \&amp; \simeq
                    \\underset{\leftarrow}{holim}_{n \in \mathbb{N}}Tot^n(E^\bullet \wedge X)
                    \\end{aligned}
            %p
              over the tower of homotopy-
              %a.existingWikiWord{:href => "/nlab/show/totalizations"} totalizations
              of the skeleta of the
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} E^\bullet \otimes Y
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#RingSpectrumGivesCosimplicialSpectrum"}
          %p
            This claim originates in (
            %a{:href => "#Hopkins99"}> Hopkins 99, remark 5.5 (ii)
            ). It is taken for granted in (
            %a{:href => "#Lurie10"}> Lurie 10, lecture 8, lecture 30
            ). The first published proof is (
            %a{:href => "#MathewNaumannNoel15"}> Mathew-Naumann-Noel 15, prop. 2.14
            ). See also (
            %a{:href => "#Carlsson07"}> Carlsson 07, e.g. remark 3.1
            ).
          .num_remark
            %h6#remark Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#ENilpotentCompletionIsHolimOverTotTower"}
              implies that the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
              may equivalently be regarded as computing
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              of
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+infinity-stacks"} quasicoherent infinity-stacks
              in
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+geometry"} E-infinity geometry
              along the canonical morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                  %annotation{:encoding => "application/x-tex"} Spec(E)\longrightarrow
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Spec%28S%29"} Spec(S)
              = succeed "." do
                %em
                  %a{:href => "https://ncatlab.org/nlab/show/Adams%20spectral%20sequence#DefinitionInHigherAlgebra"} Adams spectral sequence – As derived descent
          %h2#properties Properties
          %h3#RelationToELocalization
            Relation to
            = succeed "-localization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          #CanonicalMapFromELocalizationToTotalization.num_remark
            %h6#remark_2 Remark
            %p There is a canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L_E X
                    \\overset{}{\longrightarrow}
                    \\underset{\leftarrow}{\lim}_n (E^{\wedge^{n+1}_S}\wedge_S X)
            %p
              from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} Bousfield localization of spectra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
          %p
            We consider now conditions for this morphism to be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          #CoreOfARing.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %em core
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi R
                  %annotation{:encoding => "application/x-tex"} c R
              is the
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi R
                    %mo ⟶
                    %mi R
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi R
                    %mo ⊗
                    %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c R
                    \\longrightarrow
                    R
                    \\stackrel{\longrightarrow}{\longrightarrow}
                    R \otimes R
                    \\,.
          #SufficientConditionsForTotalizationToBeELocalization.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              such that the core of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0(E)
              = succeed "," do
                %a.maruku-ref{:href => "#CoreOfARing"}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                  at a set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/primes"} primes
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi J
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} c \pi_0(E) \simeq \mathbb{Z}[J^{-1}]
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n \geq 2
            %p
              Then the map in remark
              %a.maruku-ref{:href => "#CanonicalMapFromELocalizationToTotalization"}
              is an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_E X \stackrel{\simeq}{\longrightarrow}
                    \\underset{\leftarrow}{\lim}_n (E^{\wedge^{n+1}_S}\wedge_S X)
                    \\,.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79
            ).
          %h2#examples Examples
          %p
            The nilpotent completion of a
            %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
            at the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
