                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            argument).
          .num_example
            %h6#examples_2 Examples
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
              = succeed "-nilpotent" do
