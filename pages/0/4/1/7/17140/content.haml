              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is, for any choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_\bullet \to X
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
