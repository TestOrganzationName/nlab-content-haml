            %p
              The
              = succeed "-nilpotent" do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              The
              = succeed "-nilpotent" do
                %a.existingWikiWord{:href => "/nlab/show/BP"} BP
