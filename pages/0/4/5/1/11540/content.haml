                  %annotation{:encoding => "application/x-tex"} D
              some category. The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/restriction+of+scalars"} restriction of scalars
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ′
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^* \,\colon\, PSh(C', D) \to PSh(C, D)
              is given by the formula
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ↦
                      %mi H
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} H \mapsto H \circ f
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi C
                    %msup
                      %mo ′
                      %mi op
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} H \,\colon\, C'^{op} \to D
              to the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mover
                      %mo →
                      %mi F
                    %mi C
                    %msup
                      %mo ′
                      %mi op
                    %mover
                      %mo →
                      %mi H
                    %mi D
                    %mo .
                  %annotation{:encoding => "application/x-tex"} C^{op} \stackrel{F}{\to} C'^{op} \stackrel{H}{\to} D.
          .num_prop
            %h6#proposition Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              admits small
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (resp. small
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^\ast
              admits a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo !
                  %annotation{:encoding => "application/x-tex"} F_!
              (resp.
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_\ast
          %h2#properties Properties
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi C
                    %mo ⇄
                    %mi C
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \,\colon\, C \rightleftarrows C' \,\colon\, G
              be an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              and consider the induced functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo !
                    %mo ,
                    %msup
                      %mi F
                      %mo *
                    %mo ,
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F_!, F^\ast, F_\ast)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mo !
                      %mo ,
                      %msup
                        %mi G
                        %mo *
                      %mo ,
                      %msub
                        %mi G
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G_!, G^*, G_*)
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo !
                    %annotation{:encoding => "application/x-tex"} F_!
                is left adjoint to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mo !
                      %annotation{:encoding => "application/x-tex"} G_!
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F^*
                is left adjoint to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi G
                          %mo *
                      %annotation{:encoding => "application/x-tex"} G^*
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_*
                is left adjoint to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mo *
                      %annotation{:encoding => "application/x-tex"} G_*
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo ≅
                      %msup
                        %mi G
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_* \cong G^*
                ,
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo *
                      %mo ≅
                      %msub
                        %mi G
                        %mo !
                    %annotation{:encoding => "application/x-tex"} F^* \cong G_!
                \.
          %p Note that all these claims are in fact equivalent.
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is fully faithful, then so are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo !
                  %annotation{:encoding => "application/x-tex"} F_!
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_*
          .proof
            %h6#proof Proof
            %p
              A left adjoint functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \dashv R
              is fully faithful precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi L
                  %annotation{:encoding => "application/x-tex"} R L
              is naturally isomorphic to the identity functor (by the unit). Dually,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is fully faithful precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L R
              is naturally isomorphic to the identity (by the co-unit). Hence, it suffices to prove
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo *
                      %msub
                        %mi F
                        %mo !
                      %mo ≅
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} F^* F_! \cong Id
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %msub
                      %mi F
                      %mo *
                    %mo ≅
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} F^* F_* \cong Id
              and thus proves both claims.
            %p
              Being a left adjoint,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %msub
                      %mi F
                      %mo !
                  %annotation{:encoding => "application/x-tex"} F^* F_!
              preserves colimits. Because every presheaf is a colimit of representable objects, it is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %msub
                      %mi F
                      %mo !
                    %mi y
                    %mo ≅
                    %mi y
                  %annotation{:encoding => "application/x-tex"} F^* F_! y \cong y
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              is the Yoneda-embedding. We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mo *
                    %msub
                      %mi F
                      %mo !
                    %mi y
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mi J
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mo *
                    %mi y
                    %mi F
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mi J
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mi F
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mi J
                    %mo ,
                    %mi F
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mi J
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F^* F_! y I) J \cong (F^* y F I) J = (y F I) (F J) = Hom(F J, F I) \cong Hom(J, I) = (y I) J.
          %h2#see_also See also
          %p
            For functoriality of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/restriction+and+extension+of+sheaves"} restriction and extension of sheaves
            %li
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            %li
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
          %p
            The pseudofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                %annotation{:encoding => "application/x-tex"} PSh
            (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo !
                %annotation{:encoding => "application/x-tex"} -_!
            as its action on morphisms) takes a category to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monad"} lax-idempotent 2-monad
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/total+category"} total
            = succeed "?)" do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete"} cocomplete
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-adjunction"} lax-idempotent 2-adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                %annotation{:encoding => "application/x-tex"} PSh
            is given by
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
            and the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+2-category"} Kleisli 2-category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                %annotation{:encoding => "application/x-tex"} PSh
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
