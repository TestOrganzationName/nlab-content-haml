          %h2#idea Idea
          %h3#functoriality_wrt_functors Functoriality w.r.t. functors
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(C, D)
            valued in some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            possesses small
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of small categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F \colon C \to C'
            induces two
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint pairs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo ⇄
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_! \,\colon\, PSh(C, D) \rightleftarrows PSh(C', D) \,\colon\, F^\ast
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo ⇄
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^* \,\colon\, PSh(C', D) \rightleftarrows PSh(C, D) \,\colon\, F_\ast
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^\ast
            is given by precomposition with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo !
                %annotation{:encoding => "application/x-tex"} F_!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_\ast
            are the left and right (global)
            %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
            along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %h3#functoriality_wrt_profunctors Functoriality w.r.t. profunctors
          %p
            In fact, more generally, any
            %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mo :
                  %mi C
                  %mo ↛
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{P} : C \nrightarrow C'
            (i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mo :
                  %mi C
                  %mo ×
                  %msup
                    %mrow
                      %mi C
                      %mo ′
                    %mi op
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \mathcal{P} : C \times {C'}^{op} \to D
            or, after
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi C
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ′
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P : C \to PSh(C', D)
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjoint pair
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mo ⊙
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo ⇄
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi P
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"} P_\odot \,\colon\, PSh(C, D) \rightleftarrows PSh(C', D) \,\colon\, P^\odot
          %p
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"} P_\odot
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"} P^\odot
            are not standard notations) where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"} P_\odot
            is the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            A functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi C
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F \,\colon\, C \to C'
            gives rise to two profunctors:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/companion"} companion
                profunctor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ^
                        %mo :
                        %mi C
                        %mo ↛
                        %mi C
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \hat F : C \nrightarrow C'
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi C
                      %mo ×
                      %msup
                        %mrow
                          %mi C
                          %mo ′
                        %mi op
                      %mo →
                      %mi D
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msub
                        %mi Hom
                        %mrow
                          %mi C
                          %mo ′
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo ,
                      %mi Fc
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \hat F \,\colon\, C \times {C'}^{op} \to D : (c, c') \mapsto Hom_{C'}(c', Fc).
              %p
                After currying, this amounts to the functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∘
                        %mi F
                        %mo :
                        %mi C
                        %mo →
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \circ F : C \to PSh(C')
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/conjoint"} conjoint
                profunctor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ˇ
                        %mo :
                        %mi C
                        %mo ′
                        %mo ↛
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \check F : C' \nrightarrow C
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˇ
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi C
                      %mo ′
                      %mo ×
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi D
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msub
                        %mi Hom
                        %mrow
                          %mi C
                          %mo ′
                      %mo{:stretchy => "false"} (
                      %mi Fc
                      %mo ,
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \check F \,\colon\, C' \times {C}^{op} \to D \,\colon\, (c', c) \mapsto Hom_{C'}(Fc, c').
              %p
                After currying, this amounts to the functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo *
                        %mo ∘
                        %mi y
                        %mo :
                        %mi C
                        %mo ′
                        %mo →
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^* \circ y : C' \to PSh(C)
          %p
            The former profunctor produces the adjoint pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
