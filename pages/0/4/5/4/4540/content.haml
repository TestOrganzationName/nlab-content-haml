              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The notion of
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-Lie algebra cohomology
            generalizes the notion of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            from
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            over duals of algebras over an abelian
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
            a
            %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mover
                    %mo ↪
                    %mo ←
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L} \stackrel{\leftarrow}{\hookrightarrow}
                  \\mathbf{H}
          %p
            obtained as the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            at morphisms that induces
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            with coefficients in the canonical
            %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            are modeled by duals of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial algebra
          %p
            We may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            as the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            the theory of commutative
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
            identified cosimplicial algebras with
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is a
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            and
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-Lie algebra cohomology
            is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} intrinsic cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            restricted to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
          %p
            Typically
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            is
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} model structure on cosimplicial/cochain algebras
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a{:href => "#ExplicitDefinition"} Explicit definition
              \.
          %p A discussion of details of how exactly this models the general abstract definition is in
          %ul
            %li
              %a{:href => "#Topos"}> (∞,1)-Topos theoretic interpretation
              \.
          %h3#ExplicitDefinition Explicit definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with coefficients in the trivial module is a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mu : \mathfrak{g} \to b^{n-1}\mathbb{R}
          %p
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie n-algebra
          %p
            Dually this is a
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi μ
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{g}) \leftarrow CE(b^{n-1}\mathbb{R}) : \mu
          %p
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(b^{n-1} \mathbb{R})
            is the
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
            on a single generator in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with vanishing differential. So this is equivalently an element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ∈
                  %msup
                    %mo ∧
                    %mi n
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\mu \in \wedge^n \mathfrak{g}^*
          %p
            which is closed in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary Lie algebra, this latter description reproduces the traditional definition of cocycles in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          %p For the moment see
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          %p for more.
          %h3#Topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-topos theoretic interpretation
          %p
            We may understand the above definitions of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} intrinsic cohomology
            of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            by embedding
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoids"} ∞-Lie groupoids
          %p
            For a general recognition principle of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            in the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-infinity+algebras"} model structure for L-infinity algebras
            see also (
            %a{:href => "#FiorenzaRogersSchreiber13"}> Fiorenza-Rogers-Schreiber 13, theorem 3.1.13
            ).
          %p
            Recall from
            %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
            that
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroids"} ∞-Lie algebroids
            form the
            %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mover
                    %mo ↪
                    %mo ←
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}
                  \\stackrel{\leftarrow}{\hookrightarrow}
                  \\mathbf{H}
          %p
            of a corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of structure
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            As described at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
            be the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimally
            thickened
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi ThCartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh(ThCartSp)
            we may take to be the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"} synthetic differential ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Alg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mover
                    %mo ↪
                    %mo ←
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi ThCartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                %annotation{:encoding => "application/x-tex"}
                  (C^\infty Alg^{\Delta})^{op} \stackrel{\leftarrow}{\hookrightarrow}
                  [ThCartSp^{op}, sSet]_{proj,loc}
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} model structure on cosimplicial smooth algebras
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi LieAlg
                  %mi stackrel
                  %mo ←
                  %mo ↪
                  %mn ∞
                  %mi SDGrpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\infty LieAlg stackrel{\leftarrow}{\hookrightarrow}
                  \\infty SDGrpd
                  \\,.
          %p
            Details on this are at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} model structure on cosimplicial smooth algebras
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+rings"} model structure on cosimplicial rings
            %a.existingWikiWord{:href => "/nlab/show/Bertrand+Toen"} Bertrand Toen
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi CAlg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mover
                    %mo ↪
                    %mo ←
                  %mo{:stretchy => "false"} [
                  %mi CAlg
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi cov
                %annotation{:encoding => "application/x-tex"}
                  (CAlg^\Delta)^{op} \stackrel{\leftarrow}{\hookrightarrow}
                  [CAlg,sSet]_{proj,cov}
          %p
            that is referenced and reviewed in some detail at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory+in+an+%28%E2%88%9E%2C1%29-topos"} rational homotopy theory in an (∞,1)-topos
          %p
            Notice that the embedding map is just degreewise the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
          %p
            Notice moreover that by the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
            (see there for details) we have that the dual Dold-Kan functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo :
                  %msubsup
                    %mi Ch
                    %mo +
                    %mo •
                  %mo →
                  %msup
                    %mi Ab
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} \Xi : Ch^\bullet_+ \to Ab^\Delta
            extends to the right adjoint part in a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the opposite of the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
            and the opposite
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+rings"} model structure on cosimplicial algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ξ
                    %mi op
                  %mo :
                  %msup
                    %mi dgAlg
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ≃
                        %mi Quillen
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi CAlg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Xi^{op} : dgAlg^{op} \stackrel{\simeq_{Quillen}}{\to}
                  (CAlg^\Delta)^{op}
                  \\,.
          %p In total this gives a right Quillen functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %msup
                    %mi dgAlg
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi Ξ
                        %mi op
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi CAlg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi CAlg
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi cov
                %annotation{:encoding => "application/x-tex"}
                  R :
                  dgAlg^{op} \stackrel{\Xi^{op}}{\to} (CAlg^\Delta)^{op}
                  \\to
                  [CAlg, sSet]_{proj,cov}
          %p
            that models the embedding of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} CAlg^{op}
            and
            %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
            plays no role. In fact for that case we could just as well restrict to a site of only
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal space
          %p
            Therefor for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}
            is just a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo :
                  %mi 𝔤
                  %mo →
                  %mi 𝔥
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mn ∞
                  %mi LieAlg
                  %mo ⊂
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"}
                  (c : \mathfrak{g} \to \mathfrak{h}) \in \infty LieAlg \subset \infty LieGrpd
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of cocycles is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi LieGrpd
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mi 𝔥
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mn ∞
                  %mi LieAlg
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mi 𝔥
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\infty LieGrpd(\mathfrak{g}, \mathfrak{h})
                  \\simeq
                  \\infty LieAlg(\mathfrak{g}, \mathfrak{h})
                  \\,.
          %p
            Such cocycles are modeled by morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi dgAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} dgAlg^{op}
            from a cofibrant representative of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            to a fibrant representative of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔥
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dgAlg
                %annotation{:encoding => "application/x-tex"} dgAlg
            all objects are fibrant, in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi dgAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} dgAlg^{op}
            all objects are cofibrant. The cofibrant objects in the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
            are the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{h})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                  %mo =
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathfrak{h} = b^{n-1}\mathbb{R}
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(b^{n-1}\mathbb{R})
            is a Sullivan algebra, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b^{n-1} \mathbb{R}
            is fibrant in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} dgAlg^{op}
          %p In summary, this says that morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{g}) \leftarrow CE(b^{n-1}\mathbb{R})
          %p
            indeed model the abstract intrinsic
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Lie
                    %mi Algd
                    %mo ⊂
                    %mn ∞
                    %mi Lie
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \infty Lie Algd \subset \infty Lie Grpd
          %h3#examples Examples
          %p
            Special cases of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+Lie+algebra+cohomology"}> nonabelian Lie algebra cohomology
                \.
          %p Specific examples include:
          %ul
            %li
              cohomology of
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroids"} Poisson Lie algebroids
              is
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+cohomology"} Poisson cohomology
          %h2#transgression_between_invariant_polynomials_and_cocycles_via_chernsimons_elements Transgression between invariant polynomials and cocycles via Chern-Simons elements
          %p
            We recall the procedure by which to an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            we associate an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            that is
            %em in transgression with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            of the canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{a}) \to CE(\mathfrak{a})
            from the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            to the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inv
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  inv(\mathfrak{a}) \subset CE(\Sigma \mathfrak{a}) = ker(W(\mathfrak{a}) \to CE(\mathfrak{a}))
                  \\,.
          %p
            From the
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(\Sigma \mathfrak{a}) \to W(\mathfrak{a}) \to
                  CE(\mathfrak{a})
          %p
            we obtain the long exact sequence in
            %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi δ
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  H^{n+1}(CE(\mathfrak{a}))
                  \\stackrel{\delta}{\to} H^{n+2}(CE(\Sigma \mathfrak{a}))
                  \\to \cdots
                  \\,.
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ∈
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu \in CE(\mathfrak{a})
            is in transgression with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %mi inv
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in inv(\mathfrak{a}) \subset CE(\Sigma \mathfrak{a})
            if their classes map to each other under the connecting homomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi μ
                  %mo{:stretchy => "false"} ]
                  %mo ↦
                  %mo{:stretchy => "false"} [
                  %mi ω
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta : [\mu] \mapsto [\omega]
                  \\,.
          %p
            The following spells out in detail how one finds to a given invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            the cocycle that it is in transgression with.
          %ol
            %li
              %p
                We first regard the
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                as an element of the
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
                under the inclusion
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi inv
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} inv(\mathfrak{a}) \hookrightarrow W(\mathfrak{a})
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                        %mi ω
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{a})} \omega = 0
            %li
              %p
                then we find an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi cs
                        %mi ω
                      %mo ∈
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cs_\omega \in W(\mathfrak{a})
                with the property that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi cs
                          %mi ω
                        %mo =
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{a})} cs_\omega = \omega
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
                has trivial cohomology.
            %li
              %p
                then we send this element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi cs
                        %mi ω
                      %mo ∈
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cs_\omega\in W(\mathfrak{a})
                along the restriction map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(\mathfrak{a}) \to CS(\mathfrak{a})
                to an elemeent we call
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ν
                      %annotation{:encoding => "application/x-tex"} \nu
          %p The procedure is illustarted by the following diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                        %mtd
                          %mi ω
                        %mtd
                          %mo ←
                        %mtd
                          %mi ω
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi d
                                  %mrow
                                    %mi CE
                                    %mo{:stretchy => "false"} (
                                    %mi 𝔞
                                    %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi d
                                  %mrow
                                    %mi W
                                    %mo{:stretchy => "false"} (
                                    %mi 𝔞
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ν
                        %mtd
                          %mo ←
                        %mtd
                          %mi cs
                          %mo{:stretchy => "false"} (
                          %mi ω
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi inv
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  0 &amp;&amp; \omega &amp;\leftarrow &amp; \omega
                  \\\
                  \\;\;\uparrow^{\mathrlap{d_{CE(\mathfrak{a})}}}
                  \&amp;&amp;
                  \\;\;\uparrow^{\mathrlap{d_{W(\mathfrak{a})}}}
                  \\\
                  \\nu &amp;\leftarrow&amp; cs(\omega)
                  \\\
                  \\\
                  \\\
                  \\\
                  CE(\mathfrak{a})
                  \&amp;\leftarrow&amp;
                  W(\mathfrak{a})
                  \&amp;\leftarrow&amp;
                  inv(\mathfrak{a})
                  }
          %p
            From the fact that all morphisms involved respect the differential and from the fact that the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            vanishes it follows that
          %ul
            %li
              %p
                this element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
                satisfies
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                        %mi ν
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{a})} \nu = 0
                = succeed "-Lie" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %li
              %p
                any two different choices of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi cs
                        %mi ω
                    %annotation{:encoding => "application/x-tex"} cs_\omega
                lead to cocylces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                that are cohomologous.
          %p
            We say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            is a cocycle
            %em in transgression with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi cs
                    %mi ω
                %annotation{:encoding => "application/x-tex"} cs_{\omega}
            here a
            %em Chern-Simons element
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} A : T X \to \mathfrak{a}
            any collection of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
            coming dually from a dg-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X) \leftarrow W(\mathfrak{a}) : A
            the image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega(A)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            will be a curvature characteristic form and the image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi cs
                    %mi ω
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} cs_\omega(A)
            its corresponding Chern-Simons form.
          %p
            In the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is an ordinary semisimple
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %em Semisimple Lie algebras
            \.
          %h3#examples_2 Examples
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            and the 3-cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, [-,-] \rangle
            is exhibited by the “ordinary” Chern-Simons element, which gives these
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            is an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            equipped with a nondegenerate binary invariant polynomial in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n+2
          %p Examples are
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"}> symplectic manifold
                s
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"}> Poisson Lie algebroid
                s
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Courant+algebroid"}> Courant algebroid
                s.
          %p
            The coresponding Chern-Simons elements exhibiting the transgression of these invariant polynomials give
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            (see the above entries for more details).
          %h2#Extensions Extensions
          %p
            In any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            with its intrinsic notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi A
                %annotation{:encoding => "application/x-tex"} c : X \to \mathbf{B}^{n+1} A
            classifies an
            %em extension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo →
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A \to \hat X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat X
            is nothing but the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            classified by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            After embedding
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            = succeed "," do
              %a{:href => "#Topos"} above
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mi n
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} c : \mathfrak{g} \to b^n \mathbb{R}
            a cocycle of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo →
                  %mover
                    %mi 𝔤
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} b^{n-1} \mathbb{R} \to \hat \mathfrak{g} \to \mathfrak{g}
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of this morphism in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
          %blockquote
            %p
              a more systematic discussion is now in the section
              %a{:href => "http://ncatlab.org/nlab/show/synthetic+differential+infinity-groupoid#CohomologyOfLieAlgebroids"} Cohomology of ∞-Lie algebroids
              at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"} synthetic differential ∞-groupoid
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+Lie+algebra+cohomology"} nonabelian Lie algebra cohomology
          %p
            %strong Observation
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mi n
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} c : \mathfrak{g} \to b^n \mathbb{R}
            an
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi dgAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} dgAlg^{op}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi g
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mi inn
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi b
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi 𝔤
                        %mtd
                          %mover
                            %mo →
                            %mi c
                        %mtd
                          %msup
                            %mi b
                            %mi n
                          %mi ℜ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat g &amp;\to&amp; inn(b^{n-1}\mathbb{R})
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathfrak{g} &amp;\stackrel{c}{\to}&amp; b^n \mathfrak{R}
                  }
          %p
            maps under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to a pullback diagram of simplicial presheaves which exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi 𝔤
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(\hat \mathfrak{g})
            as isomorphic to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
          %p
            Here the right morphism denotes the dual of the generating cofibration in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dgAlg
                  %annotation{:encoding => "application/x-tex"} dgAlg
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mi n
                    %mi ℜ
                  %annotation{:encoding => "application/x-tex"} b^n \mathfrak{R}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+%E2%88%9E-bundle"} universal principal ∞-bundle
          %p
            %strong Proof
          %p
            Being a right Quillen functor,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            preserves fibrations and pullbacks, hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi R
                          %mover
                            %mi g
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mi R
                          %mi inn
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi b
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi R
                          %mi 𝔤
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi R
                              %mi c
                        %mtd
                          %mi R
                          %msup
                            %mi b
                            %mi n
                          %mi ℜ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  R \hat g &amp;\to&amp; R inn(b^{n-1}\mathbb{R})
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  R \mathfrak{g} &amp;\stackrel{R c}{\to}&amp; R b^n \mathfrak{R}
                  }
          %p
            is a pullback of a fibration. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi ThCartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                %annotation{:encoding => "application/x-tex"} [ThCartSp^{op},sSet]_{proj}
            is a
            %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} right proper model category
            this is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} R \mathfrak{g}
            is possibly not fibrant. (The detailed argument for that is reproduced at
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
            preserves finite
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mover
                    %mi 𝔤
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} R \hat \mathfrak{g}
            represents in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi ThCartSp
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi cov
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho([ThCartSp, sSet]_{proj,cov})
            the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi c
                    %mo :
                    %mi R
                    %mi 𝔤
                    %mo →
                    %mi R
                    %msup
                      %mi b
                      %mi n
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} R c : R \mathfrak{g} \to R b^n \mathbb{R}
          %h3#examples_3 Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔥
                    %annotation{:encoding => "application/x-tex"} \mathfrak{h}
                ordinary
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi der
                      %mo{:stretchy => "false"} (
                      %mi 𝔥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} der(\mathfrak{h})
                the Lie algebra of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔥
                      %annotation{:encoding => "application/x-tex"} \mathfrak{h}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo →
                      %mi der
                      %mo{:stretchy => "false"} (
                      %mi 𝔥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}\to der(\mathfrak{h})
                is a cocycle in
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+Lie+algebra+cohomology"} nonabelian Lie algebra cohomology
                and the extension it classifies is an ordinary
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
                is the
                = succeed "-extension" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} b \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                with bilinear
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
                corresponding to the 3-cocycle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ⟩
                        %mo ∈
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \langle -,[-,-]\rangle \in CE(\mathfrak{g})
            %li
              %p
                Similarly for the
                %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
                and the
                %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+6-algebra"} supergravity Lie 6-algebra
                and all the other extensions in
                = succeed "." do
                  %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} The brane bouquet
          %h2#related_concepts Related concepts
          %p
            A comprehensive discusson of an ambient
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"}> synthetic differential ∞-groupoid
              \.
          %p
            Other notions related to
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-Lie algebra cocycle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
          %h2#references References
          %p
            Discussion of cohomology of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li
              Michael Penkava,
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebras and their cohomology
              (
              %a{:href => "http://arxiv.org/abs/q-alg/9512014"}> arXiv:q-alg/9512014
              )
          %p
            The relation between
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrey+Lazarev"}> Andrey Lazarev
              ,
              %em Models for classifying spaces and derived deformation theory
              (
              %a{:href => "http://arxiv.org/abs/1209.3866"}> arXiv:1209.3866
              )
          %p
            The general structure of the threory of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            between
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
            was given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-connections
              (
              %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#SSSI"}> web
              )
          %p
            A recognition principle for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            of
            = succeed "-homomorphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul#FiorenzaRogersSchreiber13
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"} Chris Rogers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/L-%E2%88%9E+algebras+of+local+observables+from+higher+prequantum+bundles"} L-∞ algebras of local observables from higher prequantum bundles
              (
              %a{:href => "http://arxiv.org/abs/1304.6292"}> arXiv:1304.6292
              )
          %p
            Discussion of extensions of
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            based on the
            %a.existingWikiWord{:href => "/nlab/show/super+Poincare+Lie+algebra"} super Poincare Lie algebra
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} Super Lie n-algebra extensions, higher WZW models and super p-branes with tensor multiplet fields
          %p
            The hypercohomology of the Chevalley-Eilenberg-de Rham complex of a Lie algebroid L over a scheme with coefficients in an L-module can be expressed as a
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            as shown in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ugo+Bruzzo"}> Ugo Bruzzo
              ,
              %em Lie algebroid cohomology as a derived functor
              (
              %a{:href => "http://arxiv.org/abs/1606.02487"}> arxiv/1606.02487
              )
