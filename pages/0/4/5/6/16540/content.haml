          %h2#idea Idea
          %p
            Just like a right
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensored
            (over
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %msup
                    %mi 𝒞
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} T : \mathcal{C}^\op \to \mathcal{V}
            can be tensored (over
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi 𝒞
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} S : \mathcal{C} \to \mathcal{V}
            to obtain an object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            can be an arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathcal{V} = Set
            with the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            as monoidal structure.
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a category. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{V},{\otimes})
            be a monoidal category. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %msup
                    %mi 𝒞
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} T : \mathcal{C}^\op \to \mathcal{V}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi 𝒞
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} S : \mathcal{C} \to \mathcal{V}
            be functors. Then their tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %msub
                    %mo ⊗
                    %mi 𝒞
                  %mi S
                %annotation{:encoding => "application/x-tex"} T \otimes_{\mathcal{C}} S
            is defined (if it exists) as the
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %msub
                    %mo ⊗
                    %mi 𝒞
                  %mi S
                  %mo ≔
                  %msup
                    %mo ∫
                    %mi c
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} T \otimes_{\mathcal{C}} S \coloneqq \int^c T(c) \otimes S(c).
          %p
            The following slight variation is also important. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a category. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            be a category with all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            %a.existingWikiWord{:href => "/nlab/show/copower"} copower
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋅
                  %mi d
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                  %mi d
                  %mo ∈
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} X \cdot d = \coprod_{x \in X} d \in \mathcal{D}
            exists for any set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and any object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %msup
                    %mi 𝒞
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} T : \mathcal{C}^\op \to Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} S : \mathcal{C} \to \mathcal{D}
            be functors. Then their tensor product is (if it exists) the coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %msub
                    %mo ⊗
                    %mi 𝒞
                  %mi S
                  %mo ≔
                  %msup
                    %mo ∫
                    %mi c
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi 𝒟
                  %mo .
                %annotation{:encoding => "application/x-tex"} T \otimes_{\mathcal{C}} S \coloneqq \int^c T(c) \cdot S(c) \in \mathcal{D}.
          %p Intuition for the tensor product of functors can be gained by relating it to the tensor product of modules (see the first example below) and by a picture involving gluing specifications (see below).
          %h2#examples Examples
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %msup
                        %mi.mathscript 𝒞
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} T : \mathscr{C}^{op} \to Set
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo :
                        %mi.mathscript 𝒞
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} S : \mathscr{C} \to Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %msub
                        %mo ⊗
                        %mi.mathscript 𝒞
                      %mi S
                    %annotation{:encoding => "application/x-tex"} T \otimes_{\mathscr{C}} S
                can be presented as set of formal symbols
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %msub
                        %mo ⊗
                        %mi c
                      %mi s
                    %annotation{:encoding => "application/x-tex"} t \otimes_c s
                (or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ⊗
                      %mi s
                    %annotation{:encoding => "application/x-tex"} t \otimes s
                for short) where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi.mathscript 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c \in Ob(\mathscr{C})
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s \in S(c)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t \in T(c)
                modulo the equivalence relation generated by the instances
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mi f
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi c
                      %mi s
                      %mo ∼
                      %mi t
                      %msub
                        %mo ⊗
                        %mi d
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (t f) \otimes_c s \sim t \otimes_d (f s)
                when defined, where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi.mathscript 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in \mathscr{C}(c,d)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathscr{C}
                is the shorthand
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mi f
                      %mo =
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t f = T(f)(t)
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mi s
                        %mo =
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f s = S(f)(s)
            %li
              %p
                Recall that a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                can be considered as an
                %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                and that a right and a left module gives rise to an additive functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                      %mo →
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"} A^\op \to Ab
                respectively
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} A \to Ab
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
                as monoidal structure on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} Ab
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi st
                      %mo :
                      %mi Δ
                      %mo →
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} st : \Delta \to Top
                be the functor which associates to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
                the topological standard
                = succeed "-simplex." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                can be expressed as the tensor product
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                        %mo =
                        %mi X
                        %msub
                          %mo ⊗
                          %mi Δ
                        %mi st
                      %annotation{:encoding => "application/x-tex"} |X| = X \otimes_\Delta st
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a small category and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi 𝒞
                      %mo →
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} F : \mathcal{C} \to \mathcal{D}
                be a functor into a
                %a.existingWikiWord{:href => "/nlab/show/cocomplete"} cocomplete
                category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
                of
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is the
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                induces a functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ^
                        %mo :
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \hat F : PSh(\mathcal{C}) \to \mathcal{D}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                        %msub
                          %mo ⊗
                          %mi 𝒞
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \hat F(X) = X \otimes_\mathcal{C} F
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo :
                      %mi 𝒞
                      %mo →
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Y : \mathcal{C} \to PSh(\mathcal{C})
                denote the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %msup
                        %mi 𝒞
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} F : \mathcal{C}^\op \to Set
                be a presheaf on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ⊗
                        %mi Y
                        %mo =
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F \otimes Y = F
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
                (also referred to as the
                %em ninja Yoneda lemma
                in some circles).
            %li
              %p
                In some sense,
                %a.existingWikiWord{:href => "/nlab/show/representable+functors"} representable functors
                generalize
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mi n
                        %msub
                          %mo ⊗
                          %mi A
                        %mi M
                        %mo ≅
                        %msup
                          %mi M
                          %mi n
                      %annotation{:encoding => "application/x-tex"} A^n \otimes_A M \cong M^n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi 𝒞
                      %mi S
                      %mo =
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \Hom_\mathcal{C}(\cdot, c) \otimes_\mathcal{C} S = S(c).
              %p This follows from some coend manipulations:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
