                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Ξ
                      %mo ⊢
                      %mo ⊤
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \top \; \mathrm{prop}} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Xi \vdash \top \; \mathrm{true}}
