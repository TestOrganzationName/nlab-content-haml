            %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
            in the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
          %p
            Constructive logic is still
            %a.existingWikiWord{:href => "/nlab/show/two-valued+logic"} two-valued
            in the sense that any truth value which is not true is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/false"} false
          %h3#in_linear_logic In linear logic
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %em additive
            truth, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            %em multiplicative
            truth, denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            that is the
            %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
            of the lattice of linear truth values. (In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ⊢
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} 1 \vdash \top
            but
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo ⊬
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \top \nvdash 1
          %h3#in_a_topos In a topos
          %p
            In terms of the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            (or other
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi true
                %annotation{:encoding => "application/x-tex"} true
            is the
            %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
            in the
            %a.existingWikiWord{:href => "/nlab/show/poset+of+subobjects"} poset of subobjects
            of any given
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            (where each object corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            in the internal language).
          %p
            However, not every topos is
            %a.existingWikiWord{:href => "/nlab/show/two-valued+topos"} two-valued
            (even if it is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boolean+topos"} boolean
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi true
                %annotation{:encoding => "application/x-tex"} true
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi false
                  %annotation{:encoding => "application/x-tex"} false
          %h3#in_type_theory In type theory
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
          %h3#in_homotopy_type_theory In homotopy type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
          %h2#examples Examples
          %h3#in_the_topos_
            In the topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
            In the archetypical
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{*\}
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi ∅
                    %mo ↪
                    %mo *
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\emptyset \hookrightarrow *\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{*\}
            %a.existingWikiWord{:href => "/nlab/show/improper+subset"} improper subset
            of itself. (See
            %a{:href => "http://ncatlab.org/nlab/show/internal+logic#LogicOfSet"} Internal logic of Set
            for more details).
          %p
            The same is true in the archetypical
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %ul
            %li
              %p
                a set as a 0-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                = succeed "-groupoid:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
