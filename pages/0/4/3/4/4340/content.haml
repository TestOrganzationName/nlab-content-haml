          %h3#in_constructive_logic In constructive logic
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+logic"} constructive logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
