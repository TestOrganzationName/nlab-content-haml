                %a{:href => "#section_Idea"} Idea
              %li
                %a{:href => "#section_Presentation"} Presentation
              %ul
                %li
                  %a{:href => "#section_Judgments_and_contexts"} Judgments and contexts
                %li
                  %a{:href => "#section_Structural_rules"} Structural rules
                %li
                  %a{:href => "#section_Judgmental_equality"} Judgmental equality
                %li
                  %a{:href => "#section_Definitions"} Definitions
                %li
                  %a{:href => "#section_Rules_for_types"} Rules for types
                %ul
                  %li
                    %a{:href => "#section_Dependent_product_types"} Dependent product types
                  %li
                    %a{:href => "#section_Dependent_sum_types"} Dependent sum types
                  %li
                    %a{:href => "#section_Identity_types"} Identity types
                  %li
                    %a{:href => "#section_Type_of_all_propositions"} Type of all propositions
                  %li
                    %a{:href => "#section_Weak_function_extensionality_and_propositional_extensionality"} Weak function extensionality and propositional extensionality
                %li
                  %a{:href => "#section_Constructing_the_logical_operators"} Constructing the logical operators
                %ul
                  %li
                    %a{:href => "#section_Universal_quantification"} Universal quantification
                  %li
                    %a{:href => "#section_Falsehood"} Falsehood
                  %li
                    %a{:href => "#section_Implication_and_negation"} Implication and negation
                  %li
