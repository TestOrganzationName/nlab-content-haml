                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi t
                          %mo :
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} refl
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi Γ
                          %mo ,
                          %mi a
                          %mo :
                          %mi A
                          %mo ,
                          %mi b
                          %mo :
                          %mi A
                          %mo ,
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo =
                            %mi A
                          %mi b
                          %mo ⊢
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo ,
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma, a:A, b:A, p:a =_A b \vdash C(a, b, p) \; \mathrm{type} \quad \Gamma \vdash t:\prod_{x:A} C(x, x, \mathrm{refl}_A(x))}{\Gamma, a:A, b:A, p:a =_A b \vdash J(t, a, b, p):C(a, b, p)}
            %li
              %p Computation rules for identity types:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi Γ
                          %mo ,
                          %mi a
                          %mo :
                          %mi A
                          %mo ,
                          %mi b
                          %mo :
                          %mi A
                          %mo ,
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo =
                            %mi A
                          %mi b
                          %mo ⊢
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi t
                          %mo :
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} refl
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo ,
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %mi{:mathvariant => "normal"} refl
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ≡
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} refl
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma, a:A, b:A, p:a =_A b \vdash C(a, b, p) \; \mathrm{type} \quad \Gamma \vdash t:\prod_{x:A} C(x, x, \mathrm{refl}_A(x))}{\Gamma, x:A \vdash J(t, x, x, \mathrm{refl}(x)) \equiv t(x):C(x, x, \mathrm{refl}_A(x))}
          %p
          %h4#section_Type_of_all_propositions Type of all propositions
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
            or
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            if for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} y:A
            there is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p(x, y):x =_A y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            of a dependent function type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ishProp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{ishProp}(A) \coloneqq \prod_{x:A} \prod_{y:A} x =_A y
          %p
            The type of all propositions is given by the following
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          %ul
            %li
              %p Formation rules for the type of all propositions:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi Γ
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} ctx
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi{:mathvariant => "normal"} Prop
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{Prop} \; \mathrm{type}}
            %li
              %p Introduction rules for the type of all propositions:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %msub
                            %mi{:mathvariant => "normal"} toProp
                            %mi A
                          %mo :
                          %mi{:mathvariant => "normal"} ishProp
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi{:mathvariant => "normal"} Prop
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \mathrm{toProp}_A:\mathrm{ishProp}(A) \to \mathrm{Prop}}
            %li
              %p Elimination rules for the type of all propositions:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi{:mathvariant => "normal"} El
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mspace{:width => "2em"}
                      %mfrac
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi{:mathvariant => "normal"} proptrunc
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi{:mathvariant => "normal"} ishProp
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} El
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Prop}}{\Gamma \vdash \mathrm{El}(A) \; \mathrm{type}} \qquad \frac{\Gamma \vdash A:\mathrm{Prop}}{\Gamma \vdash \mathrm{proptrunc}(A):\mathrm{ishProp}(\mathrm{El}(A))}
            %li
              %p Computation rules for the type of all propositions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi{:mathvariant => "normal"} ishProp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} toProp
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash p:\mathrm{ishProp}(A)}{\Gamma \vdash \mathrm{El}(\mathrm{toProp}_A(p)) \equiv A \; \mathrm{type}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi{:mathvariant => "normal"} ishProp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} proptrunc
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} toProp
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi p
                      %mo :
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash p:\mathrm{ishProp}(A)}{\Gamma \vdash \mathrm{proptrunc}(\mathrm{toProp}_A(p)) \equiv p:\mathrm{isProp}(A)}
          %ul
            %li Uniqueness rules for the type of all propositions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ≡
                      %msub
                        %mi{:mathvariant => "normal"} toProp
                        %mrow
                          %mi{:mathvariant => "normal"} El
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} proptrunc
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Prop}}{\Gamma \vdash A \equiv \mathrm{toProp}_{\mathrm{El}(A)}(\mathrm{proptrunc}(A)):\mathrm{Prop}}
          %p
          %h4#section_Weak_function_extensionality_and_propositional_extensionality Weak function extensionality and propositional extensionality
          %ul
            %li Extensionality principle of the type of all propositions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ext
                        %mi{:mathvariant => "normal"} Prop
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi{:mathvariant => "normal"} transport
                        %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Prop} \quad \Gamma \vdash B:\mathrm{Prop}} {\Gamma \vdash \mathrm{ext}_\mathrm{Prop}(A, B):\mathrm{isEquiv}(\mathrm{transport}^\mathrm{El}(A, B))}
          %ul
            %li Weak function extensionality:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mo :
                      %mi A
                      %mo →
                      %mi{:mathvariant => "normal"} Prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} wfunext
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi{:mathvariant => "normal"} ishProp
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi{:mathvariant => "normal"} El
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B:A \to \mathrm{Prop}}{\Gamma \vdash \mathrm{wfunext}_A(B):\mathrm{ishProp}\left(\prod_{x:A} \mathrm{El}(B(x))\right)}
          %p
          %h3#section_Constructing_the_logical_operators Constructing the logical operators
          %p
            In this section we construct
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/truth"} truth
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/falsehood"} falsehood
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conjunction"} conjunction
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/implication"} implication
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
            %a.existingWikiWord{:href => "/nlab/show/universal+quantifier"} universal quantifier
            from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
          %p
          %h4#section_Universal_quantification Universal quantification
          %p
            Given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} P:A \to \mathrm{Prop}
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+type"} dependent function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:A} \mathrm{El}(P(x))
            is an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} wfunext
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} ishProp
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{wfunext}_A(P):\mathrm{ishProp}\left(\prod_{x:A} \mathrm{El}(P(x))\right)
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/universal+quantifier"} universal quantifier
            can be defined via the introduction rules of the type of all propositions as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi{:mathvariant => "normal"} toProp
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} wfunext
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall x:A.P(x) \coloneqq \mathrm{toProp}_{\prod_{x:A} \mathrm{El}(P(x))}(\mathrm{wfunext}_A(P))
          %p
          %h4#section_Falsehood Falsehood
          %p
            By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{P:\mathrm{Prop}} \mathrm{El}(P)
            is a
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            with witness
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} wfunext
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Prop
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi{:mathvariant => "normal"} Prop
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} ishProp
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi P
                        %mo :
                        %mi{:mathvariant => "normal"} Prop
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{wfunext}(\mathrm{Prop}, \mathrm{id}_\mathrm{Prop}):\mathrm{ishProp}\left(\prod_{P:\mathrm{Prop}} \mathrm{El}(P)\right)
          %p
            This dependent product type is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/falsehood"} falsehood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mo :
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} \bot:\mathrm{Prop}
            can be defined via the introduction rules of the type of all propositions as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mo ≔
                  %msub
                    %mi{:mathvariant => "normal"} toProp
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi P
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} wfunext
                    %mi{:mathvariant => "normal"} Prop
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi{:mathvariant => "normal"} Prop
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bot \coloneqq \mathrm{toProp}_{\prod_{P:\mathrm{Prop}} \mathrm{El}(P)}(\mathrm{wfunext}_\mathrm{Prop}(\mathrm{id}_\mathrm{Prop}))
          %p
          %h4#section_Implication_and_negation Implication and negation
          %p
            Given any proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} Q:\mathrm{Prop}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} P:\mathrm{Prop}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi x
                    %mo :
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi P
                    %mo :
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \lambda x:\mathrm{El}(Q).P:\mathrm{El}(Q) \to \mathrm{Prop}
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{El}(Q) \to \mathrm{El}(P)
            is defined as the
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+type"} dependent function type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{El}(Q) \to \mathrm{El}(P) \coloneqq \prod_{x:\mathrm{El}(Q)} \mathrm{El}(P) \equiv \prod_{x:\mathrm{El}(Q)} \mathrm{El}((\lambda x:\mathrm{El}(Q).P)(x))
          %p
            which is an
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} wfunext
                    %mrow
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} ishProp
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi{:mathvariant => "normal"} El
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo :
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{wfunext}_{\mathrm{El}(Q)}(\lambda x:\mathrm{El}(Q).P):\mathrm{ishProp}\left(\prod_{x:\mathrm{El}(Q)} \mathrm{El}((\lambda x:\mathrm{El}(Q).P)(x))\right)
          %p
            This means that implication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo ⇒
                  %mi P
                %annotation{:encoding => "application/x-tex"} Q \Rightarrow P
            can be defined as the following proposition:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo ⇒
                  %mi P
                  %mo ≔
                  %msub
                    %mi{:mathvariant => "normal"} toProp
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi{:mathvariant => "normal"} El
                          %mo{:stretchy => "false"} (
                          %mi Q
                          %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo :
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} wfunext
                    %mrow
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q \Rightarrow P \coloneqq \mathrm{toProp}_{\prod_{x:\mathrm{El}(Q)} \mathrm{El}((\lambda x:\mathrm{El}(Q).P)(x))}(\mathrm{wfunext}_{\mathrm{El}(Q)}(\lambda x:\mathrm{El}(Q).P))
          %p
            The negation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                %annotation{:encoding => "application/x-tex"} \neg P
            of a proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} P:\mathrm{Prop}
            is given by implication into falsehood:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                  %mo ≔
                  %mi P
                  %mo ⇒
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \neg P \coloneqq P \Rightarrow \bot
          %p
          %h4#section_Truth Truth
          %p
            There are many different ways of defining truth
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo :
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \top:\mathrm{Prop}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                  %mo ≔
                  %mo ⊥
                  %mo ⇒
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \top \coloneqq \bot \Rightarrow \bot
          %p
          %h4#section_Conjunction Conjunction
          %p
            Given two
            %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \times B
            is also an
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            by the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/binary+action+on+identifications"} binary action on identifications
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
