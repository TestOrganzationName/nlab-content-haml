            has an
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            as the group of rotations in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            preserves both the
            %a.existingWikiWord{:href => "/nlab/show/dot+product"} dot product
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cross+product"} cross product
          %p
            But something analogous happens to be true in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^7
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(3)
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the
            %a.existingWikiWord{:href => "/nlab/show/exceptional+Lie+group"} exceptional Lie group
            %a.existingWikiWord{:href => "/nlab/show/G2"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
            (see
            = succeed ")" do
              %a{:href => "G2#Subgroups"} there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 2
                %annotation{:encoding => "application/x-tex"} G_2
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 7
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^7
            remains irreducible when restricted to this subgroup.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(3)
            preserves the dot and cross products defined there in terms of the imaginary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
          %p
            This
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 7
                  %annotation{:encoding => "application/x-tex"} 7
            %a.existingWikiWord{:href => "/nlab/show/homogeneous+polynomials"} homogeneous polynomials
            on
            = succeed "," do
