                is a coproduct of representable presheaves given by iterated
                %a.existingWikiWord{:href => "/nlab/show/fiber+products"} fiber products
                of maps in the covering family
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
