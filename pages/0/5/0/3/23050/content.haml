          %title
          %h2#definition Definition
          %p
            A
            %em residuated lattice
            is an algebra,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mo ∧
                  %mo ,
                  %mo ∨
                  %mo ,
                  %mo ⋅
                  %mo ,
                  %mo \
                  %mo ,
                  %mo{:stretchy => "false"} /
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L=(L,\wedge,\vee, \cdot, \backslash, /,1)
            such that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mo ∧
                      %mo ,
                      %mo ∨
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,\wedge,\vee)
                is a lattice;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mo ⋅
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,\cdot,1)
                is a monoid;
            %li
              %p
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo ∈
                        %mi L
                      %annotation{:encoding => "application/x-tex"} a,b,c\in L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo ≤
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ≤
                  %mi a
                  %mo \
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ≤
                  %mi c
                  %mo{:stretchy => "false"} /
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a b\le c)\Leftrightarrow (b\le a \backslash c)\Leftrightarrow (a\le c / b).
          %h2#examples Examples
          %h3#powerset_of_a_monoid Powerset of a monoid.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo ⋅
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\cdot, e)
            be a monoid and consider
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L=\mathcal{P}(M)
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ⊆
                    %mi M
                  %annotation{:encoding => "application/x-tex"} X, Y\subseteq M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋅
                  %mi Y
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ⋅
                  %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo ∈
                  %mi X
                  %mo ,
                  %mi y
                  %mo ∈
                  %mi Y
                  %mo{:stretchy => "false"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"} X\cdot Y=\{x\cdot y\mid x\in X, y\in Y\};
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo \
                  %mi Y
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi z
                  %mo ∈
                  %mi M
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi X
                  %mo ⋅
                  %mo{:stretchy => "false"} {
                  %mi z
                  %mo{:stretchy => "false"} }
                  %mo ⊆
                  %mi Y
                  %mo{:stretchy => "false"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"} X\backslash Y = \{z\in M\mid X\cdot\{z\}\subseteq Y\};
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi z
                  %mo ∈
                  %mi M
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo{:stretchy => "false"} {
                  %mi z
                  %mo{:stretchy => "false"} }
                  %mo ⋅
                  %mi X
                  %mo ⊆
                  %mi Y
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Y/ X= \{z\in M\mid \{z\}\cdot X\subseteq Y\}
          %p
            and then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            with this structure is a residuated lattice.
          %ul
            %li
              A special instance of this is with the quantale of ideals in a ring,
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/ideals+in+a+monoid"} ideals in a monoid
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
          %h3#relation_algebra_on_a_set Relation algebra on a set
          %p
            For any set,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rel(X)=\mathcal{P}(X\times X)
            of binary relations on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a residuated lattice.
          %p
            Writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo −
                %annotation{:encoding => "application/x-tex"} R^-
            for the complement of a relation,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ;
                  %mi S
                %annotation{:encoding => "application/x-tex"} R;S
            for the relational composition of two relations,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo \
                  %mi S
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ;
                  %msup
                    %mi S
                    %mo −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo −
                  %mo ,
                %annotation{:encoding => "application/x-tex"} R \backslash S = (R;S^-)^- ,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mi R
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mo −
                  %mo ;
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo −
                %annotation{:encoding => "application/x-tex"} S / R = (S^-;R)^-
          %p and
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi S
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ∩
                  %msup
                    %mi S
                    %mo −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo −
                  %mo =
                  %msup
                    %mi R
                    %mo −
                  %mo ∪
                  %mi S
                  %mo .
                %annotation{:encoding => "application/x-tex"} R\to S= (R\cap S^-)^- = R^-\cup S.
          %p We have
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Rel
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ∩
                      %mo ,
                      %mo ∪
                      %mo ,
                      %mo →
                      %mo ,
                      %mi ∅
                      %mo ,
                      %msup
                        %mi X
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Rel(X), \cap,\cup,\to, \emptyset, X^2)
                is a Boolean algebra,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Rel
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ;
                      %mi Δ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Rel(X), ; \Delta)
                is a monad, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                is the diagonal / equality relation;
            %li
              %p the residuation relation is satisfied:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ;
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo \
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ⊆
                  %mi T
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} ((R;S)\subseteq T)\Leftrightarrow (S\subseteq (R\backslash T))\Leftrightarrow (R\subseteq T / S)).
          %h3#latticeordered_group Lattice-ordered group
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/lattice-ordered+group"} lattice-ordered group
            gives a residuated lattice. This is described in the entry on lattice-ordered groups. It is noteworthy that in this context, the residuals are quotients and, in fact, the inverses in the group are residuals.
          %h2#categorical_interpretations_of_residuation Categorical interpretations of residuation
          %p
            Looking at the poset structure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            as a category, one rewrites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≤
                  %mi b
                %annotation{:encoding => "application/x-tex"} a\le b
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} a\to b
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(a,b)
            for the singleton set consisting just of the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\to b
          %p
            We have for each element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi a
                  %mo :
                  %mi x
                  %mo ↦
                  %mi a
                  %mo ⋅
                  %mi x
                %annotation{:encoding => "application/x-tex"} \lambda_a:x\mapsto a\cdot x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi a
                  %mo :
                  %mi x
                  %mo ↦
                  %mi x
                  %mo ⋅
                  %mi a
                  %mo .
                %annotation{:encoding => "application/x-tex"} \rho_a:x\mapsto x\cdot a.
          %p
            These mappings are order preserving, so give endofunctors on the
            %em category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\le y
            and we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi y
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\cdot y\leq b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≤
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi b
                  %annotation{:encoding => "application/x-tex"} y\leq a/b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x\le a/b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi x
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\cdot x\leq b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mi a
                    %mo ⋅
                    %mi y
                  %annotation{:encoding => "application/x-tex"} b= a\cdot y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi x
                    %mo ≤
                    %mi a
                    %mo ⋅
                    %mi y
                  %annotation{:encoding => "application/x-tex"} a\cdot x\leq a\cdot y
          %p In this interpretation, both these functors have right adjoints, namely the two residuals. We have, for instance,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mi a
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi a
                  %mo \
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} L(\lambda_a(x),c) \cong L(x,a\backslash c).
          %p
            The residual functor,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo \
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} a\backslash -
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} /
                  %mi a
                %annotation{:encoding => "application/x-tex"} -/a
            acts like a right exponential object functor.
          %p
            This point of view is explored further in the entry on
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/residual"} residual
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/residual"} residual
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/idempotent+semiring"} idempotent semiring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/residuated+morphism"} residuated morphism
          %h2#references References
          %p A classical reference is
          %ul
            %li
              M. Ward and R. P. Dilworth,
              = succeed "," do
                %em Residuated Lattices
              %a{:href => "https://doi.org/10.2307/1990008"} doi.org/10.2307/1990008
          %p A set of slides from a modern treatment is
          %ul
            %li
              Nikolaos Galatos,
              = succeed "," do
                %em Residuated lattices
              %a{:href => "https://www2.karlin.mff.cuni.cz/~ssaos/2008/ResiduatedLatticesTutorial.pdf"} slides
        .revisedby
