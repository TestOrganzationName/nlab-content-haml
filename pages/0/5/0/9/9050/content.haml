                    %a.existingWikiWord{:href => "/nlab/show/harmonic+form"} harmonic form
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi d
                          %mo ,
                          %msup
                            %mi d
                            %mo *
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mi d
                          %mo ,
                          %msup
                            %mi d
                            %mo *
                          %mo{:stretchy => "false"} ]
                          %mi G
                          %mo =
                          %mi Δ
                          %mi G
                        %annotation{:encoding => "application/x-tex"} [d, d^* G] = [d,d^*]G = \Delta G
