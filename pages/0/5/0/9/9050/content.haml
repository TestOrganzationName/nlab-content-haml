          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Hodge+theorem"} Hodge theorem
            asserts, in particular, that for a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %a.existingWikiWord{:href => "/nlab/show/graded+object"} grading
            of its
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            descends to its
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hodge+structure"} Hodge structure
          %h2#definitions Definitions
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X)
              for the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of smooth
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                    %mo :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \star : \Omega^\bullet(X) \to \Omega^{n-\bullet}(X)
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            %p
              The Hodge
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle : \Omega^\bullet(X) \otimes \Omega^{\bullet}(X)
                    \\to
                    \\mathbb{R}
            %p is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %msub
                      %mo ∫
                      %mi X
                    %mi α
                    %mo ∧
                    %mo ⋆
                    %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \alpha , \beta\rangle = \int_X \alpha \wedge \star \beta
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mo *
                  %annotation{:encoding => "application/x-tex"} d^*
              for the formal
              %a.existingWikiWord{:href => "/nlab/show/adjoint"} adjoint
              of the de Rham differential under this inner product. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo ,
                    %msup
                      %mi d
                      %mo *
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo =
                    %mi d
                    %msup
                      %mi d
                      %mo *
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msup
                      %mi d
                      %mo *
                    %mi d
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo +
                    %msup
                      %mi d
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta := [d,d^*] := d d^* + d^* d = (d + d^*)^2
            %p
              is the Hodge
              %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo +
                    %msup
                      %mi d
                      %mo *
                  %annotation{:encoding => "application/x-tex"} d + d^*
              is the corresponding
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta \omega = 0
            %p
              is called a
              %a.existingWikiWord{:href => "/nlab/show/harmonic+form"} harmonic form
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,g)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℋ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}^k(X)
              for the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              of harmonic
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h2#ResultsOverRiemannianManifold For Riemannian manifolds
          .num_prop
            %h6#observation Observation
            %p
              Harmonic forms are precisely those in the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo +
                      %msup
                        %mi d
                        %mo *
                    %annotation{:encoding => "application/x-tex"} d + d^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi d
                        %mo *
                    %annotation{:encoding => "application/x-tex"} d^*
          %p
            By the fact that the
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            is non-degenerate.
          %p
            Therefore we have a canonical map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℋ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi dR
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^k(X) \to H_{dR}^k(X)
            of harmonic forms into the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .num_theorem
            %h6#theorem Theorem
            %p The canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℋ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi dR
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{H}^k(X) \to H_{dR}^k(X)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This means that every
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            class on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            has precisely one harmonic cocycle reprentative.
          %p But more is true
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              as above, there exists a unique degree-preserving operator (the
              %a.existingWikiWord{:href => "/nlab/show/Green+operator"} Green operator
              of the
              %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G : \Omega^\bullet(X) \to \Omega^\bullet(X)
            %p such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  commutes with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                  and with
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi d
                            %mo *
                        %annotation{:encoding => "application/x-tex"} d^*
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℋ
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} G(\mathcal{H}^\bullet(X)) = 0
                  ;
              %li
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo −
                        %msub
                          %mi π
                          %mi ℋ
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %msup
                          %mi d
                          %mo *
                        %mi G
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Id - \pi_{\mathcal{H}} = [d, d^* G]
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi ℋ
                      %annotation{:encoding => "application/x-tex"} \pi_{\mathcal{H}}
                  is the orthogonal projection on
