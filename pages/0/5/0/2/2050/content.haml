            %h6#theorem Theorem
            %p
              %strong (Nielsen–Schreier theorem)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
