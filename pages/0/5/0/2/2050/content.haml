            (see also
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/mathematics+presented+in+HoTT"} mathematics presented in HoTT
          %ul
            %li#Swan20
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Swan"}> Andrew Swan
              ,
              %em On the Nielsen-Schreier Theorem in Homotopy Type Theory
              (
              %a{:href => "https://arxiv.org/abs/2010.01187"}> arXiv:2010.01187
              )
