                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  such that the corresponding value of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
                  = succeed "," do
                    %a.maruku-ref{:href => "#SchurFunctor"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
