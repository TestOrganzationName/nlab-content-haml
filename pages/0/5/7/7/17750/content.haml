          %h2#idea Idea
          %p
            The concept of
            %em length
            of an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is akin to the concept of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{C} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            %a.existingWikiWord{:href => "/nlab/show/simple+object"} simple object
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of a vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %em length
            generalizes this concept, notably to
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          #FiniteLength.num_defn
            %h6#definition_2 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              %em Jordan-Hölder sequence
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/composition+series"} composition series
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              inclusions into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/zero+objects"} zero objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mi n
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    0 = X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X_{n-1} \hookrightarrow X_n = X
            %p
              such that at each stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_i/X_{i-1}
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi i
                          %mo −
                          %mn 1
                      %mo ↪
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} X_{i-1} \hookrightarrow X_i
              %a.existingWikiWord{:href => "/nlab/show/simple+object"} simple object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              If a Jordan-Hölder sequence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              exists at all, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is said to be of
              = succeed "." do
                %em finite length
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, def. 1.5.3
          #JordanHolderSequenceHasDefiniteLength.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Jordan-H%C3%B6lder+theorem"}> Jordan-Hölder theorem
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              has finite length according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiniteLength"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              have the same length
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, theorem 1.5.4
          #LengthOfAnObject.num_defn
            %h6#definition_3 Definition
            %p
              If an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              has finite length according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiniteLength"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              of any of its Jordan-Hölder sequences, which is uniquely defined according to prop.
              = succeed "," do
                %a.maruku-ref{:href => "#JordanHolderSequenceHasDefiniteLength"}
              %em length of the object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, def. 1.5.5
          %h2#properties Properties
          %h3#RelationToSchurFunctors Relation to Schur functors
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
            that are also
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/tensor+categories"} tensor categories
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
          %p
            This is a (considerable) generalization of the familiar fact that for every
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            there exists an
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} exterior power
            that vanishes,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \wedge^n V = 0
            (namely for all
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \gt dim(V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d,p)
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d+1)
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
            %a.maruku-ref{:href => "#LenghtOfObjectIsBounded"}
            below goes in the direction of establishing that in a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a.maruku-ref{:href => "#LenghtOfObjectIsBounded"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Deligne%27s+theorem+on+tensor+categories"} Deligne's theorem on tensor categories
          %p
            First we need to fix the precise meaning of “
            %a.existingWikiWord{:href => "/nlab/show/tensor+category"}> tensor category
            ”:
          #TensorCategory.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              an
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is an
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
                  \=
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                  (i.e.
                  = succeed "-linear)," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p such that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒜
                        %mo ×
                        %mi 𝒜
                        %mo ⟶
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \otimes \colon \mathcal{A} \times \mathcal{A} \longrightarrow \mathcal{A}
                  is
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi k
                            %mi Mod
                          %annotation{:encoding => "application/x-tex"} k Mod
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched
                      (i.e.
                      = succeed "-linear);" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi k
                            %annotation{:encoding => "application/x-tex"} k
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact
                %p in both arguments;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi End
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi k
                      %annotation{:encoding => "application/x-tex"} End(1) \simeq k
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  coincides with
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              Such a
              = succeed "-tensor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %em
                finitely
                = succeed "-generated" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
              if there exists an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} E \in \mathcal{A}
              such that every other object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              is a
              %a.existingWikiWord{:href => "/nlab/show/subquotient"} subquotient
              of a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/tensor+products"} tensor products
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %msup
                            %mo ⊗
                            %mi n
                    %annotation{:encoding => "application/x-tex"} E^{\otimes^n}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo ⊕
                              %mi i
                            %msup
                              %mi E
                              %mrow
                                %msup
                                  %mo ⊗
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ↪
                          %mtd
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo ⊕
                              %mi i
                            %msup
                              %mi E
                              %mrow
                                %msup
                                  %mo ⊗
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \underset{i}{\oplus} E^{\otimes^{n_i}}
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    X &amp;\hookrightarrow&amp; (\underset{i}{\oplus} E^{\otimes^{n_i}})/Q
                    }
                    \\,.
            %p
              Such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is called an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                \-generator
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, 0.1
            )
          #SubexponentialGrowth.num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %em subexponential growth
              if for every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is of length (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LengthOfAnObject"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are of length bounded by the corresponding powers of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒜
                    %munder
                      %mo ∃
                      %mrow
                        %mi N
                        %mo ∈
                        %mi ℕ
                    %munder
                      %mo ∀
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mspace{:width => "thickmathspace"}
                    %mi length
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mrow
                        %msup
                          %mo ⊗
                          %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msup
                      %mi N
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X \in \mathcal{A}}{\forall}
                    \\underset{N \in \mathbb{N}}{\exists}
                    \\underset{n \in \mathbb{N}}{\forall}
                    \\;
                    length(N^{\otimes^n}) \leq N^n
