            %p
              Observe that the sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo =
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
