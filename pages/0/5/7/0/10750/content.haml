                    %mo ⟶
                    %mi E
                    %msub
                      %mo ′
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n \;\colon\; E_n \longrightarrow E'_n
              of
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
