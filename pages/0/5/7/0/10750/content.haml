                    %mspace{:width => "thickmathspace"}
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge
                    \\coloneqq
                    \\otimes_{\mathbb{S}_{orth}}
                    \\;\colon\;
                    OrthSpec(Top_{cg}) \times OrthSpec(Top_{cg})
                    \\longrightarrow
                    OrthSpec(Top_{cg})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo ≔
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge
                    \\coloneqq
                    \\otimes_{\mathbb{S}_{sym}}
                    \\;\colon\;
                    SymSpec(Top_{cg}) \times SymSpec(Top_{cg})
                    \\longrightarrow
                    SymSpec(Top_{cg})
          %p In the next section we work out what these symmetric monoidal categories of orthogonal and of symmetric spectra look like more explicitly.
          %h5#SymmetricSpectra Symmetric and orthogonal spectra
          %p
            We now define
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            and
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            and their symmetric monoidal smash product. We proceed by giving the explicit definitions and then checking that these are equivalent to the abstract definition
            %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
            from above.
          %p
            %strong Literature.
            (
            = succeed "," do
              %a{:href => "#HoveyShipleySmith00"} Hovey-Shipley-Smith 00, section 1, section 2
            = succeed ")" do
              %a{:href => "#Schwede12"} Schwede 12, chapter I
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #SymmetricSpectrum.num_defn
            %h6#definition_19 Definition
            %p
              A topological
              %strong
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectrum"} symmetric spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  a sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi n
                        %mo ∈
                        %msubsup
                          %mi Top
                          %mi cg
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi n
                        %mo ∈
                        %mi ℕ
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{X_n  \in Top_{cg}^{\ast/}\;\vert\; n \in \mathbb{N}\}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              %li
                %p
                  a basepoint preserving continuous right
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Sigma(n)
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi n
                        %annotation{:encoding => "application/x-tex"} X_n
              %li
                %p
                  a sequence of morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi n
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo ⟶
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma_n \colon S^1 \wedge X_n  \longrightarrow X_{n+1}
            %p such that
            %ul
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n, k \in \mathbb{N}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi k
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo ≃
                        %msup
                          %mi S
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mover
                          %mo ⟶
                          %mrow
                            %mi id
                            %mo ∧
                            %msub
                              %mi σ
                              %mi n
                        %msup
                          %mi S
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo ≃
                        %msup
                          %mi S
                          %mrow
                            %mi k
                            %mo −
                            %mn 2
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                        %mover
                          %mo ⟶
                          %mrow
                            %mi id
                            %mo ∧
                            %msub
                              %mi σ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mi ⋯
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi σ
                              %mrow
                                %mi n
                                %mo +
                                %mi k
                                %mo −
                                %mn 1
                        %msub
