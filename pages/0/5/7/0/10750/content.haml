                      %mi stable
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{stable}
              are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ConditionsForQuillenAdjunctionAreIndeedEquivalent"}> prop.
              ) via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ≃
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ℝ
                          %msup
                            %mi seq
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %mi 𝕃
                          %msub
                            %mi seq
                            %mo !
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho( OrthSpec(Top_{cg})_{stable} )
                    \\underoverset
                    {\underset{\mathbb{R}seq^\ast}{\longrightarrow}}
                    {\overset{\mathbb{L}seq_!}{\longleftarrow}}
                    {\simeq}
                    Ho( SeqSpec(Top_{cg})_{stable} )
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})_{stable}
              is a
              %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableModelStructureOnSequentiaSpectraIsStableModelCategory"}> thm.
              ) in that the derived suspension looping adjunction is an equivalence of categories, and and since this is a condition only on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msup
                      %mi seq
                      %mi ast
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}seq^ast
              manifestly preserves the construction of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalences"} adjoint equivalences
              of homotopy categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi SeqSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi cg
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi stable
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ≃
                              %munder
                                %mo ⟶
                                %mi Ω
                              %mover
                                %mo ⟵
                                %mi Σ
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi SeqSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi cg
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi stable
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝕃
                                  %msub
                                    %mi seq
                                    %mo !
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℝ
                                  %msup
                                    %mi seq
                                    %mo *
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝕃
                                  %msub
                                    %mi seq
                                    %mo !
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℝ
                                  %msup
                                    %mi seq
                                    %mo *
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi OrthSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi cg
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi stable
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ≃
                              %munder
                                %mo ⟶
                                %mi Ω
                              %mover
                                %mo ⟵
                                %mi Σ
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi OrthSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi cg
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi stable
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Ho(SeqSpec(Top_{cg})_{stable})
                    \&amp;
                    \\underoverset
                    {\underset{\Omega}{\longrightarrow}}
                    {\overset{\Sigma}{\longleftarrow}}
                    {\simeq}
                    \&amp;
                    Ho(SeqSpec(Top_{cg})_{stable})
                    \\\
                    {}^{\mathllap{\mathbb{L} seq_!}}\downarrow \simeq \uparrow^{\mathrlap{\mathbb{R}seq^\ast}}
                    \&amp;&amp;
                    {}^{\mathllap{\mathbb{L} seq_!}}\downarrow \simeq \uparrow^{\mathrlap{\mathbb{R}seq^\ast}}
                    \\\
                    Ho( OrthSpec(Top_{cg})_{stable} )
                    \&amp;
                    \\underoverset
                    {\underset{\Omega}{\longrightarrow}}
                    {\overset{\Sigma}{\longleftarrow}}
                    {\simeq}
                    \&amp;
                    Ho( OrthSpec(Top_{cg})_{stable} )
                    }
            %p
              and so in particular also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{stable}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            %p
              Due to the vertical equivalences here we will usually not distinguish between these homotopy categories and just speak of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"}> def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
