          .proof
            %h6#proof_63 Proof
            %p
              It is sufficient to prove this for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
