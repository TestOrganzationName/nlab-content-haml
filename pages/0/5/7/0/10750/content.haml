                  from def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#TopologicalDayConvolutionProduct"}
                %p
                  called the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
                  for the model of pre-excisive functors;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  the dual operation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi Day
                      %annotation{:encoding => "application/x-tex"} [-,-]_{Day}
                  from prop.
