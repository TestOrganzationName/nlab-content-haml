              %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
              given by assigning
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                    %mspace{:width => "thickmathspace"}
