              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modules+over+monoidal+functors"} modules over monoidal functors
          #PullbackAlongLaxMonoidalFunctorPreservesMonoidsForDayConvolution.num_prop
            %h6#proposition_16 Proposition
            %p
