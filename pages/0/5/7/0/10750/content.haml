                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X^{seq})_n \coloneqq X(seq(n)) = X(S^n)
            %p and whose structure maps are the images of the action morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi X
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
