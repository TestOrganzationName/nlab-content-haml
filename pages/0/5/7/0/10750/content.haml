                                %mi N
                                %mn 1
                              %mo ⊗
                              %msub
                                %mi ρ
                                %mn 2
                        %msub
                          %mi N
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi N
                          %mn 1
                        %mover
