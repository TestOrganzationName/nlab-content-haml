            %p and then take the unit maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi U
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S^n \longrightarrow (M U)_n = Maps(S^n , \overline{M U}_n)
            %p
              to be the
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              of the canonical embeddings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %msup
                          %mi ℂ
                          %mi n
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %msub
                      %mo ∧
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi S
                      %mrow
                        %msup
                          %mi ℂ
                          %mi n
                    %mo ⟶
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %msub
                      %mo ∧
                      %mrow
