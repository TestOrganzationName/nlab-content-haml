              %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E Mod(SymSpec(Top_{cg}))
                    \\;\simeq\;
                    E Mod( [Sym,Top^{\ast/}_{cg}], \otimes_{Day}, y(0) )
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Orth
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E Mod(OrthSpec(Top_{cg}))
                    \\;\simeq\;
                    E Mod( [Orth, Top^{\ast/}_{cg}], \otimes_{Day}, y(0) )
                    \\,,
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
          .proof
            %h6#proof_24 Proof
            %p
              The proof is directly analogous to that of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#RingSpectraAreDayMonoids"}
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              and prop.
              %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
              give that the module objects in question are equivalently
              %a.existingWikiWord{:href => "/nlab/show/modules+over+a+monoidal+functor"} modules over a monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModuleOverAMonoidalFunctor"}
          %h5#as_diagram_spectra As diagram spectra
          %p
            In
            %em
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-1"} Introduction to Stable homotopy theory – 1-1
            we obtained the strict/level
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+sequential+spectra"} model structure on topological sequential spectra
            by identifying the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SeqSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
            of
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            with a category of
            %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
            with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SequentialSpectraAsDiagramSpectra"}> prop.
            ) and then invoking the general existence of the
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+functors"} projective model structure on functors
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ProjectiveModelStructureOnTopologicalFunctors"}> thm.
            ).
          %p
            Here we discuss the analogous construction for the more general structured spectra from
            = succeed "." do
              %a{:href => "#SModules"} above
          #ModulesForDayConvolutionAsEnrichedFunctors.num_prop
            %h6#proposition_23 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              be a
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mon([\mathcal{C},Top^{\ast/}_{cg}],\otimes_{Day}, y(1_{\mathcal{C}}))
              be a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              monoidal category over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#DayConvolutionYieldsMonoidalCategoryStructure"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of left A-modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              category (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctorsToTopk"}> exmpl.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi A
                    %msub
                      %mi Free
                      %mi 𝒞
                    %msup
                      %mi Mod
                      %mi op
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A Mod
                    \\;\simeq\;
                    [ A Free_{\mathcal{C}}Mod^{op}, \; Top_{cg}^{\ast/} ]
                    \\,,
            %p
              over the category of
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidModuleOverItself"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (under the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} y \colon \mathcal{C}^{op} \to [\mathcal{C}, Top^{\ast/}_{cg}]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mi Free
                      %mi 𝒞
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Free_{\mathcal{C}}Mod
              are identified with those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mi Free
                      %mi 𝒞
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A Free_{\mathcal{C}}Mod( c_1, c_2)
                    \\;=\;
                    A Mod( A \otimes_{Day} y(c_1),\; A \otimes_{Day} y(c_2) )
                    \\,.
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, theorem 2.2
            )
          .proof
            %h6#proof_25 Proof
            %p
              Use the identification from prop.
              %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with a
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              and of any
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              as a functor with the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/module+over+a+monoidal+functor"} module over a monoidal functor
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi c
                              %mn 1
                            %mo ,
                            %msub
                              %mi c
                              %mn 2
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(c_1)\otimes N(c_2) \overset{\rho_{c_1,c_2}}{\longrightarrow} N(c_1 \otimes c_2)
                    \\,.
            %p
              Notice that these transformations have just the same structure as those of the
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functoriality
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctor"}> def.
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(c_1,c_2) \otimes N(c_1) \overset{}{\longrightarrow} N(c_2)
                    \\,.
            %p Hence we may unify these two kinds of transformations into a single kind of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 3
                    %mo ⊗
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ⊗
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi c
                              %mn 3
                            %mo ,
                            %msub
                              %mi c
                              %mn 1
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 3
                    %mo ⊗
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 3
                    %mo ⊗
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(c_3 \otimes c_1 , c_2)
                    \\otimes
                    A(c_3)
                    \\otimes
                    N(c_1)
                    \\overset{id \otimes \rho_{c_3,c_1}}{\longrightarrow}
                    \\mathcal{C}(c_3 \otimes c_1, c_2)
                    \\otimes
                    N(c_3 \otimes c_2)
                    \\longrightarrow
                    N(c_2)
            %p and subject to certain identifications.
            %p
              Now observe that the hom-objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mi Free
                      %mi 𝒞
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Free_{\mathcal{C}}Mod
              have just this structure:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mi Free
                              %mi 𝒞
                            %mi Mod
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo ,
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi A
                            %mi Mod
                            %mo{:stretchy => "false"} (
                            %mi A
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi 𝒞
                            %mo ,
                            %msubsup
                              %mi Top
                              %mi cg
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi A
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mover
                              %mo ∫
                              %mrow
                                %msub
                                  %mi c
                                  %mn 3
                                %mo ,
                                %msub
                                  %mi c
                                  %mn 4
                            %mi 𝒞
