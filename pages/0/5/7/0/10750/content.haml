              is represented by the orthogonal sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo =
                    %msubsup
                      %mi Σ
                      %mi orth
                      %mn ∞
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth} = \Sigma^\infty_{orth} S^0
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi orth
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_{orth}
              is a left Quillen functor (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuspensionSpectrumStructuredStrictQuillenAdjunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
