                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} N_1
              %li
                %p
                  the
                  %strong function module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi hom
                          %mi A
