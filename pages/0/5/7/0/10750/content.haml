          #SequentialSpectraAsFunctorsOnFreeSSequModules.num_example
            %h6#example_15 Example
            %p
              For the sequential case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dia
                    %mo =
                    %mi Seq
                  %annotation{:encoding => "application/x-tex"} Dia = Seq
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              on objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Seq
                  %annotation{:encoding => "application/x-tex"} Seq
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
              (
              %a{:href => "Introduction+to+stable+homotopy+theory+--+1-1#StandardRepresentativeOfTheSphereSpectrum"}> def.
              ) is identified as the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} StdSpheres
              (
              %a{:href => "Introduction+to+stable+homotopy+theory+--+1-1#CategoriesOfStandardSpheres"}> def.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                    %msub
                      %mi Free
                      %mi seq
                    %msup
                      %mi Mod
                      %mi op
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{seq} Free_{seq}Mod^{op}
                    \\;\simeq\;
                    StdSpheres
            %p
              Accordingly, in this case prop.
              %a.maruku-ref{:href => "#ModulesForDayConvolutionAsEnrichedFunctors"}
              reduces to the identification (
              %a{:href => "Introduction+to+stable+homotopy+theory+--+1-1#SequentialSpectraAsDiagramSpectra"}> prop.
              ) of
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              as topological diagrams over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi StdSpheres
                    %annotation{:encoding => "application/x-tex"} StdSpheres
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi 𝕊
                      %mi seq
                    %msub
                      %mi Free
                      %mi seq
                    %msup
                      %mi Mod
                      %mi op
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi StdSpheres
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [ \mathbb{S}_{seq} Free_{seq}Mod^{op}, Top^{\ast/}_{cg} ]
                    \\simeq
                    [StdSpheres, Top^{\ast/}_{cg}]
                    \\simeq
                    SeqSpec(Top_{cg})
                    \\,.
          .proof
            %h6#proof_26 Proof
            %p
              There is one object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(n)
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.maruku-ref{:href => "#ModulesForDayConvolutionAsEnrichedFunctors"}
              we compute the
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              between these to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mi Free
                              %mi seq
                            %mi Mod
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %msub
                              %mi y
                              %mrow
                                %msub
                                  %mi k
                                  %mn 2
                            %mo ,
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %msub
                              %mi y
                              %mrow
                                %msub
                                  %mi k
                                  %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mover
                              %mo ∫
                              %mi n
                            %mi Seq
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %msub
                              %mi k
                              %mn 1
                            %mo ,
                            %msub
                              %mi k
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msub
                              %mi 𝕊
                              %mi seq
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi S
                                        %mrow
                                          %msub
                                            %mi k
                                            %mn 2
                                          %mo −
                                          %msub
                                            %mi k
                                            %mn 1
                                    %mtd
                                      %mi if
                                      %mspace{:width => "thickmathspace"}
                                      %msub
                                        %mi k
                                        %mn 2
                                      %mo ≥
                                      %msub
                                        %mi k
                                        %mn 1
                                  %mtr
                                    %mtd
                                      %mo *
                                    %mtd
                                      %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbb{S}_{seq} Free_{seq}Mod(
                    \\mathbb{S}_{seq} \otimes_{Day} y_{k_2}
                    ,
                    \\mathbb{S}_{seq} \otimes_{Day} y_{k_1}
                    )
                    \&amp;
                    \\simeq
                    \\overset{n}{\int} Seq(n + k_1 , k_2) \wedge \mathbb{S}_{seq}(n)
                    \\\
                    \&amp;
                    \\simeq
                    \\left\{
                    \\array{
                    S^{k_2-k_1} &amp; if \; k_2 \geq k_1
                    \\\
                    \\ast &amp; otherwise
                    }
                    \\right.
                    \\end{aligned}
                    \\,.
            %p
              These are the objects and hom-spaces of the category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi StdSpheres
                    %annotation{:encoding => "application/x-tex"} StdSpheres
          %h5#stable_weak_homotopy_equivalences Stable weak homotopy equivalences
          %p
            We consider the evident version of
            %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalences"} stable weak homotopy equivalences
            for
            %a.existingWikiWord{:href => "/nlab/show/structured+spectra"} structured spectra
            and prove a few technical lemmas about them that are needed in the proof of the stable model structure
            %a{:href => "#MonoidalStableModelStructure."} below
          #StableOrthStructureClassesOfMorphisms.num_defn
            %h6#definition_24 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dia
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mi Orth
                    %mo ,
                    %mi Sym
                    %mo ,
                    %mi Seq
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Dia \in \{Top^{\ast/}_{cg,fin}, Orth, Sym, Seq\}
              one of the shapes of structured spectra from def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod
              be the corresponding category of structured spectra (def.
              = succeed "," do
                %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
              = succeed "," do
                %a.maruku-ref{:href => "#SseqModulesAreSequentialSpectra"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
                  of an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} X \in \mathbb{S}_{dia}Mod
                  are those of the underlying sequential spectrum (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGroups"}> def.
                  ):
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi seq
                          %mo *
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_\bullet(X) \coloneqq \pi_\bullet(seq^\ast X)
                        \\,.
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} X \in \mathbb{S}_{dia}Mod
                  is a
                  %strong
                    structured
                    %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
                  if the underlying
                  %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi seq
                          %mo *
                        %mi X
                      %annotation{:encoding => "application/x-tex"} seq^\ast X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
                  %a.existingWikiWord{:href => "/nlab/show/Omega+spectrum"} Omega spectrum
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#OmegaSpectrum"}> def.
                  )
              %li
                %p
                  A morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod
                  is a
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  (or:
                  = succeed ")" do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi π
                              %mo •
                          %annotation{:encoding => "application/x-tex"} \pi_\bullet
                      \-isomorphism
                  %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi seq
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} seq^\ast(f)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  of sequential spectra (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableWeakHomotopyEquivalenceOfSequentialTopologicalSpectra"}> def.
                  );
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %strong stable cofibration
                  if it is a cofibration in the strict model structure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi OrthSpec
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Top
                          %mi cg
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi strict
                      %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{strict}
                  from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, def. 8.3 with the notation from p. 21
            ,
            = succeed ")" do
              %a{:href => "#May02"} Mandell-May 02, III, def. 3.1, def. 3.2
          #DegreewiseLESofHomotopyGroupsInducedStableLES.num_lemma
            %h6#lemma_4 Lemma
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\;\colon\; X \longrightarrow Y
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi dia
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
              of
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StableOrthStructureClassesOfMorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Path
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mo *
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Path
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    \\pi_{\bullet + 1}(Y)
                    \\overset{}{\longrightarrow}
                    \\pi_\bullet(Path_\ast(f))
                    \\overset{}{\longrightarrow}
                    \\pi_\bullet(X)
                    \\overset{f_\ast}{\longrightarrow}
                    \\pi_\bullet(Y)
                    \\longrightarrow
                    \\pi_{\bullet-1}(Path_\ast(f))
                    \\longrightarrow
                    \\cdots
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mo *
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
