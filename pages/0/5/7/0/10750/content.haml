                    \\\
                    SeqSpec(Top_{cg})_{strict}
                    \&amp;
                    \\underoverset
                    {\underset{\Omega}{\longrightarrow}}
                    {\overset{\Sigma}{\longleftarrow}}
                    {\bot}
                    \&amp;
