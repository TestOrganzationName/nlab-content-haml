                                %mo *
                                %mo{:stretchy => "false"} /
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi Quillen
                          %mtd
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mi Ω
                              %mover
                                %mo ⟵
                                %mi Σ
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Top
                              %mi cg
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi Quillen
                        %mtr
