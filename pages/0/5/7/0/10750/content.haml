            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of symmetric
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectra"} commutative ring spectra
            %p
              We regard a symmetric ring spectrum in particular as a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectrum"} symmetric spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricSpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi E
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ι
                          %mn 1
                        %mo ∧
                        %mi id
                    %msub
                      %mi E
                      %mn 1
                    %mo ∧
                    %msub
                      %mi E
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi μ
                          %mrow
                            %mn 1
                            %mo ,
                            %mi n
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_n
                    \\;\colon\;
                    S^1 \wedge E_n
                    \\overset{\iota_1 \wedge id}{\longrightarrow}
                    E_1 \wedge E_n
                    \\overset{\mu_{1,n}}{\longrightarrow}
                    E_{n+1}
                    \\,.
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CRing(SymSpec(Top_{cg}))
                    \\longrightarrow
                    SymSpec(Top_{cg})
            %p
              There is an analogous definition of
              %strong
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectrum"} orthogonal ring spectrum
              and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CRing(OrthSpec(Top_{cg}))
            %p for the category that these form.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Schwede12"} Schwede 12, def. 1.3
          %p
            We discuss
            %strong examples
            below in a dedicated section
            = succeed "." do
              %em
                %a{:href => "#Examples"} Examples
          #RingSpectraAreDayMonoids.num_prop
            %h6#proposition_21 Proposition
            %p
              The symmetric (orthogonal)
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectra"} commutative ring spectra
              in def.
              %a.maruku-ref{:href => "#RingSpectrumInSymmetricAndOrthogonalSpectra"}
              are equivalently the
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoids in
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}Mod
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}Mod
              ) of def.
              %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo =
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                  %annotation{:encoding => "application/x-tex"} \wedge = \otimes_{\mathbb{S}_{sym}}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ∧
                    %mo =
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                  %annotation{:encoding => "application/x-tex"} \wedge = \otimes_{\mathbb{S}_{orth}}
              ). Hence there are
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CRing(SymSpec(Top_{cg}))
                    \\;\simeq\;
                    CMon( \mathbb{S}_{sym}Mod, \otimes_{\mathbb{S}_{sym}}, \mathbb{S}_{sym} )
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CRing(OrthSpec(Top_{cg}))
                    \\;\simeq\;
                    CMon( \mathbb{S}_{orth}Mod, \otimes_{\mathbb{S}_{orth}}, \mathbb{S}_{orth} )
                    \\,.
            %p Moreover, under these identifications the canonical forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CMon( \mathbb{S}_{sym}Mod, \otimes_{\mathbb{S}_{sym}}, \mathbb{S}_{sym} )
                    \\longrightarrow
                    SymSpec(Top_{cg})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CMon( \mathbb{S}_{orth}Mod, \otimes_{\mathbb{S}_{orth}}, \mathbb{S}_{orth} )
                    \\longrightarrow
                    OrthSpec(Top_{cg})
            %p
              coincides with the forgetful functor defined in def.
              = succeed "." do
                %a.maruku-ref{:href => "#RingSpectrumInSymmetricAndOrthogonalSpectra"}
          .proof
            %h6#proof_23 Proof
            %p We discuss this for symmetric spectra. The proof for orthogonal spectra is directly analogous.
            %p
              By prop.
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              and def.
              = succeed "," do
                %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}Mod
              are equivalently commtutative monoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ([Sym,Top^{\ast/}_{cg}], \otimes_{Day}, y(0))
              equipped with a homomorphism of monoids
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi sym
                      %mo ⟶
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym} \longrightarrow E
              %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
              this are equivalently braided lax monoidal functors (which we denote by the same symbols, for convenience) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi Sym
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mo ∧
                    %mo ,
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E \;\colon\; (Sym, +, 0) \longrightarrow (Top^{\ast/}_{cg}, \wedge, S^0)
            %p
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformation"} monoidal natural transformation
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \;\colon\; \mathbb{S}_{sym} \longrightarrow E
                    \\,.
            %p
              The structure morphism of such a lax monoidal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has as components precisely the morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo ,
                          %msub
                            %mi n
                            %mn 2
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ∧
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo →
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \mu_{n_1, n_2}\colon E_{n_1} \wedge E_{n_2} \to E_{n_1 + n_2}
            %p
              Moreover, by the proof of prop.
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              the
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi sym
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi sym
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has action given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mo ∧
                    %mi E
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ∧
                        %mi id
                    %mi E
                    %mo ∧
                    %mi E
                    %mover
                      %mo ⟶
                      %mi μ
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{sym} \wedge E
                    \\overset{e \wedge id}{\longrightarrow}
                    E \wedge E
                    \\overset{\mu}{\longrightarrow}
                    E
                    \\,,
            %p
              which shows, via the identification in prop
              = succeed "," do
                %a.maruku-ref{:href => "#DiagramSpectraGiveSymmetricAndOrthogonalSpectra"}
            %p
              Hence it only remains to match the nature of the units. The above unit morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              has components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo ⟶
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_n \;\colon\; S^n \longrightarrow E_n
            %p
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \iota_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \iota_1
              is manifestly as in the statement above.
            %p We claim that the other components are uniquely fixed by these:
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FSPStructuredSphereSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
              is by isomorphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ≃
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{n_1} \wedge S^{n_2} \simeq S^{n_1 + n_2}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformation"} monoidal natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo ∧
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                      %mo ,
                                      %msub
                                        %mi n
                                        %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi n
                                      %mn 2
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n_1} \wedge S^{n_2}
                    \&amp;\overset{\iota_{n_1} \wedge \iota_{n_2}}{\longrightarrow}&amp;
                    E_{n_1} \wedge E_{n_2}
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\mu_{n_1, n_2}}}
                    \\\
                    S^{n_1 + n_2}
                    \&amp;\underset{\iota_{n_1 + n_2}}{\longrightarrow}&amp;
                    E_{n_1 + n_2}
                    }
            %p
              says that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
