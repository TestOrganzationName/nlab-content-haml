              = succeed "." do
                %a.maruku-ref{:href => "#FSPExcisiveSphere"}
          #SseqModulesAreSequentialSpectra.num_prop
            %h6#proposition_18 Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi seq
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi seq
                    %mi Mod
                    %mover
                      %mo ⟶
                      %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{seq}
                    \\;\colon\;
                    \\mathbb{S}_{seq} Mod
                    \\overset{}{\longrightarrow}
                    SeqSpec(Top_{cg})
            %p
              which identifies the
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#RestrictionsOfExcisiveSphere"}
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              monoidal structure (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DayConvolutionYieldsMonoidalCategoryStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Seq
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [Seq,Top^{\ast/}_{cg}]
              from def.
              %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              with the category of
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#SequentialSpectra"}> def.
              )
            %p
              Under this equivalence, an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is taken to the sequential pre-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} X^{seq}
              whose component spaces are the values of the
              %a.existingWikiWord{:href => "/nlab/show/pre-excisive+functor"} pre-excisive functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              on the standard
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∧
