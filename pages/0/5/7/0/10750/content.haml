                                      %mo ,
                                      %msub
                                        %mi n
                                        %mn 2
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi μ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                                    %mo ,
