              two pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
              %a.existingWikiWord{:href => "/nlab/show/end"} end
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
