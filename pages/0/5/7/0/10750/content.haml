            (
            %a{:href => "#Schwede12"}> Schwede 12, p. 82
            )
          #AbstractFormulaGivesSmashProductOfSymmetricSpectra.num_prop
            %h6#proposition_20 Proposition
            %p
              Under the identification of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DiagramSpectraGiveSymmetricAndOrthogonalSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              in def.
              %a.maruku-ref{:href => "#SmashProductOfSymmetricSpectra"}
              is equivalent to the abstractly defined tensor product in def.
              = succeed ":" do
                %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
            %p
              in the case of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo ≃
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge \simeq \otimes_{\mathbb{S}_{sym}}
            %p
              in the case of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo ≃
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge \simeq \otimes_{\mathbb{S}_{orth}}
                    \\,.
          %p
            (
            %a{:href => "#Schwede12"}> Schwede 12, E.1.16
            )
          .proof
            %h6#proof_22 Proof
            %p
              By def.
              %a.maruku-ref{:href => "#TensorProductOfModulesOverCommutativeMonoidObject"}
              the abstractly defined tensor product of two
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi sym
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ⊗
                      %mi Day
                    %msub
                      %mi 𝕊
                      %mi sym
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi Y
                    %munderover
                      %mphantom
                        %mi AAAA
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ρ
                            %mn 1
                          %mo ∘
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi τ
                            %mrow
                              %mi X
                              %mo ,
                              %msub
                                %mi 𝕊
                                %mi sym
                            %mi Day
                          %mo ⊗
                          %mi id
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %mi X
                          %mo ⊗
                          %msub
                            %mi ρ
                            %mn 2
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mover
                      %mo ⟶
                      %mi coeq
                    %mi X
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi sym
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \otimes_{Day} \mathbb{S}_{sym} \otimes_{Day} Y
                    \\underoverset
                    {\underset{\rho_{1}\circ (\tau^{Day}_{X, \mathbb{S}_{sym}} \otimes id)}{\longrightarrow}}
                    {\overset{X \otimes \rho_2}{\longrightarrow}}
                    {\phantom{AAAA}}
                    X \otimes Y
                    \\overset{coeq}{\longrightarrow}
                    X \otimes_{\mathbb{S}_{sym}} Y
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              product appearing here is over the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              %a.maruku-ref{:href => "#CoendGivesQuotientByDiagonalGroupAction"}
              and unwinding the definitions, this is for any two symmetric spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
