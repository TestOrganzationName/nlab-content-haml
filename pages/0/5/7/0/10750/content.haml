                    \&amp;&amp;\overset{\tau_{\Sigma^{n_1}\mathbb{S}, \Sigma^{n_2}\mathbb{S}}}{\longrightarrow}&amp;&amp;
                    \\Sigma^{n_2}\mathbb{S} \wedge \Sigma^{n_1}\mathbb{S}
                    \\\
                    {}^{\mathllap{\alpha_1 \wedge \alpha_2}}\downarrow
                    \&amp;&amp; &amp;&amp;
                    \\downarrow^{\mathrlap{\alpha_2 \wedge \alpha_1}}
                    \\\
                    E \wedge E
                    \&amp;&amp;\overset{\tau_{E,E}}{\longrightarrow}&amp;&amp;
                    E \wedge E
                    \\\
                    \&amp; {}_{\mathllap{\mu}}\searrow
                    \&amp;&amp;
                    \\swarrow_{\mathrlap{\mu}}
                    \\\
                    \&amp;&amp; E
                    }
                    \\,.
            %p
              Here the top square is that of lemma
              %a.maruku-ref{:href => "#GradedCommutativityOfSuspendedSphereSpectra"}
              (part of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              structure of prop.
              = succeed "))," do
                %a.maruku-ref{:href => "#TensorTriangulatedStructureOnStableHomotopyCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mu,e)
              being a commutative monoid (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            %p Similarly given
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi 𝕊
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;\colon\;
                    \\Sigma^{n-1}\mathbb{S}
                    \\longrightarrow
                    E
            %p as before and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi 𝕊
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\nu
                    \\;\colon\;
                    \\Sigma^{n_2}\mathbb{S}
                    \\longrightarrow
                    E \wedge X
                    \\,,
            %p then an action is defined by the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ⋅
                    %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mi 𝕊
                    %mo ∧
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mrow
                        %mi α
                        %mo ∧
                        %mi ν
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mi μ
                        %mo ∧
                        %mi id
                    %mi E
                    %mo ∧
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \cdot \nu
                    \\;\colon\;
                    \\Sigma^{n_1 + n_2}\mathbb{S}
                    \\overset{\simeq}{\longrightarrow}
                    \\Sigma^{n_1} \mathbb{S} \wedge \Sigma^{n_2}\mathbb{S}
                    \\overset{\alpha \wedge \nu}{\longrightarrow}
                    E \wedge E \wedge X
                    \\overset{\mu\wedge id}{\longrightarrow}
                    E \wedge X
                    \\,.
            %p
              This is clearly a graded pairing, and the action property and unitality follow directly from the associativity and unitality, respectively, of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi μ
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mu,e)
            %p
              Analogously for the right action on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X_\bullet(E)
          #StableStemsRingStructure.num_example
            %h6#example_16 Example
            %p
              %strong (ring structure on the stable homotopy groups of spheres)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo =
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{S} = \gamma(\mathbb{S}_{orth})
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HomotopyCommutativeRingSpectrum"}
            %p
              On the one hand this is because it is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              for the derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              (by cor.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
              %a.maruku-ref{:href => "#MonoidGivenByTensorUnit"}
              every such is canonically a (commutative) monoid. On the other hand we have the explicit representation by the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectrum"} orthogonal ring spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RingSpectrumInSymmetricAndOrthogonalSpectra"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi orth
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
              = succeed "," do
                %a.maruku-ref{:href => "#FSPStructuredSphereSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              (prop.
              = succeed "," do
                %a.maruku-ref{:href => "#LaxMonoidalLocalizationOfMonoidalModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              on cofibrant objects such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
              according to prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalStructureOnHomotopyCategoryOfMonoidalModelCategory"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MonoidsPreservedByLaxMonoidalFunctor"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              are of course the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGroupsOfSpheres"}> exmpl.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mo •
                      %mi s
                    %mo ≔
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi^s_\bullet
                    \\coloneqq
                    \\pi_\bullet(\mathbb{S})
                    \\simeq
                    \\underset{\longrightarrow}{\lim}_k \pi_{\bullet+k}(S^k)
                    \\,.
            %p
              Now prop.
              %a.maruku-ref{:href => "#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}
              gives the stable homotopy groups of spheres the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mi 𝕊
                    %mo ⟶
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \alpha_i \colon \Sigma^{n_i}\mathbb{S} \longrightarrow \mathbb{S}
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mi 𝕊
                    %mo ∧
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                        %mo ∧
                        %msub
                          %mi α
                          %mn 2
                    %mi 𝕊
                    %mo ∧
                    %mi 𝕊
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msup
                          %mi μ
                          %mi 𝕊
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^{n_1 + n_2} \mathbb{S}
                    \\overset{\simeq}{\longrightarrow}
                    \\Sigma^{n_1} \mathbb{S}
                    \\wedge
                    \\Sigma^{n_2} \mathbb{S}
                    \\overset{\alpha_1 \wedge \alpha_2}{\longrightarrow}
                    \\mathbb{S} \wedge \mathbb{S}
                    \\underoverset{\simeq}{\mu^{\mathbb{S}}}{\longrightarrow}
                    \\mathbb{S}
                    \\,,
            %p
              where now not only the first morphism, but also the last morphism is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (the isomorphism from lemma
              = succeed ")." do
                %a.maruku-ref{:href => "#kel1"}
              %em is
              the derived smash product of spectra.
            %p
              This implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in Ho(Spectra)
              any two spectra, then the
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
              ) of morphisms from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              canonically becomes a
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mo •
                      %mi s
                  %annotation{:encoding => "application/x-tex"} \pi^s_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mo •
                      %mi s
                    %mo ⊗
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet^s \otimes [X,Y]_\bullet
                    \\longrightarrow
                    [X,Y]_\bullet
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mi 𝕊
                    %mover
                      %mo →
                      %mi α
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi Σ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                      %mi X
                      %mover
                        %mo →
                        %mo ≃
                      %msup
                        %mi Σ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mi 𝕊
                      %mo ∧
                      %msup
                        %mi Σ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mi α
                          %mo ∧
                          %mi f
                      %mi 𝕊
                      %mo ∧
                      %mi Y
                      %mover
                        %mo →
                        %mo ≃
                      %mi Y
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Sigma^{n_1} \mathbb{S} \overset{\alpha}{\to} \mathbb{S}),
                    (\Sigma^{n_2} X \overset{f}{\to} Y)
                    \\;\mapsto\;
                    \\left(
                    \\Sigma^{n_1 + n_2} X
                    \\overset{\simeq}{\to}
                    \\Sigma^{n_1}\mathbb{S}\wedge \Sigma^{n_2} X
                    \\overset{\alpha \wedge f}{\longrightarrow}
                    \\mathbb{S} \wedge Y
                    \\overset{\simeq}{\to}
                    Y
                    \\right)
                    \\,.
            %p
              In particular for every spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \in Ho(Spectra)
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi 𝕊
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(X)\simeq [\mathbb{S}, X]_\bullet
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGrouspAsHomsOutOfSphereSpectrum"}> lemma
              ) canonically form a module over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mo •
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet^s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X = E
              happens to carry the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi π
                      %mo •
                      %mi s
                    %mo =
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(e)
                    \\;\colon\;
                    \\pi_\bullet^s = \pi_\bullet(\mathbb{S})
                    \\longrightarrow
                    \\pi_\bullet(E)
            %p
              under prop.
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}
            %p
              (It is straightforward to unwind all this categorical algebra to concrete component expressions by proceeding as in the proof of
              = succeed ").)" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGrouspAsHomsOutOfSphereSpectrum"} this lemma
          %p
            This finally allows to uniquely characterize the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            that we have been discussing:
          #CharacterizationOfStableHomotopyTheory.num_theorem
            %h6#theorem_6 Theorem
            %p
              %strong (Schwede-Shipley uniqueness theorem)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyCategoryOfAModelCategory"}> def.
              ) of every
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
