              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              ). For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
