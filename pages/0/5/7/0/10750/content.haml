          .proof
            %h6#proof_2 Proof
            %p
              A homomorphism out of a free
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi C
                    %mo ⟶
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; A\otimes C \longrightarrow N
            %p
              fitting into the diagram (where we are notationally suppressing the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi f
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi μ
                                  %mo ⊗
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A \otimes C
                    \&amp;\overset{A \otimes f}{\longrightarrow}&amp;
                    A \otimes N
                    \\\
                    {}^{\mathllap{\mu \otimes id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\rho}}
                    \\\
                    A \otimes C
                    \&amp;\underset{f}{\longrightarrow}&amp;
                    N
                    }
                    \\,.
            %p Consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi ℓ
                          %mi C
                    %mn 1
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ⊗
                        %mi id
                    %mi A
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mi f
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde f
                    \\;\colon\;
                    C
                    \\underoverset{\simeq}{\ell_C}{\longrightarrow}
                    1 \otimes C
                    \\overset{e\otimes id}{\longrightarrow}
                    A \otimes C
                    \\overset{f}{\longrightarrow}
                    N
                    \\,,
            %p
              i.e. the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to the unit “in”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form (where we are now notationally suppressing the
              %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              and the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ⊗
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mi e
                                  %mo ⊗
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ⊗
                                %mi f
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes C
                    \&amp;\overset{id \otimes \tilde f}{\longrightarrow}&amp;
                    A \otimes N
                    \\\
                    {}^{\mathllap{id \otimes e \otimes id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{=}}
                    \\\
                    A \otimes A \otimes C
                    \&amp;\underset{id \otimes f}{\longrightarrow}&amp;
                    A \otimes N
                    }
                    \\,.
            %p Pasting this square onto the top of the previous one yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ⊗
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mi e
                                  %mo ⊗
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi f
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi μ
                                  %mo ⊗
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes C
                    \&amp;\overset{id \otimes \tilde f}{\longrightarrow}&amp;
                    A \otimes N
                    \\\
                    {}^{\mathllap{id \otimes e \otimes id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{=}}
                    \\\
                    A \otimes A \otimes C
                    \&amp;\overset{A \otimes f}{\longrightarrow}&amp;
                    A \otimes N
                    \\\
                    {}^{\mathllap{\mu \otimes id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\rho}}
                    \\\
                    A \otimes C
                    \&amp;\underset{f}{\longrightarrow}&amp;
                    N
                    }
                    \\,,
            %p
              where now the left vertical composite is the identity, by the unit law in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is uniquely determined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              via the relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi ρ
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi A
                    %mo ⊗
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = \rho \circ (id_A \otimes \tilde f)
                    \\,.
            %p
              This natural bijection between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              establishes the adjunction.
          #TensorProductOfModulesOverCommutativeMonoidObject.num_defn
            %h6#definition_7 Definition
            %p
              Given a (pointed)
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topological
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu,e)
              a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N_1, \rho_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N_2, \rho_2)
              two left
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
              (def.
              %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}>
              ), then
            %ol
              %li
                %p
                  the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi N
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} N_1 \otimes_A N_2
                  is, if it exists, the
                  %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                        %mo ⊗
                        %mi A
                        %mo ⊗
                        %msub
                          %mi N
                          %mn 2
                        %munderover
                          %mphantom
                            %mi AAAA
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi ρ
                                %mn 1
                              %mo ∘
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi τ
                                %mrow
                                  %msub
                                    %mi N
                                    %mn 1
                                  %mo ,
                                  %mi A
                              %mo ⊗
                              %msub
                                %mi N
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mover
                            %mo ⟶
                            %mrow
