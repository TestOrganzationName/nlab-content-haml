                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    \\pi_{\bullet+1}(Y)
                    \\overset{}{\longrightarrow}
                    \\pi_{\bullet+1}(Cone(f))
                    \\overset{}{\longrightarrow}
