                    X
            %p
              under the isomorphism of corollary
              %a.maruku-ref{:href => "#DayConvolutionViaNaturalIsosInvolvingExternalTensorAndTensor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{seq}(n_1) \wedge X(n_1) \longrightarrow X_{n_1 + n_2}
            %p
              evaluated at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n_1 = 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi seq
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{S}_{seq}(1) \wedge X(n)
                    \&amp;\longrightarrow&amp;
                    X_{n+1}
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    S^1 \wedge X_n &amp;\longrightarrow&amp; X_{n+1}
                    }
                    \\,.
          %p
            (
            %a{:href => "#HoveyShipleySmith00"}> Hovey-Shipley-Smith 00, prop. 2.3.4
            )
          .proof
            %h6#proof_20 Proof
            %p After unwinding the definitions, the only point to observe is that due to the action property,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mi Day
                                %mi ρ
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi μ
                                  %msub
                                    %mo ⊗
                                    %mi Day
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi seq
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi ρ
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{S}_{seq} \otimes_{Day} \mathbb{S}_{seq} \otimes_{Day} X
                    \&amp;\overset{id \otimes_{Day} \rho}{\longrightarrow}&amp;
                    \\mathbb{S}_{seq} \otimes_{Day} X
                    \\\
                    {}^{\mathllap{\mu \otimes_{Day} id } }\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\rho}}
                    \\\
                    \\mathbb{S}_{seq} \otimes_{Day} X
                    \&amp;\underset{\rho}{\longrightarrow}&amp;
                    X
                    }
            %p
              any
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi seq
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi X
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\rho
                    \\;\colon\;
                    \\mathbb{S}_{seq} \otimes_{Day} X \longrightarrow X
            %p is indeed uniquely fixed by the components of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{seq}(1) \wedge X(n) \longrightarrow X(n)
                    \\,.
            %p
              This is because under corollary
              %a.maruku-ref{:href => "#DayConvolutionViaNaturalIsosInvolvingExternalTensorAndTensor"}
              the action property is identified with the componentwise property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 3
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ∧
                                %msub
                                  %mi ρ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                                    %mo ,
                                    %msub
                                      %mi n
                                      %mn 3
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                                %mo +
                                %msub
                                  %mi n
                                  %mn 3
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ρ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                      %mo ,
                                      %msub
                                        %mi n
                                        %mn 2
                                      %mo +
                                      %msub
                                        %mi n
                                        %mn 3
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 3
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ρ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi n
                                      %mn 2
                                    %mo ,
                                    %msub
                                      %mi n
                                      %mn 3
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                                %mo +
                                %msub
                                  %mi n
                                  %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n_1} \wedge S^{n_2} \wedge X_{n_3}
                    \&amp;\overset{id \wedge \rho_{n_2,n_3}}{\longrightarrow}&amp;
                    S^{n_1} \wedge X_{n_2 + n_3}
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\rho_{n_1,n_2+n_3}}}
                    \\\
                    S^{n_1 + n_2} \wedge X_{n_3}
                    \&amp;\underset{\rho_{n_1+n_2,n_3}}{\longrightarrow}&amp;
                    X_{n_1 + n_2 + n_3}
                    }
                    \\,,
            %p
              where the left vertical morphism is an isomorphism by the nature of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mrow
                        %mi n
                        %mo ′
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \rho_{n',n}
              to be the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} n'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mi n
                      %mo ≔
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sigma_n \coloneqq \rho(1,n)
          %p
            However, since, by remark
            = succeed "," do
              %a.maruku-ref{:href => "#SseqModulesAreSequentialSpectra"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi seq
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
            is not commutative, there is no tensor product induced on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SeqSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
            under the identification in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#SseqModulesAreSequentialSpectra"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi orth
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi sym
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
            are commutative monoids by remark
            = succeed "," do
              %a.maruku-ref{:href => "#SseqModulesAreSequentialSpectra"}
          #SsymModuleSymmetricSpectra.num_defn
            %h6#definition_18 Definition
            %p
              In the terminology of remark
              %a.maruku-ref{:href => "#RestrictionsOfExcisiveSphere"}
              we say that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    OrthSpec(Top_{cg})
                    \\coloneqq
                    \\mathbb{S}_{orth} Mod
            %p
              is the
              = succeed ";" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    SymSpec(Top_{cg})
                    \\coloneqq
                    \\mathbb{S}_{sym} Mod
            %p
              is the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            %p
              By remark
              %a.maruku-ref{:href => "#RestrictionsOfExcisiveSphere"}
              and by prop.
              %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
              these categories canonically carry a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                  %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{S}_{orth}}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi seq
                    %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{S}_{seq}}
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo ≔
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
