                    %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
            %p
              By lemma
              %a.maruku-ref{:href => "#ElementsOfKAreStableEquivalencesAndStrictCofibrations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_n \Box i_+
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} Cof_{strict}
              and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
