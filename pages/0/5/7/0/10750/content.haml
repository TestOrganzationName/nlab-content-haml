                            %mn ∞
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi Σ
                            %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\Sigma^\infty_{dia}
                    \\dashv
                    \\Omega^\infty_{dia})
                    \\;\colon\;
                    \\mathbb{S}_{dia}Mod(Top_{cg})_{strict}
                    \\underoverset
                    {\underset{seq^\ast}{\longrightarrow}}
                    {\overset{seq_!}{\longleftarrow}}
                    {\bot}
                    SeqSpec(Top_{cg})_{strict}
                    \\underoverset
                    {\underset{\Omega^\infty}{\longrightarrow}}
                    {\overset{\Sigma^\infty}{\longleftarrow}}
                    {\bot}
                    (Top^{\ast/}_{cg})
            %p
              where the Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi seq
                      %mo !
                    %mo ⊣
                    %msup
                      %mi seq
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (seq_! \dashv seq^\ast)
              is that from theorem
              %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo ⊣
                    %msup
                      %mi Ω
                      %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \dashv \Omega^\infty)
              is the suspension spectrum adjunction for sequential spectra (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SigmaInfinityIsQuillenOnStrictModelStructureOnSequential"}> prop.
              ).
          .proof
            %h6#proof_48 Proof
            %p
              By the very definition of the
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+functors"} projective model structure on functors
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ProjectiveModelStructureOnTopologicalFunctors"}> thm.
              ) it is immediate that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ev
                      %mi n
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} Ev_n^{dia}
              preserves fibrations and weak equivalences, hence it is a right Quillen functor.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi n
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} F^{dia}_n
              is its left adjoint by definition.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi dia
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_{dia}
              is a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              is part of the statement of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SmashProductOfFreeSpectra"}
            %p Moreover, it is clear from the definitions that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi dia
                      %mn ∞
                    %mo ≃
                    %msup
                      %mi Ω
                      %mn ∞
                    %mo ∘
                    %msup
                      %mi seq
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\infty_{dia} \simeq \Omega^\infty \circ seq^\ast
                    \\,,
            %p hence the last statement follows by uniqueness of adjoints.
          #SummarySituationForStrictModelStructure.num_remark
            %h6#remark_9 Remark
            %p
              In summary, we have established the following situation. There is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
