              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ∨
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V \wedge (X \vee Y)
              %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
              (or more explicitly by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AbstractFormulaGivesSmashProductOfSymmetricSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
