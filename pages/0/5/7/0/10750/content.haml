                              %mo ∘
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo ⊗
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mover
