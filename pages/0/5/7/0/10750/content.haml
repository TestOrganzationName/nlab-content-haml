                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}(G_+)
              for the pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              that has a single object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %a.existingWikiWord{:href => "/nlab/show/hom-space"} hom-space
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
