                              %mi dia
                            %msub
                              %mi Mod
                              %mi strict
                          %mtd
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi dia
                            %msub
                              %mi Mod
                              %mi strict
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (Top^{\ast/}_{cg})_{Quillen}
                    \&amp;
                    \\underoverset
                    {\underset{\Omega}{\longrightarrow}}
                    {\overset{\Sigma}{\longleftarrow}}
                    {\bot}
                    \&amp;
