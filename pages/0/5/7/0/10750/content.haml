                          %mtd
                            %mo ⊂
                            %msub
                              %mi W
                              %mi stable
                            %mo ∩
                            %msub
                              %mi Cof
                              %mi stable
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    I^{stable} \Box_{\otimes} J^{strict}
                    \&amp;=
                    I^{strict} \Box_{\otimes} J^{strict}
                    \\\
                    \&amp;\subset
                    W_{strict}\cap Cof_{strict}
                    \\\
                    \&amp; \subset
                    W_{stable} \cap Cof_{stable}
                    \\end{aligned}
            %p
              follows again from the monoidal stucture on the strict model category of theorem
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidalStrictModelStructure"}
            %p It hence remains to see that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mi strict
                    %msub
                      %mo □
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo □
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
