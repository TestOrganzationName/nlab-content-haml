                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})_{stable}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
