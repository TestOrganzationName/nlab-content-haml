                  %annotation{:encoding => "application/x-tex"} S^n = (S^1)^{\wedge n}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
