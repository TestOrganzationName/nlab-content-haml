                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c_1,c_2 \in \mathcal{C}
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (prop.
              = succeed ")" do
