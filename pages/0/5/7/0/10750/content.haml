                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \overline{n} \coloneqq \{1, \cdots,n\}
                  for
