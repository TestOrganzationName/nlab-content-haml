              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebras"} differential graded algebras
          #MonoidModuleOverItself.num_prop
            %h6#proposition_2 Proposition
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu, e)
              canonically becomes a left module over itself by setting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ≔
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \rho \coloneqq \mu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} C \in \mathcal{C}
              any object, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \otimes C
              naturally becomes a left
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi C
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msubsup
                          %mi a
                          %mrow
                            %mi A
                            %mo ,
                            %mi A
                            %mo ,
                            %mi C
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mrow
                        %mi μ
                        %mo ⊗
                        %mi id
                    %mi A
                    %mo ⊗
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho
                    \\;\colon\;
                    A \otimes (A \otimes C)
                    \\underoverset{\simeq}{a^{-1}_{A,A,C}}{\longrightarrow}
                    (A \otimes A) \otimes C
                    \\overset{\mu \otimes id}{\longrightarrow}
                    A \otimes C
                    \\,.
            %p
              The
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              constructing free
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              which sends a module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N,\rho)
              to the underlying object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi N
                    %annotation{:encoding => "application/x-tex"} U(N,\rho) \coloneqq N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mi F
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A Mod(\mathcal{C})
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{F}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
