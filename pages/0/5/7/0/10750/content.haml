                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
