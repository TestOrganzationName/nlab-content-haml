            %h6#proof_59 Proof
            %p
              In view of theorem
              %a.maruku-ref{:href => "#StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom"}
              this is a special case of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidalStructureOnHomotopyCategoryOfMonoidalModelCategory"}
          #EMHomology.num_remark
            %h6#remark_11 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A,X \in Ho(Spectra)
              be two spectra in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGroups"}> def.
              ) of their derived
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              (corollary
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_\bullet(X)
