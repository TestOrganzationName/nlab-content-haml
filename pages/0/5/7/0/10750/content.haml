                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    E_\bullet(E) \longrightarrow E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(E)
                    \\,;
            %ol
              %li
                %p
                  finally the
                  %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                  of the derived
                  %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∧
                      %annotation{:encoding => "application/x-tex"} \wedge
                  induces an
                  %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi τ
                          %mrow
                            %mi E
                            %mo ,
                            %mi E
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_{\bullet}(\tau_{E,E})
                        \\;\colon\;
                        E_\bullet(E)
                        \\overset{\simeq}{\longrightarrow}
                        E_\bullet(E)
                        \\,.
            %p
              This structure, together with various compatibility conditions that it satisfies, is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/graded+commutative+Hopf+algebroid"} graded commutative Hopf algebroid
                  structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_\bullet(E), \pi_\bullet(E))
              equipped with this structure is called the
              = succeed "." do
                %strong
                  dual
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
            %p
              We discuss this in more detail in
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} Part 2
              in the section
              = succeed "." do
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+2#DualESteenrodAlgebra"} The dual E-Steenrod algebra
          %h4#Examples Examples
          %p
            For reference, we consider some basic examples of
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectra"} orthogonal ring spectra
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#RingSpectrumInSymmetricAndOrthogonalSpectra"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.maruku-ref{:href => "#RingSpectraAreDayMonoids"}
            and corollary
            %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
            each of these examples in particular represents a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#HomotopyCommutativeRingSpectrum"}
            %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#TensorTriangulatedStructureOnStableHomotopyCategory"}
          %p
            We make use of these examples of homotopy commutative ring spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            in
            %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} Part 2
            in the computation of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
          %p
            For constructing representations as
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectra"} orthogonal ring spectra
            of spectra that are already known as
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SequentialSpectra"}> def.
            ) two principles are usefully to be kept in mind:
          %ol
            %li
              %p
                by prop.
                %a.maruku-ref{:href => "#RingSpectraAreDayMonoids"}
                it is sufficient to give an equivariant multiplicative pairing
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ∧
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo →
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} E_{n_1} \wedge E_{n_2} \to E_{n_1 + n_2}
                and equivariant unit maps
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 0
                        %mo →
                        %msub
                          %mi E
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} S^0 \to E_0
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo →
                        %msub
                          %mi E
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1 \to E_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ∧
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo →
                      %msub
                        %mi E
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{n_1} \wedge E_{n_2}\to E_{n_1+n_2}
                are already uniquely induced;
            %li
              %p
                the choice of
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E_n
                is governed mainly by the demand that the unit map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo →
                      %msub
                        %mi E
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n \to E_n
                has to be equivariant, with respect to the
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                induced by regarding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                as the
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
                of the defining
                = succeed "-representation" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                (“
                %a.existingWikiWord{:href => "/nlab/show/representation+sphere"}> representation sphere
                ”).
          %h5#sphere_spectrum Sphere spectrum
          %p
            We already described the orthogonal
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            as an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectrum"} orthogonal ring spectrum
            in lemma
            = succeed "." do
              %a.maruku-ref{:href => "#FSPStructuredSphereSpectra"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n
            with their
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representation+spheres"} representation spheres
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ∧
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                  %mo ⟶
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %msub
                        %mi n
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S^{n_1} \wedge S^{n_2}
                  \\longrightarrow
                  S^{n_1 + n_2}
                  \\,.
          %p
            More generally, by prop.
            %a.maruku-ref{:href => "#SmashProductOfFreeSpectra"}
            the orthogonal
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            functor is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            %a.maruku-ref{:href => "#RingSpectraAreDayMonoids"}
            the
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            of a monoid in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
            (for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mo +
                %annotation{:encoding => "application/x-tex"} G_+
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
          %p
            The orthogonal sphere spectrum is the special case of this with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi orth
                  %mo ≃
                  %msubsup
                    %mi Σ
                    %mi orth
                    %mn ∞
                  %msup
                    %mi S
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth} \simeq \Sigma^\infty_{orth} S^0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 0
                %annotation{:encoding => "application/x-tex"} S^0
            the tensor unit in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#PointedTopologicalSpacesWithSmashIsSymmetricMonoidalCategory"}
            = succeed "." do
              %a.maruku-ref{:href => "#MonoidGivenByTensorUnit"}
          %h5#eilenbergmaclane_spectra Eilenberg-MacLane spectra
          %p
            We discuss the model of
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectra"} Eilenberg-MacLane spectra
            as
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
          #ReducedALinearizationOfnSphere.num_defn
            %h6#definition_35 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                reduced
                = succeed "-linearization" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A[S^n]_\ast
              of the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the underlying set of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    A \otimes_{\mathbb{Z}}[S^n]
                    \=
                    A[S^n]
                    \\longrightarrow
                    A[S^n]_\ast
            %p
              by the relation that identifies every
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
              of the basepoint of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              with 0. The
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              is the induced
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi A
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo ⟶
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{k \in \mathbb{N}}{\sqcup}
                    A^k \times (S^n)^k
                    \\longrightarrow
                    A[S^n]_\ast
            %p
              (of the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equipped with the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
          %p
            (
            %a{:href => "Eilenberg-MacLane+space#AguilarGitlerPrieto02"}> Aguilar-Gitler-Prieto 02, def. 6.4.20
            )
          #ReducedALinearizationOfnSphereIsEMSpace.num_prop
            %h6#proposition_38 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              = succeed "-linearization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
