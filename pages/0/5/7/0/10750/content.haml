                            %msub
                              %mo{:stretchy => "false"} )
                              %mi strict
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi dia
                                    %mo !
                            %mo{:stretchy => "false"} ↓
                            %mo ⊣
                            %msup
                              %mo{:stretchy => "false"} ↑
