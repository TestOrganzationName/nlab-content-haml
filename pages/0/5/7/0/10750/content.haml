                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^\ast X)(c)\coloneqq X(f(c))
              preserves
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoids
              under
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi 𝒟
                    %mo ,
