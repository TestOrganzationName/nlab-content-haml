                            %msub
                              %mi Cof
                              %mi strict
                            %mo ∩
                            %msub
                              %mi W
                              %mi strict
                            %mo{:stretchy => "false"} )
                            %mo □
                            %msub
                              %mi Cof
                              %mi cl
                          %mtd
                            %mo ⊂
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi Cof
                              %mi strict
                            %mo ∩
                            %msub
                              %mi W
                              %mi strict
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Cof_{strict} \Box Cof_{cl}
                    \&amp; \subset\;
                    Cof_{strict}
                    \\\
                    Cof_{strict} \Box (Cof_{cl} \Box W_{cl})
                    \&amp; \subset\;
                    Cof_{strict} \cap W_{strict}
                    \\\
                    (Cof_{strict} \cap W_{strict})
                    \\Box
                    Cof_{cl}
                    \&amp; \subset\;
                    Cof_{strict} \cap W_{strict}
                    \\end{aligned}
                    \\,.
            %p
              Dually, the pullback powering (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoring"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Fib
                              %mi strict
                              %mrow
                                %mo □
                                %msub
                                  %mi Cof
