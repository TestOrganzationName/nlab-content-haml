          %h5#monoidal_model_structure_2 Monoidal model structure
          %p
            We now discuss that the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            structure of the strict
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+orthogonal+spectra"} model structure on orthogonal spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi OrthSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi strict
                %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{strict}
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#MonoidalStrictModelStructure"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi OrthSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi stable
                %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{stable}
            of theorem
            = succeed "." do
              %a.maruku-ref{:href => "#OrthogonalSpectraStableModelStructure"}
          #StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom.num_theorem
            %h6#theorem_5 Theorem
            %p
              The stable model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{stable}
              of theorem
              %a.maruku-ref{:href => "#OrthogonalSpectraStableModelStructure"}
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mo =
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (OrthSpec(Top_{cg}),\; \wedge = \otimes_{\mathbb{S}_{orth}},\; \mathbb{S}_{orth}  )
                    \\,.
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, prop. 12.6
            )
          .proof
            %h6#proof_57 Proof
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cof
                        %mi stable
                      %mo =
                      %msub
                        %mi Cof
                        %mi strict
                    %annotation{:encoding => "application/x-tex"} Cof_{stable} = Cof_{strict}
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidalStrictModelStructure"}
            %p
              It remains to show that if at least one of them is a
              %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#StableOrthStructureClassesOfMorphisms"}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              by theorem
              %a.maruku-ref{:href => "#OrthogonalSpectraStableModelStructure"}
              and since it has
              %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
              (
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectra"}> mapping spectra
              ) with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                  %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{S}_{dia}}
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#DayMonoidalStructureIsClosed"}
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PushoutProductInTopCGSendsCofCofToCof"} this prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mi stable
                    %msub
                      %mo □
                      %mo ⊗
                    %msup
                      %mi J
                      %mi stable
                    %mo ⊂
                    %msub
                      %mi W
                      %mi stable
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi stable
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I^{stable}
                    \\Box_{\otimes}
                    J^{stable}
                    \\subset
                    W_{stable} \cap Cof_{stable}
                    \\,.
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} stable
                    %mo =
                    %msup
                      %mi I
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} I^{\stable} = I^{strict}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mi stable
                    %mo =
                    %msup
                      %mi J
                      %mi strict
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} J^{stable} = J^{strict} \sqcup \{ k_n \Box i_+\}
              so that the special case
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi I
                              %mi stable
                            %msub
                              %mo □
                              %mo ⊗
                            %msup
                              %mi J
                              %mi strict
                          %mtd
                            %mo =
                            %msup
                              %mi I
                              %mi strict
                            %msub
                              %mo □
                              %mo ⊗
                            %msup
                              %mi J
                              %mi strict
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %msub
                              %mi W
                              %mi strict
                            %mo ∩
                            %msub
                              %mi Cof
                              %mi strict
                        %mtr
