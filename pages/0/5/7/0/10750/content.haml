                      %msub
                        %mi X
                        %mi n
                      %mo ⟶
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n \colon X_n \longrightarrow Y_n
            %p such that
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi n
                      %annotation{:encoding => "application/x-tex"} f_n
                  %a.existingWikiWord{:href => "/nlab/show/intertwiner"} intetwines
                  the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Sigma(n)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/action"} action
              %li
                %p
                  the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
