          %p
            between the (Serre-Quillen-)
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
