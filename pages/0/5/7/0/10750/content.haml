                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi S
                          %mi n
                        %mo ⟶
                        %mi E
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
