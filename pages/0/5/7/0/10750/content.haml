                                %mrow
                                  %msup
                                    %mi Σ
                                    %mn ∞
                            %mo{:stretchy => "false"} ↓
                            %mo ⊣
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi Ω
                                    %mn ∞
                        %mtr
                          %mtd
                            %mi SeqSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi cg
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi strict
                          %mtd
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mi Ω
                              %mover
                                %mo ⟵
                                %mi Σ
                          %mtd
                            %mi SeqSpec
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
