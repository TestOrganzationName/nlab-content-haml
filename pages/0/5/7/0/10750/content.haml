                    \\pi_\bullet(A \wedge X)
                    \\,.
            %p
              This is conceptually dual to the concept of
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ForASpectrumXGeneralizedECohomology"}> example
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^\bullet(X)
                    \\coloneqq
                    [X,A]_\bullet
                    \\,.
            %p
              Notice that (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGrouspAsHomsOutOfSphereSpectrum"} lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo =
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi 𝕊
                            %mo ,
                            %mi A
                            %mo ∧
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_\bullet(X)
                    \=
                    \&amp; \pi_\bullet(A \wedge X)
                    \\\
                    \&amp; \simeq
                    [\mathbb{S}, A \wedge X]_\bullet
                    \\end{aligned}
                    \\,.
            %p
              In the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X = \Sigma^\infty K
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∧
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_\bullet(X)
                    \\simeq
                    \\pi_\bullet( A \wedge K )
            %p
              (by prop.
              %a.maruku-ref{:href => "#SmashProductOfFreeSpectra"}
              ) and this is called the
              %em
                generalized
                = succeed "-homology" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              of the topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ∈
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} K \in Top^{\ast/}_{cg}
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              for the derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              (corollary
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_\bullet(\mathbb{S})
                    \\simeq
                    \\pi_\bullet(E)
                    \\,.
            %p For that reason often one also writes for short
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo ≔
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_\bullet \coloneqq \pi_\bullet(E)
                    \\,.
            %p
              Notice that similarly the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ForASpectrumXGeneralizedECohomology"}> exmpl.
              ) of the sphere spectrum is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mo •
                          %mtd
                            %mo ≔
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mi 𝕊
                            %mo ,
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo •
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi π
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi E
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^\bullet
                    \&amp; \coloneqq
                    E^\bullet(\mathbb{S})
                    \\\
                    \&amp; =
                    [\mathbb{S},E]_{-\bullet}
                    \\\
                    \&amp; \simeq
                    \\pi_{-\bullet}(E)
                    \\\
                    \&amp; \simeq E_{-\bullet}
                    \\end{aligned}
                    \\,.
            %p (Beware that, as usual, here we are not displaying a tilde-symbol to indicate reduced cohomology).
          %h5#tensor_triangulated_structure Tensor triangulated structure
          %p
            We discuss that the derived smash product of spectra from corollary
            %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
            on the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            interacts well with its structure of a
            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> def.
            ).
          #TensorTriangulatedCG.num_defn
            %h6#definition_33 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated category
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                  %annotation{:encoding => "application/x-tex"} Ho
              equipped with
            %ol
              %li
                %p
                  the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo ,
                        %mo ⊗
                        %mo ,
                        %mn 1
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ho, \otimes, 1, \tau)
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %li
                %p
                  the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo ,
                        %mi Σ
                        %mo ,
                        %mi CofSeq
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ho, \Sigma, CofSeq)
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> def.
                  );
              %li
                %p
                  for all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ∈
                        %mi Ho
                      %annotation{:encoding => "application/x-tex"} X,Y\in Ho
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi Y
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊗
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        e_{X,Y}
                        \\;\colon\;
                        (\Sigma X) \otimes Y
                        \\overset{\simeq}{\longrightarrow}
                        \\Sigma(X \otimes Y)
            %p such that
            %ol
              %li
                %p
                  (tensor product is additive) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ∈
                        %mi Ho
                      %annotation{:encoding => "application/x-tex"} V \in Ho
                  the functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V \otimes (-) \simeq (-) \otimes V
                  preserve finite
                  %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
                  (are
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/additive+functors"} additive functors
              %li
                %p
                  (tensor product is exact) for each object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ∈
                        %mi Ho
                      %annotation{:encoding => "application/x-tex"} V \in Ho
                  the functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V \otimes (-) \simeq (-)\otimes V
                  preserves distinguished triangles in that for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo ⟶
                          %mi f
                        %mi X
                        %mover
                          %mo ⟶
                          %mi g
                        %mi Y
                        %mover
                          %mo ⟶
                          %mi h
                        %mi Σ
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        X
                        \\overset{f}{\longrightarrow}
                        X
                        \\overset{g}{\longrightarrow}
                        Y
                        \\overset{h}{\longrightarrow}
                        \\Sigma X
                %p
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CofSeq
                        %annotation{:encoding => "application/x-tex"} CofSeq
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊗
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi id
                              %mi V
                            %mo ⊗
                            %mi f
                        %mi V
                        %mo ⊗
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi id
                              %mi V
                            %mo ⊗
                            %mi g
                        %mi V
                        %mo ⊗
                        %mi Y
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi id
                              %mi V
                            %mo ⊗
                            %mi h
                        %mi V
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ⊗
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        V \otimes X
                        \\overset{id_V \otimes f}{\longrightarrow}
                        V\otimes X
                        \\overset{id_V \otimes g}{\longrightarrow}
                        V \otimes Y
                        \\overset{id_V \otimes h}{\longrightarrow}
                        V \otimes (\Sigma X)
                        \\simeq
                        \\Sigma(V \otimes X)
                %p
                  is in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CofSeq
                        %annotation{:encoding => "application/x-tex"} CofSeq
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi e
                            %mrow
                              %mi X
                              %mo ,
                              %mi V
                          %mo ∘
                          %msub
                            %mi τ
                            %mrow
                              %mi V
                              %mo ,
                              %mi Σ
                              %mi Y
                        %annotation{:encoding => "application/x-tex"} e_{X,V}\circ \tau_{V, \Sigma Y}
            %p
              Jointly this says that for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              the equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              give
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \otimes (-)
              the structure of a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated functor
            %p
              (
              %a{:href => "tensor+triangulated+category#Balmer05"}> Balmer 05, def. 1.1
              )
            %p In addition we ask that
            %ol
              %li
                %p
                  (coherence) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo ∈
                        %mi Ho
                      %annotation{:encoding => "application/x-tex"} X, Y, Z \in Ho
                  the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi Z
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi e
                                      %mrow
                                        %mi X
                                        %mo ,
                                        %mi Y
                                    %mo ⊗
                                    %mi id
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ⊗
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi Z
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi e
                                      %mrow
                                        %mi X
                                        %mo ⊗
                                        %mi Y
                                        %mo ,
                                        %mi Z
                              %mtd
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ⊗
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi Z
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi α
                                        %mrow
                                          %mi Σ
                                          %mi X
                                          %mo ,
                                          %mi Y
                                          %mo ,
                                          %mi Z
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Σ
                                      %msub
                                        %mi α
                                        %mrow
                                          %mi X
                                          %mo ,
                                          %mi Y
                                          %mo ,
                                          %mi Z
                            %mtr
                              %mtd
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ⊗
                                %mi Z
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi e
                                      %mrow
                                        %mi X
                                        %mo ,
                                        %mi Y
                                        %mo ⊗
                                        %mi Z
                              %mtd
                              %mtd
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ⊗
                                %mi Z
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        ( \Sigma(X) \otimes Y) \otimes Z
