              is a
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              by theorem
              = succeed "," do
                %a.maruku-ref{:href => "#StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
