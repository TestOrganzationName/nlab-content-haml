          .proof
            %h6#proof_15 Proof
            %p
              By definition
              = succeed "," do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \to Top^{\ast/}_{cg}
              is a topologically enriched functor equipped with a morphism of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S^0 \longrightarrow F(1_{\mathcal{C}})
            %p
              and equipped with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              system of maps of pointed topological spaces of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(c_1) \wedge F(c_2) \longrightarrow F(c_1 \otimes_{\mathcal{C}} c_2)
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
