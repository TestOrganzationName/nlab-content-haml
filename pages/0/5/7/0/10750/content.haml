                          %mrow
                            %mi n
                            %mo +
                            %mi k
                      %annotation{:encoding => "application/x-tex"}
                        S^{k} \wedge X_n
                        \\simeq
                        S^{k-1} \wedge S^1 \wedge X_n
                        \\stackrel{id \wedge \sigma_n }{\longrightarrow}
                        S^{k-1} \wedge X_{n+1}
                        \\simeq
                        S^{k-2}\wedge S^1 \wedge X_{n+2}
                        \\stackrel{id \wedge \sigma_{n+1}}{\longrightarrow}
                        \\cdots
