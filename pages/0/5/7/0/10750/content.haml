                        %msub
                          %mo{:stretchy => "false"} )
                          %mo +
                        %munder
                          %mo ∧
                          %mrow
                            %mi O
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi S
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        (E O(n_1)_+ \underset{O(n_1)}{\wedge} S^{n_1})
                        \\wedge
                        (E O(n_2)_+ \underset{O(n_2)}{\wedge} S^{n_2}
                        \\longrightarrow
                        E O(n_1 + n_2)_+
                        \\underset{O(n_1 + n_2)}{\wedge}
                        S^{n_1 + n_2}
              %li
                %p unit maps
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo ≃
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} )
