                        %annotation{:encoding => "application/x-tex"} O(V) \hookrightarrow E O(V)
          %p
            (
            %a{:href => "#Schwede12"}> Schwede 12, I, example 1.16
            )
          %p
            For the universal complex Thom spectrum
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            the construction is a priori directly analogous, but with the real
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            replace by the
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
            thoughout. This makes the
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                  %mo =
                  %msup
                    %mi S
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^n = S^{(\mathbb{R}^n)}
            be replaced by the
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                  %mo ≃
                  %msup
                    %mi S
                    %mrow
                      %msup
                        %mi ℂ
                        %mi n
                %annotation{:encoding => "application/x-tex"} S^{2n} \simeq S^{\mathbb{C}^n}
            throughout. Hence the construction requires a second step in which the resulting
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
            = succeed ")" do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SequentialTSpectra"} def.
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectrum"} orthogonal spectrum
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#AdjunctionBetweenSequentialSpectraAndSequentialTSpectra"}> lemma
            ) due to the need to have compatible
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on all spaces.
          #OrthogonalComplexThomSpectrum.num_defn
            %h6#definition_38 Definition
            %p
              The
              %strong
                universal complex
                %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              is represented as an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectrum"} orthogonal ring spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RingSpectrumInSymmetricAndOrthogonalSpectra"}
            %p First consider the component spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mi n
                    %mo ≔
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %msub
                      %mo ∧
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℂ
                          %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{M U}_n
                    \\coloneqq
                    E U(n)_+ \wedge_{U(n)} S^{(\mathbb{C}^n)}
            %p
              given by the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spaces"} Thom spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ThomSpace"}> def.
              ) of the
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#EOn"}> def.
              ) of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    O(n) \hookrightarrow U(n) \hookrightarrow E U(n)
                    \\,.
            %p
              Regard these as equipped with the canonical pairing maps (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#UniversalThomSpectrumForBfStructure"}> def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi μ
                        %mo ¯
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ⟶
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\mu}_{n_1,n_2}
                    \\;\colon\;
                    \\overline{M U}_{n_1}
                    \\wedge
                    \\overline{M U}_{n_2}
                    \\longrightarrow
                    \\overline{M U}_{n_1 + n_2}
                    \\,.
            %p
              These are
              = succeed "-equivariant," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              = succeed "-equivariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
            %p
              Then take the actual components spaces to be
              %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
              of these:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %msub
                      %mi U
                      %mi n
                    %mo ≔
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    M U_n
                    \\coloneqq
                    Maps(S^n, \overline{M U}_n)
            %p
              and regard these as equipped with the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
              induced by the above action on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mrow
                          %mi M
                          %mi U
                        %mo ¯
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \overline{M U}_n
              and the canonical action on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ≃
                      %msup
                        %mi S
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^n \simeq S^{(\mathbb{R}^n)}
            %p Define the actual pairing maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi M
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %mi M
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ⟶
                    %mi M
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{n_1, n_2}
                    \\;\colon\;
                    M U_{n_1} \wedge M U_{n_2}
                    \\longrightarrow
                    M U_{n_1 + n_2}
            %p via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mrow
                                  %mi M
                                  %mi U
                                %mo ¯
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ,
                            %msub
                              %mover
                                %mrow
                                  %mi M
                                  %mi U
                                %mo ¯
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ,
                            %msub
                              %mover
                                %mrow
                                  %mi M
                                  %mi U
                                %mo ¯
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi α
                              %mn 1
                            %mo ,
                            %msub
                              %mi α
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                            %msub
                              %mover
                                %mi μ
                                %mo ¯
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi α
                              %mn 1
                            %mo ∧
                            %msub
                              %mi α
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Maps(S^{n_1}, \overline{M U}_{n_1})
                    \\wedge
                    Maps(S^{n_2}, \overline{M U}_{n_2})
                    \&amp; \longrightarrow
                    Maps(S^{n_1 + n_2}, \overline{M U}_{n_1 + n_2})
                    \\\
                    (\alpha_1, \alpha_2)
                    \&amp; \mapsto
                    \\overline{\mu}_{n_1, n_2} \circ (\alpha_1 \wedge \alpha_2)
                    \\end{aligned}
                    \\,.
            %p Finally in order to define the unit maps, consider the isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %msup
                          %mi ℂ
                          %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ⊕
                        %mi i
                        %msup
                          %mi ℝ
                          %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    S^{2 n}
                    \\simeq
