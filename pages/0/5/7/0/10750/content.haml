                    \&amp; \subset\;
                    Fib_{strict}\cap W_{strict}
                    \\\
                    (Fib_{strict} \cap W_{strict})^{\Box Cof_{cl}}
                    \&amp; \subset\;
                    Fib_{strict} \cap W_{strict}
                    \\end{aligned}
                    \\,.
          .proof
            %h6#proof_40 Proof
            %p
              The statement concering the pullback powering follows directly from the analogous statement for topological spaces (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PullbackPowering"}> prop.
              ) by the fact that, via theorem
              = succeed "," do
                %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod_{strict}
              are degree-wise those in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top_{cg}^{\ast/})_{Quillen}
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#JoyalTierneyCalculus"}> prop.
              ).
          #StructuredSpectraIsTopologicallyEnrichedModelCategory.num_remark
            %h6#remark_7 Remark
            %p
              In the language of
              = succeed "-theory," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod_{strict}
              is an
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top_{cg}^{\ast/})_{Quillen}
          %p
            We record some immediate consequences of prop.
            %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
            that will be useful.
          #SmashTensoringWithCellComplexIsLeftQuillen.num_prop
            %h6#proposition_28 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mi cg
                      %mo *
                  %annotation{:encoding => "application/x-tex"} K \in Top^{\ast}_{cg}
              be a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicalCellComplex"}> def.
              ), then the smash-tensoring/powering adjunction from prop.
              %a.maruku-ref{:href => "#UniversalPropertyOfTensoringAndPoweringOfFunctorsToTopcg"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#QuillenAdjunction"}> def.
              ) for the strict model structure from theorem
              %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi strict
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi Maps
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mi K
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi strict
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{dia}Mod(Top_{cg})_{strict}
                    \\underoverset
                    {\underset{Maps(K,-)_\ast}{\longrightarrow}}
                    {\overset{(-)\wedge K}{\longleftarrow}}
                    {\bot}
                    \\mathbb{S}_{dia}Mod(Top_{cg})_{strict}
                    \\,.
          .proof
            %h6#proof_41 Proof
            %p
              By assumption,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a cofibrant object in the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopQuillenModelStructure"}> thm.
              ,
              = succeed ")," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelStructureOnSliceCategory"} prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \ast \to K
              is a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top^{\ast/}_{cg})_{Quillen}
              %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
              of any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \ast \to K
              is equivalently the smash tensoring of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo □
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi f
                    %mo ∧
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \Box (\ast \to K)
                    \\simeq
                    f \wedge K
                    \\,.
            %p
              This way prop.
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi K
                  %annotation{:encoding => "application/x-tex"} (-)\wedge K
              preserves cofibrations and acyclic cofibrations, hence is a left Quillen functor.
          #StandardReducedCylinderOnStructuredSpectrumIsGood.num_lemma
            %h6#lemma_13 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} X \in \mathbb{S}_{dia}Mod_{strict}
              be a structured spectrum, regarded in the strict model structure of theorem
              = succeed "." do
                %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
            %ol
              %li
                %p
                  The smash powering of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  with the standard topological interval
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mo +
                      %annotation{:encoding => "application/x-tex"} I_+
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#StandardReducedCyclinderInTop"}> exmpl.
                  ) is a good
                  %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PathAndCylinderObjectsInAModelCategory"}> def.
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %msub
                              %mi W
                              %mi strict
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi I
                              %mo +
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %msub
                              %mi Fib
                              %mi strict
                        %mi X
                        %mo ×
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta_X
                        \\;\colon\;
                        X
                        \\overset{\in W_{strict}}{\longrightarrow}
                        X^{I_+}
                        \\overset{\in Fib_{strict}}{\longrightarrow}
                        X \times X
                        \\,.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is cofibrant, then its smash tensoring with the standard topological interval
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mo +
                      %annotation{:encoding => "application/x-tex"} I_+
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#StandardReducedCyclinderInTop"}> exmpl.
                  ) is a good
                  %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PathAndCylinderObjectsInAModelCategory"}> def.
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ∨
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %msub
                              %mi Cof
                              %mi strict
                        %mi X
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mo +
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %msub
                              %mi W
                              %mi strict
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\nabla_X
                        \\;\colon\;
                        X \vee X
                        \\overset{\in Cof_{strict}}{\longrightarrow}
                        X\wedge (I_+)
                        \\overset{\in W_{strict}}{\longrightarrow}
                        X
                        \\,.
          .proof
            %h6#proof_42 Proof
            %p
              It is clear that we have weak equivalences as shown (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} I \to \ast
              is even a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mo +
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^{(I_+)} \to X \times X
              is a fibration, and the cylinder object is indeed good in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi X
                    %mo →
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \vee X \to X\wedge (I_+)
              is indeed a cofibration.
            %p
              For the first statement, notice that the pullback powering (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoring"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ⊔
                    %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \ast \sqcup \ast \overset{(i_0,i_1)}{\longrightarrow} I
              into the terminal morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to \ast
              is the same as the powering
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %msub
                            %mi i
                            %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X^{(i_0,i_1)}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo →
                    %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo □
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ((X\to\ast)^{\Box(i_0,i_1)})
                    \\;\simeq\;
                    X^{(i_0,i_1)}
                    \\,,.
            %p
              But since every object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod_{strict}
              is fibrant, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to \ast
              is a fibration, and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i_0,i_1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              inclusion and hence a cofibration in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quilln
                    %annotation{:encoding => "application/x-tex"} (Top^{\ast/}_{cg})_{Quilln}
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi I
                          %mo +
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^{(i_0,i_1)} \colon X^{I_+}\to X \times X
              is a fibration.
            %p Dually, observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo □
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\ast \to X) \Box (i_0, i_1)
                    \\;\simeq\;
                    X \wedge (i_0,i_1)
                    \\,.
            %p
              Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is assumed to be cofibrant, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to X
              is a cofibration, then prop.
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ∧
                    %mi X
                    %mo →
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \wedge (i_0,i_1) \colon X \wedge X \to X \wedge (I_+)
              is a cofibration.
          #PushoutProductOfspectrumWithSpaceInteractingWithHomSpaces.num_prop
            %h6#proposition_29 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} X \in \mathbb{S}_{dia}Mod
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structured+spectrum"} structured spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Mor(\mathbb{S}_{dia}Mod)
              any morphism of structured spectra, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cpt
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g  \in Mor(Top_{cpt}^{\ast/})
              a morphism of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              of def.
              %a.maruku-ref{:href => "#PointedTopologicalFunctorCategory"}
              (via prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesForDayConvolutionAsEnrichedFunctors"}
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoring"}
              in that there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo □
                    %mi g
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo □
                        %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{dia}Mod(f \Box g, X)
                    \\simeq
                    (\mathbb{S}_{dia}Mod(f,X))^{\Box g}
                    \\,.
          .proof
            %h6#proof_43 Proof
            %p
              Since the pointed compactly generated
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              functor (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PointedMappingSpace"}> exmpl.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %msubsup
                          %mi Top
                          %mi cg
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo )
                      %mi op
                    %mo ×
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    Maps(-,-)_\ast
                    \\;\colon\;
                    \\left(Top^{\ast/}_{cg}\right)^{op}
                    \\times
                    Top^{\ast/}_{cg}
                    \\longrightarrow
                    Top^{\ast/}_{cg}
            %p
              takes
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in the first argument to
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#MappingSpacesSendsColimitsInFirstArgumentToLimits"}> cor.
              ) and
              %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              in the second argument to ends (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#MappingSpacePreservesEnds"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod
              are computed objectswise (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedCopresheavesHaveAllLimitsAndColimits"} this prop.
              via prop.
              = succeed ")" do
