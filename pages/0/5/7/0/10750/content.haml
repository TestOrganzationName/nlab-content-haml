                    \\\
                    {}^{\mathllap{dia_!}}\downarrow \dashv \uparrow^{\mathrlap{dia^\ast}}
                    \&amp;&amp;
                    {}^{\mathllap{dia_!}}\downarrow \dashv \uparrow^{\mathrlap{dia^\ast}}
                    \\\
                    \\mathbb{S}_{dia}Mod_{strict}
                    \&amp;&amp;
