                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"}
                        S^n \simeq O(n)_+ \wedge_{O(n)} S^n
                        \\longrightarrow
                        E O(n)_+ \wedge_{O(n)} S^n
                %p
                  induced by the fiber inclusion
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi O
                          %mo{:stretchy => "false"} (
