          %p
            (
            %a{:href => "#HoveyPalmieriStrickland97"}> Hovey-Palmieri-Strickland 97, def. A.2.1
            )
          #TensorTriangulatedStructureOnStableHomotopyCategory.num_prop
            %h6#proposition_35 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"}> def.
              ) equipped with
            %ol
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
                  structure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi Σ
                        %mo ,
                        %mi CofSeq
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ho(Spectra), \Sigma, CofSeq)
                  for distinguished triangles the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
                  ;
              %li
                %p
                  the derived
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msup
                          %mo ∧
                          %mi L
                        %mo ,
                        %mi 𝕊
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ho(Spectra), \wedge^L , \mathbb{S})
                  (corollary
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated category
              in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#TensorTriangulatedCG"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "HoveyPalmieriStrickland97"} Hovey-Palmieri-Strickland 97, 9.4
          %p
            We break up the
            %strong proof
            into lemma
            = succeed "," do
              %a.maruku-ref{:href => "#DerivedSmashProductOfSpectraPreservesDirectSums"}
            = succeed "," do
              %a.maruku-ref{:href => "#SmashTensoringWithSpectrumDerivedPreserveshomotopycofibers"}
            %a.maruku-ref{:href => "#SmashProductOfSpectraCompatibleWithSuspension"}
            and lemma
            = succeed "." do
              %a.maruku-ref{:href => "#GradedCommutativityOfSuspendedSphereSpectra"}
          #DerivedSmashProductOfSpectraPreservesDirectSums.num_lemma
            %h6#lemma_20 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in Ho(Spectra)
              any spectrum in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#StableHomotopyCategoryStructuredSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              (corollary
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalStableHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msup
                      %mo ∧
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V \wedge^L (-)
                    \\;\colon\;
                    Ho(Spectra)
                    \\longrightarrow
                    Ho(Spectra)
            %p
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in Ho(Spectra)
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msup
                      %mo ∧
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊕
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msup
                      %mo ∧
                      %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msup
                      %mo ∧
                      %mi L
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V \wedge^L ( X \oplus Y )
                    \\simeq
                    (V \wedge^L X)
                    \\oplus
                    (V \wedge^L Y)
                    \\,.
          .proof
            %h6#proof_60 Proof
            %p
              The direct sum in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              is represented by the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryHasCoproducts\n"}> prop.
              ,
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ProductsAreBiproducts"} prop.
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#WedgeSumOfSpectra"}> exmpl.
              ) and since the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi seq
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} seq^\ast \colon OrthSpec(Top_{cg}) \longrightarrow SeqSpec(Top_{cg})
              preserves colimits (since by prop.
              %a.maruku-ref{:href => "#ModulesForDayConvolutionAsEnrichedFunctors"}
              it acts by precomposition on functor categories, and since for these colimits are computed objectwise), it follows that also wedge sum of orthogonal spectra represents the direct sum operation in the stable homotopy category.
            %p
              Now assume without restriction that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are cofibrant orthogonal spectra representing the objects of the same name in the stable homotopy catgeory. Since wedge sum is coproduct, it follows that also the wedge sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \vee Y
              is cofibrant.
            %p
