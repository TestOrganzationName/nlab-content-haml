                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\overset{F_{n_3}(i_{n_4})_+ \otimes dom(k_{n_1} \Box (i_{n_2})_+) }{\longrightarrow}&amp;
                    \\\
                    {}^{\mathllap{dom(F_{n_3}(i_{n_4})} \otimes (k_{n_1} \Box (i_{n_2})_+ )}
                    \\downarrow
                    \&amp;(po)&amp;
                    \\downarrow
                    \\\
                    \&amp;\longrightarrow&amp;
                    }
            %p
              is a stable weak homotopy equivalence. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi seq
                      %mo *
                  %annotation{:encoding => "application/x-tex"} seq^\ast
              preserves pushouts, we may equivalently check this on the underlying sequential spectra.
            %p Consider first the top horizontal morphism in this square.
            %p We may rewrite it as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
