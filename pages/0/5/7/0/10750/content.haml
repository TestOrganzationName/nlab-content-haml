                  is the left unitor isomorphism of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  (action property) the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo ⊗
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi N
                              %mtd
                                %munderover
                                  %mo ⟶
                                  %mo ≃
                                  %mrow
                                    %msub
                                      %mi a
                                      %mrow
                                        %mi A
                                        %mo ,
                                        %mi A
                                        %mo ,
                                        %mi N
                              %mtd
                                %mi A
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo ⊗
                                %mi N
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi A
                                    %mo ⊗
                                    %mi ρ
                              %mtd
                                %mi A
                                %mo ⊗
                                %mi N
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi μ
                                      %mo ⊗
                                      %mi N
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi ρ
                            %mtr
                              %mtd
                                %mi A
                                %mo ⊗
                                %mi N
                              %mtd
                                %mo ⟶
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi ρ
                              %mtd
                                %mi N
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        (A\otimes A) \otimes N
                        \&amp;\underoverset{\simeq}{a_{A,A,N}}{\longrightarrow}&amp;
                        A \otimes (A \otimes N)
                        \&amp;\overset{A \otimes \rho}{\longrightarrow}&amp;
                        A \otimes N
                        \\\
                        {}^{\mathllap{\mu \otimes N}}\downarrow
                        \&amp;&amp; &amp;&amp;
                        \\downarrow^{\mathrlap{\rho}}
                        \\\
                        A \otimes N
                        \&amp;\longrightarrow&amp;
                        \&amp;\overset{\rho}{\longrightarrow}&amp;
                        N
                        }
                        \\,,
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of left
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (N_1, \rho_1) \longrightarrow (N_2, \rho_2)
            %p is a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f\;\colon\; N_1 \longrightarrow N_2
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi f
                          %mtd
                            %mi A
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ρ
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ρ
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi N
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A\otimes N_1 &amp;\overset{A \otimes f}{\longrightarrow}&amp; A\otimes N_2
                    \\\
                    {}^{\mathllap{\rho_1}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\rho_2}}
                    \\\
                    N_1 &amp;\underset{f}{\longrightarrow}&amp; N_2
                    }
                    \\,.
            %p
              For the resulting
              %strong
                %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              of left
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A Mod(\mathcal{C})
                    \\,.
            %p
              This is naturally a (pointed)
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              itself.
          #EveryObjectIsModuleOverTensorUnit.num_example
            %h6#example_7 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes, 1)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in a monoidal category
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidGivenByTensorUnit"}
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo ⊗
                    %mi C
                    %mo ⟶
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\ell_C
                    \\;\colon\;
                    1\otimes C \longrightarrow C
            %p
              makes every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} C \in \mathcal{C}
              into a left module, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %a.maruku-ref{:href => "#kel1"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ≃
                    %mn 1
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \simeq 1 Mod(\mathcal{C})
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with the
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              over its tensor unit.
          #RingsAreMonoidsInAb.num_example
            %h6#example_8 Example
            %p
              The archetypical case in which all these abstract concepts reduce to the basic familiar ones is the symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#ExampleAbelianGroupsOfMonoidalCategory"}
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid in
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  An
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/module"} module
              %li
                %p
                  The tensor product of
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TensorProductOfModulesOverCommutativeMonoidObject"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of module objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R Mod(Ab)
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TensorProductOfModulesOverCommutativeMonoidObject"}
                  %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mi Mod
                        %annotation{:encoding => "application/x-tex"} R Mod
          #dgAlgebraAreMonoidsInChainComplexes.num_example
            %h6#example_9 Example
            %p
              Closely related to the example
              = succeed "," do
                %a.maruku-ref{:href => "#RingsAreMonoidsInAb"}
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoids
              in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ch
                      %mo •
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ch_\bullet, \otimes, \mathbb{Z})
              from example
              = succeed "." do
