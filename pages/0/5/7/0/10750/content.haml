              from theorem
              %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
              as a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CofibrantlyGeneratedModelCategory"}> def.
              ).
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, theorem 6.5
            )
          .proof
            %h6#proof_39 Proof
            %p
              By theorem
              %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
              the strict model structure is equivalently the projective pointed
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+enriched+functors"} model structure on topologically enriched functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
