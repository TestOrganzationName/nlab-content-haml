                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_{n_1} \Box (i_{n_2})_+
              with a CW-complex. Hence by lemma
              %a.maruku-ref{:href => "#SmashTensoringWithFiniteCellComplexPreservesSWHE"}
              the left vertical morphism is a stable weak homotopy equivalence.
            %p
              In conclusion, the right vertical morphism is the pushout of a stable weak homotopy equivalence along a degreewise cofibration of pointed topological spaces. Hence lemma
              %a.maruku-ref{:href => "#PushoutOfSWHEAlongDegreewiseCofibration"}
              implies that it is itself a stable weak homotopy equivalence.
          #StableMonoidalQuillenSuspensionSpectrumFunctor.num_cor
            %h6#corollary_4 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+Quillen+adjunction"} strong monoidal Quillen adjunction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalQuillenAdjunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi orth
                      %mn ∞
                    %mo ⊣
                    %msubsup
                      %mi Ω
                      %mi orth
                      %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Sigma^\infty_{orth} \dashv \Omega^\infty_{orth})
              on the strict model structure (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuspensionSpectrumStructuredStrictQuillenAdjunction"}
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+Quillen+adjunction"} strong monoidal Quillen adjunction
              on the stable
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              from theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi orth
                            %mn ∞
                      %mover
                        %mo ⟵
                        %mrow
                          %msubsup
                            %mi Σ
                            %mi orth
                            %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mo ∧
                    %mo ,
                    %msup
                      %mi S
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    OrthSpec(Top_{cg})_{stable}
                    \\underoverset
                    {\underset{\Omega^\infty_{orth}}{\longrightarrow}}
                    {\overset{\Sigma^\infty_{orth}}{\longleftarrow}}
                    {\bot}
                    (Top^{\ast/}_{cg}, \wedge, S^0)_{Quillen}
                    \\,.
          .proof
            %h6#proof_58 Proof
            %p
              The stable model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})_{stable}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              of the strict model structure (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#BousfieldLocalizationOfModelCategories"}> def.
              ) in that it has the same cofibrations and a larger class of acyclic cofibrations. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi orth
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_{orth}
              is still a left Quillen functor also to the stable model structure.
          %h4#TheMonoidalStableHomotopyCategory The monoidal stable homotopy category
          %p
            We discuss now the consequences for the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"}> def.
            ) of the fact that by theorem
            %a.maruku-ref{:href => "#SequentialSpectraQuillenEquivalence"}
            and theorem
            %a.maruku-ref{:href => "#StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom"}
            it is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
            of a stable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            %em
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated category
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TensorTriangulatedCG"}
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            (
            %a{:href => "#HoveyPalmieriStrickland97"}> Hovey-Palmieri-Strickland 97
            ). In particular it is this structure that gives rise to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
            which we discuss in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} Part 2
          #MonoidalStableHomotopyCategory.num_cor
            %h6#corollary_5 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#StableHomotopyCategoryStructuredSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mo ∧
                      %mi L
                    %mo ,
                    %mi 𝕊
                    %mo ≔
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Ho(Spectra), \wedge^L, \mathbb{S} \coloneqq \gamma(\mathbb{S}_{orth}))
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              the
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \wedge^L
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SsymModuleSymmetricSpectra"}
              = succeed "," do
                %a.maruku-ref{:href => "#SmashProductOfSymmetricSpectra"}
              = succeed ")" do
