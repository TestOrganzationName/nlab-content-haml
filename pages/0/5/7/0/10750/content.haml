                  %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidalModelCategory"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %msub
                            %mi 𝕊
                            %mi dia
                          %msub
                            %mi Mod
                            %mi strict
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mo ∧
                          %mo =
                          %msub
                            %mo ⊗
                            %mrow
                              %msub
                                %mi 𝕊
                                %mi dia
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi 𝕊
                            %mi dia
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        \\mathbb{S}_{dia}Mod_{strict},\;
                        \\wedge = \otimes_{\mathbb{S}_{dia}}
                        ,\;
                        \\mathbb{S}_{dia}
                        \\right)
                        \\,.
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, theorem 12.1 (iii) with prop. 12.3
            )
          .proof
            %h6#proof_47 Proof
            %p
              By cofibrant generation of both model structures (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CofibrantGenerationOfPointedTopologicalSpaces"} this theorem
              and prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CofibrantGenerationOfStrictModelStructure"}
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              on generating (acylic) cofibrations (this is as in the proof of
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PushoutProductInTopCGSendsCofCofToCof"} this proposition
            %p
              Those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
              are as recalled in def.
              = succeed "." do
                %a.maruku-ref{:href => "#StableGeneratingAndGeneratingAcyclicCofibrationsForDiagramSpectra"}
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PushoutProductOfITopwithITopAndJTop"} exmpl.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mo □
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %mo =
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo +
                        %msub
                          %mi k
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    i_{k_1} \Box i_{k_2} = i_{k_1 + k_2}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mo □
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %mo =
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo +
                        %msub
                          %mi k
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_{k_1} \Box j_{k_2} = j_{k_1 + k_2}
                    \\,.
            %p This shows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %msub
                      %mo □
                      %mrow
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi 𝕊
                              %mi dia
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %mo ⊂
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    I_{Top^{\ast/}}
                    \\Box_{\otimes_{\mathbb{S}_{dia}}}
                    I_{Top^{\ast/}}
                    \\subset
                    I_{Top^{\ast/}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %msub
                      %mo □
                      %mrow
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi 𝕊
                              %mi dia
                    %msub
                      %mi J
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %mo ⊂
                    %msub
                      %mi J
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    I_{Top^{\ast/}}
                    \\Box_{\otimes_{\mathbb{S}_{dia}}}
                    J_{Top^{\ast/}}
                    \\subset
                    J_{Top^{\ast/}}
            %p
              which implies the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
              %a.existingWikiWord{:href => "/nlab/show/monoid+axiom"} monoid axiom
              (def.
              %a.maruku-ref{:href => "#MonoidAxiom"}>
              ) is problematic.)
            %p
              Now by def.
              %a.maruku-ref{:href => "#GeneratingAndGeneratingAcyclicCofibrationsForDiagramSpectra"}
              the generating (acyclic) cofibrations of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod_{strict}
              are of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi n
                      %mi dia
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} F^{dia}_n (i_k)_+
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi F
                        %mi n
                        %mi dia
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                    %annotation{:encoding => "application/x-tex"} F^{dia}_n (j_k)_+
              %a.maruku-ref{:href => "#SmashProductOfFreeSpectra"}
              these satisfy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo □
                      %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msub
                      %mo □
                      %mo ∧
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"}
                    F_{n_1} (i_{k_1})_+ \; \Box_{\wedge} \; F_{n_2} (i_{k_2})_+
                    \\;\simeq\;
                    F_{n_1 + n_2} ( i_{k_1} \Box_{\wedge} i_{k_2} )_+
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo □
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mo □
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_{n_1} (i_{k_1})_+ \; \Box \; F_{n_2} (j_{k_2})_+
                    \\;\simeq\;
                    F_{n_1 + n_2} ( i_{k_1} \Box j_{k_2} )_+
                    \\,.
            %p Hence with the previous set of relations this shows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi dia
                      %mi strict
                    %msub
                      %mo □
                      %mrow
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi 𝕊
                              %mi dia
                    %msubsup
                      %mi I
                      %mi dia
                      %mi strict
                    %mo ⊂
                    %msubsup
                      %mi I
                      %mi dia
                      %mi strict
                  %annotation{:encoding => "application/x-tex"}
                    I^{strict}_{dia}
                    \\Box_{\otimes_{\mathbb{S}_{dia}}}
                    I^{strict}_{dia}
                    \\subset
                    I^{strict}_{dia}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi dia
                      %mi strict
                    %msub
                      %mo □
                      %mrow
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi 𝕊
                              %mi dia
                    %msubsup
                      %mi J
                      %mi dia
                      %mi strict
                    %mo ⊂
                    %msubsup
                      %mi J
                      %mi dia
                      %mi strict
                  %annotation{:encoding => "application/x-tex"}
                    I^{strict}_{dia}
                    \\Box_{\otimes_{\mathbb{S}_{dia}}}
                    J^{strict}_{dia}
                    \\subset
                    J^{strict}_{dia}
            %p
              and so the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              follows also for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi dia
                      %msub
                        %mi Mod
                        %mi strict
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod_{strict}
            %p
              It is clear that in both cases the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is cofibrant: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
              the tensor unit is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              and hence cofibrant. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}Mod
              the tensor unit is the standard
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %a.maruku-ref{:href => "#ExplicitExpressionForFreeSpectra"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+structured+spectrum"} free structured spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mo ≃
                    %msubsup
                      %mi F
                      %mn 0
                      %mi dia
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{dia} \simeq F^{dia}_0(S^0)
                    \\,.
            %p
              Now the free structured spectrum functor is a left Quillen functor (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuspensionSpectrumStructuredStrictQuillenAdjunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}
              is cofibrant.
          %h5#suspension_and_looping Suspension and looping
          %p
            For the strict
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+sequential+spectra"} model structure on topological sequential spectra
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
            consitutes a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Σ
                    %mn ∞
                  %mo ⊣
                  %msup
                    %mi Ω
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \dashv \Omega^\infty)
            with the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SigmaInfinityIsQuillenOnStrictModelStructureOnSequential"}> prop.
            ) which is the precursor of the
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            adjunction involving the
            %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model structure
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsIndeedStabilizationOfClassicalHomotopyCategory"}> thm.
            ). Here we briefly discuss the lift of this strict adjunction to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/structured+spectra"} structured spectra
          #SuspensionSpectrumStructuredStrictQuillenAdjunction.num_prop
            %h6#proposition_34 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dia
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mi Orth
                    %mo ,
                    %mi Sym
                    %mo ,
                    %mi Seq
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Dia \in \{Top^{\ast/}_{cg,fin}, Orth, Sym, Seq\}
              be one of the shapes of structured spectra from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
            %p
              For every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ev
                      %mi n
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} Ev^{dia}_n
              of extracting the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi n
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} F_n^{dia}
              of forming the
              %a.existingWikiWord{:href => "/nlab/show/free+structured+spectrum"} free structured spectrum
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#QuillenAdjunction"}> def.
              ) between the strict model structure on structured spectra from theorem
              %a.maruku-ref{:href => "#StrictModelStructureOnDiagramSpectra"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}> thm.
              ,
              = succeed "):" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelStructureOnSliceCategory"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi Ev
                            %mi n
                            %mi dia
                      %mover
                        %mo ⟵
                        %mrow
                          %msubsup
                            %mi F
                            %mi n
                            %mi dia
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{dia}Mod_{strict}
                    \\underoverset
                    {\underset{Ev^{dia}_n}{\longrightarrow}}
                    {\overset{F^{dia}_n}{\longleftarrow}}
                    {\bot}
                    (Top^{\ast/}_{cg})_{Quillen}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              and writing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi dia
                      %mn ∞
                    %mo ≔
                    %msubsup
                      %mi F
                      %mn 0
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} \Sigma_{dia}^\infty \coloneqq F^{dia}_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi dia
                        %mn ∞
                      %mo ≔
                      %msubsup
                        %mi Ev
                        %mn 0
                        %mi dia
                    %annotation{:encoding => "application/x-tex"} \Omega_{dia}^\infty \coloneqq Ev^{dia}_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi dia
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_{dia}
              this yields a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+Quillen+adjunction"} strong monoidal Quillen adjunction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalQuillenAdjunction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msub
                      %mi Mod
                      %mi strict
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi dia
                            %mn ∞
                      %mover
                        %mo ⟵
                        %mrow
                          %msubsup
                            %mi Σ
                            %mi dia
                            %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{dia}Mod_{strict}
                    \\underoverset
                    {\underset{\Omega_{dia}^\infty}{\longrightarrow}}
                    {\overset{\Sigma_{dia}^\infty}{\longleftarrow}}
                    {\bot}
                    (Top^{\ast/}_{cg})_{Quillen}
                    \\,.
            %p Moreover, these Quillen adjunctions factor as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi dia
                      %mn ∞
                    %mo ⊣
                    %msubsup
                      %mi Ω
                      %mi dia
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
