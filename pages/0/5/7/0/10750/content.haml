                    I^{strict}_{dia}
                    \\;\coloneqq\;
                    \\left\{
                    F_c^{dia}((i_n)_+)
                    \\right\}_{c \in Dia, n \in \mathbb{N}}
            %p
              for the set of images under forming
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+spectra"} free spectra
              = succeed "," do
                %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
