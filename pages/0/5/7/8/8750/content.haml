                      %mi 𝒱
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}_0
              was a self-enriched category, i.e. isomorphic to the underlying category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒱
                      %mn 0
                      %mi e
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}^e_0
              of a
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒱
                        %mi e
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}^e
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ℐ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⇒
                      %mrow
                        %msubsup
                          %mrow
                          %mn 0
                          %mo −
                        %mi L
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo ,
                    %msub
                      %mi 𝒱
                      %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{I},-]\stackrel{{}^-_0L}{\Rightarrow}[(-)_0,\mathcal{V}_0]
              is in fact the whiskering of a lax natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ℐ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⇒
                      %mrow
                        %msup
                          %mrow
                          %mo −
                        %mi L
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msup
                      %mi 𝒱
                      %mi e
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{I},-]\stackrel{{}^-L}{\Rightarrow}[-,\mathcal{V}^e]
              with the forgetful
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi ℐ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} (-)_0=[\mathcal{I},-]
              = succeed "\u2026" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒱
                        %mn 0
                        %mi e
                      %mo ≅
                      %msub
                        %mi 𝒱
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}^e_0\cong\mathcal{V}_0
