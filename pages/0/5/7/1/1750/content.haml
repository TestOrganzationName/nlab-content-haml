                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} /
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f/g
                for their
                %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ≅
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f/_{\cong} g
                for their
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-pullback"} 2-pullback
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \to B
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is called a (non-strict)
            %strong fibration
            when the following equivalent conditions hold:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo *
                      %mo =
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_* = K(X,p) \colon K(X,E) \to K(X,B)
                is a
                %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi K
                      %annotation{:encoding => "application/x-tex"} X \in K
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f \colon Y \to X
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                            %mtd
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mo *
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mo *
                          %mtr
                            %mtd
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi B
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                            %mtd
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mi B
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      K(X,E) &amp; \overset{f^*}{\to} &amp; K(Y,E) \\
                      \\mathllap{p_*} \downarrow &amp; &amp; \downarrow \mathrlap{p_*} \\
                      K(X,B) &amp; \overset{f^*}{\to} &amp; K(Y,B)
                      }
              %p
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/morphism+of+fibrations"} morphism of fibrations
            %li
              %p
                For every morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi X
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f: X \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ≅
                      %mi p
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} /
                      %mi p
                    %annotation{:encoding => "application/x-tex"} i: f/_{\cong} p \to f/p
                has a
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                in the
                %a.existingWikiWord{:href => "/nlab/show/slice+2-category"} slice 2-category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} /
                        %mi X
                      %annotation{:encoding => "application/x-tex"} K / X
            %li
              %p
                The canonical map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi p
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi p
                    %annotation{:encoding => "application/x-tex"} i \colon p \to B/p
                has a right adjoint in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} /
                        %mi B
                      %annotation{:encoding => "application/x-tex"} K / B
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} p \colon E \to B
                is an algebra for the
                %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} K/B
                given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mi p
                        %mo =
                        %mi B
                        %mo{:stretchy => "false"} /
                        %mi p
                      %annotation{:encoding => "application/x-tex"} L p = B/p
            %li
              %p
                The induced
                %a.existingWikiWord{:href => "/nlab/show/F-functor"} F-functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                      %mo :
                      %mi K
                      %mo ↙
                      %mi E
                      %mo →
                      %mi K
                      %mo ↙
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \Sigma_p : K\swarrow E \to K\swarrow B
                between the
                %a.existingWikiWord{:href => "/nlab/show/lax+slice+2-category"} oplax slice
                %a.existingWikiWord{:href => "/nlab/show/F-categories"} F-categories
                has a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/lax+F-adjunction"} right semi-lax F-adjoint
                = succeed ".)" do
                  %a{:href => "#JohnstonePP"} Johnstone
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            with finite strict 2-limits, then we say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \to B
            is a
            %strong strict fibration
            when the corresponding conditions hold where “Street fibration” is replaced by “Grothendieck fibration”, slice 2-categories are replaced by strict-slice 2-categories, comma objects are replaced by strict comma objects, and 2-pullbacks are replaced by strict 2-pullbacks. In this case the 2-monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is in fact a strict 2-monad, but we do
            %em not
            require
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to be a
            %em strict
            algebra, only a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/pseudoalgebra"} pseudoalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            would instead be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/split+fibrations"} split fibrations
          %p
            Note also that the
            %em first
            definition makes perfect sense regardless of whether
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            has any limits, although this is not true of the others.
          %h2#details Details
          %p
            By way of spelling out the first definition, we may define a 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %mi e
                  %mo →
                  %mi e
                  %mo ′
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} \eta \colon e \to e' \colon X \to E
            to be
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-cartesian
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mi η
                  %mo =
                  %mi η
                  %mi f
                %annotation{:encoding => "application/x-tex"} f^*\eta = \eta f
            is
            = succeed "-cartesian" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_*
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \colon Y \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a fibration in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            if for every 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:lspace => "verythinmathspace"} :
                  %mi b
                  %mo →
                  %mi p
                  %mi e
                %annotation{:encoding => "application/x-tex"} \beta \colon b \to p e
            there is a cartesian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ^
                  %mo{:lspace => "verythinmathspace"} :
                  %mi e
                  %mo ′
                  %mo →
                  %mi e
                %annotation{:encoding => "application/x-tex"} \hat\beta \colon e' \to e
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mi e
                  %mo ′
                  %mo =
                  %mi b
                %annotation{:encoding => "application/x-tex"} p e' = b
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mi β
                  %annotation{:encoding => "application/x-tex"} p \hat\beta = \beta
          %p
            The third definition is perhaps the simplest. Of course, it is implied by the second (take
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f = 1
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma
            and
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            squares.
          %p
            We can show that the first and third definitions are equivalent by using the representability of fibrations and adjunctions, plus the following lemma, whose proof can be found at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
          .un_lemma
            %h6#lemma Lemma
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \to B
              is a
              %a.existingWikiWord{:href => "/nlab/show/cleavage"} cloven
              Street fibration if and only if the canonical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} i \colon B \to E/p
              has a right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} Cat / B
          %p
            It follows that a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \to B
            in any 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is representably a fibration (i.e. satisfies the first definition) if and only if the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ⊣
                  %mi r
                %annotation{:encoding => "application/x-tex"} i \dashv r
            exists in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} K/B
            (i.e. it satisfies the third condition).
          %p
            Now we connect the first three conditions with the fourth. Because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is finitely complete, we may form the
            %a.existingWikiWord{:href => "/nlab/show/tricategory"} tricategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span(K)
            of
            %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} K/B
            is equivalent to the hom-2-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(K)(B,1)
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} recall
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} B/p
            can be expressed as a pullback or span composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                          %mo{:stretchy => "false"} /
                          %mi p
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi B
                            %mstyle{:mathvariant => "bold"}
                              %mn 2
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; &amp; &amp; B/p &amp; &amp; &amp; &amp; \\
                  \&amp; &amp; &amp; \swarrow &amp; &amp; \searrow &amp; &amp; &amp; \\
                  \&amp; &amp; B^{\mathbf{2}} &amp; &amp; &amp; &amp; E &amp; &amp; \\
                  \&amp; \swarrow &amp; &amp; \searrow &amp;
                  \&amp; \swarrow &amp; &amp; \searrow &amp; \\
                  B &amp; &amp; &amp; &amp; B &amp; &amp; &amp; &amp; 1
                  }
          %p
            Write
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mi B
                    %mo =
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo ⇉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \Phi B = B^{\mathbf{2}}\rightrightarrows B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %mi p
                  %mo ↦
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} L \colon p \mapsto B/p
            is then given by composition:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi p
                    %mo =
                    %mi Φ
                    %mi B
                    %mo ∘
                    %mi p
                  %annotation{:encoding => "application/x-tex"} L p =\Phi B \circ p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a fibration iff it is an
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          %p
            %strong Lemma.
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \Phi B
              is a
              %a.existingWikiWord{:href => "/nlab/show/colax-idempotent+monad"} colax-idempotent monad
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(K)
              with unit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo →
                      %msup
                        %mi B
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo =
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} i \colon B \to B^{\mathbf{2}} = B/B
          .proof
            %p
              %em> Proof
              \. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              for the monoidal 2-category whose underlying 1-category is the
              %a.existingWikiWord{:href => "/nlab/show/augmented+simplex+category"} augmented simplex category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Delta_a
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
              (or
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Poset
                    %annotation{:encoding => "application/x-tex"} Poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} [n] \in \mathbf{\Delta}
              is given by the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ←
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1] \to [2] \leftarrow [1]
              with itself, where we take a 0-fold composite to denote the identity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ←
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [1] \to [1] \leftarrow [1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⊕
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n] \oplus [m]
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              is generated by composing the cospans
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi ⇸
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n],[m] \colon [1] &amp;#8696; [1]
              (together with the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0],[1]
              are the initial and terminal objects).
            %p
              Thus for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mi ⇸
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B^{[n]} \colon B &amp;#8696; B
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                      %mo ∘
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                      %mo ∘
                      %mi ⋯
                      %mo ∘
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mi ⇸
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B^{[2]} \circ B^{[2]} \circ \cdots \circ B^{[2]} \colon B &amp;#8696; B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo −
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Cat
                      %mi fp
                      %mi op
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} B^- \colon Cat^{op}_{fp} \to K
              almost restricts to a monoidal 2-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mi op
                      %mo →
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}^{op} \to Span(K)(B,B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0]
              does not yield a span from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo −
                  %annotation{:encoding => "application/x-tex"} B^-
              with the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi co
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}^{co} \to \mathbf{\Delta}^{op}
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n+1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi i
                    %mo ↦
                    %msub
                      %mi σ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \delta_i \mapsto \sigma_i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mo ↦
                    %msub
                      %mi δ
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_i \mapsto \delta_{i+1}
              does yield a monoidal 2-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mi co
                      %mo →
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}^{co} \to Span(K)(B,B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              corresponds to a unique colax-idempotent monad in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span(K)(B,B)
            %p
              In detail, the monoid object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ←
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0] \to [1] \leftarrow [2]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              is sent to the monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mi B
                    %mo =
                    %msup
                      %mi B
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Phi B = B^{[2]}
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi σ
                      %mn 0
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi Φ
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i = (\sigma^1_0)^* \colon B \to \Phi B
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi δ
                        %mn 1
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Φ
                      %mi B
                      %mo ∘
                      %mi Φ
                      %mi B
                      %mo →
                      %mi Φ
                      %mi B
                    %annotation{:encoding => "application/x-tex"} c = (\delta^2_1)^* \colon \Phi B \circ \Phi B \to \Phi B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi δ
                      %mn 1
                      %mn 2
                    %mo ⊣
                    %msubsup
                      %mi σ
                      %mn 0
                      %mn 2
                    %mo =
                    %msubsup
                      %mi σ
                      %mn 0
                      %mn 1
                    %mo ⊕
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \delta^2_1 \dashv \sigma^2_0 = \sigma^1_0 \oplus [1]
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∘
                    %mi Φ
                    %mi B
                    %mo ⊣
                    %mi c
                  %annotation{:encoding => "application/x-tex"} i \circ \Phi B \dashv c
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(K)(B,B)
              with identity unit.
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi Φ
                  %mi B
                  %mo ∘
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} L = \Phi B \circ -
            is a monad, and is colax-idempotent because, for a span
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mi ⇸
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H \colon B &amp;#8696; A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi H
                    %mo =
                    %mi i
                    %mo ∘
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \eta_H = i \circ H
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi H
                    %mo =
                    %mi c
                    %mo ∘
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \mu_H = c \circ H
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mrow
                      %mi L
                      %mi H
                  %mo =
                  %mi i
                  %mo ∘
                  %mi Φ
                  %mi B
                  %mo ∘
                  %mi H
                  %mo ⊣
                  %mi c
                  %mo ∘
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\eta_{L H} = i \circ \Phi B \circ H \dashv c \circ H
          %p
            with identity unit. It is clear, too, that the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi p
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} i \colon p \to B/p
            as above is given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %msup
                          %mi p
                          %mo ∘
                    %mo =
                    %mi i
                    %mo ∘
                    %msup
                      %mi p
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} \eta_{p^\circ} = i \circ p^\circ
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} p^\circ
            denotes the obvious span
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi ⇸
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} B &amp;#8696; 1
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colax-idempotent+monad"} colax-idempotent monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \to B
            carries the structure of an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo =
                  %msub
                    %mi η
                    %mrow
                      %msup
                        %mi p
                        %mo ∘
                  %mo{:lspace => "verythinmathspace"} :
                  %mi p
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} i = \eta_{p^\circ} \colon p \to B/p
            has a right adjoint.
          %h2#properties Properties
          %h3#the_2fibration_of_fibrations The 2-fibration of fibrations
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Fib
                    %mi K
                %annotation{:encoding => "application/x-tex"} Fib_K
            be the 2-category of strict fibrations in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %msub
                    %mi Fib
                    %mi K
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} cod : Fib_K \to K
            is a strict
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-fibration"} 2-fibration
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/microcosm+principle"} microcosm principle
          %p
            Similarly, for any
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Fib
                    %mi K
                %annotation{:encoding => "application/x-tex"} Fib_K
            of weak fibrations in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo :
                    %msub
                      %mi Fib
                      %mi K
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} cod : Fib_K \to K
          %h3#iterated_fibrations Iterated fibrations
          %p
            It is easy to show that a composite of fibrations is a fibration. Moreover, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fib
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Fib
                    %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fib(X)= Fib_K(X)
            denotes the 2-category of fibrations over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X\in K
          .num_theorem
            %h6#theorem Theorem
            %p
              A morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib(X)
              is a fibration in the 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib(X)
              iff its underlying morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a fibration.
          %p
            This is a standard result, at least in the case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} K=Cat
            = succeed ")," do
              %a{:href => "#Benabou85"} Bénabou 1985
            = succeed ")" do
              %a{:href => "#Hermida99"} Hermida 1999, Section 4.3
            = succeed ")." do
              %a{:href => "#Jacobs"} Jacobs 1999, Chapter 9
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} A\to X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Fib
                      %mrow
                        %msub
                          %mi Fib
                          %mi K
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib_K(A) \simeq Fib_{Fib_K(X)}(A\to X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K/A \simeq (K/X)/(A\to X)
            for ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"}> Grothendieck fibration
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
                %a.existingWikiWord{:href => "/nlab/show/two-sided+fibration"} two-sided fibration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                = succeed "," do
                  %em Fibrations and Yoneda’s lemma in a 2-category
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/BFb0063102"} doi:10.1007/BFb0063102
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sym%C3%A9on+Bozapalides"}> Syméon Bozapalides
                \.
                = succeed "," do
                  %em Fibrations et faisceaux dans une 2-catégorie
                = succeed "," do
                  %a{:href => "https://dml.cz/handle/10338.dmlcz/106944"} 10338.dmlcz/106944
                = succeed "&rbrack;" do
                  %a{:href => "https://dml.cz/bitstream/handle/10338.dmlcz/106944/ArchMath_012-1976-4_4.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                = succeed "," do
                  %em Fibrations in bicategories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cahiers+de+Topologie+et+G%C3%A9om%C3%A9trie+Diff%C3%A9rentielle+Cat%C3%A9goriques"} Cahiers de Topologie et Géométrie Différentielle Catégoriques
                = succeed ")." do
                  %a{:href => "http://www.numdam.org/numdam-bin/fitem?id=CTGDC_1980__21_2_111_0"} numdam
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Weber"}> Mark Weber
                ,
                = succeed "," do
                  %em Yoneda structure from 2-toposes
                %strong 15
                (2007) pp259-323. doi:
                %a{:href => "https://doi.org/10.1007/s10485-007-9079-2"} 10.1007/s10485-007-9079-2
                (
                %a{:href => "https://sites.google.com/site/markwebersmaths/home/yoneda-structures-from-2-toposes"}> author’s page
                )
            %li#JohnstonePP
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                = succeed "," do
                  %em Fibrations and partial products in a 2-category
                %strong 1
                (1993) pp141-179 doi:
                %a{:href => "https://doi.org/10.1007/BF00880041"} 10.1007/BF00880041
            %li#Benabou85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                = succeed "," do
                  %em Fibered categories and the foundations of naive category theory
                = succeed "(1)" do
                  %strong 50
                = succeed "," do
                  %a{:href => "https://doi.org/10.2307/2273784"} 10.2307/2273784
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/2273784"} JSTOR
            %li#Jacobs
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"}> Bart Jacobs
                ,
                = succeed "," do
                  %em Categorical Logic and Type Theory
                = succeed ")" do
                  %a{:href => "https://people.mpi-sws.org/~dreyer/courses/catlogic/jacobs.pdf"} pdf
                = succeed ")" do
