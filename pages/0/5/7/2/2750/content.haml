          %title Ordered pairs
          %h1#ordered_pairs Ordered pairs
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#formalisations"} Formalisations
              %li
                %a{:href => "#generalisations"} Generalisations
          %h2#idea Idea
          %p
            Given any things
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %strong ordered pair
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is a thing, usually written
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle{a,b}\rangle
          #eq:basic.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mi a
                  %mo =
                  %mi c
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi b
                  %mo =
                  %mi d
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a,b) = (c,d) \;\Leftrightarrow\; a = c,\; b = d .
          %p
            The things
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are called the
            %strong components
            of the ordered pair
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            whose
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            are precisely the ordered pairs whose components are respectively elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            Note that nothing is
            %strong ordered
            in an ordered pair other than how it is written out, so sometimes just the word
            %strong pair
            is used for this concept.
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            an ordered pair is an element in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
          %p
            The concept of “pair” meaning a set containing just one or two members as in the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+pairing"} axiom of pairing
            of
            %a.existingWikiWord{:href => "/nlab/show/ZFC"} Zermelo–Frankel Set Theory
            is now usually distinguished as an
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/unordered+pair"} unordered pair
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval
            within a larger context.
          %h2#formalisations Formalisations
          %p
            One may wish to declare ordered pairs to exist by fiat, which was done, for example, by both
            %a.existingWikiWord{:href => "/nlab/show/Bourbaki"} Bourbaki
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle{-,-}\rangle
            is a fundamental binary operation on mathematical objects satisfying two axioms:
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            and the existence (as a set) of the Cartesian product of any two sets. In Lawvere's foundational set theory,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            in the category of sets; when applied to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            can be proved. Other
            %a.existingWikiWord{:href => "/nlab/show/structural+set+theories"} structural set theories
            should contain an axiom similar to Lawvere's axiom of products.
          .query
            %p I need to check that I remembered Bourbaki correctly; it varies with the edition. —Toby
          %p
            Instead, one may construct ordered pairs out of some more basic operation. In a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/Kuratowski+pairs"} Kuratowski pairs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"} (a,b) \coloneqq \big\{\,\{a\},\{a,b\}\,\big\} ;
          %p
            it is straightforward (using the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+extensionality"} axiom of extensionality
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            holds. Sometimes one sees the alternative
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mi a
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"} (a,b) \coloneqq \big\{a, \{a,b\}\,\big\} ;
          %p
            but now the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
            is also needed to prove
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:basic"} (1)
            %a.existingWikiWord{:href => "/nlab/show/bounded+separation"} bounded separation
            is enough) to construct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            as a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            of the power set of the
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %span.newWikiWord
              restricted replacement
              %a{:href => "/nlab/new/restricted+replacement"} ?
            is enough) to construct it directly, since its elements are indexed by the sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          #class.num_remark
            %h6#remark Remark
            %p
              Again in the context of material set theory, there are other options for defining ordered pairs that may offer technical advantages. For example, assuming we have the natural numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(x)
              be the set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∖
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi n
                      %mo +
                      %mn 1
                      %mo :
                      %mi n
                      %mo ∈
                      %mi x
                      %mo ∩
                      %mi ℕ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} (x \setminus \mathbb{N}) \cup \{n+1: n \in x \cap \mathbb{N}\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi a
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo :
                    %mi b
                    %mo ∈
                    %mi B
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (A, B) \coloneqq \{\varphi(a): a \in A\} \cup \{\varphi(b) \cup \{0\}: b \in B\}
            %p
              and observe that the first entry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              may be retrieved as the set of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, B)
              that do not contain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              as the set of elements that do. One advantage is that even for classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B
              (defined in ZFC as formulas), we may define a class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, B)
              as another formula patterned on this construction. This solves a technical exercise posed by Andrej Bauer in this
              = succeed ";" do
                %a{:href => "https://mathoverflow.net/a/63268/2926"} MO post
              = succeed "." do
                %a{:href => "https://ncatlab.org/nlab/show/function#for_classes"} class functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: A \to B
              may be defined as an ordered triple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi f
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, f, B)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a class of pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a, b)
              defined by a formula that is
              %a.existingWikiWord{:href => "/nlab/show/entire+relation"} entire
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functional+relation"} functional
          %p
            In a foundational
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            may not hold, depending on the type theory used. Now Bourbaki's binary operation of pairing becomes a typed operation; given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y)
            has type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ×
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi\colon X \times Y \to X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \rho\colon X \times Y \to Y
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/beta-rule"} beta-rule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} \pi(x,y) = x
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \rho(x,y) = y
            %a.existingWikiWord{:href => "/nlab/show/eta-rule"} eta-rule
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mi z
                    %mo ,
                    %mi ρ
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} z = (\pi z,\rho z)
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            to be proved; or else take
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            as the
            %em definition
            of equality on the product type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
            %a.maruku-eqref{:href => "#eq:basic"} (1)
            and the eta-rule will fail.)
