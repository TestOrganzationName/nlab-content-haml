            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D4-brane"} D4-brane
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"}> Paul Townsend
                ,
                = succeed "," do
                  %em D-branes from M-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9512062"} arXiv:hep-th/9512062
            %li#APPS97a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
                ,
                = succeed "," do
