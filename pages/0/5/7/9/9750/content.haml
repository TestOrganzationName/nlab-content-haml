                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Gauge+enhancement+of+Super+M-Branes"} Gauge enhancement of Super M-Branes via rational parameterized stable homotopy theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1806.01115"} arXiv:1806.01115
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-019-03441-4"} doi:10.1007/s00220-019-03441-4
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
