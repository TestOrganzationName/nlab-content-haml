          #DimensionalReductionAbstractly.proof
            %h6#proof Proof
            %p
              First observe that the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G,X]
              is the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Act
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Act_G(\mathbf{H})
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    Act_G(\mathbf{H}) \simeq \mathbf{H}_{/\mathbf{B}G}
            %p
              (from
              = succeed ")" do
                %a{:href => "geometry+of+physics+-+fundamental+super+p-branes#NSS12"} NSS 12
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with its canonical
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast \to \mathbf{B}G)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the trivial action is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \times \mathbf{B}G \to \mathbf{B}G)
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi X
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [G,X]/G
                    \\simeq
                    [\ast, X \times \mathbf{B}G]_{\mathbf{B}G}
                    \\;\;\;\;\;
                    \\in
                    \\mathbf{H}_{/\mathbf{B}G}
                    \\,.
            %p
              Actually, this is the very definition of what
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} [G,X]/G \in \mathbf{H}_{/\mathbf{B}G}
              is to mean in the first place, abstractly.
            %p
              But now since the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
              is itself
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+%28infinity%2C1%29-category"} cartesian closed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    E \times_{\mathbf{B}G}(-)
                    \\;\;\;
                    \\dashv
                    \\;\;\;
                    [E,-]_{\mathbf{B}G}
            %p
              it is immediate that there is the following sequence of
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalences"} natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi G
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo ,
                            %mi X
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo *
                            %mo ,
                            %munder
                              %munder
                                %mrow
                                  %mi X
                                  %mo ×
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mi G
                                %mo ⏟
                              %mrow
                                %msup
                                  %mi p
                                  %mo *
                                %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi p
                                    %mo !
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %msub
                                    %mo ×
                                    %mrow
                                      %mstyle{:mathvariant => "bold"}
                                        %mi B
                                      %mi G
                                  %mo *
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{/\mathbf{B}G}(Y, [G,X]/G)
                    \&amp; \simeq
                    \\mathbf{H}_{/\mathbf{B}G}(Y, [\ast, X \times \mathbf{B}G]_{\mathbf{B}G})
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}_{/\mathbf{B}G}(
                    Y \times_{\mathbf{B}G} \ast,
                    \\underset{p^\ast X}{\underbrace{X \times \mathbf{B}G }}
                    )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(
                    \\underset{hofib(Y)}{\underbrace{p_!(Y \times_{\mathbf{B}G} \ast)}},
                    X
                    )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(hofib(Y),X)
                    \\end{aligned}
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} p \colon \mathbf{B}G \to \ast
              denotes the terminal morphism and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                    %mo ⊣
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_! \dashv p^\ast
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              along it.
          %h2#examples Examples
          %h3#ReductionOnTheCircle Reduction on the circle
          #ReductionOnTheCircle.num_example
            %h6#example Example
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = S^1
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X \times S^1
              as a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla \colon X \times S^1 \to \mathbf{B}^3 U(1)_{conn}
              may represent the
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
              as a cocycle in ordinary differential cohomology. Then its double dimensional reduction in the sense of def.
              %a.maruku-ref{:href => "#DoubleDimensionalReductionForDifferentialCocycles"}
              is the differential cocycle representing the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          #Cyclotomic.num_remark
            %h6#remark Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = S^1
              a circle as in example
              = succeed "," do
                %a.maruku-ref{:href => "#ReductionOnTheCircle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo ×
                    %mi Σ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow [\Sigma, X \times \Sigma]
              in def.
              %a.maruku-ref{:href => "#DoubleDimensionalReductionForDifferentialCocycles"}
              sends each point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the loop in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X\times S^1
              that winds identically around the copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              at that point. Hence in this case it would make sense to consider, more generally, for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}
              the “order
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              times around the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            %p
              The resulting double dimensional reduction is just
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C_p
              %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi p
                  %annotation{:encoding => "application/x-tex"} C_p
              the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of order
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+geometry"} E-infinity geometry
              this fixed-point structure on the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+spaces"} free loop spaces
              makes the derived function algebras – the
              %a.existingWikiWord{:href => "/nlab/show/topological+Hochschild+homology"} topological Hochschild homology
              of the original function algebras – be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclotomic+spectra"} cyclotomic spectra
          %h3#for_general_super_branes
            For general super
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            Double dimensional reduction for the super-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            dimensions which are described by the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+action+functional"} Green-Schwarz action functional
            corresponds to moving down and left the diagonals in the brane scan table of consistent such branes:
          %p
            %img{:alt => "The brane scan", :src => "/nlab/files/branescan.gif"}/
          %p In particular
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
                of
                %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
                appears as the double dimensional reduction of the
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
                in the
                %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
                from
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
                down to 10-dimensional
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/D4-brane"} D4-brane
                appears as the double dimensional reduction of the
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                under this process;
            %li
              %p
                the double dimensional reduction of the
                %a.existingWikiWord{:href => "/nlab/show/super+2-brane+in+4d"} super 2-brane in 4d
                is
                %a.existingWikiWord{:href => "/nlab/show/super+1-brane+in+3d"} super 1-brane in 3d
                (see there).
