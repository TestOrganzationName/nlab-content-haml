                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jaemo+Park"} Jaemo Park
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
