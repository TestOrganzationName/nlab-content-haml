                      %mo{:stretchy => "false"} (
                      %mi a
                      %msub
                        %mo ≡
                        %mi A
                      %mi c
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, a \in A, b \in A, c \in A \vdash \mathrm{trans}_A(a, b, c):(a \equiv_A b) \wedge (b \equiv_A c) \implies (a \equiv_A c)}
          %p
          %h2#section_Internalization_in_a_type_theory Internalization in a type theory
          %p
            In all forms of
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+types"} empty types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+types"} unit types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sum+types"} sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositional+truncations"} propositional truncations
            %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
            and
            %a.existingWikiWord{:href => "/nlab/show/predicate+logic"} predicate logic
            could be internalized in the type theory itself through the definition of a
            %a.existingWikiWord{:href => "/nlab/show/univalent"} univalent
            %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of propositions
            in the type theory.
