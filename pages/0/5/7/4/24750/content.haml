          %p Computation rules for conjunctions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo :
                      %mi B
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi β
                        %mrow
                          %mo ∧
                          %mn 1
                      %mo :
                      %msub
                        %mi π
                        %mn 1
