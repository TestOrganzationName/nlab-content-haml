                      %mi x
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash f:A \implies B}{\Gamma \vdash \eta_{\implies}:f =_{A \implies B} (x \to f(x))}
          %p
          %h3#section_Negations Negations
          %p
            A negation is just an implication of false. However, we introduce separate rules for negations specifically for the use of the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} \neg A
            rather than the longer
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⇒
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} A \implies \bot
          %p Formation rules for negations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo ¬
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{prop}}{\Gamma \vdash \neg A  \; \mathrm{prop}}
          %p Introduction rules for negations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ⊥
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ↦
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ¬
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:A \vdash b(x):\bot}{\Gamma \vdash (x \mapsto b(x)):\neg A}
          %p Elimination rules for negations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo :
                      %mo ¬
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ⊥
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash f:\neg A \quad \Gamma \vdash a:A}{\Gamma \vdash f(a):\bot}
          %p Computation rules for negations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ⊥
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi β
                        %mo ¬
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ↦
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mo ⊥
                      %mi b
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:A \vdash b(x):\bot \quad \Gamma \vdash a:A}{\Gamma \vdash \beta_{\neg}:(x \mapsto b(x))(a) =_{\bot} b}
          %p Uniqueness rules for negations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo :
                      %mo ¬
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi η
                        %mo ⇒
                      %mo :
                      %mi f
                      %msub
                        %mo =
                        %mrow
                          %mo ¬
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash f:\neg A}{\Gamma \vdash \eta_{\implies}:f =_{\neg A} (x \to f(x))}
          %p The above rules makes the dependent type theory into a model of intuitionistic propositional logic.
          %p
          %h3#section_Decidable_and_stable_propositions Decidable and stable propositions
          %p
            A proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is said to be
            %strong decidable
            or satisfy
            %strong
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            if there is a proof
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi A
                    %mo ∨
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p:A \vee \neg A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is said to be
            %strong stable
            or satisfy the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/double+negation+law"} double negation law
            if there is a proof
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mo ¬
                    %mo ¬
                    %mi A
                    %mo ⇒
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p:\neg \neg A \implies A
          %p If every proposition is decidable or stable, then the dependent type theory is a model of classical propositional logic. One could add one of the following rules to make the propositional logic classical:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} lem
                        %mi A
                      %mo :
                      %mi A
                      %mo ∨
                      %mo ¬
                      %mi A
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} doubleneg
                        %mi A
                      %mo :
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo ⇒
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{prop}}{\Gamma \vdash \mathrm{lem}_A:A \vee \neg A} \qquad \frac{\Gamma \vdash A \; \mathrm{prop}}{\Gamma \vdash \mathrm{doubleneg}_A:\neg \neg A \implies A}
          %p
          %h2#section_Categorical_semantics Categorical semantics
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of intuitionistic propositional logic is a
            %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} (0,1)-category
            which is closed under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+coproducts"} finite coproducts
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
          %p
          %h2#section_Typed_predicate_logic_as_a_dependent_type_theory Typed predicate logic as a dependent type theory
          %p
            In the same way that
            %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
            could be expressed as a dependent type theory,
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} typed
            %a.existingWikiWord{:href => "/nlab/show/predicate+logic"} predicate logic
            could also be expressed as a type theory with two layers, a layer of ‘types’ which is the usual type theory, and a layer of propositional logic over the type layer.
          %p
            Thus, in addition to the theory above, we also have the judgments
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} A \; \mathrm{type}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx} \quad \Gamma \vdash A \; \mathrm{type}}{(\Gamma, a \in A) \; \mathrm{ctx}}
          %p
          %h3#section_Structural_rules Structural rules
          %p We also have the variable, weakening and substitution structural rules for types which are in the same format as the structural rules for propositions.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} typectx
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi a
                      %mo ∈
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, a \in A, \Delta \; \mathrm{typectx}}{\Gamma, a \in A, \Delta \vdash a \in A}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi 𝒥
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, \Delta \vdash \mathcal{J} \quad \Gamma \vdash A \; \mathrm{type}}{\Gamma, a \in A, \Delta \vdash \mathcal{J}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo ∈
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi 𝒥
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo ⊢
                      %mi 𝒥
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi b
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash a \in A \quad \Gamma, b \in A, \Delta \vdash \mathcal{J}}{\Gamma, \Delta[a/b] \vdash \mathcal{J}[a/b]}
          %p
          %h3#section_Predicates Predicates
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
            is defined in the usual manner, as a proposition in the
            %a.existingWikiWord{:href => "/nlab/show/term+in+context"} context
            of a term of a type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ⊢
                  %mi P
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} prop
                %annotation{:encoding => "application/x-tex"} \Gamma, x \in A \vdash P \; \mathrm{prop}
          %p
            and the predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is usually written as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            to indicate its dependence upon the variable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
          %p A predicate proof is a proof of a proposition in the context of a term of a type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ⊢
                  %mi p
                  %mo :
                  %mi P
                %annotation{:encoding => "application/x-tex"} \Gamma, x \in A \vdash p:P
          %p
            and the proof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi P
                %annotation{:encoding => "application/x-tex"} p:P
            is similarly written as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x):P(x)
            to indicate its dependence upon the variable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
          %p
          %h3#section_Universal_quantification Universal quantification
          %p
            In this model of predicate logic,
            %a.existingWikiWord{:href => "/nlab/show/universal+quantification"} universal quantification
            is represented by a variant of the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            where the dependent type hypothesis in the usual
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            is replaced by a predicate hypothesis.
          %p Formation rules for the universal quantifier:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo ∀
                      %mi x
                      %mo ∈
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x \in A \vdash B(x) \; \mathrm{prop}}{\Gamma \vdash \forall x \in A. B(x) \; \mathrm{prop}}
          %p Introduction rules for the universal quantifier:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi λ
                      %mi x
                      %mo .
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ∀
                      %mi x
                      %mo ∈
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x \in A \vdash b(x):B(x)}{\Gamma \vdash \lambda x.b(x):\forall x \in A.B(x)}
          %p Elimination rules for the universal quantifier:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo :
                      %mo ∀
                      %mi x
                      %mo ∈
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo ∈
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash f:\forall x \in A. B(x) \quad \Gamma \vdash a \in A}{\Gamma \vdash f(a):B[a/x]}
          %p Computation rules for the universal quantifier:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo ∈
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi β
                        %mo ∀
                      %mo :
                      %mi λ
                      %mi x
                      %mo .
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mo{:stretchy => "false"} ]
                      %mi b
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x \in A \vdash b(x):B(x) \quad \Gamma \vdash a \in A}{\Gamma \vdash \beta_\forall:\lambda x.b(x)(a) =_{B[a/x]} b[a/x]}
          %p Uniqueness rules for the universal quantifier:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
