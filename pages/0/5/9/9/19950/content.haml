          #EquivariantCohomotopyOfRepresentationSphereOfSignRepresentationInThatDegree.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi ℝ
                            %mi sgn
                    %annotation{:encoding => "application/x-tex"} S^{\mathbb{R}_{sgn}}
                in
                %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
                the
                %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℝ
                          %mi sgn
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}_{sgn}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}_2
              the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi sgn
                    %mo ∈
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{sgn} \in RO(\mathbb{Z}_2)
              its 1-dimensional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
            %p
              Under equivariant
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              (
              %a{:href => "representation\\+sphere#Construction"}> here
              ) the corresponding
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi ℝ
                          %mi sgn
                  %annotation{:encoding => "application/x-tex"} S^{\mathbb{R}_{sgn}}
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/unit+circle"} unit circle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
