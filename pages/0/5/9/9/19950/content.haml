                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\big( S^1\big)^{\mathbb{Z}_2}
                    \\;\simeq\;
                    S^0
            %p
              being two antipodal points on the circle, which in the presentation
              %a.maruku-eqref{:href => "#eq:CircleAsQuaotientOfRByZ"} (1)
              are labeled
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} }
                      %mo ≃
                      %msup
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \{0,1/2\} \simeq S^0
            %p Notice that the map
            #eq:ConstantParameterFunctionFromSignRepresentationSphereToItself.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
