                            %mphantom
                              %mo ∼
                            %mn 1
                            %mo −
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo ∼
                            %mphantom
                              %mn 1
                            %mo −
                            %mi t
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\sigma
                    \\;\colon\;
                    t
                    \\mapsto
                    \&amp;
                    \\phantom{\sim}
                    1 - t
                    \\\
                    \&amp; \sim
                    \\phantom{1} - t
                    \\end{aligned}
                    \\,.
            %p
              This means that the
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
              is the
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
