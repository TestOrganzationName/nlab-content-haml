            %p
              of constant parameter speed and
              %a.existingWikiWord{:href => "/nlab/show/winding+number"} winding number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
