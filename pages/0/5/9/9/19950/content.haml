                          %mrow
                            %msup
                              %mi S
                              %mi ℍ
                        %mo )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} offs\left(id_{S^{\mathbb{H}}},1\right) = deg\left( id_{S^{\mathbb{H}}}\right) = 1
