                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S^1
                    \\simeq
                    S(\mathbb{R}^2)
            %p
              equipped with the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              whose
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              %a.existingWikiWord{:href => "/nlab/show/reflection"} reflects
              one of the two
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinates
              of the ambient
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
