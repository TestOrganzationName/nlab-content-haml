          %h2#selected_writings Selected writings
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            on
            %a.existingWikiWord{:href => "/nlab/show/spin+structures"} spin structures
            over
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
            in relation to
            %a.existingWikiWord{:href => "/nlab/show/theta+functions"} theta functions
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+scattering+amplitude"} string amplitudes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Luis+Alvarez-Gaum%C3%A9"}> Luis Alvarez-Gaumé
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
              = succeed "," do
                %em Theta functions, modular invariance, and strings
              %strong 106
              (1986) 1–40 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF01210925"}> doi:10.1007/BF01210925
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-106/issue-1/Theta-functions-modular-invariance-and-strings/cmp/1104115581.full"} eculid:cmp/1104115581
          %p
            Early argument that the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            %a.existingWikiWord{:href => "/nlab/show/flux"} flux
            = succeed "-expressions" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} density
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
            are of the form of
            %a.existingWikiWord{:href => "/nlab/show/Chern+characters"} Chern characters
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+D-brane+charge"} K-theory classification of D-brane charge
          %ul
            %li#GreenHarveyMoore97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeffrey+A.+Harvey"} Jeffrey A. Harvey
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                = succeed "," do
                  %em I-brane inflow and anomalous couplings on D-branes
                %strong 14
                (1997) 47-52 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9605033"}> arXiv:hep-th/9605033
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/0264-9381/14/1/008"} doi:10.1088/0264-9381/14/1/008
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"}> Gregory Moore
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em Self-Duality, Ramond-Ramond Fields, and K-Theory
                %strong 2000
                05 (2000) [
                %a{:href => "https://doi.org/10.1088/1126-6708/2000/05/032"}> doi:10.1088/1126-6708/2000/05/032
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9912279"} arXiv:hep-th/9912279
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/anyons"} anyons
            in the
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+effect"} fractional quantum Hall effect
            satisfying
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+group"} non-abelian
            %a.existingWikiWord{:href => "/nlab/show/braid+group+statistics"} braid group statistics
            and introducing the
            = succeed ":" do
              %em
                %a{:href => "Laughlin+wavefunction#MooreReadWavefunctionOnPlane"} Moore-Read states
          %ul
            %li#MooreRead91
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"}> Gregory Moore
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Read"} Nicholas Read
              = succeed "," do
                %em Nonabelions in the fractional quantum Hall effect
              %strong 360
              (1991) 362 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0550-3213(91)90407-O"}> doi:10.1016/0550-3213(91)90407-O
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.physics.rutgers.edu/~gmoore/MooreReadNonabelions.pdf"} pdf
          %p
            Indication that the
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective
            %a.existingWikiWord{:href => "/nlab/show/abelian+Chern-Simons+theory"} abelian Chern-Simons theory
            %a{:href => "abelian+Chern-Simons+theory#ReferencesAbCSForFQHE"} describing
            the
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+effect"} fractional quantum Hall effect
            has to be understood, in general, as a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spin+Chern-Simons+theory"} spin Chern-Simons theory
          %ul
            %li
              %a{:href => "#MooreRead91"} Moore &amp; Read 1991
              p. 381 (
              %a{:href => "https://www.physics.rutgers.edu/~gmoore/MooreReadNonabelions.pdf#page=20"}> 20 of 35
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            (
            %a.existingWikiWord{:href => "/nlab/show/BCFT"}> BCFT
            \/
            %a.existingWikiWord{:href => "/nlab/show/D-branes"}> D-branes
            ) for the
            %a.existingWikiWord{:href => "/nlab/show/gauged+WZW+model"} gauged WZW model
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/parafermions"} parafermions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"}> Juan Maldacena
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nathan+Seiberg"} Nathan Seiberg
              = succeed "," do
                %em Geometrical interpretation of D-branes in gauged WZW models
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/hep-th/0105038"} arXiv:hep-th/0105038
              %a{:href => "https://doi.org/10.1088/1126-6708/2001/07/046"} doi:10.1088/1126-6708/2001/07/046
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+D-brane+charge"} K-theory classification of D-brane charge
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"}> Greg Moore
              ,
              = succeed "," do
                %em K-Theory from a physical perspective
              %a.existingWikiWord{:href => "/nlab/show/Ulrike+Tillmann"} Ulrike Tillmann
              (ed.)
              = succeed "," do
                %em Topology, Geometry and Quantum Field Theory
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/hep-th/0304018"} arXiv:hep-th/0304018
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/CBO9780511526398.011"} doi:10.1017/CBO9780511526398.011
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2"} AdS3-CFT2
            for
            %a.existingWikiWord{:href => "/nlab/show/D1%2FD5+brane+bound+states"} D1/D5 brane bound states
            and
            %a.existingWikiWord{:href => "/nlab/show/black+hole+entropy"} black hole entropy
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/black+holes+in+string+theory"} in string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"}> Robbert Dijkgraaf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Erik+Verlinde"} Erik Verlinde
              %em A Black Hole Farey Tail
              (
              %a{:href => "https://arxiv.org/abs/hep-th/0005003"}> arXiv:hep-th/0005003
