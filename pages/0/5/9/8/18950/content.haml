                    \\array{
                    A_{in,1}, \cdots, A_{in , n_{in}},
                    \\\
                    A_{out,1}, \cdots, A_{out, n_{out}}
                    }
                    \\;\;\in\;\;
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g] ]
            %p
              whose spacetime support satisfies the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/causal+ordering"} causal ordering
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi out
                        %mo ,
                        %msub
                          %mi i
                          %mi out
                    %mrow
                      %mo &gt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo &lt;
                    %msub
                      %mi A
                      %mrow
                        %mi out
                        %mo ,
                        %msub
                          %mi j
                          %mi out
                    %mphantom
                      %mi AAA
                    %msub
                      %mi A
                      %mrow
                        %mi out
                        %mo ,
                        %msub
                          %mi i
                          %mi out
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
