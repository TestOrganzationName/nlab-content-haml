                      %mi int
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi A
                      %mrow
                        %mi in
                        %mo ,
                        %msub
                          %mi i
                          %mi in
                    %mphantom
                      %mi AAA
                    %msub
                      %mi A
                      %mrow
                        %mi in
                        %mo ,
                        %msub
                          %mi i
                          %mi in
                    %mrow
                      %mo &gt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo &lt;
                    %msub
                      %mi A
                      %mrow
                        %mi in
                        %mo ,
                        %msub
                          %mi j
                          %mi in
                  %annotation{:encoding => "application/x-tex"}
