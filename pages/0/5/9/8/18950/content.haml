                      %mi int
                  %annotation{:encoding => "application/x-tex"} g S_{int}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#VacuumStability"}
            %p
              Consider
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mi in
                                %mo ,
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi A
                              %mrow
                                %mi in
                                %mo ,
                                %msub
                                  %mi n
                                  %mi in
                            %mo ,
                        %mtr
