                      %msub
                        %mi i
                        %mi in
                      %mo &lt;
                      %msub
                        %mi j
                        %mi in
                      %mo ≤
                      %msub
                        %mi n
                        %mi in
                    %annotation{:encoding => "application/x-tex"} 1 \leq  i_{in} \lt j_{in} \leq n_{in}
            %p
