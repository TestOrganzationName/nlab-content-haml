                        %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{H}_{th})_{/X}^{fet}
                    \\stackrel{\overset{L}{\leftarrow}}{\stackrel{\overset{\iota}{\hookrightarrow}}{\underset{Et}{\leftarrow}}}
                    (\mathbf{H}_{th})_{/X}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              By the general discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reflective+factorization+system"} reflective factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
