                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}_{th}
              any object, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
