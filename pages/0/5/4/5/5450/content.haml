                    }
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              square. But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi inf
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{inf}
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              it commutes with the
              = succeed "-colimit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %msub
                              %mi Y
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi inf
                            %msub
                              %mi Y
                              %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
