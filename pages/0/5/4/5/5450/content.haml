                              %mi inf
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Π
                                    %mi inf
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi inf
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\to&amp; X \times_{\mathbf{\Pi}_{inf}(Y)} \mathbf{\Pi}_{inf}(Y) &amp;\to&amp; \mathbf{\Pi}_{inf}(Y)
                    \\\
                    \&amp; \searrow &amp; \downarrow^{} &amp;&amp; \downarrow^{\mathrlap{\mathbf{\Pi}_{inf}(f)}}
                    \\\
