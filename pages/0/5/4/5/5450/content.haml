              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
