                    \\underset{\leftarrow}{\lim}_{J \star \Delta^0} [\ast, X]
                    \\\
                    \&amp; \simeq
                    [\underset{\rightarrow}{\lim}_{J \star \Delta^0} \ast, X]
                    \\\
                    \&amp; \simeq
                    [{\vert {J \star \Delta^0}\vert}, X]
                    \\\
                    \&amp; \simeq
                    [\ast, X] \simeq X
                    \\end{aligned}
                    \\,,
            %p
              where the last line follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mi J
                      %mo ⋆
                      %msup
                        %mi Δ
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} {J \star \Delta^0}
              has a terminal object and hence contractible geometric realization.
            %p
              In conclusion this shows that
              = succeed "-limits" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mo ∘
                      %mi Disc
                    %annotation{:encoding => "application/x-tex"} L \circ (-)\times X\circ Disc
          %h2#properties Properties
          %h3#SheafConditionAndExamples Sheaf condition and examples of étale sheaves
          #EtaleDescentDetectedOnOpenImmersionCovers.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi et
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PSh(X_{et})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              condition it is sufficient to check
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              on the following two kinds of
              %a.existingWikiWord{:href => "/nlab/show/covers"} covers
              in the
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+site"} étale site
            %ol
              %li
                %p
                  jointly surjective collections of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/open+immersions+of+schemes"} open immersions of schemes
              %li
                %p
                  single surjective/
                  %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+morphism+of+schemes"} étale
                  morphisms between
                  %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
            %p
              (all over
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            (
            %a{:href => "#Tamme"}> Tamme, II Lemma (3.1.1)
            ,
            = succeed ")" do
              %a{:href => "#Milne"} Milne, prop. 6.6
          .proof
            %h6#proof_sketch Proof (sketch)
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/covers"} covers
              by standard
              %a.existingWikiWord{:href => "/nlab/show/open+immersions+of+schemes"} open immersions of schemes
              in the
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
              are also
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+morphisms+of+schemes"} étale morphisms of schemes
              and étale covers, we may take any étale cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Y
                      %mi i
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{Y_i \to Y\}
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+immersions+of+schemes"} open immersions of schemes
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              be a single morphisms of affines.
          #XSchemesRepresentSheaves.num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo →
                    %mi X
