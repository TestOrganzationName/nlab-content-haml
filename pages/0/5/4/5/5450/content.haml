                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{\to_i}{\lim} Y_i &amp;\to&amp; \mathbf{\Pi}_{inf} \underset{\to_i}{\lim} Y_i
                    \\\
