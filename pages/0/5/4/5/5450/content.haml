                                  %mo →
                                  %mi i
                            %msub
                              %mi Y
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi inf
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %msub
                              %mi Y
                              %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi inf
                            %mo{:stretchy => "false"} (
                            %mi X
