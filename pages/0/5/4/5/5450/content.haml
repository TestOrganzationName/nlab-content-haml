                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi inf
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{\to_i}{\lim} Y_i &amp;\to&amp; \underset{\to_i}{\lim} \mathbf{\Pi}_{inf} Y_i
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\to&amp; \mathbf{\Pi}_{inf}(X)
