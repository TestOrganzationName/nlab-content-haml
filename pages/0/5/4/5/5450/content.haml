          #EtalificationIsCoreflection.num_prop
            %h6#proposition Proposition
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              of def.
              %a.maruku-ref{:href => "#EtaleSlice"}
              is both
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective
              as well as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                      %mi fet
                    %mover
