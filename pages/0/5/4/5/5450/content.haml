                  %annotation{:encoding => "application/x-tex"}
                    (U_Y \to X) \mapsto Hom_X(U_Y, Z)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
          %p
            This is due to (
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck"}> Grothendieck
            ,
            = succeed "1" do
