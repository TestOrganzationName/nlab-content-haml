                        %mn 1
                    %mo ,
                    %msubsup
                      %mi ℝ
                      %mi cs
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ⋊
                    %mi Spin
