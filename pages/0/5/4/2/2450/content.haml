                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^2, \mathbb{R}^2 \rtimes Spin(2))
          %p
