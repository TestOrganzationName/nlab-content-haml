                \:
              %p
                %br/
              %p
                %strong Higher Algebra
              %p
                %br/
              %p
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ∼
                    %annotation{:encoding => "application/x-tex"} \sim
                2017)
              %p
