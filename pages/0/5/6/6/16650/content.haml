                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\omega]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                is a primitive cube
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} root of unity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi b
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi a
                        %mn 2
                      %mo −
                      %mi a
                      %mi b
                      %mo +
                      %msup
                        %mi b
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d(a + b \omega) = a^2 - a b + b^2
                (the norm).
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              A Euclidean domain is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout domain
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊆
                    %mi A
                  %annotation{:encoding => "application/x-tex"} I \subseteq A
              be a nonzero finitely generated ideal, and suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(g)
              is the minimum degree taken over all nonzero
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} g \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} f \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi q
                    %mi g
                    %mo +
                    %mi r
                  %annotation{:encoding => "application/x-tex"} f = q g + r
              where either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(r) \lt d(g)
              (which is impossible since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} r \in I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(g)
              is minimal). So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
              it is, and thus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I = (g)
          %p
            This proof uses the
            %a.existingWikiWord{:href => "/nlab/show/well-order"} well-orderedness
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            = succeed ":" do
              %strong extended Euclidean algorithm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a, b
            in a Euclidean domain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of the ideal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I = (a) + (b)
            %a.existingWikiWord{:href => "/nlab/show/greatest+common+divisor"} greatest common divisor
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a, b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi n
                  %mo ,
                  %msub
                    %mi b
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_n, b_n)
            of elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo ,
                    %msub
                      %mi b
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_0, b_0) = (a, b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mi n
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_{n+1}, b_{n+1}) = (b_n, r_n)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                  %mo =
                  %msub
                    %mi b
                    %mi n
                  %msub
                    %mi q
                    %mi n
                  %mo +
                  %msub
                    %mi r
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_n = b_n q_n + r_n
            for some choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi n
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                %annotation{:encoding => "application/x-tex"} q_n, r_n
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(r_n) \lt d(b_n)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi n
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r_n \neq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi n
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                %annotation{:encoding => "application/x-tex"} q_n, r_n
            exist, then the sequence terminates at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi n
                    %mo ,
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_n, b_n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi n
                %annotation{:encoding => "application/x-tex"} b_n
            generates
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi I
                  %annotation{:encoding => "application/x-tex"} (b_n) = I
            %a.existingWikiWord{:href => "/nlab/show/infinite+descent"} infinite descent
            of natural numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mi …
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d(r_0) \gt d(r_1) \gt \ldots,
          %p
            again by well-orderedness of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %p The proof that this algorithm produces a gcd consists in the observation that at each step we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (a_{n+1}) + (b_{n+1}) = (a_n) + (b_n),
          %p
            and that from the definition of Euclidean domain, the only reason why the sequence would terminate at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi n
                  %mo ,
                  %msub
                    %mi b
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_n, b_n)
            is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                  %mo =
                  %msub
                    %mi b
                    %mi n
                  %msub
                    %mi q
                    %mi n
                  %mo +
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a_n = b_n q_n + 0
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mi n
                  %annotation{:encoding => "application/x-tex"} q_n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_n) + (b_n) = (b_n)
          %h2#generalisations Generalisations
          %p
            Euclidean domains could be generalised to the case where the structure is only a
            %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            instead of a ring; these objects could be called
            = succeed "." do
              %strong Euclidean cancellative rigs
