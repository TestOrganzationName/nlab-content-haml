          %h2#idea Idea
          %p
            A Euclidean domain is an integral domain which admits a form of the Euclidean quotient-and-remainder algorithm familiar from school mathematics, as well as a form of the extended Euclidean algorithm for calculating the
            %a.existingWikiWord{:href => "/nlab/show/greatest+common+divisor"} greatest common divisor
            and
            %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+coefficients"} Bézout coefficients
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout domain
          %h2#definition Definition
          %p
            A
            %strong Euclidean domain
            is an
            %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            for which there exists a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi A
                  %mo ∖
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} d: A \setminus \{0\} \to \mathbb{N}
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "," do
              %em degree function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} f, g \in A
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g \neq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ,
                  %mi r
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} q, r \in A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi q
                  %mo ⋅
                  %mi g
                  %mo +
                  %mi r
