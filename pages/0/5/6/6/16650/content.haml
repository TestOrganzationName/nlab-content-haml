                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
            %li
              %p
                The real polynomial ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
