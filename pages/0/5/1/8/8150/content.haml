              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} A, B \in R
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
              coincide
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi R
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ⊗
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (L_n ((-)\otimes_R B))(A) \simeq (L_n (A \otimes_R (-)))(B)
            %p
              and hence we can consistently write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_n(A,B)
              for either.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Q^A_\bullet \stackrel{\simeq_{qi}}{\to} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Q^B_\bullet \stackrel{\simeq_{qi}}{\to} B
              be
              %a.existingWikiWord{:href => "/nlab/show/projective+resolutions"} projective resolutions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Tot
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Q
                        %mo •
                        %mi A
                      %mo ⊗
                      %msubsup
                        %mi Q
                        %mo •
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Tot (Q^A_\bullet\otimes Q^B_\bullet)
              %a.maruku-ref{:href => "#AsTotalComplex"}
              the
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of the degreewise
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              carries the
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtration
              by horizontal degree as well as that by vertical degree.
            %p
              Accordingly there are the corresponding two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequences+of+a+double+complex"} spectral sequences of a double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{{}^{A}E^r_{p,q}\}_{r,p,q}
              (for the filtering by
              = succeed "-degree)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mrow
                      %mi B
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{{}^{B}E^r_{p,q}\}_{r,p,q}
              (for the filtering by
              = succeed "-degree)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              We find the value of both spectral sequences on low degree pages according to the general discussion at
              = succeed "." do
                %em
                  %a{:href => "spectral+sequence+of+a+double%20complex#LowDegreePages"} spectral sequence of a double complex - low degree pages
            %p The 0th page for both is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo =
                    %msup
                      %mrow
                      %mi B
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo ≔
                    %msubsup
                      %mi Q
                      %mi p
                      %mi A
                    %msub
                      %mo ⊗
                      %mi R
                    %msubsup
                      %mi Q
                      %mi q
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {}^A E^0_{p,q} = {}^B E^0_{p,q} \coloneqq Q^A_p \otimes_R Q^B_q
                    \\,.
            %p For the first page we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi A
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi p
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mi p
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mo •
                              %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^A E^1_{p,q}
                    \&amp; \simeq H_q(C_{p,\bullet})
                    \\\
                    \&amp; \simeq  H_q( Q^A_p \otimes Q^B_\bullet )
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi B
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mo •
                                %mo ,
                                %mi p
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mi p
                              %mi B
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^B E^1_{p,q}
                    \&amp; \simeq H_q(C_{\bullet,p})
                    \\\
                    \&amp; \simeq  H_q( Q^A_\bullet \otimes Q^B_p )
                    \\end{aligned}
                    \\,.
            %p
              Now using the
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              %a{:href => "universal%20coefficient%20theorem#InHomology"} in homology
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi A
                  %annotation{:encoding => "application/x-tex"} Q^A_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi B
                  %annotation{:encoding => "application/x-tex"} Q^B_\bullet
              is a
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
              %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
              for which all
              = succeed "-modules" do
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi A
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi Q
                              %mi p
                              %mi A
                            %mo ⊗
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msubsup
                                        %mi Q
                                        %mi p
                                        %mi A
                                      %msub
                                        %mo ⊗
                                        %mi R
                                      %mi B
                                    %mtd
                                      %mi if
                                      %mspace{:width => "thickmathspace"}
                                      %mi q
                                      %mo =
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^A E^1_{p,q}
                    \&amp; \simeq Q^A_p \otimes H_q(Q^B_\bullet)
                    \\\
                    \&amp; \simeq \left\{
                    \\array{
                    Q^A_p \otimes_R B &amp; if\; q = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\end{aligned}
            %p and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi B
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi A
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi R
                            %msubsup
                              %mi Q
                              %mi p
                              %mi B
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mi A
                                      %msub
                                        %mo ⊗
                                        %mi R
                                      %msubsup
                                        %mi Q
                                        %mi p
                                        %mi B
                                    %mtd
                                      %mi if
                                      %mspace{:width => "thickmathspace"}
                                      %mi q
                                      %mo =
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^B E^1_{p,q}
                    \&amp; \simeq H_q(Q^A_\bullet) \otimes_R Q^B_p
                    \\\
                    \&amp; \simeq \left\{
                    \\array{
                    A \otimes_R Q^B_p &amp; if\; q = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\end{aligned}
                    \\,.
            %p It follows for the second pages that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi A
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 2
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi H
                              %mi q
                              %mi vert
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mo •
                              %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi L
                                        %mi p
                                      %mo{:stretchy => "false"} (
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mo ⊗
                                        %mi R
                                      %mi B
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} (
                                      %mi A
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                      %mi if
                                      %mspace{:width => "thickmathspace"}
                                      %mi q
                                      %mo =
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^A E^2_{p,q}
                    \&amp; \simeq
                    H_p(H^{vert}_q(Q^A_\bullet \otimes Q^B_\bullet))
                    \\\
                    \&amp; \simeq
                    \\left\{
                    \\array{
                    (L_p( (-)\otimes_R B ))(A) &amp; if \; q = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi B
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 2
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi H
                              %mi q
                              %mi hor
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mo •
                              %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi L
                                        %mi p
                                      %mo{:stretchy => "false"} (
                                      %mi A
                                      %msub
                                        %mo ⊗
                                        %mi R
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} (
                                      %mi B
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                      %mi if
                                      %mspace{:width => "thickmathspace"}
                                      %mi q
                                      %mo =
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                      %mspace{:width => "thickmathspace"}
                                      %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^B E^2_{p,q} &amp; \simeq
                    H_p(H^{hor}_q(Q^A_\bullet \otimes Q^B_\bullet))
                    \\\
                    \&amp; \simeq
                    \\left\{
                    \\array{
                    (L_p ( A \otimes_R (-) ))(B) &amp; if \; q = 0
                    \\\
                    0 \; otherwise
                    }
                    \\right.
                    \\end{aligned}
                    \\,.
            %p Now both of these second pages are concentrated in a single row and hence have converged on that page already. Therefore, since they both converge to the same value:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi R
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                      %mn 2
                    %mo ≃
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                      %mn ∞
                    %mo ≃
                    %msup
                      %mrow
                      %mi B
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                      %mn 2
