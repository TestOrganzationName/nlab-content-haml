                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I \,\in\, Ch_\bullet(R)
              is the chain complex concentrated on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              in degree 0, hence with all
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              being 0, a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %ol
              %li
                %p
                  is fixed by its value on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} 1 \in R
                  (by
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/linear+map"} linearity
              %li
                %p must take values in elements of degree 0 whose differential also vanishes (by the chain map property).
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              In particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Ch
                  %annotation{:encoding => "application/x-tex"} U_{Ch}
              does not simply take a chain complex to its term at degree 0. That would of course give a different forgetful functor.
          %h2#examples Examples
          %h3#SquareAsIntervalSquared Square as tensor product of interval with itself
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              some
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I_\bullet \in Ch_\bullet(R Mod)
              be the chain complex given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                    %mo =
                    %mrow
                      %mo [
                      %mi ⋯
                      %mo →
                      %mn 0
                      %mo →
                      %mn 0
                      %mo →
                      %mi R
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mo ∂
                            %mn 0
                            %mi I
                      %mi R
                      %mo ⊕
                      %mi R
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    I_\bullet =
                    \\left[
                    \\cdots \to 0 \to 0 \to R \stackrel{\partial^{I}_0}{\to} R \oplus R
                    \\right]
                    \\,,
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo ∂
                        %mn 0
                        %mi I
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi id
                      %mo ,
                      %mi id
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial^I_0 = (-id, id)
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              of the
              %a.existingWikiWord{:href => "/nlab/show/chain+on+a+simplicial+set"} simplicial chain complex
              of the standard simplicial interval, the 1-
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mn 0
                    %mo =
                    %mi R
                    %mo ⊕
                    %mi R
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    I_0 = R \oplus R \simeq R[ \{(0), (1)\} ]
            %p
              as the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              of two
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              elements labelled “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0)
              ” and “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1)
              ”, to be thought of as the two 0-
              %a.existingWikiWord{:href => "/nlab/show/chain+on+a+simplicial+set"} chains
              on the endpoints of the interval. Similarly we may think of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mn 1
                    %mo =
                    %mi R
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    I_1 = R \simeq R[\{(0 \to 1)\}]
            %p
              as the free
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0 \to 1)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta^1
            %p
              Accordingly, the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mn 0
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \partial^I_0
              is the oriented
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              map of the interval, taking this basis element to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mn 0
                      %mi I
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^I_0 : (0 \to 1) \mapsto (1) - (0)
            %p
              and hence a general element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r\cdot(0 \to 1)
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mn 0
                      %mi I
                    %mo :
                    %mi r
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi r
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi r
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^I_0 : r\cdot(0 \to 1) \mapsto r\cdot (1) - r\cdot(0)
                    \\,.
            %p
              We now write out in full details the tensor product of chain complexes of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                  %annotation{:encoding => "application/x-tex"} I_\bullet
              with itself, according to def.
              = succeed ":" do
                %a.maruku-ref{:href => "#TheTensorProdComplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo •
                    %mo ≔
                    %msub
                      %mi I
                      %mo •
                    %mo ⊗
                    %msub
                      %mi I
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_\bullet \coloneqq I_\bullet \otimes I_\bullet
                    \\,.
            %p
              By definition and using the above choice of
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              element, this is in low degree given as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mn 0
                          %mtd
                            %mo =
                            %msub
                              %mi I
                              %mn 0
                            %mo ⊗
                            %msub
                              %mi I
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo ⊕
                            %mi R
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo {
                              %msub
                                %mi r
                                %mn 00
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mi r
                                %mn 01
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mi r
                                %mn 10
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mi r
                                %mn 11
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi r
                                %mrow
                                  %mo ⋅
                                  %mo ,
                                  %mo ⋅
                              %mo ∈
                              %mi R
                              %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_0
                    \&amp;=
                    I_0 \otimes I_0
                    \\\
                    \&amp; =
                    (R \oplus R) \otimes (R \oplus R)
                    \\\
                    \&amp; \simeq R \oplus R \oplus R \oplus R
                    \\\
                    \&amp; =
                    \\left\{
                    r_{00} \cdot ((0),(0)')
                    +
                    r_{01} \cdot ((0),(1)')
                    +
                    r_{10} \cdot ((1),(0)')
                    +
                    r_{11} \cdot ((1),(1)')
                    |
                    r_{\cdot, \cdot} \in R
                    \\right\}
                    \\end{aligned}
                    \\,,
            %p
              where in the last line we express a general element as a linear combination of the canonical basis elements which are obtained as tensor products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi R
                    %mo ⊗
                    %mi R
                  %annotation{:encoding => "application/x-tex"} (a,b) \in R\otimes R
              of the previous basis elements. Notice that by the definition of
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              we have relations like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    r ( (0), (1)') = (r(0), (1)') = ((0), r(1)')
            %p etc.
            %p Similarly then, in degree-1 the tensor product chain complex is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo ⊗
                            %mi I
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi I
                              %mn 0
                            %mo ⊗
                            %msub
                              %mi I
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi I
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi I
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi R
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo ⊕
                            %mi R
                            %mo ⊕
                            %mi R
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo {
                              %msub
                                %mi r
                                %mn 0
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo →
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mi r
                                %mn 1
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo →
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mover
                                  %mi r
                                  %mo{:stretchy => "false"} ¯
                                %mn 0
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo →
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mover
                                  %mi r
                                  %mo{:stretchy => "false"} ¯
                                %mn 1
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo →
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ′
