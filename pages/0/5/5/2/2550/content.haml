          %h2#idea Idea
          %p
            %em Motivic homotopy theory
            or
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}^1
              \-homotopy theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of smooth
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{A}^1
            plays the role of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            %em motivic homotopy category
            or the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-homotopy category
            bears the same relation to
            %a.existingWikiWord{:href => "/nlab/show/smooth+varieties"} smooth varieties
            that the ordinary
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Top)
            bears to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          %p
            Both are special cases of a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            induced by any sufficiently well-behaved
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            in a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            via
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+localization+at+an+object"} localization at that object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to be the
            %a.existingWikiWord{:href => "/nlab/show/Diff"} site of smooth manifolds
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            to be the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %a.existingWikiWord{:href => "/nlab/show/Noetherian+scheme"} Noetherian scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is obtained when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich site
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
          #eq:AffineLine.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≔
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  I \coloneqq \mathbb{A}^1
          %p
            is the standard
            %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            As for the standard homotopy theory, one can furthermore pass to
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            and consider the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
          %ul
            %li
              %em
                %a{:href => "#UnstableCategory"} The unstable motivic homotopy category
          %p and then
          %ul
            %li
              %em>
                %a{:href => "#StableCategory"} The stable motivic homotopy category
              \.
          %h2#UnstableCategory The unstable motivic homotopy category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a fixed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Noetherian+scheme"} Noetherian base scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sm
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} Sm/S
            be the category of
            %a.existingWikiWord{:href => "/nlab/show/smooth+schemes"} smooth schemes
            of finite type over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          #MotivicHomotopyCategory.num_defn
            %h6#definition Definition
            %p
              The
              %em motivic homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} H
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
              at the
              %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %a.maruku-eqref{:href => "#eq:AffineLine"} (1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-topos of (∞,1)-sheaves
              on the
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich site
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sm
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Sm/S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} H
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
              are called
              = succeed "." do
                %em motivic spaces
          %p
            Thus, a motivic space over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sm
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} Sm/S
            such that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
              for the
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+topology"} Nisnevich topology
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              = succeed ":" do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                  \-homotopy invariant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi Sm
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} X\in Sm/S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\times\mathbb{A}^1\to X
              induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} F(X)\simeq F(X\times\mathbb{A}^1
          %p
            As for any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi Sm
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)\subset PSh(Sm/S)
            admits a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/localization+functor"} localization functor
          %p
            The (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable
            and
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28%E2%88%9E%2C1%29-category"} locally cartesian closed
            (∞,1)-category. However, it is not an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            (see Remark 3.5 in
            = succeed ")" do
              %a{:href => "http://arxiv.org/pdf/1008.4915v1.pdf"}
                Spitzweck-Østvær,
                = succeed "," do
                  %em Motivic twisted K-theory
          %h3#MotivicSpheres Motivic spheres
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/Tate+sphere"} Tate sphere
            is the
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
            defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ≔
                  %msup
                    %mi 𝔸
                    %mn 1
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo ,
                %annotation{:encoding => "application/x-tex"} T {\coloneqq} \mathbb{A}^1/\mathbb{G}_m,
          %p
            that is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
            of the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo ↪
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m\hookrightarrow \mathbb{A}^1
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (or, equivalently, any
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} locally free sheaf
            of finite rank on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %em motivic sphere
            given by its
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi V
                  %mo ≔
                  %mi V
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi V
                    %mo ×
                  %mo .
                %annotation{:encoding => "application/x-tex"} S^V {\coloneqq} V/V^\times.
          %p
            Thus,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %msup
                      %mi S
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} T=S^{\mathbb{A}^1}
          %p
            A crucial observation is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is the
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            (pointed at
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ≃
                  %msup
                    %mi S
                    %mn 1
                  %mo ∧
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo .
                %annotation{:encoding => "application/x-tex"} T \simeq S^1\wedge\mathbb{G}_m.
          %p
            Indeed, this follows from the definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔸
                    %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{A}^1,1)
            is
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            as a pointed motivic space. It is common to write, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≥
                    %mi q
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p\geq q\geq 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mrow
                    %mo :
                    %mo =
                  %msup
                    %mi S
                    %mrow
                      %mi p
                      %mo −
                      %mi q
                  %mo ∧
                  %msubsup
                    %mi 𝔾
                    %mi m
                    %mrow
                      %mo ∧
                      %mi q
                  %mo .
                %annotation{:encoding => "application/x-tex"} S^{p,q} {:=} S^{p-q}\wedge \mathbb{G}_m^{\wedge q}.
          .num_prop
            %h6#proposition Proposition
            %p
              There is a canonical equivalence of pointed motivic spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℙ
                        %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T\simeq (\mathbb{P}^1,1)
          .proof
            %h6#proof Proof
            %p The cartesian square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝔾
                              %mi m
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msup
                              %mi 𝔸
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi 𝔸
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msup
                              %mi ℙ
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{G}_m &amp;\stackrel{}{\to}&amp; \mathbb{A}^1
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbb{A}^1 &amp;\stackrel{}{\to}&amp; \mathbb{P}^1
                    }
            %p
              becomes
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushout"} homotopy cocartesian
              in the
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich
              (even
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Zariski+site"} Zariski
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{A}^1,1)
              is contractible, we deduce that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℙ
                      %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo ≃
                    %mi T
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (\mathbb{P}^1,1)\simeq S^1\wedge \mathbb{G}_m\simeq T.
          %h2#StableCategory The stable motivic homotopy category
          #StableMotivicHomotopyCategory.num_defn
            %h6#definition_2 Definition
            %p
              The
              %em stable motivic homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SH(S)
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              of the tower of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi …
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Ω
                          %mi T
                    %msub
                      %mi{:mathvariant => "normal"} H
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Ω
                          %mi T
                    %msub
                      %mi{:mathvariant => "normal"} H
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Ω
                          %mi T
                    %msub
                      %mi{:mathvariant => "normal"} H
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \dots \stackrel{\Omega_T}{\to} \mathrm{H}_*(S) \stackrel{\Omega_T}{\to} \mathrm{H}_*(S) \stackrel{\Omega_T}{\to} \mathrm{H}_*(S),
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(S)
              is the ordinary motivic homotopy category from def.
              = succeed "," do
                %a.maruku-ref{:href => "#MotivicHomotopyCategory"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi T
                      %mrow
                        %mo :
                        %mo =
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega_T {:=}Hom(T, -)
              %em
                %a.existingWikiWord{:href => "/nlab/show/motivic+spectrum"} motivic spectrum
              (or
              = succeed ")." do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  \-spectrum
          %p
            Thus, a motivic spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a sequence of pointed motivic spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mn 0
                  %mo ,
                  %msub
                    %mi E
                    %mn 1
                  %mo ,
                  %msub
                    %mi E
                    %mn 2
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_0,E_1,E_2\dots)
            together with
            %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi T
                  %msub
                    %mi E
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ≃
                  %msub
                    %mi E
                    %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Omega_T E_{i+1}\simeq E_i.
          %p
            Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≃
                    %msup
                      %mi ℙ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T\simeq \mathbb{P}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℙ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^1
            instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in the above definition.
          %p
            Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} T\simeq S^1\wedge \mathbb{G}_m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            is indeed a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
          %h3#SymmetricMonoidalStructureAndUniversalProperty Symmetric monoidal structure and universal property
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi T
                    %mn ∞
                  %mo{:lspace => "verythinmathspace"} :
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} H
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\infty_T\colon SH(S)\to \mathrm{H}_*(S)
            sending a motivic spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            to its first component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            admits a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi T
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma_T^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            in such a way that the (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Σ
                    %mi T
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Sigma_T^\infty
            can be promoted to a symmetric monoidal (∞,1)-functor. As such,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            is characterized by a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mrow
                        %mo ⊗
                        %mo ,
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi SH
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Fun
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi Sm
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "1em"}
                    %mi F
                    %mo ↦
                    %mi F
                    %mo ∘
                    %msubsup
                      %mi Σ
                      %mi T
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} Fun^{\otimes, L}(SH(S),\mathcal{C}) \to Fun^{\otimes} (Sm/S, \mathcal{C}), \quad F\mapsto F\circ \Sigma_T^\infty(-)_+
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              means “symmetric monoidal” and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              means “colimit-preserving”) is
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
              and its essential image consists of the symmetric monoidal (∞,1)-functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Sm
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} F\colon Sm/S\to \mathcal{C}
              satisfying:
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich excision
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                \-homotopy invariance
              %li
                %em>
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  \-stability
                \: the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔾
                        %mi m
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(\mathbb{G}_m)\to F(\mathbb{A}^1)
                is
                = succeed "-invertible." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
          %p
            This is (
            %a{:href => "#Robalo"}> Robalo, Corollary 5.11
            ).
          .num_remark
            %h6#remark Remark
            %p
              Similar characterizations exist for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
              = succeed "." do
                %em
                  %a{:href => "noncommutative+motive#AsUniversalAditiveInvariant"} Noncommutative motive – As the universal additive invariant
          %h3#StableMotivicSpheres Stable motivic spheres
          %p
            Because
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} T\simeq S^{2,1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                %annotation{:encoding => "application/x-tex"} S^{p,q}
            are defined for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p,q\in\mathbb{Z}
          %p
            All the other motivic spheres
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a vector bundle on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SH(S)
            %a.existingWikiWord{:href => "/nlab/show/Picard+%E2%88%9E-groupoid"} Picard ∞-groupoid
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            receives a map from the
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %em exotic
            in the sense that they are not equivalent to any of the “categorical” spheres
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %msup
                      %mi Σ
                      %mi n
                    %msubsup
                      %mi Σ
                      %mi T
                      %mn ∞
                    %msub
                      %mi S
                      %mo +
                  %annotation{:encoding => "application/x-tex"} S^n = \Sigma^n\Sigma^\infty_T S_+
            %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            in stable motivic homotopy theory (see
            = succeed ")." do
              %a{:href => "#Ayoub"} Ayoub
          %h3#CohomologyTheories Cohomology theories
          %p
            Any motivic spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∈
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E\in SH(S)
            gives rise to a bigraded
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology theory
            for smooth
            = succeed "-schemes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo :
                    %mo =
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi Σ
                    %mi T
                    %mn ∞
                  %msub
                    %mi X
                    %mo +
                  %mo ,
                  %msup
                    %mi Σ
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} E^{p,q}(X) {:=} [\Sigma^\infty_T X_+, \Sigma^{p,q} E],
          %p as well as a bigraded homology theory:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo :
                    %mo =
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo ,
                  %msubsup
                    %mi Σ
                    %mi T
                    %mn ∞
                  %msub
                    %mi X
                    %mo +
                  %mo ∧
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} E_{p,q}(X) {:=} [S^{p,q}, \Sigma^\infty_T X_+ \wedge E].
          %h2#main_features Main features
          %h3#SixOperations The six operations
          %p
            The categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            for varying base scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            support a formalism of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X\to Y
            is associated an (
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed ")-" do
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^* : SH(Y) \to SH(X) : f_*
          %p
            and, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %a.existingWikiWord{:href => "/nlab/show/separated+morphism"} separated
            of finite type, a (
            %a.existingWikiWord{:href => "/nlab/show/direct+image+with+compact+support"} direct image with compact support
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed ")-adjunction" do
              %a.existingWikiWord{:href => "/nlab/show/exceptional+inverse+image"} exceptional inverse image
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo :
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi f
                    %mo !
                  %mo ,
                %annotation{:encoding => "application/x-tex"} f_! : SH(X) \to SH(Y): f^!,
          %p
            satisfying the properties listed at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            = succeed "." do
              %a{:href => "#Ayoub"} Ayoub
          %p
            %strong Stable homotopy functors.
            To construct the six operations for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                  %annotation{:encoding => "application/x-tex"} SH
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
            %em stable homotopy functor
            is a contravariant (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Schemes
                    %mi op
                  %mo →
                  %mi PrStab
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mo ,
                %annotation{:encoding => "application/x-tex"} D\colon Schemes^{op} \to PrStab (\infty,1) Cat,
          %p
            from some category of schemes to the (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PrStab
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} PrStab (\infty,1) Cat
            of
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
            and colimit-preserving exact functors, satisfying the following axioms (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            a morphism of schemes, we denote
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(f)
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            and its right adjoint by
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} D(\emptyset)=0
                \.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} i: X\to Y
                is an immersion of schemes, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i_*\colon D(X)\to D(Y)
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+%28%E2%88%9E%2C1%29-functor"} fully faithful
            %li
              %p
                (Smooth base change/
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"}> Beck-Chevalley condition
                ) If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                admits a left adjoint
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo ♯
                      %annotation{:encoding => "application/x-tex"} f_\sharp
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Y
                              %mo ′
                            %mtd
                              %mover
                                %mo →
                                %mi k
                            %mtd
                              %mi X
                              %mo ′
                          %mtr
                            %mtd
                              %msub
                                %mo
                                %mi h
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %msub
                                %mspace{:width => "thickmathspace"}
                                %mi f
                          %mtr
                            %mtd
                              %mi Y
                            %mtd
                              %mover
                                %mo →
                                %mi g
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Y' &amp;\stackrel{k}{\to}&amp; X'
                      \\\
                      _h\downarrow &amp;&amp; \downarrow \;_f
                      \\\
                      Y &amp;\stackrel{g}{\to}&amp; X
                      }
              %p
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                smooth, there is a canonical equivalence
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mo ♯
                        %msup
                          %mi k
                          %mo *
                        %mo ≃
                        %msup
                          %mi g
                          %mo *
                        %msub
                          %mi f
                          %mo ♯
                      %annotation{:encoding => "application/x-tex"} h_\sharp k^*\simeq g^* f_\sharp
            %li
              %p
                (Locality) If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi Z
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i: Z\hookrightarrow X
                is a
                %a.existingWikiWord{:href => "/nlab/show/closed+immersion"} closed immersion
                with open complement
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo :
                        %mi U
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} j: U\hookrightarrow X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi i
                        %mo *
                      %mo ,
                      %msup
                        %mi j
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i^*,j^*)
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
            %li
              %p
                (Homotopy invariance) If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi X
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p: X\times\mathbb{A}^1\to X
                is the projection, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p^*
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+%28%E2%88%9E%2C1%29-functor"} fully faithful
            %li
              %p
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                \-stability) If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is as above and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                is the zero section of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo ♯
                      %msub
                        %mi s
                        %mo *
                      %mo :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_\sharp s_*: D(X)\to D(X)
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .num_theorem
            %h6#theorem Theorem
            %p
              (Ayoub, Voevodsky) Every stable homotopy functor admits a formalism of four operations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^\ast
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo !
                    %annotation{:encoding => "application/x-tex"} f_!
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo !
                    %annotation{:encoding => "application/x-tex"} f^!
          %p
            For a more precise statement, see
            = succeed "." do
              %a{:href => "#Ayoub"} Ayoub, Scholie 1.4.2
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                  %annotation{:encoding => "application/x-tex"} SH
              is a stable homotopy functor.
          %p
            This is essentially proved in
            = succeed "." do
              %a{:href => "#MorelVoevodsky99"} Morel-Voevodsky 99
          .num_theorem
            %h6#expected_theorem Expected Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                  %annotation{:encoding => "application/x-tex"} SH
              is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
              of stable homotopy functors.
          %p
            This theorem has not been proved yet; however,
            %a{:href => "#Ayoub"} Ayoub’s thesis
            shows that every stable homotopy functor factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                  %annotation{:encoding => "application/x-tex"} SH
          %h3#RealizationFunctors Realization functors
          %p
            %strong Complex realization.
            The functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sm
                  %mo{:stretchy => "false"} /
                  %mi ℂ
                  %mo →
                  %mi SmoothMfd
                  %mo ,
                  %mspace{:width => "1em"}
                  %mi X
                  %mo ↦
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sm/\mathbb{C}\to SmoothMfd,\quad X\mapsto X(\mathbb{C})
          %p
            associating to a smooth
            = succeed "-scheme" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            its set of
            = succeed "-points" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            induces a functor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(\mathbb{C})
            to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth (∞,1)-topos
            at the
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1(\mathbb{C})\simeq \mathbb{R}^2
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Grpd
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            %em complex realization functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(\mathbb{C}) \to \infty Grpd.
          %p
            After
            = succeed "-stabilization," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(\mathbb{C})
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+spectra"} (∞,1)-category of spectra
            %em complex Betti realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Be
                  %mo :
                  %mi{:mathvariant => "normal"} Sp
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} Sp
                %annotation{:encoding => "application/x-tex"} \mathrm{Be}:\mathrm{Sp}(\mathbb{C}) \rightarrow \mathrm{Sp}
          %p
            associating to a smooth
            = succeed "-scheme" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            its set of
            = succeed "-points" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            together with the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            by
            %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            induces as in the complex case the
            %em Real realization functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(\mathbb{R}) \to PSh_\infty(\mathcal{O}_{\mathbb{Z}/2}),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{Z}/2}
            is the
            %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed "-stabilization," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(\mathbb{R})
            to the (∞,1)-category of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+homotopy+theory"} genuine
            = succeed "-spectra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %em real Betti realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Be
                  %mo :
                  %mi{:mathvariant => "normal"} Sp
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} Sp
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \mathrm{Be}:\mathrm{Sp}(\mathbb{R}) \rightarrow \mathrm{Sp}_{C_2}
          %p
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/shape+of+an+%28%E2%88%9E%2C1%29-topos"} shape of an (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(k)
            because the étale homotopy type is not
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo ≠
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} char
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} l\neq \operatorname{char}(k)
            and consider the reflexive
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi l
                    %mo ∧
                %annotation{:encoding => "application/x-tex"} Pro(\infty Grpd)^\wedge_{l}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(\infty Grpd)
            at the class of maps inducing isomorphisms on pro-homology groups with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi l
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/l
            %em étale realization functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi l
                    %mo ∧
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(k) \to Pro(\infty Grpd)^\wedge_{l}.
          %h3#SliceFiltration The slice filtration
          %p
            %em
              See
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/motivic+slice+filtration"} motivic slice filtration
          %p
            The slice filtration is a filtration of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
            and of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            which is analogous to the
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower+in+an+%28%E2%88%9E%2C1%29-category"} Postnikov filtration
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topoi"} (∞,1)-topoi
            %em coniveau filtration
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            %em fundamental filtration
            on
            = succeed "," do
              %span.newWikiWord
                Witt groups
                %a{:href => "/nlab/new/Witt+groups"} ?
            %em weight filtration
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mixed+Tate+motives"} mixed Tate motives
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth
            over a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed ")" do
              %em slices
            %a{:href => "#MotivicCohomology"} motivic Eilenberg–Mac Lane spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(\mathbb{Z})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of characteristic zero, this is the same thing as an integral
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/motive"} motive
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            associated to the slice filtration are analogous to the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
            groups.
          %h3#A1PostnikovFiltration
            The
            = succeed "-Postnikov" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          %p
            One can also consider the filtration on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower+in+an+%28%E2%88%9E%2C1%29-category"} Postnikov filtration
            in the containing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+%28%E2%88%9E%2C1%29-topos"} Nisnevich (∞,1)-topos
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-n-connected
            if it is
            %a.existingWikiWord{:href => "/nlab/show/n-connected"} n-connected
            as a Nisnevich (∞,1)-sheaf, and the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi π
                    %mi n
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n^{\mathbb{A}^1}(X,x)
            of a motivic space are its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} homotopy groups
            as a Nisnevich (∞,1)-sheaf.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            has finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Krull+dimension"} Krull dimension
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            because the
            %a.existingWikiWord{:href => "/nlab/show/Nisnevich+%28%E2%88%9E%2C1%29-topos"} Nisnevich (∞,1)-topos
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete"} hypercomplete
          .num_remark
            %h6#remark_2 Remark
            %p
              The usage of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is viewed as a motivic space, a localization functor is implicitly applied. The underlying Nisnevich (∞,1)-sheaf of the motivic space “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ” can thus be very different from the Nisnevich (∞,1)-sheaf represented by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (for which these definitions would not be interesting at all!).
          %p
            Intuitively,
            = succeed "-connectedness" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %em real points
            rather than of the complex points. For example,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            is not
            = succeed "-connected," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℙ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^1
            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "-simply" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfect field
              (resp. a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich
              (∞,1)-sheaf of spaces (resp. of spectra) on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sm
                      %mo{:stretchy => "false"} /
                      %mi k
                    %annotation{:encoding => "application/x-tex"} Sm/k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/n-connected"} n-connected
              for some n, then its
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          %p
            This is Morel’s
            %em connectivity theorem
            (
            %a{:href => "#Morel"}> Morel, Theorem 5.38
            ). It follows that the
            = succeed "-Postnikov" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(k)
            “extends” to a
            %a.existingWikiWord{:href => "/nlab/show/t-structure"} t-structure
            on the stable (∞,1)-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SH(k)
            = succeed "." do
              %em homotopy t-structure
          %h3#relation_to_the_theory_of_motives Relation to the theory of motives
          %p
            The stable motivic homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            is the basis for several definitions of the
            %a.existingWikiWord{:href => "/nlab/show/motive"} derived category of mixed motives
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h3#relation_to_the_theory_of_symmetric_bilinear_forms Relation to the theory of symmetric bilinear forms
          %p
            Motivic homotopy theory is also related to the classical theory of symmetric
            %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
            (or
            %a.existingWikiWord{:href => "/nlab/show/quadratic+forms"} quadratic forms
            in characteristic
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \neq 2
            = succeed "," do
              %span.newWikiWord
                Witt groups
                %a{:href => "/nlab/new/Witt+groups"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chow+groups"} Chow groups
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+K-theory"} Hermitian K-theory
            are representable in the motivic homotopy category.
          %p
            A central theorem of
            %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
            states that, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 0
                  %mo ∈
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^0\in SH(k)
            is canonically isomorphic to the
            %em Grothendieck–Witt ring
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GW
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GW(k)
            %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/semiring"} semiring
            of isomorphism classes of nondegenerate symmetric
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (
            %a{:href => "#Morel"}> Morel, Corollary 5.43
            ). The case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} k=\mathbb{R}
            is especially enlightening: there the stable homotopy class of a pointed endomorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℙ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^1
            corresponds to the nondegenerate symmetric bilinear form over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            whose dimension is the degree of the induced endomorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℙ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^1(\mathbb{C})\simeq S^2
            and whose signature is the degree of the induced endomorphism of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℙ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{P}^1(\mathbb{R})\simeq S^1
          %h2#EquivariantMotivicHomotopyTheory Equivariant motivic homotopy theory
          %p
            A general theory of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+motivic+homotopy+theory"} equivariant
            (unstable and stable) motivic homotopy theory was introduced in (
            %a{:href => "#CJ2014"}> Carlsson-Joshua 2014
            ) and further developed in (
            %a{:href => "#Hoyois15"}> Hoyois 15
            ).
          %h2#applications_and_examples Applications and examples
          %h3#A1coverings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            \-coverings and the
            = succeed "-fundamental" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          %p
            Like the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "," do
              %a{:href => "#A1PostnikovFiltration"} Postnikov filtration
            = succeed "-coverings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "-fundamental" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Π
                    %mn 1
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \Pi_1^{\mathbb{A}^1}
            are defined in the containing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nisnevich+%28%E2%88%9E%2C1%29-topos"} Nisnevich (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f: Y\to X
            is an
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-covering
            if it is
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28%E2%88%9E%2C1%29-category"} 0-truncated
            as a morphism between Nisnevich (∞,1)-sheaves. Such a morphism is determined by its 1-truncation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mn 1
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \tau_{\leq 1}f
            = succeed "-coverings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and that of
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            of the Nisnevich sheaf of groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Π
                    %mn 1
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi τ
                    %mrow
                      %mo ≤
                      %mn 1
                  %mi X
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Pi_1^{\mathbb{A}^1}(X):=\tau_{\leq 1}X.
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi{:mathvariant => "normal"} H
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\in\mathrm{H}_\ast(k)
              a pointed
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde X
              be the
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (as a pointed Nisnevich (∞,1)-sheaf). Then:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"} \tilde X
                  is the initial object in the category of pointed
                  = succeed "-coverings" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"} \tilde X
                  is the unique pointed
                  = succeed "-covering" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  which is
                  = succeed "-simply" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %li
                %p
                  The Nisnevich sheaf of (unpointed) automorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Aut
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Aut_X(\tilde X)
                  is canonically isomorphic to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi π
                            %mn 1
                            %mrow
                              %msup
                                %mi 𝔸
                                %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_1^{\mathbb{A}^1}(X)
          %p
            This is
            = succeed "." do
              %a{:href => "#Morel"} Morel, Theorem 6.8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Π
                    %mn 1
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1^{\mathbb{A}^1}(X)
            is
            = succeed "-invariant;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a smooth
            = succeed "-scheme," do
