            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (
            %a{:href => "#Morel"}> Morel, Lemma 6.5
            ). This can be used to compute some
            = succeed "-fundamental" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n\geq 2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 1
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℙ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \pi_1^{\mathbb{A}^1}(\mathbb{P}^n)=\mathbb{G}_m
          .proof
            %h6#proof_2 Proof
            %p
              The projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo −
                    %mn 0
                    %mo →
                    %msup
                      %mi ℙ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^{n+1}-0\to\mathbb{P}^n
              is a
              = succeed "-torsor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
              = succeed "-covering." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n\geq 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo −
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^{n+1}-0
              is moreover
              = succeed "-simply" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              = succeed "-covering" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℙ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{P}^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 1
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℙ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi Aut
                        %mrow
                          %msup
                            %mi ℙ
                            %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo −
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \pi_1^{\mathbb{A}^1}(\mathbb{P}^n)=Aut_{\mathbb{P}^n}(\mathbb{A}^{n+1}-0)=\mathbb{G}_m
          %h3#hcobordisms_and_the_classification_of_surfaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            \-h-cobordisms and the classification of surfaces
          %p
            An
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-h-cobordism
            is a surjective
            %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X\to\mathbb{A}^1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sm
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} Sm/S
            such that, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i=0,1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} X_i
            is smooth and the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_i\hookrightarrow X
            becomes an equivalence in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} H
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
          %p
            Asok and Morel used
            = succeed "-h-cobordisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed field
            = succeed "-homotopy." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "." do
              %a{:href => "#AsokMorel"} Asok-Morel
          %h3#euler_classes_and_splittings_of_algebraic_vector_bundles Euler classes and splittings of algebraic vector bundles
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfect field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a smooth affine
            = succeed "-scheme," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Vect
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msub
                    %mi BGL
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Vect_n(X) \cong [X,BGL_n],
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            denote homotopy classes of maps in the motivic homotopy category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} H
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{H}(k)
            = succeed "." do
              %a.maruku-ref{:href => "#MotivicHomotopyCategory"}
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            splits off a trivial
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            is thus equivalent to determining whether the classifying map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi BGL
                    %mi n
                %annotation{:encoding => "application/x-tex"} X\to BGL_n
            lifts to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi BGL
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} BGL_{n-1}
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} H
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{H}(k)
            %a.existingWikiWord{:href => "/nlab/show/cohomological+dimension"} cohomological dimension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is at most
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/obstruction+theory"} obstruction theory
            together with the
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo −
                  %mn 0
                  %mo →
                  %msub
                    %mi BGL
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %msub
                    %mi BGL
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^n-0 \to BGL_{n-1} \to BGL_n
          %p to obtain the following criterion:
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              (Morel) Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n\geq 2
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \leq n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              be a vector bundle of rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi H
                      %mi Nis
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msubsup
                      %mi π
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo −
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} det
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e(\xi)\in H^n_{Nis}(X,\pi_{n-1}^{\mathbb{A}^1}(\mathbb{A}^n-0)(\mathrm{det} \xi))
            %p
              which vanishes if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              splits off a trivial line bundle.
          %p
            The twist by the determinant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} det
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \mathrm{det} \xi
            comes from the nontrivial
            = succeed "-fundamental" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi BGL
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \pi_1^{\mathbb{A}^1}(BGL_n)=\mathbb{G}_m
          %p
            The Nisnevich sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo −
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{n-1}^{\mathbb{A}^1}(\mathbb{A}^n-0)
            is the n-th Milnor–Witt K-theory sheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi K
                      %mi n
                      %mi MW
                  %annotation{:encoding => "application/x-tex"} \mathbf{K}^{MW}_n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi Nis
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msubsup
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔸
                    %mi n
                  %mo −
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} det
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mover
                      %mi CH
                      %mo ˜
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi{:mathvariant => "normal"} det
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n_{Nis}(X,\pi_{n-1}^{\mathbb{A}^1}(\mathbb{A}^n-0)(\mathrm{det} \xi)) \cong \widetilde{CH}^n(X; \mathrm{det} \xi)
          %p
            is the n-th oriented
            %a.existingWikiWord{:href => "/nlab/show/Chow+group"} Chow group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e(\xi)
            can be identified with the top Chern class of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
          %h3#MotivicCohomology Motivic cohomology
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth scheme
            over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
            of smooth
            = succeed "-schemes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} H
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{H}(S)
            and in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SH
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SH(S)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≥
                    %mi q
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p\geq q\geq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(A(q),p)
            = succeed "," do
              %em motivic Eilenberg–MacLane space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Sm
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X\in Sm/S
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo −
                      %mi r
                      %mo ,
                      %mi q
                      %mo −
                      %mi s
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Σ
                    %mrow
                      %mi r
                      %mo ,
                      %mi s
                  %msub
                    %mi X
                    %mo +
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} H^{p-r,q-s}(X,A) = [\Sigma^{r,s}X_+, K(A(q),p)].
          %p
            Voevodsky’s
            %em cancellation theorem
            implies that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi T
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega_T K(A(q+1), p+2)\simeq K(A(q), p)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A(n),2n)
            form a
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(A)
            = succeed "," do
              %em motivic Eilenberg–MacLane spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi Σ
                    %mi T
                    %mn ∞
                  %msub
                    %mi X
                    %mo +
                  %mo ,
                  %msup
                    %mi Σ
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} H^{p,q}(X,A) = [\Sigma_T^\infty X_+, \Sigma^{p,q} H(A)].
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(R)
            has a canonical structure of
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            which induces the ring structure in motivic cohomology.
          %p
            Unlike in topology,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(\mathbb{Q})
            is not always equivalent to the rational motivic sphere spectrum
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi ℚ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0_{\mathbb{Q}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            is a sum of squares in the base field. In general,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(\mathbb{Q})
            is a direct summand of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi ℚ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0_{\mathbb{Q}}
          %p
            The stable (∞,1)-category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(\mathbb{Q})
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            is equivalent to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derived+category+of+mixed+motives"} derived category of mixed motives
          %h3#algebraic_ktheory Algebraic K-theory
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory+spectrum"} algebraic K-theory spectrum
          %h3#AlgebraicCobordism Algebraic cobordism
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+cobordism"} algebraic cobordism
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motive"} motive
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/slice+spectral+sequence"} slice spectral sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/B1-homotopy+theory"} B1-homotopy theory
            %li
              %p
                There is an analog of
                = succeed "-homotopy" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive (infinity,1)-topos
                may realize the localization at an abstract
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
                for more details.
          %h2#references References
          %h3#general General
          %p The original references:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
                ,
                = succeed "-Homotopy" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi A
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbf{A}^1
                %a{:href => "http://www.math.uiuc.edu/documenta/xvol-icm/00/Voevodsky.MAN.html"} web
            %li#MorelVoevodsky99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"}> Fabien Morel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                    \-homotopy theory of schemes
                %a{:href => "http://www.numdam.org/item/?id=PMIHES_1999__90__45_0"} Numdam:PMIHES_1999__90__45_0
                %a{:href => "https://faculty.math.illinois.edu/K-theory/0305/"} K-Theory:0305
                )
            %li#Morel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"}> Fabien Morel
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                    \-algebraic topology over a field
                = succeed ")" do
                  %a{:href => "https://www.mathematik.uni-muenchen.de/~morel/Prepublications/A1TopologyLNM.pdf"} pdf
            %li#AsokMorel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aravind+Asok"}> Aravind Asok
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
                = succeed "," do
                  %em
                    Smooth varieties up to
                    = succeed "-homotopy" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi 𝔸
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                %strong 227
                (5) (2011) 1990-2058 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0810.0324"}> arXiv:0810.0324
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2011.04.009"} doi:10.1016/j.aim.2011.04.009
          %p Readable introductions to the subject are:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bj%C3%B8rn+Ian+Dundas"}> Bjørn Ian Dundas
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"} Marc Levine
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Arne+%C3%98stv%C3%A6r"} Paul Arne Østvær
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+R%C3%B6ndigs"} Oliver Röndigs
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
                = succeed "," do
                  %em Motivic Homotopy Theory: Lectures at a Summer School in Nordfjordeid, Norway, August 2002
                = succeed ")" do
                  %a{:href => "https://www.springer.com/de/book/9783540458951"} doi:10.1007/978-3-540-45897-5
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %em Motivic Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.unam.mx/~javier/levine.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"}> Fabien Morel
                ,
                = succeed "," do
                  %em
                    An introduction to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                    homotopy theory
                = succeed "," do
                  %a{:href => "http://publications.ictp.it/lns/vol15/vol15toc.html"} directory
                = succeed "," do
                  %a{:href => "http://www.ictp.it/%7Epub_off/lectures/lns015/Morel/Morel.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://www.mathematik.uni-muenchen.de/~morel/Prepublications/lectureTrieste.ps"} ps
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"}> Fabien Morel
                ,
                %em On the motivic stable π₀ of the sphere spectrum
                (
                %a{:href => "https://www.mathematik.uni-muenchen.de/~morel/Prepublications/Newton.ps"}> ps
                )
            %li#Arndt17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Arndt"}> Peter Arndt
                ,
                = succeed "," do
                  %em Abstract motivic homotopy theory
                = succeed "," do
                  %a{:href => "https://repositorium.ub.uni-osnabrueck.de/handle/urn:nbn:de:gbv:700-2017021015476?mode=full"} web
                = succeed "," do
                  %a{:href => "https://repositorium.ub.uni-osnabrueck.de/bitstream/urn:nbn:de:gbv:700-2017021015476/6/thesis_arndt.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/ArndtAbstractMotivic.pdf", :title => "pdf"} pdf
              %p#Arndth19
                exposition: lecture at
                = succeed "," do
                  %em
                    %a{:href => "https://felix-cherubini.de/abstracts.html"} Geometry in Modal HoTT
                = succeed "," do
                  %a{:href => "https://www.youtube.com/watch?v=f0wpcNs8hQo"} recording I
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=sTl8637a2Zo"} recording II
          %p
            Detailed discussion of the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich site
            and its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+F.+Jardine"}> John F. Jardine
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Local+homotopy+theory"} Local homotopy theory
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-1-4939-2300-7"} doi:10.1007/978-1-4939-2300-7
          %p with brief exposition in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+F.+Jardine"}> John F. Jardine
              ,
              %em Motivic spaces and the motivic stable category
              \&amp;lbrack;
              %a{:href => "http://www.aimath.org/WWN/motivesdessins/motivic.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Jardine-MotivicSpaces.pdf", :title => "pdf"} pdf
          %p
            For more on the general procedure see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
          %p
            The universal property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SH
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SH(S)
            is proved in
          %ul
            %li#Robalo
              %a.existingWikiWord{:href => "/nlab/show/Marco+Robalo"}> Marco Robalo
              ,
              = succeed "," do
                %em Noncommutative Motives I: A Universal Characterization of the Motivic Stable Homotopy Theory of Schemes
              = succeed ")" do
                %a{:href => "http://arxiv.org/pdf/1206.3645v3.pdf"} pdf
          %p
            For the formalism of
            %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            see
          %ul
            %li#Ayoub
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
                ,
                %em Les six opérations de Grothendieck et le formalisme des cycles évanescants dans le monde motivique
                PhD thesis, Paris &amp;lbrack;
                %a{:href => "http://www.math.uiuc.edu/K-theory/0761/THESE.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://faculty.math.illinois.edu/K-theory/0761"} K:0761
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
                ,
                = succeed "," do
                  %em Les six opérations de Grothendieck et le formalisme des cycles évanescents dans le monde motivique (I)
                %strong 314
                (2007) &amp;lbrack;
                %a{:href => "http://www.numdam.org/issues/AST_2007__314__R1_0"}> numdam:AST_2007__314__R1_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
                ,
                = succeed "," do
                  %em Les six opérations de Grothendieck et le formalisme des cycles évanescents dans le monde motivique (II)
                %strong 315
                (2007) &amp;lbrack;
                %a{:href => "http://www.numdam.org/issues/AST_2007__315__1_0"}> numdam:AST_2007__315__1_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
                %em Voevodsky’s lectures on cross functors
                (
                %a{:href => "https://www.math.ias.edu/vladimir/sites/math.ias.edu.vladimir/files/2015_transfer_from_ps_delnotes01.pdf"}> pdf
                )
          %p The slice filtration was defined in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
              ,
              %em Open problems in the stable motivic homotopy theory
              K-theory, 0392 (
              %a{:href => "https://faculty.math.illinois.edu/K-theory/0392/"} web
              = succeed ")" do
                %a{:href => "https://faculty.math.illinois.edu/K-theory/0392/nowmovo.pdf"} pdf
          %p Representability results:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aravind+Asok"}> Aravind Asok
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"} Marc Hoyois
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Wendt"} Matthias Wendt
                = succeed "," do
                  %em
                    Affine representability results in
                    = succeed "-homotopy" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi 𝔸
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                %strong 166
                10 (2017) 1923-1953 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1506.07093"}> arXiv:1506.07093
                ,
                = succeed "&rbrack;" do
