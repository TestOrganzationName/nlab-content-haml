            %li
              %p
                Tonny A. Springer,
                = succeed "," do
                  %em Linear algebraic groups
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1642713"} MR1642713
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Mumford"}> David Mumford
                ,
                = succeed "," do
                  %em Abelian varieties
            %li
              %p
                A. Polishchuk,
                = succeed "," do
