              %p
                Bull. London Math. Soc. (1980) 12 (6): 476-478,
                %a{:href => "http://dx.doi.org/10.1112/blms/12.6.476b"} doi
            %li
              %p SGA III
            %li
              %p
                J. S. Milne,
                = succeed "," do
                  %em Abelian varieties
                %a{:href => "http://www.jmilne.org/math/CourseNotes/AV.pdf"} pdf
