            %li
              D. Eisenbud,
              = succeed "," do
                %em Commutative algebra: with a view toward algebraic geometry
            %li
              James Milne,
              = succeed "," do
                %em A primer of commutative algebra
              = succeed "," do
                %a{:href => "http://www.jmilne.org/math/xnotes/ca.html"} webpage
              %a{:href => "http://www.jmilne.org/math/xnotes/CA.pdf"} pdf
          %h2#algebraic_groupsgroup_schemes_fouriermukai_transform Algebraic groups/group schemes; Fourier-Mukai transform
          %ul
            %li
              %p
                William C. Waterhouse,
                = succeed "," do
