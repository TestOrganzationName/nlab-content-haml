          %p
          #TheDefinition.num_defn
            %h6 Definition
            %p
              A
              %strong Heyting field
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
              where every non-
              %a.existingWikiWord{:href => "/nlab/show/invertible"} invertible
              %a.existingWikiWord{:href => "/nlab/show/element"} element
              is
              %a.existingWikiWord{:href => "/nlab/show/equal"} equal
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero"} zero
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is non-trivial (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≠
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 0 \neq 1
                  );
              %li
                %p
                  given elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} a \in R
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} b \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo +
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a + b
                  is invertible, then either
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is invertible or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is invertible;
              %li
                %p
                  given an element
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} a \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is non-invertible, then
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} a = 0
            %p
          %p Equivalently, a Heyting field is:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                whose
                %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
                by the
                %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
                of non-invertible elements is
                %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
                to
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
            %li
              %p
                a local ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                such that the canonical
                %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo #
                    %annotation{:encoding => "application/x-tex"} \#
                — defined as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo #
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \# b
                if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo −
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a - b
                is invertible — is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
                which is both
                %a.existingWikiWord{:href => "/nlab/show/reduced+ring"} reduced
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Artinian+ring"} Artinian
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
                which is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/semiprimitive+ring"} semiprimitive ring
          %p
          #TrivialRingAsAField.num_remark
            %h6 Remark
            %p
              In
              = succeed "," do
                %a{:href => "#LombardiQuitté2010"} Lombardi &amp; Quitté (2010)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 \neq 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 = 0
              %a.existingWikiWord{:href => "/nlab/show/trivial+ring"} trivial ring
              counts as a Heyting field and constitutes the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} categories
              of Heyting fields.
          %h2#properties  Properties
          %h3#stable_equality Stable equality.
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/Heyting+field"} Heyting field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+equality"} stable equality
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo #
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \# b
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo −
                  %mi b
                %annotation{:encoding => "application/x-tex"} a - b
            is invertible. For all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a \in R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} b \in R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg \neg \neg (a \# b) \iff \neg (a \# b)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \neg (a \# b) \iff a = b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \neg \neg (a = b) \iff a = b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has stable equality.
          %h3#decidable_tight_apartness Decidable tight apartness
          %p
            A Heyting field with
            %a.existingWikiWord{:href => "/nlab/show/decidable+tight+apartness"} decidable tight apartness
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+field"} discrete field
          %h2#weak_heyting_fields Weak Heyting fields
          %p
            A
            %strong weak Heyting field
            (cf.
            = succeed ")" do
              %a{:href => "#Richman20"} Richman (2020)
            %strong Johnstone residue field
            is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            which only satisfy
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            1 and 3 in Def.
            = succeed "." do
              %a.maruku-ref{:href => "#TheDefinition"}
            %a{:href => "#Johnstone77"} Johnstone (1977)
            referred these as a
            = succeed ";" do
              %em residue field
            %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
            in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            as the
            %a.existingWikiWord{:href => "/nlab/show/quotient+field"} quotient field
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
          %p
            If every weak Heyting field with decidable equality is a Heyting field, then
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            follows. The following proof is due to Mark Saving:
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              be a proposition. We define the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              to be the union of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi ℚ
                    %mo{:stretchy => "false"} |
                    %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x \in \mathbb{Q} \vert p\}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi p
                %annotation{:encoding => "application/x-tex"} R_p
            is a
            %a.existingWikiWord{:href => "/nlab/show/subring"} subring
            of the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi p
                %annotation{:encoding => "application/x-tex"} R_p
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            has decidable equality,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi p
                %annotation{:encoding => "application/x-tex"} R_p
            also has decidable equality. And of course
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≠
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0\neq 1
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a weak Heyting field iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \neg \neg p
          %p
          .proof
            %h6 Proof
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \neg \neg p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi R
                        %mi p
                    %annotation{:encoding => "application/x-tex"} x\in R_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              does not have a multiplicative inverse. Now suppose
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x\neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x^{-1}
              is not in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi p
                    %annotation{:encoding => "application/x-tex"} R_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              held, we would have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %mo ∈
                      %msub
                        %mi R
                        %mi p
                    %annotation{:encoding => "application/x-tex"} x{-1} \in R_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \neg p
              holds. But this is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contradiction"} contradiction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              must be zero (using decidable equality).
            %p
              Conversely, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a weak Heyting field. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \neg p
              held, we would have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi p
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} R_p = \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              is neither invertible nor zero. So we must have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \neg \neg p
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a Heyting field iff it is the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a discrete field.
          %p
          .proof
            %h6 Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a Heyting field. Then either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
              has a multiplicative inverse, so either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} 2^{-1} \in R_p
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 3
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∈
                      %msub
                        %mi R
                        %mi p
                    %annotation{:encoding => "application/x-tex"} 3^{-1} \in R_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              holds. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              holds, then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi p
                      %mo =
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} R_p = \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi p
                  %annotation{:encoding => "application/x-tex"} R_p
              is a discrete field, it is clearly a Heyting field.
          %p
          .num_theorem
            %h6 Theorem
            %p
              If every weak Heyting field with discrete equality is Heyting, then
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              is valid.
          %p
          .proof
            %h6 Proof
            %p
              From the lemmas above, if every weak Heyting field with decidable equality is a Heyting field, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⇔
                    %mo ¬
                    %mo ¬
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p \iff \neg \neg p
              holds for all propositions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
