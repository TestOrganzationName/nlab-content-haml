                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \mathbf{B}^k U(1)
            %li
              %p the observation that this is lifted to connections and differential refinement by
              %ol
                %li
                  %p
                    thickening the simplicial presheaf for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
