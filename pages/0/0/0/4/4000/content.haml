                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on a
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em trivialization
            of its corresponding Chern-Simons 3-bundle. This in particular implies a trivialization of the underlying cocycle in degree 4
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            and therefore defines a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            = succeed "s." do
