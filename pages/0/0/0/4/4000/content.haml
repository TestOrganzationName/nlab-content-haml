                    \\stackrel{(cs,\langle -\rangle)}{\leftarrow}
                    W(b^2 \mathbb{R})
                    \\,.
            %p The remaining fiber integration is then that exhibiting the equivalence of simplicial differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
