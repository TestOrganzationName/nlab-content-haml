                          }
                          \\right\}
                %li
                  %p thickening the Lie algebra cocycle by its Chern-Simons element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi CE
