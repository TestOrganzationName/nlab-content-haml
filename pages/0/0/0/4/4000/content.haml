                          %mi Δ
                          %mo •
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi diff
                        %mo ,
                        %mi simp
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi diff
                        %mo ,
                        %mi chn
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^\bullet} :
                    \\mathbf{\flat}_{dR} \mathbf{B}^3 U(1)_{diff,simp}
                    \\stackrel{\simeq}{\to}
                    \\mathbf{\flat}_{dR} \mathbf{B}^3 U(1)_{diff,chn}
            %p
              that is described in some detail at
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/circle+n-bundle+with+connection#U1FromLieIntegration"} Circle n-bundle with connection – models from ∞-Lie integration
          %h4#as_a_bundle_2gerbe As a bundle 2-gerbe
          %p
            We indicate (for the moment) the way the Chern-Simons 3-bundle is realized as a
            %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            (for instance in
            %a{:href => "#CJMS"} CJMS
            and
            = succeed ")" do
              %a{:href => "#WaldorfCS"} Waldorf CS
          %p
            One first constructs the canonical
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \to G
            on the Lie group and notices that (more or less implicitly by recourse to its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            2-gerbe on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %em multiplicative structure
            \.
          %p
            Using this we see that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mi P
                  %msub
                    %mo ×
                    %mi X
                  %mi P
                  %mo →
                  %mi P
                  %mo ×
                  %mi G
                %annotation{:encoding => "application/x-tex"} P^{[2]} : = P \times_X P \to P \times G
            the principality isomorphism, the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            along
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi P
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                  %mo →
                  %mi P
                  %mo ×
                  %mi G
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  f : P^{[2]} \to P \times G \stackrel{p_2}{\to} G
          %p serves to provide the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi f
                            %mo *
                          %mi 𝒢
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi P
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mn 2
                              %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mo →
                        %mtd
                          %mi P
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  f^* \mathcal{G}
                  \\\
                  \\downarrow
                  \\\
                  P^{[2]} &amp;\stackrel{\to}{\to}&amp; P
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; X
                  }
          %p
            on which the pullback of the multiplicative structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            induces the structure of a bundle 2-gerbe, in that we get morphisms of bundle gerbes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %msubsup
                    %mi π
                    %mn 0
                    %mo *
                  %msup
                    %mi f
                    %mo *
                  %mi 𝒢
                  %mo ⊗
                  %msubsup
                    %mi π
                    %mn 2
                    %mo *
                  %msup
                    %mi f
                    %mo *
                  %mi 𝒢
                  %mo →
                  %msubsup
                    %mi π
                    %mn 2
                    %mo *
                  %msup
                    %mi f
                    %mo *
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\mu : \pi_0^{\ast} f^{\ast} \mathcal{G} \otimes \pi_2^{\ast} f^{\ast} \mathcal{G} \to \pi_2^* f^* \mathcal{G}
          %p that are associative up to a higher coherent morphisms, etc.
          %h3#in_complex_analytic_geometry__for_complex_lie_groups In complex analytic geometry – For complex Lie groups
          %p
            (…) (
            %a{:href => "#Brylinski00"}> Brylinski 00
            ) (…)
          %h3#ForReductiveAlgebraicGroups In arithmetic geometry – For reductive groups
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/reductive+algebraic+group"} reductive algebraic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            there is no sensible element in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^3(\mathbf{B}G, \mathbb{G}_m)
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K_2(R)
            for the degree-2
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            of a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            (e.g.
            = succeed ")" do
              %a{:href => "algebraic+K-theory#Isely05"} Isely 05, section 4
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{K}_2
            for corresponding
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            on the suitable
            %a.existingWikiWord{:href => "/nlab/show/etale+site"} etale site
            (e.g.
            = succeed ")." do
              %a{:href => "#DeligneBrylinski01"} Deligne-Brylinski 01, page 6
          %p Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi B
                  %msub
                    %mi G
                    %mi ℂ
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^4(B G_{\mathbb{C}}, \mathbb{Z})
                  \\simeq
                  H^2(\mathbf{B}G, \mathbf{K}_2)
          %p
            This is (
            %a{:href => "#HKLV98"}> HKLV 98, theorem 4.11
            ) also (
            %a{:href => "#DeligneBrylinski01"}> Deligne-Brylinski 01
            ), going back to (
            %a{:href => "#Bloch80"}> Bloch 80
            ). See also (
            %a{:href => "#Kapranov00"}> Kapranov 00, (2.1)
            ,
            = succeed ")." do
              %a{:href => "http://mathoverflow.net/a/24862/381"} MO discussion
          %p
            Notice that over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            the
            %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulator"} Beilinson regulator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 2
                %annotation{:encoding => "application/x-tex"} c_{1,2}
            (e.g.
            = succeed ")" do
              %a{:href => "#Brylinski94"} Brylinski 94, theorem, 3.3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^1(X, \mathbf{K}_2) \longrightarrow H^2(X, \mathbb{G}_m)
                  \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
                of a Chern-Simons circle 3-bundle is the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                for
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %li
              %p
                For the case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi O
                    %annotation{:encoding => "application/x-tex"} G = O
                is the
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi O
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}O
                the classifying map of the
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %em with connection
                is a
                %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                For products of torus groups and the
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
                class the same construction yields the
                %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} T-duality 2-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+Chern-Simons+n-bundle"} universal Chern-Simons n-bundle
              %ul
                %li
                  %p
                    %strong Chern-Simons circle 3-bundle
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+7-bundle"} Chern-Simons circle 7-bundle
          %p
            The CS 3-bundle 3-connection is the
            %a.existingWikiWord{:href => "/nlab/show/extended+Lagrangian"} extended Lagrangian
            for ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang+monopole"} Yang monopole
          %h2#references References
          %h3#for_lie_groups For Lie groups
          %h4#the_cechdeligne_cohomology_realization The Cech-Deligne cohomology realization
          %p
            As cocycles in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            the Chern-Simons 2-gerbe has been constructed explicitly in
          %ul
            %li#GeomConstructionFirst
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"} Jean-Luc Brylinski
              and Dennis McLaughlin,
              %em A geometric construction of the first Pontryagin class
              (1993) (
              %a{:href => "http://www.math.uni-hamburg.de/home/schreiber/Brylinski-McLaughlin-I.pdf"}> pdf
              )
          %p as a special case of the general construction in
          %ul#CechCocyclesForCharClasses
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"} Jean-Luc Brylinski
              and Dennis McLaughlin,
              %em Cech cocycles for characteristic classes
              , Communications in Mathematical Phiysics, Volume 178, Number 1, (
              %a{:href => "http://www.springerlink.com/content/762g1m76jp6425x5/"}> Springer
              )
          %h4#2GerbeReferences The 2-gerbe realization
          %p
            Conceived as a genuine
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            the Chern-Simons 2-gerbe appears in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"} Jean-Luc Brylinski
              and Dennis McLaughlin,
              %em The geometry of degree-4 characteristic classes and of line bundles on loop spaces II
              (
              %a{:href => "http://www.math.uni-hamburg.de/home/schreiber/Brylinski-McLaughlin-Duke-II.pdf"}> pdf
              ).
          %p
            Among the first references to apply specifically
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            technology to this construction is
          %ul#CJMS
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alan+Carey"}> Alan Carey
              , Stuart Johnson,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"} Michael Murray
              %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bai-Ling+Wang"} Bai-Ling Wang
              %em Bundle gerbes for Chern-Simons and Wess-Zumino-Witten theories
              Communications in Mathematical Physics, 259 (3). (2005) (
              %a{:href => ""}> arXiv
              )
          %p This was later refined in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              %em Multiplicative Bundle Gerbes with Connection
              (
              %a{:href => "http://arxiv.org/abs/0804.4835"}> arXiv:0804.4835
              )
          %p Here are some slides from talks:
          %ul#WaldorfCS
            %li
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              %em Multiplicative gerbes and Chern-Simons theory
              (
              %a{:href => "http://www.konradwaldorf.de/docs/bonn.pdf"}> pdf
              )
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Gawedzki"}> Krzysztof Gawedzki
              ,
              %em Wess-Zumino-Witten and Chern-Simons theories for non-simply connected Lie groups
              (
              %a{:href => "http://dftuz.unizar.es/ftzar/activities/highenergy09_talks/gawedzki.pdf"}> pdf
              )
          %p
            The full Chern-Simons circle 3-connection on the full
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} \to \mathbf{B}^3 U(1)_{conn}
            was then constructed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Cech+Cocycles+for+Differential+characteristic+Classes"} Cech Cocycles for Differential characteristic Classes
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1011.4735"} arXiv:1011.4735
          %p Exposition of this and further developments are in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/A+higher+stacky+perspective+on+Chern-Simons+theory"} A higher stacky perspective on Chern-Simons theory
          %h3#ReferencesForComplexReductiveGroups For complex reductive groups
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            of multiplicative Chern-Simons
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+line+2-bundles"} holomorphic line 2-bundles
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
                , around theorem 5.4.10 (p. 226-227) of
                = succeed "," do
                  %em Loop spaces and characteristic classes
            %li#Brylinski00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
                ,
                %em Gerbes on complex reductive Lie groups
                (
                %a{:href => "http://arxiv.org/abs/math/0002158"}> arXiv:math/0002158
                )
          %p
            The relevant
            %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulator"} Beilinson regulator
            is discussed also in
          %ul
            %li#Brylinski94
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
              ,
              = succeed "," do
                %em Holomorphic gerbes and the Beilinson regulator
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Brylinski94.pdf", :title => "pdf"} pdf
          %h3#for_reductive_algebraic_groups For reductive algebraic groups
          %p
            For the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/reductive+algebraic+groups"} reductive algebraic groups
          %ul
            %li#Bloch80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Spencer+Bloch"}> Spencer Bloch
                ,
                = succeed "," do
                  %em The dilogarithm and extensions of Lie algebras
                = succeed ")" do
                  %a{:href => "http://link.springer.com/chapter/10.1007%2FBFb0089515"} publisher
            %li#HKLV98
              %p
                %a.existingWikiWord{:href => "/nlab/show/H%C3%A9l%C3%A8ne+Esnault"}> Hélène Esnault
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bruno+Kahn"} Bruno Kahn
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"} Marc Levine
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eckart+Viehweg"} Eckart Viehweg
                = succeed "," do
                  %em The Arason invariant and mod 2 algebraic cycles
                = succeed "," do
                  %a{:href => "https://www.uni-due.de/~bm0032/publ/Arason.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.ams.org/journals/jams/1998-11-01/S0894-0347-98-00248-3/"} publisher page
            %li#Kapranov00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                %em The elliptic curve in the S-duality theory and Eisenstein series for Kac-Moody groups
                (
                %a{:href => "http://arxiv.org/abs/math/0001005"}> arXiv.math/0001005
                )
            %li#DeligneBrylinski01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"} Jean-Luc Brylinski
                = succeed "," do
                  %em
                    Central extensions of reductive groups by
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi K
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} K_2
                = succeed "," do
                  %a{:href => "http://publications.ias.edu/node/424"} web
                = succeed ")" do
                  %a{:href => "http://publications.ias.edu/sites/default/files/78_ReductiveGroupsK2.pdf"} pdf
            %li
              %p
                %a{:href => "http://mathoverflow.net/a/24862/381"} MO discussion
