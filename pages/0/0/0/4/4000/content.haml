                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \langle -\rangle : CE(b^3\mathbb{R})\to W(\mathfrak{g})
            its canonical
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
