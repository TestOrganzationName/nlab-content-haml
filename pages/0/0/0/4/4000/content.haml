                    %msub
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CS(\hat A_{i j})
              is the image of the degree 3-generator on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(b^2 \mathbb{R})
              under the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi vert
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %mi i
                            %mi j
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi cs
                        %mo ,
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} )
                    %mi W
