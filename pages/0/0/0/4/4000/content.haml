                %annotation{:encoding => "application/x-tex"} \mu = \langle -,[-,-]\rangle: CE(b^2\mathbb{R})\to CE(\mathfrak{g})
            the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cs
                  %mo :
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mn 2
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} cs: W(b^2\mathbb{R})\to W(\mathfrak{g})
            the Chern-Simons elements exhibiting the transgression between the two,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            the
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrating
            it.
          %p
            First consider the bare cocycle for the Chern-Simons circle 3-bundle as the
            %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#IntegrationOfCocycles"} Lie integration of the cocycle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
          .num_def
            %h6#definition Definition
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g}) : (U,[n])
                    \\mapsto
                    \\{C^\infty(U) \otimes \Omega^\bullet(\Delta^n) \leftarrow CE(\mathfrak{g})\}
                    \\,,
            %p
              where here and in what follows differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on simplices are taken to have
              %em sitting instants
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              there exists for every
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              an open neighbourhood such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              restricted to that open neighbourhood is constant in the direction perpendicular to the boundary.
          .num_lemma
            %h6#lemma Lemma
            %p The canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{cosk}_3 \exp(\mathfrak{g}) \to \mathbf{B}G
            %p
              from the 3-
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
              to the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the simply connected Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              which is given on 1-morphisms by
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              is an equivalence ( in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
          .proof
            %h6#proof_2 Proof
            %p
              Use that a
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k \leq 2
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_k(G) = 0
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              for more.
          .num_prop
            %h6#proposition_2 Proposition
            %p There is a commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ∫
                                    %mrow
                                      %msup
                                        %mi Δ
                                        %mo •
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g}) &amp;\stackrel{\exp(\mu)}{\to}&amp; \exp(b^2 \mathbb{R})
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\int_{\Delta^\bullet}}}
                    \\\
                    \\mathbf{cosk}_3 \exp(\mathfrak{g}) &amp;\stackrel{}{\to}&amp;
                    \\mathbf{B}^3 \mathbb{R}/\mathbb{Z}
                    }
                    \\,,
            %p where the right vertical morphism is the composite of the equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mo •
                    %mo :
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^\bullet}  : \exp(b^2 \mathbb{R}) \stackrel{\simeq}{\to} \mathbf{B}^3 \mathbb{R}
            %p
              discussed at
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#IntegrationOfBnR"} Integration to Line n-groups
              with the evident quotient
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi ℝ
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^3 \mathbb{R} \to \mathbf{B}^3 \mathbb{R}/\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is the lattice of periods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              over 3-spheres in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            The top morphism sends a
            = succeed "-family" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 3
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mi A
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U \times \Delta^3) \stackrel{A}{\leftarrow} CE(\mathfrak{g})
            – which we may think of as a
            = succeed "-family" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo :
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 3
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Sigma : U \times \Delta^3 \to G
            – to the family of 3-forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi vert
                  %mover
                    %mo ←
                    %mi A
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mi μ
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mn 2
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi μ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(U \times \Delta^k)_{vert} \stackrel{A}{\leftarrow} CE(\mathfrak{g})
                  \\stackrel{\mu}{\leftarrow}
                  CE(b^2 \mathbb{R})
                  \:
                  \\mu^*(A)
                  \\,.
          %p which we may think as a family of closed 3-forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi μ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi vert
                %annotation{:encoding => "application/x-tex"}
                  \\mu^*(A)\in \Omega^\bullet(U \times \Delta^k)_{vert}
          %p
            The right vertical morphism sends this to the
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↦
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Δ
                        %mn 3
                  %msup
                    %mi μ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ;
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U \mapsto \int_{\Delta^3} \mu^*(A) \;\;\; \in C^\infty(U;\mathbb{R})
          %p
            and regards the result then modulo
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g})
            – which is a 3-sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %msup
                    %mi S
                    %mn 3
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} V : S^3 \to G
            – we have that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 3
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mi μ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \int_{S^3} V^* \mu^*(A) = 0 \;mod\; \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to be precisely generated by these periods. (Alternatively we can assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            to be normalized such that it generates the image in deRham cohomology of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H^3(G,\mathbb{Z}) \simeq \mathbb{Z}
          %p
            We shall by slight abuse of notation write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mu)
            also for the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g}) \to \mathbf{B}^3 \mathbb{R}/\mathbb{Z}
          .num_lemma
            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} C(U) \in [CartSp^{op}, sSet]_{proj}
              the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              we have that
            %ul
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} g : C(U) \to \mathbf{B}G
                  is precisely a Cech 1-cocycle with values in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              %li
                %p a lift
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi cosk
                                  %mn 3
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mover
                                      %mi g
                                      %mo{:stretchy => "false"} ^
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mo ≃
                            %mtr
                              %mtd
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mi g
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; \mathbf{cosk}_3 \exp(\mathfrak{g})
                        \\\
                        \&amp; {}^{\mathllap{\hat g}}\nearrow &amp; \downarrow^{\mathrlap{\simeq}}
                        \\\
                        C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                        }
                %p
                  is precisely a lift of this cocycle to a system of paths, triangles and tetrahedra in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "." do
                    %a{:href => "#InCechDelineCohomology"} above
          .num_def
            %h6#definition_2 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff}
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi Ω
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi vert
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %msup
                                %mi Ω
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ←
                            %mtd
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (U,[n]) \mapsto
                    \\left\{
                    \\array{
                    \\Omega^\bullet(U \times \Delta^k)_{vert}
                    \&amp;\stackrel{}{\leftarrow}&amp; CE(\mathfrak{g})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\Omega^\bullet(U \times \Delta^k)
                    \&amp;\leftarrow&amp;
                    W(\mathfrak{g})
                    }
                    \\right\}
                    \\,.
          %p
            Its 3-
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo →
                  %mi inn
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g} \to inn(\mathfrak{g}))
            is the coefficient for
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/pseudo-connection"} pseudo-connection
            adapted to the model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g})
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              Pseudo-connections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∇
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \nabla
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mo ∇
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{cosk}_3 \exp(\mathfrak{g})_{diff}
                    \\\
                    \&amp;{}^{\mathllap{\hat \nabla}}\nearrow&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \&amp;&amp; \mathbf{cosk}_3 \exp(\mathfrak{g})
                    \\\
                    \&amp; {}^{\mathllap{\hat g}}\nearrow &amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
            %p
              which are
              %em genuine
              = succeed "-connections" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} C(U) \to \mathbf{B}G
          .proof
            %h6#proof_3 Proof
            %p
              On single patches
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∇
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \nabla
              is a collection of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi i
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_i \in \Omega^1(U_i, \mathfrak{g})
            %p On double intersection it is a collection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo +
                    %msub
                      %mi λ
                      %mrow
                        %mi i
                        %mi j
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat A_{i j} = A_{i j} + \lambda_{i j} \in
                    \\Omega^1(U_i \cap U_j, \mathfrak{g})\otimes C^\infty(\Delta^1) \oplus
                    C^\infty(U)\otimes \Omega^1(\Delta^1, \mathfrak{g})
                    \\subset \Omega^1(U_i \cap U_j  \times \Delta^1, \mathfrak{g})
            %p
              whose restriction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \lambda_{i j}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1
              is the given path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \hat g_{i j}
              that is being covered. The condition that the curvature of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \hat A_{i j}
              has no component in the simplicial direction is the
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi t
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                    %mo ,
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial}{\partial t} A_{i j} = d_U (\lambda_{i j})_t + [(\lambda_{i j})_t, A_{i j}]
                    \\,.
            %p
              This differential equation has a unique solution for the boundary condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} A_{i j}(0) = A_i
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_{i j}(t) = \hat g_{i j}(t)^{-1}(A_i + d)\hat g_{i j}(t)
                    \\,.
            %p
              (To see this, use the formulas from
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
              then we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi t
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                    %mo ⋅
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial t} \hat g_{i j} = \hat g_{i j} \cdot \lambda
              (by definition) and using that the claim follows.)
            %p In particular this implies the forms on single patches satisfy the ordinary cocycle relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mi j
                    %mo =
                    %msubsup
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"}
                    A_{i j}(1) = A_j = g_{i j}^{-1}(A_i + d)g_{i j}
            %p for connections.
            %p Similarly there are differential equations on 2-simplices and 3-simplices with unique solutions.
          .num_lemma
            %h6#observation_2 Observation
            %p Pasting postcomposition with the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi μ
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi cs
                                %mo ,
                                %mo{:stretchy => "false"} ⟨
                                %mo{:stretchy => "false"} ⟩
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g}) &amp;\stackrel{\mu}{\leftarrow}&amp; CE(b^2 \mathbb{R})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    W(\mathfrak{g}) &amp;\stackrel{(cs,\langle \rangle)}{\leftarrow}&amp;
                    W(b^2 \mathbb{R})
                    }
            %p
              induces a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo →
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff} \to \exp(b^2\mathbb{R})_{diff}
              and we obtain a commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                          %mtd
                            %mo →
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi chn
                                %mo ,
                                %mi diff
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g})_{diff} &amp;\to&amp; \exp(b^2\mathbb{R})_{diff}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{cosk}_3\exp(\mathfrak{g})_{diff} &amp;\to&amp;
                    \\mathbf{B}^3 U(1)_{chn,diff}
                    }
            %p that covers the corresponding diagram we had before.
          %p
            Here we are using the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi ch
                      %mo ,
                      %mi diff
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^3 U(1)_{ch,diff}
            described in detail at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
          .num_remark
            %h6#remark Remark
            %p The deeper reason for this construction is that the zig-zag composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mover
                      %mo ←
                      %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi diff
                        %mo ,
                        %mi chn
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 4
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi chn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G
                    \\stackrel{\simeq}{\leftarrow}
                    \\mathbf{cosk}_3\exp(\mathfrak{g})_{diff}
                    \\to
                    \\mathbf{B}^3 U(1)_{diff,chn}
                    \\to
                    \\mathbf{\flat}_{dR}\mathbf{B}^4 U(1)_{chn}
            %p of morphisms of simplicial presheaves models the intrinsically defined morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 4
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G \to \mathbf{\flat}_{dR}\mathbf{B}^4 U(1)
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          .num_prop
            %h6#proposition_3 Proposition
            %p The outer composite morphism
            .maruku-equation
