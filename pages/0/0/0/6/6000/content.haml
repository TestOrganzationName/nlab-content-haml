                    %mo ⋅
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y = g \cdot x
          %p
            This is equivalent to saying that the
            %a.existingWikiWord{:href => "/nlab/show/shear+map"} shear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                          %mo ×
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi pr
                                %mn 2
                              %mo ,
                              %mo ⋅
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi x
                          %mo ,
                          %mi g
                          %mo ⋅
                          %mi x
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G \times X
                  \&amp;
                  \\overset
                  { (pr_2, \cdot) }
                  {\longrightarrow}&amp;
                  X \times X
                  \\\
                  (g, x)
                  \&amp;
                  \\mapsto
                  \&amp;
                  \\big( x, g \cdot x \big)
                  \\,.
                  }
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            %a.existingWikiWord{:href => "/nlab/show/action+objects"} action objects
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to any ambient
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            (where one may want to require
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+epimorphisms"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphisms"} effective
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
          %p
            Beware that often it is assumed that the underlying
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of a transitive action is
            %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
            (but not always, see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/pseudo-torsor"}> pseudo-torsor
              ).
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k\ge 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} G \times X \to X
            is said to be
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-transitive
            if the componentwise-action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %msup
                    %mi X
                    %munder
                      %mi k
                      %mo ̲
                  %mo →
                  %msup
                    %mi X
                    %munder
                      %mi k
                      %mo ̲
                %annotation{:encoding => "application/x-tex"} G \times X^{\underline{k}} \to X^{\underline{k}}
            is transitive, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %munder
                      %mi k
                      %mo ̲
                %annotation{:encoding => "application/x-tex"} X^{\underline{k}}
            denotes the set of tuples of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            distinct points (i.e.,
            %a.existingWikiWord{:href => "/nlab/show/injective+functions"} injective functions
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{1,\dots,k\}
            to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is 3-transitive if any pair of triples
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %mo ,
                  %msub
                    %mi a
                    %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_1,a_2,a_3)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mn 2
                  %mo ,
                  %msub
                    %mi b
                    %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b_1,b_2,b_3)
            of points in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                  %mo ≠
                  %msub
                    %mi a
                    %mi j
                %annotation{:encoding => "application/x-tex"} a_i \ne a_j
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi i
                  %mo ≠
                  %msub
                    %mi b
                    %mi j
                %annotation{:encoding => "application/x-tex"} b_i \ne b_j
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≠
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i\ne j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \in G
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo ,
                    %msub
                      %mi b
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi g
                    %msub
                      %mi a
                      %mn 2
                    %mo ,
                    %mi g
                    %msub
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b_1,b_2,b_3) = (g a_1,g a_2,g a_3)
          %p
            A transitive action that is also
            %a.existingWikiWord{:href => "/nlab/show/free+action"} free
            is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular
            action. See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
          %h2#properties Properties
          %p
            A set equipped with a transitive action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (and which is
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
            %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected object
            in the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
            = succeed "-set" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-sets." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h2#examples Examples
          %ul
            %li
              %p
                Any group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                acts transitively on itself by multiplication
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋅
                        %mo :
                        %mi G
                        %mo ×
                        %mi G
                        %mo →
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \cdot : G \times G \to G
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/alternating+group"} alternating group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi n
                    %annotation{:encoding => "application/x-tex"} A_n
                acts transitively on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1,\dots,n\}
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \gt 2
                = succeed "-transitively" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-2)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \ge 2
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSL(2,\mathbb{Z})
                acts transitively on the
                %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational
                %a.existingWikiWord{:href => "/nlab/show/projective+line"} projective line
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℙ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi ℚ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ℚ
                        %mo ∪
                        %mo{:stretchy => "false"} {
                        %mn ∞
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbb{P}^1(\mathbb{Q}) = \mathbb{Q} \cup \{\infty\}
                %a.existingWikiWord{:href => "/nlab/show/projective+general+linear+group"} projective general linear group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PGL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PGL(2,\mathbb{C})
                acts 3-transitively on the
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℙ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{P}^1(\mathbb{C})
            %li
              %p
                An action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                (viewed as the
                %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
                on one generator) on a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                corresponds to an arbitrary
                %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mo :
                        %mi X
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \pi : X \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
                is a
                %em cyclic
                permutation.
          %h2#as_an_action_on_cosets As an action on cosets
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo :
                  %mi G
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} * : G \times X \to X
            be a transitive action and suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            is equivalent to the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by multiplication on a
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is taken as the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %msub
                    %mi G
                    %mi x
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi g
                  %mo ∈
                  %mi G
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi g
                  %mo *
                  %mi x
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} H = G_x = \{ g \in G \mid g * x = x \}
          %p
            of some arbitrary element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            guarantees that the
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} G/H \to X
            defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi H
                  %mo ↦
                  %mi g
                  %mo *
                  %mi x
                %annotation{:encoding => "application/x-tex"} g H \mapsto g * x
            is a bijection. (Note that although the subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %msub
                    %mi G
                    %mi x
                %annotation{:encoding => "application/x-tex"} H = G_x
            depends on the choice of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            is independent of the choice of element.)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit-stabilizer+theorem"} orbit-stabilizer theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+map"} combinatorial map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homogeneous+space"} homogeneous space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/transitive+action"}> transitive action
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/free+action"} free action
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/semi-free+action"} semi-free action
                %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
