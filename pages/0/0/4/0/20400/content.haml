                              %mn 1
                              %mo ,
                              %mi x
                              %mn 2
                              %mo{:stretchy => "false"} ]
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi q
                              %mo ⊩
                              %mi t
                              %mn 1
                              %mo =
                              %mi t
                              %mn 2
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mn 1
                              %mo =
                              %mi x
                              %mn 2
                              %mo{:stretchy => "false"} |
                              %mi R
                              %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mfrac
                            %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mi Γ
                                  %mo ⊢
                                  %mi C
                                  %mspace{:width => "thinmathspace"}
                                  %mi type
                                  %mspace{:width => "2em"}
                                  %mi Γ
                                  %mo ⊢
                                  %mi R
                                  %mo{:stretchy => "false"} [
                                  %mi t
                                  %mn 1
                                  %mo ,
                                  %mi t
                                  %mn 2
                                  %mo{:stretchy => "false"} /
                                  %mi x
                                  %mn 1
                                  %mo ,
                                  %mi x
                                  %mn 2
                                  %mo{:stretchy => "false"} ]
                                  %mspace{:width => "thinmathspace"}
                                  %mi type
                              %mtr
                                %mtd
                                  %mi Γ
                                  %mo ⊢
