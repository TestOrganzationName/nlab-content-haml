                              %mspace{:width => "thinmathspace"}
                              %mi type
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mo ∩
                              %mi x
                              %mo :
                              %mi A
                              %mo .
                              %mi B
                              %mspace{:width => "thinmathspace"}
                              %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\begin{gathered}
                  \\frac{\Gamma \vdash p \Vdash A \prec C \qquad
                  \\Gamma \vdash q \Vdash B \prec C \qquad
                  \\Gamma \vdash a \Vdash A \qquad \Gamma \vdash b \Vdash B}
                  {\Gamma \vdash a = b \in C\,type} \\
                  \\\
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type}
                  {\Gamma \vdash \Pi x:A.B\,type} \\
                  \\\
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type}
                  {\Gamma \vdash \cap x:A.B\,type}
                  \\end{gathered}
          %p
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Comp
            type, which is called
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Base
                %annotation{:encoding => "application/x-tex"} Base
            in Nuprl:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "true", :rowspacing => "1.0ex"}
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Comp
                              %mspace{:width => "thinmathspace"}
                              %mi type
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi A
                              %mspace{:width => "thinmathspace"}
                              %mi type
                              %mspace{:width => "2em"}
                              %mi Γ
                              %mo ,
                              %mi x
                              %mo :
                              %mi A
                              %mo ⊢
                              %mi B
                              %mspace{:width => "thinmathspace"}
                              %mi type
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mo :
                              %mi A
                              %mo{:stretchy => "false"} |
                              %mi B
                              %mo{:stretchy => "false"} }
                              %mspace{:width => "thinmathspace"}
                              %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\begin{gathered}
                  \\frac{}{\Gamma \vdash Comp\,type} \\
                  \\\
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type}
                  {\Gamma \vdash \{x:A | B\}\,type}
                  \\end{gathered}
          %p
            A PER comprehension type was originally conceived by Stuart Allen, and then forgotten and subsequently
            = succeed "." do
              %a{:href => "#PERTypes14"} reintroduced
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Base
                  %annotation{:encoding => "application/x-tex"} Base
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "true", :rowspacing => "1.0ex"}
                      %mtr
                        %mtd
                          %mfrac
                            %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
