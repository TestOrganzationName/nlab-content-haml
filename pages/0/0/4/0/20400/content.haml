                                  %mi Comp
                                  %mo ,
                                  %mi x
                                  %mn 2
                                  %mo :
                                  %mi Comp
                                  %mo ⊢
                                  %mi R
                                  %mspace{:width => "thinmathspace"}
                                  %mi type
                              %mtr
                                %mtd
                                  %mi Γ
                                  %mo ,
                                  %mi y
                                  %mn 1
                                  %mo :
