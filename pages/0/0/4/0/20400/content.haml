          %h3#booleans Booleans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi tru
                      %mo ⊩
                      %mi Bool
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi fls
                      %mo ⊩
                      %mi Bool
                %annotation{:encoding => "application/x-tex"}
                  \\frac{}{\Gamma \vdash tru \Vdash Bool} \qquad
                  \\frac{}{\Gamma \vdash fls \Vdash Bool}
          %p
            Exercise: Does the following rule express (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Bool
                  %mo ⊆
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Bool \subseteq Comp
            ), (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Bool
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Bool \lt\!\!:\;Comp
            ), or (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Bool
                  %mo ⊑
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Bool \sqsubseteq Comp
            )?
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi Comp
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash b \Vdash Bool}{\Gamma \vdash b \Vdash Comp}
          %p
            Our elimination rule is intuitively characterizing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bool
                %annotation{:encoding => "application/x-tex"} Bool
            as the least type containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tru
                %annotation{:encoding => "application/x-tex"} tru
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fls
                  %annotation{:encoding => "application/x-tex"} fls
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi Bool
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi tru
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi fls
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma,x:Bool \vdash C\,type \qquad
                  \\Gamma \vdash c \Vdash C[tru/x] \qquad
                  \\Gamma \vdash c \Vdash C[fls/x] \qquad
                  \\Gamma \vdash b \Vdash Bool}
                  {\Gamma \vdash c \Vdash C[b/x]}
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/ex+falso+quodlibet"} ex falso quodlibet
            rule, which is technically about booleans, because of how we defined
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            the minimum PER, ordered by inclusion, subtyping, or refinement.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi T
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo ⊩
                      %mo ⊥
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi t
                      %mo ⊩
                      %mi T
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash T\,type \qquad
                  \\Gamma \vdash p \Vdash \bot}
                  {\Gamma \vdash t \Vdash T}
          %h2#admissible_rules Admissible rules
          %h3#StructRules Structural rules
          %p The structural rules of weakening and substitution are admissible. “Strengthening” is not. Strengthening says that a variable that’s not free in the conclusion can be removed from the context:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msub
                        %mi Γ
                        %mn 1
                      %mo ,
                      %mi x
                      %mo :
                      %mi T
                      %mo ,
                      %msub
                        %mi Γ
                        %mn 2
                      %mo ⊢
                      %mi 𝒥
                      %mspace{:width => "2em"}
                      %mi x
                      %mo ∉
                      %mi FV
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Γ
                        %mn 2
                      %mo ,
                      %mi 𝒥
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi Γ
                        %mn 1
                      %mo ,
                      %msub
                        %mi Γ
                        %mn 2
                      %mo ⊢
                      %mi 𝒥
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma_1,x:T,\Gamma_2 \vdash \mathcal{J} \qquad
                  x \notin FV(\Gamma_2,\mathcal{J})}
                  {\Gamma_1,\Gamma_2 \vdash \mathcal{J}}
          %p
            So nonadmissibility of strengthening means that a derivation can be using a hypothesis without it being obvious from the conclusion derived. This is typical of extensional type theory. Typically it’s considered all the fault of equality reflection, which may be technically true for some systems. But Nuprl benefits more from the lack of strengthening: subsets, intersections, quotients, and other “refinement-style” type constructors provide flexible control over which proofs make it into the computational content, and which are merely establishing external facts. (
            %a.existingWikiWord{:href => "/nlab/show/quotient"} Quotients
            don’t have to be refinement-style, but in Nuprl and CLF, they are. See
            = succeed ".)" do
              %a{:href => "#PERtheory"} below
          %p CLF follows Nuprl in trying to give the user maximum control over the terms used to represent elements. The hope is that with care, this can allow significantly greater convenience and performance than with decidable dependent type systems, which are committed to retaining enough annotations to effectively reject ill-typed terms. Once proof terms are added to the formal judgments, you probably do get strengthening. (But not decidability.)
          %h3#sanity_and_inversion Sanity and Inversion
          %p
            You’d think a statement should make sense before you try to prove it. And likewise, that a type should be valid before you try to construct an element. But in practice, it also works to consider a typed construction as providing evidence that the type makes sense. Specifically, the only way to derive (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊢
                  %mi t
                  %mo ⊩
                  %mi T
                %annotation{:encoding => "application/x-tex"} \Gamma \vdash t \Vdash T
            ) is if you could also derive (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊢
                  %mi T
                  %mspace{:width => "thinmathspace"}
                  %mi type
                %annotation{:encoding => "application/x-tex"} \Gamma \vdash T\,type
            ). That’s a “sanity check” admissible rule. It’s
            %em probably
            admissible for the judgments defined by the rules above.
          %p Also, since the only way to derive type validity in this system (not using the sanity admissible rule) is to use a type former, a derivation of type validity implies that there are derivations of validity for the subexpressions of the type expression. These are “inversion” admissible rules.
          %h3#AdmissSem Admissible Rules vs PER Semantics
          %p
            For full Nuprl, it seems practically impossible to prove admissibility of sanity or inversion, if they’re not just included among the primitive rules. But they
            %em can
            be included among the primitive rules, because they’re true in the semantics. Due to the way hypothetical judgments are defined, making the inversion rules true requires making type equality intensional.
          %p The above rules are the result of an experiment to reason about formal derivability in a Nuprl-style system. In the PER semantics that the above rules were based on, type equality is extensional. So the basic rules directly satisfied were more complicated, since they needed extra premises that inversion would’ve made redundant. The above rules are actually admissible rules relative to those basic rules. Sanity and inversion are “probably” admissible for the above rules because what’s actually known is that they’re admissible for the basic rules; they were in fact used to prove the above rules.
          %p So the experiment was partially successful, but I (Matt Oliveri) don’t recommend the approach. It cannot be easily adapted to handle universes, and some of the rules above still have type validity premises that a fully semantic approach could avoid.
          %p It may seem weird that Nuprl is based on a particular PER semantics, if you think of it as a mathematical model. But if you think of it as a proof theoretic technique that reasons about realizability instead of formal derivability, perhaps it’s more palatable.
          %p Thinking that way, all the consequences of the PER semantics are like admissible rules, and can be added to the formal system if they’re useful. But it still seems like a good idea to try and find a stable formal system with enough rules that incompleteness is not a problem in practice.
          %p This raises questions though: If the formal rules of a Nuprl-style system are considered admissible, what defines the system? What are the mathematical models of Nuprl-style systems? If they’re considered unnatural, should Nuprl-style systems be modified?
          %p In my (Matt Oliveri’s) opinion, Nuprl-style systems are potentially relevant and useful to mathematics, but it’s not currently clear exactly how that might work.
          %h3#loose_ends Loose ends
          %p Now that we’ve covered the issue that the distinction between derivable and admissible doesn’t really matter for this system, we can get to explaining particular aspects that may seem to be in particular need of an explanation.
          %h4#equality_uses_respect_which_uses_equality Equality uses respect which uses equality
          %p
            The equality formation rule refers to the respect (“
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            ”) relation. The latter is not primitive, it’s defined in terms of equality. Is that OK? Yes: Because of the rule that all types respect
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ≺
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma \vdash B\,type}
                  {\Gamma \vdash A \prec B\;type}
          %p
            If it still seems suspiciously circular, rest assured that in the semantics, respecting computational equivalence is more basic than anything in the type system. The rule about respecting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Comp
            just exposes the fact internally.
          %p
            Because every type respects itself, we get all the instances of equality formation from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
          %h4#UsuPiIn Usual Pi-intro rule
          %p
            Taking function extensionality to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            intro seems odd. Not only is it not about lambdas, it’s not apparently about elements at all; just equality. That’s (one place) where the selectivity rules are handy. The function extensionality rule is strong enough to combine with selectivity (and reflexivity) to derive elements of function type. A term is a function when you can apply it to an argument to get a result:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mo ⊩
                      %mi B
                      %mspace{:width => "2em"}
                      %mi x
                      %mo ∉
                      %mi FV
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo ⊩
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad
                  \\Gamma,x:A \vdash f\,x \Vdash B \qquad x \notin FV(f)}
                  {\Gamma \vdash f \Vdash \Pi x:A.B}
          %p Proving that lambdas are functions additionally uses beta conversion. Lambdas are functions, not by fiat, but because they produce results when applied.
          %p
            Note that not all functions are denoted by lambdas. At the very least, the empty function is denoted by any term you like. That is, a function type with empty domain has the same PER as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi f
                  %mo :
                  %mi Π
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo ⊢
                  %mi f
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo .
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Π
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Gamma,f:\Pi x:A.B \vdash f = (\lambda x.f\,x) \in \Pi x:A.B
          %p as well as (the weaker)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi f
                  %mo :
                  %mi Comp
                  %mo ,
                  %mi Hf
                  %mo :
                  %mi f
                  %mo ∈
                  %mi Π
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo ⊢
                  %mi f
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo .
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Π
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Gamma,f:Comp,Hf:f \in \Pi x:A.B \vdash f = (\lambda x.f\,x) \in \Pi x:A.B
          %p but not
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi f
                  %mo :
                  %mi Comp
                  %mo ,
                  %mi Hf
                  %mo :
                  %mi f
                  %mo ∈
                  %mi Π
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo ⊢
                  %mi f
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo .
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} \Gamma,f:Comp,Hf:f \in \Pi x:A.B \vdash f = (\lambda x.f\,x) \in Comp
          %p .
          %h4#congruence_rules Congruence rules
          %p
            With such a small set of type constructors, it may be hard to tell, but congruence rules are rarely needed as primitives. Beta conversion was already defined as an untyped congruence closure, and for typed equality, the subsumptive rewrite rule does most of the work of congruence rules. The extensionality rules for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∩
                %annotation{:encoding => "application/x-tex"} \cap
            are needed to help with binders and (our ersatz) hidden assumptions. That may turn out to handle everything, with this judgmental setup.
          %h2#semantic_judgmental_reflection Semantic Judgmental Reflection
          %h3#equality_reflection Equality reflection
          %p
            With many type theories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            as type families in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %em syntactic
            reflection of a system’s judgments within itself.
            %a.existingWikiWord{:href => "/nlab/show/provability+logic"} There
            %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} are
            %a.existingWikiWord{:href => "/nlab/show/higher-order+abstract+syntax"} ways
            of making syntactic reflection more convenient and/or powerful.
          %p
            But Nuprl-style systems provide a quite different kind of judgmental reflection that we’ll call “
            %em semantic
            judgmental reflection”, or just “judgmental reflection” for short. The original example of judgmental reflection, and the basis of the name, is the equality reflection rule of extensional type theory (ETT), which makes the “identity” type family a reflection of the meaning of the element equality judgment of the same system. In a sense, this is still the only judgmental reflection principle in Nuprl-style systems. (But the type family is called “equality”.) The difference is in the interpretation of the equality judgment.
          %p
            There are two styles of interpretation for ETT:
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intrinsic+and+extrinsic+views+of+typing"} intrinsic and extrinsic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/meaning+explanation"} meaning explanation
            = succeed "," do
              %a{:href => "#HofmannThesis"} Martin Hofmann’s thesis
          %p
            An irony is that by considering terms extrinsically typed, you consider them intrinsically meaningful. In Nuprl and CLF, following Martin-Löf, terms have an intrinsic computational meaning. The role of the Nuprl-style type system is to reason about that. (Remember: this can all be considered a
            = succeed "!" do
              %a{:href => "#AdmissSem"} substitute for admissible rules
          %p There is actually no interpretation necessary, for terms in general. The type system can be layered over the terms as they are, making use of an operational model of their computational meaning. (A denotational semantics would probably work too.) The details need not concern us here, but some things are important:
          %ul
            %li Computational meaning pertains principally to closed terms, because free variables don’t compute; they’re just placeholders.
            %li Some closed terms are designated as types, and denote PERs on closed terms.
            %li
              For closed terms and types, the equality judgment form (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi t
                    %mo ′
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} t = t' \in T
              ) just accesses the PER of the type.
            %li
              For closed terms and types, the judgment of being an element of a type (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} t \in T
              ) is a special case of equality.
            %li It’s the judgments about closed terms that are reflected as closed types; judgments about open terms are not involved.
          %p All of these points are important to the design of a Nuprl-style system. But the one that seems to distinguish the approach from intrinsic typing is that being an element is a special case of equality. In the intrinsic approach, equality is only meaningful when applied to two terms known to have the same type. So being an element must be somehow prior to equality. But with the judgment of being an element as a special case of equality, it’s simultaneous.
          %p
            A lot of the power of judgmental reflection is that it
            %em can
            be understood as reasoning about the computational content of the language as it actually is. But since it’s probably not
            %em necessary
            to interpret Nuprl-style systems as being about their own syntax, we should speak of “computations”, not “closed terms”. In CLF, however they’re interpreted, computations are axiomatized as the elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
          %h3#OpenEq Equality of Open terms
          %p
            So then what’s with all this respect (“
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            ”) stuff in the equality formation rule? If terms have an intrinsic computational meaning, and equality reasons about it, shouldn’t the rule be just:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi T
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi t
                      %mn 1
                      %mo =
                      %mi t
                      %mn 2
                      %mo ∈
                      %mi T
                      %mspace{:width => "thinmathspace"}
                      %mi type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash T\,type}{\Gamma \vdash t1 = t2 \in T\,type}
          %p ?
          %p
            No, that doesn’t work. The extra complexity has to do with making the axiomatization work for open terms. Consider the type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo ∈
                    %mi Bool
                    %mo ∧
                    %mi y
                    %mo ∈
                    %mi Bool
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I\;\coloneqq\;\{x = y | x \in Bool \wedge y \in Bool\}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tru
                    %mo =
                    %mi fls
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} tru = fls \in I
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi I
                    %mo ⊢
                    %mi tru
                    %mo =
                    %mi x
                    %mo ∈
                    %mi Bool
                    %mspace{:width => "thinmathspace"}
                    %mi type
                  %annotation{:encoding => "application/x-tex"} x:I \vdash tru = x \in Bool\,type
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tru
                    %mo =
                    %mi tru
                    %mo ∈
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} tru = tru \in Bool
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tru
                    %mo =
                    %mi fls
                    %mo ∈
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} tru = fls \in Bool
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tru
                %annotation{:encoding => "application/x-tex"} tru
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi fls
                %annotation{:encoding => "application/x-tex"} fls
            are the same
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            such that (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi I
                  %mo ⊢
                  %mi x
                  %mo ⊩
                  %mi T
                %annotation{:encoding => "application/x-tex"} x:I \vdash x \Vdash T
            ) and (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi T
                  %mo ≺
                  %mi Bool
                %annotation{:encoding => "application/x-tex"} T \prec Bool
            ). But if (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi I
                  %mo ⊢
                  %mi x
                  %mo ⊩
                  %mi T
                %annotation{:encoding => "application/x-tex"} x:I \vdash x \Vdash T
            ), then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            considers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tru
                %annotation{:encoding => "application/x-tex"} tru
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi fls
                %annotation{:encoding => "application/x-tex"} fls
            equal, while if (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi T
                  %mo ≺
                  %mi Bool
                %annotation{:encoding => "application/x-tex"} T \prec Bool
            ), then it doesn’t.
          %p That variables and other open terms cannot generally be treated as computations is the sense in which variables are intrinsically typed: although elements are all realized by computations, an arbitrary element generally cannot be used as a computation, so reasoning about membership is constrained.
          %h3#other_semantic_judgments Other semantic judgments
          %p
            Based on the ability to reason about membership, in addition to equality, other types can be defined that seem like semantic judgments. For example,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊆
                  %annotation{:encoding => "application/x-tex"} \subseteq
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                  %annotation{:encoding => "application/x-tex"} \lt\!\!:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊑
                %annotation{:encoding => "application/x-tex"} \sqsubseteq
            were
            = succeed "." do
              %a{:href => "#SemJudg"} defined above
          %p
            A lenient answer is that semantic judgments are type (families)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            such that any two elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            are equal (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is a subsingleton), and (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌊
                  %mi J
                  %mo{:stretchy => "false"} ⌋
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} \lfloor J \rfloor \to J
            ) is inhabited. That is, the squash-stable subsingletons. All such types are isomorphic to equality types, and are the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+subobjects"} regular subobjects
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory#DependentTypeTheory"} manner analogous to ETT
          %p
            A stricter definition of semantic judgments is that they are type (families)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            such that (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌊
                  %mi J
                  %mo{:stretchy => "false"} ⌋
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi J
                %annotation{:encoding => "application/x-tex"} \lfloor J \rfloor \lt\!\!:\;J
            ). Types formed with equality, squash itself,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊆
                  %annotation{:encoding => "application/x-tex"} \subseteq
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                  %annotation{:encoding => "application/x-tex"} \lt\!\!:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊑
                %annotation{:encoding => "application/x-tex"} \sqsubseteq
            are always judgments in this strict sense. These types are extensionally equal to equality types (for example, this one:
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} (\lambda x.x) \in J
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≈
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mo ∧
                  %mi B
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \approx B\;\coloneqq\;A \lt\!\!:\;B \wedge B \lt\!\!:\;A
          %p This definition of extensional equality is motivated by the “subsumption” (derived) rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi t
                      %mo ⊩
                      %mi A
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mi B
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi t
                      %mo ⊩
                      %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash t \Vdash A \qquad
                  \\Gamma \vdash A \lt\!\!:\;B}
                  {\Gamma \vdash t \Vdash B}
          %p
            So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≈
                %annotation{:encoding => "application/x-tex"} \approx
            gives us subsumptions in both directions. Extensionally equal types denote the same PER.
          %p
            Thus, the semantic judgments in the strict sense are regular subobjects defined in a convenient way so that they’re inhabited if and only if they’re basically
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≈
                %annotation{:encoding => "application/x-tex"} \approx
            is itself a semantic judgment. Also:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ≈
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≈
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊑
                  %mi B
                  %mo ∧
                  %mi B
                  %mo ⊑
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A \approx B) \approx (A \sqsubseteq B \wedge B \sqsubseteq A)
          %p
            However, (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi B
                  %mo ∧
                  %mi B
                  %mo ⊆
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \subseteq B \wedge B \subseteq A
            ) is generally weaker. For example,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Comp
            have the same members (computations) but are not extensionally equal, or even isomorphic.
          %h2#constructive_propositions Constructive Propositions
          %p
            We define
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            as quotienting a type down to a subsingleton:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ∧
                  %mi y
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil \coloneqq \{x = y | x \in A \wedge y \in A\}
          %p
            Unlike the squash of a type (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌊
                  %mi A
                  %mo{:stretchy => "false"} ⌋
                %annotation{:encoding => "application/x-tex"} \lfloor A \rfloor
            ),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            has the same set of computations as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            is just as useful as a member of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            are not allowed to depend on the identity of the member. So for example, a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil \to B
            is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %mo :
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\,:\,A \to B
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,a':A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi a
                    %mo =
                    %mi f
                    %mi a
                    %mo ′
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f a = f a' \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            is constant, but that’s still more permissive than a map out of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mi A
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \lfloor A \rfloor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p Let
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                    %mo ≔
                    %mi A
                    %mo →
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \not A \coloneqq A \to \bot
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dec
                    %mi A
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo :
                    %mi Bool
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo =
                    %mi tru
                    %mo ∈
                    %mi Bool
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo =
                    %mi fls
                    %mo ∈
                    %mi Bool
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo ¬
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} dec A \coloneqq \{b:Bool | ((b = tru \in Bool) \to A) \wedge ((b = fls \in Bool) \to \not A)\}
          %p
            By non-contradiction,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dec
                  %mi A
                %annotation{:encoding => "application/x-tex"} dec A
            is a subsingleton, so
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌈
                    %mi dec
                    %mi A
                    %mo{:stretchy => "false"} ⌉
                    %mo ≈
                    %mi dec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \lceil dec A \rceil \approx dec A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} dec A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is inhabited. On the other hand, a member of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌊
                  %mi dec
                  %mi A
                  %mo{:stretchy => "false"} ⌋
                %annotation{:encoding => "application/x-tex"} \lfloor dec A\rfloor
            tells you nothing: its existence means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is either inhabited or not, but you still don’t know which. A member of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi dec
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \not \not (dec A)
            also tells you nothing, and even its existence is uninformative: you can prove
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi dec
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \not \not (dec A)
            yourself, without knowing anything about
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            There are implications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                  %mo →
                  %mo{:stretchy => "false"} ⌊
                  %mi A
                  %mo{:stretchy => "false"} ⌋
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil \to \lfloor A \rfloor
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mi A
                    %mo{:stretchy => "false"} ⌋
                    %mo →
                    %mo ¬
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \lfloor A \rfloor \to \not \not A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌈
                    %mi A
                    %mo{:stretchy => "false"} ⌉
                  %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mi A
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \lfloor A \rfloor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} \not \not A
            as truncating down to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proof+relevance"} constructive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} intuitionistic
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
            propositions, respectively. Here, the distinction between “constructive” and “intuitionistic” is that constructive logic is explicitly computational, whereas intuitionistic logic merely declines to assume anti-computational principles, like
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %a.existingWikiWord{:href => "/nlab/show/constructive+set+theory"} constructive set theory
            is merely intuitionistic by this terminology, though it has constructive models.) (None of this has to do with
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/intuitionism"} intuitionism
          %p It should be consistent to add the rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo ⊩
                      %mo{:stretchy => "false"} (
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} ⌊
                      %mi A
                      %mo{:stretchy => "false"} ⌋
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A\,type}{\Gamma \vdash p \Vdash (\not \not A) \to \lfloor A \rfloor}
          %p
            This makes the semantic judgments classical, rather than intuitionistic. Constructive propositions remain constructive, and
            %a.existingWikiWord{:href => "/nlab/show/canonicity"} canonicity
            is not affected.
          %p
            In contrast, having
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} \not \not A
            imply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⌈
                  %mi A
                  %mo{:stretchy => "false"} ⌉
                %annotation{:encoding => "application/x-tex"} \lceil A \rceil
            is not known to be consistent, and it ruins canonicity. (It’s quite possible that it’s consistent with the current rules, but this is pure luck. In full Nuprl, the same implication is probably false, due to “partial” types.)
          %h2#ShortCirc Short-Circuiting connectives
          %p
            Due to the
            = succeed "," do
              %a{:href => "#StructRules"} lack of strengthening
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∧
                  %mi B
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %munder
                    %mspace{:width => "thickmathspace"}
                    %mo ̲
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} A \wedge B \coloneqq \{\underline{\;}:A | B\}
          %p From the formation rule for subset, we derive the following formation rule for conjunction:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ,
                      %munder
                        %mspace{:width => "thickmathspace"}
                        %mo ̲
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ∧
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma,\underline{\;}:A \vdash B\,type}
                  {\Gamma \vdash A \wedge B\,type}
          %p That is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi x
                      %mo ∉
                      %mi FV
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ∧
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo ∧
                  %mi intro
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad
                  \\Gamma,x:A \vdash B\,type \qquad x \notin FV(B)}
                  {\Gamma \vdash A \wedge B\,type}\;(\wedge intro1)
          %p With strengthening, this would be basically the same as:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ∧
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo ∧
                  %mi intro
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma \vdash B\,type}
                  {\Gamma \vdash A \wedge B\,type}\;(\wedge intro2)
          %p
            But without being able to strengthen the premises of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ∧
                  %mi intro
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\wedge intro1)
            to those of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∧
                    %mi intro
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\wedge intro2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ∧
                  %mi intro
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\wedge intro1)
            itself is generally
            %em stronger
            than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∧
                    %mi intro
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\wedge intro2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            only needs to be a type if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is inhabited. So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            is a
            %em short-circuiting
            conjunction, kind of like the
            %code &amp;&amp;
            boolean operator from many programming languages, where the right conjunct need only be able to return a boolean when the left conjunct is true. (Because that’s the only case in which it’s evaluated.)
          %p Implication is similarly short-circuiting, like a conditional expression from a programming language:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ,
                      %munder
                        %mspace{:width => "thickmathspace"}
                        %mo ̲
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo →
                      %mi B
                      %mspace{:width => "thinmathspace"}
                      %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A\,type \qquad \Gamma,\underline{\;}:A \vdash B\,type}
                  {\Gamma \vdash A \to B\,type}
          %p
            Short-circuiting disjunction doesn’t seem natural for types; what is a dependent
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} Bool
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo =
                    %mi fls
                    %mo ∈
                    %mi Bool
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (a = fls \in Bool) \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            only needs to be a type if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fls
                  %annotation{:encoding => "application/x-tex"} fls
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo =
                    %mi fls
                    %mo ∈
                    %mi Bool
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (a = fls \in Bool) \to B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi tru
                    %mo ∈
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} a = tru \in Bool
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h2#more_admissiblederived_rules More admissible/derived rules
          %h3#bool_eliminations Bool eliminations
          %p
            Combining (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Bool
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Comp
                %annotation{:encoding => "application/x-tex"} Bool \lt\!\!:\;\Comp
            ) with the primitive elimination rule for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} Bool
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi Comp
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi tru
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi fls
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma,x:Comp \vdash C\,type \qquad
                  \\Gamma \vdash c \Vdash C[tru/x] \qquad
                  \\Gamma \vdash c \Vdash C[fls/x] \qquad
                  \\Gamma \vdash b \Vdash Bool}
                  {\Gamma \vdash c \Vdash C[b/x]}
          %p Curiously, you can go in the other direction too, and get both of the original rules from this one.
          %p To get the usual elimination rule, prove that Church booleans are self-eliminating functions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi Bool
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thinmathspace"}
                      %mi type
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi tru
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi fls
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma,x:Bool \vdash C\,type \qquad
                  \\Gamma \vdash b \Vdash Bool}
                  {\Gamma \vdash b \Vdash C[tru/x] \to C[fls/x] \to C[b/x]}
          %p
            This is reasoning about membership, so we really do want to know that
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} Bool
            = succeed "s." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            at that function type.
          %p In Nuprl, it’s often possible to get induction rules without a premise showing that the motive is a valid family. The idea is that for sufficiently concrete types, validity of the motive can be proven pointwise, and moreover the cases of this proof are actually implied by the cases of the main induction.
          %p
            In the current CLF rules though, it doesn’t seem possible to derive such rules. Also, including such strengthened induction rules as primitive doesn’t seem compatible with the
            %a{:href => "#AdmissSem"} current hybrid approach
            based on admissible formal rules: the sanity check would require an unusual type validity rule, which would ruin the inversion lemma. Basically the Nuprl-style justification for omitting the motive premise is “too semantic” for the current hybrid approach.
          %h3#fun_with_subsets Fun with subsets
          %h3#subtyping Subtyping
          %p Subtyping variance rules should be derivable for the type constructors. Here are some for the primitive type constructors:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thinmathspace"}
                          %mi type
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo ′
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ′
                          %mo ⊢
                          %mi B
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo ′
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo ′
                      %mo .
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}
                  \\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type \\
                  \\Gamma \vdash A' \lt\!\!:\;A \qquad
                  \\Gamma,x:A' \vdash B \lt\!\!:\;B'
                  \\end{array}}
                  {\Gamma \vdash (\Pi x:A.B) \lt\!\!:\;(\Pi x:A'.B')}
          %p
            Yes, contravariance for function domains. A difference from subsetting in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thinmathspace"}
                          %mi type
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo ′
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ′
                          %mo ⊢
                          %mi B
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo ′
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} (
                      %mo ∩
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∩
                      %mi x
                      %mo :
                      %mi A
                      %mo ′
                      %mo .
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}
                  \\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type \\
                  \\Gamma \vdash A' \lt\!\!:\;A \qquad
                  \\Gamma,x:A' \vdash B \lt\!\!:\;B'
                  \\end{array}}
                  {\Gamma \vdash (\cap x:A.B) \lt\!\!:\;(\cap x:A'.B')}
          %p Subset is covariant in both positions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ′
                          %mo ⊢
                          %mi B
                          %mo ′
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mo ′
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo ′
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} }
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi A
                      %mo ′
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}
                  \\Gamma,x:A' \vdash B'\,type \\
                  \\Gamma \vdash A \lt\!\!:\;A' \qquad
                  \\Gamma,x:A \vdash B \lt\!\!:\;B'
                  \\end{array}}
                  {\Gamma \vdash \{x:A | B\} \lt\!\!:\;\{x:A' | B'\}}
          %p
            This rule can be strengthened, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is proof irrelevant:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ′
                          %mo ⊢
                          %mi B
                          %mo ′
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mo ′
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi m
                          %mo ⊩
                          %mi B
                          %mo →
                          %mi B
                          %mo ′
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} }
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi A
                      %mo ′
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}
                  \\Gamma,x:A' \vdash B'\,type \\
                  \\Gamma \vdash A \lt\!\!:\;A' \qquad
                  \\Gamma,x:A \vdash m \Vdash B \to B'
                  \\end{array}}
                  {\Gamma \vdash \{x:A | B\} \lt\!\!:\;\{x:A' | B'\}}
          %p
            The intersection rule can be strengthened too, since the “argument” is irrelevant, but it’s not as pretty, because the type dependency is
            %em not
            irrelevant:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thinmathspace"}
                          %mi type
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi m
                          %mo ⊩
                          %mi A
                          %mo ′
                          %mo →
                          %mi A
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ′
                          %mo ⊢
                          %mi B
                          %mo{:stretchy => "false"} [
                          %mi m
                          %mspace{:width => "thinmathspace"}
                          %mi x
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mo{:stretchy => "false"} ]
                          %mo &lt;
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo ′
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} (
                      %mo ∩
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∩
                      %mi x
                      %mo :
                      %mi A
                      %mo ′
                      %mo .
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}
                  \\Gamma \vdash A\,type \qquad \Gamma,x:A \vdash B\,type \\
                  \\Gamma \vdash m \Vdash A' \to A \qquad
                  \\Gamma,x:A' \vdash B[m\,x/x] \lt\!\!:\;B'
                  \\end{array}}
                  {\Gamma \vdash (\cap x:A.B) \lt\!\!:\;(\cap x:A'.B')}
          %h2#PERtheory PER theory
          %p
            We have
            %a{:href => "#UsuPiIn"} seen
            that in CLF (as in Nuprl) whether two terms are equal depends on what type we compare them at, and that we
            %a{:href => "#OpenEq"} need to care
            about whether one type respects (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            ) another’s equality. This gives rise to three different (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ⊆
                %annotation{:encoding => "application/x-tex"} \subseteq
            ) basic (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo &lt;
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mo :
                %annotation{:encoding => "application/x-tex"} \lt\!\!:
            ) preorders (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ⊑
                %annotation{:encoding => "application/x-tex"} \sqsubseteq
            ) on types, whereas
            %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            has just one. What does all this extra complexity buy us?
          %p
            Very roughly, it buys us the ability to reason directly using realizers, rather than some other system of terms that denote mathematical objects that are realizable. Intuitively, the realizers are elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Comp
                  %annotation{:encoding => "application/x-tex"} Comp
          %p
            More specifically, it’s an aspect of how quotients work that seems to be the root cause of the difference between set theory and “PER theory”. PER semantics provides
            = succeed ":" do
              %em refinement-style quotients
          %p Eventually, general subquotients should be definable in CLF as:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo =
                  %mi y
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} |
                  %mi R
                  %mo{:stretchy => "false"} }
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo ∈
                  %mi T
                  %mo ∧
                  %mi y
                  %mo ∈
                  %mi T
                  %mo ∧
                  %mi R
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x = y:T | R\} \coloneqq \{x = y | x \in T \wedge y \in T \wedge R\}
          %p (Of course, this definition can already be written, but it doesn’t currently seem to have all the desired properties, due to missing rules.)
          %p
            This is using the
            %a{:href => "#ShortCirc"} short-circuiting
            behavior of conjunction to allow deriving a formation rule something like:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi T
                          %mspace{:width => "thinmathspace"}
                          %mi type
                          %mspace{:width => "2em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mn 1
                          %mo :
                          %mi T
                          %mo ,
                          %mi x
                          %mn 2
                          %mo :
                          %mi T
                          %mo ⊢
                          %mi R
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ,
                          %mi y
                          %mn 1
                          %mo :
                          %mi T
                          %mo ,
                          %mi y
                          %mn 2
                          %mo :
                          %mi T
                          %mo ⊢
                          %mi s
                          %mo ⊩
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mn 1
                          %mo ,
                          %mi y
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mn 1
                          %mo ,
                          %mi x
                          %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mn 2
                          %mo ,
                          %mi y
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mn 1
                          %mo ,
                          %mi x
                          %mn 2
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ,
                          %mi y
                          %mn 1
                          %mo :
                          %mi T
                          %mo ,
                          %mi y
                          %mn 2
                          %mo :
                          %mi T
                          %mo ,
                          %mi y
                          %mn 3
                          %mo :
                          %mi T
                          %mo ⊢
                          %mi t
                          %mo ⊩
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mn 1
                          %mo ,
                          %mi y
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mn 1
                          %mo ,
                          %mi x
                          %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mn 2
                          %mo ,
                          %mi y
                          %mn 3
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mn 1
                          %mo ,
                          %mi x
                          %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mn 1
                          %mo ,
                          %mi y
                          %mn 3
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mn 1
                          %mo ,
                          %mi x
                          %mn 2
                          %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mn 1
                      %mo =
                      %mi x
                      %mn 2
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} |
                      %mi R
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mi type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\begin{array}{l}\Gamma \vdash T\,type \qquad \Gamma,x1:T,x2:T \vdash R\,type \\
                  \\Gamma,y1:T,y2:T \vdash s \Vdash R[y1,y2/x1,x2] \to R[y2,y1/x1,x2] \\
                  \\Gamma,y1:T,y2:T,y3:T \vdash t \Vdash R[y1,y2/x1,x2] \to R[y2,y3/x1,x2] \to R[y1,y3/x1,x2]\end{array}}
                  {\Gamma \vdash \{x1 = x2:T | R\}\,type}
          %p
            So we expect
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a family on a pair of
            = succeed "s," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            equality is respected in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo =
                  %mi y
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} |
                  %mi R
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x = y:T | R\}
            is a member of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≺
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \prec \{x = y:T | R\}
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\} \subseteq T
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                    %mo ⊑
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\} \sqsubseteq T
          %p
            In case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is also reflexive for members of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ,
                    %mi y
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi r
                    %mo ⊩
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} /
                    %mi x
                    %mn 1
                    %mo ,
                    %mi x
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Gamma,y:T \vdash r \Vdash R[y,y/x1,x2]
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \subseteq \{x = y:T | R\}
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo &lt;
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \lt\!\!:\;\{x = y:T | R\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo =
                  %mi y
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} |
                  %mi R
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x = y:T | R\}
            is a (full) quotient of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi x
                    %mo .
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \lambda x.x
            %em projection
            mapping from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\}
          %p
            Taking stock, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a
            %a.existingWikiWord{:href => "/nlab/show/regular+and+exact+completions#TheExLexCompletion"} pseudo-equivalence relation
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\} \subseteq T
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \subseteq \{x = y:T | R\}
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≺
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \prec \{x = y:T | R\}
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                    %mo ⊑
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \{x = y:T | R\} \sqsubseteq T
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo &lt;
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} |
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T \lt\!\!:\;\{x = y:T | R\}
          %p
            Since we have member inclusion in both directions, according to set theory, this “quotient” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is not actually any different from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≡
                    %mo{:stretchy => "false"} ⌈
                    %mi Bool
                    %mo{:stretchy => "false"} ⌉
                    %mo ≈
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo =
                    %mi y
                    %mo :
                    %mi Bool
                    %mo{:stretchy => "false"} |
                    %mo ⊤
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I \equiv \lceil Bool \rceil \approx \{x = y:Bool | \top\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a singleton, but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bool
                %annotation{:encoding => "application/x-tex"} Bool
            is not.
          %p
            In set theory, the intuition behind quotients is that a quotient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a set of equivalence classes of members of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and its quotient generally have different members. The effect on equality is a consequence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+extensionality"} set extensionality
          %p In programming, programmers informally use quotients, probably mostly without realizing it. For example, when using hash tables to implement finite maps, the representation has extra implementation details like the number of buckets, and the assignment of keys to buckets. Any meaningful results given to the user should not depend on this information. That doesn’t mean that the computation of the results should not depend on it, but that the results should not vary due to changes in implementation details. Programmers know that, so they effectively treat hash tables as quotient types where implementation details have been modded out. And no operations on equivalence classes of hash tables will be found in the program; programming languages provide no such thing. So the programmer’s quotient is not the set theoretic quotient construction, it’s the refinement-style quotient codified by PER theory.
          %p (What seems to be missing from the current rules is a way to prove that you can map out of a quotient by mapping out of the base type in a way that respects the equivalence relation. For example, to allow using a hash table correctly by proving that only implementation details of the result vary with implementation details of the hash table.)
          %p
            However, for many purposes, it may be a net improvement to give up on refinement-style quotients in order to get the simplicity of set theory. Refinement-style quotients seem particularly
            %a{:href => "#QIIF"} well suited
            to CLF’s use as a metalogic, though.
          %h2#CLFasLF CLF and Logical Frameworks
          %p
            %a.existingWikiWord{:href => "/nlab/show/logical+framework"} Logical frameworks
            provide a formal notation for languages. (Especially languages that support logical deduction.) The kind of logical framework CLF aims to provide is one that represents dependent type systems using HOAS signatures.
          %p
            The logical framework “
            %a.existingWikiWord{:href => "/nlab/show/LF"}> LF
            ” uses HOAS, and can already represent seemingly any language, including dependent type systems. But the issue is not only whether a language can be represented at all, but how “deep” the encoding is. With a
            %em shallow
            encoding, the framework representation of encoded expressions of the language is close to a custom representation tailored to that language. With a
            %em deep
            encoding, a lot of overhead is introduced by the encoding, making the framework representation much less convenient than a custom one.
          %p
            LF’s use of HOAS makes the encoding of many languages shallower, but only works for languages that can be expressed using
            = succeed "-style" do
              %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural-deduction
            %a.existingWikiWord{:href => "/nlab/show/combinatory+logic"} combinator
            languages.) So to encode
            %a.existingWikiWord{:href => "/nlab/show/substructural+logic"} substructural
            languages, for example, evidence of substructural variable use needs to be handled explicitly, unlike with a custom representation.
          %p
            There are two styles of HOAS-based encoding associated with LF, called “synthetic” and “analytic”. (See the
            %a.existingWikiWord{:href => "/nlab/show/logical+framework"} logical framework
            page.) Synthetic is a deeper style of encoding than analytic, but analytic only works for languages where type equality is just
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/alpha+equivalence"} alpha equivalence
          %p
            The formal description of a language in LF and similar logical frameworks is called a “signature”, since it’s similar to a
            %a.existingWikiWord{:href => "/nlab/show/signature+%28in+logic%29"} signature
            for some fixed logic.
          %h3#martinlfs_logical_framework Martin-Löf’s Logical Framework
          %p To see how equality reflection is useful for a logical framework, we will propose an extension of LF, called “LF=” (LF with equality), that combines the shallowness of LF’s analytic encoding with more of the flexibility of LF’s synthetic encoding. (But in LF=, the encoding is generally not analytic, in the sense of algorithmic judgments. That’s the catch.) But first, it’s instructive to cover analytic encoding in Martin-Löf’s logical framework (“MLLF”).
          %p Unlike LF, MLLF doesn’t have a fixed judgmental equality. Term formers are specified in roughly the same intrinsically typed way as with the analytic encoding for LF. But meanwhile, judgmental equality rules for the object language are added by adding corresponding judgmental equality rules to the framework. Thus, MLLF can shallowly encode many type systems with analytic judgments, not just the ones where type equality is very simple, like with LF. MLLF is particularly well suited to specifying variants of Martin-Löf type theory.
          %p
            MLLF is defined and discussed in Martin-Löf’s
            %a{:href => "#AnaSynJudg"} Analytic and Synthetic Judgements in Type Theory
            and in part III of
            = succeed "." do
              %a{:href => "#ProgMLTT"} Programming in Martin-Löf’s Type Theory
          %p
            There are tools that provide a style of language specification very similar to MLLF.
            %a{:href => "https://deducteam.github.io/"} Dedukti
            implements a logical framework similar to LF, but signatures can also include typed rewrite rules that extend judgmental equality. There’s an
            %a{:href => "#AgdaJudgRewr16"} Agda feature
            that allows proven or hypothesized equations to be declared as rewrites that extend judgmental equality. This can presumably be combined with axioms to imitate Dedukti signatures, and quite possibly more.
          %p These tools are designed under the assumption that, while open-ended, judgmental equality remains analytic. That is, it’s something that you can sanely just check automatically. (Or so the story goes.) Trying to add extensional type theory’s equality reflection rule to a rewrite engine is not going to work. It generally won’t have a good way to solve the premise that proves the equation. (Either the system will give up, or do something useless.)
          %p
            The equality reflection rule is enough to make the judgments synthetic. That is, something you generally have to prove. To handle type systems with synthetic judgments, you either need to use a synthetic encoding (for example, in LF or Isabelle), or use a tool designed to handle synthetic judgments, like Nuprl,
            = succeed "," do
              %a{:href => "http://metaprl.org/"} MetaPRL
            = succeed "," do
              %a{:href => "#Andromeda"} Andromeda
          %h3#LFEq LF=
          %p Like LF, and unlike MLLF, LF= has a fixed judgmental equality. Unlike either LF or MLLF, this judgmental equality is synthetic, because LF= has equality reflection. (LF=’s typing judgment form is synthetic as well, for the usual reason that it makes use of judgmental equality.)
          %p LF= is LF plus a reflective equality type constructor. (Combined with LF’s eta equality for function types, this gets function extensionality.) But still no equality kinds. LF is often formulated such that only canonical forms (beta normal, eta long) are well typed. This probably does not work for LF=; use your favorite way of formulating extensional type theory. (The details don’t matter here, since I’m going to propose CLF as a generalization of LF=.)
          %p To encode an intrinsically typed language in LF=, you can declare intrinsically typed constants/axioms in LF=, much like LF’s analytic encoding:
          %pre
            %code
              :preserve
                tp : Type
                el : tp -> Type
                
                Pi : {A:tp} (el A -> tp) -> tp
                lam : {A:tp} {B:el A->tp} ({a:el A} el (B a)) -> el (Pi A B)
                app : {A:tp} {B:el A->tp} el (Pi A B) -> {a:el A} el (B a)          %p Like in MLLF, the object language’s judgmental equality is identified with the framework’s judgmental equality. This means you don’t need to encode congruence rules. Interesting equality rules are encoded by assuming an equation:
          %pre
            %code
              :preserve
                pi_beta : {A:tp} {B:el A->tp} {b:{a:el A} el (B a)} {a:el A} app A B (lam A B b) a = b a
                pi_eta : {A:tp} {B:el A->tp} {f:el (Pi A B)} f = lam A B ([a] app A B f a)          %p
            Unlike MLLF, these axioms are just additional constants; there is no restriction other than that they be well typed declarations in LF=. Although these equations are just constants, by using equality reflection to use them, no coercions appear in the terms. If using LF= equations added a coercion to the term, LF= equality would not be an adequate representation of judgmental equality. (The adequacy of reflective equality is inspired by
            = succeed ".)" do
              %a{:href => "#Andromeda"} Andromeda
          %p
            For an example of why using equality reflection in the framework doesn’t automatically make the object language extensional, we will cover the non-derivability of (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi nat
                  %mo ,
                  %mi m
                  %mo :
                  %mi nat
                  %mo ⊢
                  %mi n
                  %mo +
                  %mi m
                  %mo ≡
                  %mi m
                  %mo +
                  %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi nat
                %annotation{:encoding => "application/x-tex"} n:nat,m:nat \vdash n + m \equiv m + n\;:\;nat
            ) in intensional type theory. So we add natural numbers:
          %pre
            %code
              :preserve
                nat : tp
                
                zro : el nat
                suc : el nat -> el nat
                
                natrec : ...
                
                natrec_zro : ...
                natrec_suc : ...          %p
            %code natrec
            should be the dependent elimination form for the inductive type of natural numbers.
            %code natrec_zro
            and
            %code natrec_suc
            are its defining equations.
          %p We can then define—in the metalanguage—a derived form
          %pre
            %code plus : el nat -&gt; el nat -&gt; el nat
          %p
            using
            = succeed "." do
              %code natrec
            = succeed ")" do
              %code plus n m
            = succeed ")." do
              %code n + m
          %p
            The judgment (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi nat
                  %mo ,
                  %mi m
                  %mo :
                  %mi nat
                  %mo ⊢
                  %mi n
                  %mo +
                  %mi m
                  %mo ≡
                  %mi m
                  %mo +
                  %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi nat
                %annotation{:encoding => "application/x-tex"} n:nat,m:nat \vdash n + m \equiv m + n\;:\;nat
            ) is represented as (
            %code> {n:el nat} {m:el nat} n + m = m + n
            ). There is “obviously” no LF= term of that type, since there’s no induction principle for the LF= type
            = succeed "," do
              %code el nat
            %code el nat
            don’t apply for a general element. The object language has
            %code natrec
            as an induction principle, but that only works for proving object language types, not LF= equality.
          %p
            Of course, if we add reflective equality to the
            = succeed "," do
              %em object language
            %code natrec
            and the object language’s equality reflection to prove the LF= equation. Here is a reflective equality type constructor:
          %pre
            %code
              :preserve
                eq : {T:tp} el T -> el T -> tp
                eqI : {T:tp} {t:el T} el (eq T t t)
                eqE : {T:tp} {t1 t2:el T} el (eq T t1 t2) -> t1 = t2
                eqK : {T:tp} {t:el T} {p:el (eq T t t)} p = eqI T t          %p
            %code eqE
            is the equality reflection rule for the object language. Note that there’s no trouble declaring this constant. It’s just another judgmental equality rule for the object language. LF= was prepared all along for equality requiring proof. On the other hand, that means that it requires
            %em boring
            proof in the common case that it’s obvious. So an implementation of LF= would have a practical need for proof automation, to effect type checking of the object language.
          %p
            Part of the rationale behind CLF—and seemingly many other type system implementations based on synthetic judgments—is that there’s no
            %em implementation
            reason to distinguish type checking from other forms of proof automation. That type checking really is just automatic “proving” of judgments.
          %p On the other hand, if you insist upon decidable type checking, that would be a reason to distinguish type checking from general proof automation. Implementers of synthetic type systems seem united in not considering decidability an important property of type checking.
          %h3#lf_signatures_as_inductiveinductive_families LF Signatures as Inductive-Inductive Families
          %p
            LF, MLLF, and LF= are all specialized, weak languages, wherein the object language is specified as a list of assumptions. CLF is not. Although it’s still fairly weak, it’s supposed to be strong enough to actually prove stuff. In CLF, the object language is defined as some number of mutually
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive-inductive+type"} inductive-inductive families
          %p Declared LF type families correspond to CLF inductive type family definitions. The declared element formers for declared LF families correspond to the constructors of the CLF inductive families. Since multiple families can be declared in LF prior to declaring elements, the CLF inductive families are mutually defined, in general. And since there can also be type dependencies between the families, induction-induction is generally necessary.
          %p
            LF signatures are not ordinary inductive-inductive families. Although the constructors can take functions as arguments, this does not denote an infinitary constructor, as found in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/W-types"} W-types
            %a.existingWikiWord{:href => "/nlab/show/bound+variable"} binding
            subexpression. This is the HOAS interpretation of function types: applying a function just substitutes into an open expression. Since binding and substitution are rather tame notions from formal syntax, there are no restrictions on recurrences in the inductive definition. For example, a recurrence is allowed in the domain of a function type, unlike with infinitary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
          %p
            HOAS should be used in CLF too. But unlike LF, this doesn’t involve function types, since CLF’s maps out of an inductive definition allow case analysis, which would not be an adequate representation of binding subexpressions. Instead, lambdas from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Comp
            can be used as the representation of binding subexpressions. In the family definitions, free variables will presumably be kept track of explicitly, as usual for an inductive definition of a formal system. It should be possible to develop some generic definition of the families, for some broad type of signature codes. (It should include at least all LF= signatures. See below.)
          %p In other words, in CLF, the HOAS interpretation of signatures should be definable; it’s not just part of the metatheory. This should allow CLF to serve as both a logical framework, and a metalanguage for reasoning about derivability. With sufficient proof automation, reasoning about derivability allows the convenient use of object languages. The shallowness of the encoding avoids much of the notational inconvenience and computational overhead usually present when reasoning via a metalanguage definition.
          %h3#QIIF Quotient-Inductive-Inductive Families as Refinements
          %p The addition of reflective equality types to LF= has the consequence that LF= signatures correspond to quotient inductive-inductive families, not just plain inductive-inductive families. The declarations concluding with an equality type correspond to equality constructors.
          %p
            In CLF, quotienting is actually needed just to define inductive-inductive families, since lambdas in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Comp
                %annotation{:encoding => "application/x-tex"} Comp
            don’t already satisfy the eta conversion rule of LF’s function type. So in principle, supporting quotient inductive-inductive families should be a straightforward modification to the construction. Due to the use of
            = succeed "," do
              %a{:href => "#PERtheory"} refinement-style quotients
          %h2#references References
          %ul
            %li#AnandRahliITP14
              %p
                Abhishek Anand, Vincent Rahli,
                = succeed "," do
                  %em Towards a Formally Verified Proof Assistant
                = succeed "," do
                  %a{:href => "http://www.nuprl.org/html/Nuprl2Coq/"} project web
                = succeed "," do
                  %a{:href => "http://www.nuprl.org/KB/show.php?ID=726"} paper web
                = succeed ")" do
                  %a{:href => "http://www.nuprl.org/documents/Anand/TowardsAFormallyVerifiedProofAssistant.pdf"} pdf
            %li#PERTypes14
              %p
                Abhishek Anand, Mark Bickford,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Constable"} Robert L. Constable
                = succeed "," do
                  %em A Type Theory with Partial Equivalence Relations as Types
                = succeed "," do
                  %a{:href => "https://vrahli.github.io/articles/slides-per-types.pdf"} slides
                = succeed "," do
                  %a{:href => "http://www.nuprl.org/KB/show.php?ID=722"} web
                = succeed ")" do
                  %a{:href => "http://www.nuprl.org/documents/Anand/ATypeTheoryWithPartialEquivalenceRelationsAsTypes.pdf"} pdf
            %li#HofmannThesis
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hofmann"}> Martin Hofmann
                ,
                = succeed "," do
                  %em Extensional concepts in intensional type theory
                = succeed ")" do
                  %a{:href => "http://www.lfcs.inf.ed.ac.uk/reports/95/ECS-LFCS-95-327/"} link
            %li#SterlingHarperRefinement
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Sterling"}> Jonathan Sterling
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Harper"} Robert Harper
                = succeed "," do
                  %em Algebraic Foundations of Proof Refinement
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1703.05215"} arXiv
            %li#Andromeda
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
                , Gaëtan Gilbert, Philipp G. Haselwarter,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matija+Pretnar"} Matija Pretnar
                = succeed "," do
                  %em Design and Implementation of the Andromeda Proof Assistant
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1802.06217v1"} arXiv
                = succeed ")" do
                  %a{:href => "http://www.andromeda-prover.org/"} project web
            %li#AnaSynJudg
              %p
                %a.existingWikiWord{:href => "/nlab/show/Per+Martin-L%C3%B6f"}> Per Martin-Löf
                ,
                = succeed "," do
                  %em Analytic and Synthetic Judgments in Type Theory
                = succeed ")" do
                  %a{:href => "http://archive-pml.github.io/martin-lof/pdfs/Martin-Lof-Analytic-and-Synthetic-Judgements-in-Type-Theory.pdf"} pdf
            %li#ProgMLTT
              %p
                Bengt Nordström, Kent Petersson, Jan M. Smith,
                = succeed "," do
                  %em Programming in Martin-Löf’s Type Theory
                = succeed ")" do
                  %a{:href => "http://www.cse.chalmers.se/research/group/logic/book/"} web
            %li#AgdaJudgRewr16
              %p
                Jesper Cockx, Andreas Abel,
                = succeed "," do
                  %em Sprinkles of extensionality for your vanilla type theory
                = succeed ")" do
                  %a{:href => "http://www.cse.chalmers.se/~abela/types16-cockx.pdf"} pdf
