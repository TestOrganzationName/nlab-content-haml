                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_2 \times \mathcal{C}_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has some specified value for its 2-source and 2-target.
            %li
              There are
              %em identity
              relations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %msub
                      %mi 𝒞
                      %mn 0
                    %mo ×
                    %msub
                      %mi 𝒞
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Id:\mathcal{C}_0 \times \mathcal{C}_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 1
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_1 \times \mathcal{C}_2
            %li
              There is a
              %em composition
              relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                      %mo :
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mn 1
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \circ:(\mathcal{C}_1 \times \mathcal{C}_1) \times \mathcal{C}_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_2
              are such that some specified target of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              is also a specified source of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
            %li
              There is a
              %em 1-composition
              relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mn 1
                      %mo :
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \circ_1:(\mathcal{C}_2 \times \mathcal{C}_2) \times \mathcal{C}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_2
              are such that some specified 2-target at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              is also a specified 2-source at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
            %li
              There is a
              %em 2-composition
              relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mn 2
                      %mo :
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \circ_2:(\mathcal{C}_2 \times \mathcal{C}_2) \times \mathcal{C}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_2
              are such that some specified target at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              is also a specified source at
