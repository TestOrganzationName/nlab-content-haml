                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              respectively, and suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo ∘
                      %mn 1
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \circ_1 g
              exists. Then it is an identity 2-cell on any value of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∘
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \circ y
            %li
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be an identity 1-cell, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              be any 1-cell. Then, if there is a composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \circ g
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} g \circ f
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            %li
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              be 2-cells. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi f
                      %msub
                        %mo ∘
                        %mn 2
                      %mi g
                    %annotation{:encoding => "application/x-tex"} F = f \circ_2 g
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi g
                      %msub
                        %mo ∘
                        %mn 2
                      %mi h
                    %annotation{:encoding => "application/x-tex"} G = g \circ_2 h
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ∘
                        %mn 2
                      %mi h
                      %mo =
                      %mi f
                      %msub
                        %mo ∘
                        %mn 2
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \circ_2 h = f \circ_2 G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              are equal, as are the set of sources of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %li
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              be 2-cells. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi f
                      %msub
                        %mo ∘
                        %mn 1
                      %mi g
                    %annotation{:encoding => "application/x-tex"} F = f \circ_1 g
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi g
                      %msub
                        %mo ∘
                        %mn 1
                      %mi h
                    %annotation{:encoding => "application/x-tex"} G = g \circ_1 h
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ∘
                        %mn 1
                      %mi h
                      %mo =
                      %mi f
                      %msub
                        %mo ∘
                        %mn 1
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \circ_1 h = f \circ_1 G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              are equal, as are the set of 2-sources of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %li
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} f_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} g_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_2
              be 2-cells. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %msub
                        %mi f
                        %mn 1
                      %msub
                        %mo ∘
                        %mn 1
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F = f_1 \circ_1 f_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %msub
                        %mi g
                        %mn 1
                      %msub
                        %mo ∘
                        %mn 1
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G = g_1 \circ_1 g_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 1
                      %mo =
                      %msub
                        %mi f
                        %mn 1
                      %msub
                        %mo ∘
                        %mn 2
                      %msub
                        %mi g
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} H_1 = f_1 \circ_2 g_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 2
                      %mo =
                      %msub
                        %mi f
                        %mn 2
                      %msub
                        %mo ∘
                        %mn 2
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} H_2 = f_2 \circ_2 g_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ∘
                        %mn 1
                      %mi G
                      %mo =
                      %msub
                        %mi H
                        %mn 1
                      %msub
                        %mo ∘
                        %mn 2
                      %msub
                        %mi H
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F \circ_1 G = H_1 \circ_2 H_2
          %p
            So every anabicategory is “ana
            %a.existingWikiWord{:href => "/nlab/show/skeletal"}> skeletal
            ” (every equivalence is an identity), and “
            %a.existingWikiWord{:href => "/nlab/show/strict+category"}> anastrict
            \:” its associators and unitors are also identities.
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            can be made into an anabicategory; we simply make the source, target, identity, and composition maps into relations with the original functions as specified values, then define the full values by isomorphism and equivalence. This will satisfy the coherence relations because the original bicategory satisfied the bicategory coherence relations.
          %p
            On the other hand, we can also assume that every value of the defining relations is specified; then the anabicategory is said to be
            = succeed "." do
              %em saturated
            %a.existingWikiWord{:href => "/nlab/show/anafunctors"} anaequivalent
            to a strict 2-category (just map each object or 1-cell to its equivalence class, and vice versa). For there to be a weak equivalence between the anabicategory and the 2-category, however, we would need the
            %span.newWikiWord
              Axiom of Choice
              %a{:href => "/nlab/new/Axiom+of+Choice"} ?
            (to pick out a single element of each equivalence class to serve as its image).
