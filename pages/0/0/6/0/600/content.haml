                  \\\
                  X &amp;&amp;&amp;&amp; X
                  }
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/span"} span
            with identical left and right index object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong span trace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} tr(R)
            is as by regarding it as a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} R\to X\times X
            %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\to X\times X
          %p
            This can be expressed in terms of the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            %a.existingWikiWord{:href => "/nlab/show/Span"} Span
            in several ways. For instance, we can regard it as the composite of the result
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi x
                              %mo ×
                              %mi y
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi pt
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; R
                  \\\
                  \&amp; {}^{x \times y}\swarrow &amp;&amp; \searrow
                  \\\
                  X \times X &amp;&amp;&amp;&amp; pt
                  }
          %p of dualizing one leg of the span with the span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                      %mtr
                        %mtd
                          %mi pt
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; X
                  \\\
                  \&amp; {}^{}\swarrow &amp;&amp; \searrow^{Id \times Id}
                  \\\
                  pt &amp;&amp;&amp;&amp; X \times X
                  }
          %p
            i.e. the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi{:mathvariant => "normal"} tr
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi x
                              %mo ×
                              %mi y
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi pt
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi pt
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp;&amp;&amp;
                  \\mathrm{tr}R
                  \\\
                  \&amp;&amp;&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \&amp;&amp; X &amp;&amp;&amp;&amp; R
                  \\\
                  \&amp; {}^{}\swarrow &amp;&amp; \searrow^{Id \times Id}
                  \&amp;&amp; {}^{x \times y}\swarrow &amp;&amp; \searrow
                  \\\
                  pt &amp;&amp;&amp;&amp; X \times X &amp;&amp;&amp;&amp; pt
                  }
          %p regarded as a span from the point to the point
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi tr
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi pt
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi pt
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; tr(R)
                  \\\
                  \&amp; {}^{}\swarrow &amp;&amp; \searrow
                  \\\
                  pt &amp;&amp;&amp;&amp; pt
                  }
                  \\,.
          %h3#for_multispans For multispans
          %p
            More generally, the trace of a
            %a.existingWikiWord{:href => "/nlab/show/multispan"} multispan
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            identical of its index objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the composite with the multispan
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi Id
                          %mo ↙
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi Id
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mi X
                        %mtd
                          %mi ⋯
                        %mtd
                          %mi X
                        %mtd
                          %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; X
                  \\\
                  \&amp; {}^{Id}\swarrow \downarrow^{Id} &amp; \cdots
                  \\\
                  X &amp; X &amp; \cdots &amp; X &amp; \cdots
                  }
          %h2#examples Examples
          %h3#trace_of_setvalued_matrices Trace of Set-valued matrices
          %p
            Let the ambient category be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a finite set and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi X
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} R \to X \times X
            an
            = succeed "-matrix" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo ×
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |X| \times |X|
            %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
            as a
            %a.existingWikiWord{:href => "/nlab/show/groupoidification"} groupoidified
            = succeed "-matrix" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo ×
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |X| \times |X|
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %p The trace of the span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi x
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mi y
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; R
                  \\\
                  \&amp; {}^x\swarrow &amp;&amp; \searrow^{y}
                  \\\
                  X &amp;&amp;&amp;&amp; X
                  }
          %p is the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi tr
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi x
                              %mo ,
                              %mi y
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  tr(R) &amp;\to&amp; R
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{x,y}
                  \\\
                  X &amp;\stackrel{Id \times Id}{\to}&amp; X \times X
                  }
          %p
            which is the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %msub
                      %mi R
                      %mrow
                        %mi x
                        %mo ,
                        %mi x
                  %annotation{:encoding => "application/x-tex"} tr(R) = \sqcup_{x \in X} R_{x,x}
            %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
            this is indeed the trace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi x
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi R
                    %mrow
                      %mi x
                      %mo ,
                      %mi x
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |tr(R)| = \sum_{x} |R_{x,x}|
            of the matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi R
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |R|
            represented by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#loop_objects_from_homotopy_span_traces Loop objects from homotopy span traces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            with
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            its free
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            is the part of the
            %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} B^I = [I,B]
            which consists of closed paths, i.e. the pullback.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ω
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                              %mo ×
                              %msub
                                %mi d
                                %mn 1
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega B &amp;\to&amp; [I,B]
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{d_0 \times d_1}
                  \\\
                  B &amp;\stackrel{Id \times Id}{\to}&amp; B \times B
                  }
                  \\,.
          %p
            This can be understood as the
            %em homotopy span trace
            of the identity span on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi B
                  %mo =
                  %mi hotr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Id
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hotr
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mi Id
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mi Id
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Omega B = hotr(Id_B) = hotr\left(
                  \\array{
                  \&amp;&amp; B
                  \\\
                  \&amp; {}^{Id}\swarrow &amp;&amp; \searrow^{Id} \\
                  B &amp;&amp;&amp;&amp; B
                  }
                  \\right)
                  \\,,
          %p
            where the homotopy span trace is computed like the span trace but with the pullback replaced by a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hotr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Id
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi holim
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi Id
                                %mo ×
                                %mi Id
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %mi Id
                                %mo ×
                                %mi Id
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  hotr(Id_B) =
                  holim
                  \\left(
                  \\array{
                  B &amp;&amp;&amp;&amp; B
                  \\\
                  \&amp; {}_{Id \times Id}\searrow &amp;&amp; \swarrow_{Id \times Id}
                  \\\
                  \&amp;&amp;
                  B \times B
                  }
                  \\right)
                  \\,.
          %p
            According to the example described at
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            and using that we assume that we are in a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            we can compute this homotopy limit, up to weak equivalence, as the ordinary limit of the weakly equivalent pullback diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi Id
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi Id
                      %mtr
                        %mtd
                          %mi F
                          %mo ′
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                              %mo ×
                              %msub
                                %mi d
                                %mn 1
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %mi Id
                              %mo ×
                              %mi Id
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F
                  \&amp;&amp;&amp;&amp;
                  B &amp;\stackrel{Id \times Id}{\to}&amp; B \times B
                  \&amp;\stackrel{Id \times Id}{\leftarrow}&amp; B
                  \\\
                  \\downarrow^{\simeq}
                  \&amp;&amp;&amp;&amp;
                  \\downarrow^{\simeq} &amp;&amp; \downarrow^{Id} &amp;&amp; \downarrow^{Id}
                  \\\
                  F'
                  \&amp;&amp;&amp;&amp;
                  [I,B] &amp;\stackrel{d_0 \times d_1}{\to}&amp;
                  B \times B &amp;\stackrel{Id \times Id}{\leftarrow}&amp;
                  B
                  }
          %p
            where we replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            by its
            %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} B^I = [I,B]
            using the factorization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mover
                    %mo →
                    %mrow
                      %mi Id
                      %mo ×
                      %mi Id
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} B \stackrel{Id \times Id}{\to} B \times B
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mover
                    %mo →
                    %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ×
                      %msub
                        %mi d
                        %mn 1
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} B \stackrel{\simeq}{\to} [I,B] \stackrel{d_0 \times d_1}{\to} B \times B
            guaranteed to exist in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ×
                      %msub
                        %mi d
                        %mn 1
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} [I, B] \stackrel{d_0 \times d_1}{\to} B \times B
            is a
            = succeed ":" do
              %em fibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi holim
                    %mi D
                  %mi F
                  %mover
                    %mo →
                    %mo ≃
                  %msub
                    %mi lim
                    %mi D
                  %mi F
                  %mo ′
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  holim_D F \stackrel{\simeq}{\to} lim_D F'
                  \\,.
          %p
            But by the above
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mi D
                    %mi F
                    %mo ′
                    %mo =
                    %mi Ω
                    %mi B
                  %annotation{:encoding => "application/x-tex"} lim_D F' = \Omega B
          %h3#categorical_trace_from_homotopical_span_trace Categorical trace from homotopical span trace
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/categorical+trace"} categorical trace
            on a 1-
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            in a 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the homotopy trace on the span given by that endomorphism.
          %p This should be true quite generally, but here are the details just for the special case that connects to the above example:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            with the standard interval object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mover
                      %mo →
                      %mo ≃
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{a \stackrel{\simeq}{\to} b\}
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            with respect to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/folk+model+structure"} folk model structure
          %p
            Notice that
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \eta : F \to G
            between two functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F, G : C \to D
            are in bijection with commuting diagrams
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi η
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi Id
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                              %mo ×
                              %msub
                                %mi d
                                %mn 1
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi F
                              %mo ×
                              %mi G
                        %mtd
                          %mi Y
                          %mo ×
                          %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{\eta}{\to}&amp; [I,Y]
                  \\\
                  \\downarrow^{Id} &amp;&amp; \downarrow^{d_0 \times d_1}
                  \\\
                  X &amp;\stackrel{F \times G}{\to}&amp; Y \times Y
                  }
                  \\,.
          %p
            Now, the homotopy trace on the span corresponding to an ednofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F : B \to B
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hotr
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hotr
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mi Id
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mi F
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                    %mo )
                  %mo =
                  %mi holim
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi Id
                                %mo ×
                                %mi Id
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                            %mrow
                              %mi F
                              %mo ×
                              %mi Id
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  hotr(F)
                  \=
                  hotr\left(
                  \\array{
                  \&amp;&amp; B
                  \\\
                  \&amp; {}^{Id}\swarrow &amp;&amp; \searrow^{F}
                  \\\
                  B &amp;&amp;&amp;&amp; B
                  }
                  \\right)
                  \=
                  holim\left(
                  \\array{
                  B &amp;&amp;&amp;&amp; B
                  \\\
                  \&amp; {}_{Id \times Id}\searrow &amp;&amp; \swarrow{F \times Id}
                  \\\
                  \&amp;&amp; B \times B
                  }
                  \\right)
                  \\,.
          %p
            Since we are in a category of fibrant objects the assumptions of the example discussed at
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            apply and the above homotopy limit is again computed, up to weak equivalence, by the ordinary limit of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mover
                    %mo →
                    %mo ≃
                  %mi lim
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi I
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi d
                                  %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                            %mrow
                              %mi Id
                              %mo ×
                              %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\stackrel{\simeq}{\to}
                  lim
                  \\left(
                  \\array{
                  [I,B] &amp;&amp;&amp;&amp; B
                  \\\
                  \&amp; {}_{d_0 \times d_1}\searrow &amp;&amp; \swarrow{Id \times F}
                  \\\
                  \&amp;&amp; B \times B
                  }
                  \\right)
                  \\,.
          %p
            By the above, every cone over the pullback diagram with a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi Q
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} h : Q \to B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Id
                      %mi B
                    %mo ⇒
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h^*(Id_B \Rightarrow F)
            %em represents
            the collection of these transformations.
          %h2#related_concepts Related concepts
          %ul
            %li
              The dual notion is that of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/co-span+co-trace"} co-span co-trace
          %h2#references References
          %p
            That the canonical trace on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            is compatible with the interpretation of spans as linear maps in the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoidification"} groupoidification
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/co-span+co-trace"} co-span co-trace
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
          %ul
            %li
              Urs Schreiber,
              %a{:href => "http://golem.ph.utexas.edu/category/2008/05/hopkinslurie_on_baezdolan.html#c021537"} (co)-traces
              (2008)
          %p More discussion is in
          %ul#BenZviNadler13
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %em Nonlinear traces
              (
              %a{:href => "http://arxiv.org/abs/1305.7175"}> arXiv:1305.7175
