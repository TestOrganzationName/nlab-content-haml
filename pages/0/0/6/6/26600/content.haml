              %a.existingWikiWord{:href => "/nlab/show/wide+pushouts"} wide pushouts
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %h2#definition Definition
          %h3#as_a_higher_inductive_type As a higher inductive type
          %p
            Given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/codomains"} codomains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(i)
            indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i:I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\prod_{i:I} A \to B(i)
            %strong dependent pushout type
            or
            %strong wide pushout type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi I
                  %mo ,
                  %mi B
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, I, B, f)
            is the
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mi x
                      %mo :
                      %mi I
                    %mrow
                      %mi A
                      %mo ,
                      %mi f
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigsqcup_{x:I}^{A, f} B(x)
            generated by the constructors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} in
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mi x
                      %mo :
                      %mi I
                    %mrow
                      %mi A
                      %mo ,
                      %mi f
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{in}:\prod_{i:I} B(i) \to \bigsqcup_{x:I}^{A, f} B(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} gluehubs
                  %mo :
                  %mi A
                  %mo →
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mi x
                      %mo :
                      %mi I
                    %mrow
                      %mi A
                      %mo ,
                      %mi f
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{gluehubs}:A \to \bigsqcup_{x:I}^{A, f} B(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} gluespokes
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
