          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/pushout+type"} pushout type
            of
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} g:A \to C
            is the
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                  %mi C
                %annotation{:encoding => "application/x-tex"} B \sqcup_{A}^{f, g} C
            generated by functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi B
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                  %mi C
                %annotation{:encoding => "application/x-tex"} \mathrm{in}_B:B \to B \sqcup_{A}^{f, g} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi C
                  %mo :
                  %mi C
                  %mo →
                  %mi B
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                  %mi C
                %annotation{:encoding => "application/x-tex"} \mathrm{in}_C:C \to B \sqcup_{A}^{f, g} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} glue
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{glue}:\prod_{x:A} \mathrm{in}(f(x)) = \mathrm{in}(g(x))
          %p
            However, by using large elimination for the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} bool
                %annotation{:encoding => "application/x-tex"} \mathrm{bool}
            on the codomain of the functions and by using the induction principle for the type of booleans on the functions themselves, one has a family of functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mi A
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_\mathrm{bool}(f, g):\prod_{b:\mathrm{bool}} A \to \mathrm{rec}_\mathrm{bool}(B, C, b)
          %p and the resulting binary pushout is the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mi{:mathvariant => "normal"} bool
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mi{:mathvariant => "normal"} bool
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{rec}_\mathrm{bool}(B, C, 0) \sqcup_{A}^{\mathrm{ind}_\mathrm{bool}(f, g, 0), \mathrm{ind}_\mathrm{bool}(f, g, 1)} \mathrm{rec}_\mathrm{bool}(B, C, 1)
          %p generated by functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} in
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mi{:mathvariant => "normal"} bool
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mi{:mathvariant => "normal"} bool
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{in}:\prod_{b:B} \mathrm{rec}_\mathrm{bool}(B, C, b) \to (\mathrm{rec}_\mathrm{bool}(B, C, 0) \sqcup_{A}^{\mathrm{ind}_\mathrm{bool}(f, g, 0), \mathrm{ind}_\mathrm{bool}(f, g, 1)} \mathrm{rec}_\mathrm{bool}(B, C, 1))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} glue
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo ,
                  %mn 0
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{glue}:\prod_{x:A} \mathrm{in}(\mathrm{ind}_\mathrm{bool}(f, g, 0, x)) = \mathrm{in}(\mathrm{ind}_\mathrm{bool}(f, g, 1, x))
          %p
            Thus, it suffices to define the binary pushout of a boolean-indexed family of functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi{:mathvariant => "normal"} bool
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\prod_{x:\mathrm{bool}} A \to B(x)
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            generated by the constructors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} in
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo ⊔
                    %mi A
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{in}:\prod_{b:\mathrm{bool}} B(b) \to (B(0) \sqcup_A^{f(0), f(1)} B(1))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} glue
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{glue}:\prod_{x:A} \mathrm{in}(0, f(0, x)) = \mathrm{in}(1, f(1, x))
          %p
            For any elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = y
            is equivalent to the dependent sum type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo =
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo =
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{z:A} (x = z) \times (y = z)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} glue
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msubsup
                        %mo ⊔
                        %mi A
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
