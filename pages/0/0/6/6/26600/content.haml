                      %mo .
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash I \; \mathrm{type} \quad \Gamma, x:I \vdash B(x) \; \mathrm{type} \quad \Gamma, x:I, z:A \vdash f(x, z):B(x)}{\Gamma \vdash \mathrm{pushout}(A, I, x.B, x z.f) \; \mathrm{type}}
