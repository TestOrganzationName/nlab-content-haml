                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi z
                %annotation{:encoding => "application/x-tex"} \mathrm{glue}:\prod_{x:A} \sum_{z:B(0) \sqcup_A^{f(0), f(1)} B(1)} \prod_{b:\mathrm{bool}} \mathrm{in}(b, f(b, x)) = z
          %p
            which by the
            %a.existingWikiWord{:href => "/nlab/show/type+theoretic+axiom+of+choice"} type theoretic axiom of choice
            is equivalently
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
