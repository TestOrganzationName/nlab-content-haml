                    %mrow
                      %mi C
                      %mo :
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msubsup
                        %mo ⊔
                        %mi A
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{glue}:\sum_{C:A \to (B(0) \sqcup_A^{f(0), f(1)} B(1))} \prod_{x:A} \prod_{b:\mathrm{bool}} \mathrm{in}(b, f(b, x)) = C(x)
          %p
            Unwrapping the dependent sum type, there are now three constructors for the binary pushout of a boolean-indexed family of functions
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi{:mathvariant => "normal"} bool
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\prod_{x:\mathrm{bool}} A \to B(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} in
