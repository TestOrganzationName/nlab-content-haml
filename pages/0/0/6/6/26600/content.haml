                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{gluehubs}:A \to (B(0) \sqcup_A^{f(0), f(1)} B(1))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} gluespokes
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
