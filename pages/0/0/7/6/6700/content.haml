              %strong 3
              3/4 (2012) 255-291
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "https://doi.org/10.4171/qt/29"} doi:10.4171/QT/29
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-dimensional+Euclidean+field+theories+and+tmf"} (2,1)-dimensional Euclidean field theories and tmf
            is in
          %ul
            %li#StolzTeichner11
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Stolz"}> Stefan Stolz
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
              = succeed "," do
                %em Supersymmetric field theories and generalized cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              (eds.),
              = succeed "," do
                %em
                  %a{:href => "http://ncatlab.org/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory#ContributionStolzTeichner"} Mathematical foundations of Quantum field theory and String theory
          %p
            Discussion in the context of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
          %ul
            %li#FiorenzaValentino14
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alessandro+Valentino"} Alessandro Valentino
              = succeed "," do
                %em Boundary Conditions for Topological Quantum Field Theories, Anomalies and Projective Modular Functors
              %strong 338
              (2015) 1043–1074
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
