            %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
            on the punctured
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
          %ul
            %li#AndersenUeno12
              %a.existingWikiWord{:href => "/nlab/show/J%C3%B8rgen+Ellegaard+Andersen"}> Jørgen Ellegaard Andersen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kenji+Ueno"} Kenji Ueno
              = succeed "," do
