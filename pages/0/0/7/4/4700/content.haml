                ,
                = succeed "," do
                  %em The Lambrechts-Stanley Model of Configuration Spaces
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1608.08054"} arXiv:1608.08054
                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.1007/s00222-018-0842-9"} doi:10.1007/s00222-018-0842-9
            %li#CamposWillwacher16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ricardo+Campos"}> Ricardo Campos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Willwacher"} Thomas Willwacher
                %em A model for configuration spaces of points
                (
                %a{:href => "https://arxiv.org/abs/1604.02043"}> arXiv:1604.02043
                )
            %li#Campos17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ricardo+Campos"}> Ricardo Campos
                ,
                = succeed "," do
                  %em Batalin-Vilkovisky formality and configuration spaces of points
                = succeed ")" do
                  %a{:href => "https://doi.org/10.3929/ethz-a-010886114"} doi:10.3929/ethz-a-010886114
            %li#CamposIdrissiLambrechtsWillwacher18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ricardo+Campos"}> Ricardo Campos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Najib+Idrissi"} Najib Idrissi
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"} Pascal Lambrechts
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Willwacher"} Thomas Willwacher
