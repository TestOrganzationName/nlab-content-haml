                %strong 43
                (2004), n. 6, p. 1469-1510,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2005d:57028"} MR2005d:57028
                %a{:href => "http://dx.doi.org/10.1016/j.top.2004.03.004"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vasily+Dolgushev"}> Vasily Dolgushev
