                  n, D \in \mathbb{N}
                  \\,,
          %p
            As such, this is
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
            to the semi-algebraic
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+algebra"} de Rham algebra
          .maruku-equation
