                  %a{:href => "http://dx.doi.org/10.1023/A:1000619911308"} doi
                %a{:href => "http://arxiv.org/abs/dg-ga/9704009"} arXiv:dg-ga/9704009
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrey+Lazarev"}> Andrey Lazarev
                ,
                = succeed "," do
                  %em Operads and topological conformal field theories
                = succeed ";" do
                  %a{:href => "http://www.maths.lancs.ac.uk/~lazarev/1-10.pdf"} pdf
                = succeed "," do
                  %em Graduate lectures on operads and topological field theories
                %a{:href => "http://www2.le.ac.uk/departments/mathematics/extranet/staff-material/staff-profiles/al179/New%20Folder.zip"} over 5 Mb
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alastair+Hamilton"}> Alastair Hamilton
                ,
                = succeed "," do
