                %mrow
                  %mi Σ
                  %mo =
                  %msup
                    %mi ℝ
                    %mi D
                %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^D
            and sending it to its corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude"} Feynman amplitude
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
