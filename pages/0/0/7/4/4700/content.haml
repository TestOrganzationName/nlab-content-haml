              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1109.0056"} arXiv:1109.0056
          %p
            Concrete examples of cohomology classes in certain bi-degrees in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Graphs
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Graphs_0(\mathbb{R}^2)
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/computer+experiment"} computer experiment
          %ul
            %li#BarNatanMcKay
              %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
