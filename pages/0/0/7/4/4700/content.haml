                %a{:href => "http://arxiv.org/abs/1105.2680"} arxiv/1105.2680
            %li
              %p
                Jian Qiu, Maxim Zabzine,
                = succeed "," do
                  %em Knot weight systems from graded symplectic geometry
                %a{:href => "http://arxiv.org/abs/1110.5234"} arxiv/1110.5234
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alastair+Hamilton"}> Alastair Hamilton
