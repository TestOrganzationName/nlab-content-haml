            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            points in
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            which exhibits this
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            is given by regarding a graph as a
