                  %a{:href => "http://pagesperso.ihes.fr/~maxim/TEXTS/VassilievKnot.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/KontsevichVassilievInvariants93.pdf", :title => "pdf"} pdf
            %li#Kontsevich99b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                , around Def. 15 and Lemma 3 in
                = succeed "," do
                  %em Operads and Motives in Deformation Quantization
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/9904055"} arXiv:math/9904055
          %h3#surveys Surveys
          %ul
            %li
              Marko Berghoff,
              = succeed "," do
                %em Graph complexes from the geometric viewpoint
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/2312.11237"} arXiv
          %p
            In relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ricardo+Campos"}> Ricardo Campos
              \:
              = succeed "," do
                %em Configuration Spaces of Points
              %a{:href => "https://www.cim.pt/magazines/bulletin/41"}
                CIM Bulletin
                %strong 41
                (2020)
              41-47 &amp;lbrack;
              %a{:href => "https://www.cim.pt/magazines/bulletin/41/article/296/pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://hal.science/hal-03754254"} hal:03754254
          %h3#as_a_rational_model_for_configuration_spaces As a rational model for configuration spaces
          %p
            A clean account and proof of the graph complex as a model for the
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+type"} rational homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/Fulton-MacPherson+compactification"} Fulton-MacPherson compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            (exhibiting the
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formality
            of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/little+n-disk+operads"} little n-disk operads
          %ul
            %li#LambrechtsVolic14
              %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"}> Pascal Lambrechts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ismar+Voli%C4%87"} Ismar Volić
              = succeed "," do
                %em Formality of the little N-disks operad
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0808.0457"} arxiv:0808.0457
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1090/memo/1079"} doi:10.1090/memo/1079
          %p
            Discussion as a direct model for the rationalized
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"}> Pascal Lambrechts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Victor+Tourtchine"} Victor Tourtchine
              = succeed "," do
                %em Homotopy graph-complex for configuration and knot spaces
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/0611766"} arxiv:math/0611766
          %p further review:
          %ul
            %li#Fresse18
              %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"}> Benoit Fresse
              ,
              = succeed "," do
                %em Little discs operads, graph complexes and Grothendieck–Teichmüller groups
              %a.existingWikiWord{:href => "/nlab/show/Haynes+Miller"} Haynes Miller
              (ed.)
              %em
                %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Homotopy+Theory"} Handbook of Homotopy Theory
              (
              %a{:href => "https://arxiv.org/abs/1811.12536"}> arXiv:1811.12536
              )
          %p
            Further discussion of the graph complex as a model for the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            is in
          %ul
            %li
              %p
