                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is thought of as exhibiting a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          %p
            Hence a
            %strong retraction
            of a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} i  \;\colon\;  A \to B
            is a
            = succeed "." do
              %em
                left-
                %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
          %p
            In this situation,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is a
            %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
            %em
              splitting of the
              %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mover
                    %mo ⟶
                    %mi r
                  %mi A
                  %mover
                    %mo ⟶
                    %mi i
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B \stackrel{r}{\longrightarrow} A \stackrel{i}{\longrightarrow} B
                  \\,.
          %p
            Accordingly, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
            is a morphism that
            %em has
            a retraction; a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
            is a morphism that
            %em is
            a retraction.
          %h2#properties Properties
          #LeftInverseWithLeftInverseIsLeftInverse.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
                with
                %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              be
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g \circ f = id
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              itself has a left inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
                    %mi g
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    h \circ g = id
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} h = f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g = f^{-1}
              is an actual (two-sided)
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          .proof
            %h6#proof Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphisms"} inverse morphisms
              are unique if they exists, it is sufficient to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi g
                    %mo =
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \circ g = id
                    \\,.
            %p Compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi f
                            %mo ∘
                            %mi g
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mi h
                                  %mo ∘
                                  %mi g
                                %mo ⏟
                              %mrow
                                %mo =
                                %mi id
                            %mo ∘
                            %mi f
                            %mo ∘
                            %mi g
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi h
                            %mo ∘
                            %munder
                              %munder
                                %mrow
                                  %mi g
                                  %mo ∘
                                  %mi f
                                %mo ⏟
                              %mrow
                                %mo =
                                %mi id
                            %mo ∘
                            %mi g
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi h
                            %mo ∘
                            %mi g
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi id
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    f \circ g
                    \&amp; =  \underset{ = id}{\underbrace{h \circ g}} \circ f \circ g
                    \\\
                    \&amp; =
                    h \circ \underset{= id}{\underbrace{g \circ f}} \circ g
                    \\\
                    \&amp; = h \circ g
                    \\\
                    \&amp; = id
                    \\end{aligned}
          #RetractsPreservedByFunctor.num_remark
            %h6#remark Remark
            %p
              Retracts are clearly preserved by any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          #SplitEpisAndMonos.num_remark
            %h6#remark_2 Remark
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ;
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} r; B \to A
              is the strongest of various notions of
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              (e.g., it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+epimorphism"} regular epimorphism
              %span.newWikiWord
                absolute
                %a{:href => "/nlab/new/abolute+limit"} ?
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %msub
                      %mn 1
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e, 1_B)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo =
                    %mi i
                    %mo ∘
                    %mi r
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} e = i \circ r: B \to B
              is idempotent). Dually, a
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
              is the strongest of various notions of monomorphism.
          #RetractOfObjectWithLLP.num_prop
            %h6#proposition Proposition
            %p
              If an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              has the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              against a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mo ∃
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mo ∃
                              %mo ↗
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo →
                            %mtd
                              %mi B
                            %mtd
                              %mo →
                            %mtd
                              %mi A
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{\exists}}\nearrow&amp; \downarrow
                    \\\
                    A &amp;\to&amp; Y
                    }
                    \\right)
                    \\;\;\;\;
                    \:=
                    \\;\;\;\;
                    \\left(
                    \\array{
                    \&amp;&amp; &amp;&amp; &amp;&amp;  X
                    \\\
                    \&amp;&amp;&amp; {}^{\mathllap{\exists}}\nearrow&amp; &amp;&amp; \downarrow
                    \\\
                    A &amp;\to&amp; B &amp;\to&amp; A &amp;\to&amp; Y
                    }
                    \\right)
          #RetractOfRepresentable.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} split idempotent
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} PSh(C) = [C^{op}, Set]
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F = PSh(C)
              is itself representable.
          %p
            This appears as (
            %a{:href => "#Borceux"}> Borceux, lemma 6.5.6
            )
          %h2#examples Examples
          %h3#to_the_point To the point
          %ul
            %li
              In a category with
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              every morphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} * \to X
              is a section, and the unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to *
              is the corresponding retraction.
          %h3#of_simplices Of simplices
          %p
            The inclusion of standard topological
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mi k
                    %mi n
                  %mo ↪
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Lambda^n_k \hookrightarrow \Delta^n
            is a retract in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %h3#in_arrow_categories In arrow categories
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo →
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \Delta[1] = \{0 \to 1\}
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Delta[1], C]
            is the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            In the theory of
            %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C^{\Delta[1]}
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            is a retract of a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Z
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} g:Z\to W
            if we have commutative squares
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi id
                            %mi X
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi Z
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mi g
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mi f
                      %mtr
                        %mtd
                          %msub
                            %mi id
                            %mi Y
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi Y
                        %mtd
                          %mo →
                        %mtd
                          %mi W
                        %mtd
                          %mo →
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  id_X \colon &amp; X &amp; \to &amp; Z &amp; \to &amp; X
                  \\\
                  \&amp; f \downarrow  &amp; &amp; g \downarrow &amp; &amp; \downarrow f
                  \\\
                  id_Y \colon &amp; Y &amp; \to &amp; W &amp; \to &amp; Y
                  }
          %p such that the top and bottom rows compose to identities.
          #RetractsOfMorphismWithLiftingProperty.num_prop
            %h6#proposition_3 Proposition
            %p
              Classes of morphisms in a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that are given by a left or right
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              are preserved under retracts in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Delta[1],C]
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              are closed under retracts.
          %p
            This is fairly immediate, a proof is made explicit
            = succeed "." do
              %a{:href => "ClosurePropertiesOfInjectiveAndProjectiveMorphisms"} here
          %p This implies:
          #RetractOfIso.num_prop
            %h6#proposition_4 Proposition
            %p
              In every category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              the class of
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              is preserved under retracts in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta[1], C]
          .proof
            %h6#proof_2 Proof
            %p This is also checked directly: for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi id
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi a
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi id
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi b
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi b
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi b
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id \colon &amp; a_1 &amp;\to&amp; a_2 &amp;\to&amp; a_1
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    id \colon &amp; b_1 &amp;\to&amp; b_2 &amp;\to&amp; b_1
                    }
            %p
              a retract diagram and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 2
                    %mo →
                    %msub
                      %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a_2 \to b_2
              an isomorphism, the inverse to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo →
                    %msub
                      %mi b
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1 \to b_1
              is given by the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi a
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi b
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi b
                              %mn 2
                          %mtd
                          %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;  &amp; &amp; a_2 &amp;\to&amp; a_1
                    \\\
                    \&amp; &amp;&amp; \uparrow &amp;&amp;
                    \\\
                    \&amp; b_1 &amp;\to&amp; b_2 &amp;&amp;
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 2
                    %mo →
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} b_2 \to a_2
              is the inverse of the middle morphism.
          %h3#RetractsOfDiagrams Retracts of diagrams
          %p
            For the following, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be categories and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mo ◃
                %annotation{:encoding => "application/x-tex"} J^{\triangleleft}
            for the
            %a.existingWikiWord{:href => "/nlab/show/join+of+quasi-categories"} join
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            with a single
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mo ◃
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} J^{\triangleleft} \to C
            are precisely
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} J \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi J
                  %mo →
                  %msup
                    %mi J
                    %mo ◃
                %annotation{:encoding => "application/x-tex"}
                  i : J \to J^{\triangleleft}
          %p
            for the canonical inclusion and hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} i^* F
            for the underlying diagram of a cone
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi J
                      %mo ◃
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : J^{\triangleleft} \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi J
                    %mo ◃
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [J^{\triangleleft}, C]
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
          #RetractsOfLimits.num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %msub
                      %mi F
                      %mn 1
                    %mo ↪
                    %msub
                      %mi F
                      %mn 2
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Id: F_1 \hookrightarrow F_2 \to F_1
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mo ◃
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [J^{\triangleleft}, C]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                    %mo :
                    %msup
                      %mi J
                      %mo ◃
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F_2 : J^{\triangleleft} \to C
              is a
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              over the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 2
                      %mo :
                      %mi J
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} i^* F_2 : J \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              is a limit cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} i^* F_1
          .proof
            %h6#proof_3 Proof
            %p We give a direct and a more abstract argument.
            %p
              %strong> Direct argument
              \. We can directly check the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the limit: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              any other
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} i^* F_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mi G
                    %mo =
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i^* G = i^* F_1 \to i^* F_2
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              also as a cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} i^* F_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_2
              this extends to a morphism of cones
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G \to F_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_2 \to F_1
              makes this a morphism of cones
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msub
                        %mi F
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G \to F_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_1 \to F_2
              and the universality of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
            %p
              %strong> More abstract argument
              \. The limiting cone over a diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo :
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D : J \to C
              may be regarded as the right
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mi D
                    %mo :
                    %mo =
                    %msub
                      %mi Ran
                      %mi i
                    %mi D
                  %annotation{:encoding => "application/x-tex"} i_* D := Ran_i D
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi J
                          %mtd
                            %mover
                              %mo →
                              %mi D
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %msub
                                  %mi i
                                  %mo *
                                %mi D
                        %mtr
                          %mtd
                            %msup
                              %mi J
                              %mo ◃
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J &amp;\stackrel{D}{\to}&amp; C
                    \\\
                    {}^{\mathllap{i}}\downarrow &amp; \nearrow_{i_* D}
                    \\\
                    J^{\triangleleft}
                    }
                    \\,.
            %p
              Therefore a cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi J
                      %mo ◃
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : J^{\triangleleft} \to C
              is limiting precisely if the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi i
                        %mo *
                      %mo ⊣
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i^* \dashv i_*)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi i
                      %mo *
                    %msup
                      %mi i
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    F \stackrel{}{\to} i_* i^* F
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              it follows that applied to the retract diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %msub
                      %mi F
                      %mn 1
                    %mo ↪
                    %msub
                      %mi F
                      %mn 2
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Id : F_1 \hookrightarrow F_2 \to F_1
            %p it yields the retract diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Id
                            %mo :
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Id
                            %mo :
                          %mtd
                            %msub
                              %mi i
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi F
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi i
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi i
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi F
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Id : &amp; F_1 &amp;\to&amp; F_2 &amp;\to&amp; F_1
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    Id : &amp; i_* i^* F_1 &amp;\to&amp; i_* i^* F_2 &amp;\to&amp; i_* i^* F_1
                    }
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi J
                        %mo ◃
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Delta[1], [J^{\triangleleft}, C]]
              = succeed "," do
                %a.maruku-ref{:href => "#RetractOfIso"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              is a limiting cone.
          %p
            This argument generalizes form limits to
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
          %p
            For that, let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Diagram
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Ho(C) : Diagram^{op} \to Cat
            for the corresponding
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi J
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi W
                    %mi J
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Ho(C)(J) := [J,C](W^J)^{-1}
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of
            = succeed "-diagrams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          #RetractOfHomotopyLimits.num_cor
            %h6#corollary Corollary
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi F
                      %mn 2
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Id : F_1 \to F_2 \to F_1
            %p
              be a retract in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi J
                        %mo ◃
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(C)(J^{\triangleleft})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_2
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              cone over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} i^* F_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              is a homotopy limit cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi F
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} i^* F_1
          .proof
            %h6#proof_4 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
              we have that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mo *
                        %mo :
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi J
                          %mo ◃
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i_* : Ho(C)(J) \to Ho(C)(J^{\triangleleft})
                  forms
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
                  cones;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo →
                        %msub
                          %mi i
                          %mo *
                        %msup
                          %mi i
                          %mo *
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F \to i_* i^* F
                  is an isomorphism precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a homotopy limit cone.
            %p
              With this the claim follows as in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#RetractsOfLimits"}
