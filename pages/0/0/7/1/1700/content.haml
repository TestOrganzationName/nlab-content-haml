                %a{:href => "https://doi.org/10.1016/j.jpaa.2017.08.010"} doi
            %li
              %p
                Joseph Rennie,
                %em The Unreasonable Efficacy of the Lifting Condition in Higher Categorical Galois Theory I: a Quasi-categorical Galois Theorem
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2409.03347"}> arXiv:2409.03347
                \&amp;rbrack;
          %p See also
          %ul
            %li
              %p
                %em
                  %a{:href => "http://www.math.upenn.edu/~galois/"} The Galois Theory Web Page
            %li
              %p
                %a{:href => "http://en.wikipedia.org/wiki/Galois_theory"} Wikipedia: Galois theory
            %li
              %p
                Tamás Szamuely,
                = succeed "," do
                  %em Galois groups and fundamental groups
                %strong 117
                (2009)
            %li#Grothendieck75
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
                , letter to
                %a.existingWikiWord{:href => "/nlab/show/Larry+Breen"} Larry Breen
                17/2/1975
                = succeed "," do
                  %a{:href => "https://agrothendieck.github.io/divers/LGB17275en.pdf"} pdf
                %a{:href => "https://agrothendieck.github.io/divers/LGB17275scanen.pdf"} scan
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
                , La Longue Marche a Travers la Théorie de Galois
                %a{:href => "https://agrothendieck.github.io/galoispoincaregrothendieck/galois.pdf"} pdf
          .property
