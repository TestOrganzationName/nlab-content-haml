          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            of
            %strong supergravity
            is similar to the theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} first order formulation
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (the
            %a.existingWikiWord{:href => "/nlab/show/Einstein-Hilbert+action"} Einstein-Hilbert action
            functional) on the space of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/Poincare+Lie+algebra"} Poincare Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(n,1)
            %a.existingWikiWord{:href => "/nlab/show/super+Poincare+Lie+algebra"} super Poincare Lie algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{siso}(n,1)
            %em local
            (Poincaré)
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            in the same sense that ordinary
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            is the theory of “local Poincaré-symmetry”. These are
            %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            for the
            %a.existingWikiWord{:href => "/nlab/show/Poincare+Lie+algebra"} Poincare Lie algebra
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Poincare+Lie+algebra"} super Poincare Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field (physics)
            is a
            %a.existingWikiWord{:href => "/nlab/show/Cartan+connection"} Cartan connection
            for the inclusion
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi o
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝔰𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} o(n,1) \hookrightarrow \mathfrak{siso}(n,1)
          %p
            if we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔦𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{siso}(n,1)
            as a
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
            of the translation Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{(n,1)}
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{so}(n,1)
            and a
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-form"} Lie algebra valued 1-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %mi 𝔰𝔦𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A : T X \to \mathfrak{siso}(n,1)
          %p
            that decomposes into three components,
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi Ω
                    %mo ,
                    %mi Ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = (E, \Omega, \Psi)
          %ul
            %li
              %p
                a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n,1}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                – the
                %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
              %p
                (this encodes the
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
                and hence the field of
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %li
              %p
                a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{so}(n,1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
                – called the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
            %li
              %p
                a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ψ
                    %annotation{:encoding => "application/x-tex"} \Psi
                – called the
                %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
                field.
          %p
            Typically in fact the field content of supergravity is larger, in that a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is really an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra-valued+differential+form"} ∞-Lie algebra-valued differential form
            with values in an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            such as the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
            (
            %a{:href => "#DAuriaFreCastellani"}> DAuriaFreCastellani
            )
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲𝔤𝔯𝔞
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}(10,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
