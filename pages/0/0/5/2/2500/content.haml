                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} |
                            %mi N
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %msup
                          %mover
                            %mi ℝ
                            %mo ^
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} |
                            %mi N
                            %mo =
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{Iso}(\widehat{\mathbb{R}}^{10,1\vert N=1})
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔬
