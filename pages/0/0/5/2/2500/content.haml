              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Axel+Kleinschmidt"} Axel Kleinschmidt
              %em Eisenstein series for infinite-dimensional U-duality groups
              (
              %a{:href => "http://arxiv.org/abs/1204.3043"}> arXiv:1204.3043
              )
          %h3#ReferencesNonRelativisticSupergravity Non-relativistic supergravity
          %p
            On non-
            %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
            supergravity:
          %ul
            %li
              %p
                Roel Andringa,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eric+A.+Bergshoeff"} Eric A. Bergshoeff
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Rosseel"} Jan Rosseel
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em Newton-Cartan Supergravity
                %strong 30
                20 (2013) &amp;lbrack;
                %a{:href => "https://doi.org/10.1088/0264-9381/30/20/205005"}> doi:10.1088/0264-9381/30/20/205005
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1305.6737"} arXiv:1305.6737
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Rosseel"} Jan Rosseel
                = succeed "," do
                  %em Newton-Cartan (super)gravity as a non-relativistic limit
                %strong 32
                (2015) 205003 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1505.02095"}> arXiv:1505.02095
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/0264-9381/32/20/205003"} doi:10.1088/0264-9381/32/20/205003
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+A.+Bergshoeff"}> Eric A. Bergshoeff
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Rosseel"} Jan Rosseel
                = succeed "," do
                  %em Non-Lorentzian Supergravity
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2211.02604"} arXiv:2211.02604
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-981-99-7681-2_52"} doi:10.1007/978-981-99-7681-2_52
            %li
              %p
                Patrick Concha,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Lucrezia+Ravera"} Lucrezia Ravera
                = succeed "," do
                  %em Non-Lorentzian Supergravity and Kinematical Superalgebras
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2412.07665"} arXiv:2412.07665
          %p
            On non-relativistic SuGra as an
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            for excitation modes of
            %a.existingWikiWord{:href => "/nlab/show/FQH+systems"} FQH systems
            (cf.
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry+in+fractional+quantum+Hall+systems+--+references"} supersymmetry in fractional quantum Hall systems
          %ul
            %li
              %p
                Dung Xuan Nguyen, Kartik Prabhu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ajit+C.+Balram"} Ajit C. Balram
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Andrey+Gromov"} Andrey Gromov
                = succeed "," do
                  %em Supergravity model of the Haldane-Rezayi fractional quantum Hall state
                %strong 107
                (2023) 125119 [
                %a{:href => "https://doi.org/10.1103/PhysRevB.107.125119"}> doi:10.1103/PhysRevB.107.125119
                ,
