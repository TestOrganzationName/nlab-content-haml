                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2507.12535"}> arXiv:2507.12535
                \&amp;rbrack;
            %li
              %p
                Tony Gherghetta, Wenqi Ke:
                %em Supergravity from the Bottom Up
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2507.12538"}> arXiv:2507.12538
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            of supergravity:
          %ul
            %li
              S. Deser, J.H. Kay, K.S. Stelle,
              = succeed "," do
                %em Renormalizability Properties of Supergravity
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1506.03757"} arXiv:1506.03757
          %h3#UDualityReferences U-duality
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            of supergravity compactifications:
          %p Some basic facts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"}> Jacques Distler
              ,
              %em Split real forms
              (
              %a{:href => "http://golem.ph.utexas.edu/~distler/blog/archives/001213.html"}> blog post
              ).
          %p
            The
            = succeed "-symmetry" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mn 7
                        %mo{:stretchy => "false"} (
                        %mn 7
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{7(7)}
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bernard+de+Wit"}> Bernard de Wit
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 11
                      %annotation{:encoding => "application/x-tex"} D = 11
                  Supergravity With Local
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 8
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(8)
                  Invariance
              %p B 274, 363 (1986)
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mn 8
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{8(8)}
            in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
                ,
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 11
                      %annotation{:encoding => "application/x-tex"} D = 11
                  Supergravity with Local
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 16
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(16)
                  Invariance
                , Phys. Lett. B 187, 316 (1987).
            %li
              %p
                K. Koepsell,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Henning+Samtleben"} Henning Samtleben
                = succeed "," do
                  %em
                    An exceptional geometry for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} d = 11
                    supergravity?
                = succeed ")." do
                  %a{:href => "http://arxiv.org/abs/hep-th/0006034"} arXiv:hep-th/0006034
          %p The discrete quantum subgroups were discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              %em Unity of Superstring Dualities
              Nucl.Phys.B438:109-137 (1995) (
              %a{:href => "http://arxiv.org/abs/hep-th/9410167"}> arXiv:hep-th/9410167
              )
          %p which also introduced the term “U-duality”.
          %p Review and further discusssion is in
          %ul
            %li
              Shun’ya Mizoguchi, Germar Schroeder,
              = succeed "," do
                %em On Discrete U-duality in M-theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9909150"} arXiv:hep-th/9909150
          %p A careful discussion of the topology of the U-duality groups is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arjan+Keurentjes"}> Arjan Keurentjes
                ,
                %em The topology of U-duality (sub-)groups
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0309106"}> arXiv:hep-th/0309106
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arjan+Keurentjes"}> Arjan Keurentjes
                ,
                %em U-duality (sub-)groups and their topology
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0312134"}> arXiv:hep-th/0312134
                )
          %p
            A discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/generalized+complex+geometry"} generalized complex geometry
            \/
            %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+complex+geometry"} exceptional generalized complex geometry
            is in
          %ul
            %li
              %p
                Paulo Pires Pacheco,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Waldram"} Daniel Waldram
                %em M-theory, exceptional generalised geometry and superpotentials
                (
                %a{:href => "http://arxiv.org/abs/0804.1362"}> arXiv:0804.1362
                )
            %li
              %p
                Nicholas Houston,
                %em Supergravity and Generalized Geometry
                Thesis (2010) (
                %a{:href => "https://workspace.imperial.ac.uk/theoreticalphysics/Public/MSc/Dissertations/2010/Nicholas%20Houston%20Dissertation.pdf"}> pdf
                )
          %p
            The case of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 10
                %annotation{:encoding => "application/x-tex"} E_{10}
            ” is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thibault+Damour"}> Thibault Damour
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"} Marc Henneaux
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mn 10
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E(10)
                  and a ‘small tension expansion’ of M
              %p
                theory_, Phys. Rev. Lett. 89, 221601 (2002) (
                %a{:href => "http://arxiv.org/abs/hep-th/0207267"}> arXiv:hep-th/0207267
                );
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Axel+Kleinschmidt"}> Axel Kleinschmidt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mo{:stretchy => "false"} (
                          %mn 10
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} E(10)
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 9
                          %mo ,
                          %mn 9
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(9,9)
                    invariant supergravity
              %p
                041 (2004) (
                %a{:href => "http://arxiv.org/abs/hep-th/0407101"}> arXiv:hep-th/0407101
                )
          %p
            and that of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 11
                %annotation{:encoding => "application/x-tex"} E_{11}
            ” in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 11
                      %annotation{:encoding => "application/x-tex"} E_{11}
                  and M-theory
              = succeed ")." do
                %a{:href => "http://arxiv.org/abs/hep-th/0104081"} arXiv:hep-th/0104081
          %p
            General discussion of the
            %a.existingWikiWord{:href => "/nlab/show/Kac-Moody+groups"} Kac-Moody groups
            arising in this context is for instance in
          %ul
            %li
