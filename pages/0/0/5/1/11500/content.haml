                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                  %msub
                    %mo ∮
                    %mi C
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi z
                      %mo −
                      %mi ζ
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f(\zeta) =  \frac{1}{2\pi\mathrm{i}}\oint_C \frac{f(z)}{z - \zeta} \,\mathrm{d}z.
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/contour+integral"} contour integral
            picks out the enclosed
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/residues"} residues
          %p
            More generally, this implies, by
            %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
            expansion of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{(n)}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi n
                      %mo !
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                  %msub
                    %mo ∮
                    %mi C
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi ζ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                  %mi d
                  %mi z
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f^{(n)}(\zeta)
                  \=
                  \\frac{n!}{2\pi i}  \oint_C \frac{f(z)}{(z - \zeta )^{n+1}} d z
                  \\,.
          %p
            This is also known as
            = succeed "." do
              %em Cauchy’s differentiation formula
          %h2#proof_in_synthetic_differential_geometry Proof in synthetic differential geometry
          %p
            Here is a proof written in terms of
            %a.existingWikiWord{:href => "/nlab/show/synthetic+mathematics"} synthetic
            %a.existingWikiWord{:href => "/nlab/show/infinitesimals"} infinitesimals
            as in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            be a nilpotent. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi ϵ
                %annotation{:encoding => "application/x-tex"} S_\epsilon
            denote the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            of
            %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            centered at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo −
                  %mi ζ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} f(z)/(z-\zeta) \,\mathrm{d}z
            is
            %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed
            in the region bounded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi ϵ
                  %annotation{:encoding => "application/x-tex"} S_\epsilon
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mrow
                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                  %msub
                    %mo ∮
                    %mi C
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi z
                      %mo −
                      %mi ζ
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                  %msub
                    %mo ∮
                    %mrow
                      %msub
                        %mi S
                        %mi ϵ
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi z
                      %mo −
                      %mi ζ
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{1}{2\pi\mathrm{i}}\oint_C \frac{f(z)}{z - \zeta} \,\mathrm{d}z = \frac{1}{2\pi\mathrm{i}}\oint_{S_\epsilon} \frac{f(z)}{z - \zeta} \,\mathrm{d}z.
          %p
            Parametrize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi ϵ
                %annotation{:encoding => "application/x-tex"} S_\epsilon
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ↦
                  %mi ζ
                  %mo +
                  %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (t\mapsto \zeta + \epsilon \,\exp(2\pi\mathrm{i}t))
            to transform the above integral to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mrow
                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi ζ
                      %mo +
                      %mi ϵ
                      %mspace{:width => "thinmathspace"}
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi ϵ
                      %mspace{:width => "thinmathspace"}
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %mi{:mathvariant => "normal"} i
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo +
                  %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo +
                  %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                %annotation{:encoding => "application/x-tex"} \frac{1}{2\pi\mathrm{i}}\int_0^1 \frac{f(\zeta + \epsilon\, \exp(2\pi\mathrm{i}t))}{\epsilon \,\exp(2\pi\mathrm{i}t))} \,\mathrm{d}(\zeta + \epsilon\, \exp(2\pi\mathrm{i}t)) = \int_0^1 f(\zeta + \epsilon\, \exp(2\pi\mathrm{i}t)) \, \mathrm{d}t
          %p
            By the infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor formula
            and the
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphicity
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo +
                  %mi ϵ
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi ζ
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %mi z
                  %mo .
                %annotation{:encoding => "application/x-tex"} f(\zeta + \epsilon\exp(2\pi\mathrm{i}t)) = f(\zeta) + \epsilon\,\exp(2\pi\mathrm{i}t) \frac{\partial f(\zeta)}{\partial z}.
          %p Hence the above integral is equal to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mrow
                    %mo [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi ζ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi ϵ
                    %mspace{:width => "thinmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi{:mathvariant => "normal"} i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi ζ
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %mi z
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo =
                  %mrow
                    %mo [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi ζ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi ϵ
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi ζ
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %mi z
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi{:mathvariant => "normal"} i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo ]
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ζ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \int_0^1 \left[f(\zeta) + \epsilon\,\exp(2\pi\mathrm{i}t) \frac{\partial f(\zeta)}{\partial z}\right] \, \mathrm{d}t = \left[f(\zeta) + \epsilon\frac{\partial f(\zeta)}{\partial z} \int_0^1 \exp(2\pi\mathrm{i}t)  \, \mathrm{d}t\right] = f(\zeta).
