          %p This page is supposed to be a review of the seminal article
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Beilinson"}> Alexander Beilinson
                ,
              %p
                %em> Higher regulators and values of L-functions
                ,
              %p Journal of Soviet Mathematics 30 (1985), 2036-2070,
              %p
                (
                %a{:href => "http://www.mathnet.ru/php/archive.phtml?wshow=paper&jrnid=intd&paperid=73&option_lang=eng"}> mathnet (Russian)
                ,
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1007%2FBF02105861"} DOI
          %p
            introducing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Beilinson-Deligne+cohomology"} Beilinson-Deligne cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulators"} Beilinson regulators
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+regulators"} higher regulators
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Beilinson+conjectures"} Beilinson conjectures
          %p
            Please note that it is currently in a very preliminary state, having been prepared quickly as notes for a seminar talk on the first section of the paper. It follows the paper very closely, and an interested reader might like to rewrite from the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
          %h2#overview Overview
          %h3#notation Notation
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/analytic+space"} analytic space
            we will mean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+analytic+space"} real analytic space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi An
                %annotation{:encoding => "application/x-tex"} An
            denote the real
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/analytic+site"} analytic site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi An
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ab(Sh(An))
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi An
                  %annotation{:encoding => "application/x-tex"} An
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi An
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^+(An)
            its bounded above
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            %a.existingWikiWord{:href => "/nlab/show/connective"} connective
            %a.existingWikiWord{:href => "/nlab/show/cochain+complexes"} cochain complexes
            up to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi An
                  %annotation{:encoding => "application/x-tex"} X \in An
            %a.existingWikiWord{:href => "/nlab/show/petit+topos"} petit topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} X^\sim
            of sheaves on the site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ouv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ouv(X)
            of open subsets.
          %p
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi An
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^+(An)
            we have the complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+forms"} holomorphic forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mo ≥
                      %mi i
                %annotation{:encoding => "application/x-tex"} \Omega^{\ge i}
            denote the “stupid”
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
          %p
            Fix a subring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊂
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                %annotation{:encoding => "application/x-tex"} A \subset \mathbf{R}
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi A
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi p
                  %mo ⊂
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} A(p) = A \cdot (2\pi i)^p \subset \mathbf{C}
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} p \in \mathbf{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ∈
                  %msup
                    %mi D
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi An
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{C} \in D^+(An)
            also for the constant sheaf valued in the complex concentrated in degree zero. Similarly we will view
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(p)
            as an object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi An
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^+(An)
          %p
            We will write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi B
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^*_B(X, \mathbf{C})
            for the
            %a.existingWikiWord{:href => "/nlab/show/Betti+cohomology"} Betti cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi An
                  %annotation{:encoding => "application/x-tex"} X \in An
          %h3#main_constructions_and_conjectures Main constructions and conjectures
          %h4#deligne_cohomology_of_analytic_spaces Deligne cohomology of analytic spaces
          %p
            For each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} p \in \mathbf{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mo ≥
                      %mi p
                  %mo ↪
                  %msup
                    %mi Ω
                    %mo •
                %annotation{:encoding => "application/x-tex"} \Omega^{\ge p} \hookrightarrow \Omega^\bullet
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ↪
                  %msup
                    %mi Ω
                    %mo •
                %annotation{:encoding => "application/x-tex"} A(p) \hookrightarrow \mathbf{C} \hookrightarrow \Omega^\bullet
            induce a canonical morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mo ≥
                      %mi p
                  %mo ⊕
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mo •
                %annotation{:encoding => "application/x-tex"} \Omega^{\ge p} \oplus A(p) \longrightarrow \Omega^\bullet
          %p (given by the difference of the two inclusions).
          .num_defn
            %h6#definition Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                    %annotation{:encoding => "application/x-tex"} p \in \mathbf{Z}
              = succeed "," do
                %strong
                  Deligne complex of weight
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} D
                    %annotation{:encoding => "application/x-tex"} A(p)_\D
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of the above morphism shifted by -1, hence fitting in the
              %a.existingWikiWord{:href => "/nlab/show/distinguished+triangle"} distinguished triangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo ≥
                        %mi p
                    %mo ⊕
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} D
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mo ≥
                        %mi p
                    %mo ⊕
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (\Omega^{\ge p} \oplus A(p))[-1] \longrightarrow \Omega^\bullet[-1] \longrightarrow A(p)_\D \longrightarrow \Omega^{\ge p} \oplus A(p).
          %p
            The Deligne cohomology is just the
            %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
            of this complex. That is, consider the
            %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R\Gamma(-, A(p)_D)
            of the functor of
            %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi An
                %annotation{:encoding => "application/x-tex"} An
            with values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo −
                    %mi mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^+(A-mod)
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong Deligne cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi An
                  %annotation{:encoding => "application/x-tex"} X \in An
              of weight
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi D
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mi q
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} H_D^q(X, A(p)) = H^q R\Gamma(X, A(p)_D).
          .num_prop
            %h6#proposition Proposition
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msubsup
                      %mi H
                      %mi B
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi D
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mo ≥
                        %mi p
                    %msubsup
                      %mi H
                      %mi B
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} \cdots \to H^{q-1}_B(X, \mathbf{C}) \to H^q_D(X, A(p)) \to \Omega^{\ge p} H^q_B(X, \mathbf{C}) \oplus H^q(X, A(p)) \to \cdots
          %p
            This follows by applying the
            %a.existingWikiWord{:href => "/nlab/show/cohomological+functor"} cohomological functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R\Gamma(X, -)
            to the above
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distinguished+triangle"} distinguished triangle
          .num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p \le 0
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mover
                      %mo ⟶
                      %mo ∼
                    %msup
                      %mi Ω
                      %mrow
                        %mo ≥
                        %mi p
                    %mo .
                  %annotation{:encoding => "application/x-tex"} A(p)_D \stackrel{\sim}{\longrightarrow} \Omega^{\ge p}.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p \gt 0
              there are canonical
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi D
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ∼
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi 𝒪
                            %mo →
                            %msup
                              %mi Ω
                              %mn 1
                            %mo →
                            %mi ⋯
                            %mo →
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ∼
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo →
                            %mi 𝒪
                            %mo{:stretchy => "false"} /
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msup
                              %mi Ω
                              %mn 1
                            %mo →
                            %mi ⋯
                            %mo →
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A(p)_D &amp;\stackrel{\sim}{\longrightarrow} (A(p) \to \mathcal{O} \to \Omega^1 \to \cdots \to \Omega^{p-1}) &amp; (\ast) \\
                    \&amp;\stackrel{\sim}{\longrightarrow} (0 \to \mathcal{O}/A(p) \to \Omega^1 \to \cdots \to \Omega^{p-1}) &amp;
                    \\end{aligned}
          %h4#multiplicative_structure Multiplicative structure
          .num_prop
            %h6#proposition_2 Proposition
            %p
              There exists a canonical morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi An
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^+(An)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ∪
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %msup
                      %mo ⊗
                      %mi L
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo ⟶
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                  %annotation{:encoding => "application/x-tex"} - \cup - : A(i)_D \otimes^L A(j)_D \longrightarrow A(i+j)_D
            %p
              inducing the structure of a
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi D
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %msubsup
                      %mi H
                      %mi D
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^*_D(X, A(*)) = \bigoplus_{p,q} H^p_D(X, A(p))
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi An
                    %annotation{:encoding => "application/x-tex"} X \in An
          .proof
            %h6#proof Proof
            %p
              Beilinson gives an explicit formula using the usual explicit model for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mrow
                          %mo ≥
                          %mo *
                    %annotation{:encoding => "application/x-tex"} \Omega^{\ge *}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(*)
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/cochain+complexes"} cochain complexes
              (of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              (of complexes of sheaves). Consider then the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              of the diagram
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Ω
                      %mo ←
                      %msup
                        %mi Ω
                        %mrow
                          %mo ≥
                          %mo *
                    %annotation{:encoding => "application/x-tex"} A(*) \to \Omega \leftarrow \Omega^{\ge *}
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              has in each degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              the Deligne complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                  %annotation{:encoding => "application/x-tex"} A(p)_D
              of weight
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %a{:href => "#HopkinsQuick"} Hopkins-Quick
            %p
              Here we will simply give a formula for the quasi-isomorphic complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (*)
              of Lemma 1 (assuming
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i,j \gt 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi E
                    %annotation{:encoding => "application/x-tex"} A(i)_E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi An
                    %annotation{:encoding => "application/x-tex"} X \in An
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in \Gamma(X, A(i)_E)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi j
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y \in \Gamma(X, A(j)_E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∪
                    %mi y
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %mi x
                              %mo ⋅
                              %mi y
                            %mtd
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                              %mspace{:width => "1em"}
                              %mtext or
                              %mspace{:width => "1em"}
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi x
                              %mo ∧
                              %mi dy
                            %mtd
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo &gt;
                              %mn 0
                              %mspace{:width => "1em"}
                              %mtext and
                              %mspace{:width => "1em"}
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi j
                              %mo &gt;
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    x \cup y = \begin{cases}
                    x \cdot y &amp; \deg(x) = 0\quad\text{or}\quad\deg(y) = 0 \\
                    x \wedge dy &amp; \deg(x) \gt 0\quad\text{and}\quad\deg(y) = j \gt 0 \\
                    0 &amp; \text{otherwise}
                    \\end{cases}
            %p
              We omit the various verifications, that this defines a morphism of complexes, is associative, commutative, etc. One gets a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              in the category of cochain complexes of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R\Gamma(X, -)
              preserves monoids, so that one gets the structure of a graded commutative ring on the
              %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi D
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^*_D(X, A(*))
          %h4#the_bloch_regulator The Bloch regulator
          %p
            Beilinson uses this cup product for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo =
                  %mi j
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} i=j=1
            to recover the
            = succeed "." do
              %span.newWikiWord
                Bloch regulator
                %a{:href => "/nlab/new/Bloch+regulator"} ?
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong> (Bloch)
              \. For each
              %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                    %annotation{:encoding => "application/x-tex"} \mathbf{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi X
                    %mo :
                    %msub
                      %mi K
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi B
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r_X : K_2(X) \to H^1_B(X, \mathbf{C}^*)
            %p
              from the second
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
              group to the first
              %a.existingWikiWord{:href => "/nlab/show/Betti+cohomology"} Betti cohomology
              group with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^*
          .proof
            %h6#sketch_of_proof Sketch of proof
            %p By Lemma 1, there are quasi-isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mover
                      %mo →
                      %mo ∼
                    %msup
                      %mi 𝒪
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}(1)_D \stackrel{\sim}{\to} \mathcal{O}^*[-1]
            %p
              induced by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mover
                      %mo →
                      %mo ∼
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒪
                      %mo *
                    %mover
                      %mo →
                      %mrow
                        %mi d
                        %mi log
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}(2)_D \stackrel{\sim}{\to} (\mathcal{O}^* \stackrel{d \log}{\to} \Omega^1)[-1]
            %p
              induced by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi π
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \mapsto \exp(x/2\pi i)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∪
                    %mo :
                    %msubsup
                      %mi H
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msubsup
                      %mi H
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi H
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cup : H^1_D(X, \mathbf{Z}(1)) \otimes H^1_D(X, \mathbf{Z}(1)) \longrightarrow H^2_D(X, \mathbf{Z}(2))
            %p corresponds to a canonical homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi 𝒪
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi 𝒪
                      %mo *
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^*(X) \otimes \mathcal{O}^*(X) \to H^1(X, \mathcal{O}^* \to \Omega^1).
            %p
              According to Deligne, the RHS classifies isomorphism classes of
              %a.existingWikiWord{:href => "/nlab/show/line+bundles"} line bundles
              with
              = succeed "." do
                %span.newWikiWord
                  holomorphic connection
                  %a{:href => "/nlab/new/holomorphic+connection"} ?
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \dim(X) = 1
              %a.existingWikiWord{:href => "/nlab/show/connections"} connections
              are
              %a.existingWikiWord{:href => "/nlab/show/integrable+connection"} integrable
              and this group is identified with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi B
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^1_B(X, \mathbf{C}^*)
            %p
              Now by Matsumoto’s theorem, giving a presentation of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} K_2
              group of a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              by two generators and certain relations, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ⊗
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo &lt;
                    %mi t
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo &gt;
                      %mrow
                        %mi t
                        %mo ≠
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} K_2(\mathcal{O}(X)) = (\mathcal{O}(X)^* \otimes \mathcal{O}(X)^*)/\lt t \otimes (1-t) \gt_{t \ne 0,1}.
            %p
              On the other hand, one has the Steinberg identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t \cup (1-t) = 0
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %msup
                        %mi 𝒪
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t \in \mathcal{O}^*(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi K
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_2(\mathcal{O}(X)) = K_2(\eta)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              a generic point. To extend it to all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi K
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mi K
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi η
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mo ⊕
                            %mrow
                              %mi x
                              %mo ∈
                              %mi X
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi C
                              %mo{:stretchy => "false"} )
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msubsup
                            %mi H
                            %mi B
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi C
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi H
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi η
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mo *
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mo ⊕
                            %mrow
                              %mi x
                              %mo ∈
                              %mi X
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi C
                              %mo{:stretchy => "false"} )
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccccc}
                    K_2(X) &amp; \longrightarrow &amp; K_2(\eta) &amp; \longrightarrow &amp; \oplus_{x \in X(\mathbf{C})} \mathbf{C}^* \\
                    \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                    H^1_B(X, \mathbf{C}) &amp; \longrightarrow &amp; H^1(\eta, \mathbf{C}^*) &amp; \longrightarrow &amp; \oplus_{x \in X(\mathbf{C})} \mathbf{C}^*
                    \\end{array}
            %p
              The first row comes from the
              %span.newWikiWord
                Gersten-Quillen resolution
                %a{:href => "/nlab/new/Gersten-Quillen+resolution"} ?
              for K-theory.
          %h4#relative_cohomology Relative cohomology
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            are
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mo :
                  %mi S
                  %mo ⇄
                  %mi T
                  %mo :
                  %msub
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^* : S \rightleftarrows T : u_*
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Artin+gluing"} Artin gluing
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi S
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi u
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi u
                    %mo *
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi id
                    %mi T
                  %mo{:stretchy => "false"} )
