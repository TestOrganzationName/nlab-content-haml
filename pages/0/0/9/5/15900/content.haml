                  %annotation{:encoding => "application/x-tex"}
                    \\oplus c_1(\mathcal{O}(1))^j \cup \pi^*
                    \: \bigoplus_{j=0}^{r-1} H_D(X, A(i-j))[2j]
                    \\longrightarrow H_D(\mathbf{P}(E), A(i))
            %p is invertible.
          .proof
            %h6#proof_2 Proof
            %p By definition we have the distinguished triangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
