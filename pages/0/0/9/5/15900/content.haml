                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} cl_D : Z_n(X) \longrightarrow H'_D^{-2n}(X, A(-n))
          %p
            given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cl
                      %mi D
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo{:stretchy => "false"} ]
