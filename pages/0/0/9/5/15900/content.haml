                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Omega_{X, \overline{X}} \hookrightarrow \mathcal{D}_{X, \overline{X}}[-2n]
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+quasi-isomorphism"} filtered quasi-isomorphism
              %a.existingWikiWord{:href => "/nlab/show/associated+graded+objects"} associated graded objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
