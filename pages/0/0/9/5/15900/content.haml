                        %mi j
                        %mo =
                        %mn 0
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %msub
                      %mi H
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
