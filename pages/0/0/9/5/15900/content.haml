            an
            %a.existingWikiWord{:href => "/nlab/show/irreducible+topological+space"} irreducible
            subscheme of dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msubsup
                    %mo ′
                    %mi D
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi H
                  %msubsup
                    %mo ′
                    %mi B
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
