                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} cl_D : Z^n(X) \longrightarrow H_D^{2n}(X, A(n))
          %p
            on the group of
            %span.newWikiWord
              algebraic cyles
              %a{:href => "/nlab/new/algebraic+cyles"} ?
