                  %mi A
                %annotation{:encoding => "application/x-tex"} H'_D^{-2n}(Y, A(-n)) \longrightarrow H'_B^{-2n}(Y, A(-n)) = A
          %p
            is invertible. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi cl
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
