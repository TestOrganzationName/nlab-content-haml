              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi X
                      %mo ¯
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(p)_D \in Ch^+(Ab((X, \overline{X})^\sim))
              and defined as follows. In degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                    %annotation{:encoding => "application/x-tex"} n \in \mathbf{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi D
                        %mo ,
                        %mi X
                    %mo =
                    %msup
                      %mi Cone
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(p)_{D,X} = Cone^n(A(p) \to \Omega^\bullet_X)
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"} X^\sim
              (where the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              is taken in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ch
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi Ab
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mo ∼
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch^+(Ab(X^\sim))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi D
                        %mo ,
                        %mover
                          %mi X
                          %mo ¯
                    %mo =
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi X
                        %mo ,
                        %mover
                          %mi X
                          %mo ¯
                      %mrow
                        %mo ≥
                        %mi p
                  %annotation{:encoding => "application/x-tex"} A(p)_{D,\overline{X}} = \Omega^{\ge p}_{X, \overline{X}}
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi X
                          %mo ¯
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"} \overline{X}^\sim
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Ω
                        %mrow
                          %mo ≥
                          %mi p
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msubsup
                        %mi Ω
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} j^*(\Omega^{\ge p}) \hookrightarrow \Omega^\bullet_X
          .num_defn
            %h6#definition_6 Definition
            %p
              The
              %strong Beilinson-Deligne cohomology with logarithmic singularities
              of the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi X
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \overline{X})
              in weight
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              and with coefficients in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi D
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi X
                      %mo ¯
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mi q
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi X
                      %mo ¯
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} H^q_D(X, \overline{X}, A(p)) = H^q R\Gamma((X, \overline{X})^\sim, A(p)_D).
          %p One defines a cup product on these complexes in the same way as above, and gets a graded commutative ring structure on Beilinson-Deligne cohomology with logarithmic singularities.
          .num_defn
            %h6#definition_7 Definition
          %h4#deligne_cohomology_for_algebraic_varieties Deligne cohomology for algebraic varieties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo ′
                  %mo ⊂
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi' \subset \Pi
            denote the full subcategory spanned by pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mover
                    %mi X
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \overline{X})
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{X}
            is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+variety"} smooth
            %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+variety"} algebraic variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %msub
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                %annotation{:encoding => "application/x-tex"} V = V_\mathbf{R}
            denote the category of
            %a.existingWikiWord{:href => "/nlab/show/smooth+variety"} smooth
            %a.existingWikiWord{:href => "/nlab/show/quasi-projective+variety"} quasi-projective
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbf{R}
            %a.existingWikiWord{:href => "/nlab/show/GAGA"} GAGA
            principle, we have a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi Π
                  %mo ′
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \sigma : \Pi' \to V
            which sends a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mover
                    %mi X
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \overline{X})
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X \in V
            %span.newWikiWord
              Hironaka
              %a{:href => "/nlab/new/Hironaka"} ?
            there exists a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mover
                    %mi X
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Π
                  %mo ′
                %annotation{:encoding => "application/x-tex"} (X, \overline{X}) \in \Pi'
            (a compactification).
          .num_defn
            %h6#definition_8 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X \in V
              be a smooth quasi-projective algebraic variety over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                    %annotation{:encoding => "application/x-tex"} \mathbf{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi X
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Π
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} (X, \overline{X}) \in \Pi'
              be a compactification and define the
              %strong Beilinson-Deligne cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi D
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mi q
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo ¯
                    %mo ,
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_D^q(X, A(p)) = H^q R\Gamma(\overline{X}, X, A(p)_D)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi B
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mi q
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} H_B^q(X, A(p)) = H^q R\Gamma(X, A(p)).
          %p
            One shows that these definitions are independent of the chosen compactification. By the above, one gets a
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            also on these cohomology groups.
          %p
            Next Beilinson shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi D
                %annotation{:encoding => "application/x-tex"} H_D
            can be defined as cohomologies of certain complexes of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski sheaves
          %h4#chern_classes_of_vector_bundles Chern classes of vector bundles
          %p There is a canonical morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mo :
                  %mi R
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %msub
                    %mi H
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c_1 : R\Gamma(X, \mathcal{O}^*)[-1] \longrightarrow H_D(X, A(1))
          %p
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X \in V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pic
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pic(X) = H^1(X, \mathcal{O}^*) \longrightarrow H^2(X, A(1))
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/Picard+group"} Picard group
            of
            = succeed "." do
              %span.newWikiWord
                invertible sheaves
                %a{:href => "/nlab/new/invertible+sheaves"} ?
          .num_defn
            %h6#definition_9 Definition
            %p
              For an
              %span.newWikiWord
                invertible sheaf
                %a{:href => "/nlab/new/invertible+sheaf"} ?
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong first Chern class
              is defined to be the image of the class of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              under the above homomorphism.
          %p
            One can show that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} A = \mathbf{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compact"} compact
          %p
            Next Beilinson shows the
            %span.newWikiWord
              projective bundle formula
              %a{:href => "/nlab/new/projective+bundle+formula"} ?
            for Beilinson-Deligne cohomology.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong> (Projective bundle formula)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be an
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              of rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi : \mathbf{P}(E) \to X
              be the associated
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+bundle"} projective bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(1)
              the
              %span.newWikiWord
                tautological sheaf
                %a{:href => "/nlab/new/tautological+sheaf"} ?
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{P}(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi j
                    %mo ∪
                    %msup
                      %mi π
                      %mo *
                    %mo :
                    %munderover
