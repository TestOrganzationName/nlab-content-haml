                  %mi Y
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H'_D^{-2n}(Y, A(-n))
            corresponding to the unit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} 1 \in A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi cl
                    %mi D
                  %mo :
                  %msub
                    %mi Z
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi H
                  %msubsup
                    %mo ′
                    %mi D
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi n
