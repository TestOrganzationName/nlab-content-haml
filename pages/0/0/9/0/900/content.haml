                    %mi G
                    %mo{:stretchy => "false"} )
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cong Hom_{\mathcal{A}}(\underset{d:\mathcal{D}}{lim} (i \circ F) d, \underset{e:\mathcal{E}}{lim} (i \circ G) e)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %msub
