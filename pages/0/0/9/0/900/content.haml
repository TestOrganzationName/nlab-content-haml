              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} G:\mathcal{E} \to \mathcal{C}
              be pro-objects. We then have a sequence of (natural) bijections:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Pro
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Pro(\mathcal{C})}(F,G)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %munder
                      %mi lim
                      %mrow
                        %mi e
                        %mo :
                        %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mi colim
                      %mrow
                        %mi d
                        %mo :
                        %mi 𝒟
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi F
