                    %mo ,
                    %mi G
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} = \underset{e:\mathcal{E}}{lim} \, \underset{d:\mathcal{D}}{colim} \, Hom_{\mathcal{C}}(F d, G e)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≅
