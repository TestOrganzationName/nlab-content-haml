                  the first step is the
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithfulness
                  of the defining
                  = succeed "-inclusion" do
                    %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  = succeed ";" do
                    %a.maruku-eqref{:href => "#eq:ProCAsFullSubcategoryOfOppositeOfCategoryOfPresheaves"} (3)
              %li
                %p
                  the second step is the definition of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                  = succeed ";" do
                    %a.maruku-ref{:href => "#BetweenFilteredLimitsAndFilteredColimits"}
              %li
                %p
                  the third step uses that
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/hom-functors+preserve+limits"} hom-functors preserve limits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒦
                          %mi op
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒦
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                        %mi Sets
                      %annotation{:encoding => "application/x-tex"} \mathcal{K}^{op}  \xrightarrow{\;\mathcal{K}(-,k)\;} Sets
                  takes
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒦
                        %annotation{:encoding => "application/x-tex"} \mathcal{K}
                  to
                  %em
                    limits in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒦
                            %mo =
                            %mi Func
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo ,
                            %mi Sets
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \mathcal{K} = Func(\mathcal{C},Sets)
              %li
                %p
                  the fourth step is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %li
                %p
                  the fifth step is Lemma
                  = succeed "." do
                    %a.maruku-ref{:href => "#ProObjectsAsFunctors"}
            %p
