            can be viewed as actual limits in a certain category. We prove here some results of this kind.
          %p
          #PropositionCategoriesEquivalentToProC.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a category, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a category with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofiltered+limit"} cofiltered limits
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} i: \mathcal{C} \rightarrow \mathcal{A}
              which lands in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+object"} cocompact objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mi 𝒜
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} lim_{\mathcal{A}} \circ (i \circ) : Pro(\mathcal{C}) \to \mathcal{A}
              is fully faithful, and hence defines an equivalence onto its image.
            %p
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
