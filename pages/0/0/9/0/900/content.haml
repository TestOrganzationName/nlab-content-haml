                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cong \underset{e:\mathcal{E}}{lim} \, \underset{d:\mathcal{D}}{colim} \, Hom_{\mathcal{A}}(i (F d), i (G e))
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≅
                    %munder
                      %mi lim
                      %mrow
                        %mi e
                        %mo :
                        %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mrow
                        %mi d
                        %mo :
                        %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mi d
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cong \underset{e:\mathcal{E}}{lim} \, Hom_{\mathcal{A}}(\underset{d:\mathcal{D}}{lim} (i \circ F) d, i (G e))
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
