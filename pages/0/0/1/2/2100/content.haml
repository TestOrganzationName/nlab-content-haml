                  \\\
                  \&amp;&amp;&amp;&amp; X_2 &amp;&amp;&amp;&amp;
                  }
                  \\,.
          %p This is described by the diagram
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_48.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msubsup
                            %mi p
                            %mn 1
                            %mo *
                          %mi Ψ
                      %mtr
                        %mtd
                        %mtd
