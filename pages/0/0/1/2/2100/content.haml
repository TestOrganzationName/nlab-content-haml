                        %mtd
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi g
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Z
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Y
                  \\\
                  \&amp;&amp; \downarrow^g
                  \\\
                  X &amp;\stackrel{f}{\to}&amp; Z
                  }
          %p
            a diagram in
            = succeed "," do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            of
            %a.existingWikiWord{:href => "/nlab/show/over+category"} over categories
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_54.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi Y
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{H}/X) \times_{\mathbf{H}/Y} \mathbf{H}/Y
          %p
            are those pairs
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
