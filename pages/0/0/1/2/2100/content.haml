                  %annotation{:encoding => "application/x-tex"} C(X \times_Z Y)
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_60.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
