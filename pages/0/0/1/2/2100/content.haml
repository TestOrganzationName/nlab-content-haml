                      \\\
                      \&amp;&amp; Y_1 &amp;&amp;&amp;&amp; Y_2
                      \\\
                      \&amp; {}^t\swarrow &amp;&amp; \searrow^u &amp;&amp; {}^v\swarrow &amp;&amp; \searrow^w
                      \\\
                      X_1 &amp;&amp;&amp;&amp; X_2 &amp;&amp;&amp;&amp; X_4
                      }
              %p
                is a composite of two
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/span"} span
              .maruku-equation
                %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
