          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_41.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo{:stretchy => "false"} (
                  %mi Ψ
                  %mo ,
                  %msup
                    %mi f
                    %mo *
                  %mi Φ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo *
                  %mi Ψ
                  %mo ,
                  %mi Φ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom_{\mathbf{H}/X}(\Psi, f^* \Phi)
                  \\simeq
                  Hom_{\mathbf{H}/X}(f_* \Psi, \Phi)
          %p which is established by the essential uniqueness of the universal morphism into the pullback
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_42.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ψ
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mrow
                              %mo ∃
                              %mo !
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} ¯
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi k
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mi f
                            %mo *
                          %mi Φ
                        %mtd
                          %mo →
                        %mtd
                          %mi Φ
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msup
                                %mi f
                                %mo *
                              %mi ψ
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi ψ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Psi &amp;&amp;\to&amp;&amp;
                  \\\
                  \&amp; \searrow^{\exists ! \bar k} &amp; &amp;&amp; \downarrow^{k}
                  \\\
                  \\downarrow &amp;&amp; f^* \Phi &amp;\to&amp; \Phi
                  \\\
                  \&amp;\searrow&amp; \downarrow^{f^* \psi} &amp;&amp; \downarrow^\psi
                  \\\
                  \&amp;&amp; X &amp;\stackrel{f}{\to}&amp; Y
                  }
          %p
            Here the outer diagram exhibits a morphism
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %msub
                      %mi f
                      %mo *
                    %mi Ψ
                    %mo →
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} k : f_* \Psi \to \Phi
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            says that this essentially uniquely corresponds to the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            morphism
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
