          %p
            which are precisely the objects of
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
