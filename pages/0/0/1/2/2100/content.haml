                  %mi X
                %annotation{:encoding => "application/x-tex"} \psi : \Psi \to X
            and
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi Φ
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \phi : \Phi \to Y
            such that we get a (homotopy) commutative diagram
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_57.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ψ
                          %mo ≃
                          %mi Φ
                        %mtd
                          %mover
                            %mo →
                            %mi ϕ
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
