                      \\,.
              %p Of course this just means that the two ways to pull-push through the pullback diamond
              .maruku-equation
                %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_17.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
