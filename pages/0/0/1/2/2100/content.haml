                              %mn 1
                    %mo )
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \left(\array{ \Psi \\ \downarrow^{\psi} \\ Y_1}\right) \in C(Y_1)
            through a pullback diamond (see the introduction above)
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_47.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Y
