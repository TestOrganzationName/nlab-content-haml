                      C(X \times_Z Y) \simeq C(X) \otimes_{C(Z)} C(Y)
                      \\,.
          %h2#overcategories_and_groupoidification over-categories and groupoidification
          %p This first example is rather minimalistic and may feel a bit tautological, as compared to more involved constructions as discussed below. It does nevertheless have interesting applications and, due to its structural simplicity, should serve as a good model on which to study the structural aspects of geometric function theory.
          %p So consider here the assignment
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_21.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  C := \mathbf{H}/(-) : \mathbf{H} \to (\infty,1)Cat
          %p
            that sends each object
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            to its
            %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
          %p
            Checking that this assignment does satisfy a good deal of the properties of a geometric function object amounts to recalling the properties of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over categories
          %p
            So an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X)
            is a morphism
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %mi Ψ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \psi : \Psi \to X
            in
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo ,
                  %mi Ψ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo ′
                  %mo ,
                  %mi Ψ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\psi,\Psi) \to (\psi',\Psi')
            is a diagram
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_28.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ψ
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mi Ψ
                          %mo ′
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mi ψ
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mrow
                              %mi ψ
                              %mo ′
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Psi &amp;&amp;\to&amp;&amp; \Psi'
                  \\\
                  \&amp; {}_\psi\searrow &amp;&amp; \swarrow_{\psi'}
                  \\\
                  \&amp;&amp; X
                  }
          %p
            in
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            For
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            a morphism in
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            the push-forward functor
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_32.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f_* : C(X) \to C(Y)
          %p
            is simply given by postcomposition with
            = succeed ":" do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_34.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ψ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi ψ
                        %mtr
                          %mtd
                            %mi X
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ψ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi ψ
                        %mtr
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %mi Y
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f_* \;\;:\;\;
                  \\left(
                  \\array{
                  \\Psi
                  \\\
                  \\downarrow^\psi
                  \\\
                  X
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  \\array{
                  \\Psi
                  \\\
                  \\downarrow^\psi
                  \\\
                  X
                  \\\
                  \\downarrow^f
                  \\\
                  Y
                  }
                  \\right)
                  \\,.
          %p The pullback functor
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_35.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f^* : C(Y) \to C(X)
          %p
            is literally given by the (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"}> homotopy
            )
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_36.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi f
                            %mo *
                          %mi Ψ
                        %mtd
                          %mo →
                        %mtd
                          %mi Ψ
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msup
                                %mi f
                                %mo *
                              %mi ψ
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi ψ
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  f^* \Psi &amp;\to&amp; \Psi
                  \\\
                  \\downarrow^{f^* \psi} &amp;&amp; \downarrow^\psi
                  \\\
                  X &amp;\stackrel{f}{\to}&amp; Y
                  }
          %p
            of a morphism
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %mi Ψ
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \psi : \Psi \to Y
            along
            = succeed "." do
              %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            A quick way to check that pushforward
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            and pullback
            %math#mathml_113c989f2e9b2a0f6487505e924b173522c83f79_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            defined this form a pair of
            = succeed "s" do
