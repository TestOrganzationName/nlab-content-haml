          %p As a consequence:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a{:href => "#McCord66"}> McCord 66, theorem 6
                ,
                = succeed ")" do
                  %a{:href => "#Quillen78"} Quillen 78, prop. 1.6
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D}
              be
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              and consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
