                %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
                of suitable algebras of functions on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %p
            .num_prop
              %h6 Proposition
              %p
                The
                %em powering
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                over
                %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Grpd
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} Grpd_\infty
                is given by the
                %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
                out of the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+constant+infinity-stack"}
                    locally constant
                    = succeed "-stacks" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
