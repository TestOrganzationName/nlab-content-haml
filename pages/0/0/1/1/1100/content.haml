            %p
            .num_remark
              %h6 Remark
              %p
                Under
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} Isbell duality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
