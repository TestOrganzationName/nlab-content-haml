                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          #RModulesAsInfinityPresheaves.num_defn
            %h6#definition_notation Definition (Notation)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet \in Ch_\bullet(\mathbf{R}Mod)
              be a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              (unbounded) of
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              of
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                    %annotation{:encoding => "application/x-tex"} \mathbf{R}
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              this defines an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SmthMfd
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi L
                      %mi qi
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi SmthMfd
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi SmthMfs
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ch_\bullet(\mathbf{R}Mod)
                    \\longrightarrow
                    Sh(SmthMfd, Ch_{\bullet})
                    \\longrightarrow
                    L_{qi} PSh(SmthMfd, Ch_\bullet)
                    \\simeq
                    PSh_\infty(SmthMfs, Ch_\bullet)
                    \\,.
            %p
              We still write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ∈
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi SmthMfd
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet\in PSh_\infty(SmthMfd, Ch_\bullet)
              for this
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              of chain complexes.
