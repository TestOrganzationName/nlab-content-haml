                      %annotation{:encoding => "application/x-tex"} D
          %h3#StrongEquivalence Strong equivalence
          %p
            Two
            %a.existingWikiWord{:href => "/nlab/show/strict+categories"} strict categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            %strong strongly equivalent
            if there exist strict functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F\colon C \to D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G\colon D \to C
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi G
                %annotation{:encoding => "application/x-tex"} F G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} G F
            are each
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
            (
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            in the relevant
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            %strong strong equivalence
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
