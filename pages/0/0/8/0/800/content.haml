                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mi n
                      %annotation{:encoding => "application/x-tex"} k^n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is not (though it is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/essentially+small+category"} essentially small
                = succeed ")." do
