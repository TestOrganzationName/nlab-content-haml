              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/ModCat"}> ModCat
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/CombModCat"} CombModCat
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Pr%28%E2%88%9E%2C1%29Cat"} Pr(∞,1)Cat
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Operad"} (∞,1)Operad
