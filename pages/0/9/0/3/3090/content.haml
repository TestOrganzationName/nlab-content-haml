                      %mrow
                    %mi B
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} = \big\{ U_i \overset{}{\hookrightarrow} B \big\}_{i \in I}
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              to each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              (i.e. its
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              to the cover) is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
