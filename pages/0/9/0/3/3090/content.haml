                      %mi n
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} (id,0) \colon D^n \hookrightarrow D^n \times I
              that include the standard topological
              %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
              into its standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
          %p
