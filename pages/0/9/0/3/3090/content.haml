          %h3#LocalRecognition Local recognition
          #MapIsSerreFibrationIfLocallySo.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong (map is Serre fibration if it is locally so)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
