              and set
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi κ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta(\vec v,t) \coloneqq \kappa(t \vec v)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              of the top two squares that have appeared this way is equivalent to the following commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
