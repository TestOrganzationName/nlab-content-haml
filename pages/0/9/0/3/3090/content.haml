                                      %mrow
                                        %mi Serre
                                      %mrow
                                        %mi fibration
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mrow
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi pb
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mrow
                                %msub
