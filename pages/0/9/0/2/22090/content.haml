              %li#Segal73
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                  ,
                  = succeed "," do
                    %em Configuration-spaces and iterated loop-spaces
                  %strong 21
                  (1973), 213–221. MR 0331377 (
                  %a{:href => "http://dodo.pdmi.ras.ru/~topology/books/segal.pdf"}> pdf
                  )
                %p c Generalization of these constructions and results is due to
              %li#McDuff75
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Dusa+McDuff"}> Dusa McDuff
                  ,
                  = succeed "," do
                    %em Configuration spaces of positive and negative particles
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1016/0040-9383(75)90038-5"} doi:10.1016/0040-9383(75)90038-5
              %li#Boedigheimer87
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Carl-Friedrich+B%C3%B6digheimer"}> Carl-Friedrich Bödigheimer
                  ,
                  = succeed "," do
                    %em Stable splittings of mapping spaces
                  = succeed "," do
                    %a{:href => "http://www.math.uni-bonn.de/~cfb/PUBLICATIONS/stable-splittings-of-mapping-spaces.pdf"} pdf
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/BoedigheimerStableSplittings87.pdf", :title => "pdf"} pdf
            %h4#thoms_construction Thom’s construction
            %p
              %a.existingWikiWord{:href => "/nlab/show/Thom%27s+theorem"} Thom's theorem
              i.e. the unstable and
              %em oriented
              version of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+construction"} Pontrjagin-Thom construction
              %a.existingWikiWord{:href => "/nlab/show/cobordism+classes"} cobordism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/normally+oriented+submanifolds"} normally oriented submanifolds
              with
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
              to the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M SO(n)
            %ul
              %li#Thom54
                %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Thom"}> René Thom
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Quelques+propri%C3%A9t%C3%A9s+globales+des+vari%C3%A9t%C3%A9s+diff%C3%A9rentiables"} Quelques propriétés globales des variétés différentiables
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/BF02566923"} doi:10.1007/BF02566923
                = succeed "," do
                  %a{:href => "https://eudml.org/doc/139072"} dml:139072
                = succeed "," do
                  %a{:href => "http://www.digizeitschriften.de/dms/img/?PID=GDZPPN002056259"} digiz:GDZPPN002056259
                = succeed ")" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/thomcob.pdf"} pdf
            %p Textbook accounts:
            %ul
              %li#Stong68
                %a.existingWikiWord{:href => "/nlab/show/Robert+Stong"}> Robert Stong
