                  = succeed ")" do
                    %a{:href => "http://dx.doi.org/10.4310/HHA.2017.v19.n2.a16"} doi:10.4310/HHA.2017.v19.n2.a16
              %li#FranekKrcalWagner18
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Franek"}> Peter Franek
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Marek+Kr%C4%8D%C3%A1l"} Marek Krčál
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Hubert+Wagner"} Hubert Wagner
                  = succeed "," do
                    %em Solving equations and optimization problems with uncertainty
                  %strong 1
                  (2018) 297 (
                  %a{:href => "https://arxiv.org/abs/1607.06344"}> arxiv:1607.06344
                  ,
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1007/s41468-017-0009-6"} doi:10.1007/s41468-017-0009-6
            %p Review:
            %ul
              %li{:id => "FranekKrčál15"}
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Franek"}> Peter Franek
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Marek+Kr%C4%8D%C3%A1l"} Marek Krčál
                  = succeed "," do
