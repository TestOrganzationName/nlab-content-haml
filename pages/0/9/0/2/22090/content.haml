              from
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/persistent+homology"} persistent homology
            %ul
              %li#FranekKrcal16
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Franek"}> Peter Franek
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Marek+Kr%C4%8D%C3%A1l"} Marek Krčál
                  = succeed "," do
                    %em On Computability and Triviality of Well Groups
                  %strong 56
                  (2016) 126 (
                  %a{:href => "https://arxiv.org/abs/1501.03641"}> arXiv:1501.03641
                  ,
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1007/s00454-016-9794-2"} doi:10.1007/s00454-016-9794-2
              %li#FranekKrcal17
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Franek"}> Peter Franek
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Marek+Kr%C4%8D%C3%A1l"} Marek Krčál
                  = succeed "," do
                    %em Persistence of Zero Sets
                  %strong 19
