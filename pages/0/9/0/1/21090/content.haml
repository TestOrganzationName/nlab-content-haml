          %ul
            %li
              %p
                In
                = succeed "," do
                  %em FinStoch
                %a.existingWikiWord{:href => "/nlab/show/stochastic+map"} stochastic map
                of entries
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p|_X(y|x)
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y\in Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi p
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      p(x,y) = p_X(x)\,p|_X(y|x) .
              %p
                (Note the difference between the
                = succeed "," do
                  %em marginal
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi X
                      %annotation{:encoding => "application/x-tex"} p_X
                = succeed "," do
                  %em conditional
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi X
                      %annotation{:encoding => "application/x-tex"} p|_X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      p|_X(y|x) = \frac{p(x,y)}{p(x)}
              %p
                when
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p(x)\ne 0
            %li
              %p
                In
                = succeed "," do
                  %em Stoch
                %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"} Markov kernel
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi X
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p|_X:X\to Y
                such that for all measurable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A\subseteq X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} B\subseteq Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi A
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi p
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      p(A\otimes B) = \int_A p|_X(B|x)\,p_X(d x) .
              %p
                This is known in probability theory as a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#regular_conditional_distributions"} regular conditional distribution
          %p
            Note that, if a conditional distribution exists, it is unique only up to
            = succeed "-almost" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} p_X
          %ul
            %li
              In
              %em FinStoch
              all conditional distributions exist;
            %li
              In
              = succeed "," do
                %em Stoch
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/standard+Borel+spaces"} standard Borel spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BorelStoch"} BorelStoch
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#regular_conditional_distributions"} regular conditional distribution
          %p
            It is helpful to think of a conditional distribution as of turning the output
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into an input. In terms of string diagram, it is sometimes helpful to represent this as follows,
          %svg{:height => "122.013pt", :version => "1.2", :viewbox => "0 0 196.702 122.013", :width => "196.702pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
