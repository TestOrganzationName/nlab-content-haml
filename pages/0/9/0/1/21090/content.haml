          %p
            Note that this is the same as a conditional given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            for the joint on the right-hand side. The equation can be seen as a version of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Bayes%27+formula"} Bayes' formula
          %ul
            %li
              %p
                In
                = succeed "," do
                  %em FinStoch
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mi f
                        %mi p
                        %mo †
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      q(y) \,f^\dagger_p(x|y) = p(x) \,f(y|x) ,
              %p which is in the usual form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      P(y) \, P(x|y) = P(x) \, P(y|x) ,
              %p
                which recovers the usual
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bayesian+inversion#discrete_case"} Bayesian version for stochastic maps
            %li
              %p
                In
                = succeed "," do
                  %em Stoch
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A\subseteq X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} B\subseteq Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi B
                      %msubsup
                        %mi f
                        %mi p
                        %mo †
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi A
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_B f^\dagger_p(A|y) \, q(d y) = \int_A f(B|x)\,p(d x) .
              %p
                This recovers the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bayesian+inversion#measuretheoretic_case"} Bayesian inversion of Markov kernels
          %p
            Once again, Bayesian inversions exist for all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/standard+Borel+spaces"} standard Borel spaces
            = succeed "-almost" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          %p
            To conclude this section, let’s give the most general definition of conditional. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi A
                  %mo →
                  %mi X
                  %mo ⊗
                  %mi Y
                %annotation{:encoding => "application/x-tex"} h:A\to X\otimes Y
            be a joint morphism. A
            %strong conditional
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            %strong given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi X
                  %mo :
                  %mi X
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} h|_X:X\otimes A\to Y
            such that the following equation holds.
