                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p(x) \ne 0
