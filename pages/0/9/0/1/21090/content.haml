          %p which we can interpret as the facts that
          %ul
            %li The two copies are interchangeable;
            %li Copying once and discarding one of the two copies is the same as doing nothing;
            %li Copying once and then copying one of the copies is the same as copying the other copy.
          %p In other words, these conditions assure that the interpretation as “copying and discarding information” is consistent.
          %h3#markov_and_cd_categories Markov and CD categories
          %p
            A
            %strong copy-discard (CD) category
            or
            %strong garbage-share (GS) monoidal category
            is a symmetric monoidal category where
          %ul
            %li
              %p Every object is equipped with a distinguished commutative comonoid structure;
            %li
              %p The comonoid structures are compatible with the tensor products in the following ways.
          %p
            First for all, for all objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi copy
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo ⊗
                  %msub
                    %mi b
                    %mrow
                      %mi Y
                      %mo ,
                      %mi X
                  %mo ⊗
                  %msub
                    %mi id
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi copy
                    %mi X
                  %mo ⊗
                  %msub
                    %mi copy
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  copy_{X\otimes Y} \; =\; (id_X\otimes b_{Y,X} \otimes id_Y) ( copy_X \otimes copy_Y ),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            denotes the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
