          %p
            This reflect the traditional idea of probability theory of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zero-one+measure"} zero-one measure
          %ul
            %li
              %p
                In
                = succeed "," do
                  %em FinStoch
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is deterministic if and only if for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi x
                        %mo ′
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x,x'\in X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi δ
                        %mrow
                          %mi x
                          %mo ,
                          %mi x
                          %mo ′
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      p(x)\,\delta_{x,x'} = p(x)\,p(x') ,
              %p
                i.e. if and only if for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x\in X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      p(x) = p(x)^2 .
              %p
                This means precisely that for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p(x)=0
                or
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p(x)=1
            %li
              %p
                In
                = succeed "," do
                  %em Stoch
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is deterministic if and only if for every measurable subset
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊆
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A\subseteq X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p(A)=0
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p(A)=1
                (
                %a.existingWikiWord{:href => "/nlab/show/zero-one+measure"}> zero-one measure
                ). That is, we are (almost) certain about which events happen and which do not. On well-behaved measurable spaces, such as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/standard+Borel+spaces"} standard Borel spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+measure"} Dirac delta
            %li
              %p
                In
                = succeed "," do
                  %em Set
          %p
            More generally, a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            in a Markov category is called
            %strong deterministic
