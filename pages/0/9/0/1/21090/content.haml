          %h3#commutative_comonoids Commutative comonoids
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %a.existingWikiWord{:href => "/nlab/show/commutative"} commutative
            %a.existingWikiWord{:href => "/nlab/show/internal+monoid"} comonoid
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            consists first of all of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi X
                  %mo ⊗
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\mapsto X\otimes X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X\to I
            %em comultiplication
            and
            = succeed "," do
              %em counit
            %em copy
            and
            = succeed "." do
              %em discard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi copy
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mo ⊗
                  %mi X
                %annotation{:encoding => "application/x-tex"} copy: X \to X \otimes X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi del
                  %mo :
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} del: X\to 1
