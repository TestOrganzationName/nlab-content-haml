                  %mo ⊗
                  %mi Y
                %annotation{:encoding => "application/x-tex"} A\otimes B\to X\otimes Y
            of entries
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⊗
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} |
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (f\otimes g) (x,y|a,b) = f(x|a) \, g(y|b) ,
