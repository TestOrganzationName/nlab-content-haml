                (see
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/stochastic+map#stochastic_maps_from_deterministic_functions"} here
            %li
              %p
                In
                = succeed "," do
                  %em Stoch
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} k:X\to Y
                is deterministic if and only if for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                and every measurable
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} B\subseteq Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k(B|x)=0
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k(B|x)=1
                (
                %a.existingWikiWord{:href => "/nlab/show/zero-one+kernels"}> zero-one kernels
                ). On well-behaved measurable spaces, such as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/standard+Borel+spaces"} standard Borel spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is in the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \delta_f
                for a measurable function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                (see
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#kernels_from_deterministic_functions"} here
            %li
              %p
                In
                = succeed "," do
                  %em Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                both side of the equations yield
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo =
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\big(f(x),f(x)\big) = \big(f(x),f(x)\big) ,
              %p
                where on the left we have applied
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and copied the result, while on the right we have copied
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and applied
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                to both copies.
          %p
            Let’s now see where the generic case differs from
            = succeed "," do
              %em Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a “random” function between real numbers, which adds to the input the result of the roll of a die. Given a number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi n
                    %mo ,
                    %mi x
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x+n,x+n)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi m
                    %mo ,
                    %mi x
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x+m,x+n)
            %em definition
            of randomness: it’s a process that may give a different result if you do it twice. Or equivalently, that copying the information before or after the process has taken place gives different results.
          %p
            A
            %em deterministic
            morphism is one that does
            %em not
            exhibit this behavior, i.e. that commutes with the copy map.
          %p
            Deterministic morphisms are closed under composition. One usually denotes the
            %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
            of deterministic morphisms of a Markov category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi det
                  %annotation{:encoding => "application/x-tex"} C_det
          %p We have seen that in a Markov category, every morphism commutes with the discard map. Therefore, from the category-theoretic perspective, we can equivalently see deterministic morphisms exactly as the morphisms of comonoids.
          %p
            The following statement makes precise the idea, sketched in the previous sections, that
            = succeed ":" do
              %em no inference is possible without randomness
          %p
          #eqdet.num_prop
            %h6 Proposition
            %p For a Markov category, the following conditions are equivalent.
            %ol
              %li Every morphism is deterministic;
              %li The copy maps are natural;
              %li
                The category is
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal
              %li Every morphism displays conditional independence of its outputs given its inputs.
            %p
          %p
            (See also
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Fox%27s+theorem"} Fox's theorem
          %p Therefore, we can consider Markov categories as a generalization of cartesian monoidal categories to the case where “randomness is present”.
          %p (However, using Markov categories to study cartesian categories, while technically possible, usually yields trivial results, since all the correlations are trivial and no inference is possible.)
          %h3#almost_sure_equality Almost sure equality
          %p
            Another concept of probability and measure theory that Markov categories formalize is
            = succeed "." do
              %em almost sure equality
            = succeed "," do
              %em up to a null set
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f,g:X\to Y
            be morphisms in a Markov category, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a state on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-almost surely equal
            if and only if the following equation holds.
