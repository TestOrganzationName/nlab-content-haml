              ,
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~jmf/CV/Seminars/SUSY98.pdf"} talk slides
          %p Other review:
          %ul
            %li
              Adémólá Adéìféoba:
              = succeed "," do
                %em Brane Solutions in Supergravity and the Near-Horizon Geometries
              = succeed "," do
                %em
                  %a{:href => "https://www.mathi.uni-heidelberg.de/~walcher/teaching/sose18/adscft/"}
                    Holography and large-
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    dualities
              = succeed "," do
                %a{:href => "https://www.mathi.uni-heidelberg.de/~walcher/teaching/sose18/adscft/AdemolaWriteup.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Adeifeoba-BraneSolutions.pdf", :title => "pdf"} pdf
          %p
            The near horizon geometry of coincident
            %a.existingWikiWord{:href => "/nlab/show/KK-monopoles"} KK-monopoles
            in
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            is discussed in
          %ul
            %li#IMSY98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nissan+Itzhaki"}> Nissan Itzhaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jacob+Sonnenschein"} Jacob Sonnenschein
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shimon+Yankielowicz"} Shimon Yankielowicz
                = succeed "," do
                  %em
                    Supergravity and The Large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    Limit of Theories With Sixteen Supercharges
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9802042"} arXiv:hep-th/9802042
            %li#ItzhakiTseytlinYankielowicz98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nissan+Itzhaki"}> Nissan Itzhaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"} Arkady Tseytlin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shimon+Yankielowicz"} Shimon Yankielowicz
                = succeed "," do
                  %em Supergravity Solutions for Branes Localized Within Branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9803103"} arXiv:hep-th/9803103
            %li#Hashimoto98
              %p
                Akikazu Hashimoto,
                = succeed "," do
                  %em Supergravity Solutions for Localized Intersections of Branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9812159"} arXiv:hep-th/9812159
            %li#Asano00
              %p
                Masako Asano, section 3 of
