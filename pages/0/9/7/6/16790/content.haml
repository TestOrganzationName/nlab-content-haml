                          %mn 1
                  %mo +
                  %msub
                    %mi g
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 4
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  g_{M5} \;\overset{\ell_{th} \to 0}{\longrightarrow}\;
                  g_{\mathbb{R}^{5,1}}
                  +
                  g_{C(X_4)}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %mi M
