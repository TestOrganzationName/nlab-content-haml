                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mo{:stretchy => "false"} /
                      %mn 3
                  %mi N
                  %msub
                    %mi ℓ
                    %mi P
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\ell_{th} \;=\; \sqrt{2} (2\pi)^{-2/3} N \ell_P
                  \\,.
          %p
            The identification
            %a.maruku-eqref{:href => "#eq:OrbifoldIdentificationForKKMonopole"} (4)
            means that this is the
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            %a.existingWikiWord{:href => "/nlab/show/metric+cone"} metric cone
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
