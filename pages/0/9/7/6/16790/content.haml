                %annotation{:encoding => "application/x-tex"} \ell_{th} \to 0
            %a.maruku-eqref{:href => "#eq:BlackM5BraneMetric"} (2)
            becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ⟶
                    %mrow
