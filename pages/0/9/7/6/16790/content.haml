                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  g_{M2}
                  \\overset{\ell_{th} \gg 1}{\longrightarrow}
                  \\;\;\;
                  \&amp;
                  \\left(
                  r/\ell_{th}
                  \\right)^{4}
                  g_{(\mathbb{R}^{2,1})}
                  +
                  \\left( r/\ell_{th} \right)^{-2} g_{C(X_7)}
