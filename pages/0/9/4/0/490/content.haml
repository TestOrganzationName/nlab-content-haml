                    %annotation{:encoding => "application/x-tex"} C(-, a), C(-, b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              are
              %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
