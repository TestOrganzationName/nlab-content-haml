                  %annotation{:encoding => "application/x-tex"} G^{C(-, a)}(b)
              is inhabited by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
