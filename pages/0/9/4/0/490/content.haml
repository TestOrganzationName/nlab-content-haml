                    %mrow
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{N} \cup \{a, b\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \leq n+1
              = succeed "," do
