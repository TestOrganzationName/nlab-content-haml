                  %annotation{:encoding => "application/x-tex"} G^P(b)
              is inhabited (the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi C
