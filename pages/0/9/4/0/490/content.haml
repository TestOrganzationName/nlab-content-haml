                      %mi F
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} e: F \to G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
