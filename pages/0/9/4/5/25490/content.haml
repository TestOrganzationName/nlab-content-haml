          %p
            As such,
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            However, via
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            of the evident
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            (whose
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            is
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒮
                    %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{S}^{\mathcal{I}}
            of
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
          %p
            This monoidal structure on
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} internal to
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            = succeed "." do
