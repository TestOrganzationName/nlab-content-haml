                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext and
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mrow
                      %mi i
                      %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi ϕ
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ∘
                  %mi R
                  %mo{:stretchy => "false"} )
