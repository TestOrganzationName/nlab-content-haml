          %p
            In the special case of this generalization where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ≡
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} U \equiv \mathbb{C}^\times
            is the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            and restricting the dependence to be on the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the parameters
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi R
                    %mo{:stretchy => "false"} ˇ
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo ,
                  %mi u
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mover
                    %mi R
                    %mo{:stretchy => "false"} ˇ
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} /
                  %mi u
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\check R(u, u') \,=\, \check R( u/u')
                  \\,,
          %p
            the parameterized quantum Yang-Baxter equation
            %a.maruku-eqref{:href => "#eq:ParameterizedQuantumYBEquation"} (4)
            becomes (identifying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ≔
                  %msub
                    %mi u
                    %mn 1
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi u
                    %mn 2
                %annotation{:encoding => "application/x-tex"} u \coloneqq u_1/u_2
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ≔
                    %msub
                      %mi u
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi u
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} v \coloneqq u_2/u_3
          #eq:MultiplicativeSpectrallyParameterizedQuantumYBEquation.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 23
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 13
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 12
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 12
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 13
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 23
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\check R_{23}(v)
                  \\circ
                  \\check R_{13}(u v)
                  \\circ
                  \\check R_{12}(u)
                  \\;=\;
                  \\check R_{12}(u)
                  \\circ
                  \\check R_{13}(u v)
                  \\circ
                  \\check R_{23}(v)
                  \\,,
          %p
            and one speaks of the parameterized quantum Yang-Baxter equation with “
            %em> multiplicative spectral parameter
            ”.
          %p
            Yet again redefining by passage to
            %a.existingWikiWord{:href => "/nlab/show/logarithms"} logarithms
            of the parameters,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ↦
                  %mi ln
                  %mi u
                %annotation{:encoding => "application/x-tex"} u \mapsto ln u
            (or rather, understanding the previous parameters as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponentials
            %a.maruku-eqref{:href => "#eq:MultiplicativeSpectrallyParameterizedQuantumYBEquation"} (6)
            assumes the form with “
            %em> additive spectral parameter
            ”:
          #eq:MultiplicativeSpectrallyParameterizedQuantumYBEquation.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 23
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 13
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo +
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 12
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 12
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 13
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo +
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 23
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\check R_{23}(v)
                  \\circ
                  \\check R_{13}(u + v)
                  \\circ
                  \\check R_{12}(u)
                  \\;=\;
                  \\check R_{12}(u)
                  \\circ
                  \\check R_{13}(u + v)
                  \\circ
                  \\check R_{23}(v)
                  \\,.
          %p
            This spectral form
            %a.maruku-eqref{:href => "#eq:MultiplicativeSpectrallyParameterizedQuantumYBEquation"} (6)
            is close to the historical origin of Yang-Baxter equation, whence some authors refer to this form by default as the “
            %em> the Yang-Baxter equation
            ” (cf.
            = succeed ")." do
              %a{:href => "#Jimbo89"} Jimbo 1989 (2.1)
          %h3#classical_ybe Classical YBE
          %p (…)
          %h2#Variants Variants
          %p
            Beware that the term
            %em Yang-Baxter equation
            can mean (or be interpreted in the context of) any of several related but different concepts:
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Yang-Baxter+equations"} Yang-Baxter equations
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/classical+Yang-Baxter+equation"} classical Yang-Baxter equation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/quantum+Yang-Baxter+equation"} quantum Yang-Baxter equation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/dynamical+quantum+Yang-Baxter+equation"} dynamical quantum Yang-Baxter equation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/associative+Yang-Baxter+equation"} associative Yang-Baxter equation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+relation"} infinitesimal braid relation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/set+theoretic+Yang-Baxter+equation"} set theoretic Yang-Baxter equation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/quasitriangular+bialgebra"} quasitriangular bialgebra
          %h2#References References
          %blockquote
            %p
              for more see at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/quantum+Yang-Baxter+equation"} quantum YBE
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/classical+Yang-Baxter+equation"} classical YBE
              %a{:href => "#Variants"} etc.
          %p
            The (
            %a.existingWikiWord{:href => "/nlab/show/quantum+Yang-Baxter+equation"}> quantum
            )
            %em Yang-Baxter equation
            was named (cf.
            = succeed ")" do
              %a{:href => "#PerkAu-Yang06"} Perk &amp; Au-Yang 2006
            %a.existingWikiWord{:href => "/nlab/show/Ludwig+Fadeev"} Ludwig Fadeev
            in the late 1970s, in honor of:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"}> Chen Ning Yang
                \:
                = succeed "," do
                  %em Some Exact Results for the Many-Body Problem in one Dimension with Repulsive Delta-Function Interaction
                %strong 19
                (1967) 1312 &amp;lbrack;
                %a{:href => "https://doi.org/10.1103/PhysRevLett.19.1312"}> doi:10.1103/PhysRevLett.19.1312
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"}> Chen Ning Yang
                \:
                = succeed "," do
                  %em
                    S Matrix for the One-Dimensional
                    = succeed "-Body" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                          %annotation{:encoding => "application/x-tex"} N
                    = succeed "-Function" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi δ
                          %annotation{:encoding => "application/x-tex"} \delta
                %strong 168
                (1968) 1920 &amp;lbrack;
                %a{:href => "https://doi.org/10.1103/PhysRev.168.1920"}> doi:10.1103/PhysRev.168.1920
                \&amp;rbrack;
          %p and
          %ul
            %li#Baxter72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rodney+J.+Baxter"}> Rodney J. Baxter
                \:
                = succeed "," do
                  %em Partition function of the Eight-Vertex lattice model
                %strong 70
                1 (1972) 193-228 [
                %a{:href => "https://doi.org/10.1016/0003-4916(72)90335-1"}> doi:10.1016/0003-4916(72)90335-1
                ]
            %li#Baxter78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rodney+J.+Baxter"}> Rodney J. Baxter
                \:
                = succeed "," do
                  %em Solvable eight-vertex model on an arbitrary planar lattice
                %strong 289
                1359 (1978) &amp;lbrack;
                %a{:href => "https://doi.org/10.1098/rsta.1978.0062"}> doi:10.1098/rsta.1978.0062
                \&amp;rbrack;
            %li#Baxter82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rodney+Baxter"}> Rodney Baxter
                \:
                = succeed "," do
                  %em Exactly Solved Models in Statistical Mechanics
                = succeed "," do
                  %a{:href => "https://physics.anu.edu.au/research/ftp/mpg/baxter_book.php"} webpage
                = succeed "&rbrack;" do
                  %a{:href => "https://physics.anu.edu.au/research/ftp/_files/Exactly.pdf"} pdf
              %blockquote
                %p (who spoke instead of the “star-triangle relation”).
          %p Reviews:
          %ul
            %li#Jimbo89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michio+Jimbo"}> Michio Jimbo
                \:
                = succeed "," do
                  %em Introduction to the Yang-Baxter Equation
                %strong 4
                15 (1989) 3717-3757 &amp;lbrack;
                %a{:href => "https://doi.org/10.1142/S0217751X89001497"}> doi:10.1142/S0217751X89001497
                \&amp;rbrack;
              %p
                reprinted in:
                = succeed "," do
                  %em Braid Group, Knot Theory and Statistical Mechanics
                = succeed "," do
                  %strong 9
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/0796"} doi:10.1142/0796
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Larry+A.+Lambe"}> Larry A. Lambe
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/David+E.+Radford"} David E. Radford
                = succeed "," do
                  %em Introduction to the quantum Yang-Baxter equation and quantum groups: an algebraic approach
                = succeed "," do
                  %strong 423
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-1-4615-4109-7"} doi:10.1007/978-1-4615-4109-7
            %li#PerkAu-Yang06
              %p
                Jacques H. H. Perk, Helen Au-Yang:
                = succeed "," do
                  %em Yang-Baxter Equations
                %strong 5
                (2006) 465-473 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math-ph/0606053"}> arXiv:math-ph/0606053
                \&amp;rbrack;
          %p
            Literature collection with focus on application to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integrable+systems"} integrable systems
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michio+Jimbo"} Michio Jimbo
              (ed.):
              = succeed "," do
                %em Yang-Baxter Equation in Integrable Systems
              = succeed "," do
                %strong 10
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/1021"} doi:10.1142/1021
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Yang%E2%80%93Baxter_equation"} Yang-Baxter equation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/eom"}> eom
                ,
                %em
                  %a{:href => "https://encyclopediaofmath.org/index.php?title=Yang-Baxter_equation"} Yang-Baxter equation
