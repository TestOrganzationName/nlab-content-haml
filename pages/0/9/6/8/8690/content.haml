                  %annotation{:encoding => "application/x-tex"} \check R
            %a.existingWikiWord{:href => "/nlab/show/quantum+Yang-Baxter+equation"} quantum Yang-Baxter equation
            %a.maruku-eqref{:href => "#eq:PlainQuantumYBE"} (2)
            is equivalent to
          #eq:PlainQuantumYBInParameterizedForm.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
