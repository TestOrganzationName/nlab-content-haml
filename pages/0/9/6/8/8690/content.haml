            (not necessarily the ambient
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            structure map) — is called the plain
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+Yang-Baxter+equation"} quantum Yang-Baxter equation
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
