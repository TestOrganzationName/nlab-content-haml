                    %mrow
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} Vect
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thinmathspace"}
