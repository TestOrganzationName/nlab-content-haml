            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ,
                  %mi u
                  %mo ′
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} u, u' \in U
            (typically taken from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} U = \mathbb{C}
            the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
          #eq:ParameterizedQuantumYBEquation.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˇ
                    %mn 23
                  %mo{:stretchy => "false"} (
                  %msub
