            %a.existingWikiWord{:href => "/nlab/show/braid+groups"} braid groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Br
                    %mi n
                %annotation{:encoding => "application/x-tex"} Br_n
            (
            %a.existingWikiWord{:href => "/nlab/show/braid+representations"}> braid representations
            ), by representing the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a{:href => "braid+group#ArtinGenerators"} Artin braid generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi i
