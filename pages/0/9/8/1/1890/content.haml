            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+closed+category"} monoidal closed category
