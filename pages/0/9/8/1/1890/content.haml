                %path{:d => "M -4.143787 4.782781 C -3.387588 1.912173 -1.698211 0.557659 -0.000996935 -0.00142189 C -1.698155 -0.556735 -3.387397 -1.911417 -4.143308 -4.782101 ", :style => "fill:none;stroke-width:0.79701;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.0000496006,0.991992,0.991992,0.0000496006,288.15766,60.282239)"}
