          %p The diagrams above assure us that
          %ul
            %li
              This map gives indeed a
              = succeed "-algebra;" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1,A]
              are canonically isomorphic as
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %li
              The internal precomposition with a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi W
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f:W\to X
              gives a morphism of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi W
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,A]\to [W,A]
