                        %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed "&rbrack;" do
                %a{:href => "http://archive.numdam.org/item/BSMF_1963__91__227_0"} numdam:BSMF_1963__91__227_0
          %p
            Direct proof for the
            %a{:href => "UH#CompactOpenTopology"} compact-open topology
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/U%28%E2%84%8B%29"} U(ℋ)
          %ul
            %li#AtiyahSegal04
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
              = succeed "," do
                %em Twisted K-theory
              = succeed "," do
                %strong 1
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/math/0407054"} arXiv:math/0407054
              = succeed "," do
                %a{:href => "http://iamm.su/en/journals/j879/?VID=10"} journal page
              = succeed "&rbrack;" do
                %a{:href => "http://iamm.su/upload/iblock/45e/t1-n3-287-330.pdf"} published pdf
          %p
            Proof that the
            %a{:href => "UH#CompactOpenTopology"} compact-open topology
            agrees with the
            %a{:href => "UH#StrongOperatorTopolgy"} strong operator topology
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/U%28%E2%84%8B%29"} U(ℋ)
          %ul
            %li#Schottenloher
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Schottenloher"}> Martin Schottenloher
                ,
                %em The Unitary Group In Its Strong Topology
                (
                %a{:href => "https://arxiv.org/abs/1309.5891"}> arXiv:1309.5891
                ), Advances in Pure Mathematics
                %strong 08
                05 (2018) (
                %a{:href => "https://www.scirp.org/html/4-5301487_84967.htm"}> doi:10.4236/apm.2018.85029
                )
            %li#EspinozaUribe
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jesus+Espinoza"}> Jesus Espinoza
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bernardo+Uribe"} Bernardo Uribe
                = succeed "," do
                  %em Topological properties of the unitary group
                %strong 16
                (2014) Issue 1, pp 45-55 (
                %a{:href => "https://arxiv.org/abs/1407.1869"}> arXiv:1407.1869
                ,
                = succeed ")" do
                  %a{:href => "http://www.pphmj.com/abstract/8730.htm"} journal
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Kuiper%27s_theorem"} Kuiper’s theorem
          %p
            Generalization from
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+modules"} Hilbert modules
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joachim+Cuntz"}> Joachim Cuntz
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Higson"} Nigel Higson
              = succeed "," do
                %em Kuiper’s Theorem for Hilbert Modules
              %em Operator Algebras and Mathematical Physic
              Contemporary Mathematics
              = succeed "," do
                %strong 62
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/CONM/62"} ISBN:978-0-8218-7652-7
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/CuntzHigson-KuiperForHilbertModules.pdf", :title => "pdf"} pdf
          %p
            which implies notably the
