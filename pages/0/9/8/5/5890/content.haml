          %p
            Proof for the
            %a{:href => "UH#StrongOperatorTopology"} strong operator topology
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/U%28%E2%84%8B%29"} U(ℋ)
          %ul
            %li#DixmierDOuady63
              %a.existingWikiWord{:href => "/nlab/show/Jacques+Dixmier"}> Jacques Dixmier
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adrien+Douady"} Adrien Douady
              = succeed "," do
                %em
                  Champs continus d’espaces hilbertiens et de
                  = succeed "-alg\u00E8bres" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
