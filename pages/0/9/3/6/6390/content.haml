          %h2#history History
          %p
            That some
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            %a.existingWikiWord{:href => "/nlab/show/spinor"} spin
            was found in 1922 in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stern-Gerlach+experiment"} Stern-Gerlach experiment
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fermion"}> fermion
                ,
                %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sigma+model"}> sigma model
                ,
                %a.existingWikiWord{:href => "/nlab/show/brane"} brane
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/relativistic+particle"}> relativistic particle
                    ,
                    = succeed "," do
                      %strong spinning particle
                    %a.existingWikiWord{:href => "/nlab/show/superparticle"} superparticle
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/A-hat+genus"}> A-hat genus
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/%281%2C1%29-dimensional+Euclidean+field+theories+and+K-theory"} (1,1)-dimensional Euclidean field theories and K-theory
                %li
