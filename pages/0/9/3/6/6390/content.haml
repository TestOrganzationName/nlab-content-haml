                  [
                  %a{:href => "https://arxiv.org/abs/1406.6318"}> arXiv:1406.6318
                  ,
                  = succeed "]" do
                    %a{:href => "https://inspirehep.net/literature/1302860"} spire:1302860
              %li
                %p
                  Viola Gattus, Apostolos Pilaftsis,
                  = succeed "," do
                    %em Supergeometric Approach to Quantum Field Theory
                  %strong 463
                  (2024) 156 [
                  %a{:href => "https://doi.org/10.22323/1.463.0156"}> doi:10.22323/1.463.0156
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/2404.13107"} arXiv:2404.13107
              %li
                %p
