                  (ed.):
                  = succeed "," do
                    %em Introduction to Superanalysis
                  = succeed "," do
                    %strong 9
                  = succeed "&rbrack;" do
                    %a{:href => "https://doi.org/10.1007/978-94-017-1963-6"} doi:10.1007/978-94-017-1963-6
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schmitt"}> Thomas Schmitt
                  \:
                  %em The Cauchy Problem for Classical Field Equations with Ghost and Fermion Fields
                  [
                  %a{:href => "https://arxiv.org/abs/hep-th/9607133"}> arXiv:hep-th/9607133
                  ]
              %li#Schmitt97
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schmitt"}> Thomas Schmitt
                  \:
                  = succeed "," do
                    %em Supergeometry and Quantum Field Theory, or: What is a Classical Configuration?
                  %strong 9
                  (1997) 993-1052 [
                  %a{:href => "https://doi.org/10.1142/S0129055X97000348"}> doi:10.1142/S0129055X97000348
                  ,
                  = succeed "]." do
                    %a{:href => "https://arxiv.org/abs/hep-th/9607132"} arXiv:hep-th/9607132
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schmitt"}> Thomas Schmitt
                  \:
                  = succeed "," do
                    %em Supermanifolds of classical solutions for Lagrangian field models with ghost and fermion fields
                  = succeed "," do
                    %a{:href => "https://arxiv.org/abs/hep-th/9707104"} hep-th/9707104
                  = succeed "]" do
                    %a{:href => "https://inspirehep.net/literature/445574"} inspire:445574
              %li#Freed99
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                  ,
                  = succeed "," do
                    %em What are fermions?
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Five+lectures+on+supersymmetry"} Five lectures on supersymmetry
                  = succeed "," do
                    %a{:href => "https://bookstore.ams.org/FLS"} ISBN:978-0-8218-1953-1
                  = succeed "]" do
                    %a{:href => "https://inspirehep.net/literature/517862"} spire:517862
              %li#GiachettaMangiarottiSardanashvily09
                %p
                  Giovanni Giachetta, Luigi Mangiarotti,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Gennadi+Sardanashvily"} Gennadi Sardanashvily
                  = succeed "," do
                    %em Advanced classical field theory
                  = succeed "]" do
                    %a{:href => "https://doi.org/10.1142/7189"} doi:10.1142/7189
              %li#Sardanashvily12
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Gennadi+Sardanashvily"}> Gennadi Sardanashvily
                  ,
                  = succeed "," do
                    %em Grassmann-graded Lagrangian theory of even and odd variables
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/1206.2508"} arXiv:1206.2508
              %li
                %p
