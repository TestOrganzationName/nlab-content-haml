                  [
                  %a{:href => "https://arxiv.org/abs/2406.13594"}> arXiv:2406.13594
                  ]
            %p
              and more generally via
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+super+sets"} smooth super sets
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                \: §3.1 in:
                = succeed "," do
                  %a.existingWikiWord{:href => "/schreiber/show/Higher+Prequantum+Geometry"} Higher Prequantum Geometry
                = succeed "," do
                  %em
