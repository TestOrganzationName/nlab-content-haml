                  %a{:href => "https://www.ma.utexas.edu/users/dafr/pcmi.pdf"}> pdf
                  ,
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/Freed-ClassicalFieldTheoryAndSuSy.pdf", :title => "pdf"} pdf
            %p
              and specifically in the context of
              %a.existingWikiWord{:href => "/nlab/show/superstring"} super-
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
              (regarding
              %a.existingWikiWord{:href => "/nlab/show/worldsheets"} worldsheets
