                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo *
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mo *
                          %mi F
                        %annotation{:encoding => "application/x-tex"} \alpha: F \ast (F \ast F) \to (F \ast F) \ast F
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  is the involution
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi σ
                          %mn 2
                        %mo :
                        %mi F
                        %mo ″
                        %mo ⊗
                        %msup
                          %mi F
                          %mrow
                            %mo ⊗
                            %mn 2
                        %mo →
                        %mi F
                        %mo ″
                        %mo ⊗
                        %msup
                          %mi F
                          %mrow
                            %mo ⊗
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_1 \otimes \sigma_2: F'' \otimes F^{\otimes 2} \to F'' \otimes F^{\otimes 2}
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo :
                        %mi F
                        %mo ″
                        %mo →
                        %mi F
                        %mo ″
                      %annotation{:encoding => "application/x-tex"} \sigma: F'' \to F''
                  is the natural involution on the second derivative
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ″
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo +
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo *
                        %mo :
                        %msup
                          %mi V
                          %mi FB
                        %mo →
                        %msup
                          %mi V
                          %mi FB
                      %annotation{:encoding => "application/x-tex"} (-)'' = (- + 2)*: V^{FB} \to V^{FB}
                %p
                  induced by the nonidentity involution
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mo →
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} 2 \to 2
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_2
                  is the symmetry isomorphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi F
                            %mrow
                              %mo ⊗
                              %mn 2
                          %mo →
                          %msup
                            %mi F
                            %mrow
                              %mo ⊗
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} F^{\otimes 2} \to F^{\otimes 2}
          %p Of course the notion can be reformulated perfectly well in a general symmetric monoidal category; the use of coproducts just makes for a more efficient packaging.
          %h3#graft_product_of_nonpermutative_species Graft product of (non-permutative) species
          %p
            A non-permutative species in a
            %a.existingWikiWord{:href => "/nlab/show/monoidally+cocomplete+category"} monoidally cocomplete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is simply an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded object
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \to V
            from the monoidal groupoid of finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
            %a.existingWikiWord{:href => "/nlab/show/ordinal+sum"} ordinal sum
            to the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            groupoid. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a finite linear order and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                  %mo ⊆
                  %mi S
                %annotation{:encoding => "application/x-tex"} T = [a, b] \subseteq S
            is a
            %span.newWikiWord
              subinterval
              %a{:href => "/nlab/new/subinterval"} ?
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mi T
                %annotation{:encoding => "application/x-tex"} S/T
            via a pushout construction in the category of finite linear orders, and define a corresponding graft product by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo *
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi subintervals
                      %mi T
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mi T
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi G
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} (F \ast G)[S] = \sum_{subintervals T} F[S/T] \otimes G[T].
          %p
            This graft product shares certain formal properties with the permutative graft product defined above, such as the fact that it is a lax monoidal product. A triple graft product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo *
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo *
                  %mi H
                %annotation{:encoding => "application/x-tex"} (F \ast G) \ast H
            cab be decomposed as a coproduct of parts, the first being
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo *
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo *
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi subintervals
                      %msub
                        %mi T
                        %mn 1
                      %mo ⊆
                      %msub
                        %mi T
                        %mn 2
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi G
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi H
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F \ast (G \ast H)[S] = \sum_{subintervals T_1 \subseteq T_2} F[S/T_2] \otimes G[T_2/T_1] \otimes H[T_1]
          %p and the second being
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi subint
                      %mo .
                      %msub
                        %mi T
                        %mn 1
                      %mo ,
                      %msub
                        %mi T
                        %mn 2
                      %mo :
                      %msub
                        %mi T
                        %mn 1
                      %mo ∩
                      %msub
                        %mi T
                        %mn 2
                      %mo =
                      %mi ∅
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo ,
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi G
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi H
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \sum_{subint. T_1, T_2: T_1 \cap T_2 = \emptyset} F[S/(T_1, T_2)] \otimes G[T_1] \otimes H[T_2]
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo ,
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S/(T_1, T_2)
            denotes the pushout of the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo +
                  %msub
                    %mi T
                    %mn 2
                  %mo ↪
                  %mi S
                %annotation{:encoding => "application/x-tex"} T_1 + T_2 \hookrightarrow S
            along the quotient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo !
                    %mo :
                    %msub
                      %mi T
                      %mn 1
                    %mo +
                    %msub
                      %mi T
                      %mn 2
                    %mo →
                    %mn 1
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} ! + !: T_1 + T_2 \to 1 + 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
          %p To be continued…
