                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
            %li
              %p
                An element of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} [
                        %mi σ
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} F[\sigma]
            %li
              %p
                An element of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} [
                        %mi τ
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} G[\tau]
          %h3#lax_monoidal_structure_of_graft_product Lax monoidal structure of graft product
          %p
            The graft poduct is not associative up to isomorphism, but there is a lax associativity. Specifically, we calculate (using a categorified
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo *
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo *
                          %mi H
                        %mtd
                          %mo ≅
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo ′
                          %mo ⊗
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo ′
                          %mo ⊗
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %mi F
                          %mo ″
                          %mo ⊗
                          %mi G
                          %mo ⊗
                          %mi H
                          %mo +
                          %mi F
                          %mo ′
                          %mo ⊗
                          %mi G
                          %mo ′
                          %mo ⊗
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %mi F
                          %mo ″
                          %mo ⊗
                          %mi G
                          %mo ⊗
                          %mi H
                          %mo +
                          %mi F
                          %mo *
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo *
                          %mi H
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (F \ast G) \ast H &amp; \cong &amp; (F' \otimes G)' \otimes H \\
                  \&amp; \cong &amp; F'' \otimes G \otimes H + F' \otimes G' \otimes H \\
                  \&amp; \cong &amp; F'' \otimes G \otimes H + F \ast (G \ast H)
                  }
          %p so that there is a noninvertible associativity (an inclusion)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mi F
                      %mi G
                      %mi H
                  %mo :
                  %mi F
                  %mo *
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo *
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo *
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo *
                  %mi H
                %annotation{:encoding => "application/x-tex"} \alpha_{F G H}: F \ast (G \ast H) \to (F \ast G) \ast H
          %p
            which is natural in each of its arguments
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X[S]
            is the monoidal unit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi card
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} card(S) = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X[S]
            is initial, for which we have evident natural maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi F
                  %mo :
                  %mi X
                  %mo *
                  %mi F
                  %mo →
                  %mi F
                  %mo ,
                  %mspace{:width => "2em"}
                  %msub
                    %mi ρ
                    %mi F
                  %mo :
                  %mi F
                  %mo *
                  %mi X
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} \lambda_F: X \ast F \to F, \qquad \rho_F: F \ast X \to F
          %p
            The first map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi F
                %annotation{:encoding => "application/x-tex"} \lambda_F
            is invertible, but the second is not: its component at a finite set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the codiagonal
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo :
                  %mi S
                  %mo ⋅
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \nabla: S \cdot F[S] \to F[S]
          %p
            However, the standard unit coherence conditions for monoidal categories hold. We may call such a structure, relaxing the condition of invertibility of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            but retaining the usual naturality and coherence conditions, a
            = succeed "." do
              %strong lax monoidal category
          %p
            In the sequel,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mo *
                      %mi n
                %annotation{:encoding => "application/x-tex"} F^{\ast n}
            will denote the iterated graft product defined recursively by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mo *
                      %mn 0
                  %mo =
                  %mi X
                  %mo ,
                  %mspace{:width => "2em"}
                  %msup
                    %mi F
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi F
                    %mrow
                      %mo *
                      %mi n
                  %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} F^{\ast 0} = X, \qquad F^{\ast (n+1)} = F^{\ast n} \ast F
          %p
            so that all parentheses in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mo *
                      %mi n
                %annotation{:encoding => "application/x-tex"} F^{\ast n}
            are to the left. We state without proof the following partial coherence theorem:
          .num_prop
            %h6#proposition Proposition
            %p Any two maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mo *
                        %mi m
                    %mo *
                    %msup
                      %mi F
                      %mrow
                        %mo *
                        %mi n
                    %mo →
                    %msup
                      %mi F
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo +
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{\ast m} \ast F^{\ast n} \to F^{\ast (m+n)}
            %p
              definable in the language of lax monoidal categories are equal. We denote this map by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mrow
                          %mi m
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \alpha_{m n}
          %h3#permutative_nonunital_operads Permutative non-unital operads
          .num_defn
            %h6#definition Definition
            %p
              A (permutative)
              %em non-unital operad
              in a
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              %a.existingWikiWord{:href => "/nlab/show/species"} species
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi FB
                      %mi op
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} F: FB^{op} \to V
              equipped with a multiplication
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo :
                      %mi F
                      %mo *
                      %mi F
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} m: F \ast F \to F
            %ol
              %li
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi F
                                %mo *
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo *
                                %mi F
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mn 1
                                    %mo *
                                    %mi m
                              %mtd
                                %mi F
                                %mo *
                                %mi F
                              %mtd
                            %mtr
                              %mtd
                                %mi α
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                              %mtd
                                %mo ↘
                                %mi m
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo *
                                %mi F
                                %mo{:stretchy => "false"} )
                                %mo *
                                %mi F
                              %mtd
                                %munder
                                  %mo →
                                  %mrow
                                    %mi m
                                    %mo *
                                    %mn 1
                                %mi F
                                %mo *
                                %mi F
                              %mtd
                                %munder
                                  %mo →
                                  %mi m
                              %mtd
                                %mi F
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        F \ast (F \ast F) &amp; \stackrel{1 \ast m}{\to} &amp; F \ast F &amp; \\
                        \\alpha \downarrow &amp; &amp; &amp; \searrow m \\
                        (F \ast F) \ast F &amp; \underset{m \ast 1}{\to} F \ast F &amp; \underset{m}{\to} &amp; F
                        }
                %p commutes;
              %li
                %p
                  The two composites
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ″
                        %mo ⊗
                        %msup
                          %mi F
                          %mrow
                            %mo ⊗
                            %mn 2
                        %mo →
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F'' \otimes F^{\otimes 2} \to F
                  named in
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ″
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo ⊗
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mover
                          %munder
                            %mo →
                            %mn 1
                          %mover
                            %mo →
                            %mi σ
                        %mi F
                        %mo ″
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo ⊗
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo *
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mo *
                        %mi F
                        %mover
                          %mo →
                          %mrow
                            %mi m
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo *
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F'' \otimes (F \otimes F) \stackrel{\overset{\sigma}{\to}}{\underset{1}{\to}} F'' \otimes (F \otimes F) \stackrel{i}{\to} (F \ast F) \ast F \stackrel{m(m \ast 1)}{\to} F
                %p
                  commute. Here
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  denotes the inclusion complementary to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo :
                          %mi F
                          %mo *
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo *
                          %mi F
