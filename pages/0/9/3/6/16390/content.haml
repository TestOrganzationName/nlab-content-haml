                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V = Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo *
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \ast G
            is given by three data:
          %ul
            %li
              %p
                A tree obtained by grafting the root of a sprout (aka corolla) with leaf set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
