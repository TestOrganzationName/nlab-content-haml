          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              be two
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is an
              %strong orthogonal factorization system
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              in which solutions to
              %a.existingWikiWord{:href => "/nlab/show/lifting+problems"} lifting problems
              are unique.
          %p We spell out several equivalent explicit formulation of what this means.
          #EquivalentDefinitions.num_defn
            %h6#definition_3 Definition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is an
              %strong orthogonal factorization system
              if every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              factors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi r
                    %mo ∘
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} f = r\circ \ell
              as a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \ell \in E
              followed by a morphism
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} r \in M
            %ol
              %li
                %p We have:
                %p
                  a.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is precisely the class of morphisms that are left
                  %a.existingWikiWord{:href => "/nlab/show/orthogonality"} orthogonal
                  to every morphism in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
                %p
                  b.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  is precisely the class of morphisms that are right
                  %a.existingWikiWord{:href => "/nlab/show/orthogonality"} orthogonal
                  to every morphism in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p We have:
                %p
                  a. The factorization is unique up to unique
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %p
                  b.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  both contain all
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  and are closed under composition.
              %li
                %p We have:
                %p
                  a.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  are
                  %a.existingWikiWord{:href => "/nlab/show/replete+subcategories"} replete subcategories
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mi I
                        %annotation{:encoding => "application/x-tex"} C^I
                %p
                  b. Every morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is left
                  %a.existingWikiWord{:href => "/nlab/show/orthogonality"} orthogonal
                  to every morphism in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
          %p
            OFS’s are traditionally called just
            = succeed "." do
              %strong factorization systems
            %em
              %a.existingWikiWord{:href => "/joyalscatlab/published/Factorization+systems"} Catlab
            for more of the theory.
          %p
            An orthogonal factorization system is called
            %strong proper
            if every morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            and every morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %h3#prefactorization_systems Prefactorization systems
          %p
            For any class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            of morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} E^\perp
            for the class of all morphisms that are right orthogonal to every morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mo ⊥
                  %mi M
                %annotation{:encoding => "application/x-tex"} {}^\perp M
            for the class of all morphisms that are left orthogonal to every morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %msup
                    %mrow
                    %mo ⊥
                  %mi M
                %annotation{:encoding => "application/x-tex"} E= {}^\perp M
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %msup
                      %mi E
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} M= E^\perp
          %p
            In general,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} (-)^\perp
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mo ⊥
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {}^\perp(-)
            form a
            %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            on the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of classes of morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %msup
                    %mrow
                    %mo ⊥
                  %mi M
                %annotation{:encoding => "application/x-tex"} E= {}^\perp M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %msup
                    %mi E
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} M= E^\perp
            is sometimes called a
            = succeed "." do
              %strong prefactorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of maps we have prefactorization systems
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mrow
                    %mo ⊥
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi A
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ({}^\perp(A^\perp),A^\perp)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mrow
                      %mo ⊥
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mrow
                      %mo ⊥
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ({}^\perp A, ({}^\perp A)^\perp)
            %em generated
            and
            %em cogenerated
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#Properties Properties
          %h3#general General
          .num_prop
            %h6#proposition Proposition
            %p
              The different characterization in def.
              %a.maruku-ref{:href => "#EquivalentDefinitions"}
              are indeed all equivalent.
          .proof
            %h6#proof Proof
            %p (…)
            %p
              For the moment see (
              %a{:href => "#Joyal"}> Joyal
              ).
            %p (…)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is an orthogonal factorization system precisely if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊥
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L \perp R
          .proof
            %h6#proof_2 Proof
            %p (…)
            %p
              For the moment see (
              %a{:href => "#Joyal"}> Joyal
              ).
            %p (…)
          #IsomorphismsAreIntersection.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              an orthogonal factorization system in a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∩
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \cap R
              is precisely the class of
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_3 Proof
            %p
              If is clear that every isomorphism is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∩
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L \cap R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              be a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∩
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L \cap R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi id
                          %mi A
                    %mi A
                    %mover
                      %mo →
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    f = A \stackrel{id_A}{\to} A \stackrel{f}{\to} B
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi A
                    %mover
                      %mo →
                      %mi f
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi id
                          %mi B
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    f = A \stackrel{f}{\to} B \stackrel{id_B}{\to} B
            %p
              are both
              = succeed "-factorization." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              in the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mi A
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                            %msub
                              %mo ↗
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mi B
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{id_A}{\to}&amp; A
                    \\\
                    \\downarrow^{\mathrlap{f}}
                    \&amp;\nearrow_{\bar f}&amp;
                    \\downarrow^{\mathrlap{f}}
                    \\\
                    B &amp;\stackrel{id_B}{\to}&amp; B
                    }
                    \\,.
            %p
              This says precisely that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar f
              is a left and right
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h3#closure_properties Closure properties
          %p
            A prefactorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            (and hence, also, a factorization system) satisfies the following closure properties. We state them for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            of course satisfies the dual property.
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              contains the isomorphisms and is closed under composition and
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (insofar as pullbacks exist in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              If a composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f g
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is either in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              or a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is closed under all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Arr
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Arr(C)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
            %em small set
            of maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mrow
                    %mo ⊥
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi A
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ({}^\perp(A^\perp),A^\perp)
            is actually a factorization system. The argument is by a transfinite construction similar to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
          %p
            On the other hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            is any prefactorization system for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            consists of monomorphisms and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} well-powered
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            is actually a factorization system. (Of course, there is a dual statement as well.) In fact something slightly more general is true; see
            %a.existingWikiWord{:href => "/nlab/show/M-complete+category"} M-complete category
            for this and other related ways to construct factorization systems.
          %h3#CancellationProperties Cancellation properties
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              an orthogonal factorization system. Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi g
                                %mo ∘
                                %mi f
                          %mtd
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp; {}^{\mathllap{f}}\nearrow &amp;&amp; \searrow^{\mathrlap{g}}
                    \\\
                    X
                    \&amp;&amp;
                    \\stackrel{g \circ f}{\to}
                    \&amp;&amp;
                    Z
                    }
            %p be two composable morphisms. Then
            %ul
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∘
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g \circ f
                  are in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                        %annotation{:encoding => "application/x-tex"} g
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∘
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g\circ f
                  are in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
          .proof
