          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %strong mapping cylinder
            as a
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi σ
                                  %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi σ
                                  %mn 0
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi I
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi σ
                                %mn 0
                              %msub
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi Cyl
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{f}\to&amp; Y
                  \\\
                  {}^{\mathllap{\sigma_0}}\downarrow &amp;&amp; \downarrow^{\mathrlap{ f_*(\sigma_0)}}
                  \\\
                  X\times I &amp;\stackrel{(\sigma_0)_* (f)}\to &amp; Cyl(f)
                  }
          %p
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0,1]
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mo ×
                  %mi I
                %annotation{:encoding => "application/x-tex"} \sigma_0:X\to X\times I
            is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\mapsto (x,0)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theorists
            sometimes use the inverted (upside-down) mapping cylinder where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \sigma_0
            is replaced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo :
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_1:x\mapsto (x,1)
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            so it is a matter of convention which one to use, of course, compatibly with other constructions depending on the
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            Set-theoretically, the mapping cylinder is usually represented as the
            %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi I
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} (X\times I \coprod Y)/{\sim}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            is the smallest
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            identifying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,0)\sim f(x)
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
          %h3#properties Properties
          %p
            As any other pushout, the mapping cylinder has a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            and mapping
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo :
                    %mi X
                    %mo ×
                    %mi I
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g_1:X\times I\to Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 2
                  %mo :
                  %mi Y
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} g_2:Y\to Z
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_1(x,0)=g_2(f(x))
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} k:Cyl(f)\to Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi I
                  %mo →
                  %mi Cyl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi k
                  %mi Z
                %annotation{:encoding => "application/x-tex"} X\times I\to Cyl(f)\stackrel{k}\to Z
            equals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 1
                %annotation{:encoding => "application/x-tex"} g_1
            and the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mi Cyl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi k
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Y\to Cyl(f)\stackrel{k}\to Z
            equals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_2
          #FactorizationOfMapThroughMappingCylinderFollowedByDeformationRetraction.num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≔
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \coloneqq f_*(\sigma_0) \colon Y\to Cyl(f)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/deformation+retraction"} deformation retraction
          .proof
            %h6#proof Proof
            %p
              We exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              as a homotopy equivalence by constructing its homotopy inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{f}
              given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}:[x,t]\mapsto f(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x,t]
              is a class of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} (x,t)\in X\times I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \tilde{f}([y])=[y]
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y\in Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo ∘
                      %mi j
                      %mo =
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \tilde{f}\circ j = \id_Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo ∘
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} (j\circ\tilde{f})[x,t] = [f(x)]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo :
                    %mi{:mathvariant => "normal"} Cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi I
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} H:\mathrm{Cyl}(f)\times I\to Y
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H([x,t],\tau) = [x,t(1-\tau)], \,\,\,H([y],\tau)=[y].
            %p
              It is easy to see that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mrow
                          %mi Cyl
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(-,0) = \id_{Cyl(f)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} H(-,1)=[-,0]=[f(-)]
              hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∘
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo ∼
                      %msub
                        %mi id
                        %mrow
                          %mi Cyl
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j\circ\tilde{f}\sim id_{Cyl(f)}
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              A continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i:A\to X
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+cofibration"} Hurewicz cofibration
              iff there is a
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi X
                    %mo ×
                    %mi I
                    %mo →
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r:X\times I\to Cyl(f)
              for the canonical map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi I
                      %mo →
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X\times I \to Cyl(f)
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              A continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
