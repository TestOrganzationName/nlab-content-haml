                      %mn 1
                      %mi B
                  %annotation{:encoding => "application/x-tex"} f t = 1_B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi g
                  %mo →
                  %mi e
                %annotation{:encoding => "application/x-tex"} (f,e)\colon g \to e
            has a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            in the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#related_concepts Related concepts
          %h3#AsCoequalizers As coequalizers and absolute coequalizers
          %p
            The name “split coequalizer” is appropriate, because in any split coequalizer diagram, the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is necessarily a
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} h\colon B\to D
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi f
                    %mo =
                    %mi h
                    %mi g
                  %annotation{:encoding => "application/x-tex"} h f = h g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mi s
                %annotation{:encoding => "application/x-tex"} h s
            provides a factorization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi s
                    %mi e
                    %mo =
                    %mi h
                    %mi g
                    %mi t
                    %mo =
                    %mi h
                    %mi f
                    %mi t
                    %mo =
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h s e = h g t = h f t = h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is (split)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epic
          %p
            In fact, a split coequalizer is not just a coequalizer but an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/absolute+coequalizer"} absolute coequalizer
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi e
                %annotation{:encoding => "application/x-tex"} F e
            is a coequalizer of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi f
                %annotation{:encoding => "application/x-tex"} F f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi g
                %annotation{:encoding => "application/x-tex"} F g
            for any functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %em because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            also preserves the splitting morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %h3#contractible_pairs Contractible pairs
          %p
            On the other hand, suppose we are given only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f,g\colon A\to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} t\colon B\to A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi t
                  %mo =
                  %msub
                    %mn 1
                    %mi B
                %annotation{:encoding => "application/x-tex"} f t = 1_B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi t
                  %mi f
                  %mo =
                  %mi g
                  %mi t
                  %mi g
                %annotation{:encoding => "application/x-tex"} g t f = g t g
            (which is certainly the case in any split coequalizer, since
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi t
                    %mi f
                    %mo =
                    %mi s
                    %mi e
                    %mi f
                    %mo =
                    %mi s
                    %mi e
                    %mi g
                    %mo =
                    %mi g
                    %mi t
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g t f = s e f = s e g = g t g
            = succeed "." do
              %strong contractible pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is split, for if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} e\colon B\to C
            is a coequalizer of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi t
                  %mi f
                  %mo =
                  %mi g
                  %mi t
                  %mi g
                %annotation{:encoding => "application/x-tex"} g t f = g t g
            implies, by the universal property of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} s\colon C\to B
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mi e
                    %mo =
                    %mi g
                    %mi t
                  %annotation{:encoding => "application/x-tex"} s e = g t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mi s
                  %mi e
                  %mo =
                  %mi e
                  %mi g
                  %mi t
                  %mo =
                  %mi e
                  %mi f
                  %mi t
                  %mo =
                  %mi e
                %annotation{:encoding => "application/x-tex"} e s e = e g t = e f t = e
            and so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mi s
                  %mo =
                  %msub
                    %mn 1
                    %mi C
                %annotation{:encoding => "application/x-tex"} e s = 1_C
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is epic.
          %p
            Similarly, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} e\colon B\to C
            %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splits
            the
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi t
                %annotation{:encoding => "application/x-tex"} g t
            with section
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} s\colon C\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mi s
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} e s = 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mi e
                    %mo =
                    %mi g
                    %mi t
                  %annotation{:encoding => "application/x-tex"} s e = g t
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mi g
                  %mo =
                  %mi e
                  %mi s
                  %mi e
                  %mi g
                  %mo =
                  %mi e
                  %mi g
                  %mi t
                  %mi g
                  %mo =
                  %mi e
                  %mi g
                  %mi t
                  %mi f
                  %mo =
                  %mi e
                  %mi s
                  %mi e
                  %mi f
                  %mo =
                  %mi e
                  %mi f
                %annotation{:encoding => "application/x-tex"} e g = e s e g = e g t g = e g t f = e s e f = e f
          %p
            and the other identities are obvious; thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is a split coequalizer of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %h3#split_epimorphisms Split epimorphisms
          %p
            Dually, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} e\colon B\to C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} s\colon C\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is a split coequalizer of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo ⇉
                      %mn 1
                      %mrow
                        %mi s
                        %mi e
                    %mspace{:width => "thickmathspace"}
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \;\underoverset{1}{s e}{\rightrightarrows}\; B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            being the identity.
          %p
            Moreover,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is also the split coequalizer of its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %munderover
                    %mo ⇉
                    %mi f
                    %mi g
                  %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \;\underoverset{f}{g}{\rightrightarrows}\; B
            is this kernel pair, then the two maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mi e
                  %mo ,
                  %msub
                    %mn 1
                    %mi B
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} s e, 1_B \colon B\to B
            satisfy
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∘
                    %mi s
                    %mi e
                    %mo =
                    %mi e
                    %mo ∘
                    %msub
                      %mn 1
                      %mi B
                  %annotation{:encoding => "application/x-tex"} e \circ s e = e \circ 1_B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} t\colon B\to A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi t
                  %mo =
                  %msub
                    %mn 1
                    %mi B
                %annotation{:encoding => "application/x-tex"} f t = 1_B
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi t
                    %mo =
                    %mi s
                    %mi e
                  %annotation{:encoding => "application/x-tex"} g t = s e
          %h2#examples Examples
          %h3#BeckCoequalizerForAlgebrasOverAMonad Beck coequalizer for algebras over a monad
          %p
            The “ur-example” of a split coequalizer is the following. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} algebra
            for the
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on the category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a\colon T A \to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mn 2
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %munderover
                    %mo ⇉
                    %mrow
                      %mi T
                      %mi a
                    %mrow
                      %msub
                        %mi μ
                        %mi A
                  %mspace{:width => "thickmathspace"}
                  %mi T
                  %mi A
                  %mover
                    %mo →
                    %mi a
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"} T^2 A \;\underoverset{T a}{\mu_A}{\rightrightarrows}\; T A \overset{a}{\rightarrow} A\, ,
          %p
            called the
            %a.existingWikiWord{:href => "/nlab/show/canonical+presentation"} canonical presentation
            of the algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (and a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
            in the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} category of
            = succeed "-algebras)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %msub
                    %mi η
                    %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi T
                  %mi A
                %annotation{:encoding => "application/x-tex"} s = \eta_A \colon A \to T A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %msub
                      %mi η
                      %mrow
