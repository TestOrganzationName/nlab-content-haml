              %blockquote
                %p
                  (via
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Haag-Kastler+axioms"} Haag-Kastler axioms
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Garth+Warner"}> Garth Warner
                \:
                = succeed "," do
                  %em Quantum Gauge Theory
                = succeed "," do
                  %a{:href => "https://sites.math.washington.edu//~warner/QGTSeminar_Warner.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Warner-QuantumGaugeTheory.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/gauge+theory"}> gauge theory
                  )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Zee"}> Anthony Zee
                \:
                %em Quantum Field Theory in a Nutshell
                2nd ed., Princeton University Press (2010) &amp;lbrack;
                %a{:href => "https://press.princeton.edu/books/hardcover/9780691140346/quantum-field-theory-in-a-nutshell?srsltid=AfmBOoovOHTlGiQ8S-JqFUpn26ihzhfNQocoId3eN9SUZ8WYL83oyKG0"}> ISBN:9780691140346
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Schwartz"}> Matthew Schwartz
                ,
                = succeed "," do
                  %em Quantum Field Theory and the Standard Model
                = succeed "," do
                  %a{:href => "https://www.cambridge.org/de/universitypress/subjects/physics/theoretical-physics-and-mathematical-physics/quantum-field-theory-and-standard-model?format=HB&isbn=9781107034730"} ISBN:9781107034730
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781139540940"} doi:10.1017/9781139540940
                = succeed "&rbrack;" do
                  %a{:href => "https://indico.ihep.ac.cn/event/11134/attachments/3783/4308/QFT-Schwartz.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michel+Talagrand"}> Michel Talagrand
                ,
                = succeed "," do
                  %em What is a Quantum Field Theory? – A first Introduction for Mathematicians
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/9781108225144"} doi:10.1017/9781108225144
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pavel+Etingof"}> Pavel Etingof
                \:
                %em Mathematical ideas and notions of quantum field theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2409.03117"}> arXiv:2409.03117
                \&amp;rbrack;
            %li
              %p
                Wolfgang Bietenholz, Uwe-Jens Wiese:
                = succeed "," do
                  %em Uncovering Quantum Field Theory and the Standard Model
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cambridge.org/highereducation/books/uncovering-quantum-field-theory-and-the-standard-model/D68C7687188CBD9111503A348A5E09FA"} ISBN:9781108472333
          %p
            A standard textbook written from the perspective of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
          %ul
            %li#Weinberg95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Weinberg"}> Steven Weinberg
                \:
                = succeed "," do
                  %em The Quantum Theory of Fields Vol 1: Foundations
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9781139644167"} doi:10.1017/CBO9781139644167
            %li#Weinberg96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Weinberg"}> Steven Weinberg
                \:
                = succeed "," do
                  %em The Quantum Theory of Fields Vol 2: Applications
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9781139644174"} doi:10.1017/CBO9781139644174
          %p
            Application in/to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/solid+state+physics"} solid state physics
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Xiao-Gang+Wen"}> Xiao-Gang Wen
                \:
                = succeed "," do
                  %em Quantum Field Theory of Many-Body Systems: From the Origin of Sound to an Origin of Light and Electrons
                = succeed "," do
                  %a{:href => "https://doi.org/10.1093/acprof:oso/9780199227259.001.0001"} doi:10.1093/acprof:oso/9780199227259.001.0001
                = succeed "&rbrack;" do
                  %a{:href => "https://materias.df.uba.ar/cuanticaa2018c2/files/2012/07/wen_quantum_field_theory_of_many-body_systems_from_the_origin_of_sound_to_an_origin_of_light_and_electrons.pdf"} pdf
              %blockquote
                %p
                  (with an eye towards
                  %a.existingWikiWord{:href => "/nlab/show/topological+phases+of+matter"} topological phases of matter
                  and
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+order"} topological order
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+systems"} fractional quantum Hall systems
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+M.+Tsvelik"}> Alexei M. Tsvelik
                \:
                = succeed "," do
                  %em Quantum Field Theory in Condensed Matter Physics
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511615832"} doi:10.1017/CBO9780511615832
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Fradkin"}> Eduardo Fradkin
                ,
                = succeed "," do
                  %em Field Theories of Condensed Matter Physics
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9781139015509"} doi:10.1017/CBO9781139015509
          %p An extensive compilation of material on QFT aiming for mathematical precision is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eberhard+Zeidler"}> Eberhard Zeidler
              ,
              %em Quantum field theory. A bridge between mathematicians and physicists. I: Basics in mathematics and physics.
              (
              %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:1124.81002&format=complete"}> ZMATH entry
              ),
              %em II: Quantum electrodynamics
              (
              %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:1155.81005&format=complete"}> ZMATH entry
              ),
              %em III: Gauge theory
              (
              %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:1228.81005&format=complete"}> ZMATH entry
              ).
          %p
            Survey of the mathematically rigorous discussion in
            %a.existingWikiWord{:href => "/nlab/show/locally+covariant+perturbative+quantum+field+theory"} locally covariant perturbative quantum field theory
            is in
          %ul
            %li#FredenhagenRejzner12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"}> Klaus Fredenhagen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"} Katarzyna Rejzner
                = succeed "," do
                  %em Perturbative algebraic quantum field theory
                = succeed "," do
                  %em Mathematical Aspects of Quantum Field Theories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1208.1428"} arXiv:1208.1428
            %li#FredenhagenRejzner15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"}> Klaus Fredenhagen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"} Katarzyna Rejzner
                %em Perturbative Construction of Models of Algebraic Quantum Field Theory
                (
                %a{:href => "https://arxiv.org/abs/1503.07814"}> arXiv:1503.07814
                )
          %p
            based on the
            %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            of
          %ul
            %li#EpsteinGlaser73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Epstein"} Henri Epstein
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+Glaser"} Vladimir Glaser
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/The+Role+of+locality+in+perturbation+theory"} The Role of locality in perturbation theory
            %li#IlinSlavnov78
              %p
                V. A. Il’in and D. S. Slavnov,
                = succeed "," do
                  %em Observable algebras in the S-matrix approach
            %li#BrunettiFredenhagen00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"}> Romeo Brunetti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"} Klaus Fredenhagen
                = succeed "," do
                  %em Microlocal Analysis and Interacting Quantum Field Theories: Renormalization on Physical Backgrounds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math-ph/9903028"} math-ph/9903028
          %p
            and developed as
            %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            for
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            such as
            %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
            in
          %ul
            %li#Scharf95
              %a.existingWikiWord{:href => "/nlab/show/G%C3%BCnter+Scharf"}> Günter Scharf
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Finite+Quantum+Electrodynamics+--+The+Causal+Approach"} Finite Quantum Electrodynamics – The Causal Approach
          %p
            and for
            %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
            and perturbative
            %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
            in
          %ul
            %li#Scharf01
              %a.existingWikiWord{:href => "/nlab/show/G%C3%BCnter+Scharf"}> Günter Scharf
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantum+Gauge+Theories+--+A+True+Ghost+Story"} Quantum Gauge Theories – A True Ghost Story
          %p
            Discussion of perturbative
            %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
            in this perspective is in
          %ul
            %li#BrunettiFredenhagenRejzner13
              %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"}> Romeo Brunetti
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"} Klaus Fredenhagen
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"} Katarzyna Rejzner
              %em Quantum gravity from the point of view of locally covariant quantum field theory
              (
              %a{:href => "https://arxiv.org/abs/1306.1058"}> arXiv:1306.1058
              )
          %p
            and survey of the generalization to
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            via
            %a.existingWikiWord{:href => "/nlab/show/homotopical+algebraic+quantum+field+theory"} homotopical algebraic quantum field theory
            is in
          %ul
            %li#Schenkel14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"}> Alexander Schenkel
                ,
                = succeed "," do
                  %em On the problem of gauge theories in locally covariant QFT
                %em
                  %a{:href => "http://www.science.unitn.it/~moretti/convegno/convegno.html"} Operator and Geometric Analysis on Quantum Theory
                Trento, 2014 (
                %a.existingWikiWord{:href => "/nlab/files/SchenkelTrento2014.pdf", :title => "pdf"}> pdf
                ) (with further emphasis on this point in the companion talk
                = succeed ")" do
                  %a{:href => "field+bundle#Schreiber14"} Schreiber 14
            %li#Schenkel17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"}> Alexander Schenkel
                ,
                = succeed "," do
                  %em Towards Homotopical Algebraic Quantum Field Theory
                = succeed "," do
                  %em
                    %a{:href => "https://indico.mitp.uni-mainz.de/event/76/overview"} Foundational and Structural Aspects of Gauge Theories
              %p
                Mainz Institute for Theoretical Physics, 29 May – 2 June 2017. (
                %a{:href => "http://aschenkel.eu/Mainz17.pdf"}> pdf
                )
          %p
            A discussion of aspects of QFT with an eye towards applications in
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            and
            %em aimed
            at mathematicians (though requiring more of a physicist’s mindset than many pure mathematicians will find themselves in) is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              , P. Etingof,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"} Dan Freed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantum+Fields+and+Strings"}> Quantum Fields and Strings
                  , A course for mathematicians
              = succeed ")" do
                %a{:href => "http://www.math.ias.edu/qft"} web version
          %p
            Aspects of
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            and
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            (e.g. connections to
            %a.existingWikiWord{:href => "/nlab/show/index+theorems"} index theorems
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
          %ul
            %li
              Charles Nash,
              = succeed "," do
                %em Differential topology and quantum field theory
          %p An indication of the modern foundational picture of quantum mechanics is attempted in
          %ul
            %li#SatiSchreiber11
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
              = succeed "," do
                %strong 83
              = succeed "&rbrack;" do
                %a{:href => "https://bookstore.ams.org/pspum-83"} ams:pspum-83
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Glimm"}> James Glimm
                \:
                = succeed "," do
                  %em The foundations of Quantum Field Theory
                %strong 3
                1 (1969) 101-125 [
