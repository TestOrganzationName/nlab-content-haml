            %li
              %p
                Gerald B. Folland,
                = succeed "," do
                  %em Quantum field theory: A tourist guide for mathematicians
                %strong 149
                (
                %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:1155.81003&format=complete"}> ZMATH
                )
            %li
