                \:
                = succeed "," do
                  %em Quantum Field Theory Seminar (School of Wightman et al.)
                = succeed "," do
                  %a{:href => "https://sites.math.washington.edu//~warner/QFTSeminar_Warner.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Warner-WightmanQFT.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (via
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Wightman+axioms"} Wightman axioms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Garth+Warner"}> Garth Warner
                \:
                = succeed "," do
                  %em Quantum Field Theory Seminar (School of Haag-Kastler et al.)
                = succeed "," do
