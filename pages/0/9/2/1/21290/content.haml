                      %mn 1
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\Vert (\vert \xi\vert^{-2N}\varphi_k)^\vee\Vert_1 = 2^{-k2N}\Vert (\vert \xi\vert^{-2N}\varphi)^\vee\Vert_1;
            %p
              we conclude so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %msub
                        %mi P
                        %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ψ
                        %mi l
                      %mo *
                      %mi f
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi p
                      %mo ≤
                      %mi C
                      %msup
                        %mn 2
                        %mrow
                          %mn 2
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi l
                          %mo −
                          %mi k
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Vert P_k(\psi_l*f)\Vert_p \le C2^{2N(l-k)}\Vert f\Vert_p
              = succeed "-norm" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mrow
                          %mi s
                          %mo ,
                          %mi p
                    %annotation{:encoding => "application/x-tex"} W^{s,p}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi l
                    %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \psi_l*f
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ‖
                            %msub
                              %mi ψ
                              %mi l
                            %mo *
                            %mi f
                            %msubsup
                              %mo{:stretchy => "false"} ‖
                              %mrow
                                %msup
                                  %mi W
                                  %mrow
                                    %mi s
                                    %mo ,
                                    %mi p
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mi n
                                %mo{:stretchy => "false"} )
                              %mi p
                          %mtd
                            %mo ≤
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi k
                                %mo ≤
                                %mi l
                            %msup
                              %mn 2
                              %mrow
                                %mi p
                                %mi k
                                %mi s
                            %mo{:stretchy => "false"} ‖
                            %msub
                              %mi P
                              %mi k
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mi l
                            %mo *
                            %mi f
                            %mo{:stretchy => "false"} )
                            %msubsup
                              %mo{:stretchy => "false"} ‖
                              %mi p
                              %mi p
                            %mo +
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo &gt;
                                %mi l
                            %msup
                              %mn 2
                              %mrow
                                %mi p
                                %mi k
                                %mi s
                            %mo{:stretchy => "false"} ‖
                            %msub
                              %mi P
                              %mi k
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mi l
                            %mo *
                            %mi f
                            %mo{:stretchy => "false"} )
                            %msubsup
                              %mo{:stretchy => "false"} ‖
                              %mi p
                              %mi p
                        %mtr
                          %mtd
                          %mtd
                            %mo ≤
                            %mi C
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi k
                                %mo ≤
                                %mi l
                            %msup
                              %mn 2
                              %mi pks
                            %mo +
                            %msup
                              %mn 2
                              %mrow
                                %mi p
                                %mn 2
                                %mi N
                                %mi l
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo &gt;
                                %mi l
                            %msup
                              %mn 2
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi s
                                %mo −
                                %mn 2
                                %mi N
                                %mo{:stretchy => "false"} )
                                %mi k
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo{:stretchy => "false"} ‖
                            %mi f
                            %msubsup
                              %mo{:stretchy => "false"} ‖
                              %mi p
                              %mi p
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msup
                              %mn 2
                              %mrow
                                %mi p
                                %mi s
                                %mi l
                            %mo{:stretchy => "false"} ‖
                            %mi f
                            %msubsup
                              %mo{:stretchy => "false"} ‖
                              %mi p
                              %mi p
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Vert \psi_l*f\Vert_{W^{s,p}(\mathbb{R}^n)}^p &amp;\le \sum_{0\le k\le l}2^{p k s}\Vert P_k(\psi_l*f)\Vert_p^p + \sum_{k\gt l}2^{p k s}\Vert P_k(\psi_l*f)\Vert_p^p \\
                    \&amp;\le C\Big(\sum_{0\le k \le l}2^{pks} + 2^{p 2 N l}\sum_{k \gt l}2^{p(s-2N)k}\Big)\Vert f\Vert_p^p \\
                    \&amp;= C2^{p s l}\Vert f\Vert_p^p,
                    \\end{aligned}
            %p which concludes the proof.
          %p
            For a fixed direction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\mapsto \operatorname{X} f(x,\sigma)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mo ⋅
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \operatorname{X} f(\cdot,\sigma)
            turns out to be more regular than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\in L^2(\mathbb{R}^n)
              has support
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mi f
                      %mo ⊂
                      %mi K
                    %annotation{:encoding => "application/x-tex"} supp f\subset K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              compact, then
            #eq:eqThmL2Bound.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ‖
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} ⟨
                        %mi D
                        %msup
                          %mo{:stretchy => "false"} ⟩
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi M
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mi C
                      %mi K
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\Vert \vert \langle D\rangle^\frac{1}{2}\operatorname{X} f\right\Vert_{L^2(M_n)} \le C_K\left\Vert f\right\Vert_{L^2(\mathbb{R}^n)}.
          %p
          .num_remark
            %h6 Remark
            %p
              The Japanese bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo ⋅
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle\cdot\rangle
              is defined as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi ξ
                      %mo{:stretchy => "false"} ⟩
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo +
                      %mo{:stretchy => "false"} |
                      %mi ξ
                      %msup
                        %mo{:stretchy => "false"} |
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mfrac
                          %mn 1
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \langle \xi\rangle \coloneqq (1+\vert \xi\vert^2)^\frac{1}{2}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi D
                      %msup
                        %mo{:stretchy => "false"} ⟩
                        %mn 2
                      %mo =
                      %mi I
                      %mo −
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \langle D\rangle^2 = I-\Delta
          .proof
            %h6#proof_3 Proof
            %p
              We set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≔
                      %mo{:stretchy => "false"} ⟨
                      %mi D
                      %msup
                        %mo{:stretchy => "false"} ⟩
                        %mfrac
                          %mn 1
                          %mn 2
                      %mi f
                    %annotation{:encoding => "application/x-tex"} g \coloneqq \langle D\rangle^\frac{1}{2} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msup
                      %mi ℙ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma\in \mathbb{P}^{n-1}
              we compute the Fourier transform of the function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ↦
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in\mathbb{R}^{n-1}\mapsto \operatorname{X}g(x,\sigma)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %msub
                        %mi e
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \sigma = e_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ∫
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dt
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\operatorname{X}g(x,e_n) = \int g(x,t)\,dt.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo ,
                      %msub
                        %mi e
                        %mi n
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\operatorname{X}g(\cdot,e_n))^\wedge(\eta) = \hat{g}(\eta,0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mrow
                        %mo ⊥
                        %mi σ
                    %mo =
                    %msub
                      %mi lim
                      %mrow
                        %mi ε
                        %mo →
                        %mn 0
                    %msup
                      %mi ε
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi ξ
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} ⟨
                        %mi ξ
                        %mo ,
                        %mi σ
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} |
                        %mo ≤
                        %mi ε
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \delta_{\perp\sigma} = \lim_{\varepsilon\to 0}\varepsilon^{-1}1_{\{\xi\mid \vert\langle \xi,\sigma\rangle\vert\le\varepsilon\}}
              is the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+delta+distribution"} Dirac delta distribution
              of the plane normal to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo ⋅
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi L
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %msub
                      %mi δ
                      %mrow
                        %mo ⊥
                        %mi σ
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi ξ
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Vert \operatorname{X}g(\cdot,\sigma)\Vert_{L^2(\mathbb{R}^{n-1})}^2 = \int \vert \hat{g}\vert^2\delta_{\perp\sigma}\,d\xi.
            %p Hence,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo ⋅
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi L
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi M
                          %mi n
                        %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi δ
                      %mrow
                        %mo ⊥
                        %mi σ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dS
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi ξ
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} ⟨
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mfrac
                      %mrow
                        %mi d
                        %mi ξ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Vert \operatorname{X}g(\cdot,\sigma)\Vert_{L^2(M_n)}^2 = \int\vert \hat{g}\vert^2\Big(\int_{S^{n-1}}\delta_{\perp\sigma}(\xi)\,dS(\sigma)\Big)\,d\xi = \int \langle \xi\rangle\vert\hat{f}\vert^2\frac{d\xi}{\vert \xi\vert}.
            %p For high frequencies we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                        %mo ≥
                        %mn 1
                    %mo{:stretchy => "false"} ⟨
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mfrac
                      %mrow
                        %mi d
                        %mi ξ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi C
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                      %mn 2
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\vert\xi\vert\ge 1} \langle \xi\rangle\vert\hat{f}\vert^2\frac{d\xi}{\vert \xi\vert} \le C\Vert f\Vert_2^2.
            %p For low frequencies we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                        %mo ≤
                        %mn 1
                    %mo{:stretchy => "false"} ⟨
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mfrac
                      %mrow
                        %mi d
                        %mi ξ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi C
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                      %mn 2
                    %mo ≤
                    %msub
                      %mi C
                      %mi K
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                      %mn 2
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\vert\xi\vert\le 1} \langle \xi\rangle\vert\hat{f}\vert^2\frac{d\xi}{\vert \xi\vert} \le C\Vert f\Vert_1^2 \le C_K\Vert f\Vert_2^2.
            %p The statement of the Theorem follows.
          %p
            The Sobolev embedding Theorem
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi h
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi L
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi C
                    %mo{:stretchy => "false"} ‖
                    %mi h
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi W
                          %mrow
                            %mi s
                            %mo ,
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Vert h\Vert_{L^\infty(\mathbb{R}^{n-1})}\le C\Vert h\Vert_{W^{s,2}(\mathbb{R}^{n-1})}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} s\gt \frac{n-1}{2}
            %a.maruku-eqref{:href => "#eq:eqThmL2Bound"} (3)
            allow us to conclude that for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} supp\,f\subset K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            compact, it holds that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msubsup
                        %mi L
                        %mi σ
                        %mn 2
                      %msubsup
                        %mi L
                        %mi x
                        %mn ∞
                  %mo ≤
                  %msub
                    %mi C
                    %mi K
                  %mo{:stretchy => "false"} ‖
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msup
                        %mi W
                        %mrow
                          %mi s
                          %mo ,
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Vert \operatorname{X} f\Vert_{L^2_\sigma L^\infty_x}\le C_K \Vert f\Vert_{W^{s,2}(\mathbb{R}^n)},
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mfrac
                      %mi n
                      %mn 2
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s\gt \frac{n}{2}-1
            %a.maruku-ref{:href => "#ThmXRayKakeya"}
            the Hausdorff dimension of a Kakeya set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ⊂
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} E\subset\mathbb{R}^n
            is at least 2. This result is the best possible in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            (
            %a{:href => "#cordoba1977"}> Córdoba 1977
            ), but far away from the expected dimension for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n\ge 3
          #LorentzSpace.num_defn
            %h6#definition_2 Definition
            %p
              %strong (Lorentz Spaces)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\nu)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                      %mo{:stretchy => "false"} (
                      %mi ν
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L^{p,q}(\nu)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi p
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} 1\le p\lt\infty
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi q
                      %mo &lt;
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} 1\le q \lt\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo :
                    %mo =
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi p
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn ∞
                    %msup
                      %mi s
                      %mi q
                    %mi ν
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} |
                    %mo ≥
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} }
                      %mfrac
                        %mi q
                        %mi p
                    %mfrac
                      %mi ds
                      %mi s
                    %msup
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mfrac
                        %mn 1
                        %mi q
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left\Vert f\right\Vert_{p,q} := \Big(p\int_0^\infty s^q\nu\{\vert f\vert\ge s\}^\frac{q}{p}\frac{ds}{s}\Big)^\frac{1}{q},
            %p
              and, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi p
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} 1\le p\lt\infty
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} q=\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %mi p
                        %mo ,
                        %mn ∞
                    %mo ≔
                    %munder
                      %mi sup
                      %mrow
                        %mi s
                        %mo &gt;
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mi ν
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} |
                    %mo ≥
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} }
                      %mfrac
                        %mn 1
                        %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\left\Vert f\right\Vert_{p,\infty} \coloneqq \sup_{s\gt 0} (s\nu\{\vert f\vert\ge s\}^\frac{1}{p})
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong
                (
                %a{:href => "#drury1983"}> Drury 1983
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E\subset \mathbb{R}^n
              is a measurable set, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} 1_E
              is the characteristic function of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            #eq:eqThmDrury.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ‖
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                            %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi M
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi C
                    %msup
                      %mrow
                        %mo |
                        %mi E
                        %mo |
                      %mfrac
                        %mn 2
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\Vert \operatorname{X}(1_E)\right\Vert_{L^{n+1,\infty}(M_n)} \le C\left\vert E\right\vert^\frac{2}{n+1}.
          %p
          .num_remark
            %h6 Remark
            %p
            %p
              This inequality corresponds to the restricted weak version of the point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mfrac
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                        %mn 2
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q,r) = (\frac{n+1}{2}, n+1, n+1)
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msub
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} f = 1_E
              and define the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mi l
                      %mo ∈
                      %msub
                        %mi M
                        %mi n
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi l
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mi λ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} F \coloneqq \{l\in M_n\mid \operatorname{X} f(l)\ge\lambda\}
            #eq:eqProofDruryLowerBush.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:stretchy => "false"} |
                    %mi F
                    %mo{:stretchy => "false"} |
                    %mo ≤
                    %msub
                      %mo ∫
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi μ
                    %mo =
                    %mo ∫
                    %mi f
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %msub
                      %mn 1
                      %mi F
                    %mspace{:width => "thinmathspace"}
                    %mi dx
                    %mo ≤
                    %msub
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda\vert F\vert \le \int_F \operatorname{X} f\,d\mu = \int f\operatorname{X}^*1_F \,dx \le \left\Vert \operatorname{X}^*1_F\right\Vert_\infty\left\Vert f\right\Vert_1.
            %p
              This establishes a lower bound for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo ‖
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                            %mo *
                          %msub
                            %mn 1
                            %mi F
                          %mo ‖
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \left\Vert \operatorname{X}^*1_F\right\Vert_\infty
            %p
              Choose a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %msub
                      %mn 1
                      %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \operatorname{X}^*1_F(x_0)\ge \frac{1}{2}\left\Vert \operatorname{X}^*1_F\right\Vert_\infty
              —
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              is the center of
              = succeed "." do
                %em Bourgain’s bush
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x_0 = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta_0
              is the Dirac delta centered at the origin, then
            #eq:eqProofDruryLower.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mi λ
                    %msub
                      %mo ∫
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mfrac
                      %mi λ
                      %mn 2
                    %msub
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int 1_F \operatorname{X} f\,\operatorname{X}\delta_0\,d\mu(l) \ge \lambda\int_F \operatorname{X}\delta_0\,d\mu(l)\ge \frac{\lambda}{2}\left\Vert \operatorname{X}^*1_F\right\Vert_\infty.
            %p
              Here we can think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \operatorname{X}\delta_0
              as the distribution we defined earlier
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                    %mo ≔
                    %msub
                      %mi lim
                      %mrow
                        %mi ε
                        %mo →
                        %mn 0
                    %msup
                      %mi ε
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi l
                        %mo ∈
                        %msub
                          %mi M
                          %mi n
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mspace{:width => "thickmathspace"}
                        %mi l
                        %mo ∩
                        %msub
                          %mi B
                          %mi ε
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mi ∅
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \delta_{\{0\}} \coloneqq \lim_{\varepsilon\to 0}\varepsilon^{-n+1}1_{\{l\in M_n\mid \;l\cap B_\varepsilon(0)\neq\emptyset\}}
              supported over the lines passing through the point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \operatorname{X}\delta_0
              by a limiting process since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                      %mo ≔
                      %msub
                        %mi lim
                        %mrow
                          %mi ε
                          %mo →
                          %mn 0
                      %msup
                        %mi ε
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi n
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi B
                            %mi ε
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \delta_0 \coloneqq \lim_{\varepsilon\to 0}\varepsilon^{-n}1_{B_\varepsilon(0)}
            %p
              On the other hand, we can also estimate the left side of
              %a.maruku-eqref{:href => "#eq:eqProofDruryLower"} (6)
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ∫
                    %mi f
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dx
                    %mo ≤
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mi n
                            %mo ,
                            %mn 1
                    %msub
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi F
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                        %msub
                          %mi δ
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mfrac
                              %mi n
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mn ∞
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\int 1_F \operatorname{X} f\,\operatorname{X}\delta_0\,d\mu(l) = \int f\operatorname{X}^*(1_F \operatorname{X}\delta_0)\,dx \le  \left\Vert f\right\Vert_{L^{n,1}} \left\Vert \operatorname{X}^*(1_F \operatorname{X}\delta_0)\right\Vert_{L^{\frac{n}{n-1},\infty}},
            %p
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{X}^*(1_F \operatorname{X}\delta_0)
              can be computed explicitly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %msup
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mn 1
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\operatorname{X}^*(1_F \operatorname{X}\delta_0)(x) = \frac{1}{\vert x\vert^{n-1}}1_F(l(\tilde{x}, 0)),
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ˜
                    %mo ≔
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \tilde{x} \coloneqq x/\vert x\vert
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} l(\tilde{x}, 0)
              is the line that passes through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{X}^*(1_F \operatorname{X}\delta_0)
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi F
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                        %msub
                          %mi δ
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mfrac
                              %mi n
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mn ∞
                    %mo =
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} |
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                      %mo *
                    %msub
                      %mn 1
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} |
                      %mfrac
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mi n
                    %mo ≤
                    %msub
                      %mi c
                      %mi n
                    %msubsup
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                      %mfrac
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mi n
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\Vert \operatorname{X}^*(1_F \operatorname{X}\delta_0)\right\Vert_{L^{\frac{n}{n-1},\infty}} = c_n\vert \operatorname{X}^*1_F(0)\vert^\frac{n-1}{n}\le c_n\left\Vert \operatorname{X}^*1_F\right\Vert_\infty^\frac{n-1}{n}.
            %p Then we get the bound
            #eq:eqProofDruryUpper.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %msub
                      %mn 1
                      %mi F
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mi c
                      %mi n
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mi n
                            %mo ,
                            %mn 1
                    %msubsup
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                      %mfrac
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mi n
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int 1_F \operatorname{X} f\,\operatorname{X}\delta_0\,d\mu(l) \le c_n \left\Vert f\right\Vert_{L^{n,1}}\left\Vert \operatorname{X}^*1_F\right\Vert_\infty^\frac{n-1}{n}.
            %p
              By
              %a.maruku-eqref{:href => "#eq:eqProofDruryLower"} (6)
              and
              %a.maruku-eqref{:href => "#eq:eqProofDruryUpper"} (7)
              we get the desired upper bound for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo ‖
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                            %mo *
                          %msub
                            %mn 1
                            %mi F
                          %mo ‖
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \left\Vert \operatorname{X}^*1_F\right\Vert_\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                    %mi λ
                    %msubsup
                      %mrow
                        %mo ‖
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                          %mo *
                        %msub
                          %mn 1
                          %mi F
                        %mo ‖
                      %mn ∞
                      %mfrac
                        %mn 1
                        %mi n
                    %mo ≲
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mi n
                            %mo ,
                            %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c_n\lambda \left\Vert \operatorname{X}^*1_F\right\Vert_\infty^\frac{1}{n} \lesssim \left\Vert f\right\Vert_{L^{n,1}}.
            %p
              This and
              %a.maruku-eqref{:href => "#eq:eqProofDruryLowerBush"} (5)
              allow us to conclude that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi F
                    %mo{:stretchy => "false"} |
                    %mo ≲
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi λ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %msub
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mn 1
                    %msubsup
                      %mrow
                        %mo ‖
                        %mi f
                        %mo ‖
                      %mrow
                        %msup
                          %mi L
                          %mrow
                            %mi n
                            %mo ,
                            %mn 1
                      %mi n
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi λ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mo{:stretchy => "false"} |
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\vert F\vert \lesssim \frac{1}{\lambda^{n+1}}\left\Vert f\right\Vert_1\left\Vert f\right\Vert_{L^{n,1}}^n = \frac{1}{\lambda^{n+1}}\vert E\vert^2,
            %p
              which implies the restricted weak inequality
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:eqThmDrury"} (4)
          %p
            Drury’s Theorem and the bound
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 1
                  %mo →
                  %msup
                    %mi L
                    %mn 1
                %annotation{:encoding => "application/x-tex"} L^1\to L^1
            imply that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msup
                        %mi L
                        %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi M
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi C
                  %mo{:stretchy => "false"} ‖
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msup
                        %mi L
                        %mi p
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Vert \operatorname{X} f\Vert_{L^q(M_n)}\le C\Vert f\Vert_{L^p(\mathbb{R}^n)},
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ≤
                  %mi p
                  %mo &lt;
                  %mfrac
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %mn 2
                %annotation{:encoding => "application/x-tex"} 1\le p\lt \frac{n+1}{2}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mi q
                    %mo +
                    %mn 1
                    %mo =
                    %mfrac
                      %mi n
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \frac{n-1}{q}+1 = \frac{n}{p}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi h
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi L
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} ‖
                    %mi h
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi W
                          %mrow
                            %mi s
                            %mo ,
                            %mi q
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Vert h\Vert_{L^\infty(\mathbb{R}^{n-1})} \le \Vert h\Vert_{W^{s,q}(\mathbb{R}^{n-1})}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mi q
                  %annotation{:encoding => "application/x-tex"} s\gt \frac{n-1}{q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msubsup
                        %mi L
                        %mi σ
                        %mi q
                      %msubsup
                        %mi L
                        %mi x
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi M
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi C
                  %mo{:stretchy => "false"} ‖
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %msup
                        %mi W
                        %mrow
                          %mi s
                          %mo ,
                          %mi p
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Vert \operatorname{X} f\Vert_{L^q_\sigma L^\infty_x(M_n)}\le C\Vert f\Vert_{W^{s,p}(\mathbb{R}^n)},
          %p
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi p
                    %mo &lt;
                    %mfrac
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} 1\le p\lt \frac{n+1}{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %mi q
                  %mo +
                  %mn 1
                  %mo =
                  %mfrac
                    %mi n
                    %mi p
                %annotation{:encoding => "application/x-tex"} \frac{n-1}{q}+1 = \frac{n}{p}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mfrac
                      %mi n
                      %mi p
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s\gt \frac{n}{p}-1
            %a.maruku-ref{:href => "#ThmXRayKakeya"}
            the Hausdorff dimension of a Kakeya set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ⊂
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} E\subset\mathbb{R}^n
            is at least
