          %h2#statement Statement
          %p
          #LefschetzNumber.num_defn
            %h6 Definition
            %p
              %strong (Lefschetz number)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \colon X\to X
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %strong Lefschetz number
              is the alternating
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the
              %a.existingWikiWord{:href => "/nlab/show/traces"} traces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⋅
                    %mi Tr
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda_k(X,f)
                    \\;\coloneqq\;
                    \\sum_i
                    \\,
                    (-1)^i
                    \\cdot
                    Tr
                    \\bigg(
                    H^i(X ,\, \mathbb{Q})
                    \\xrightarrow{ f^\ast }
                    H^i(X ,\, \mathbb{Q})
                    \\bigg)
                    \\,,
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
              on the
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} groups
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              given by
              %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback in cohomology
              \.
          %p
            One sometimes also speaks of the
            %em Lefschetz number
            of the induced
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain/cochain complexes
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+Lefschetz+formula"} algebraic Lefschetz formula
          %p
          #LefschetzFixedPointTheorem.num_prop
            %h6 Proposition
            %p
              %strong (Lefschetz fixed point theorem)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/polyhedron"} polyhedron
              (a finite
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complex
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzNumber"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has at least one
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
          The
          %strong proof
          follows from the existence of
          %ol
            %li
              %p a good cycle map,
            %li
              %p
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+formula"} Künneth formula
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality"}> Poincaré duality
                \.
          %p
            (see
            = succeed ")." do
              %a{:href => "#Milne"} Milne, section 25
          %p
          .num_remark
            %h6 Remark
            %p
              The Lefschetz formula holds more generally in
              %a.existingWikiWord{:href => "/nlab/show/Weil+cohomology"} Weil cohomology
              theories (by definition) and hence notably in
              %a.existingWikiWord{:href => "/nlab/show/%E2%84%93-adic+cohomology"} ℓ-adic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Weil+conjectures"} Weil conjectures
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              %strong (Euler characteristic)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} f = id
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              map, the Lefschetz number (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzNumber"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (see
              = succeed "):" do
                %a{:href => "Euler+characteristic#EulerCharOfTopSpace"} this Def.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi id
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda(X,\,id) \,=\, \chi(X)
                    \\,.
            %p
          %p
          #ForContractibleCompactPolyhedra.num_remark
            %h6 Example
            %p
              %strong
                (fixed point theorem for
                %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/polyhedra"} polyhedra
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is compact polyhedron which is
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
              then all its
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              in
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              degree vanish,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mo ≥
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ;
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} H^{\geq 1}(X; k) \,=\, 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ;
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi k
                    %annotation{:encoding => "application/x-tex"} H^0(X; k) \,=\, k
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzNumber"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \Lambda(X,f) \,=\, 1
            %p
              Therefore, for contactible compact polyhedral
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the Lefschetz fixed point theorem (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzFixedPointTheorem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \colon X\to X
              has a fixed point.
            %p
              In the further special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = D^n
              is a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ball"} ball
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Brouwer%27s+fixed+point+theorem"} Brouwer's fixed point theorem
          %p
          #FixedPointTheoremForHomeomorphismsOfnSpheres.num_remark
            %h6 Example
            %p
              %strong
                (fixed point theorem for
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℚ
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 0
                              %mo ,
                              %mi n
                              %mo{:stretchy => "false"} }
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^k(S^n;\, \mathbb{Q})
                    \\;\simeq\;
                    \\left\{
                    \\array{
                    \\mathbb{Q} &amp;\vert&amp; k \in \{0,n\}
                    \\\
                    0 &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              Any map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \,\colon\, S^n \to S^n
              necessarily induces the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ;
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^0(S^n;\mathbb{Q})
              and is multiplication by the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(f)
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi n
                      %mo ;
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^n(S^n; \mathbb{Q})
            %p
              Therefore the Lefschetz number of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzNumber"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda(S^n, f)
                    \\;=\;
                    1 + (-1)^n d(f)
            %p
              and so the Lefschetz fixed point theorem (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LefschetzFixedPointTheorem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to have a fixed point is that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is not a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  (its degree is different from
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ±
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \pm 1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d(f) \,=\, (-1)^n
                        \\,.
            %p
              The last case means equivalently that a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \,\colon\, S^n \to S^n
              is guaranteed to have a fixed point if
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is
                %a.existingWikiWord{:href => "/nlab/show/even+number"} even
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                preserves
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            %p or
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is
                %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                reverses
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            %p
              This plays a role in the classification of
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %a.existingWikiWord{:href => "/nlab/show/transformation+group"} transformation group
              %a.existingWikiWord{:href => "/nlab/show/actions"} actions
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              %em
                %a.existingWikiWord{:href => "/nlab/show/group+actions+on+spheres"} group actions on spheres
              the section
              = succeed "." do
                %em
                  %a{:href => "group+actions+on+spheres#FreeActionsByFiniteGroupsAndSphericalSpaceForms"} Free actions by finite groups
            %p
              For example, the
              %a.existingWikiWord{:href => "/nlab/show/antipode"} antipodal
              reflection action of
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+two"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              is orientation reversing for even
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and orientation preserving for odd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and hence always has vanishing Lefschetz number. Indeed, this action is manifestly fixed-point free. But the Lefschetz fixed point theorem implies that this is the only case, in that there can be
              %em no
              orientation-preserving free action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              on an even-dimensional sphere, and no orientation-reversing free action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              on an odd-dimensional sphere.
