              ,
              = succeed "," do
                %em The Lefschetz trace formula for algebraic stacks
              = succeed "," do
                %strong 112
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1007/BF01232427"} doi:10.1007/BF01232427
