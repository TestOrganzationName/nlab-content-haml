                  %div
                    %p
                      %a{:href => "/nlab/edit/stable+homotopy+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#remarks"} Remarks
              %li
                %a{:href => "#characterization_of_deloopable_objects"} Characterization of deloopable objects
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#topological_loop_spaces"} Topological loop spaces
                %li
                  %a{:href => "#delooping_of_a_group_to_a_groupoid"} Delooping of a group to a groupoid
              %li
                %a{:href => "#DeloopingOfHigherCategoricalStructures"} Deloopings of higher categorical structures
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em delooping
            of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is, if it exists, a uniquely
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{B} A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A \simeq \Omega(\mathbf{B} A)
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi G
                %annotation{:encoding => "application/x-tex"} A = G
            is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            then its delooping
          %ul
            %li
              %p
                in the context
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                is the
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}G
            %li
              %p
                in the context
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Grpd"} ∞-Grpd
                is the one-object groupoid
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            these two objects are identified: the
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of the groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is the classifying space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} |
                  %mo ≃
                  %mi ℬ
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  |\mathbf{B}G| \simeq \mathcal{B}G
                  \\,.
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
          %h2#definition Definition
          %p
            Loop space objects are defined in any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            any
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            with point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} {*} \to X
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            of this point along itself:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ω
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega X &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; X
                  }
                  \\,.
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given and a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; \mathbf{B}A
                  }
          %p
            exists, with the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} {*} \to \mathbf{B} A
            being essentially unique, by the above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has been realized as the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{B} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi Ω
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  A = \Omega \mathbf{B} A
          %p
            and we say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{B} A
            is the
            %strong delooping
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            See the section
            %a{:href => "http://ncatlab.org/nlab/show/groupoid+object+in+an+(infinity%2C1)-category#Delooping"} delooping
            at
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
            for more.
          %h2#remarks Remarks
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is even a
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            then all deloopings exist and are then also denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Sigma A
            and called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#characterization_of_deloopable_objects Characterization of deloopable objects
          %p In section 6.1.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            a definition of
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is given as a homotopy simplicial object, i.e. a
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  C  : \Delta^{op} \to \mathbf{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %msub
                    %mi C
                    %mn 2
                  %mover
                    %mo ⇉
                    %mo →
                  %msub
                    %mi C
                    %mn 1
                  %mo ⇉
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  C_2 \stackrel{\to}\rightrightarrows
                  C_1
                  \\rightrightarrows
                  C_0
          %p
            satisfying certain conditions (prop. 6.1.2.6) which are such that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} C_0 = {*}
            is the
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            we have an internal
            %em group
            in a homotopical sense, given by an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C_1
            equipped with a coherently associative multiplication operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 1
                  %mo ×
                  %msub
                    %mi C
                    %mn 1
                  %mo →
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C_1 \times C_1 \to C_1
            generalizing that of
            %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Stasheff
            %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
            from the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            to arbitrary
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            Lurie calls the groupoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            an
            %em effective
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
            precisely if it arises as the delooping, in the above sense, of some object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}C
          %p
            One of the characterizing properties of an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
            is that
            %em every
            groupoid object in it is effective.
          %p
            This is the analog of
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Stasheff
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/H-spaces"} H-spaces
          %p
            See the remark at the very end of section 6.1.2 in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
          %h2#examples Examples
          %h3#topological_loop_spaces Topological loop spaces
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/A-infinity-space"} A-infinity-space
            and hence homotopy equivalent to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
          %h3#delooping_of_a_group_to_a_groupoid Delooping of a group to a groupoid
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete groupoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B} G
            exists and is, up to equivalence, the
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          %ul
            %li
              %p
                with a single object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo •
                      %annotation{:encoding => "application/x-tex"} \bullet
            %li
              %p
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mo{:stretchy => "false"} (
                        %mo •
                        %mo ,
                        %mo •
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi G
                      %annotation{:encoding => "application/x-tex"} Hom_{\mathbf{B} G}(\bullet, \bullet) = G
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Aut
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mo{:stretchy => "false"} (
                        %mo •
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi G
                      %annotation{:encoding => "application/x-tex"} Aut_{\mathbf{B}G}(\bullet) = G
            %li
              %p
                and with composition of morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} G
                being given by the product operation in the group.
          %p More informally but more suggestively we may write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo •
                  %mover
                    %mo →
                    %mi g
                  %mo •
                  %mo{:stretchy => "false"} |
                  %mi g
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} G = \{ \bullet \stackrel{g}{\to} \bullet | g \in G\}
          %p or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo •
                  %mo ⟲
                  %mi g
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi g
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G = \{
                  \\bullet \righttoleftarrow g \;|\; g \in G
                  \\}
          %p to emphasize that there is really only a single object.
          %p
            Notice how the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            works in this simple case:
          %p
            the universal 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ⇓
                            %mi η
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;\Downarrow^{\eta}&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; \mathbf{B}G
                  }
          %p
            filling this
            %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
            diagram is the
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            from the constant
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  G \to {*} \to \mathbf{B}G
          %p to itself, whose component map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi Obj
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\eta : Obj(G) \to Mor(\mathbf{B}G)
          %p
            is just the identity map, using that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Obj
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi G
                %annotation{:encoding => "application/x-tex"} Obj(G) = G
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} Mor(\mathbf{B}G) = G
          %h2#DeloopingOfHigherCategoricalStructures Deloopings of higher categorical structures
          %p
            There is also a notion of delooping which takes a pointed
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n, k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to a pointed
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1, k)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{B} C
            in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{B} C
            has a single
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                  %annotation{:encoding => "application/x-tex"} \bullet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mo ,
                    %mo •
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \hom(\bullet, \bullet) = C
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/delooping+hypothesis"} delooping hypothesis
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n, k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a special type of
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+k+1)
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-category:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+k+1)
            %em a fortiori
            a pointed
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+k+1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} C
          %p
            This is just a generalization of the fact that a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            gives rise to a one-object category (which we are denoting
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} M
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            has an associated
            %strong
              delooping
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} M
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} M
                has a single
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo •
                      %annotation{:encoding => "application/x-tex"} \bullet
            %li
              %p
                the
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo •
                      %mo →
                      %mo •
                    %annotation{:encoding => "application/x-tex"} \bullet \to \bullet
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} M
                are named by objects of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo •
                      %mover
                        %mo →
                        %mi a
                      %mo •
                      %mover
                        %mo →
                        %mi b
                      %mo •
                    %annotation{:encoding => "application/x-tex"} \bullet \stackrel{a}{\to} \bullet \stackrel{b}{\to} \bullet
                is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo •
                      %mover
                        %mo →
                        %mrow
                          %mi a
                          %mo ⊗
                          %mi b
                      %mo •
                    %annotation{:encoding => "application/x-tex"} \bullet \stackrel{a \otimes b}{\to} \bullet
                (using the monoidal product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                of
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                the
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} M
                are similarly named by morphisms of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} M
                is given by composition of morphisms of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} M
                is given by taking the monoidal product of the morphisms that name them in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
          %p
            Along similar lines, the delooping of a
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            produces a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+bicategory"} monoidal bicategory
            %em that
            is a
            %a.existingWikiWord{:href => "/nlab/show/tricategory"} tricategory
            or (weak)
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            %a.existingWikiWord{:href => "/nlab/show/delooping+hypothesis"} delooping hypothesis
            for more.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"}> loop space object
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              %ul
                %li
                  %p
                    %strong delooping
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/loop+space"}> loop space
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
                    %a.existingWikiWord{:href => "/nlab/show/derived+loop+space"} derived loop space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/suspension+object"} suspension object
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/suspension"}> suspension
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
          %h2#references References
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#BCFR23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrik+Buchholtz"}> Ulrik Buchholtz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+Daniel+Christensen"} J. Daniel Christensen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jarl+G.+Taxer%C3%A5s+Flaten"} Jarl G. Taxerås Flaten
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"} Egbert Rijke
                %em Central H-spaces and banded types
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2301.02636"}> arXiv:2301.02636
                \&amp;rbrack;
            %li{:id => "Wärn23"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+W%C3%A4rn"}> David Wärn
                ,
                %em Eilenberg-MacLane spaces and stabilisation in homotopy type theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2301.03685"}> arXiv:2301.03685
                \&amp;rbrack;
        .revisedby
