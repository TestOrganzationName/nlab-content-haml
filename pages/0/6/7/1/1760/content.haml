                              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/stable+derivator"} stable derivator
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category+of+spectra"} stable (∞,1)-category of spectra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+of+spectra"} symmetric smash product of spectra
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+duality"} Spanier-Whitehead duality
