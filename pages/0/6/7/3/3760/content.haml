                %mrow
                  %mi G
                  %mo ×
                  %mi G
                %annotation{:encoding => "application/x-tex"} G\times G
            as the relations are indexed by pairs of elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h3{:id => ""}
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} Cyclic groups
          %p
            Cyclic group,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
