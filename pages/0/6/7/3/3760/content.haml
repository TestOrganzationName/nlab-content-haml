                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1007/978-1-4612-4576-6"} doi:10.1007/978-1-4612-4576-6
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                Behrooz Mashayekhy, Hanieh Mirebrahimi,
                = succeed "," do
                  %em Some Properties of Finitely Presented Groups with Topological Viewpoints
                %strong 18
                6 (2010) 511-515 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1012.1744"}> arXiv:1012.1744
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/rewriting"} rewriting
            in group presentations:
          %ul
            %li
