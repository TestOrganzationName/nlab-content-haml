                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1703.08695"} arXiv:1703.08695
            %li
              %p
                Vikas Yadav, Aalok Misra,
                %em
                  On M-Theory Dual of Large-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  Thermal QCD-Like Theories up to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %msup
