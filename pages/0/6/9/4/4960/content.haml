                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is fully faithful (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#LeftKanExtensionAlongFullyFaithfulFunctor"}> this prop.
              ). This implies that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              is fully faithful, by
              = succeed "." do
                %a{:href => "geometry+of+physics+--+Categories+and+Toposes#FullyFaithfulAdjointTriple"} this prop.
            %p
