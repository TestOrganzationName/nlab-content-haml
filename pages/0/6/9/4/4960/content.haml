                    %mi Disc
                    %mo ≃
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Disc \simeq p^\ast
              is the
              %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant
              = succeed "-assigning" do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#UniquenessOfAdjoints"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              is the functor that sends a presheaf, regarded as a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
