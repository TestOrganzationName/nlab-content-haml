              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              (
              %a{:href => "geometry+of+physics+--+smooth+sets#DifferentiallyGoodOpenCover"}> this def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSet
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSet \simeq Sh(CartSp)
                    \\,.
            %p
              Hence, by Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CategoriesOfSheavesOnCohesiveSiteIsCohesive"}
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OneCohesiveSite"}
            %p
              It clearly has
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo =
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\ast = \mathbb{R}^0
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of two
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              is the Cartesian space whose
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              is the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the two separate dimensions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
