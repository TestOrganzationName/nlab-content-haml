          .proof
            %h6#proof_4 Proof
            %p First observe the equivalence of the first two statements:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ptp
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext is epi
                    %mphantom
                      %mi AAA
                    %mtext iff
                    %mphantom
                      %mi AAA
                    %msub
                      %mi ptp
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext is epi
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ptp_{\mathbf{H}} \;\; \text{is epi}
                    \\phantom{AAA}
                    \\text{iff}
                    \\phantom{AAA}
                    ptp_{\mathbf{B}} \;\; \text{is epi}
                    \\,.
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ptp
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                  %annotation{:encoding => "application/x-tex"} ptp_{\mathbf{B}}
              is an epimorphism. By
              %a.maruku-eqref{:href => "#eq:PiecesToPointsFromBase"} (4)
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ptp
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo =
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ptp
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ptp_{\mathbf{H}} = Disc(ptp_{\mathbf{B}})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and left adjoints preserve epimorphisms.
            %p
              In the other direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ptp
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                  %annotation{:encoding => "application/x-tex"} ptp_{\mathbf{H}}
              is an epimorphism. By
              %a.maruku-eqref{:href => "#eq:PointsToPiecesInTheBase"} (2)
              and
              %a.maruku-eqref{:href => "#eq:AdjunctOfptpH"} (5)
              we see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ptp
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                  %annotation{:encoding => "application/x-tex"} ptp_{\mathbf{B}}
              is re-obtained from this by applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              and then composition with isomorphisms. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is again a left adjoint, and hence preserves epimorphisms, as does composition with isomorphisms.
            %p
              By applying
              %a.maruku-eqref{:href => "#eq:PointsToPiecesInTheBase"} (2)
              again, we find in particular that
              %em
                %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
              is also equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %msubsup
                      %mi ϵ
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} \Pi \epsilon^\flat_{\mathbf{X}}
              being an epimorphism, for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} \in \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %msubsup
                      %mi ϵ
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ♭
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mstyle{:mathvariant => "bold"}
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ♭
                    %mo ,
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathbf{B}}(\Pi \epsilon^\flat_{\mathbf{X}}, S)
                    \=
                    Hom_{\mathbf{\mathbf{H}}}(\epsilon^\flat_{\mathbf{X}}, Disc(S))
            %p
              being a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (by adjunction isomorphism and definition of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            %p
              Now by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ReExpressingMiddleFunctorInAdjointTriple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %msubsup
                      %mi η
                      %mrow
                        %mi Disc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %mo ♯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathbf{H}}( \mathbf{X}, \eta^\sharp_{Disc(S)} )
            %p
              being a monomorphism, which is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mrow
                        %mi Disc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"} \eta^\sharp_{Disc(S)}
              being a monomorphism, hence to
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/discrete+objects+are+concrete"} discrete objects are concrete
          .num_example
            %h6#example Example
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} points-to-pieces transform
              = succeed "," do
                %a.maruku-ref{:href => "#TransformationFromPointsToPieces"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          .num_example
            %h6#example_2 Example
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/tangent+cohesion"} tangent cohesion
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} points-to-pieces transform
              = succeed "," do
                %a.maruku-ref{:href => "#TransformationFromPointsToPieces"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+diagram"} differential cohomology diagram
          %p
            This condition
            %em
              %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
            may also be expressed as follows:
          #RelationOfPiecesToPointsToInitialAufhebung.num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mo →
                    %mo ∫
                  %annotation{:encoding => "application/x-tex"} \flat \to \int
              is epi, then there is
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              of the initial opposition, in that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                      %mi ∅
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mo →
                    %mo ∫
                  %annotation{:encoding => "application/x-tex"} \flat \to \int
              is epi.
          %p
            This is
            = succeed "." do
              %a{:href => "#LawvereMenni15"} Lawvere-Menni 15, lemma 4.1, 4.2
          #PiecesOfPowersArePowersOfPieces.num_defn
            %h6#definition_4 Definition
            %p
              We say
              %strong pieces of powers are powers of pieces
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} S \in \mathcal{S}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X \in E
              the natural morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi S
                  %annotation{:encoding => "application/x-tex"}
                    f_! (X^{f^* S}) \stackrel{\simeq}{\longrightarrow} (f_!(X))^S
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .num_remark
            %h6#remark_2 Remark
            %p
              This morphism is the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi f
                      %mo !
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S \times f_!(X^{f^* S})
                    \\stackrel{\simeq}{\longrightarrow}
                    f_!f^*(S) \times f_!(X^{f^* S})
                    \\stackrel{\simeq}{\longrightarrow}
                    f_!(f^*(S) \times X^{f^* S})
                    \\longrightarrow
                    f_!(X)
            %p
              where we use that by definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
              and then that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              preserves
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
          %p
            These extra axioms are proposed in (
            %a{:href => "#LawvereAxiomatic"}> Lawvere, Axiomatic cohesion
            ).
          #SubobjectClassifierIsConnected.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{E} \to \mathcal{S}
              a cohesive topos, we say that its
              %strong subobject classifier is connected
              if for the
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \Omega \in \mathcal{E}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_!(\Omega) \simeq *
                    \\,.
            %p
              This implies that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo !
                      %msup
                        %mi Ω
                        %mi X
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} f_! \Omega^X \simeq *
          %p
            This appears as axiom 2 in (
            %a{:href => "#LawvereCatsOfSpaces"}> Lawvere, Categories of spaces
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              There is some overlap between the structures and conditions appearing here and those considered in the context of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Q-categories"} Q-categories
          %p
            Another axiom to consider, also introduced by
            %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
            (see at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
          #AufhebungOfBecoming.num_defn
            %h6#definition_6 Definition
            %p
              Say that a cohesive topos, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CohesiveTopos"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
                of
                %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
              if the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
              = succeed "," do
                %a.maruku-ref{:href => "#AdjointTriple"}
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi ∅
                    %mo ≃
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sharp \emptyset \simeq \emptyset
                    \\,.
          .num_example
            %h6#example_3 Example
            %p
              The Aufhebungs axiom def.
              %a.maruku-ref{:href => "#AufhebungOfBecoming"}
              is satisfied by all cohesive toposes with a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              of definition, see at
              = succeed "." do
                %em
                  %a{:href => "Aufhebung#ExamplesBecomingFormalization"} Aufhebung – Over cohesive sites
          .num_remark
            %h6#remark_4 Remark
            %p
              In the Aufhebungs-axiom of def.
              = succeed "," do
                %a.maruku-ref{:href => "#AufhebungOfBecoming"}
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#CohesiveTopos"}
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ʃ
                    %mo *
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \&amp;#643; \ast \simeq \ast
            %p finds a dual companion. It might make sense to consider the variant of the axioms of cohesion which say
            %ol
              %li
                %p
                  there is an
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                  of idempotent (co-)monads
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ʃ
                          %mo ⊣
                          %mo ♭
                          %mo ⊣
                          %mo ♯
                        %annotation{:encoding => "application/x-tex"} &amp;#643; \dashv \flat \dashv \sharp
              %li
                %p
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                      %annotation{:encoding => "application/x-tex"} \sharp
                  satisfies Aufhebung and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ʃ
                      %annotation{:encoding => "application/x-tex"} &amp;#643;
                  satisfies co-Aufhebung.
          %h2#Properties Properties
          %p We discuss properties of cohesive toposes. In
          %ul
            %li
              %a{:href => "#RelationsBetweenTheAxioms"} Relations between the axioms
          %p we comment on the interdependency of the collection of axioms on a cohesive topos. In
          %ul
            %li
              %a{:href => "#ConcreteObjects"} Quasitopos of concrete objects
          %p we discuss the induced notion of concrete objects that comes with every cohesive topos and in
          %ul
            %li
              %a{:href => "#ObjectsWithOnePointPerCohesivePiece"} Objects with one point per cohesive piece
          %p the induced subcategory of objects with one point per piece.
          %p Some of these phenomena have a natural
          %ul
            %li
              %a{:href => "#Modality"}> Modality interpretation
              \.
          %p For a long list of further structures that are canonically present in a cohesive context see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos+--+structures"} cohesive (∞,1)-topos – structures
          %p For more structure available with a few more axioms see at
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tangent+cohesion"}> tangent cohesion
                \.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#RelationsBetweenTheAxioms Relations between the axioms
          %p We record some relations between the various axioms characterizing cohesive toposes.
          #PiecesHavePointsEquivalentToDiscreteObjectsAreConcrete.num_prop
            %h6#proposition_4 Proposition
            %p
              The axioms
              %a{:href => "#PiecesHavePoints"} pieces have points
              and
              %a{:href => "#DiscreteObjectsAreConcrete"} discrete objects are concrete
              are equivalent.
          %p
            This is just a reformulation of the
            = succeed "." do
              %a{:href => "#TheEpiAndTheMono"} above proposition
          .num_prop
            %h6#proposition_5 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              that
            %ol
              %li
                %p
                  is
                  %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected
                  and
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/connected+topos"} connected
              %li
                %p
                  satisfies
                  %a{:href => "#PiecesHavePoints"} pieces have points
            %p also is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/local+topos"}> local
                  ;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/hyperconnected+topos"}> hyperconnected
                  ;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/strongly+connected+topos"} strongly locally connected
              %li
                %p
                  %a{:href => "#CohesiveTopos"}> cohesive
                  \.
          %p
            The statement of the first items appears as (
            %a{:href => "#Johnstone11"}> Johnstone 11, prop. 1.6
            ). The last item is then a consequence by definition.
          #HyperconnectivityAndPiecesHavePoints.num_prop
            %h6#proposition_6 Proposition
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              the condition that it
            %ol
              %li
                %p
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected
              %li
                %p
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/connected+topos"} connected
              %li
                %p
                  satisfies
                  %a{:href => "#PiecesHavePoints"} pieces have points
            %p is equivalent to the condition that it
            %ol
              %li
                %p
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected
              %li
                %p
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/hyperconnected+topos"} hyperconnected
              %li
                %p
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/local+topos"} local
          %p
            This is (
            %a{:href => "#Johnstone11"}> Johnstone 11, theorem 3.4
            ).
          %h3#subcategories_of_discrete_and_codiscrete_objects Subcategories of discrete and codiscrete objects
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
              of
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
              and of
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+objects"} codiscrete objects
              are both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+ideals"} exponential ideals
          .proof
            %h6#proof_5 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/exponential+ideal"} exponential ideal
              a reflective subcategories of a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              is an exponential ideal precisely if the
              %a.existingWikiWord{:href => "/nlab/show/reflector"} reflector
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+objects"} codiscrete objects
              the reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves even all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and for the
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
              the reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              does so by assumption of strong connectedness.
          %h3#ConcreteObjects Quasitoposes of concrete objects
          %p
            A cohesive topos comes canonically with various
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subcategories"} subcategories
            %a.existingWikiWord{:href => "/nlab/show/quasi-toposes"} quasi-toposes
            and
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
          .num_lemma
            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} (\Pi \dashv \Disc \dashv \Gamma \dashv coDisc) :  \mathcal{E} \to Set
              a cohesive topos,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              as a
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Set
                    %mover
                      %mo ↪
                      %mo ←
                    %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma \dashv \coDisc) : Set \stackrel{\leftarrow}{\hookrightarrow}
                    \\mathcal{E}
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By general properties of
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
          .num_lemma
            %h6#observation_2 Observation
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              is equivalent to the full
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              on those objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              for which the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
