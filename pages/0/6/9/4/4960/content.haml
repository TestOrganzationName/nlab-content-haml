                    %mi Π
                    %mi Disc
                    %mi Γ
                    %mi X
                    %mo →
                    %mi Γ
                    %mi Disc
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi Disc \Gamma X \to \Gamma Disc \Pi X
              along the bottom part of the diagram equals the left hand side of
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CoincidenceOfNaturalTransformationsForAdjointTriple"} (1)
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CoincidenceOfNaturalTransformationsForAdjointTriple"} (1)
          #PointsToPiecesTransform.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"}> points-to-pieces transform
                )
            %p
              Consider an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
