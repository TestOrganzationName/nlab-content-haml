                    \\;\;=\;\;
                    \\underset{
                    \= id_{\Gamma X}
                    }{
                    \\underbrace{
                    \\Gamma X
                    \\underoverset{iso}{ \phantom{A} \eta^{\flat}_{\Gamma X} \phantom{A} }{ \longrightarrow }
                    \\Gamma Disc \Gamma X
                    \\underoverset{iso}{ \phantom{A} \Gamma \epsilon^{\flat}_X \phantom{A} }{\longrightarrow}
                    \\Gamma X
