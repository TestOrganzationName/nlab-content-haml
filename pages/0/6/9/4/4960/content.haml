                    \\;\colon\;
                    Disc \Gamma X
                    \\overset{ \phantom{A} \epsilon^{\flat}_X \phantom{A} }{\longrightarrow}
                    X
                    \\overset{ \phantom{A} \eta^{&amp;#643;}_X \phantom{A} }{\longrightarrow}
                    Disc \Pi X
            %p is
            #eq:AdjunctOfptpH.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
