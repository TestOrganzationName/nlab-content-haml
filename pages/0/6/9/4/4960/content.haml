          %h4#diffeological_spaces Diffeological spaces
          .num_prop
            %h6#proposition_15 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
              of
              %a{:href => "#ConcreteObjects"} concrete objects
              in the cohesive topos of
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothSetsFormACohesiveTopos"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Conc
                            %mo{:stretchy => "false"} (
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi CartSp
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi CartSp
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo =
                          %mtd
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                            %mi DiffeolSp
                          %mtd
                            %mo ↪
                          %mtd
                            %mi SmoothSets
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Conc(Sh(CartSp))
                    \&amp;\hookrightarrow&amp;
                    Sh(CartSp)
                    \\\
                    \= &amp;&amp; =
                    \\\
                    DiffeolSp &amp;\hookrightarrow&amp; SmoothSets
                    }
          .proof
            %h6#proof_16 Proof
            %p
              A sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              is a
              %a.existingWikiWord{:href => "/nlab/show/separated+presheaf"} separated presheaf
              with respect to the further localization given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CoDisc
                  %annotation{:encoding => "application/x-tex"} CoDisc
              precisely if the canonical morphism (the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi CoDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv CoDisc)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi CoDisc
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \to CoDisc \Gamma X
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi CoDisc
                    %mi Γ
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(U,X) \simeq X(U) \to Hom(U,CoDisc \Gamma X)
            %p
              being a monomorphism for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              (where in the first step we used the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X(U) \to Set(\Gamma(U), \Gamma(X))
                    \\,.
            %p
              This being a monomorphism is precisely the condition on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              being a
              %a.existingWikiWord{:href => "/nlab/show/concrete+sheaf"} concrete sheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              that singles out diffeological spaces among all sheaves on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
          %h4#formally_smooth_sets Formally smooth sets
          .num_prop
            %h6#proposition_16 Proposition
            %p
