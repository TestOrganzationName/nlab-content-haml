              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo →
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi X
              an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi s
                      %mo *
                    %mo :
                    %mi ℒ
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} s^* : \mathcal{L} \hookrightarrow \mathcal{E}
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on those objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo →
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi X
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℒ
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi s
                          %mo !
                        %mo ⊣
                        %msup
                          %mi s
                          %mo *
                        %mo ⊣
                        %msub
                          %mi s
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi ℰ
                        %mover
                          %mover
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi s
                                  %mo *
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi s
                                  %mo *
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi s
                                %mo !
                        %mi ℒ
                      %annotation{:encoding => "application/x-tex"}
                        (s_! \dashv s^* \dashv s_*)
                        \:
                        \\mathcal{E}
                        \\stackrel{\overset{s_!}{\longrightarrow}}{\stackrel{\overset{s^*}{\leftarrow}}{\underset{s_*}{\longrightarrow}}}
                        \\mathcal{L}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mo *
                      %annotation{:encoding => "application/x-tex"} s_*
                  preserves
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %li
                %p
                  the components of the reflector
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %msub
                          %mi s
                          %mo !
                        %msup
                          %mi s
                          %mo *
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \to s_! s^* X
                  are
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          %p
            This is
            %a{:href => "http://www.tac.mta.ca/tac/volumes/19/3/19-03.pdf#page=5"} theorem 2
            in (
            %a{:href => "#Lawvere"}> Lawvere
            ).
          .proof
            %h6#proof_11 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              it preserves
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo →
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi X
              is an isomorphism is closed under colimits and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              has all colimits and the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi s
                      %mo *
                    %mo :
                    %mi ℒ
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} s^* : \mathcal{L} \hookrightarrow \mathcal{E}
              obviously preserves them.
            %p
              To apply the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              to deduce that therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} s^*
              has a right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} s_*
              it is sufficient to argue that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L} \hookrightarrow \mathcal{E}
              is the
              %a.existingWikiWord{:href => "/nlab/show/inverter"} inverter
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo →
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Gamma \to \Pi
              %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %a.existingWikiWord{:href => "/nlab/show/accessible+categories"} accessible categories
              and
              %a.existingWikiWord{:href => "/nlab/show/accessible+functors"} accessible functors
              is closed under (non-strict)
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              is accessible. Since we already know that it is also cocomplete it follows that it must be locally presentable.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              by assumption preserves finite products and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves all products, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is also closed under finite products and in particular contains the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} s_*
              preserves coproducts.
            %p (…details…)
            %p
              Using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo →
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi X
              is an epi, we find that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              is also closed under
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X
              is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              then if in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi Γ
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi Π
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi Π
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma Y &amp;\to&amp; \Gamma X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\Pi Y &amp;\to&amp; \Pi X
                    }
            %p the right vertical morphism is an iso, then so is the left vertical one.
            %p (…details…).
            %p
              It then also follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              is closed under arbitrary products.
            %p (…details…)
            %p
              This implies the existence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mo !
                  %annotation{:encoding => "application/x-tex"} s_!
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi s
                      %mo *
                    %msub
                      %mi s
                      %mo !
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to s^* s_! X
              is epi.
            %p (…details…)
          %h3#Modality Internal modal logic
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            comes with its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            – such as the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi coDisc
                %annotation{:encoding => "application/x-tex"} coDisc
            on a cohesive topos – is manifested by the existence of extra internal logical operators. These may be understood as
            %em modalities
            equipping the internal logic with a structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
          %p
            For the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+toposes"} local toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi coDisc
                %annotation{:encoding => "application/x-tex"} coDisc
            has been noticed in (
            %a{:href => "#AwodeyBirkedal"}> AwodeyBirkedal, section 4.2
            ). (Beware that in that reference the symbols “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ♭
                %annotation{:encoding => "application/x-tex"} \flat
            ” and “#” are used precisely oppositely to their use here).
          #DiscreteModality.num_defn
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \phi \hookrightarrow A
              a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              in a cohesive topos, hence a
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
              of
              %a.existingWikiWord{:href => "/nlab/show/type"} type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
              %em discretely true
              if the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                    %mi ϕ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} # \phi|_A \to A
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo #
                            %mi ϕ
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mo #
                            %mi ϕ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mo #
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \#\phi |_A &amp;\to&amp; # \phi
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    A &amp;\to&amp; # A
                    }
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo #
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \to # A
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma\dashv coDisc)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_remark
            %h6#remark_6 Remark
            %p
              If a proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is true over all discrete objects, then it is discretely true. More precisely, if for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X = \mathbf{\flat} X
              any discrete object we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}(X, \phi)
                    \\to
                    \\mathcal{E}(X, A)
            %p
              is an isomorphism, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is discretely true.
            %p Because if so, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi X
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}(\flat X , \phi)
                    \\to
                    \\mathcal{E}(\flat X , A)
            %p is an isomorphism and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mi X
                    %mo ,
                    %mi Γ
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mi X
                    %mo ,
                    %mi Γ
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}(\Gamma X , \Gamma \phi)
                    \\to
                    \\mathcal{E}(\Gamma X , \Gamma A)
            %p
              is for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi ϕ
                    %mo →
                    %mi Γ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \phi \to \Gamma A
              is an isomorphism and hence so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo #
                      %mi ϕ
                      %mo →
                      %mo #
                      %mi A
                    %annotation{:encoding => "application/x-tex"} # \phi \to # A
          .num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} = Sh(CartSp)
              the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              over
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
              (
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"}> smooth spaces
              ) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^n_{cl}(-) \hookrightarrow \Omega^n(-)
              the inclusion of all closed
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              into all
              = succeed "-forms," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is closed”. This is of course not true generally, but it is discretely true: over a
              %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
              every form is closed.
          %h2#examples Examples
          %h3#over_a_discrete_site Over a discrete site
          %p
            We discuss some cohesive toposes over
            %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with trivial
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} topology
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sh(C) \simeq PSh(C)
                  \\,.
          %h4#FamiliesOfSets Families of sets – the Sierpinski topos
          %p
            We discuss an example of a cohesive topos over a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
            that is about the simplest non-trivial example that there is: the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
            and hence there is a corresponding example of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+%28%E2%88%9E%2C1%29-topos"} Sierpinski (∞,1)-topos
          %p
            Consider the site given by the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  C = \{\emptyset \to *\}
          %p
            equipped with trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} topology
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            (which makes it
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            \=
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} presheaves
            on this is the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Sh(\{\emptyset \to *\})
                  \\simeq
                  PSh(\{\emptyset \to *\})
                  \\simeq
                  Arr(Set)
          %p
            since a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given by a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X : (\emptyset \to *) \mapsto (I \leftarrow S)
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ←
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \Gamma : (I \leftarrow S) \mapsto S
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ←
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \Pi_0 : (I \leftarrow S) \mapsto I
                \.
          %p
            Trivial as this is, it does provide some insight into the interpretation of cohesiveness: by decomposing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            into its
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (I \leftarrow S)
            is an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S = \coprod_i S_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi i
                %annotation{:encoding => "application/x-tex"} S_i
            and there are
            = succeed "-many" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi I
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |I|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            computes, which clearly preserves products.
          %p
            Moreover we find for
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} K \in Set
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Disc
                      %mo :
                      %mi K
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mover
                        %mo ←
                        %mi Id
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc : K \mapsto (K \stackrel{Id}{\leftarrow} K)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CoDisc
                      %mo :
                      %mi K
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mover
                        %mo ←
                        %mrow
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CoDisc : K \mapsto (* \stackrel{}{\leftarrow} K)
          %p (and evidently both these functors are full and faithful).
          %p
            This matches the interpretation we just found:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                  %mi K
                %annotation{:encoding => "application/x-tex"} Disc K
            is the collection of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            with no two of them lumped together by cohesion, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Codisc
                  %mi K
                %annotation{:encoding => "application/x-tex"} Codisc K
            is all elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            lumped together.
          %p The canonical morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma (I \leftarrow S) \to \Pi_0 (I \leftarrow S)
          %p is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mi Disc
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Γ
                  %mi Disc
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ←
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma Disc \Gamma (I \leftarrow S) \to \Gamma (I \leftarrow S) \to \Gamma Disc \Pi_0 (I \leftarrow S)
                  \\,.
          %p Plugging in the above this is just
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"}
                  S \to I
          %p
            itself. Indeed, by the above interpretation, this sends each point to its cohesive component. It is not an epimorphism in general, because the fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi i
                %annotation{:encoding => "application/x-tex"} S_i
            over an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            may be empty: the cohesive component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            may have no points.
          %h4#over_a_site_with_initial_and_terminal_object Over a site with initial and terminal object
          %p
            The
            %a{:href => "#FamiliesOfSets"} above
            example is the simplest special case of a more general but still very simple class of examples.
          %p
            First notice that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            of presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F : C^{op} \to Set
            along the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C^{op} \to *
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            and
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi lim
                    %mo →
                  %mo ⊣
                  %mi Const
                  %mo ⊣
                  %munder
                    %mi lim
                    %mo ←
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %munder
                            %mi lim
                            %mo ←
                      %mover
                        %mo ←
                        %mi Const
                    %mover
                      %mo ⟶
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\lim_\to \dashv Const \dashv \lim_\leftarrow) :
                  PSh(C) \stackrel{\overset{\lim_{\to}}{\longrightarrow}}{\stackrel{\overset{Const}{\leftarrow}}{\underset{\lim_\leftarrow}{\longrightarrow}}}
                  Set
                  \\,.
          .num_lemma
            %h6#observation_3 Observation
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              then
            %ul
              %li
                %p the colimit is given by evaluation on this object;
              %li
                %p
                  there is a further
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi lim
                          %mo ←
                        %mo ⊣
                        %mi CoConst
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\lim_\leftarrow \dashv CoConst)
                %p given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CoConst
                        %mo :
                        %mi S
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ↦
                        %mi Set
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        CoConst : S \mapsto (c \mapsto Set(C(*,c), S)
                        \\,.
          .proof
            %h6#proof_12 Proof
            %p
              The terminal object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              and therefore the limit over any functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F : C^{op} \to Set
              is given by evaluation on this object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ←
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mover
                      %mo →
                      %mi F
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_\leftarrow (C^{op} \stackrel{F}{\to} Set) \simeq F(*)
                    \\,.
            %p
              To see that we have a pair of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi lim
                      %mo →
                    %mo ⊣
                    %mi CoConst
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lim_\to \dashv CoConst)
              we check the natural
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi CoConst
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi lim
                      %mo →
                    %mi F
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_C(F, CoConst S ) \simeq Set(\lim_\to F , S)
              by computing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi PSh
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ,
                            %mi CoConst
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ∈
                                %mi C
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ∈
                                %mi C
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ∈
                                %mi C
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thickmathspace"}
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi S
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    PSh_C(F , CoConst S)
                    \&amp; \simeq
                    \\int_{c \in C} Set(F(c), Set(C(*,c), S))
                    \\\
                    \&amp; \simeq
                    \\int_{c \in C} Set(F(c) \times C(*,c), S)
                    \\\
                    \&amp; \simeq
                    Set( \int^{c \in C} F(c) \times C(*,c) , \; S)
                    \\\
                    \&amp; \simeq Set(F(*), S)
                    \\end{aligned}
                    \\,,
            %p
              Here the first step is the expression of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              = succeed "-calculus," do
                %a.existingWikiWord{:href => "/nlab/show/end"} end
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              sends
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
          %p The formal dual of this statement is the following.
          .num_lemma
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              then
            %ul
              %li
                %p the limit is given by evaluation on this object;
              %li
                %p
                  there is a further
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo ⊣
                          %msub
                            %mi lim
                            %mo →
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (L \dashv \lim_\to)
                %p
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                      %annotation{:encoding => "application/x-tex"} \lim_\to
                  preserves all small limits and in particular all finite products.
          %p In summary we have
          .num_lemma
            %h6#proposition_11 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has both an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              as well as a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              then there is a quadruple of adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mn 0
                    %mo ⊣
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi CoDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi_0 \dashv Disc \dashv \Gamma \dashv CoDisc)
                    \:
                    PSh(C) \to Set
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  is given by evaluation on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \Pi_0
                  is given by evaluation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \emptyset
                  and preserves products.
          %p
            The above interpretation of the cohesiveness encoded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} C = \{\emptyset \to *\}
            still applies to the general case: a general object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \in PSh(C)
            is, by restriction to the unique morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset \to *
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a set-indexed family of sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X(\emptyset \to *) = (\Pi_0(X) = X(\emptyset) \leftarrow  X(*) = \Gamma(X))
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            picks out the total set of points, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            picks of the indexing set (“of cohesive components”). The extra information for general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with initial and terminal object is that for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            these cohesive lumps of points are refined to a hierarchy of lumps and lumps-of-lumps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo →
                  %mi c
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X(\emptyset \to c \to *) = (\Pi_0(X) \leftarrow X(c) \leftarrow \Gamma(X))
                  \\,.
          %h4#Graphs Reflexive directed graphs
          .num_prop
            %h6#proposition_12 Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RDGraph
                  %annotation{:encoding => "application/x-tex"} RDGraph
              of reflexive
              %a.existingWikiWord{:href => "/nlab/show/directed+graphs"} directed graphs
              is a cohesive topos.
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DGraph
                  %annotation{:encoding => "application/x-tex"} DGraph
              of just directed graphs, not necessarily reflexive, is
              %em not
              a cohesive topos.
          %p
            This example was considered in (
            %a{:href => "#LawvereCatsOfSpaces"}> Lawvere, Categories of spaces
            ) as a simple test case for two very similar toposes, one of which is cohesive, the other not.
          %p We spell out some details on the cohesive topos of reflexive directed graphs.
          .num_defn
            %h6#definition_9 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}End(\Delta[1])
              be the one-object category coming from the
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              with three
              %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
              elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Id
                    %mo ,
                    %mi σ
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{Id, \sigma, \tau\}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∘
                        %mi σ
                        %mo =
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma \circ  \sigma = \sigma
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo ∘
                        %mi τ
                        %mo =
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} \tau \circ  \tau = \tau
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo ∘
                        %mi σ
                        %mo =
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} \tau \circ \sigma = \tau
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∘
                        %mi τ
                        %mo =
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma \circ \tau = \sigma
          %p
            A presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} X : C^{op} \to Set
            on this is a
            %em
              reflexive
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
            \: the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\bullet)
            is the set of all edges and vertices regarded as identity edges, the projection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mo =
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  s := X(\sigma) : X \to X
          %p sends each edge to its source and the projection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mo =
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi τ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  t := X(\tau) : X \to X
          %p sends each edge to its target. The identities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∘
                  %mi t
                  %mo =
                  %mi t
                %annotation{:encoding => "application/x-tex"}
                  s \circ t = t
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∘
                  %mi s
                  %mo =
                  %mi s
                %annotation{:encoding => "application/x-tex"}
                  t \circ s = s
          %p express the fact that source and target are identity edges.
          %p
            Equivalently, this is a presheaf on the full
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mo ≤
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ⊂
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta_{\leq [1]} \subset \Delta
            of the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            on the objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mo ≤
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mover
                      %munder
                        %mo ←
                        %mi σ
                      %mo →
                    %mover
                      %mo ←
                      %mi τ
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Delta_{\leq [1]} = ([1] \stackrel{\overset{\tau}{\leftarrow}}{\stackrel{\to}{\underset{\sigma}{\leftarrow}}} [0])
                  \\,.
          %p
            In fact this is the
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}End(\Delta[1])
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splitting the idempotents
          %p In summary this shows that
          .num_prop
            %h6#observation_4 Observation
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RDGraph
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    RDGraph \simeq PSh(\mathbf{B} End(\Delta[1])) \simeq PSh(\Delta_{\leq [1]})
                    \\,.
          %p To see that this presheaf topos is cohesive, notice that the terminal geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Disc
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  (Disc \dashv \Gamma) : Psh(C) \to Set
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                  %mi S
                %annotation{:encoding => "application/x-tex"} Disc S
            is the reflexive directed graph with set of vertices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and no non-identity morphisms and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Gamma X
            is the set of vertices = identity edges.
          %p
            The extra left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo :
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Pi_0 : PSh(C) \to Set
            sends a graph to its set of connected components, the
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of the source and target maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mover
                    %munder
                      %mo →
                      %mi s
                    %mover
                      %mo →
                      %mi t
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %msub
                    %mi Π
                    %mn 0
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X_1 \stackrel{\overset{t}{\to}}{\underset{s}{\to}} X_0 \to \Pi_0 X
                  \\,.
          %p
            Since this is a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
            (by the existence of the unit map
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X([1] \to [0])
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DGraph
                %annotation{:encoding => "application/x-tex"} DGraph
            of all directed graphs: a general coequalizer does not preserve products.
          %p
            And
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CoDisc
                  %mo :
                  %mi Set
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CoDisc : Set \to PSh(C)
            sends a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to the reflexive graph with vertices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and one edge for every ordered pair of vertices (the
            %a.existingWikiWord{:href => "/nlab/show/indiscrete+category"} indiscrete
            or
            %em chaotic
            graph).
          %p
            The canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mi X
                  %mo →
                  %msub
                    %mi Π
                    %mn 0
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi_0 X
            sends each vertex to its connected component. Evidently this is epi, hence in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi RDGraphs
                %annotation{:encoding => "application/x-tex"} RDGraphs
            %em cohesive pieces have points
            \.
          %h4#SimplicialSets Simplicial sets
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} C = \Delta
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            with the trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(\Delta)
            is the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} )
                  %mo =
                %annotation{:encoding => "application/x-tex"} E = PSh(\Delta) =
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
            Notice that reflexive
            %a.existingWikiWord{:href => "/nlab/show/directed+graphs"} directed graphs
            are equivalently
            %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          .num_prop
            %h6#proposition_13 Proposition
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              of simplicial sets is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              in which
              %em
                %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} cohesive pieces have points
              \.
          %p
            We have for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} X \in sSet
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Γ
                      %mo :
                      %mi X
                      %mo ↦
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Gamma : X \mapsto X_0
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mo :
                      %mi X
                      %mo ↦
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi X
                        %mn 0
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Pi_0 : X \mapsto \pi_0(X) = X_0/X_1
                , the set of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} connected components
          %p
            And for
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Disc S
                the constant simplicial set on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Codisc
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Codisc S
                the simplicial set which in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                has the set of
                = succeed "-tuples" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (k+1)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ∈
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} X, Y \in sSet
            are
            = succeed "es," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Y
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_0(Y^X)
            is the set of
            = succeed "-classes" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy"} simplicial homotopy
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of Kan complexes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ho
                    %mi KanCplx
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Y
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ho_{KanCplx}(X,Y) = \Pi_0(Y^X)
                  \\,.
          %h3#OverACohesiveSite Over a cohesive site
          %p
            We discuss here presentations of
            %a.existingWikiWord{:href => "/nlab/show/cohesive+toposes"} cohesive toposes
            as
            %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            over
            %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            equipped with suitable
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/extra+properties"} extra properties
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+sites"} cohesive sites
            = succeed ")" do
              %a.maruku-ref{:href => "#OneCohesiveSite"}
            = succeed "," do
              %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
            %a.existingWikiWord{:href => "/nlab/show/cohesive+sites"} cohesive sites
            with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/trivial+coverage"} trivial coverage
          #PresheavesAdjointQuadrupleOnSiteWithTerminalObject.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
                of
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                over
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                with
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              with
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              (hence with a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
              and for any two
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X,Y \in \mathcal{C}
              their
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \times Y \in \mathcal{C}
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#CategoryOfPresheaves"}> this def.
              ), and the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#CategoryOfSets"}> this Def.
              )
            #eq:PreaheafAdjointQuadruple.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %msub
                                  %mi Π
                                  %mn 0
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi Disc
                                %mphantom
                                  %mi AA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Γ
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi coDisc
                                %mphantom
                                  %mi AA
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, Set]
                    \\array{
                    \\overset{\phantom{AAA} \Pi_0 \phantom{AAA}}{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} Disc \phantom{AA} }{\hookleftarrow}
                    \\\
                    \\overset{\phantom{AAA} \Gamma \phantom{AAA} }{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} coDisc \phantom{AA} }{\hookleftarrow}
                    }
                    Set
            %p such that:
            %ol
              %li
                %p
                  the functor
