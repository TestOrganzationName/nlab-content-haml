                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Π
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \Pi X
            %p Moreover, notice that
            %ol
