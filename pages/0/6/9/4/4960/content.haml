            %h6#proof_13 Proof
            %p
              The existence of the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              means equivalently, (by
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+Categories+and+Toposes#InitialCategoryAndTerminalCategory"} this Example
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#InitialCategoryAndTerminalCategory"}> this def.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
