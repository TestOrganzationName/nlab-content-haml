          %h3#ObjectsWithOnePointPerCohesivePiece Objects with one point per cohesive piece
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
