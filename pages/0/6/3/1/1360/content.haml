              be a
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"}> combinatorial model category
                  \.
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              in the section
              = succeed "," do
                %em
                  %a{:href => "cofibrantly+generated+model+category#PresentationAndGeneration"} Presentation and generation
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
