                        [\Delta^{op}, C]_{proj, S}
                %p
                  constitute a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                  %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
                  constitute a
