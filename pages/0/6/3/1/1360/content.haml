                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Δ
                            %mi op
                          %mo ,
                          %mi C
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi proj
                              %mo ,
                              %mi S
                        %annotation{:encoding => "application/x-tex"} [\Delta^{op}, C]_{proj,S}
                  = succeed "." do
