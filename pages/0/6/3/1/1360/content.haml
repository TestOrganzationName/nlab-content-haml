          #HocolimOverHomotopyConstantSimplicialDiagram.num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \in [\Delta^{op}, C]
              is degreewise
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              and has all structure maps being
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              %a.existingWikiWord{:href => "/nlab/show/coprojections"} coprojections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                    %mo →
                    %mi hocolim
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_i \to hocolim X
              into the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              are
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi const
                    %mspace{:width => "thinmathspace"}
                    %mi hocolim
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to const\,hocolim X
              is a weak equivalence.
          %p
            This appears as
            = succeed "." do
              %a{:href => "#Dugger"} Dugger, prop. 5.4 corollary 5.5
          #LocalizationOfReedyOnSimplicialObjects.num_theorem
            %h6#theorem Theorem
            %p
              The model structures from def.
              %a.maruku-ref{:href => "#LocalizationOfStructureOnSimplicalObjects"}
              have the following properties.
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  in both are precisely those morphisms which become weak equivalences under
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
                  over
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
