          %h2#idea Idea
          %p
            The idea of the following text is to begin with a category of objects presumed
            %a.existingWikiWord{:href => "/nlab/show/undirected+object"} undirected
            and construct from that a supercategory of directed objects, analogous to how
            %a.existingWikiWord{:href => "/nlab/show/Marco+Grandis"} Marco Grandis
            developed
            %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed topological spaces
            out of the usual undirected ones.
          %p
            (Rather different approaches to a notion of “directed object” will exist. See also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+theory"} directed homotopy theory
            and
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+type+theory"} directed homotopy type theory
          %h2#definition_tentative Definition (tentative)
          %p
            Let
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/Trimble+n-category"} Trimble omega-category
            with
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            = succeed "," do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pt
                    %mover
                      %mo →
                      %mi σ
                    %mi I
                    %mover
                      %mo ←
                      %mi τ
                    %mi pt
                  %annotation{:encoding => "application/x-tex"} pt\stackrel{\sigma}{\to}I\stackrel{\tau}{\leftarrow}pt
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "-" do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/undirected+object"} undirected
            (i.e.
            = succeed ")." do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi pt
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [pt,X]\simeq [I,X]
          %p
            Let
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi I
                  %mo ⊂
                  %msub
                    %mrow
                    %mi pt
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi pt
                %annotation{:encoding => "application/x-tex"} d_I \subset {}_{pt}hom(I,I)_{pt}
            be a subset of the set of
            = succeed "-endomorphisms" do
              %a.existingWikiWord{:href => "/nlab/show/co-span"} co-span
            = succeed "." do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pt
                    %mover
                      %mo →
                      %mi σ
                    %mi I
                    %mover
                      %mo ←
                      %mi τ
                    %mi pt
                  %annotation{:encoding => "application/x-tex"} pt\stackrel{\sigma}{\to}I\stackrel{\tau}{\leftarrow}pt
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dX
                  %mo ⊂
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} dX\subset [I,X]
            be a subset of the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            = succeed "." do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I , X]
          %p
            Then we call the pair
            %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi dX
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, dX)
            an
            %em
              object with directed path space
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dX
                  %annotation{:encoding => "application/x-tex"} dX
            (or
            = succeed ")" do
              %em directed object
          %ol
            %li
              %p
                (Constant paths) Every map
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} pt
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} I \to \pt \to X
                is directed;
            %li
              %p
                (Reparametrisation) If
                = succeed "," do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo ∈
                        %msub
                          %mi d
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \gamma\in d_I
                = succeed "," do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ∈
                        %mi dX
                      %annotation{:encoding => "application/x-tex"} \phi \in dX
                = succeed "." do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo ∘
                        %mi ϕ
                        %mo ∈
                        %mi dX
                      %annotation{:encoding => "application/x-tex"} \gamma \circ \phi\in dX
                = succeed "," do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi I
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi I
                        %mo ,
                        %mi I
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} d_I=[I,I]
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi X
                    %annotation{:encoding => "application/x-tex"} d X
                is a sieve in
                = succeed "." do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo{:stretchy => "false"} /
                        %mi C
                      %annotation{:encoding => "application/x-tex"} I/C
            %li
              %p
                (Concatenation) Let
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo :
                      %mi I
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a,b:I\to X
                be
                %em
                  consecutive wrt.
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                (i.e.
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} pt
                      %msup
                        %mo →
                        %mi τ
                      %mi I
                      %msup
                        %mo →
                        %mi a
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \pt \to^{\tau} I \to^{a} X
                equals
                = succeed ")," do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
