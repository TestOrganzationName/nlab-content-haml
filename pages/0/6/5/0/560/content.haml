              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a subcategory of
            = succeed "." do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
