                      %annotation{:encoding => "application/x-tex"} \phi:I^{v2}\to X
                %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                (described there in the section “Intervals for Trimble
                = succeed "-categories\u201D)" do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
