                        %mi I
                        %msup
                          %mo →
                          %mi b
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \pt \to^{\sigma} I \to^{b} X
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi I
                        %mrow
                          %mi v
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} I^{v2}
                denote the pushout of
                %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                and
                = succeed "," do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} \tau
                = succeed "." do
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %msup
