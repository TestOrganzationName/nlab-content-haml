                      %annotation{:encoding => "application/x-tex"} \psi:I\to I^{v2}
                %em
                  composition of
                  %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
