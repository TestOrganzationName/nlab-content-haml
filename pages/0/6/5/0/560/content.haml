                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi:X\to Y
            = succeed ")." do
              %math#mathml_8bf95d3c2674448993e25648d0a96a855a987674_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
