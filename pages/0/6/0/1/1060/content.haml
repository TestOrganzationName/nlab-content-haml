                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
              = succeed "," do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/28/7/28-07abs.html"} TAC
          %p A wide-ranging summary of different model constructions:
          %ul
            %li
          %p
            The fact that a
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %mi B
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ≃
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %msup
                    %mi B
                    %mo *
                %annotation{:encoding => "application/x-tex"} (A \otimes B)^\ast \simeq A^\ast \otimes B^\ast
            is a
            %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
            has a purely
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagrammatic
            proof, but it also follows from the implication (a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇒
                %annotation{:encoding => "application/x-tex"} \implies
            (b) of Theorem 1.3 in this paper:
          %ul
            %li#DP83
              %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"} Dieter Puppe
              = succeed "," do
                %em Duality, Trace and Transfer
              %strong 154
              (1984) 85–103 &amp;lbrack;
              %a{:href => "http://mi.mathnet.ru/tm2435"}> mathnet:tm2435
              ,
              = succeed "," do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/doldpup2.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/doldpup2.pdf"} pdf
          %p
            According to Tobias Fritz (on the
            = succeed "):" do
              %a{:href => "https://categorytheory.zulipchat.com/#narrow/stream/229136-theory.3A-category-theory/topic/From.20*-autonomous.20to.20compact.20closed"} Category Theory Community Server
          %blockquote
            %p
              They apparently didn’t know about
              = succeed "-autonomous" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi.mathscript 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msup
                      %mi B
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathscr{C}(A \otimes B, I) \cong \mathscr{C}(A, B^*)
              only, but they also require the induced morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                    %mo ⊗
                    %msup
                      %mi B
                      %mo *
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A^* \otimes B^* \to (A \otimes B)^*
              to be isomorphisms.
          %p See also:
          %ul
            %li#Barr96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em The Chu construction
                %strong 2
                2 (1996) 17–35 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/volumes/1996/n2/2-02abs.html"}> tac:2-02
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em
                    Topological
                    = succeed "-autonomous" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \ast
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/mack.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-TopologicalStarAutonomous.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em
                    Topological
                    = succeed "-autonomous" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \ast
                %strong 10
                3 (2017) 51–64 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1609.04241"}> arXiv:1609.04241
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Kennison"} John Kennison
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Raphael"} Robert Raphael
                = succeed "," do
                  %em
                    The
                    = succeed "-autonomous" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \ast
                %strong 27
                11 (2012) 222–241 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/volumes/27/11/27-11abs.html"}> tac:27-11
                \&amp;rbrack;
          %p
            With an eye towards apication in
            %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            (to
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of
            %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebras"} vertex operator algebras
            and their
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"}> Jürgen Fuchs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregor+Schaumann"} Gregor Schaumann
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Simon+Wood"} Simon Wood
              %em Grothendieck-Verdier duality in categories of bimodules and weak module functors
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2306.17668"}> arXiv:2306.17668
              \&amp;rbrack;
          %p
            For enriched
            = succeed "-autonomy" do
              %em -autonomous categories, and
            = succeed "," do
