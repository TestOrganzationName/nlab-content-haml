                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %msup
                          %mi Ω
                          %mi op
                      %annotation{:encoding => "application/x-tex"} D = \Omega^{op}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊸
                        %msup
                          %mi Y
                          %mo *
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (X \multimap Y^*)^*
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
            %li
              %p
                Another interesting example is due to Yuri Manin: the category of
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/quadratic+algebra"} quadratic algebra
                %strong quadratic algebra
                over a
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is a graded algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
