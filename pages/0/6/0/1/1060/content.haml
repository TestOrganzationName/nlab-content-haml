                      %annotation{:encoding => "application/x-tex"} (V, R)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V, R) \to (W, S)
                is a linear map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi V
                      %mo →
                      %mi W
                    %annotation{:encoding => "application/x-tex"} f: V \to W
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⊗
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ⊆
                        %mi S
                      %annotation{:encoding => "application/x-tex"} (f \otimes f)(R) \subseteq S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A^*
                of a quadratic algebra given by a pair
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V, R)
                to be that given by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %mo ,
                      %msup
                        %mi R
                        %mo ⊥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V^*, R^\perp)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi R
                        %mo ⊥
                      %mo ⊆
                      %msup
                        %mi V
                        %mo *
                      %mo ⊗
                      %msup
                        %mi V
                        %mo *
                    %annotation{:encoding => "application/x-tex"} R^\perp \subseteq V^* \otimes V^*
                is the kernel of the transpose of the inclusion
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %mi R
                        %mo ⊆
                        %mi V
                        %mo ⊗
                        %mi V
                      %annotation{:encoding => "application/x-tex"} i: R \subseteq V \otimes V
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %msup
                        %mi R
                        %mo ⊥
                      %mo →
                      %msup
                        %mi V
                        %mo *
                      %mo ⊗
                      %msup
                        %mi V
                        %mo *
                      %mover
                        %mo →
                        %mrow
                          %msup
                            %mi i
                            %mo *
                      %msup
                        %mi R
                        %mo *
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \to R^\perp \to V^* \otimes V^* \overset{i^*}{\to} R^* \to 0
              %p Define a tensor product by the formula
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ⊗
                      %mi W
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mn 1
                        %mi V
                      %mo ⊗
                      %mi σ
                      %mo ⊗
                      %msub
                        %mn 1
                        %mi W
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ⊗
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V, R) \otimes (W, S) = (V \otimes W, (1_V \otimes \sigma \otimes 1_W)(R \otimes S))
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo :
                      %mi V
                      %mo ⊗
                      %mi W
                      %mo →
                      %mi W
                      %mo ⊗
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \sigma: V \otimes W \to W \otimes V
                is the symmetry. The unit is the tensor algebra on a 1-dimensional space. The hom that is adjoint to the tensor product is given by the formula
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊸
                        %mi B
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊗
                        %msup
                          %mi B
                          %mo *
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} A \multimap B = (A \otimes B^*)^*
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
            %li
              %p
                In a similar vein, I am told that there is a
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/quadratic+operad"} quadratic operad
            %li
              %p
                Girard’s
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coherence+spaces"} coherence spaces
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/poset-valued+sets"} poset-valued sets
            %li
              %p
                The category of
                %a.existingWikiWord{:href => "/nlab/show/finiteness+spaces"} finiteness spaces
                and their relations is
                = succeed "-autonomous." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/arity+spaces"} arity spaces
            %li
              %p
                Hyland and Ong have given a completeness theorem for multiplicative linear logic in terms of a
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "," do
                  %em fair games
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Chu+construction"} Chu construction
                can be used to form many more examples of
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is a
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                with finite products, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ×
                      %msup
                        %mi V
                        %mi op
                    %annotation{:encoding => "application/x-tex"} V \times V^{op}
                is
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed ")." do
                  %a{:href => "#Barr96"} Barr 1996
            %li
              %p
                Various
                %a.existingWikiWord{:href => "/nlab/show/subcategories"} subcategories
                of Chu constructions are also
                = succeed "-autonomous." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                is the category of
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                over a
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi Vect
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(Vect,k)
                is the category of vector spaces equipped with a specified “dual” having no further structure than an evaluation map
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊗
                        %mi W
                        %mo →
                        %mi k
                      %annotation{:encoding => "application/x-tex"} V\otimes W\to k
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological
                properties of the original space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi V
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,V')
                for an object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi Vect
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(Vect,k)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle v,w \rangle
                the evaluation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                    %annotation{:encoding => "application/x-tex"} w
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi V
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,V')
                is separated if for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ≠
                        %mn 0
                        %mo ∈
                        %mi V
                      %annotation{:encoding => "application/x-tex"} v \neq 0 \in V
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ′
                      %mo ∈
                      %mi V
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} v' \in V'
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo ′
                      %mo{:stretchy => "false"} ⟩
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle v,v' \rangle \neq 0
                and we say that it is extensional if for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ′
                        %mo ≠
                        %mn 0
                        %mo ∈
                        %mi V
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} v' \neq 0 \in V'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} v \in V
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi v
                        %mo ,
                        %mi v
                        %mo ′
                        %mo{:stretchy => "false"} ⟩
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \langle v,v' \rangle \neq 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi chu
                      %mo{:stretchy => "false"} (
                      %mi Vect
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} chu(Vect,k)
                of separated, extensional pairs is
                = succeed "-autonomous." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
                (see there) is a
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dualizing+object"} dualizing object
            %li
              %p
                Suppose
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi C
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mi I
                      %mo ,
                      %mo ⊸
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle C,\otimes, I,\multimap\rangle
                is a closed symmetric monoidal category equipped with a “pre-dualizing object”
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} \bot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⊸
                      %mo ⊥
                      %mo{:stretchy => "false"} )
                      %mo ⊣
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⊸
                      %mo ⊥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-\multimap\bot) \dashv (-\multimap\bot)
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊸
                      %mo ⊥
                      %mo{:stretchy => "false"} )
                      %mo ⊸
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} A \to (A \multimap \bot) \multimap \bot
                is an isomorphism whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is of the form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊸
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} B\multimap\bot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a poset.) Then the category of
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points
                of this adjunction, i.e. the full subcategory of objects of the form
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊸
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} B\multimap\bot
                = succeed "-autonomous." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊸
                      %annotation{:encoding => "application/x-tex"} \multimap
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊸
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ⊸
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊗
                        %mi B
                        %mo ⊸
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (A\multimap (B\multimap \bot)) \cong (A\otimes B\multimap \bot)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ⊸
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                        %mo ⊸
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} (-\multimap\bot)\multimap\bot
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \bot
                since
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊥
                        %mo ≅
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ⊸
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \bot\cong (I\multimap \bot)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊗
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ⊸
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                        %mo ⊸
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} ((A\otimes B)\multimap\bot)\multimap\bot
                %a.existingWikiWord{:href => "/nlab/show/phase+semantics"} phase semantics
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mo ⊥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(C,\bot)
                closed under duality — indeed, it is the intersection of the two embeddings of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
                therein — but its tensor product is
                %em not
                the restriction of the tensor product of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C,\bot)
            %li
              %p
                Phase semantics is also a special case of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/ternary+frame"} ternary frame
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi C
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mi I
                      %mo ,
                      %mo ⊸
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle C,\otimes, I,\multimap\rangle
                has the
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
                structure induced from a
                %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal
                poset. There is also another way to obtain negation in a ternary frame involving a “compatibility relation”…
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
                is a
                %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+category"} semicartesian
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⊗
                      %mi y
                      %mo =
                      %mi max
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \otimes y = \max(x+y-1,0)
                and dualizing object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo *
                      %mo =
                      %mn 1
                      %mo −
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x^\ast = 1-x
                and the dual
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+disjunction"} multiplicative disjunction
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⅋
                        %mi y
                        %mo =
                        %mi min
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi y
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x\parr y = \min(x+y,1)
                %span.newWikiWord
                  Lukasiewicz logic
                  %a{:href => "/nlab/new/Lukasiewicz+logic"} ?
                and is used in
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/fuzzy+logic"} fuzzy logic
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/t-norm"} t-norm
            %li
              %p
                A summary of many different ways to construct examples is in
                = succeed "." do
                  %a{:href => "#HylandSchalk01"} Hyland-Schalk
          %h2#relation_to_other_structures Relation to other structures
          %ul
            %li
              %p
                A
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+category"} linearly distributive category
                with the cotensor product
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⅋
                        %mi y
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mo *
                        %mo ⊗
                        %msup
                          %mi y
                          %mo *
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} x\parr y = (x^* \otimes y^*)^*
                = succeed "-autonomous." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
            %li
              %p
                Since a linearly distributive category is a representable
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/polycategory"} polycategory
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%2A-polycategory"} *-polycategory
            %li
              %p
                As noted above, a
                %a.existingWikiWord{:href => "/nlab/show/compact+closed"} compact closed
                category is a degenerate sort of
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
            %li
              %p
                It is shown in
                %a{:href => "#HH13"} HH13
                that a
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %a.existingWikiWord{:href => "/nlab/show/traced+monoidal+category"} traced
                must be compact closed.
            %li
              %p
                We can weaken the requirement that the canonical morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi A
                      %mo :
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊸
                      %mo ⊥
                      %mo{:stretchy => "false"} )
                      %mo ⊸
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} d_A: A \to (A \multimap \bot) \multimap \bot
                is an isomorphism to the one that it is a monomorphism:
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+%28star%29-autonomous+category"} weak (star)-autonomous category
          %h2#references References
          %p The notion is originally due to:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
