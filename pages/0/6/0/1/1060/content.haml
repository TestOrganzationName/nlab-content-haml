                          %mi op
                        %mo ,
                        %mi Ω
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [X^{op}, \Omega]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
                is a unit for the closed structure. Define a duality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (-)^*
                on sup-lattices, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo *
                      %mo =
                      %msup
                        %mi X
                        %mi op
                    %annotation{:encoding => "application/x-tex"} X^* = X^{op}
                is the opposite poset (inf-lattices are sup-lattices), and where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %msup
                        %mi Y
                        %mo *
                      %mo →
                      %msup
                        %mi X
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*: Y^* \to X^*
                is the left adjoint of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mi op
                        %mo :
                        %msup
                          %mi X
                          %mi op
                        %mo →
                        %msup
                          %mi Y
                          %mi op
