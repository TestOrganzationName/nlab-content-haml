                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    \-Autonomous categories and linear logic
                %strong 1
                2 (1991) 159–178 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0960129500001274"}> doi:10.1017/S0960129500001274
                ,
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/scatll.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-AutomomousCatAndLinLogic.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em Accessible categories and models of linear logic
                %strong 69
                (1990) 219–232 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0022-4049(91)90020-3"} doi:10.1016/0022-4049(91)90020-3
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/accll.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-AccCatLinearLogic.pdf", :title => "pdf"} pdf
          %p and a detailed review (also of a fair bit of plain monoidal category theory) is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul-Andr%C3%A9+Melli%C3%A8s"}> Paul-André Melliès
              ,
              = succeed "," do
                %em Categorial Semantics of Linear Logic
              = succeed "," do
                %em Interactive models of computation and program behaviour
              = succeed ")" do
                %a{:href => "http://www.pps.univ-paris-diderot.fr/~mellies/papers/panorama.pdf"} pdf
          %p Examples from algebraic geometry are given here:
          %ul
            %li
              Mitya Boyarchenko and Vladimir Drinfeld, A duality formalism in the spirit of Grothendieck and Verdier, arXiv:1108.6020 (
              %a{:href => "http://arxiv.org/pdf/1108.6020v2.pdf"}> pdf
              )
          %p
            These authors call any closed monoidal category with a
            %a.existingWikiWord{:href => "/nlab/show/dualizing+object+in+a+closed+category"} dualizing object
            a
            = succeed "," do
              %strong Grothendieck-Verdier category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Verdier+duality"} Verdier duality
          %p
            Here it is explained how
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em Frobenius monads and pseudomonoids
              %strong 45
              (2004) 3930-3948 &amp;lbrack;
              %a{:href => "http://www.math.mq.edu.au/~street/Frob.pdf"}> pdf
              \&amp;rbrack;
          %p Examples using toplogical vector spaces are given here:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %em
                  On
                  = succeed "-autonomous" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
              %strong 41
              4 (2000) 243-254 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/CTGDC_2000__41_4_243_0.pdf"}> numdan:CTGDC_2000__41_4_243_0
              \&amp;rbrack;
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+categories"} linearly distributive categories
          %ul
            %li#CockettSeely99
              %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"}> Robin Cockett
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robert+Seely"} Robert Seely
              %em Linearly distributive functors
              (1999) &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/S0022-4049(98)00110-8"}> doi:10.1016/S0022-4049(98)00110-8
              \&amp;rbrack;
          %p Combination with traces yields compact closure:
          %ul
            %li#HH13
              Tamás Hajgató and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Masahito+Hasegawa"} Masahito Hasegawa
              = succeed "," do
                %em
                  Traced
                  = succeed "-autonomous" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
