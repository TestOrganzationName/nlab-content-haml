              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BFb0064579"} doi:10.1007/BFb0064579
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
