              %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
              of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
