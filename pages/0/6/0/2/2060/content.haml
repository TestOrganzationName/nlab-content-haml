            %p
              The square on the right is a pullback, because the inclusion of the terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi x
                  %annotation{:encoding => "application/x-tex"} 1\to C_{/x}
              is a
              %span.newWikiWord
                right anodyne
                %a{:href => "/nlab/new/right+anodyne"} ?
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi y
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D_{/y} \to D
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} eval
                      %mi x
                    %mo{:stretchy => "false"} ↓
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Fun
                      %mrow
                        %mi Z
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi x
                    %mo →
                    %mi C
                    %mo ,
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi y
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\eval_x \downarrow y) \to Fun_{Z'}(C_{/x} \to C, D_{/y} \to D)
            %p
              is an equivalence of
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %p
            This should be compared with the lax
            %a.existingWikiWord{:href => "/nlab/show/slice+2-category"} slice 2-category
            construction. In fact,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ′
                %annotation{:encoding => "application/x-tex"} Z'
            can be constructed by taking the underlying (∞,1) category of the lax coslice (or colax, depending on convention) over the point of the (∞,2)-category of (∞,1)-categories.
          %h3#RestInfGrpd
            For
            = succeed "-Groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_2 Definition
            %p
              The universal fibration of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn ∞
                        %mi Grpd
                    %mo →
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Z|_{\infty Grpd} \to \infty Grpd^{op}
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              by
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along the inclusion morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \infty Grpd \hookrightarrow (\infty,1)Cat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Z
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %mn ∞
                                %mi Grpd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mn ∞
                            %msup
                              %mi Grpd
                              %mi op
                          %mtd
                            %mo ↪
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi Cat
                              %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Z|_{\infty Grpd} &amp;\longrightarrow&amp; Z
                    \\\
                    \\big\downarrow &amp;&amp; \big\downarrow
                    \\\
                    \\infty Grpd^{op} &amp;\hookrightarrow&amp; (\infty,1)Cat^{op}
                    }
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-functor"} ∞-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn ∞
                        %mi Grpd
                    %mo →
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Z|_{\infty Grpd} \to \infty Grpd^{op}
              is even a
              %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
              and it is the
              = succeed "." do
                %em universal right fibration
              %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              = succeed "." do
                %a{:href => "%28sub%29object+classifier+in+an+%28infinity%2C1%29-topos#ObjectClassifierInInfinityGroupoid"} object classifier – In ∞Grpd
          #UniversalLeftFibration.num_prop
            %h6#proposition_3 Proposition
            %p
              The universal left fibration is the forgetful functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %msub
                        %mi Grpd
                        %mo *
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd_* \to \infty Grpd
          %p
            (
            %a{:href => "#Lurie09"}> Lurie 2009, Prop, 3.3.2.7
            ,
            = succeed "," do
              %a{:href => "#Cisinski19"} Cisinski 2019, Sec. 5.2
            %a.existingWikiWord{:href => "/nlab/show/universal+Kan+fibration"} universal Kan fibration
            see also
            = succeed ")" do
              %a{:href => "#KapulkinLumsdaine12"} Kapulkin &amp; Lumsdaine 2021
          .num_prop
            %h6#proposition_4 Proposition
            %p The following are equivalent:
            %ul
              %li
                %p
                  An
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-functor"} ∞-functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} p : C \to D
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/right+Kan+fibration"} right Kan fibration
              %li
                %p
                  Every functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi p
                        %mo :
                        %mi D
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} S_p : D \to (\infty,1)Cat
                  that classifies
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                  factors through
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Grpd"} ∞-Grpd
              %li
                %p
                  There is a functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi p
                        %mo :
                        %mi D
                        %mo →
                        %mn ∞
                        %mi Grpd
                      %annotation{:encoding => "application/x-tex"} G_p : D \to \infty Grpd
                  that classifies
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  as a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/right+Kan+fibration"} right Kan fibration
          .proof
            %h6#proof_3 Proof
            %p
              This is proposition 3.3.2.5 in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
          %h2#models Models
          %p
            For concretely constructing the relation between
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p : E \to C
            of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"} (∞,1)-categories
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                  %mo :
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} F_p : C \to (\infty,1)Cat
            one may use a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between suitable
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model categories
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} marked simplicial set
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            (i.e. as a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            with certain properties), the two model categories in question are
          %ul
            %li
              %p
                the projective
                %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+simplicial+presheaves"} global model structure on simplicial presheaves
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi SSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C,SSet]
                – this models the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Func
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Cat
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)Func(C,(\infty,1)Cat)
            %li
              %p
                the
                %em covariant model structure
                on the
                %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SSet
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} SSet/C
                – this models the
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between these is established by the
            %span.newWikiWord
              relative nerve
              %a{:href => "/nlab/new/relative+nerve"} ?
            construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi SSet
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N_{-}(C) : [C,SSet] \to SSet/C
                  \\,.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            this functor has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi SSet
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_{-}(C) : SSet/C \to [C,SSet]
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p : E \to C
            a
            %a.existingWikiWord{:href => "/nlab/show/left+Kan+fibration"} left Kan fibration
            the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo →
                  %mi SSet
                %annotation{:encoding => "application/x-tex"} F_p(C) : C \to SSet
            sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi Obj
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c \in Obj(C)
            to the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi E
                  %msub
                    %mo ×
                    %mi C
                  %mo{:stretchy => "false"} {
                  %mi c
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} p^{-1}(c) := E \times_C \{c\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi c
                  %mo ↦
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_p(C) : c \mapsto p^{-1}(c)
                  \\,.
          %p
            (See remark 3.2.5.5 of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+Kan+fibration"} universal Kan fibration
            %li
              %p
                %span.newWikiWord
                  fibration of (∞,1)-categories
                  %a{:href => "/nlab/new/fibration+of+%28%E2%88%9E%2C1%29-categories"} ?
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#Lurie09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , Section 3.3.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
                = succeed "," do
                  %strong 170
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
                = succeed ")" do
                  %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
              %blockquote
                %p (the concrete description in terms of model theory on marked simplicial sets is in section 3.2. A simpler version of this is in section 2.2.1)
            %li#Cisinski19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                , Section 5.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Categories+and+Homotopical+Algebra"} Higher Categories and Homotopical Algebra
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108588737"} doi:10.1017/9781108588737
                = succeed ")" do
                  %a{:href => "http://www.mathematik.uni-regensburg.de/cisinski/CatLR.pdf"} pdf
              %blockquote
                %p (the universal left fibration)
          %p The direct description of the universal fibration is discussed at
          %ul
            %li#direct
              MathOverflow:
              %em
                %a{:href => "https://mathoverflow.net/questions/383275/"} A construction of the universal cocartesian fibration
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/universal+Kan+fibration"} universal Kan fibration
            as a
            %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} categorical semantics
            for a
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalent
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %p
            Discussion of fibrations via
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , chapter 5
              %em
                %a{:href => "https://kerodon.net/tag/01J2"} Fibrations of ∞-Categories
              (2021) in:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kerodon"} Kerodon
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} categorical semantics
            of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids
          %ul
            %li#KapulkinLumsdaine12
              %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
              = succeed "," do
                %em The Simplicial Model of Univalent Foundations (after Voevodsky)
              %strong 23
              (2021) 2071–2126
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1211.2851"} arXiv:1211.2851
              %a{:href => "https://doi.org/10.4171/jems/1050"} doi:10.4171/jems/1050
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/straightening+and+unstraightening"} straightening and unstraightening
            entirely within the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hoang+Kim+Nguyen"} Hoang Kim Nguyen
              %em The universal coCartesian fibration
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2210.08945"}> arXiv:2210.08945
              \&amp;rbrack;
          %p
            which (along the lines of the discussion of the universal left fibration from
            = succeed ")" do
              %a{:href => "#Cisinski19"} Cisinski 2019
            %a.existingWikiWord{:href => "/nlab/show/universal+coCartesian+fibration"} universal coCartesian fibration
            as
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for the
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalent
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+type+theory"} directed homotopy type theory
          %ul
            %li#CisinskiEtAl23
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hoang+Kim+Nguyen"} Hoang Kim Nguyen
              = succeed "," do
                %em Univalent Directed Type Theory
              %em
                %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/index.html"} CMU Homotopy Type Theory Seminar
              (13, 20, 27 Mar 2023) &amp;lbrack;
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/index.html#230313"}> web
              , video 1:
              %a{:href => "https://www.youtube.com/watch?v=5YOltuTcBK8"}> YT
              , 2:
              %a{:href => "https://www.youtube.com/watch?v=xWmELBvHMPo"}> YT
              , 3:
              %a{:href => "https://www.youtube.com/watch?v=P0Cfb4eUJo4"}> YT
              ; slides 0:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-intro_talk1.pdf"}> pdf
              , 1:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk1.pdf"}> pdf
              , 2:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk2.pdf"}> pdf
              , 3:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk3.pdf"}> pdf
              \&amp;rbrack;
          %p
            (see
            %a{:href => "https://youtu.be/P0Cfb4eUJo4?t=4618"} video 3 at 1:16:58
            and
            = succeed ")." do
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk3.pdf#page=33"} slide 3.33
