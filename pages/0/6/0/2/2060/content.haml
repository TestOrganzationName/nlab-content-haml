                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                itself;
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} p : C \to D
                arises as the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                of the universal fibration along an
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi p
                        %mo :
                        %mi D
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %msup
                          %mi Cat
                          %mi op
                      %annotation{:encoding => "application/x-tex"} S_p : D \to (\infty,1)Cat^{op}
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
            and at
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} stuff, structure, property
            that for
            %a.existingWikiWord{:href => "/nlab/show/n-category"} n-categories
            at least for low
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            the corresponding universal object was the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %msub
                    %mi Cat
                    %mo *
                %annotation{:encoding => "application/x-tex"} n Cat_*
            of
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            should at least morally be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Cat
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat_*
          %h2#definition Definition
          %h3#for_categories
            For
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            One description of the universal cartesian fibration is given in section 3.3.2 of
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
            as the contravariant
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            applied to the identity functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} ((\infty,1)Cat^{op})^{op} \to (\infty,1)Cat
          %p We can also give a more direct description:
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Z^{op}
              is equivalent to the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat^{[1]}
              spanned by the morphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mrow
                        %mi x
                        %mo{:stretchy => "false"} /
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C_{x/} \to C]
              for small (∞,1)-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x \in C
            %p
              The universal fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Z \to (\infty,1)Cat^{op}
              is opposite to the target evaluation.
            %p
              Dually, the universal cocartesian fibration is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ′
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Z' \to (\infty,1)Cat
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} Z'
              is the (∞,1)-category of arrows of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi x
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C_{/x} \to C]
          .proof
            %h6#proof Proof
            %p
              This is the proof idea of
              = succeed "." do
                %a{:href => "#direct"} this mathoverflow post
            %p
              By proposition 5.5.3.3 of Higher Topos Theory, there are presentable fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RFib
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} RFib \to (\infty,1)Cat
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi tgt
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat^{[1]} \xrightarrow{tgt} (\infty,1)Cat
              classifying functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ↦
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \mapsto \mathcal{P}(C)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi C
                    %annotation{:encoding => "application/x-tex"} C \mapsto (\infty,1)Cat_{/C}
            %p
              By proposition 5.3.6.2 of Higher Topos Theory, the yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi C
                    %mo →
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j : C \to \mathcal{P}(C)
              is a natural transformation, and the covariant Grothendieck construction provides a cocartesian functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo ′
                      %mo →
                      %mi RFib
                    %annotation{:encoding => "application/x-tex"} Z' \to RFib
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                  %annotation{:encoding => "application/x-tex"} (-)_!
              preserves representable presheaves, we can identify
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} Z'
              with the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RFib
                  %annotation{:encoding => "application/x-tex"} RFib
              consisting of the representable presheaves.
            %p
              The Grothendieck construction provides a fully faithful
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{P}(C) \to
                    (\infty,1)Cat_{/C}
              whose essential image is the right fibrations. The contravariant Grothendieck construction a cartesian functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi RFib
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} RFib \to (\infty,1)Cat^{[1]}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RFib
                  %annotation{:encoding => "application/x-tex"} RFib
              with the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ( \infty,1)Cat^{[1]}
              spanned by right fibrations.
            %p
              By the relationship between the covariant and contravariant Grothendieck constructions, the universal cartesian fibration is classified by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi op
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi Cat
                        %mi op
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} op : ((\infty,1)Cat^{op})^{op} \to (\infty,1)Cat
          .num_remark
            %h6#remark Remark
            %p
              A key point of this description is that for any small (∞,1)-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi x
                  %annotation{:encoding => "application/x-tex"} x \mapsto C_{/x}
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \to y
              acts by composition) is a fully faithful functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi C
                    %annotation{:encoding => "application/x-tex"} C \to (\infty,1)Cat_{/C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi C
                      %mrow
                        %mi x
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} x \mapsto C_{x/}
              is a fully faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi C
                  %annotation{:encoding => "application/x-tex"} C^{op} \to (\infty,1)Cat_{/C}
          %p
            The universal cocartesian fibration can also be viewed as a full
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat^{[1]}
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The hom-categories of the universal cocartesian fibration are given by the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fun
                      %mrow
                        %mi Z
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi x
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi y
