                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  p \colon Z \to (\infty,1)Cat^{op}
          %p
            over the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
            such that
          %ul
            %li
              %p
                its fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^{-1}(C)
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} C \in (\infty,1)Cat
                is just the
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
