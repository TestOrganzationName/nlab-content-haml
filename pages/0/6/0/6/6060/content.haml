                  \\mathbb{Z}
                  \\big)
                  \\\
                  \&amp;
                  \\,\simeq\,
                  \&amp;
                  H^\bullet
                  \\big(
                  ( X^g \sslash C_G(g) )
                  \\;
                  \\,
                  \\mathbb{Z}
                  \\big)
                  \\otimes_{\mathbb{Z}}
                  \\underset{
                  \\mathclap{
                  \\simeq
                  \\left\{
                  \\array{
                  \\mathbb{Z} &amp;\vert&amp; \bullet \in \{0,1\}
                  \\\
                  0 &amp;\vert&amp; else
                  }
                  \\right.
                  }
                  }{
                  \\underbrace{
                  H^\bullet
                  \\big(
                  B \mathbb{Z}
                  ;\,
                  \\mathbb{Z}
                  \\big)
                  }
                  }
                  \\\
                  \&amp;\simeq &amp;
                  H^\bullet
                  \\big(
                  ( X^g \sslash C_G(g) )
                  \\;
                  \\,
                  \\mathbb{Z}
                  \\big)
                  \\,\oplus\,
                  H^{\bullet-1}
                  \\big(
                  ( X^g \sslash C_G(g) )
                  \\;
                  \\,
                  \\mathbb{Z}
                  \\big)
                  \\,,
                  \\end{array}
          %p
            where the second line uses the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %p
            (The following definition becomes a proposition if one uses conceptualization of
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            as laid out in
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/transgression+in+group+cohomology"} transgression in group cohomology
          %p
          #TransgressionOntoFixedLocus.num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi g
