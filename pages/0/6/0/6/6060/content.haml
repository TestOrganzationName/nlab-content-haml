              and each point in the
              %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
