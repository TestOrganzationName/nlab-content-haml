                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Prop}}{\Gamma \vdash A \equiv \mathrm{toProp}_{A}(\mathrm{proptrunc}(A)):\mathrm{Prop}}
          %p
            Extensionality principle for the type of all propositions (i.e.
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/propositional+extensionality"} propositional extensionality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ext
                        %mi{:mathvariant => "normal"} Prop
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi A
                      %msub
                        %mo =
                        %mi{:mathvariant => "normal"} Prop
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ≃
                      %mi B
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Prop} \quad \Gamma \vdash B:\mathrm{Prop}} {\Gamma \vdash \mathrm{ext}_\mathrm{Prop}(A, B):(A =_\mathrm{Prop} B) \simeq (A \simeq B)}
          %h2#predicate_logic Predicate logic
          %p
            In this section, we assume that
            %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            or
            %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            is true for all dependent function types. The
            %a.existingWikiWord{:href => "/nlab/show/predicate+logic"} predicate logic
            can be defined in the type theory purely from the type of all propositions, dependent function types, dependent sum types, and identity types (see
            = succeed ")." do
              %a{:href => "#AngiuliGratzer"} Angiuli &amp; Gratzer
          %h3#the_empty_type_and_falsehood The empty type and falsehood
          %p
            For Russell types of all propositions, the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi P
                %annotation{:encoding => "application/x-tex"} \prod_{P:\mathrm{Prop}} P
            is the
            %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi P
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                      %mi P
                      %mo )
                    %mo :
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \left(\prod_{P:\mathrm{Prop}} P\right):\mathrm{Prop}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{P:\mathrm{Prop}} \mathrm{El}(P)
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi P
                            %mo :
                            %mi{:mathvariant => "normal"} Prop
                        %mi{:mathvariant => "normal"} El
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mi{:mathvariant => "normal"} Prop
                    %mo :
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \left(\prod_{P:\mathrm{Prop}} \mathrm{El}(P)\right)_\mathrm{Prop}:\mathrm{Prop}
          %p
            In either case, the definition implies that if the empty type has an element, then every proposition has an element and is thus contractible. This implies that the empty type represents falsehood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            in the type of all propositions.
          %h3#the_type_of_pointed_propositions_and_truth The type of pointed propositions and truth
          %p
            The type of pointed propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Prop
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}_*
            is given by the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi P
                %annotation{:encoding => "application/x-tex"} \sum_{P:\mathrm{Prop}} P
            for Russell types of propositions and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{P:\mathrm{Prop}} \mathrm{El}(P)
            for Tarski types of propositions, and because pointed propositions are contractible types, pointed propositions are equivalent to each other, and thus by the extensionality principle of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
          %p
            Because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Prop
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}_*
            is itself a proposition,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Prop
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}_*
            is an element of itself, and thus a pointed proposition and a contractible type. This implies that the type of pointed propositions represents
            %a.existingWikiWord{:href => "/nlab/show/truth"} truth
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            in the type of all propositions.
          %h3#propositional_truncations Propositional truncations
          %p
            Given the type of all propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
            and given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            into an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} [A] \equiv \prod_{P:\mathrm{Prop}} (A \to P) \to P
          %p and for Tarski types of all propositions by the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [A] \equiv \prod_{P:\mathrm{Prop}} (A \to \mathrm{El}(P)) \to \mathrm{El}(P)
          %p By weak function extensionality, both of these types are propositions.
          %h3#universal_quantification Universal quantification
          %p
            Given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and family of propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+type"} dependent function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:A} P(x)
            is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:A} P(x)
            is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{x:A} P(x)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+quantifier"} universal quantifier
          %p
            More generally, given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and family of propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(x)
            indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mrow
                    %mo [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \forall x:A.B(x) \equiv \left[\prod_{x:A} B(x)\right]
          %h3#implication_and_negation Implication and negation
          %p
            Given any proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} Q \to P
            is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} A \to P
            is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} Q \to P
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/implication"} implication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the empty type or falsehood defined above, then the function type represents the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi Q
                    %mo ≡
                    %mi Q
                    %mo →
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \neg Q \equiv Q \to \emptyset
          %p
            More generally, given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⇒
                  %mi B
                  %mo ≡
                  %mrow
                    %mo [
                    %mi A
                    %mo →
                    %mi B
                    %mo ]
                %annotation{:encoding => "application/x-tex"} A \implies B \equiv \left[A \to B\right]
          %h3#biconditionals Biconditionals
          %p
            Given any proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ≃
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \simeq Q
            is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ≃
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \simeq Q
            is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≃
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P \simeq Q
          %p
            More generally, given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⇔
                  %mi B
                  %mo ≡
                  %mrow
                    %mo [
                    %mi A
                    %mo ≃
                    %mi B
                    %mo ]
                %annotation{:encoding => "application/x-tex"} A \iff B \equiv \left[A \simeq B\right]
          %h3#existential_quantification Existential quantification
          %p
            Given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and family of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(x)
            indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
