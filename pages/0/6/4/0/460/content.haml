                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{Frame}(\tau_X, \tau_\ast)
                    \&amp;\underoverset{\simeq}{}{\longrightarrow}&amp;
                    IrrClSub(X)
                    \\\
                    \\phi
                    \&amp;\mapsto&amp;
                    X \backslash U_\emptyset(\phi)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_\emptyset(\phi)
              is the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \in \tau_x
              such that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U) = \emptyset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo ∪
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi U
                            %mo ∈
                            %msub
                              %mi τ
                              %mi X
                        %mrow
                          %mrow
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_{\emptyset}(\phi)
                    \\coloneqq
                    \\underset{{U \in \tau_X} \atop {\phi(U) = \emptyset} }{\cup}
                    U
                    \\,.
          %p
            See also (
            %a.existingWikiWord{:href => "/nlab/show/Stone+Spaces"}> Johnstone 82, II 1.3
            ).
          .proof
            %h6#proof Proof
            %p
              First we need to show that the function is well defined in that given a frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \phi \colon \tau_X \to \tau_\ast
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \backslash U_\emptyset(\phi)
              is indeed an irreducible closed subspace.
            %p To that end observe that:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              %em
                If there are two elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ∈
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \tau_X
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U_{\emptyset}(\phi)
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                        %mo ⊂
                        %msub
                          %mi U
                          %mi ∅
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi ∅
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi(U_1) \cap \phi(U_2)
                    \&amp; =
                    \\phi(U_1 \cap U_2)
                    \\\
                    \&amp; \subset \phi(U_{\emptyset}(\phi))
                    \\\
                    \&amp; =
                    \\emptyset
                    \\end{aligned}
                    \\,,
            %p
              where the first equality holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves finite intersections by def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              respects inclusions by remark
              = succeed "," do
                %a.maruku-ref{:href => "#PreservationOfInclusionsByFrameHomomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves arbitrary unions by def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi ∅
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tau_\ast = \{\emptyset, \{1\}\}
              the intersection of two open subsets is empty precisely if at least one of them is empty, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \phi(U_1) = \emptyset
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U_2) = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p
              Now according to
              = succeed "," do
                %a{:href => "irreducible+closed+subspace#OpenSubsetVersionOfClosedIrreducible"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \backslash U_{\emptyset}(\phi)
              as an
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible closed subspace
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Conversely, given an irreducible closed subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo \
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X \backslash U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi U
                              %mo ⊂
                              %msub
                                %mi U
                                %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    U
                    \\mapsto
                    \\left\{
                    \\array{
                    \\emptyset &amp; \vert \, \text{if} \, U \subset U_0
                    \\\
                    \\{1\} &amp; \vert \, \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p This does preserve
            %ol
              %li
                %p arbitrary unions
                %p
                  because
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi ∅
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(\underset{i}{\cup} U_i) = \{\emptyset\}
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \underset{i}{\cup}U_i \subset U_0
                  which is the case precisely if all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_i \subset U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_i) = \emptyset
                  and because
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mi i
                          %mi ∅
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \underset{i}{\cup}\emptyset = \emptyset
                %p
                  while
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(\underset{i}{\cup}U_1) = \{1\}
                  as soon as one of the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  is not contained in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(U_i) = \{1\}
                  which means that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mi i
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \underset{i}{\cup} \phi(U_i) = \{1\}
              %li
                %p finite intersections
                %p
                  because if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 1
                          %mo ∩
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\ast)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∈
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_1 \in U_0
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 2
                          %mo ∈
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_2 \in U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_1) = \emptyset
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \phi(U_2) = \emptyset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_1 \cap U_2) = \emptyset
                  also
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \phi(U_1) \cap \phi(U_2) = \emptyset
                %p
                  while if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} U_1 \cap U_2
                  is not contained in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_0
                  then neither
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} U_1
                  nor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} U_2
                  is contained in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_0
                  and hence with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(U_1 \cap U_2) = \{1\}
                  also
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                          %mo ∩
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \phi(U_1) \cap \phi(U_2) = \{1\} \cap \{1\} = \{1\}
            %p
              Hence this is indeed a frame homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                      %mo →
                      %msub
                        %mi τ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \tau_X \to \tau_\ast
            %p Finally, it is clear that these two operations are inverse to each other.
          #ProofOfFrameMorphismsBetweenOpensOfSoberSpaces.proof
            %h6#proof_2 Proof
            %p
              of prop.
              %a.maruku-ref{:href => "#FrameMorphismsBetweenOpensOfSoberSpaces"}
            %p We first consider the special case of frame homomorphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\ast \longleftarrow \tau_X \;\colon\; \phi
            %p
              and show that these are in bijection to the underlying set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
