                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mrow
                              %mo (
                              %munder
                                %mo ∩
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mo ∈
                            %mover
                              %mrow
                                %munder
                                  %mo ∩
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msub
                                  %mi U
                                  %mi i
                              %mo ˜
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p \in \underset{i \in I}{\cap} \widetilde{U_i} \;
                    \&amp; \Leftrightarrow
                    \\underset{i \in I}{\forall} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow \underset{i \in I}{\cap} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p\left(\underset{i \in I}{\cap} U_i\right) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p \in \widetilde{ \underset{i \in I}{\cap} U_i }
                    \\end{aligned}
                    \\,,
            %p
              where now we used that the frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              preserves finite intersections.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
