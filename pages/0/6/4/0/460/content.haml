                              %mo ˜
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∀
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∩
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
