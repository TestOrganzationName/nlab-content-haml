                      %mo *
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ast \to (X,\tau)
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \phi \colon \tau_X \to \tau_\ast
              are identified with the irreducible closed subspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \backslash U_\emptyset(\phi)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sobriety
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              there is a unique point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo \
                      %msub
                        %mi U
                        %mi ∅
                      %mo =
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \backslash U_{\emptyset} = Cl(\{x\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              an open neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              is not a subset of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_\emptyset(\phi)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \phi(U_x) = \{1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi x
                              %mo ∈
                              %mi U
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    U \mapsto
                    \\left\{
                    \\array{
                    \\{1\} &amp; \vert \,\text{if}\, x \in U
                    \\\
                    \\emptyset &amp; \vert \, \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              This is precisely the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              function of the continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to X
              which sends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ↦
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1 \mapsto x
            %p
              Hence this establishes the bijection between frame homomorphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_\ast \longleftarrow \tau_X
              and continuous functions of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ast \to (X,\tau)
            %p
              With this it follows that a general frame homomorphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mover
                      %mo ⟵
                      %mi ϕ
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_X \overset{\phi}{\longleftarrow} \tau_Y
              defines a function of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overset{f}{\longrightarrow} Y
              by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mo *
                            %mo ←
                            %msub
                              %mi τ
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mo *
                            %mo ←
                            %msub
                              %mi τ
                              %mi X
                            %mover
                              %mo ⟵
                              %mi ϕ
                            %msub
                              %mi τ
                              %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{f}{\longrightarrow}&amp; Y
                    \\\
                    (\tau_\ast \leftarrow \tau_X)
                    \&amp;\mapsto&amp;
                    (\tau_\ast \leftarrow \tau_X \overset{\phi}{\longleftarrow} \tau_Y)
                    }
                    \\,.
            %p
              By the previous analysis, an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Y
                    %mo ∈
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} U_Y \in \tau_Y
              is sent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1\}
              under this composite precisely if the corresponding point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \ast \to X \overset{f}{\longrightarrow} Y
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} U_Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi X
                      %mo ∈
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} U_X \in \tau_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \phi(U_Y) \in \tau_X
              is precisely that subset of points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which are sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} U_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi = f^{-1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              function of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by definition sends open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to open subsets of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is indeed a continuous function. This proves the claim in generality.
          %h3#Reflection Sobrification reflection
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of sober spaces is
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
            in the category of all topological spaces; the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            is called the
            = succeed "," do
              %strong sobrification
            = succeed "." do
              %strong soberification
          %p
            This reflection is also induced by the
            %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
            between spaces and
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of sober spaces is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locales+with+enough+points"} locales with enough points
          %p We now say this in detail.
          %p
            Recall again the
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msub
                      %mi τ
                      %mo *
                    %mo =
                    %mrow
                      %mo {
                      %mi ∅
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ast \coloneqq ( \{1\}, \tau_\ast = \left\{ \emptyset, \{1\}\right\} )
          #SoberificationConstruction.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S X
              to be the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi Frame
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S X \coloneqq Hom_{Frame}( \tau_X, \tau_\ast )
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from the
              %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} frame of opens
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to that of the point. Define a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
