                    \\\
                    \&amp; \Leftrightarrow p\left(\underset{i \in I}{\cup} U_i\right) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p \in \widetilde{ \underset{i \in I}{\cup} U_i }
                    \\end{aligned}
                    \\,,
            %p
              where we used that the frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
