                                %mi S
                                %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (X, \tau_X) &amp;\overset{f}{\longrightarrow}&amp; (Y, \tau^{sob}_Y)
                    \\\
                    {}^{\mathllap{s_X}}\downarrow &amp; \nearrow&amp; \downarrow^{\mathrlap{s_{S X}}}
                    \\\
                    (S X, \tau_{S X})
                    \&amp;\underset{S f}{\longrightarrow}&amp;
                    (S S X, \tau_{S S X})
                    }
                    \\,.
            %p
              By Lemma
              %a.maruku-ref{:href => "#SoberificationIsIndeedSober"}
              and Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#UnitIntoSXDetectsT0AndSoberity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mi S
                        %mi X
                  %annotation{:encoding => "application/x-tex"} s_{S X}
              is an isomorphism (a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
            %p
              To see that this factorization is unique, consider two factorizations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mover
                      %mi f
                      %mo ¯
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msubsup
                      %mi τ
                      %mi Y
                      %mi sob
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde f, \overline{f} \colon \colon (S X, \tau_{S X}) \to (Y, \tau_Y^{sob})
              and apply the sobrification construction once more to the triangles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
