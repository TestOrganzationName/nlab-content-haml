          #ProofOfSoberificationConstructionWellDefined.proof
            %h6#proof_3 Proof
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
