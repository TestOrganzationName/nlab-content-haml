              and the
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \tau_\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Frame
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mo *
                            %mo{:stretchy => "false"} )
