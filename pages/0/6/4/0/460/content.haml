                                %mi S
                                %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (X, \tau_X) &amp;\overset{f}{\longrightarrow}&amp; (Y, \tau_Y^{sob})
                    \\\
                    {}^{\mathllap{s_X}}\downarrow &amp; \nearrow_{ \tilde f, \overline{f}}
                    \\\
                    (S X , \tau_{S X})
                    }
                    \\phantom{AAA}
                    \\mapsto
                    \\phantom{AAA}
                    \\array{
                    (S X, \tau_{S X}) &amp;\overset{S f}{\longrightarrow}&amp; (Y, \tau_Y^{sob})
                    \\\
                    {}^{\simeq}\downarrow &amp; \nearrow_{ \tilde f, \overline{f}}
                    \\\
                    (S X , \tau_{S X})
                    }
                    \\,.
            %p
              Here on the right we used again lemma
              %a.maruku-ref{:href => "#UnitIntoSXDetectsT0AndSoberity"}
              to find that the vertical morphism is an isomorphism, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{f}
              do not change under sobrification, as they already map between sober spaces. But now that the left vertical morphism is an isomorphism, the commutativity of this triangle for both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{f}
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo =
                      %mover
                        %mi f
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \tilde f = \overline{f}
          %h3#enough_points Enough points
          %p
            A topological space has enough points in the sense of def.
            %a.maruku-ref{:href => "#EnoughPointsOfATopologicalSpace"}
            if and only if its
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            quotient is sober. The category of topological spaces with enough points is a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of the category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of all topological spaces, and a topological space is
            %a.existingWikiWord{:href => "/nlab/show/T0"} T0
            iff this reflection is sober.
          %h2#examples_and_nonexamples Examples and Non-examples
          %ul
            %li
              %p
                With
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
                is sober, but this can fail
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructively
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Hausdorff+implies+sober"} Hausdorff implies sober
              %p#NonComparisonToT1
                Since the Hausdorff condition implies the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separation axiom
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classically
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                of the
                %a.existingWikiWord{:href => "/nlab/show/classes"} classes
                of
                = succeed "-topological" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
              %ul
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                    is sober, but not
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi T
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} T_1
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/cofinite+topology"} cofinite topology
                    on a non-
                    %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                    is
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T_1
                    but not sober.
            %li
              %p
                The topological space underlying any
                %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
                is sober. See at
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"} schemes are sober
          %p
            Further examples of spaces that are
            %em not
            sober includes the following:
          %ul
            %li
              Any nontrivial
              %a.existingWikiWord{:href => "/nlab/show/indiscrete+space"} indiscrete space
              is not sober, since it is not
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} T_0
          %p More interestingly:
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} R^2
              with the
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              but not sober, since every subvariety is an irreducible closed set which is not the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} closure
              of a point. Its sobrification is, unsurprisingly, the
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(R[x,y])
          %p
            The following non-example shows that sobriety is not a hereditary separation property, i.e.,
            %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topological subspaces
            of sober spaces need not be sober:
          %ul
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/Alexandroff+topology"} Alexandroff topology
              on a
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              is also not, in general, sober. For instance, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the infinite binary tree (the set of finite
              = succeed "-words" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/lists"} lists
              = succeed "," do
                %span.newWikiWord
                  Wilson space
                  %a{:href => "/nlab/new/Wilson+space"} ?
              = succeed "-words" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/streams"} streams
              %a.existingWikiWord{:href => "/nlab/show/filters"} filters
              on the poset as its points.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/nice+topological+space"} nice topological space
            %li
              %a.existingWikiWord{:href => "/nlab/show/sober+measurable+space"} sober measurable space
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cauchy-complete+category"} Cauchy-complete category
            %li
              %a.existingWikiWord{:href => "/nlab/show/sober+sigma-topological+space"} sober sigma-topological space
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , volume 3, section 1.9 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
            %li#Johnstone82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                , section II.1, from II.1 on in
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stone+Spaces"} Stone Spaces
                = succeed "," do
                  %strong 3
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=698074"} MR85f:54002
            %li#MacLaneMoerdijk
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
            %li
              %p
                Sober spaces in the
                = succeed "." do
                  %a{:href => "http://topology.jdabbs.com/properties/73"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi π
                        %annotation{:encoding => "application/x-tex"} \pi
                    \-base
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            of
            %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            which makes the
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
            of
            %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
            a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            to the sober-restriction of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %ul
            %li#SterlingKapulkin23
              %a.existingWikiWord{:href => "/nlab/show/Sterling+Ebel"}> Sterling Ebel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"} Chris Kapulkin
              %em Synthetic approach to the Quillen model structure on topological spaces
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2310.14235"}> arXiv:2310.14235
              \&amp;rbrack;
