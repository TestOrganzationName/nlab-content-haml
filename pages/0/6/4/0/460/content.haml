          #UnitIntoSXDetectsT0AndSoberity.num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s_X \colon X \to S X
              from def.
              %a.maruku-ref{:href => "#SoberificationConstruction"}
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/injection"} injection
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} T0
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is sober.
                %p
                  In this case
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi X
                      %annotation{:encoding => "application/x-tex"} s_X
                  is in fact a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
          .proof
            %h6#proof_4 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
              there is an identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo ≃
                    %mi IrrClSub
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S X \simeq IrrClSub(X)
              and via this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                  %annotation{:encoding => "application/x-tex"} s_X
              is identified with the map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \mapsto Cl(\{x\})
            %p
              Hence the second statement follows by definition, and the first statement by
              = succeed "." do
                %a{:href => "separation+axioms#T0InTermsOfClosureOfPoints"} this prop.
            %p
              That in the second case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                  %annotation{:encoding => "application/x-tex"} s_X
              is in fact a homeomorphism follows from the definition of the opens
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              in this case (…expand…).
          #SoberificationIsIndeedSober.num_lemma
            %h6#lemma_4 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S X, \tau_{S X})
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#SoberificationConstruction"}
              %a.maruku-ref{:href => "#SoberificationConstructionWellDefined"}
              is sober.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Johnstone82"} Johnstone 82, lemma II 1.7
          .proof
            %h6#proof_5 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo \
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} S X \backslash \tilde U
              be an
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible closed subspace
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mrow
                          %mi S
                          %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S X, \tau_{S X})
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of a unique element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %mi S
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi \in S X
            %p
              Observe first that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \backslash U
              is irreducible.
            %p
              To see this use
              = succeed "," do
                %a{:href => "irreducible+closed+subspace#OpenSubsetVersionOfClosedIrreducible"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \backslash U
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi U
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 1
                      %mo ⊂
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mi or
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U \Rightarrow (U_1 \subset U) or (U_2 \subset U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U
              then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo ∩
                    %msub
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo ⊂
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde U_1 \cap \tilde U_2 \subset \tilde U
              (as in the
              %a{:href => "#ProofOfSoberificationConstructionWellDefined"} proof
              of lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#SoberificationConstructionWellDefined"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde U
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo ⊂
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde U_1 \subset \tilde U
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi U
                          %mo{:stretchy => "false"} ˜
                        %mn 2
                      %mo ⊂
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde U_2 \subset \tilde U
              %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
              this in turn implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1 \subset U
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U_2 \subset U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \backslash U
              is irreducible .
            %p
              By lemma
              %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
              this irreducible closed subspace corresponds to a point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi S
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p \in S X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p \colon \tau_X \to \tau_\ast
              takes the value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              on all those opens which are inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of this point is just
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mi X
                      %mo \
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} S X \backslash \tilde U
            %p
              This shows that there exists at least one point of which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} X \backslash \tilde U
              is the topological closure. It remains to see that there is no other such point.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo ≠
                    %msub
                      %mi p
                      %mn 2
                    %mo ∈
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p_1 \neq p_2 \in S X
              be two distinct points. This means that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} U \in \tau_X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %msub
                        %mi p
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_1(U) \neq p_2(U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde U
              contains one of the two points, but not the other. This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S X, \tau_{S X})
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} T0
              %a{:href => "separation+axioms#T0InTermsOfClosureOfPoints"} this prop.
              this is equivalent to there being no two points with the same topological closure.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msubsup
                      %mi τ
                      %mi Y
                      %mi sob
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y^{sob})
              a sober topological space, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \longrightarrow (Y, \tau_Y)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_X \colon (X, \tau_X) \longrightarrow(S X, \tau_{S X})
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#SoberificationConstruction"}
              %a.maruku-ref{:href => "#SoberificationConstructionWellDefined"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %msubsup
                              %mi τ
                              %mi Y
                              %mi sob
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi s
                                    %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %mo ∃
                                %mo !
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mrow
                                %mi S
                                %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (X, \tau_X) &amp;\overset{f}{\longrightarrow}&amp; (Y, \tau_Y^{sob})
                    \\\
                    {}^{\mathllap{s_X}}\downarrow &amp; \nearrow_{\exists !}
                    \\\
                    (S X , \tau_{S X})
                    }
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By the construction in def.
              = succeed "," do
                %a.maruku-ref{:href => "#SoberificationConstruction"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %msubsup
                              %mi τ
                              %mi Y
                              %mi sob
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
