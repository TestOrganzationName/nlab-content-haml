          #EquivariantWhiteheadAndElmendorfTheorem.num_theorem
            %h6#theorem Theorem
            %p
              %strong (Elmendorf’s theorem)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy categories
              of all three
              %a.existingWikiWord{:href => "/nlab/show/homotopical+categories"} homotopical categories
              in def.
              %a.maruku-ref{:href => "#HomotopicalStructures"}
              are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
