          %h2#in_topological_spaces In topological spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
          %h3#homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Homotopy
          #GSpace.num_defn
            %h6#definition Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
              is a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              equipped with a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} I = \mathbb{R}
            be the
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mover
                    %mo →
                    %mn 0
                  %mi I
                  %mover
                    %mo ←
                    %mn 1
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ({*} \stackrel{0}{\to} I \stackrel{1}{\leftarrow} {*})
            regarded as a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
