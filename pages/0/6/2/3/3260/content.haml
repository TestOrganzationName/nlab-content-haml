                    %mi G
                    %msub
                      %mi Top
                      %mi loc
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Orb
