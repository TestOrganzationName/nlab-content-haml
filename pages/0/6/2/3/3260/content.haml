                  %a{:href => "https://homepages.warwick.ac.uk/~maaac/segal.html"} web
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Segal-EquivariantHT.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (on equivariant
                  %a.existingWikiWord{:href => "/nlab/show/iterated+loop+spaces"} iterated loop spaces
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            %li#Waner80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Waner"}> Stefan Waner
                ,
                = succeed "," do
                  %em Equivariant Homotopy Theory and Milnor’s Theorem
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/1998061"} JSTOR
          %p
            Specifically with an eye towards equivariant
            %a.existingWikiWord{:href => "/nlab/show/differential+topology"} differential topology
            (such as
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+construction"} Pontryagin-Thom construction
            for
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
          %ul
            %li#Wasserman69
              %a.existingWikiWord{:href => "/nlab/show/Arthur+Wasserman"}> Arthur Wasserman
              ,
              = succeed "," do
                %em Equivariant differential topology
              = succeed ")" do
                %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/wasserman.pdf"} pdf
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
            is in
          %ul
            %li#Rezk14
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Global+Homotopy+Theory+and+Cohesion"} Global Homotopy Theory and Cohesion
              (2014)
          %p
            Discussion via
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is in
          %ul
            %li#Shulman15
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em Univalence for inverse EI diagrams
              (
              %a{:href => "http://arxiv.org/abs/1508.02410"}> arXiv:1508.02410
              )
          %p
            An alternative
            = succeed "-structure:" do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
          %ul
            %li
              Mehmet Akif Erdal, Aslı Güçlükan İlhan,
              %em A model structure via orbit spaces for equivariant homotopy
              (
              %a{:href => "https://arxiv.org/abs/1903.03152"}> arXiv:1903.03152
              )
        .revisedby
