          %p
            Now a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi lim
                      %mi Φ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \lim^\Phi S
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msup
                    %mi lim
                    %mi Φ
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi 𝔻
                  %mo ,
                  %mi 𝔽
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi Φ
                  %mo ,
                  %mi 𝔸
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{A}(A, {\lim}^\Phi S) \cong [\mathbb{D},\mathbb{F}](\Phi, \mathbb{A}(A,S))
          %p
            One can prove (by an easy characterization of the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi lim
                      %mi Φ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \lim^\Phi S
              is a
              %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
              in the 2-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒜
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}_\lambda
            %li
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ∈
                      %msub
                        %mi Φ
                        %mi τ
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w \in \Phi_\tau(D)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi D
                      %mi w
                    %mo :
                    %msup
                      %mi lim
                      %mi Φ
                    %mi S
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_D^w : \lim^\Phi S \to S(D)
              is tight,
            %li
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mi A
                      %mo →
                      %msup
                        %mi lim
                        %mi Φ
                      %mi S
                    %annotation{:encoding => "application/x-tex"} h:A \to \lim^\Phi S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is tight as soon as for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ∈
                      %msub
                        %mi Φ
                        %mi τ
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w \in \Phi_\tau(D)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi D
                      %mi w
                    %mi h
                  %annotation{:encoding => "application/x-tex"} p_D^w h
              is tight.
          %p
            The third condition is succinctly expressed by saying the family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi p
                    %mi D
                    %mi w
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi D
                      %mo ∈
                      %mi 𝔻
                      %mo ,
                      %mi w
                      %mo ∈
                      %msub
                        %mi Φ
                        %mi τ
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{p_D^w\}_{D \in \mathbb{D}, w \in \Phi_\tau(D)}
            = succeed "." do
              %strong jointly detects tightness
          %p
            This characterization of
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
            = succeed ")." do
              %a{:href => "#LS"} LS
          %h2#properties_of_
            Properties of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
          %p
            As mentioned above, the
            %a.existingWikiWord{:href => "/nlab/show/base+of+enrichment"} base of enrichment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            is well behaved. For instance, it is
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed"} cartesian closed
            and
            %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} locally finitely presentable
            (hence
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            and
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            = succeed ";" do
              %a{:href => "#LS"} Lack and Shulman
          %p
          .num_prop
            %h6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is locally finitely presentable.
          %p
          .proof
            %h6 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ𝔸𝕋
                      %mo →
                  %annotation{:encoding => "application/x-tex"} \mathbb{CAT}^\to
              is locally finitely presentable, to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is locally finitely presentable, it suffices by Theorem 1.39 of
              %a.existingWikiWord{:href => "/nlab/show/Locally+Presentable+and+Accessible+Categories"} Locally Presentable and Accessible Categories
              to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is a
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+subcategory+problem"} finite orthogonality class
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ𝔸𝕋
                        %mo →
                    %annotation{:encoding => "application/x-tex"} \mathbb{CAT}^\to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} m \colon X \to Y
              is orthogonal in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} e \colon A \to B
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is orthogonal, as an object in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ
                        %mo →
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}^\to
              %svg{:height => "90.064pt", :version => "1.2", :viewbox => "0 0 113.226 90.064", :width => "113.226pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
                %defs
                  %g
                    %symbol{:id => "k6HVW1fT47V0KZnUZhOdYqxDnzo=-glyph0-0", :overflow => "visible"}
