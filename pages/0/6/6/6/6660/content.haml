                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
            %a.existingWikiWord{:href => "/nlab/show/created+limit"} created
            by the forgetful functors from the various
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
