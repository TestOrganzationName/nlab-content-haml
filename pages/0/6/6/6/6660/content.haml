                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            \-weighted limits
          %p
            The general machinery of
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            theory applied to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            gives us a notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
            %em diagram
            in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
          %p
