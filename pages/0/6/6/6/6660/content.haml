                      %mi λ
                    %mo →
                    %msub
                      %mi ℬ
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} F_\lambda:\mathcal{A}_\lambda \to \mathcal{B}_\lambda
              sends tight 1-cells to tight 1-cells, i.e. such that it co/restrcts to a 2-functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi τ
                      %mo :
