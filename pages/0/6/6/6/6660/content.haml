                        %mi τ
                    %annotation{:encoding => "application/x-tex"} F_\tau:\mathcal{A}_\tau \to \mathcal{B}_\tau
          %p
          .num_defn
            %h6 Definition
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
                \-natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
