          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            denote the category whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+embeddings"} full embeddings
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            that are
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functors"} fully faithful
            and injective on objects, and whose
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are
            %a.existingWikiWord{:href => "/nlab/show/commutative+squares"} commutative squares
            (a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
