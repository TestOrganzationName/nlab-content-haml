                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} K(x,y)\in \mathcal{F}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %msub
