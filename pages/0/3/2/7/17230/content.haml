          %p
            (cf.
            = succeed "," do
              %a{:href => "#HenneauxTeitelboim92"} Henneaux &amp; Teitelboim 1992 (15.25)
            = succeed ")." do
              %a{:href => "#Rejzner16"} Rejzner 2016 Rem. 7.7
          %p
            If one can arrange or imagine that the
            %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
            of
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            are given by a
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            against an
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponentiated
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
