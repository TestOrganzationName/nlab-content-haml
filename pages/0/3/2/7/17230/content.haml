          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            the
            %em Schwinger-Dyson equation
            (named after
            = succeed "," do
              %a{:href => "#Dyson49"} Dyson 1949
            = succeed ")" do
              %a{:href => "#Schinger51"} Schwinger 1951
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
            of the
            %a.existingWikiWord{:href => "/nlab/show/functional+derivative"} functional derivative
            of the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            for a
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            and another
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with the
            %a.existingWikiWord{:href => "/nlab/show/time+ordered+product"} time ordering
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/functional+derivative"} functional derivative
            of just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself, times
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mi ℏ
                %annotation{:encoding => "application/x-tex"} i \hbar
            (
            %a.existingWikiWord{:href => "/nlab/show/imaginary+unit"} imaginary unit
            times
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
          #eq:EquationSchwingerDyson.maruku-equation
