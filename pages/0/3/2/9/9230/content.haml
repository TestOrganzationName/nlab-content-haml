            a
            %a.existingWikiWord{:href => "/nlab/show/Gaussian+probability+measure"} Gaussian probability measure
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi I
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi μ
                    %mi S
                %annotation{:encoding => "application/x-tex"} \exp(-I)\mu_S
            a perturbation with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial
            at least of degree 3, there is a combinatorial expression for the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/moments"} moments
            %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi I
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi μ
                    %mi S
                %annotation{:encoding => "application/x-tex"} \exp(-I)\mu_S
            as a sum over certain
            %a.existingWikiWord{:href => "/nlab/show/graphs"} graphs
            whose
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} I = 0
            it reduces to
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Wick%27s+lemma"} Wick's lemma
          %p
            These graphs are called
