                    %mi S
                %annotation{:encoding => "application/x-tex"} \mu_S
            is the exponentiated
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            and hence the
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+fields"} free fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(I)
            is the
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            part of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            monomials in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            encode an interaction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
