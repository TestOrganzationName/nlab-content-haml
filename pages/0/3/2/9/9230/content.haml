                  \\int_0^\tau (\dot X^2 - m^2)
                  \\end{aligned}
                  \\,.
          %p
            This now happens to be the standard
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (
            %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"}> Polyakov action
            ) for a
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            describing the propagation of a particle along its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            may be thought of as coming from the
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            of a scalar particle along its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/worldline+formalism"} worldline formalism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/second+quantization"} second quantization
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            in terms of that of their particle “quanta” running along
            %a.existingWikiWord{:href => "/nlab/show/worldlines"} worldlines
            of the form of the corresponding Feynman diagrams (to which we finally come in a moment).
          %p
            Back to the computation of the
            = succeed "-point" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
