                        %mn 1
                        %mrow
                          %mi k
                          %mo !
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mi ℏ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi k
                      %mi T
                      %mo{:stretchy => "false"} (
                      %munder
                        %munder
                          %mrow
                            %msub
                              %mi S
                              %mi int
