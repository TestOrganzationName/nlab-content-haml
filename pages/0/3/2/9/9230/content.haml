            %a.existingWikiWord{:href => "/nlab/show/edge"} edge
            (a “
            %a.existingWikiWord{:href => "/nlab/show/worldline"}> worldline
            ”) from
            %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
