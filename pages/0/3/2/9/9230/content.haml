            %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
            of the
            %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            %a.existingWikiWord{:href => "/nlab/show/variable"} variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
