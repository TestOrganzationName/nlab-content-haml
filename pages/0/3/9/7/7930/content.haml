          .num_remark
            %h6#remark_6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              immediately implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}\}
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
              (see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/SL%282%2CH%29"} SL(2,H)
              for the definition in the quaternionic case) to the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              in the given dimension:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dim
                      %mrow
                        %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SL(2,\mathbb{K})
                    \\hookrightarrow
                    Spin(dim_{\mathbb{R}(\mathbb{K} )} +1 ,1)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi A
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto A(-)A^\dagger
                    \\,.
            %p
              This preserves the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi A
                      %mo †
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %munder
                        %mrow
                          %mi det
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo =
                        %mn 1
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %munder
                        %munder
                          %mrow
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mo ⏟
                        %mrow
                          %mo =
                          %mn 1
                      %mo *
                    %mo =
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    det(A(-)A^\dagger) = \underset{=1}{\underbrace{det(A)}} det(-) \underset{= 1}{\underbrace{det(A)}}^\ast = det(-)
                    \\,.
          %p
            Hence it remains to show that this is surjective, and to define this action also for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            being the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
            does not apply, due to non-associativity.
          #CliffordAlgebraInTermsOfNormedDivisionAlgebra.num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Define a real
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⟶
                    %msub
                      %mi End
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝕂
                      %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma
                    \\;\colon\;
                    \\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}
                    \\longrightarrow
                    End_{\mathbb{R}}(\mathbb{K}^4)
            %p
              from (the real vector space underlying)
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              to real
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}^4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ψ
                          %mtr
                            %mtd
                              %mi ϕ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi A
                              %mi ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(A)
                    \\left(
                    \\array{
                    \\psi
                    \\\
                    \\phi
                    }
                    \\right)
                    \\;\coloneqq\;
                    \\left(
                    \\array{
                    \\tilde A \phi
                    \\\
                    A \psi
                    }
                    \\right)
                    \\,.
            %p
              Here on the right we are using the isomorphism from prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              for identifying a spacetime vector with a
              = succeed "-matrix," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TraceReversal"}
          .num_remark
            %h6#remark_7 Remark
            %p
              Each operation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(A)
              in def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              is clearly a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              being the non-associative
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              the octonions, then the composition of two such linear maps is not in general given by the usual matrix product.
          #SpinorRepsByNormedDivisionAlgebra.num_prop
            %h6#proposition_13 Proposition
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              in def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              gives a
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo +
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{dim_{\mathbb{R}}}(\mathbb{K}+1,1)  )
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{2,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 3
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{3,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 5
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{5,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 9
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{9,1})
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi 𝕆
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
            %p
              Hence this Clifford representation induces
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(dim_{\mathbb{R}}(\mathbb{K})+1,1)
              on the real vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo ±
                    %mo ≔
                    %msup
                      %mi 𝕂
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{\pm } \coloneqq \mathbb{K}^2
                    \\,.
          %p
            (
            %a{:href => "#BaezHuerta09"}> Baez-Huerta 09, p. 6
            )
          .proof
            %h6#proof_4 Proof
            %p We need to check that the Clifford relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma(A))^2 = -\eta(A,A)1
            %p
              is satisfied. Now by definition, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} (\phi,\psi) \in \mathbb{K}^4
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi ψ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mi ϕ
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ψ
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma(A))^2
                    \\left(
                    \\array{
                    \\phi
                    \\\
                    \\psi
                    }
                    \\right)
                    \\;=\;
                    \\left(
                    \\array{
                    \\tilde A(A \phi)
                    \\\
                    A(\tilde A \psi)
                    }
                    \\right)
                    \\,,
            %p where on the right we have in each component ordinary matrix product expressions.
            %p Now observe that both expressions on the right are sums of triple products that involve either one real factor or two factors that are conjugate to each other:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                            %mi ψ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                    %mtd
                                      %mi y
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo −
                                      %msub
                                        %mi x
                                        %mn 1
                              %mo )
                            %mo ⋅
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo +
                                      %mi y
                                      %msub
                                        %mi ϕ
                                        %mn 2
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo −
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 2
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %msubsup
                                        %mi x
                                        %mn 0
                                        %mn 2
                                      %mo +
                                      %msubsup
                                        %mi x
                                        %mn 1
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo +
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} (
                                      %mi y
                                      %msub
                                        %mi ϕ
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                                      %mo +
                                      %mi y
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi y
                                        %mo *
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} (
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                                  %mtr
                                    %mtd
                                      %mi ⋯
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A (\tilde A \psi)
                    \&amp; =
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    \\cdot
                    \\left(
                    \\array{
                    (-x_0 + x_1) \phi_1 + y \phi_2
                    \\\
                    y^\ast \phi_1 - (x_0 + x_1)\phi_2
                    }
                    \\right)
                    \\\
                    \&amp; =
                    \\left(
                    \\array{
                    (-x_0^2 + x_1^2) \phi_1 + (x_0 + x_1)(y \phi_2) + y (y^\ast \phi_1) - y( (x_0 + x_1) \phi_2 )
                    \\\
                    \\cdots
                    }
                    \\right)
                    \\end{aligned}
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/associators"} associators
              of triple products that involve a real factor and those involving both an element and its conjugate vanish by prop.
              %a.maruku-ref{:href => "#PropertiesOfAssociatorInAlternativeAlgebra"}
              (hence ultimately by Artin’s theorem, prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ArtinTheorem"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi ψ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi A
                              %mo{:stretchy => "false"} )
                              %mi ϕ
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mo{:stretchy => "false"} )
                              %mi ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma(A))^2
                    \\left(
                    \\array{
                    \\phi
                    \\\
                    \\psi
                    }
                    \\right)
                    \\;=\;
                    \\left(
                    \\array{
                    (\tilde A A) \phi
                    \\\
                    (A \tilde A) \psi
                    }
                    \\right)
                    \\,.
            %p
              This implies the statement via the equality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mi A
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \tilde A = \tilde A A = -det(A)
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#DeterminantViaProductWithTraceReversal"}
          .num_remark
            %h6#remark_8 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              says that the isomorphism of prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              is that given by forming generalized
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi γ
                      %mrow
                        %mi α
                        %mover
                          %mi α
                          %mo ˙
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(x^a) = (\gamma^a_{\alpha \dot \alpha})
                    \\,.
          .num_prop
            %h6#proposition_14 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
              given via prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              by the Clifford representation of def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              are the following:
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo =
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
                  the Majorana representation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(2,1)
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo +
                          %mo ≃
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_+ \simeq S_-
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo =
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
                  the Majorana representation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(3,1)
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo +
                          %mo ≃
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_+ \simeq S_-
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo =
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
                  the Weyl representation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(5,1)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S_+
                  and on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_-
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo =
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
                  the Majorana-Weyl representation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 9
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(9,1)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S_+
                  and on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_-
          #RealSpinorPairingsViaDivisionAlg.num_prop
            %h6#proposition_15 Proposition
            %p
              Under the identification of prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              the bilinear pairings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \;\colon\; S_+ \otimes S_-\longrightarrow \mathbb{R}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mo ±
                    %mo ⊗
                    %msub
                      %mi S
                      %mo ±
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-) \;\colon\; S_\pm \otimes S_{\pm}\longrightarrow V
            %p
              from
              %a{:href => "#TheSpinorPairingToVectors"} above
              are given, respectively, by forming the real part of the canonical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \colon S_+\otimes S_- \longrightarrow \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi ϕ
                    %mo ≔
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %mo ⋅
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,\phi)\mapsto \overline{\psi} \phi \coloneqq Re(\psi^\dagger \cdot \phi)
            %p
              and by forming the product of a column vector with a row vector to produce a matrix, possibly up to trace reversal (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#TraceReversal"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo +
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    S_+ \otimes S_+ \longrightarrow V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi Γ
                    %mi ϕ
                    %mo ≔
                    %mover
                      %mrow
                        %mi ψ
                        %msup
                          %mi ϕ
                          %mo †
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi ϕ
                        %msup
                          %mi ψ
                          %mo †
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"}
                    (\psi , \phi) \mapsto \overline{\psi}\Gamma \phi \coloneqq
                    \\widetilde{\psi \phi^\dagger + \phi \psi^\dagger}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo −
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    S_- \otimes S_- \longrightarrow V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mi ψ
                      %msup
                        %mi ϕ
                        %mo †
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi ϕ
                      %msup
                        %mi ψ
                        %mo †
                  %annotation{:encoding => "application/x-tex"}
                    (\psi , \phi) \mapsto {\psi \phi^\dagger + \phi \psi^\dagger}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} A \in V
              the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi Γ
                    %mi ϕ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(\overline{\psi}\Gamma \phi, A)
                    \=
                    Re (\psi^\dagger (A\phi))
                    \\,.
          %p
            (
            %a{:href => "#BaezHuerta09"}> Baez-Huerta 09, prop. 8, prop. 9
            ).
          #RealSpinorRepsIn3d.num_example
            %h6#example Example
            %p
              Consider the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi symm
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V= Mat^{symm}_{2\times 2}(\mathbb{R})
              is the space of symmetric 2x2-matrices with real numbers.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi t
                                  %mo +
                                  %mi x
                                %mtd
                                  %mi y
                              %mtr
                                %mtd
                                  %mi y
                                %mtd
                                  %mi t
                                  %mo −
                                  %mi x
                          %mo )
                        %mo |
                      %mi t
                      %mo ,
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi ℝ
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    V =
                    \\left\{
                    \\left.
                    \\left(
                    \\array{
                    t + x &amp; y
                    \\\
                    y &amp; t - x
                    }
                    \\right)
                    \\right\vert
                    t,x,y\in \mathbb{R}
                    \\right\}
            %p
              The “light-cone”-
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              for this space would be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mi v
                        %mo +
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi v
                        %mo −
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi v
                        %mi y
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    v^+
                    \\coloneqq
                    \\left(
                    \\array{
                    1 &amp; 0
                    \\\
                    0 &amp; 0
                    }
                    \\right)
                    \\,,
                    \\;
                    v^-
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 0
                    \\\
                    0 &amp; 1
                    }
                    \\right)
                    \\,,
                    \\;
                    v^y
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right\}
            %p
              Its trace reversal (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TraceReversal"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mo +
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mo −
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mi y
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\tilde{v}^+
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 0
                    \\\
                    0 &amp; -1
                    }
                    \\right)
                    \\,,
                    \\;
                    \\tilde v^-
                    \\coloneqq
                    \\left(
                    \\array{
                    \-1 &amp; 0
                    \\\
                    0 &amp; 0
                    }
                    \\right)
                    \\,,
                    \\;
                    \\tilde v^y
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right\}
            %p
              Hence the Minkowski metric of prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              in this basis has the components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta
                    \=
                    \\left(
                    \\array{
                    0 &amp; -1 &amp; 0
                    \\\
                    \-1 &amp; 0 &amp; 0
                    \\\
                    0 &amp; 0 &amp; 2
                    }
                    \\right)
                    \\,.
            %p
              As vector spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo ±
                      %mo =
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_{\pm} = \mathbb{R}^2
            %p
              The bilinear spinor pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}(-) \colon S_+ \otimes S_- \to \mathbb{R}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi ψ
                              %mo ¯
                            %mi ϕ
                          %mtd
                            %mo =
                            %msup
                              %mi ψ
                              %mi t
                            %mo ⋅
                            %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ψ
                              %mn 1
                            %msub
                              %mi ϕ
                              %mn 1
                            %mo +
                            %msub
                              %mi ψ
                              %mn 2
                            %msub
                              %mi ϕ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\psi}\phi
                    \&amp;= \psi^t \cdot \phi
                    \\\
                    \&amp; = \psi_1  \phi_1 + \psi_2 \phi_2
                    \\end{aligned}
                    \\,.
            %p
              The spinor pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} S_+ \otimes S_+ \otimes V^\ast \to \mathbb{R}
              from prop.
              %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
              is given on an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mo +
                    %msup
                      %mi v
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi A
                      %mo −
                    %msup
                      %mi v
                      %mo −
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi A
                      %mi y
                    %msup
                      %mi v
                      %mi y
                  %annotation{:encoding => "application/x-tex"} A = A_+ v^+ + A_- v^- + A_y v^y
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo +
                    %mo ,
                    %msub
                      %mi A
                      %mo −
                    %mo ,
                    %msub
                      %mi A
                      %mi y
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} A_+, A_-, A_y \in \mathbb{R}
              ) by the components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi ψ
                              %mo ¯
                            %mi Γ
                            %mi ϕ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msup
                              %mi ψ
                              %mi t
                            %mo ⋅
                            %mi A
                            %mo ⋅
                            %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ψ
                              %mn 1
                            %msub
                              %mi ϕ
                              %mn 1
                            %msub
                              %mi A
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msub
                              %mi ψ
                              %mn 2
                            %msub
                              %mi ϕ
                              %mn 2
                            %msub
                              %mi A
                              %mo −
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mn 1
                            %msub
                              %mi ϕ
                              %mn 2
                            %mo +
                            %msub
                              %mi ψ
                              %mn 2
                            %msub
                              %mi ϕ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi A
                              %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
