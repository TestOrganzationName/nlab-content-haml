                            %mn 2
                          %msup
                            %mi S
                            %mo *
                          %mo ≃
                          %mi V
                          %mo ⊕
                          %msup
                            %mo ∧
                            %mn 2
                          %mi V
                          %mo ⊕
                          %msup
                            %mo ∧
                            %mn 5
                          %mi V
                        %annotation{:encoding => "application/x-tex"} Sym^2 S^\ast \simeq V \oplus \wedge^2 V \oplus \wedge^5 V
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is the 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
            on which the
            %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            naturally act.
          #BilinearPairingForRealRepresentations.num_remark
            %h6#remark Remark
            %p
              The last column implies that in each dimension there exists a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mo *
                    %mo ⊗
                    %msup
                      %mi S
                      %mo *
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\colon\; S^\ast \otimes S^\ast \longrightarrow \mathbb{R}^{d-1,1}
            %p which is
            %ol
              %li
                %p symmetric;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(V)
                  \-equivariant.
            %p
              This allows to form the
              %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
              in each of these cases. See there and see
              %em
                %a{:href => "#SpinorBilinearForms"} Spinor bilinear forms
              below for more.
          %h3#SpinorBilinearForms Spinor bilinear forms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
