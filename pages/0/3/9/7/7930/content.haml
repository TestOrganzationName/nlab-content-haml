                            %msup
                              %mi c
                              %mo *
                            %mo ,
                            %msup
                              %mi b
                              %mo *
                            %mo ,
                            %msup
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
