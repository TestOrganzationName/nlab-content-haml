                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi a
                          %mo *
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
