            %h6#proof Proof
            %p That the associator vanishes as soon as one argument is real is just the linearity of an algebra product over the ground ring.
            %p Hence in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
