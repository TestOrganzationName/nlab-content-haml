                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [Re(a),b,c]
              %li
                %p
