                        %annotation{:encoding => "application/x-tex"} S
          %p
            (
            %a{:href => "#BaezHuerta09"}> Baez-Huerta 10, p. 10, prop. 8, prop. 9
            )
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mn 0
                  %mo ≔
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mn 1
                              %mrow
                                %mn 2
                                %mi x
                                %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mn 1
                              %mrow
                                %mn 2
                                %mo ×
                                %mn 2
                          %mtd
                            %mn 0
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma^0 \coloneqq
                  \\left(
                  \\array{
                  0 &amp; - 1_{2x2}
                  \\\
                  1_{2\times 2} &amp; 0
                  }
                  \\right)
                  \\,.
          .num_prop
            %h6#proposition_17 Proposition
            %p
              Under the identification of prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebraOneDimHigher"}
              of the bilinear pairings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \;\colon\; S \otimes S \longrightarrow \mathbb{R}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-) \;\colon\; S  \otimes S \longrightarrow V
            %p
              of remark
              = succeed "," do
                %a.maruku-ref{:href => "#BilinearPairingForRealRepresentations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi ϕ
                    %mo ≔
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %msup
                      %mi Γ
                      %mn 0
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,\phi)
                    \\mapsto
                    \\overline\psi\phi
                    \\coloneqq
                    Re(\psi^\dagger \Gamma^0 \phi)
            %p and the second is characterized by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mrow
                              %mo (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mi Γ
                              %mi ϕ
                              %mo ,
                              %mi A
                              %mo )
                          %mtd
                            %mo =
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ψ
                              %mo †
                            %msup
                              %mi Γ
                              %mn 0
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta
                    \\left(
                    \\overline{\psi}\Gamma\phi, A
                    \\right)
                    \&amp;=
                    \\overline{\psi}(\Gamma(A)\phi)
                    \\\
                    \&amp; = Re( \psi^\dagger \Gamma^0 \Gamma(A)\phi)
                    \\end{aligned}
                    \\,.
          %p
            (
            %a{:href => "#BaezHuerta10"}> Baez-Huerta 10, prop. 10, prop. 11
            ).
