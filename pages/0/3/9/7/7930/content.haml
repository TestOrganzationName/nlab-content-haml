                      %mi S
                      %mo ⟶
                      %mi k
                    %annotation{:encoding => "application/x-tex"} (-,-) \;\colon\; S \otimes S \longrightarrow k
                define a
                %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                on the space of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
                for a
                %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                = succeed "," do
