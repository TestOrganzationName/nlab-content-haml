          %h4#SpinorMetric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p = 0
            – spinor metric
          %p We discuss spinor bilinear pairings to scalars.
          %h5#over_the_complex_numbers Over the complex numbers
          #DualityPairingOverComplexNumbers.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a quadratic vector space, def.
              %a.maruku-ref{:href => "#QuadraticVectorSpace"}
              over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ≠
                      %mn 2
                      %mo ,
                      %mn 6
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mspace{:width => "thinmathspace"}
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} d \neq 2,6 \; mod \, 8
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(V)
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    C \;\colon\; S \otimes S \longrightarrow \mathbb{C}
            %p
              on a complex
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(V)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mo +
                    %mo ⊗
                    %msup
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    C \;\colon\; S^+ \otimes S^- \longrightarrow \mathbb{C}
            %p which is non-degenerate and whose symmetry is given by the following table:
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mspace{:width => "thinmathspace"}
                          %mi mod
                          %mspace{:width => "thinmathspace"}
                          %mn 8
                        %annotation{:encoding => "application/x-tex"} d \, mod\, 8
                  %th C
              %tbody
                %tr
                  %td{:style => "text-align: left;"} 0
                  %td{:style => "text-align: left;"} symmetric
                %tr
                  %td{:style => "text-align: left;"} 1
                  %td{:style => "text-align: left;"} symmetric
                %tr
                  %td{:style => "text-align: left;"} 2
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mo ±
                        %annotation{:encoding => "application/x-tex"} S^\pm
                    dual to each other
                %tr
                  %td{:style => "text-align: left;"} 3
                  %td{:style => "text-align: left;"} skew-symmetric
                %tr
                  %td{:style => "text-align: left;"} 4
                  %td{:style => "text-align: left;"} skew-symmetric
                %tr
                  %td{:style => "text-align: left;"} 5
                  %td{:style => "text-align: left;"} skew-symmetric
                %tr
                  %td{:style => "text-align: left;"} 6
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mo ±
                        %annotation{:encoding => "application/x-tex"} S^\pm
                    dual to each other
                %tr
                  %td{:style => "text-align: left;"} 7
                  %td{:style => "text-align: left;"} symmetric
          %p
            This appears for instance as (
            %a{:href => "#Varadarajan04"}> Varadarajan 04, theorem 6.5.7
            ).
          #ChargeConjugationMatrix.num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              representation of the bilinear form in prop.
              %a.maruku-ref{:href => "#DualityPairingOverComplexNumbers"}
              is known in the physics literature as the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              the symmetry property means that the
              %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    C^T = - \epsilon C
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \epsilon \in \{-1,1\}
              given in
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              by the following table
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mspace{:width => "thinmathspace"}
                          %mi mod
                          %mspace{:width => "thinmathspace"}
                          %mn 8
                        %annotation{:encoding => "application/x-tex"} d \, mod \, 8
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %tbody
                %tr
                  %td{:style => "text-align: left;"} 0
                  %td{:style => "text-align: left;"} -1
                %tr
                  %td{:style => "text-align: left;"} 1
                  %td{:style => "text-align: left;"} -1
                %tr
                  %td{:style => "text-align: left;"} 2
                  %td{:style => "text-align: left;"} either
                %tr
                  %td{:style => "text-align: left;"} 3
                  %td{:style => "text-align: left;"} +1
                %tr
                  %td{:style => "text-align: left;"} 4
                  %td{:style => "text-align: left;"} +1
                %tr
                  %td{:style => "text-align: left;"} 5
                  %td{:style => "text-align: left;"} +1
                %tr
                  %td{:style => "text-align: left;"} 6
                  %td{:style => "text-align: left;"} either
                %tr
                  %td{:style => "text-align: left;"} 7
                  %td{:style => "text-align: left;"} -1
          %p
            For instance (
            %a{:href => "#vanProeyen99"}> van Proeyen 99, table 1
            ).
          %h5#over_the_real_numbers_for_majorana_spinors Over the real numbers (for Majorana spinors)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a quadratic vector space, def.
