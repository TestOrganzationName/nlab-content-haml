            %a.maruku-ref{:href => "#ArtinTheorem"}
            is what allows to carry over a minimum of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            also to the
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            such as to yield a representation of the
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
            %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
            below.
          %p
            So we will be looking at a fragment of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            over these four
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
          #MatrixNotation.num_defn
            %h6#definition_10 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Say that an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in Mat_{n\times n}(\mathbb{K})
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              if the
              %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi t
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mi j
                    %mo ≔
                    %msub
                      %mi A
                      %mrow
                        %mi j
                        %mi i
                  %annotation{:encoding => "application/x-tex"} (A^t)_{i j} \coloneqq A_{j i}
              equals the componentwise
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} conjugated
              matrix (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi t
                    %mo =
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^t = A^\ast
                    \\,.
            %p Hence with the notation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    (-)^\dagger \coloneqq ((-)^t)^\ast
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              precisely if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi A
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A = A^\dagger
                    \\,.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mat_{2 \times 2}^{her}(\mathbb{K})
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of hermitian matrices.
          #TraceReversal.num_defn
            %h6#definition_11 Definition
            %p
              %strong (trace reversal)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mat_{2 \times 2}^{her}(\mathbb{K})
              be a hermitian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %em trace reversal
              is the result of subtracting its
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              times the identity matrix:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mn 1
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde A \;\coloneqq\; A - (tr A) 1_{n\times n}
                    \\,.
          %h4#spacetime_in_dimensions_346_and_10 Spacetime in dimensions 3,4,6 and 10
          %p
            We discuss how
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            of dimension 3,4,6 and 10 is naturally expressed in terms of the real
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            from prop.
            = succeed "," do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
            %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
            %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ZornTheorem"}
          #SpacetimeAsMatrices.num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (of real
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mo +
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d = 2 + dim_{\mathbb{R}}(\mathbb{K})
            %p hence
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 3
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{3,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 5
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 9
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi 𝕆
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              whose
              = succeed "-square" do
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              operation on matrices:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi det
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}
                    \\;\simeq\;
                    \\left(Mat_{2 \times 2}^{her}(\mathbb{K}), -det \right)
                    \\,.
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              this is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                              %mo +
                              %msub
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                              %mo −
                              %msub
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ≔
                    %msub
                      %mi x
                      %mn 2
                    %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mn 3
                    %msub
                      %mi e
                      %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mn 4
                    %msub
                      %mi e
                      %mn 2
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi x
                      %mrow
                        %mn 2
                        %mo +
                        %msub
                          %mi dim
                          %mrow
                            %mi ℝ
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x_0, x_1, \cdots, x_{d-1})
                    \\;\mapsto\;
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    \\;\;\;
                    \\text{with}\;
                    y \coloneqq x_2 1 + x_3 e_1 + x_4 e_2 +   \cdots + x_{2 + dim_{\mathbb{R}(\mathbb{K})}} \,e_{dim_{\mathbb{R}}(\mathbb{K})-1}
                    \\,.
            %p
              Under this identification the operation of trace reversal from def.
              %a.maruku-ref{:href => "#TraceReversal"}
              corresponds to
              %em time reversal
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi x
                                  %mn 0
                                %mo +
                                %msub
                                  %mi x
                                  %mn 1
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %msup
                                  %mi y
                                  %mo *
                              %mtd
                                %msub
                                  %mi x
                                  %mn 0
                                %mo −
                                %msub
                                  %mi x
                                  %mn 1
                        %mo )
                      %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi x
                                %mn 0
                              %mo +
                              %msub
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi x
                                %mn 0
                              %mo −
                              %msub
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    }
                    \\;=\;
                    \\left(
                    \\array{
                    \-x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; -x_0 - x_1
                    }
                    \\right)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              This is immediate from the nature of the conjugation operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mi det
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                    %mtd
                                      %mi y
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo −
                                      %msub
                                        %mi x
                                        %mn 1
                              %mo )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo +
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo −
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi y
                            %msup
                              %mi y
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi a
                                %mo =
                                %mn 1
                              %mrow
                                %mi d
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-
                    det
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    \&amp; =
                    \-(x_0 + x_1)(x_0 - x_1)
                    +
                    y y^\ast
                    \\\
                    \&amp; =
                    \-(x_0)^2 + \underoverset{a = 1}{d-1}{\sum} (x_a)^2
                    \\end{aligned}
                    \\,.
          %p By direct computation one finds:
          #DeterminantViaProductWithTraceReversal.num_prop
            %h6#proposition_12 Proposition
            %p
              In terms of the trace reversal operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
