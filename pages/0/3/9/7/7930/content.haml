                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e_1, \cdots, e_7\}
              subject to the
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
            %div{:style => "float:right;margin:0 20px 10px 20px;"}
              %img{:alt => "octonion multiplication table", :src => "https://ncatlab.org/nlab/files/OctonionMultiplicationTable.jpg", :width => "400"}/
            %ol
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} (e_i)^2 = -1
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mi i
                        %mo →
                        %msub
                          %mi e
                          %mi j
                        %mo →
                        %msub
                          %mi e
                          %mi k
                      %annotation{:encoding => "application/x-tex"} e_i \to e_j \to e_k
                  an edge or circle in the diagram shown (a labeled version of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Fano+plane"} Fano plane
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi j
                            %mo =
                            %msub
                              %mi e
                              %mi k
                          %annotation{:encoding => "application/x-tex"} e_i e_j  = e_k
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi i
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi k
                          %annotation{:encoding => "application/x-tex"} e_j e_i  = -e_k
                %p
                  and all relations obtained by cyclic
                  %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  of the indices in these equations.
            %blockquote
              %p
                (graphics grabbed from
                = succeed ")" do
                  %a{:href => "#Baez02"} Baez 02
          %p One defines the following operations on these real algebras:
          #Conjugation.num_defn
            %h6#definition_8 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi ℝ
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi ℍ
                      %mo ,
                      %mi 𝕆
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    (-)^\ast
                    \\;\colon\;
                    \\mathbb{K}
                    \\longrightarrow
                    \\mathbb{K}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} antihomomorphism
              of real algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo =
                            %mi r
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo ,
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi r
                            %mo ∈
                            %mi ℝ
                            %mo ,
                            %mi a
                            %mo ∈
                            %mi 𝕂
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo =
                            %msup
                              %mi b
                              %mo *
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo ,
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ,
                            %mi b
                            %mo ∈
                            %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (r a)^\ast  = r a^\ast &amp;, \text{for}\;\; r \in \mathbb{R}, a \in \mathbb{K}
                    \\\
                    (a b)^\ast = b^\ast a^\ast &amp;,\text{for}\;\; a,b \in \mathbb{K}
                    \\end{aligned}
            %p
              given on the generators of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi e
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (e_i)^\ast = - e_i
                    \\,.
            %p
              This operation makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              into a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              this is called
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              = succeed "." do
                %em conjugation
            %p Let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    Re \;\colon\; \mathbb{K} \longrightarrow \mathbb{R}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %msup
                      %mi a
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Re(a) \;\coloneqq\; \tfrac{1}{2}(a + a^\ast)
            %p
              (“
              %a.existingWikiWord{:href => "/nlab/show/real+part"}> real part
              ”) and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    Im \;\colon\; \mathbb{K} \longrightarrow \mathbb{R}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %msup
                      %mi a
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Im(a) \;\coloneqq \; \tfrac{1}{2}(a - a^\ast)
            %p
              (“
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"}> imaginary part
              ”).
            %p
              It follows that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{K}
              then the product of a with its conjugate is in the real
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msup
                      %mi a
                      %mo *
                    %mo =
                    %msup
                      %mi a
                      %mo *
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi ℝ
                    %mo ↪
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    a a^\ast = a^\ast a \;\in \mathbb{R} \hookrightarrow \mathbb{K}
            %p
              and we write the
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              of this expression as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msqrt
                      %mrow
                        %mi a
                        %msup
                          %mi a
                          %mo *
                  %annotation{:encoding => "application/x-tex"}
                    {\vert a\vert}
                    \\;\coloneqq\;
                    \\sqrt{a a^\ast}
            %p
              called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert -\vert}
                    \\;\colon\;
                    \\mathbb{K}
                    \\longrightarrow
                    \\mathbb{R}
                    \\,.
            %p
              This norm operation clearly satisfies the following properties (for all
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} a,b \in \mathbb{K}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi a
                        %mo{:stretchy => "false"} |
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \vert a \vert \geq 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⇔
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi a
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} {\vert a \vert } = 0 \;\;\;\;\; \Leftrightarrow\;\;\;\;\;\; a = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mi b
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi b
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\vert a b \vert } = {\vert a \vert} {\vert b \vert}
            %p
              and hence makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normed+algebra"} normed algebra
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi b
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext or
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi b
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a b = 0 \;\;\;\;\;\; \Rightarrow \;\;\;\;\;\; a = 0 \;\; \text{or} \;\; b = 0
                    \\,.
            %p
              Hence the conjugation operation makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              a
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
          #SequenceOfInclusionsOfRealNormedDivisionAlgebras.num_remark
            %h6#remark_4 Remark
            %p
              Sending each generator in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              to the generator of the same name in the next larger algebra constitutes a sequence of real
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
                    \\,.
          #HurwitzTheorem.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"}> Hurwitz theorem
                )
            %p
              The four algebras of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
              and
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"} \mathbb{O}
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              respectively, which are real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              via def.
              = succeed "," do
                %a.maruku-ref{:href => "#Conjugation"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %em only
              real normed division algebras that exist.
          .num_remark
            %h6#remark_5 Remark
            %p
              While hence the sequence from remark
              %a.maruku-ref{:href => "#SequenceOfInclusionsOfRealNormedDivisionAlgebras"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
            %p
              is maximal in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of real normed non-associative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              = succeed "." do
                %em
                  forming the
                  %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+double+algebra"} Cayley-Dickson double algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                    %mo ↪
                    %mi 𝕊
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
                    \\hookrightarrow
                    \\mathbb{S}
                    \\hookrightarrow
                    \\cdots
            %p
              where the next algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
          %p
            What actually matters for the following relation of the real normed division algebras to
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            is that they are also
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
          #AlternativeAlgebra.num_defn
            %h6#definition_9 Definition
            %p
              Given any
              %a.existingWikiWord{:href => "/nlab/show/non-associative+algebra"} non-associative algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⟶
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    [-,-,-] \;-\; A \otimes A \otimes A \longrightarrow A
            %p
              given on any elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b,c \in A
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi c
                    %mo −
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [a,b,c] \coloneqq (a b) c - a (b c)
            %p
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              (in analogy with the
              %em
                %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mi a
                    %mi b
                    %mo −
                    %mi b
                    %mi a
                  %annotation{:encoding => "application/x-tex"} [a,b] \coloneqq a b - b a
              ).
            %p
              If the associator is completely antisymmetric (in that for any
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
