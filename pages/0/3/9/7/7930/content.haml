          %p
            This appears for instance as (
            %a{:href => "#Freed99"}> Freed 99, around (3.4)
            ,
            = succeed ")." do
              %a{:href => "#Varadarajan04"} Varadarajan 04, theorem 6.5.10
          %h4#SuperPoincareBrackets
