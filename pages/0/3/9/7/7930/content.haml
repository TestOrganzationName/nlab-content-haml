            ).
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi v
                  %mo ↦
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} q\colon v \mapsto \langle v ,v \rangle
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CL(V,q)
              of a quadratic vector space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuadraticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(V,q)
                    \\coloneqq
                    T(V)/I(V,q)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              by the ideal generated by the elements
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⊗
                      %mi v
                      %mo −
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \otimes v - q(v)
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            is naturally
            = succeed "-graded," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(V,q)
            is naturally
            = succeed "-graded." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi q
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{R}^n, q = {\vert \vert})
            be the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            with its canonical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/scalar+product"} scalar product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cl
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl^\mathbb{C}(\mathbb{R}^n)
            for the
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
          .num_prop
            %h6#proposition Proposition
            %p
              There exists a unique
              %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cl
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi End
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl^{\mathbb{C}}(\mathbb{R}^n) \longrightarrow End(\Delta_n)
            %p
              of the algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cl
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl^\mathbb{C}(\mathbb{R}^n)
              of smallest
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim_{\mathbb{C}}(\Delta_n) = 2^{[n/2]}
                    \\,.
          #SpinGroup.num_defn
            %h6#definition_4 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,q)
              of a quadratic vector space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuadraticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              in the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V,q)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spin(V,q)\hookrightarrow GL_1(Cl(V,q))
            %p
              on those elements which are even number multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi v
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} v_1 \cdots v_{2k}
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_i \in V
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q(v_i) = 1
            %p Specifically, “the” Spin group is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spin(n) \coloneqq Spin(\mathbb{R}^n)
                    \\,.
          %p
            A
            %em spin representation
            is a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of the spin group, def.
            = succeed "." do
              %a.maruku-ref{:href => "#SpinGroup"}
          %h2#Properties Properties
          %h3#complex_representations Complex representations
          %p
            Complex
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            follow a mod-2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
          %p
            In even
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 2
                  %mi n
                %annotation{:encoding => "application/x-tex"} d = 2n
            there are two inequivalent complex-linear
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 2^{d/2-1}
            %em chiral
            representations, or the two
            %em Weyl spinor
            representations.
          %p
            For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 10
                %annotation{:encoding => "application/x-tex"} d = 10
            one often writes these as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 16
                %annotation{:encoding => "application/x-tex"} \mathbf{16}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{16}'
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of the two chiral representation is called the
            %em Dirac spinor
            representation, for instance
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{16} + \mathbf{16}'
          %p
            In odd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 2
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} d = 2n+1
            there is a single complex
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            of complex
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} 2^{(d-1)/2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 11
                %annotation{:encoding => "application/x-tex"} d = 11
            one often writes this as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                  %annotation{:encoding => "application/x-tex"} \mathbf{32}
            %em Dirac spinor
            representation in this odd dimension.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} d = 2n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi Γ
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msup
                    %mi Γ
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\Gamma^1, \cdots, \Gamma^n\}
            denote the generators of the
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cl
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Cl_{d-1,1}
            then there is the
            %em chirality operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mrow
                      %mi d
                      %mo +
                      %mn 1
                  %mo ≔
                  %msup
                    %mi Γ
                    %mn 1
                  %mo ⋅
                  %msup
                    %mi Γ
                    %mn 2
                  %mi ⋯
                  %msup
                    %mi Γ
                    %mi d
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma^{d+1} \coloneqq \Gamma^1 \cdot \Gamma^2 \cdots \Gamma^d
          %p
            on the Dirac representation, whose
            %a.existingWikiWord{:href => "/nlab/show/eigenspaces"} eigenspaces
            induce its decomposition into the two chiral summands.
          %p
            The unique irreducible Dirac representation in the odd dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} d+1
            is, as a complex vector space, the sum of the two chiral representations in dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Gamma^1
            through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mi d
                %annotation{:encoding => "application/x-tex"} \Gamma^d
            acting diagonally on the two chiral representations, and the chirality operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mrow
                      %mi d
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Gamma^{d+1}
            in dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            acting on their sum, now being the representation of the
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d+1)
          %h3#RealIrreducibleSpinRepresentationInLorentzSignature Real representations (Majorana representations)
          %p
            One may ask in which dimensions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            the above complex representations admit a
            %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
          %p
            Real spinor representations are also called
            %em Majorana representations
            (with variants such as “symplectic Majorana”), and an element of a real/Majorana spin representation is also called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            there is a non-vanishing symmetric and
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi d
