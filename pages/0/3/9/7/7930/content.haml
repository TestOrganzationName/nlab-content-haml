                            %msub
                              %mi e
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
