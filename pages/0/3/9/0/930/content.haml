                %mrow
                  %mi u
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} u\in E
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi u
                    %mo ⊗
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \rho(u)=u\otimes 1
          %p
            The
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %strong extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↪
                  %mi E
                %annotation{:encoding => "application/x-tex"} U\hookrightarrow E
            is
            %strong Hopf–Galois
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            if the natural map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %msub
                    %mo ⊗
                    %mi U
                  %mi E
                  %mo →
                  %mi E
                  %mo ⊗
                  %mi H
                %annotation{:encoding => "application/x-tex"} E\otimes_U E\to E\otimes H
            given by the
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ⊗
                  %mi e
                  %mo ′
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi e
                  %msub
                    %mo ⊗
                    %mi k
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %mi e
                  %mi e
                  %msub
                    %mo ′
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi e
                  %msub
                    %mo ′
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e\otimes e'\mapsto (e\otimes_k 1)\rho(e') = \sum e e'_{(0)}\otimes e'_{(1)}
            is a bijection (hence a
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            A
            %strong Hopf–Galois object
            over a
            = succeed "-bialgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
