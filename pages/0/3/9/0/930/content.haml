            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the
            = succeed "-Hopf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectra
            (with the
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            of spectra in the role of tensor product) was studied by Rognes and others (see (
            %a{:href => "#Rognes08"}> Rognes 08
            )). In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+principal+bundle"} noncommutative principal bundle
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            theorems for
            %a.existingWikiWord{:href => "/nlab/show/Hopf+module"} Hopf modules
            like the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Schneider%27s+descent+theorem"} Schneider's descent theorem
            = succeed "-Hopf-Galois" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↪
                  %mi E
                %annotation{:encoding => "application/x-tex"} U\hookrightarrow E
            and a left
            = succeed "-comodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
