                  %mrow
                    %mi K
                    %mo ≠
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} K\neq (k[G])^*
          %h2#role_in_geometry Role in geometry
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
