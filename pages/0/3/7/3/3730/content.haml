                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mo □
                    %mi a
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} /
                  %mi π
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi φ
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_{\square}^{a}(\mathcal{O}_{X}^{+}/\pi)^{\varphi}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒟
                    %mi et
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔽
                    %mi p
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi oc
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_{et}(X,\mathbb{F}_{p})^{oc}
            respectively).
          %p
          .num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#Mann22"}> Mann22
              , Theorem 1.2.7, Theorem 3.9.23)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a small v-stack over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{p}
              with pseudouniformizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} |
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \pi\vert p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ⊗
                    %msubsup
                      %mi 𝒪
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi a
                    %mo{:stretchy => "false"} /
                    %mi π
                    %mo :
                    %msub
                      %mi 𝒟
                      %mi et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi oc
                    %mo →
                    %msubsup
                      %mi 𝒟
                      %mo □
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝒪
                      %mi X
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} /
                    %mi π
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi φ
                  %annotation{:encoding => "application/x-tex"} -\otimes\mathcal{O}_{X}^{+a}/\pi:\mathcal{D}_{et}(X,\mathbb{F}_{p})^{oc}\to\mathcal{D}_{\square}^{a}(\mathcal{O}_{X}^{+}/\pi)^{\varphi}
            %p is fully faithful and induces an equivalence of categories of perfect objects on both sides.
