                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              is the quantum correction of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
