                        %msup
                          %mover
                            %mi V
                            %mo ¯
                          %mo ±
                      %annotation{:encoding => "application/x-tex"}
                        supp(\Delta_{\pm}) \subset \overline{V}^{\pm}
              %li
                %p
                  they turn into each other under exchange of their arguments (cor.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#CausalPropagatorIsSkewSymmetric"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
