          %p
            While the
            %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            with its
            %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
            provides a
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
            of
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            implies that the physically relevant observables are just the
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            ones, exhibited by the
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi S
                    %msub
                      %mo ′
                      %mi BRST
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-S' + S'_{BRST}, (-)\}
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
            needs to be lifted to the
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebra"} noncommutative algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
            – this is called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+quantization"} BV-BRST quantization
          %p
            To do so, we may regard the
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %msub
                    %mo ′
                    %mi BRST
                %annotation{:encoding => "application/x-tex"} S'_{BRST}
            as an
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            term, to be dealt with later via
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/scattering+theory"} scattering theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-S',(-)\}
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered
            version
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
