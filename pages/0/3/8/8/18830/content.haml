          %p
            The important point is that
            %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
            still contain all
            %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            but also all polynomial
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
          #MicrocausalRegularObservables.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynomialObservables"}
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observable"} microcausal
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
          .proof
            %h6#proof Proof
            %p
              By definition of regular polynomial observables, their
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              are
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              and because the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              is
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#NonSingularDistributionTrivialWaveFrontSet"}
          #PointwiseProductsOfFieldObservablesAdiabaticallySwitchedIsMicrocausal.num_example
            %h6#example_2 Example
            %p
              %strong
                (polynomial
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal
            %p
              Every polynomial
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observable"} microcausal polynomial observable
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
          .proof
            %h6#proof_2 Proof
            %p
              For notational convenience, consider the case of the
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              with
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} k = 2
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              coming from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi^2
              (a
              = succeed "-term)," do
                %a.existingWikiWord{:href => "/nlab/show/phi%5En+interaction"} phi^n interaction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo −
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta(x_1-x_2)
              as
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              in degree 2:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mi Σ
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi Σ
                                %mo ×
                                %mi Σ
                            %munder
                              %munder
                                %mrow
                                  %mi g
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi x
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mi δ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi x
                                    %mn 1
                                  %mo −
                                  %msub
                                    %mi x
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo =
                                %msup
                                  %mi α
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mn 2
                                    %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A(\Phi)
                    \&amp; =
                    \\underset{\Sigma}{\int} g(x) (\Phi(x))^2 \,dvol_\Sigma(x)
                    \\\
                    \&amp; =
                    \\underset{\Sigma \times \Sigma}{\int}
                    \\underset{ = \alpha^{(2)}}{
                    \\underbrace{
                    g(x_1)
                    \\delta(x_1 - x_2)
                    }}
                    \\,
                    \\Phi(x_1) \Phi(x_2) \, dvol_\Sigma(x_1) \, dvol_\Sigma(x_2)
                    \\end{aligned}
                    \\,.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Σ
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} (x_1, x_2) \in \Sigma \times \Sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ≃
                    %mi U
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n} \simeq U \subset X \times X
              a
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              around this point, the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \cdot \delta(-,-)
              restricted to this chart is proportional to the Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              evaluated at the sum of the two covectors:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 1
                            %mo ,
                            %msub
                              %mi k
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mn 2
                                    %mi n
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi k
                                  %mn 1
                                %mo ⋅
                                %msub
                                  %mi x
                                  %mn 1
                                %mo +
                                %msub
                                  %mi k
                                  %mn 2
                                %mo ⋅
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ∝
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 1
                            %mo +
                            %msub
                              %mi k
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (k_1, k_2)
                    \&amp; \mapsto
                    \\underset{\mathbb{R}^{2n}}{\int}
                    g(x_1)
                    \\delta(x_1, x_2)
                    e^{i (k_1 \cdot x_1 + k_2 \cdot x_2 )}
                    \\, dvol_\Sigma(x_1) \, dvol_\Sigma(x_2)
                    \\\
                    \&amp; \propto \hat g(k_1 + k_2)
                    \\end{aligned}
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              is quickly decaying (according to prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 1
                      %mo +
                      %msub
                        %mi k
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} k_1 + k_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 1
                      %mo +
                      %msub
                        %mi k
                        %mn 2
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k_1 + k_2 \neq 0
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo +
                    %msub
                      %mi k
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k_1 + k_2 = 0
              the Fourier transform is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/WaveFrontSetOfDeltaDistributionInTwoVariables.png", :width => "200"}/
            %p#WaveFrontOfdeltaxy
              This means that the wave front set consists of the elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, (k, -k))
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                  %annotation{:encoding => "application/x-tex"} -k
              are both in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              or both in the
              %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
              precisely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \cdot \delta(-,-)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observable"} microcausal
            %blockquote
              %p
                (graphics grabbed from
                = succeed ")" do
                  %a{:href => "microcausal+polynomial+observable#KhavkineMoretti14"} Khavkine-Moretti 14, p. 45
          #MoyalStarProductOnMicrocausal.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+distribution"}> Hadamard
                \-
                %a.existingWikiWord{:href => "/nlab/show/Moyal+star+product"} Moyal star product
                on
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/abstract+Wick+algebra"} abstract Wick algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mi Φ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} P \Phi = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              for the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_H
                    \\;=\;
                    \\tfrac{i}{2}\Delta + H
            %p
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              (
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+2-point+function"}> Hadamard 2-point function
              ).
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⋆
                      %mi H
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi X
                            %mn 2
                      %mi ℏ
                      %msubsup
                        %mi Δ
                        %mi H
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi a
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi b
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi dvol
                        %mi g
                      %mo )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi P
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \star_H A
                    \\;\coloneqq\;
                    prod
                    \\circ
                    \\exp\left(
                    \\int_{X^2} \hbar \Delta_H^{a b}(x_1, x_2) \frac{\delta}{\delta \mathbf{\Phi}^a(x_1)}
                    \\otimes \frac{\delta}{\delta \mathbf{\Phi}^b(x_2)} dvol_g
                    \\right)
                    (P_1 \otimes P_2)
            %p
              on
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %msub
                      %mi ℱ
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathcal{F}_{mc}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
              involved in the
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              that appear in expanding out the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              satisfy
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            %p
              Hence by the general properties of
              %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AssociativeAndUnitalStarProduct"}
              %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the space of
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              of
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    PolyObs(E)_{mc}[ [\hbar] ] \,,\, \star_H
                    \\right)
                    \\,.
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              corresponding to the choice of
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            %p
              Moreover the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is an ideal with respect to this algebra structure, so that it descends to the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              to yield the
              %em
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    PolyObs(E,\mathbf{L})_{mc}[ [ \hbar ] ] \,,\, \star_H
                    \\right)
                    \\,.
            %p
              Finally, under
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              these are
              %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mi A
                          %mn 1
                        %msub
                          %mo ⋆
                          %mi H
                        %msub
                          %mi A
                          %mn 2
                        %mo )
                      %mo *
                    %mo =
                    %msubsup
                      %mi A
                      %mn 2
                      %mo *
                    %msub
                      %mo ⋆
                      %mi H
                    %msubsup
                      %mi A
                      %mn 1
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    A_1 \star_H A_2
                    \\right)^\ast
                    \=
                    A_2^\ast \star_H A_1^\ast
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Wick+algebra#Collini16"} Collini 16, p. 25-26
          .proof
            %h6#proof_3 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#WaveFronSetsForKGPropagatorsOnMinkowski"}
              the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              has all cotangents on the first variables in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              (at the given base point, which itself is on the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
            %center
              %img{:src => "https://ncatlab.org/nlab/files/HadamardPropagator.png", :width => "60"}/
            %p
              and hence all those on the second variables in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
            %p
              The first variables are integrated against those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and the second against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A_2
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_2
              are disjoint from the subsets where all components are in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              or all components are in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
              %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of
              %a.existingWikiWord{:href => "/nlab/show/distributions+of+several+variables"} distributions of several variables
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#PartialProductOfDistributionsOfSeveralVariables"}
            %p
              It remains to see that the star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 \star_H A_2
              is itself again a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observable"} microcausal observable
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
              and that it respects the ideal generated by the equations of motion. That it still satisfies the condition on the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              follows directly from the fact that the wave front set of a
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              is inside the fiberwise sum of elements of the factor wave front sets (prop.
              = succeed "," do
                %a.maruku-ref{:href => "#WaveFrontSetOfProductOfDistributionsInsideFiberProductOfFactorWaveFrontSets"}
              = succeed ")." do
                %a.maruku-ref{:href => "#PartialProductOfDistributionsOfSeveralVariables"}
            %p
              Finally the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              follows via remark
              %a.maruku-ref{:href => "#WightmanPropagatorAsKaehlerVectorSpaceStructure"}
              as in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#StarProductAlgebraOfKaehlerVectorSpaceIsStarAlgebra"}
          #WickAlgebraIsFormalDeformationQuantization.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                is
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Poisson-Peierls+bracket"} Poisson-Peierls algebra of observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Φ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} P \Phi = 0
              with
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H \;=\; \tfrac{i}{2}\Delta + H
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              (
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+2-point+function"}> Hadamard 2-point function
              ).
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( PolyObs(E,\mathbf{L})_{mc}[ [\hbar] ] \,,\, \star_H \right)
              from prop.
              %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              given by the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Poisson-Peierls+bracket"} Poisson-Peierls bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo ⊗
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo →
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} \{-,-\} \;\colon\; PolyObs(E,\mathbf{L})_{mc} \otimes PolyObs(E,\mathbf{L})_{mc}  \to PolyObs(E,\mathbf{L})_{mc}
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in PolyObs(E,\mathbf{L})_{mc}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_H A_2
                    \\;=\;
                    A_1 \cdot A_2
                    \\;mod\;
                    \\hbar
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                    %mo −
                    %msub
                      %mi A
                      %mn 2
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi a
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mi ℏ
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℏ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_H A_2
                    \-
                    A_2 \star_H a_1
                    \\;=\;
                    i \hbar \{A_1, A_2\}
                    \\;mod\;
                    \\hbar^2
                    \\,.
          %p
            (
            %a{:href => "Wick+algebra#Dito90"}> Dito 90
            ,
            = succeed "," do
              %a{:href => "Wick+algebra#DuetschFredenhagen00"} Dütsch-Fredenhagen 00
            = succeed "," do
              %a{:href => "Wick+algebra#DuetschFredenhagen01"} Dütsch-Fredenhagen 01
            = succeed ")" do
              %a{:href => "Wick+algebra#HirschfeldHenselder02"} Hirshfeld-Henselder 02
          .proof
            %h6#proof_4 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              this is immediate from the general properties of the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MoyalStarProductIsFormalDeformationQuantization"}
            %p
              Explicitly, consider, without restriction of generality,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Φ
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_1 = \int (\alpha_1)_a(x) \mathbf{\Phi}^a(x)\, dvol_\Sigma(x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Φ
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
