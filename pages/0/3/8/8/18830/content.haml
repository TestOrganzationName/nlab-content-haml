            (e.g.
            = succeed ")" do
              %a{:href => "antibracket#HenneauxTeitelboim92"} Henneaux-Teitelboim 92, (15.105d)
          .proof
            %h6#proof_11 Proof
            %p
              With prop.
              %a.maruku-ref{:href => "#ComponentsBVOperator"}
              the first statement is a graded version of the analogous relation for an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≔
                    %msup
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mo ∂
                      %mi a
                    %msub
                      %mo ∂
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \Delta \coloneqq g^{a b} \partial_a \partial_b
              acting on
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f,g
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mi f
                    %mo ,
                    %mo ∇
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo −
                    %mi f
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(f \cdot g)
                    \\;=\;
                    (\nabla f, \nabla g) - \Delta(f) g - f \Delta(g)
                    \\,,
            %p
              by the
              %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mi f
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mo ∂
                      %mi b
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nabla f \coloneqq (g^{a b} \partial_b f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/gradient"} gradient
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi v
                      %mi a
                    %mi w
                    %mi b
                  %annotation{:encoding => "application/x-tex"} (v,w) \coloneqq g_{a b} v^a w b
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            %p
              That the BV-operator commutes with the time-ordering operator is clear from the fact that both of these are given by
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial
              %a.existingWikiWord{:href => "/nlab/show/functional+derivatives"} functional derivatives
              with
              %em
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          #TimeOrderedExponentialBVOperator.num_example
