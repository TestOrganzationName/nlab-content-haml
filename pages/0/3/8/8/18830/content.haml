                  %mi S
                  %mo ′
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \{-S',(-)\}_{\mathcal{T}}
            (prop.
            %a.maruku-ref{:href => "#GaugeFixedActionFunctionalTimeOrderedAntibracket"}
            below) plus a quantum correction, called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
            (def.
            %a.maruku-ref{:href => "#ForGaugeFixedFreeLagrangianFieldTheoryBVOperator"}
            below) or
            %em
              %a.existingWikiWord{:href => "/nlab/show/BV-Laplacian"} BV-Laplacian
            (prop.
            %a.maruku-ref{:href => "#ComponentsBVOperator"}
            below).
          %p
            Applied to
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            this relation is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
            (prop.
            %a.maruku-ref{:href => "#DysonSchwinger"}
            below), which expresses the
            = succeed "-correction" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of the
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge field
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            as seen by
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            of
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            (example
            %a.maruku-ref{:href => "#SchwingerDysonDistributional"}
            below.)
          %p
            After introducing
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
            via
            %a.existingWikiWord{:href => "/nlab/show/scattering+theory"} scattering theory
            in the
            %a{:href => "#InteractingQuantumFields"} next chapter
            the quantum correction to the
            %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            by the
            %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
            becomes the “
            %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"}> quantum master equation
            ” and the
            %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
            becomes the “
            %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"}> master Ward identity
            ”. When choosing
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            these identities become
            %em conditions
            to be satisfied by
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            choices in order for the interacting quantum BV-BRST differential, and hence for
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
            quantum observables, to be well defined in
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            = succeed "." do
              %em
                %a{:href => "#Renormalization"} Renormalization
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#WickAlgebraAbstract
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
          %p
            The abstract
            %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            of a
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            with
            %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic differential equation
            is directly analogous to the
            = succeed "-algebra" do
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
            %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
            with the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+space"} Kähler space
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
          #WightmanPropagatorAsKaehlerVectorSpaceStructure.num_remark
            %h6#remark Remark
            %p
              %strong
                (
