                        %mi Φ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Φ
                      %mrow
                        %msub
                          %mi a
                          %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^a(x)
                    \\;\coloneqq\;
                    \\delta(x-x_0) \delta^a_{a_0}
                    \\mathbf{\Phi}^{a_1}(x_1) \cdots \mathbf{\Phi}^{a_n}(x_n)
                    \\,.
            %p
              This choice makes
              %a.maruku-eqref{:href => "#eq:EquationSchwingerDyson"} (7)
              become the
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mi T
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mi δ
