              be a compatible
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
