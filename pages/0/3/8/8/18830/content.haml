              %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
              in terms of
              %a.existingWikiWord{:href => "/nlab/show/operator+products"} operator products
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/operator-valued+distributions"} operator-valued distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
