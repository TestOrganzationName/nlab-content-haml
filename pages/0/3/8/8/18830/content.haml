            %p
              In particular this means that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi a
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi k
                    %mo ,
                    %msub
                      %mi a
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_0,a_0) \neq (x_k, a_k)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} k \in \{1,\cdots ,n\}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mi δ
                          %mi S
                        %mrow
                          %mi δ
