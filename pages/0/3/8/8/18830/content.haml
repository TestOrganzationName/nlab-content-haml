              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
