                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi k
                            %mi T
                            %mrow
                              %mo (
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi Φ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mi ⋯
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi Φ
