              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ≔
                      %msup
                        %mi T
                        %mo *
                      %mo{:stretchy => "false"} [
