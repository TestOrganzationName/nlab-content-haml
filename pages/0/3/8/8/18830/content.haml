                          %mo ±
                      %annotation{:encoding => "application/x-tex"} \Delta_{\pm}
                  by definition are
                  %a.existingWikiWord{:href => "/nlab/show/support"} supported
                  in the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
