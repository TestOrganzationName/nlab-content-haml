          %h3#models_and_categorical_semantics Models and categorical semantics
          %p
            The first
            %a.existingWikiWord{:href => "/nlab/show/model"} model
            for
            %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional
            %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
            on
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            (instead of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            \=
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/0-groupoids"} 0-groupoids
          %ul
            %li#HofmannStreicher98
              %a.existingWikiWord{:href => "/nlab/show/Martin+Hofmann"}> Martin Hofmann
              ,
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
