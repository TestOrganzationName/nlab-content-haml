          %h2#idea Idea
          %p
            The
            %em scaling degree
            or
            %em degree of divergence
            (
            %a{:href => "#Steinmann71"}> Steinmann 71
            ) or more generally the
            %em degree
            (
            %a{:href => "#Weinstein78"}> Weinstein 78
            ) of a
            %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
            on
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            is a measure for how it behaves at the origin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^n
            under
            %a.existingWikiWord{:href => "/nlab/show/rescaling"} rescaling
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi λ
                  %mi x
                %annotation{:encoding => "application/x-tex"} x \mapsto \lambda x
            of the canonical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
          %p
            The concept controls the problem of
            %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
            from the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ∖
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \{0\}
            of the origin to all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theories"} perturbative quantum field theories
            via
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            freedom (“counter-terms”) in the construction.
          %h2#definition Definition
          #RescaledDistribution.num_defn
            %h6#definition_2 Definition
            %p
              %strong (rescaled distribution)
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty) \subset \mathbb{R}
              a
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi s
                                  %mi λ
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mi λ
                            %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^n
                    \&amp;\overset{s_\lambda}{\longrightarrow}&amp;
                    \\mathbb{R}^n
                    \\\
                    x &amp;\mapsto&amp; \lambda x
                    }
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              given by multiplication with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
              a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              on the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              the
              %em rescaled distribution
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+a+distribution"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} m_\lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi λ
                    %mo ≔
                    %msubsup
                      %mi s
                      %mi λ
                      %mo *
                    %mi u
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    u_\lambda
                    \\coloneqq
                    s_\lambda^\ast u
                    \\;\in\;
                    \\mathcal{D}'(\mathbb{R}^n)
                    \\,.
            %p Explicitly, this is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %msub
                                  %mi u
                                  %mi λ
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mi b
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi λ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi n
                            %mo{:stretchy => "false"} ⟨
                            %mi u
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi λ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D}(\mathbb{R}^n)
                    \&amp;\overset{ \langle  u_\lambda, - \rangle}{\longrightarrow}&amp;
                    \\mathbb{R}
                    \\\
                    b &amp;\mapsto&amp; \lambda^{-n} \langle u , b(\lambda^{-1}\cdot (-))\rangle
                    }
                    \\,.
            %p
              Similarly for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
              an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              which is invariant under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} s_\lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
              is is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mi λ
                      %mo ≔
                      %msubsup
                        %mi s
                        %mi λ
                        %mo *
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u_\lambda \coloneqq s_\lambda^\ast u
          #ScalingDegree.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"}> scaling degree of a distribution
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              which is invariant under
              %a.existingWikiWord{:href => "/nlab/show/rescaling"} rescaling
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} s_\lambda
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RescaledDistribution"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              on this subset. Then
            %ol
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sd
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi inf
                        %mrow
                          %mo {
                          %mi ω
                          %mo ∈
                          %mi ℝ
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mi lim
                            %mrow
                              %mi λ
                              %mo →
                              %mn 0
                          %msup
                            %mi λ
                            %mi ω
                          %msub
                            %mi u
                            %mi λ
                          %mo =
                          %mn 0
                          %mo }
                      %annotation{:encoding => "application/x-tex"}
                        sd(u)
                        \\;\coloneqq\;
                        inf
                        \\left\{
                        \\omega \in \mathbb{R}
                        \\;\vert\;
                        \\underset{\lambda \to 0}{\lim}
                        \\lambda^\omega u_\lambda
                        \= 0
                        \\right\}
                %p
                  of the set of
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  such that the
                  %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                  of the rescaled distribution
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi λ
                          %mi ω
                        %msub
                          %mi u
                          %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda^\omega u_\lambda
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#RescaledDistribution"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  one sets
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sd
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} sd(u) \coloneqq \infty
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
                  is the difference of the scaling degree by the
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  of the underlying space:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi sd
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(u) \coloneqq sd(u) - n
                    \\,.
          %h2#examples Examples
          #NonSingularDistributionsScalingDegree.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %msub
                      %mi u
                      %mi f
                  %annotation{:encoding => "application/x-tex"} u = u_f
              is a
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
              given by
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^\infty(X) \subset \mathcal{D}'(X)
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingDegree"}
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sd(u_f) \leq 0
                    \\,.
            %p
              Specifically if the first non-vanishing
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi α
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial_\alpha f(0)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at 0 occurs at order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi f
                  %annotation{:encoding => "application/x-tex"} u_f
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} -{\vert \alpha\vert}
          .proof
            %h6#proof Proof
            %p
              By definition we have for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
              any
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo ⟨
                              %msup
                                %mi λ
                                %mi ω
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi u
                                %mi f
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi λ
                              %mo ,
                              %mi n
                              %mo ⟩
                          %mtd
                            %mo =
                            %msup
                              %mi λ
                              %mrow
                                %mi ω
                                %mo −
                                %mi n
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi λ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi d
                              %mi n
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi λ
                              %mi ω
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi d
                              %mi n
                            %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left\langle
                    \\lambda^{\omega}
                    (u_f)_\lambda,
                    n
                    \\right\rangle
                    \&amp; =
                    \\lambda^{\omega-n}
                    \\underset{\mathbb{R}^n}{\int}
                    f(x) g(\lambda^{-1} x)
                    d^n x
                    \\\
                    \&amp; =
                    \\lambda^{\omega}
                    \\underset{\mathbb{R}^n}{\int}
                    f(\lambda x) g(x)
                    d^n x
                    \\end{aligned}
                    \\,,
            %p
              where in last line we applied
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
            %p
              The limit of this expression is clearly zero for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \omega \gt 0
            %p
              If moreover the first non-vanishing
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              occurs at order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} {\vert \alpha \vert} = k
              %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mi i
                        %msub
                          %mi α
                          %mi i
                        %mo !
                        %mo )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
