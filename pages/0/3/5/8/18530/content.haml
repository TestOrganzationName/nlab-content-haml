                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product distribution
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u,v \in \mathcal{D}'(\mathbb{R}^n)
              be two
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              such that
            %ol
              %li
                %p
                  both have finite
                  %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ScalingDegree"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"}
                        deg(u), deg(v) \lt \infty
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                  is well-defined
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mi v
                        %mo ∈
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        u v \in \mathcal{D}'(\mathbb{R}^n)
                %p
                  (in that their
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
                  satisfy
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            %p
              then the product distribution has
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              bounded by the sum of the separate degrees:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(u v)
                    \\;\leq\;
                    deg(u) + deg(v)
                    \\,.
          %p
            (
            %a{:href => "#BrunettiFredenhagen00"}> Brunetti-Fredenhagen 00, special case of lemma 6.6
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support of a distribution
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/order+of+a+distribution"} order of a distribution
          %h2#references References
          %p The concept of scaling degree is due to
          %ul
            %li#Steinmann71
              O. Steinmann,
              = succeed "," do
                %em Perturbation Expansions in Axiomatic Field Theory
          %p
            and the more general concept of
            %em degree
            due to
          %ul
            %li#Weinstein78
              %a.existingWikiWord{:href => "/nlab/show/Alan+Weinstein"}> Alan Weinstein
              ,
              = succeed "," do
                %em The order and symbol of a distribution
          %p
            Review and further developments in the context of
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            %a.existingWikiWord{:href => "/nlab/show/pAQFT"} pAQFT
            is in
          %ul
            %li#BrunettiFredenhagen00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"}> Romeo Brunetti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"} Klaus Fredenhagen
                = succeed "," do
                  %em Microlocal Analysis and Interacting Quantum Field Theories: Renormalization on Physical Backgrounds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math-ph/9903028"} math-ph/9903028
            %li
              %p
                Dorothea Bahns, Michał Wrochna,
                %em On-shell extension of distributions
                (
                %a{:href => "https://arxiv.org/abs/1210.5448"}> arXiv:1210.5448
                )
            %li#Duetsch18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+D%C3%BCtsch"}> Michael Dütsch
                , def. 3.32 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/From+classical+field+theory+to+perturbative+quantum+field+theory"} From classical field theory to perturbative quantum field theory
        .revisedby
