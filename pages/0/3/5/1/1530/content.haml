                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/10.5749/j.cttttp0k.9"} jstor:10.5749/j.cttttp0k.9
                = succeed "," do
                  %a{:href => "https://conservancy.umn.edu/bitstream/handle/11299/185660/11_06Birkhoff.pdf?sequence=1"} pdf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
