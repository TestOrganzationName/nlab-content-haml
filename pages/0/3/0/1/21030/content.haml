              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/round+chord+diagrams"} round chord diagrams
              %a.existingWikiWord{:href => "/nlab/show/M2-M5+brane+bound+states"} M2-M5 brane bound states
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
