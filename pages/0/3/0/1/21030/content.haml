                    %annotation{:encoding => "application/x-tex"} N^{(M5)}_i
                \-
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 5
                          %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi ℂ
                      %mi Rep
                    %annotation{:encoding => "application/x-tex"} \mathbf{N}^{(M5)}_i \in \mathfrak{su}(2)_{\mathbb{C}}Rep
            %p
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \{N^{(M2)}_i, N^{(M5)}_i\}_{i} \in (\mathbb{N} \times \mathbb{N})^I
              some
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finitely
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %p
              with total
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi dim
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %munder
                      %mo ⊕
                      %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msubsup
