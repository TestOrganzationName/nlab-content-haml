                    \\big)
                    \\;\;\in\;\;
                    \\mathfrak{su}(2)_{\mathbb{C}}Rep^{fin}
            %p
              denotes
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} representation
              containing
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N^{(M2)}_i
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summands
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msubsup
                        %mi N
