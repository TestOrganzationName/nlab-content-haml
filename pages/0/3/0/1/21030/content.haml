              %a.existingWikiWord{:href => "/nlab/show/multi-trace+observables"} multi-trace observables
              on these) is
            #eq:M2M5BraneBoundStateInWeightSystems.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
