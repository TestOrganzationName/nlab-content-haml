              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              (
              %a{:href => "su2#Complexification"} hence
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+linear+Lie+algebra"} special linear Lie algebra
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
