                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_0 \,\colon\, G \xrightarrow{\;} \Gamma \rtimes G
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi η
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi 𝒢
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    s
                    \\big(
                    \\eta_0(g)
                    \\big)
                    \\;=\;
                    (id_{\mathcal{G}})_0(g)
                    \\;=\;
                    g
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi pr
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ×
                    %mi G
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    s \,\coloneqq\, pr_2 \;\colon\; \Gamma \times G \xrightarrow{\;} G
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/source"} source
              map of the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p
              This means that the admissible
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \eta_0
              are precisely the
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} homomorphic
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ⋊
                      %mi G
                      %mover
                        %mo →
                        %mspace{:width => "thickmathspace"}
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \Gamma \rtimes G \xrightarrow{\;} G
              %a.existingWikiWord{:href => "/nlab/show/invertible+morphism"} invertiblity
              of all morphisms involved, every such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \eta_0
              is the component homomorphism of some 2-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} id_{\mathcal{G}}
            %p
              Therefore the statement
              %a.maruku-eqref{:href => "#eq:CrossedHomomorphismsBijectiveTo2Group2MorphismsOutOfIdG"} (8)
              follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup"}
            %p
              The analogous statement for general 2-morphisms is indicated in
              = succeed "." do
                %a{:href => "#Noohi07"} Noohi 07, p. 12
          %h3#in_relation_to_equivariant_bundles In relation to equivariant bundles
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Top)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Grp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi G
                  %mi Act
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \Gamma \,\in\, Grp\big( G Act(Top) \big)
            be
            %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
            which are
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
            (to be on the safe side). Then:
          %p
          #EquivariantConnectedComponentsOfEquivariantClassifyingSpaces.num_prop
            %h6 Proposition
            %p
              %strong (equivariant connected components of equivariant classifying spaces)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} G-equivariant
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi G
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} B_G \Gamma
              for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+bundle"} equivariant
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              exists, and the
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              %a.existingWikiWord{:href => "/nlab/show/compact+subgroups"} compact subgroups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              to the
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointActionOnCrossedHomomorphisms"}
              = succeed ")" do
                %a.maruku-ref{:href => "#CrossedHomomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              (with respect to the
              %a.existingWikiWord{:href => "/nlab/show/restricted+action"} restricted action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              on
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            #eq:EquivariantConnectedComponentsOfEquivariantClassifyingSpaces.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mrow
                      %mo (
                      %msup
                        %mrow
                          %mo (
                          %msub
                            %mi B
                            %mi G
                          %mi Γ
                          %mo )
                        %mi H
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi CrsHom
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi Γ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0
                    \\left(
                    \\left(
                    B_G \Gamma
                    \\right)^{H}
                    \\right)
                    \\;\;
                    \\simeq
                    \\;\;
                    CrsHom(H,\Gamma)_{/\sim}
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              After a little reformulation via Prop.
              %a.maruku-ref{:href => "#GraphOfACrossedHomomorphism"}
              and Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup"}
              = succeed "," do
                %a{:href => "equivariant+bundle#LashofMay86"} Lashof &amp; May 1986, Thm. 10
              = succeed "." do
                %a{:href => "#May90"} May 1990, Thm. 7
          %p
            In view of the explicit construction of universal equivariant principal bundles in
            = succeed "," do
              %a{:href => "#MurayamaShimakawa95"} Murayama &amp; Shimakawa 1995
            %a.maruku-ref{:href => "#EquivariantConnectedComponentsOfEquivariantClassifyingSpaces"}
            on elementary grounds, as follows:
          %p
            Consider the following
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action+objects"} action objects
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Groupoids"} Groupoids
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Γ
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Γ
                      %mo ⇉
                      %mo *
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mi Act
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Groupids
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}\Gamma
                      \\,\coloneqq\,
                      \\big( \Gamma \rightrightarrows \ast\big)
                      \\;\;\;
                      \\in
                      \\;
                      G Act\big( Groupids \big)
              %p
                via the
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                by
                %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi G
                      %mo ×
                      %mi G
                      %mo ⇉
                      %mi G
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{E}G
                      \\,\coloneqq\,
                      \\big( G \times G \rightrightarrows G\big)
              %p
                via the left multiplication action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on all three copies of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
              #eq:EquivariantFunctorGroupoidFromEGToBGamma.maruku-equation
                %span.maruku-eq-number (10)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fnctr
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi G
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Γ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mi Act
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Groupids
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      Fnctr
                      \\big(
                      \\mathbf{E}G
                      ,\,
                      \\mathbf{B}\Gamma
                      \\big)
                      \\;\;\;
                      \\in
                      \\;
                      G Act\big( Groupids \big)
              %p
                with the induced
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                on component functions of
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                and
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ↦
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo ⋅
                      %mi F
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      g \,\colon\, F(-) \,\mapsto\,  g \cdot F\big( g^{-1}\cdot (-) \big)
                      \\,.
          %p
          #HFixedLociOFMappingGroupoidFromEGToBGamma.num_prop
            %h6 Proposition
            %p
              %strong
                (crossed homomorphisms are
                %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
                in
                %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
                from
                %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi E
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{E}G
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}\Gamma
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
              (in fact of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fnctr
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi CrsHom
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⫽
                      %mrow
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mi ad
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    Fnctr
                    \\big(
                    \\mathbf{E}G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\big)^H
                    \\;\simeq\;
                    CrsHom(H,\Gamma)
                    \\sslash_{\!\!ad}
                    \\Gamma
            %p between
            %ul
              %li
                %p
                  the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed
                  sub-groupoid of the functor groupoid
                  %a.maruku-eqref{:href => "#eq:EquivariantFunctorGroupoidFromEGToBGamma"} (10)
                  and
              %li
                %p
                  the conjugation groupoid
                  %a.maruku-eqref{:href => "#eq:ConjugationGroupoidOfCrossedHomomorphismsInPropRelatingToSlicedFunctor"} (4)
                  of crossed homomorphisms
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo →
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} H \to \Gamma
            %p
          This is essentially the statement of
          = succeed "." do
            %a{:href => "#GuillouMayMerling17"} Guillou, May &amp; Merling 2017, Thm. 4.14, Cor. 4.15
          = succeed "." do
            %a{:href => "https://ncatlab.org/schreiber/show/TED+cohomology"} SS21
