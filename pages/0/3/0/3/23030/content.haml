          %p
          #CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup.num_prop
            %h6 Proposition
            %p
              %strong
                (as splittings/
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphic
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
