              %br/
              Crossed homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} G \to \Gamma
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CrossedHomomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} homomorphic
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              out of the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⋊
                      %mi α
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Gamma \rtimes_\alpha G \xrightarrow{pr_2} G
              (see also at
              = succeed "):" do
                %a{:href => "group+extension#SplitExtensionsAndSemidirectProductGroups"} split group extensions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CrsHom
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi GrpHom
                      %mrow
                        %msub
                          %mrow
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi Γ
                    %msub
                      %mo ⋊
                      %mi α
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi GrpHom
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi Γ
                    %msub
                      %mo ⋊
                      %mi α
                    %mi G
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi GrpHom
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi G
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} {
                    %mi id
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CrsHom(G,\,\Gamma)
                    \\;\simeq\;
                    GrpHom_{{}_{/G}}
                    \\big(
                    G
                    ,\,
                    \\Gamma \rtimes_\alpha G
                    \\big)
                    \\;\coloneqq\;
                    GrpHom(G, \, \Gamma \rtimes_\alpha G)
                    \\underset{
                    GrpHom(G,\,G)
                    }{\times}
                    \\{id\}
                    \\,.
            %p
          (e.g.
          = succeed "," do
            %a{:href => "#Brown82"} Brown 1982, p. 88
          = succeed "," do
            %a{:href => "#NSW08"} NSW 2008, Ex. 1 on p. 24
          = succeed ")" do
            %a{:href => "#Milne17"} Milne 2017, Ex. 15.1 (16.1 in the pdf)
          .proof
            %h6 Proof
            %p
              By immediate unwinding of the definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⋊
                              %mi α
                            %mi G
                        %mtr
                          %mtd
                            %mi g
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi g
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\xrightarrow{\;}&amp; \Gamma \rtimes_\alpha G
                    \\\
                    g
                    \&amp;\mapsto&amp;
                    \\big(
                    \\phi(g), \, g
                    \\big)
                    }
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                        %mo ,
                        %msub
                          %mi g
                          %mn 2
                        %mo ∈
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi g
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo =
                      %mo !
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⋅
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi α
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi g
                      %mn 2
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    g_1, g_2 \in G
                    }{\forall}
                    \\;\;\;\;\;
                    \\big(
                    \\phi(g_1 \cdot g_2), \, g_1 \cdot g_2
                    \\big)
                    \\;\overset{!}{=}\;
                    \\big(
                    \\phi(g_1), g_1
                    \\big)
                    \\cdot
                    \\big(
                    \\phi(g_2), g_2
                    \\big)
                    \\;=\;
                    \\Big(
                    \\phi(g_1)
                    \\cdot
                    \\alpha(g_1)\big(\phi(g_2)\big)
                    ,\,
                    g_1 \cdot g_2
                    \\Big)
                    \\,.
            %p
          %p
          #GraphOfACrossedHomomorphism.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graphs
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphisms"} crossed homomorphisms
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
              of a
              %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphism"} crossed homomorphism
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CrossedHomomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            #eq:MayStyleCrossedHomomorphism.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⋊
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext such that
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} pr
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi G
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ≃
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi G
                      %mo ^
                    %mo ∩
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} e
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat G
                    \\;\subset\;
                    \\Gamma \rtimes G
                    \\,,
                    \\;\;\;\;
                    \\text{such that}
                    \\;\;\;\;
                    \\mathrm{pr}_2\big(\widehat G\big) \simeq G
                    \\;\;\;
                    \\text{and}
                    \\;\;\;
                    \\widehat{G} \cap i(\Gamma)
                    \\;=\;
                    \\big\{
                    (\mathrm{e},\,\mathrm{e})
                    \\big\}
                    \\,,
            %p
              and every subgroup of this form arises as the
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph
              of a unique crossed homomorphism.
          This is, essentially, considered in
          = succeed "," do
            %a{:href => "#tomDieck69"} tom Dieck 1969, Sec. 2.1
          = succeed "." do
            %a{:href => "#GuillouMayMerling17"} Guillou, May &amp; Merling 2017, Lem. 4.5
          .proof
            %h6 Proof
            %p The first statement is immediate from the definition.
            %p
              For the converse, consider a subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{G}
              as in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:MayStyleCrossedHomomorphism"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi G
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi α
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi γ
                    %mo ′
                    %mo ⋅
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} e
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi G
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\gamma,g), (\gamma',g) \,\in\, \widehat{G}
                    \\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;
                    (\gamma' ,\, g) \cdot (\gamma ,\, g)^{-1}
                    \\;=\;
                    (\gamma' ,\, g)
                    \\cdot
                    \\big(
                    \\alpha(g^{-1})(\gamma^{-1})
                    ,\,
                    g^{-1}
                    \\big)
                    \\;=\;
                    \\big(
                    \\gamma' \cdot \gamma^{-1}
                    ,\,
                    \\mathrm{e}
                    \\big)
                    \\;\;\;
                    \\in
                    \\;
                    \\widehat{G}
                    \\,.
            %p
              From this the second condition in
              %a.maruku-eqref{:href => "#eq:MayStyleCrossedHomomorphism"} (1)
              implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi G
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi γ
                    %mo =
                    %mi γ
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\gamma,\,g) ,\, (\gamma',\, g)
                    \\;\in\;
                    \\widehat{G}
                    \\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;
                    \\gamma = \gamma'
                    \\,.
            %p
              Together with the first condition in
              %a.maruku-eqref{:href => "#eq:MayStyleCrossedHomomorphism"} (1)
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{G}
              is the
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mo →
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \phi \;\colon\; G \to \Gamma
              = succeed "." do
                %a.maruku-ref{:href => "#CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup"}
          %p
          .num_remark
            %h6 Remark
            %p
              Subgroups of the form
              %a.maruku-eqref{:href => "#eq:MayStyleCrossedHomomorphism"} (1)
              are considered throughout articles by
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              on
              %a.existingWikiWord{:href => "/nlab/show/equivariant+principal+bundles"} equivariant principal bundles
              (e.g. in
              = succeed "," do
                %a{:href => "equivariant+bundle#LashofMay86"} Lashof &amp; May 1986, Thm. 10
              = succeed ")." do
                %a{:href => "equivariant+bundle#May90"} May 1990, Thm. 7
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graphs
              of)
              %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphisms"} crossed homomorphisms
              may have been one the key observations that lead to
              = succeed "," do
                %a{:href => "#MurayamaShimakawa95"} Murayama &amp; Shimakawa 1995
              %a.maruku-ref{:href => "#GraphOfACrossedHomomorphism"}
              was still not explicit there.
          %p
          #AdjointActionOnCrossedHomomorphisms.num_defn
            %h6 Definition
            %p
              %strong (crossed conjugation)
              %br/
              Two crossed homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_1, \phi_2
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CrossedHomomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi γ
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ϕ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_1 \xrightarrow{\;\gamma\;} \phi_2
              if in their incarnation as homomorphisms to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Gamma \rtimes G
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup"}
              %br/
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo ∈
                      %mi Γ
                      %mover
                        %mo ↪
                        %mspace{:width => "thickmathspace"}
                      %mi Γ
                      %mo ⋊
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \gamma \in \Gamma \xhookrightarrow{\;} \Gamma \rtimes G
            #eq:CrossedConjugationRelation.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    g \in G
                    }{\forall}
                    \\;\;\;\;
                    \\phi_2(g)
                    \\;=\;
                    \\gamma^{-1}
                    \\cdot
                    \\phi_1(g)
                    \\cdot
                    \\alpha(g)(\gamma)
                    \\,.
            %p
          (e.g.
          = succeed "," do
            %a{:href => "#GilleSzamuely06"} Gille &amp; Szamuely 2006, (2) on p. 25
          = succeed ")" do
            %a{:href => "#GuillouMayMerling17"} Guillou, May &amp; Merling 2017, Def. 4.11
          #AsCoboundariesInGroupCohomology.num_remark
            %h6 Remark
            %p
              %strong
                (as 1-
                %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              %br/
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.maruku-ref{:href => "#AdjointActionOnCrossedHomomorphisms"}
              of the constant function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} const_{0}
              (Exp.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConstantFunctionOnNeutralElement"}
            #eq:GroupCoboundaryInSpecializationOfConjugation.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi γ
                  %annotation{:encoding => "application/x-tex"}
                    g \;\mapsto\; \alpha(g)(\gamma) - \gamma
            %p
              (writing now in additive notation as befits an
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %p
              These
              %a.maruku-eqref{:href => "#eq:GroupCoboundaryInSpecializationOfConjugation"} (3)
              are also known as “principal crossed homomorphisms”.
            %p
              With crossed homomorphisms understood as 1-
