          %h3#ComponentDefinition Component definition
          %p
          #CrossedHomomorphism.num_defn
            %h6 Definition
            %p
              A
              %em crossed homomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
