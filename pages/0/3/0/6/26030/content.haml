                %use{:x => "60.305729", "xlink:href" => "#u021L9pz094SHE49Gus7Q-GlPaU=-glyph5-1", :y => "30.400383"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "64.058077", "xlink:href" => "#u021L9pz094SHE49Gus7Q-GlPaU=-glyph3-1", :y => "30.400383"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "67.947997", "xlink:href" => "#u021L9pz094SHE49Gus7Q-GlPaU=-glyph1-6", :y => "30.400383"}
          %p
            respectively, and consider a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Mon
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A \,\in\, Mon\big(\mathcal{C}\big)
                  \\,.
          %p
            Recall that the “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            \-
            %a.existingWikiWord{:href => "/nlab/show/action+monad"}> action monad
            ” induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            – often called the “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            \-
            %a.existingWikiWord{:href => "/nlab/show/writer+monad"}> writer monad
            ” when considered as a
            %a.existingWikiWord{:href => "/nlab/show/monad+in+computer+science"} monad in computer science
            – is the
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            of forming the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mtext -
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  A \otimes (\text{-})
                  \\;\colon\;
                  \\mathcal{C} \to \mathcal{C}
          %p
            equipped with unit and multiplication structure morphisms induced, under the tensor product, from the unit and multiplication on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            The analogous construction but with the tensor product replaced by the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mtext -
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  [A,\, \text{-}]
                  \\;\colon\;
                  \\mathcal{C} \to \mathcal{C}
          %p
            which in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            tends to be written
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mtext -
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (A \to \text{-})
                  \\;\colon\;
                  \\mathcal{C} \to \mathcal{C}
                  \\,,
          %p
            gives a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            which hence deserves to be called the
            %em coaction comonad
            or
            %em cowriter comonad
            induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Alternatively, one might think to
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dualize
            the notion of the
            %a.existingWikiWord{:href => "/nlab/show/writer+monad"} writer monad
            by considering a
            = succeed "-object" do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi CoMon
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  B \,\in\, CoMon(\mathcal{C})
          %p
            and the induced comonad structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \otimes (\text{-})
          %p
            But if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is in fact a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            out of the
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            with the
            %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual
            %a.existingWikiWord{:href => "/nlab/show/comonoid+object"} comonoid object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mtext -
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mtext -
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [A,\,\text{-}]
                  \\;\simeq\;
                  A^\ast \otimes (\text{-})
                  \\,.
          %p
            Finally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            carries both
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            in a compatible way to make a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+monoid"} Frobenius monoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
