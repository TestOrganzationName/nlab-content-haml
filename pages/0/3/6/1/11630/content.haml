                          %mi E
                          %mn 10
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(E_{10})
                (
                %a{:href => "https://arxiv.org/abs/1504.01586"}> arXiv:1504.01586
                )
            %li#MeissnerNicolai18a
              %p
                Krzysztof A. Meissner,
