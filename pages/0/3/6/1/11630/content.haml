                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
                ,
                = succeed "," do
                  %em On Exceptional Geometry and Supergravity
                %a{:href => "http://www.lestudium-ias.com/#!registration-conference-21-may-gibbons/ci2z"} Gravitation, Solitons and Symmetries
                (
                %a.existingWikiWord{:href => "/nlab/files/NicolaiTalk14.pdf", :title => "pdf"}> pdf
                )
          %p
            Discussion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Axel+Kleinschmidt"}> Axel Kleinschmidt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                %em
                  Standard model fermions and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
