            parameterized by the
            %a.existingWikiWord{:href => "/nlab/show/homogeneous+spaces"} homogeneous spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  E_{n(n)}/ K_n
          %p for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 11
                  %mo −
                  %mi d
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  n = 11 - d
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} K_n
            is the
            %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{n(n)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 8
                  %mo ≃
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 16
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi K
                    %mn 7
                  %mo ≃
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 8
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi K
                    %mn 6
                  %mo ≃
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K_8 \simeq Spin(16), K_7 \simeq SU(8), K_6 \simeq Sp(4)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 5
                  %mo ≃
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi K
                    %mn 4
                  %mo ≃
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi K
                    %mn 3
                  %mo ≃
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  K_5 \simeq Spin(5) \times Spin(5),
                  K_4 \simeq Spin(5),
                  K_3 \simeq SU(2) \times SO(2)
                  \\,.
          %p
            Therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{n(n)}
            acts as a
            %a.existingWikiWord{:href => "/nlab/show/global+symmetry"} global symmetry
            on the supergravity fields and more generally certain
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of it are “gauged” (have
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            %a.existingWikiWord{:href => "/nlab/show/gauged+supergravity"} gauged supergravity
            version.
          %p
            So for instance maximal
            %a.existingWikiWord{:href => "/nlab/show/3d+supergravity"} 3d supergravity
            has global (and in fact also local, see there) gauge group given by (the
            %a.existingWikiWord{:href => "/nlab/show/split+real+form"} split real form
            of)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E8"} E8
          %p
            This is no longer verbatim true for their
            %a.existingWikiWord{:href => "/nlab/show/UV-completion"} UV-completion
            by the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+mechanism"} compactifications
            of
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            (e.g.
            %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete subgroup
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E_{n(n)}(\mathbb{Z}) \hookrightarrow E_{n(n)}
          %p
            acts as global symmetry. This is called the
            %strong U-duality
            group of the supergravity theory.
          %p
            It has been argued that this pattern should continue in some way further to the remaining values
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi d
                    %mo &lt;
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 0 \leq d \lt 3
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/Kac-Moody+groups"} Kac-Moody groups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E9"} E9
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E10"} E10
            %a.existingWikiWord{:href => "/nlab/show/E11"} E11
            corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/Kac-Moody+algebras"} Kac-Moody algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔢
                    %mn 9
                  %mo ,
                  %msub
                    %mi 𝔢
                    %mn 10
                  %mo ,
                  %msub
                    %mi 𝔢
                    %mn 11
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{e}_9, \mathfrak{e}_10, \mathfrak{e}_{11}
                  \\,.
          %p
            Continuing in the other direction to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 10
                %annotation{:encoding => "application/x-tex"} d = 10
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            ) connects to the
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
