                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(d,d,\mathbb{Z})
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
