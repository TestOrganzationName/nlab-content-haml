                  E_{3(3)} \coloneqq SL(3, \mathbb{R}) \times SL(2, \mathbb{R})
                  \\,.
          %p
            For instance the
            %a.existingWikiWord{:href => "/nlab/show/scalar+fields"} scalar fields
            in the field
            %a.existingWikiWord{:href => "/nlab/show/supermultiplet"} supermultiplet
            of
            = succeed "-dimensional" do
