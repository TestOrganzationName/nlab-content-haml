                = succeed "," do
                  %em Standard Model Fermions and Infinite-Dimensional R-Symmetries
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1804.09606"} arXiv:1804.09606
            %li#MeissnerNicolai18b
              %p
                Krzysztof A. Meissner,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em Planck Mass Charged Gravitino Dark Matter
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1809.01441"} arXiv:1809.01441
          %h3#_7
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 11
                %annotation{:encoding => "application/x-tex"} n=11
          %p
            The case of of
            %a.existingWikiWord{:href => "/nlab/show/E11"} E11
            is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 11
                        %annotation{:encoding => "application/x-tex"} E_{11}
                    and M-theory
                = succeed ")." do
                  %a{:href => "http://arxiv.org/abs/hep-th/0104081"} arXiv:hep-th/0104081
            %li#West16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
                ,
                %em A brief review of E theory
                (
                %a{:href => "http://arxiv.org/abs/1609.06863"}> arXiv:1609.06863
                )
          %h3#_8
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
