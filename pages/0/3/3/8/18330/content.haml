          %h3#abstract_definition Abstract definition
          %p
          .num_defn
            %h6 Definition
            %p
              %strong Two categories with the same collection of objects with an identity-on-objects functor
              is a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              enriched in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi I
                  %annotation{:encoding => "application/x-tex"} Set^I
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            See also
            %a.existingWikiWord{:href => "/nlab/show/M-category"} M-category
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/F-category"} F-category
          %h3#by_components By components
          %p
            First, we distinguish between a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/collection"} collection
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %a.existingWikiWord{:href => "/nlab/show/proset"} proset
            and a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong category structure
              on a collection of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} Ob
              is a family of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor(x, y)
              whose elements are called morphisms, indexed by objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} x:Ob
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} y:Ob
            %ul
              %li
                for each object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} x:Ob
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi x
                      %mo :
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{id}_x:Mor(x, x)
              %li
                for each object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} x:Ob
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} y:Ob
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} z:Ob
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                      %mo :
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \circ_{x, y, z}:Mor(y, z) \times Mor(x, y) \to Mor(x, z)
            %p such that
            %ul
              %li
                for each object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} x:Ob
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} y:Ob
                and morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:Mor(x, y)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo ∘
                        %mrow
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %mi y
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi x
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f \circ_{x, x, y} \mathrm{id}_x = f
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi y
                        %msub
                          %mo ∘
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                            %mo ,
                            %mi y
                        %mi f
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \mathrm{id}_y \circ_{x, y, y} f = f
              %li
                for each object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} x:Ob
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} y:Ob
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo :
                        %mi Ob
                      %annotation{:encoding => "application/x-tex"} z:Ob
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} w:Ob
                and morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:Mor(x, y)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g:Mor(y, z)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo ,
                        %mi w
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} h:Mor(z, w)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %msub
                          %mo ∘
                          %mrow
                            %mi x
                            %mo ,
                            %mi z
                            %mo ,
                            %mi w
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mo ∘
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                            %mo ,
                            %mi z
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi h
                        %msub
                          %mo ∘
                          %mrow
                            %mi y
                            %mo ,
                            %mi z
                            %mo ,
                            %mi w
                        %mi g
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ∘
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                            %mo ,
                            %mi w
                        %mi f
                      %annotation{:encoding => "application/x-tex"} h \circ_{x, z, w} (g \circ_{x, y, z} f) = (h \circ_{y, z, w} g) \circ_{x, y, w} f
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} Ob
              with a category structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor(x, y)
              indexed by objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} x:Ob
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} y:Ob
          %p
          .num_defn
            %h6 Definition
            %p
              %strong Two categories with the same collection of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} Ob
              with two category structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mor
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor_A(x, y)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mor
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor_B(x, y)
              indexed by objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi Ob
                  %annotation{:encoding => "application/x-tex"} x:Ob
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi Ob
                    %annotation{:encoding => "application/x-tex"} y:Ob
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are defined to be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ob
                    %mo ,
                    %msub
                      %mi Mor
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ob, Mor_A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ob
                    %mo ,
                    %msub
                      %mi Mor
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ob, Mor_B)
              respectively.
          %p
          .num_defn
            %h6 Definition
            %p
              %strong An identity-on-objects functor
              between two categories with the same collection of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a family of functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Mor
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Mor
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{Mor}(x, y):Mor_A(x, y) \to Mor_B(x, y)
              which preserve the category structure on the type families:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  is preserved: for all morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msub
                          %mi Mor
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:Mor_A(x, y)
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo :
                          %msub
                            %mi Mor
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} g:Mor_B(y, z)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %msubsup
                            %mo ∘
                            %mrow
                              %mi x
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                            %mi A
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %msubsup
                            %mo ∘
                            %mrow
                              %mi x
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                            %mi B
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F_{Mor}(x, z)(g \circ^A_{x, y, z} f) = F_{Mor}(y, z)(g) \circ^B_{x, y, z} F_{Mor}(x, y)(f)
              %li
                %p
                  identity morphisms are preserved:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi id
                            %mi x
                            %mi A
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msubsup
                            %mi id
                            %mi x
                            %mi B
                        %annotation{:encoding => "application/x-tex"} F_{Mor}(x, x)(id^A_x) = id^B_x
            %p
          %h3#historical_note Historical note
          %h4#the_notion_of_two_categories_with_the_same_collection_of_objects The notion of two categories with the same collection of objects
          %p What does it mean for two categories to have the same collection of objects?
          %p
            The current definition defines such a structure as having one collection of object and two category structures. In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            whose collections of objects are
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmentally equal
            to each other:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ob
                      %mi A
                    %mo ≡
                    %msub
                      %mi Ob
                      %mi B
                  %annotation{:encoding => "application/x-tex"} Ob_A \equiv Ob_B
          %p
            Historically, authors have tried to use
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            to define two categories with the same collection of objects. However, this runs into a number of problems:
          %ul
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/material+set+theories"} material set theories
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ob
                        %mo =
                        %mi ob
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ob
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ob = ob(A) = ob(B)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %li
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
                such as
                %a.existingWikiWord{:href => "/nlab/show/SEAR"} SEAR
                or
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/ETCS+with+elements"} ETCS with elements
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relations"} relations
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/elements"} elements
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bijective-on-objects+functor"} bijective-on-objects functor
            %li
              %p
                In type theory,
                %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
                is represented by the
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
                or the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/path+type"} path type
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
                %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi Ob
                      %msub
                        %mo =
                        %mi 𝒰
                      %mi ob
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a:Ob =_\mathcal{U} ob(A)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo :
                        %mi Ob
                        %msub
                          %mo =
                          %mi 𝒰
                        %mi ob
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} b:Ob =_\mathcal{U} ob(B)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi a
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi b
                        %mo :
                        %mi ob
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi 𝒰
                        %mi ob
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a^{-1} b: ob(A) =_\mathcal{U} ob(B)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalence
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalent-on-objects+functor"} equivalent-on-objects functor
          %p
            Hence, the notion of “two categories with the same collection of objects” is somewhat of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"} red herring
          %h4#is_the_identityonobjects_functor_a_functor Is the identity-on-objects functor a functor?
          %p
            Historically, the notion of
            %strong identity-on-objects functor
            in between two categories with the same collection of objects was defined to be an actual functor, additionally having a function on the objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi Ob
                  %mo :
                  %msub
                    %mi Ob
                    %mi C
                  %mo →
                  %msub
                    %mi Ob
                    %mi C
                %annotation{:encoding => "application/x-tex"} F_{Ob}:Ob_C \to Ob_C
            which is the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ob
                      %mi C
                  %annotation{:encoding => "application/x-tex"} Ob_C
          %ul
            %li
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
                or
                %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
                or a type theory with
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
                %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
                if one were to use it to define concrete
                %a.existingWikiWord{:href => "/nlab/show/dagger+categories"} dagger categories
                such as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
                %a.existingWikiWord{:href => "/nlab/show/Hilb"} Hilb
                or concrete
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                such as the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/permutation+category"} permutation category
                %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %li
              %p
                In a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/univalent+type+theory"} univalent type theory
                %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
                do not necessarily violate the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi Ob
                      %mi x
                    %annotation{:encoding => "application/x-tex"} id(x) =_Ob x
                for object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
                is not necessarily a proposition, and in the presence of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
                %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi id
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi Ob
                      %mi x
                    %annotation{:encoding => "application/x-tex"} p(x):id(x) =_Ob x
                are additional structure on the mathematical object, and thus does not result in the same object as the definitions above do.
          %p
            As a result, the current definition of an identity-on-objects functor, valid in all foundations and respecting the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"} red herring
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between the two objects collections.
          %h2#contravariant_endofunctor_which_is_the_identityonobjects Contravariant endofunctor which is the identity-on-objects
          %p
            Sometimes we want an identity-on-objects functor which behaves like a
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong contravariant endofunctor which is the identity-on-objects
              on a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a family of functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{Mor}(x, y):Mor(x, y) \to Mor(y, x)
              such that
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  is reversed: for all morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msub
                          %mi Mor
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f: Mor_A(x, y)
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo :
                          %msub
                            %mi Mor
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} g:Mor_B(y, z)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %msub
                            %mo ∘
                            %mrow
                              %mi x
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ∘
                            %mrow
                              %mi x
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F_{Mor}(x, z)(g \circ_{x, y, z} f) = F_{Mor}(x, y)(f) \circ_{x, y, z} F_{Mor}(y, z)(g)
              %li
                %p
                  identity morphisms are preserved:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi id
                            %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi id
                            %mi x
                        %annotation{:encoding => "application/x-tex"} F_{Mor}(x, x)(id_x) = id_x
            %p
          %p
            This is used in particular for defining
            %a.existingWikiWord{:href => "/nlab/show/dagger+categories"} dagger categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
          %h2#examples Examples
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger category
                is a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                with an identity-on-objects contravariant endofunctor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mo †
                              %mrow
                                %mi A
                                %mo ,
                                %mi B
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-)^{\dagger_{A, B}}:Mor(A,B) \to Mor(B, A)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} A:\mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo :
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} B:\mathcal{C}
                and morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:Hom(A,B)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mrow
                            %msub
                              %mo †
                              %mrow
                                %mi A
                                %mo ,
                                %mi B
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mo †
                              %mrow
                                %mi B
                                %mo ,
                                %mi A
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} (f^{\dagger_{A, B}})^{\dagger_{B, A}} = f
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                is a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                with an identity-on-objects contravariant endofunctor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi A
                              %mo ,
                              %mi B
                      %mo :
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)^{(-1)_{A, B}}:Mor(A,B) \to Mor(B, A)
                such that for all objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} A:\mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo :
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} B:\mathcal{C}
                and morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:Hom(A,B)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msup
                        %mi f
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi A
                              %mo ,
                              %mi B
                      %mo =
                      %msub
                        %mi id
                        %mi B
                    %annotation{:encoding => "application/x-tex"} f \circ f^{(-1)_{A, B}} = id_B
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi A
                                %mo ,
                                %mi B
                        %mo ∘
                        %mi f
                        %mo =
                        %msub
                          %mi id
                          %mi A
                      %annotation{:encoding => "application/x-tex"} f^{(-1)_{A, B}} \circ f = id_A
