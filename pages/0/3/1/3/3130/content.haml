                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+L%C3%BCck"}> Wolfgang Lück
                ,
                = succeed "," do
                  %em Chern characters for proper equivariant homology theories and applications to K- and L-theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1515/crll.2002.015"} doi:10.1515/crll.2002.015
                = succeed ")" do
                  %a{:href => "https://www.him.uni-bonn.de/lueck/data/eh.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+L%C3%BCck"}> Wolfgang Lück
                ,
                = succeed "," do
                  %em Equivariant Cohomological Chern Characters
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0401047"} arXiv:math/0401047
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0218196705002773"} doi:10.1142/S0218196705002773
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+L%C3%BCck"}> Wolfgang Lück
                ,
                = succeed "," do
                  %em Equivariant Chern characters
                = succeed "," do
                  %a{:href => "https://www.him.uni-bonn.de/lueck/data/goettingen_equi_Chern061130trans.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/LuckEquivariantChernCharacters.pdf", :title => "pdf"} pdf
          %h3#in_derived_algebraic_geometry In derived algebraic geometry
          %p
            Discussion of Chern characters in terms of
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space+objects"} free loop space objects
            in
