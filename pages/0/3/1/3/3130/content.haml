                    {}^{ \mathllap{ \psi^k } }
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    {}^{ \mathrlap{ \psi^k_H } }
                    \\\
                    K(X)
                    \&amp;\underset{\;\;\;ch\;\;\;}{\longrightarrow}&amp;
                    H^{ev}(X;\,\mathbb{Q})
                    \\,,
                    }
          %p
            (
            %a{:href => "Adams+operations#Adams62"}> Adams 62, Thm. 5.1. (vi)
            , review in
            = succeed "," do
              %a{:href => "Adams+operations#Karoubi78"} Karoubi 78, Chapter V, Theorem 3.27
            = succeed ")" do
              %a{:href => "#Maakestad06"} Maakestad 06, Thm. 4.9
          .proof
            %h6#proof_idea Proof idea
            %p
              Use the exponentional-formula for the
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
          %h2#related_concepts Related concepts
          %ul
