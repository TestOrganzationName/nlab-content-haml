              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriele+Vezzosi"} Gabriele Vezzosi
              %em Caractères de Chern, traces équivariantes et géométrie algébrique dérivée
              (
              %a{:href => "http://arxiv.org/abs/0903.3292"}> arXiv:0903.3292
              )
          %p See also
          %ul
