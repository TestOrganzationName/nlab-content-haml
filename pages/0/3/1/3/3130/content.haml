          %h2#references References
          %h3#chern_character_on_ktheory Chern character on K-theory
          %p
            Original Discussion of the Chern character on complex
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li#Hirzebruch56
              %p
                %a.existingWikiWord{:href => "/nlab/show/Friedrich+Hirzebruch"}> Friedrich Hirzebruch
                , Section 12.1 of:
                = succeed "," do
                  %em Neue topologische Methoden in der Algebraischen Geometrie
                = succeed ")" do
                  %a{:href => "https://www.springer.com/de/book/9783662406052"} doi:10.1007/978-3-662-41083-7
            %li#BorelHirzebruch58
              %p
                %a.existingWikiWord{:href => "/nlab/show/Armand+Borel"}> Armand Borel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Friedrich+Hirzebruch"} Friedrich Hirzebruch
                = succeed "," do
                  %em Characteristic Classes and Homogeneous Spaces, I
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/2372795"} jstor:2372795
            %li#AtiyahHirzebruch61
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+F.+Atiyah"}> M. F. Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/F.+Hirzebruch"} F. Hirzebruch
                = succeed "," do
                  %em Vector bundles and homogeneous spaces
                = succeed "," do
                  %a{:href => "http://hirzebruch.mpim-bonn.mpg.de/87/"} web
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/9789814401319_0008"} doi:10.1142/9789814401319_0008
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=0139181"} MR 0139181
            %li#Hilton71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"}> Peter Hilton
                ,
                = succeed "," do
                  %em General cohomology theory and K-theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511662577"} doi:10.1017/CBO9780511662577
            %li#Karoubi78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                , Chapter V.3 of:
                = succeed "," do
                  %em K-Theory – An introduction
                = succeed "," do
                  %a{:href => "https://webusers.imj-prg.fr/~max.karoubi/K.book/MK.book.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007%2F978-3-540-79890-3"} doi:10.1007%2F978-3-540-79890-3
          %p Further discussion
          %ul
            %li#Maakestad06
              %p
                Helge Maakestad,
                = succeed "," do
                  %em Notes on the Chern-character
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0612060"} arXiv:math/0612060
                = succeed ")" do
                  %a{:href => "https://www.hilarispublisher.com/open-access/notes-on-the-cherncharacter-.pdf"} doi:10.4172/1736-4337.100025
            %li
