          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong symplectic manifold
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  of even
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dim
                          %mi X
                          %mo =
                          %mn 2
                          %mi n
                        %annotation{:encoding => "application/x-tex"} dim X = 2 n
              %li
                %p
                  equipped with a
                  = succeed ":" do
                    %strong symplectic form
                %ul
                  %li
                    %p
                      a closed smooth
                      %a.existingWikiWord{:href => "/nlab/show/differential+form"} 2-form
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi ω
                              %mo ∈
                              %msubsup
                                %mi Ω
                                %mi cl
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \omega \in \Omega^2_{cl}(X)
                  %li
                    %p
                      such that
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ω
                          %annotation{:encoding => "application/x-tex"} \omega
                      is
                      = succeed "," do
                        %strong non-degenerate
                    %ul
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msup
                                  %mi ω
                                  %mrow
                                    %mo ∧
                                    %mi n
                                %mo =
                                %mi ω
                                %mo ∧
                                %mi ω
                                %mo ∧
                                %mi ⋯
                                %mo ∧
                                %mi ω
                              %annotation{:encoding => "application/x-tex"} \omega^{\wedge n}=\omega\wedge\omega\wedge\cdots\wedge\omega
                          has the maximal
                          %a.existingWikiWord{:href => "/nlab/show/rank"} rank
                          at every point
                          = succeed ";" do
                            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                              %semantics
                                %mrow
                                  %mi p
                                  %mo ∈
                                  %mi X
                                %annotation{:encoding => "application/x-tex"} p\in X
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mo ∧
                                  %mn 2
                                %msubsup
                                  %mi T
                                  %mi p
                                  %mo *
                                %mi X
                                %mo ,
                                %msub
                                  %mi ω
                                  %mi p
                                %mo{:stretchy => "false"} )
                              %annotation{:encoding => "application/x-tex"} (\wedge^2 T^*_p X,\omega_p)
                          is a
                          %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
                          for every point
                          = succeed "." do
                            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                              %semantics
                                %mrow
                                  %mi p
                                  %mo ∈
                                  %mi X
                                %annotation{:encoding => "application/x-tex"} p\in X
          .num_defn
            %h6#definition_3 Definition
            %p
              A real
              %strong symplectic manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ul
              %li
                %p
                  a
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi n
                        %annotation{:encoding => "application/x-tex"} 2n
                  %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              %li
                %p
                  equipped with a
                  = succeed ":" do
                    %strong symplectic atlas
                %ul
                  %li
                    %p
                      an
                      %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                      consisting of smooth
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/chart"} chart
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                            %mo :
                            %msub
                              %mi U
                              %mi i
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} \phi_i:U_i\to X
                      as usual,
                  %li
                    %p
                      such that the transition functions
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo ∘
                            %msub
                              %mi ϕ
                              %mi i
                            %mo :
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϕ
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %msub
                              %mi ϕ
                              %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi j
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msubsup
                              %mi ϕ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϕ
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %msub
                              %mi ϕ
                              %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi j
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \phi_j^{-1}\circ\phi_i:\phi_i^{-1}(\phi_i(U_i)\cap\phi_j(U_j))\to \phi_j^{-1}(\phi_i(U_i)\cap\phi_j(U_j))
                      preserve the standard symplectic form
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ω
                              %mn 0
                            %mo =
                            %msubsup
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mi n
                            %msub
                              %mi dx
                              %mi i
                            %mo ∧
                            %msub
                              %mi dp
                              %mi i
                          %annotation{:encoding => "application/x-tex"} \omega_0=\sum_{i=1}^n dx_i\wedge dp_i
                      on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n}
                      with the basis
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %mi …
                              %mo ,
                              %msub
                                %mi x
                                %mi n
                              %mo ,
                              %msub
                                %mi p
                                %mn 1
                              %mo ,
                              %mi …
                              %mo ,
                              %msub
                                %mi p
                                %mi n
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (x_1,\ldots,x_n,p_1,\ldots,p_n)
          #TangentCotangentIsomorphism.num_note
            %h6#remark Remark
            %p
              The non-degeneracy of the symplectic form implies that it defines an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(-,-) : \Gamma(T X) \to \Gamma(T^* X)
            %p
              between
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              –
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              –
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ∈
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi T
                      %mi x
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (v \in T_x X) \mapsto (\omega(v,-) \in T^*_x X)
                    \\,.
          .num_defn
            %h6#definition_4 Definition
            %p
              The vector fields in the image of the exact 1-forms under the isomorphism, remark
              = succeed "," do
                %a.maruku-ref{:href => "#TangentCotangentIsomorphism"}
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
          %p
            This means that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \in C^\infty(X)
            a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi H
                %annotation{:encoding => "application/x-tex"} d H
            its differential 1-form, the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi H
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v_H \in \Gamma(T X)
            is the unique vector field such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi H
                  %mo =
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi H
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  d H = \omega(v_H, -)
                  \\,
          %p
            Equivalently, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 2
                      %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi : \mathbb{R}^{2n} \to X
            a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mo *
                  %mi ω
                  %mo =
                  %msub
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %mi d
                  %msup
                    %mi x
                    %mi i
                  %mo ∧
                  %mi d
                  %msup
                    %mi x
                    %mi j
                %annotation{:encoding => "application/x-tex"} \phi^*\omega = \omega_{i j} d x^i \wedge d x^j
            the symplectic form on this patch, the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi H
                %annotation{:encoding => "application/x-tex"} v_H
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi H
                  %mo =
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi H
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ω
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo ∂
                    %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  v_H =  \frac{\partial H}{\partial x^i} (\omega^{-1})^{i j} \partial_j
                  \\,.
          %h2#properties Properties
          %h3#darboux_coordinates Darboux coordinates
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/Darboux%27s+theorem"} Darboux's theorem
            every symplectic manifold has an
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            by
            %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 2
                      %mi n
                  %mo ≃
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n} \simeq U \hookrightarrow X
            on which the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            takes the canonical form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %mn 2
                        %mi k
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \omega|_U = \sum_{k = 1}^n d x^{2k} \wedge d x^{2 k+1}
          %h3#SymplecticStructure Relation to almost symplectic structure
          %p
            The existence of a 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^2(X)
            which is non-degenerate (but not necessarily closed) is equivalent to the existence of a
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} Sp-structure
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            along the inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+group"} symplectic group
            into the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sp(2n) \hookrightarrow GL(2n)
                  \\,.
          %p
            Such an
            %em Sp(2n)-structure
            is also called an
            %em almost symplectic structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ω
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d \omega = 0
            – the condition for
            %a.existingWikiWord{:href => "/nlab/show/integrability+of+G-structures"} integrability of G-structures
            – makes it a genuine symplectic structure. See at
            = succeed "." do
              %em
                %a{:href => "integrability+of+G-structures#ExampleSymplecticStructure"} integrability of G-structures – Examples – Symplectic structure
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/metaplectic+structure"} metaplectic structure
            on a symplectic or almost symplectic manifold is in turn
            %a.existingWikiWord{:href => "/nlab/show/lift+of+the+structure+group"} lift of the structure group
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metaplectic+group"} metaplectic group
          %h3#relation_to_almost_hermitian_and_khler_structure Relation to almost Hermitian and Kähler structure
          %p
            By the
            = succeed "," do
              %a{:href => "#SymplecticStructure"} above
            %a.existingWikiWord{:href => "/nlab/show/integrable+G-structure"} integrable
            = succeed "-structure." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(2n,\mathbb{R}) \hookrightarrow GL(2n,\mathbb{R})
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            along the
            %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
            inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(n) \hookrightarrow Sp(2n,\mathbb{R})
            yields is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/almost+Hermitian+structure"} almost Hermitian structure
            %a.existingWikiWord{:href => "/nlab/show/integrable+G-structure"} first order integrable
            then it is
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+structure"} Kähler structure
          %p
            Such a refinement from symplectic to Kähler structure is also called a choice of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
          %h3#symplectomorphisms Symplectomorphisms
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
              a symplectic manifold, the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
              that generate
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
          .proof
            %h6#proof Proof
            %p
              The condition in question is that the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi v
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    L_v \omega = 0
            %p
              vanishes. By
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d \omega = 0
              this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \iota_v \omega = 0
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Poincare+lemma"} Poincare lemma
              it follows that there is locally a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi H
                      %mo =
                      %msub
                        %mi ι
                        %mi v
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} d H = \iota_v \omega
          %h3#poisson_structure Poisson structure
          .num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a symplectic manifold, define a bilinear skew-symmetric map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\{-,-\} : C^\infty(X) \otimes C^\infty(X) \to C^\infty(X)
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi F
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} }
                    %mo :
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi F
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi H
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{F,H\} := \iota_{v_F} \iota_{v_H} \omega
                    \\,.
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
            this says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi F
                  %mo ,
                  %mi H
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi F
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ω
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi H
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{F,H\} = (\frac{\partial F}{\partial x^i}) (\omega^{-1})^{i j}
                  (\frac{\partial H}{\partial x^j})
                  \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-,-\}
              makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
          %h2#examples Examples
