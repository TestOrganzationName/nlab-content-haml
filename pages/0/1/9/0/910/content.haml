          %p
          #EquivalentConditionsForCompactGeneration.num_prop
            %h6 Proposition
            %p
              %strong (equivalent characterizations of compact generation)
              %br/
              The following conditions on a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are equivalent:
            %ol
              %li
                %p
                  For all spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  and all
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  (of
                  %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                  if and only if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is
                  = succeed "-continuous" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed ")." do
                    %a.maruku-ref{:href => "#kContinuousFunction"}
              %li
                %p
                  There is a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  (instead of a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
                  such that the previous condition holds for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} C \in S
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/identification+space"} identification space
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                  of compact Hausdorff spaces.
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊆
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subseteq X
                  is
                  %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open
                  if and only if the
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi t
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} t^{-1}(U)
                  under any
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo{:lspace => "verythinmathspace"} :
                        %mi C
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} t \colon C \to X
                  out of a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is open.
            %p
          %p
          #kSpace.num_defn
            %h6 Definition
            %p
              %strong (k-spaces)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-space
              if any (hence all) of the conditions in Prop.
              %a.maruku-ref{:href => "#EquivalentConditionsForCompactGeneration"}
              hold.
              %br/
          .num_remark
            %h6 Remark
            %p
              %strong (terminology)
              %br/
              Some authors say that a
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")" do
                %a.maruku-ref{:href => "#kSpace"}
              = succeed "," do
                %strong compactly generated
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/weak+Hausdorff+space"} weak Hausdorff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} t\colon C\to X
              is closed (when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is compact Hausdorff). Some authors (especially the early authors on the subject) go on to require a
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              space, but this seems to be unnecessary.
          %h2#Examples Examples
          %p Examples of compactly generated spaces include
          .num_example
            %h6#example Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              is compactly generated.
          %p
            Note: it is not generally true that
            %a.existingWikiWord{:href => "/nlab/show/compact+spaces"} compact spaces
            are compactly generated, even if they are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weakly+Hausdorff+space"} weakly Hausdorff
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            of the rationals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            with its standard topology. See for example this
            = succeed "." do
              %a{:href => "https://math.stackexchange.com/a/964546/43208"} MathStackExchange post
          .num_example
            %h6#example_2 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              is compactly generated.
          .num_example
            %h6#example_3 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              is compactly generated
          #CWComplexIsCompactlyGenerated.num_example
            %h6#example_4 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              is a compactly generated topological space.
          .proof
            %h6#proof Proof
            %p
              Since a CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              over attachments of standard
              %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                  %annotation{:encoding => "application/x-tex"} D^{n_i}
              (its cells), by the characterization of colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              (
              %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ) a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is open or closed precisely if its restriction to each cell is open or closed, respectively. Since the
              = succeed "-disks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              intersected with all compact subsets is closed, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is closed.
            %p
              For the converse direction, since
              %a.existingWikiWord{:href => "/nlab/show/a+CW-complex+is+a+Hausdorff+space"} a CW-complex is a Hausdorff space
              and since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
          .num_example
            %h6#example_5 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/first+countable+space"} first countable space
              is a compactly generated space.
          .proof
            %h6#proof_idea Proof idea
            %p
              Since the topology is determined by convergent sequences = maps from one-point
              %a.existingWikiWord{:href => "/nlab/show/compactification"} compactification
              = succeed ");" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{N} \cup \{\infty\}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Frechet%E2%80%93Uryson+spaces"} Frechet–Uryson spaces
          %h2#properties Properties
          %h3#CoreflectionIntoTopologicalSpaces Coreflection into topological spaces
          %p
          #CategoryOfKSpaces.num_defn
            %h6 Definition
            %p
              %strong (category of k-spaces)
              %br/
              We write
            #eq:kSpacesAsSubcategoryOfAllSpaces.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mover
                      %mo ↪
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    k\Top
                    \\xhookrightarrow{\;\;\;\;}
                    Top
            %p
              for the category of
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")" do
                %a.maruku-ref{:href => "#kSpace"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              between them, hence for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              on the k-spaces.
          %p
          #TheCoreflection.num_prop
            %h6 Proposition
            %p
              The inclusion
              %a.maruku-eqref{:href => "#eq:kSpacesAsSubcategoryOfAllSpaces"} (1)
              is that of a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
            #eq:kIficationReflection.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mi Top
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟵
                        %mi k
                      %mover
                        %mo ↪
                        %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    k Top
                    \\underoverset
                    {\underset{k}{\longleftarrow}}
                    {\overset{}{\hookrightarrow}}
                    {\;\;\;\; \bot \;\;\;\;}
                    Top
            %p
          The
          %a.existingWikiWord{:href => "/nlab/show/coreflection"} coreflection
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi k
              %annotation{:encoding => "application/x-tex"} k
          is sometimes called
          %em
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            \-ification
          (
          %a{:href => "#May99"}> May 1999, p. 49
          ).
          .proof
            %h6 Proof
            %p
              The reflection functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is constructed as follows:
            %p
              We take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi X
                  %annotation{:encoding => "application/x-tex"} k(X) \coloneqq X
              on
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              whose
              %a.existingWikiWord{:href => "/nlab/show/closed+sets"} closed sets
              are those whose
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              with
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff
              subsets of (the original topology on)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
              (in the original topology on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k(X)
              has all the same closed sets and possibly more, hence all the same open sets and possibly more.
            %p
              In particular, the identity map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} id \colon k(X)\to X
              is continuous, and forms the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflection
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              as well as an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          %p
          .num_remark
            %h6 Remark
            %p
              There is also the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Top_k
              of all topological spaces and
              = succeed "-continuous" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")." do
                %a.maruku-ref{:href => "#kContinuousFunction"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              sequence of inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    k\Top \xhookrightarrow{\;} \Top \xrightarrow{\;} \Top_k
                    \\,,
            %p
              of which the first is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
              inclusion
              %a.maruku-eqref{:href => "#eq:kSpacesAsSubcategoryOfAllSpaces"} (1)
              and the second is
              %a.existingWikiWord{:href => "/nlab/show/bijective+on+objects+functor"} bijective on objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mo →
                      %msub
                        %mi Top
                        %mi k
                    %annotation{:encoding => "application/x-tex"} k\Top \to Top_k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            %p
              Namely, the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id \colon X \to k(X)
              is
              = succeed "-continuous," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              from Prop.
              %a.maruku-ref{:href => "#TheCoreflection"}
              becomes an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Top_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mo →
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} k\Top \to \Top_k
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              since any
              = succeed "-continuous" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-continuous;" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
          .num_remark
            %h6 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mo ↪
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %annotation{:encoding => "application/x-tex"} k\Top \hookrightarrow \Top
              is coreflective, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %annotation{:encoding => "application/x-tex"} k\Top
              is
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              are constructed as in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              are the
              = succeed "-ification" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.maruku-eqref{:href => "#eq:kIficationReflection"} (2)
              of
              = succeed "." do
                %a{:href => "Top#UniversalConstructions"} limits in Top
            %p
              Notice that this is nontrivial already for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              is the
              = succeed "-ification" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              to preserve products (and all
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %a.existingWikiWord{:href => "/nlab/show/CW+complexes"} CW complexes
              to be another CW complex.
          %h3#ReflectionIntoWeakHausdorffSpaces Reflection into weak Hausdorff spaces
          %p
          #FullSubcategoryOfCGWHSpacesInsideCGSpaces.num_defn
            %h6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi k
                    %mi Top
                    %mover
                      %mo ↪
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi k
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    h k Top
                    \\xhookrightarrow{\;\;\;}
                    k Top
            %p
              for the further
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inside that of k-spaces (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfKSpaces"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+Hausdorff+spaces"} weak Hausdorff spaces
          %p
          #ReflectionOntoCGWHSpaces.num_prop
            %h6 Proposition
            %p
              %strong (cgwh spaces reflective in cg spaces)
              %br/
              The
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %a.existingWikiWord{:href => "/nlab/show/weakly+Hausdorff+space"} weak Hausdorff spaces
              in k-spaces (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FullSubcategoryOfCGWHSpacesInsideCGSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              inclusion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi k
                    %mi Top
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ↪
                        %mrow
                      %mover
                        %mo ⟵
                        %mi h
                    %mi k
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    h k Top
                    \\underoverset
                    {\underset{}{\hookrightarrow}}
                    {\overset{ h }{\longleftarrow}}
                    {\;\;\;\; \bot \;\;\;\; }
                    k Top
            %p
          (e.g.
          = succeed ")" do
            %a{:href => "#Strickland09"} Strickland 2009, Prop. 2.22
          %p
          #SequencesOfCoReflections.num_remark
            %h6 Remark
            %p
              %strong
                (sequence of
                %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} (co-)
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflections
              %br/
              In summary, Prop.
              %a.maruku-ref{:href => "#TheCoreflection"}
              and Prop.
              %a.maruku-ref{:href => "#ReflectionOntoCGWHSpaces"}
              yield a sequence of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi k
                    %mi Top
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ↪
                        %mrow
                      %mover
                        %mo ⟵
                        %mi h
                    %mi k
                    %mi Top
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟵
                        %mi k
                      %mover
                        %mo ↪
                        %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    h k Top
                    \\underoverset
                    {\underset{}{\hookrightarrow}}
                    {\overset{ h }{\longleftarrow}}
                    {\;\;\;\; \bot \;\;\;\; }
                    k Top
                    \\underoverset
                    {\underset{k}{\longleftarrow}}
                    {\overset{}{\hookrightarrow}}
                    {\;\;\;\; \bot \;\;\;\;}
                    Top
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              restricts along these (co-)reflective embeddings to a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+compactly+generated+topological+spaces"} model structure on compactly generated topological spaces
          %h3#cartesian_closure Cartesian closure
          %p
            The categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %mo ≃
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mi k
                %annotation{:encoding => "application/x-tex"} k\Top\simeq \Top_k
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            only some objects are exponentiable, see
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/exponential+law+for+spaces"} exponential law for spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %em test-open
            or
            %em compact-open topology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Top_k(X,Y)
            to have the
            %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
            of sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(t,U)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} t\colon C \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M(t,U)
            consists of all
            = succeed "-continuous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X \to Y
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} f(t(C))\subseteq U
          %p
            (This is slightly different from the usual
            %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            happens to have non-Hausdorff compact subspaces; in that case the usual definition includes such subspaces as tests, while the above definition excludes them. Of course, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself is Hausdorff, then the two become identical.)
          %p
            With this topology,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Top_k(X,Y)
            becomes an
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Top_k
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            arguments (
            %a{:href => "closed+monoidal+category#TensorHomIsoInternalizes"}> prop.
            ), that the bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi k
                  %mi Top
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mi k
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  k\Top(X \times Y, Z)
                  \\longrightarrow
                  k Top\big(X,k\Top(Y,Z)\big)
          %p
            is actually an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Top_k
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-homeomorphism
            (e.g.
            = succeed ")." do
              %a{:href => "#Strickland09"} Strickland 09, prop. 2.12
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          %p
            It follows that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                %annotation{:encoding => "application/x-tex"} k\Top
            of
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Top_k
            = succeed "-ification" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Top_k
            = succeed "-spaces," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-continuous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Top
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k\Top(X,Y)
            is the set of all continuous maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is Hausdorff, we can identify this space with the
            = succeed "-ification" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top(X,Y)
          %p Finally, this all remains true if we also impose the weak Hausdorff, or Hausdorff, conditions.
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (failure of local cartesian closure)
              %br/
              Unfortunately neither of the above categories is
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed
              (
              %a{:href => "#CagliariMatovaniVitale95"}> Cagliari-Matovani-Vitale 1995, p. 4
              )
            %p#PartialLocalCartesianClosure
              However, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is the category of not-necessarily-weak-Hausdorff k-spaces, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are k-spaces that are weak Hausdorff, then the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (
              %a.existingWikiWord{:href => "/nlab/show/base+change"}> base change
              )
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi B
                    %mo →
                    %msub
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                  %annotation{:encoding => "application/x-tex"} K_{/B} \to K_{/A}
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed ";" do
                %a{:href => "#BoothBrown78a"} Booth &amp; Brown 1978a, Thm. 3.5 &amp; 7.3
              = succeed ")." do
                %a{:href => "#MaySigurdsson06"} May &amp; Sigurdsson 2006, §1.3.7-§1.3.9
            %p
              There is still a lot of work on fibred exponential laws and their applications. One reason for the success and difficulties is that it is easy to give a topology on the space of closed subsets of a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by regarding this as the space of maps to the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
              (the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1\}
              of
              %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth values
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1\}
              is closed but not open). From this one can get an
              %a.existingWikiWord{:href => "/nlab/show/exponential+law+for+spaces"} exponential law for spaces
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/T0"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} T_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are closed in their total space. Note that weak Hausdorff implies
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/T0"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} T_0
          %p
            %br/
          %h3#RelationToLocallyCompactHausdorffSpaces Relation to locally compact Hausdorff spaces
          %p
          #LocallyCompactHausdorffSpacesAreCompactlyGeneratedWeaklyHausdorff.num_prop
            %h6 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              is a k-space and is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weakly+Hausdorff+topological+space"} weakly Hausdorff
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LCHausSp
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mi h
                    %mi k
                    %mi TopSp
                  %annotation{:encoding => "application/x-tex"}
                    LCHausSp
                    \\xhookrightarrow{\;}
                    h k TopSp
            %p
          (
          %a{:href => "#Dugundji66"}> Dugundji 1966, XI Thm. 9.3
          ;
          = succeed ")" do
            %a{:href => "compactly+generated+topological+space#Strickland09"} Strickland 2009, Prop. 1.7
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              with a k-space is already a k-space (i.e. without need of k-ification).
          %p
            (e.g.
            = succeed ";" do
              %a{:href => "#Lewis78"} Lewis 1978, Lem. 2.4
            = succeed "," do
              %a{:href => "#Piccinini92"} Piccinini 1992, Thm. B.6
            = succeed ")" do
              %a{:href => "compactly+generated+topological+space#Strickland09"} Strickland 2009, Prop. 2.6
          %p
          #kSpacesAreTheQuotientSpacesOfLocallyCompactHausdorffSpaces.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/k-spaces"} k-spaces
                are the
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient spaces
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+spaces"} locally compact Hausdorff spaces
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is a
              %a.existingWikiWord{:href => "/nlab/show/k-space"} k-space
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#kSpace"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
          This is proven in
          %a{:href => "#Dugundji66"} Dugundji 1966, XI Thm. 9.4
          (also
          = succeed ")" do
            %a{:href => "#Piccinini92"} Piccinini 92, Thm. B.4
          = succeed "." do
            %a{:href => "#EscardoLawsonSimpson04"} Escardo, Lawson &amp; Simpson 2004, Cor. 3.4 (iii)
          #kSpacesAreTheColimitsInTopOfCompactHausdorffSpaces.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/k-spaces"} k-spaces
                are the
                %a.existingWikiWord{:href => "/nlab/show/Top#UniversalConstructions"} colimits in Top
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is a
              %a.existingWikiWord{:href => "/nlab/show/k-space"} k-space
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#kSpace"}
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              as formed in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (according to
              = succeed ")" do
                %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
          (
          %a{:href => "#EscardoLawsonSimpson04"}> Escardo, Lawson &amp; Simpson 2004, Lem. 3.2 (v)
          )
          %h3#relation_to_compactly_generated_topological_space Relation to compactly generated topological space
          %p
            Insice
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mi Top
                %annotation{:encoding => "application/x-tex"} D Top
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Delta-generated+topological+spaces"} Delta-generated topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi k
                    %mo ↩
                  %mi k
                  %msub
                    %mi Top
                    %mi Qu
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi D
                    %mo ↩
                  %mi D
                  %msub
                    %mi Top
                    %mi Qu
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Top
                  \\underoverset
                  { \underset{ k }{\longrightarrow} }
                  { {\hookleftarrow} }
                  { \;\;\;\;\;\;\bot\;\;\;\;\;\; }
                  k Top_{Qu}
                  \\underoverset
                  { \underset{ D }{\longrightarrow} }
                  { {\hookleftarrow} }
                  { \;\;\;\;\;\;\bot\;\;\;\;\;\; }
                  D Top_{Qu}
                  \\,.
          %p
            Both of these
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} coreflections
            are
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            and the induced
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+compactly+generated+topological+spaces"} model structure on compactly generated topological spaces
            and the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+Delta-generated+topological+spaces"} model structure on Delta-generated topological spaces
            (
            %a{:href => "#Gaucher07"}> Gaucher 2009
            ,
            = succeed ")." do
              %a{:href => "Delta-generated+topological+space#Haraguchi13"} Haraguchi 2013
          %h3#Regularity Regularity
          %p
          #kHausIsRegular.num_prop
            %h6 Proposition
            %p The categories of
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+Hausdorff+spaces"} compactly generated Hausdorff spaces
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+weakly+Hausdorff+spaces"} compactly generated weakly Hausdorff spaces
            %p
              are both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
          (
          %a{:href => "#CagliariMatovaniVitale95"}> Cagliari-Matovani-Vitale 95, p. 3
          ).
          %p
            In particular this implies that in these categories
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            preserves
            %a.existingWikiWord{:href => "/nlab/show/effective+epimorphisms"} effective epimorphisms
            (see
            = succeed ")." do
              %a{:href => "regular+epimorphism#InRegularCategoryRegularEpisAreStableUnderPullback"} there
          %h3#Homotopy Homotopy
          %p
          #kIficationIsWeakHomotopyEquivalence.num_prop
            %h6 Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              from the
              = succeed "-ification" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on all
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mi whe
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msubsup
                          %mi ε
                          %mi X
                          %mi k
                        %mspace{:width => "thickmathspace"}
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext i.e.
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ∼
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∀
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi x
                            %mo ∈
                            %mi X
                        %mrow
                          %mrow
                            %mi n
                            %mo ∈
                            %msub
                              %mi ℕ
                              %mo +
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msub
                      %mi π
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi x
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mo ∼
                    %msub
