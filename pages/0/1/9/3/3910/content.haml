                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} b:\mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(a)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(b)
          %p
            There is a Dedekind cut for every integer
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi a
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi b
                  %mo &lt;
                  %mi a
                %annotation{:encoding => "application/x-tex"} L_a(b) \coloneqq b \lt a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} U_a(b) \coloneqq a \lt b
          %p
            Since the integers are the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+integral+domain"} Archimedean integral domain
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/walking+arrow"} walking arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi ℤ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} h:\mathbb{Z} \to \mathbb{R}
          %h2#terminology Terminology
          %p
            The underlying
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theorists
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/number+theory"} number theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+integers"} algebraic integers
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"} red herring principle
            = succeed "\u2019" do
              %a.existingWikiWord{:href => "/nlab/show/rational+integers"} rational integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
            in the
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/Gaussian+integers"} Gaussian integers
            and
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Gaussian+numbers"} Gaussian numbers
          %p
            The symbol ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            ’ derives from the German word ‘Zahlen’, which is a generic word for ‘numbers’. (Compare
            = succeed "'s" do
              %a.existingWikiWord{:href => "/nlab/show/Richard+Dedekind"} Dedekind
            %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinite+cyclic+group"} infinite cyclic group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/even+number"}> even number
                ,
                %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd number
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/natural+number"}> natural number
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebraic+integer"} algebraic integer
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclotomic+integer"} cyclotomic integer
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
                modeled on the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal dual
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/integers+object"} integers object
                in a
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rational+zero+theorem"} rational zero theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/integers+type"} integers type
          %h2#references References
          %p
            The first characterization of the integers as an
            %a.existingWikiWord{:href => "/nlab/show/ordered+integral+domain"} ordered integral domain
            appeared in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Grassmann"}> Hermann Grassmann
              ,
              = succeed "," do
                %em Lehrbuch der Arithmetik für höhere Lehranstalten
              = succeed ")" do
                %a{:href => "https://books.google.com/books?id=jdQ2AAAAMAAJ"} Google Books
          %p though the name “ordered integral domain” does not appear in the text.
          %p History:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leo+Corry"}> Leo Corry
              ,
              = succeed "," do
                %em A Brief History of Numbers
              = succeed "&rbrack;" do
                %a{:href => "https://global.oup.com/academic/product/a-brief-history-of-numbers-9780198702597"} ISBN:9780198702597
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Integer"} Integer
          %p
            Formalization in
            %a.existingWikiWord{:href => "/nlab/show/univalent+foundations+of+mathematics"} univalent foundations of mathematics
            (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            with the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
          %ul
            %li#UFP13
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              , Rem. 6.10.7
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
              (2013) &amp;lbrack;
              %a{:href => "http://homotopytypetheory.org/book/"}> web
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://hottheory.files.wordpress.com/2013/03/hott-online-323-g28e4374.pdf"} pdf
          %p
            and specifically in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/UniMath+project"}> UniMath project
              ,
              %em
                %a{:href => "https://unimath.github.io/agda-unimath/elementary-number-theory.integers.html#1032"} agda-unimath/elementary-number-theory.integers
          %p
            and specifically in
            %a.existingWikiWord{:href => "/nlab/show/cubical+Agda"} cubical Agda
          %ul
