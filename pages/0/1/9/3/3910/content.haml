          %h2#idea Idea
          %p
            An
            %strong integer
            is a
            %a.existingWikiWord{:href => "/nlab/show/number"} number
            that is a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            or the
            %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
            of one.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            of all integers may defined as the
            %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
            on one generator or as the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
          %p In keeping with a historical point of view in which integers are natural numbers with a sign attached, one may write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} |
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo ,
                  %mn 0
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi …
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 3
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 2
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z} = \{n, -n | n \in \mathbb{N}, 0 = -0\} = \{ \ldots, -3, -2, -1, 0, 1, 2, 3, \ldots \}
                  \\,.
          %p
            From an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is a
            %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
            of sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mi ℕ
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mi ℕ
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mi …
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \stackrel{1 + (-)}{\to} \mathbb{N} \stackrel{1 + (-)}{\to} \mathbb{N} \stackrel{1 + (-)}{\to} \ldots
          %p
            whereby
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} -n \in \mathbb{Z}
            is represented by the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mi th
                %annotation{:encoding => "application/x-tex"} n^{th}
            copy of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            appearing in this diagram (starting the count at the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 0
                    %mi th
                %annotation{:encoding => "application/x-tex"} 0^{th}
            copy). The resulting induced map to the colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi m
                      %mo ∈
                      %mi ℕ
                  %mi ℕ
                  %mo →
                  %mi ℤ
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi n
                  %mo −
                  %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \times \mathbb{N} \cong \sum_{m \in \mathbb{N}} \mathbb{N} \to \mathbb{Z}: (m, n) \mapsto n-m
          %p
            imparts a monoid (in fact a group) structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            descended from the monoid structure on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \times \mathbb{N}
            = succeed ")." do
              %em
                %a{:href => "http://rfcwalters.blogspot.com/2011/02/mathematical-economics-double-entry.html"} partita doppia
          %p
            As a group,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            and is the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            of the
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
          %p
            The monoid of natural numbers is naturally even a
            %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            – in fact the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            rig – and this multiplicative structure extends to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to make it a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            – in fact the initial ring.
          %h2#properties Properties
          %ul
            %li
              %p
                The integers form a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %li
              %p
                The integers have
                %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/decidable+relation"} decidable order
            %li
              %p
                The trivial ring is a
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+ring"} tight apartness ring
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+ring"} discrete ring
            %li
              %p
                The integers are a
                %a.existingWikiWord{:href => "/nlab/show/strictly+weakly+ordered+ring"} strictly weakly ordered ring
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/lattice-ordered+ring"} lattice-ordered ring
            %li
              %p
                The integers are a
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/normed+space"} normed space
            %li
              %p
                The integers are a
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
            %li
              %p
                The integers satisfy the Archimedean property, making it into an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Archimedean+integral+domain"} Archimedean integral domain
          %h3#bijection_of_the_integers_with_the_natural_numbers Bijection of the integers with the natural numbers
          %p
            The integers are in bijection with the natural numbers. Both the integers and the natural numbers are
            %span.newWikiWord
              submonoids
              %a{:href => "/nlab/new/submonoids"} ?
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi ℤ
                  %mo :
                  %mi ℤ
                  %mo ↪
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} i_\mathbb{Z}:\mathbb{Z} \hookrightarrow \mathbb{Q}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi ℕ
                  %mo :
                  %mi ℕ
                  %mo ↪
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} i_\mathbb{N}:\mathbb{N} \hookrightarrow \mathbb{Q}
            preserving addition, zero, and one. Let us take the relation on the rational numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℚ
                  %mo ,
                  %mi y
                  %mo :
                  %mi ℚ
                  %mo ⊢
                  %mrow
                    %mo |
                    %mi x
                    %mo +
                    %mi x
                    %mo +
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo |
                  %msub
                    %mo =
                    %mi ℚ
                  %mi y
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x:\mathbb{Q}, y:\mathbb{Q} \vdash \left| x + x + \frac{1}{2} \right| =_\mathbb{Q} y + \frac{1}{2}
          %p The relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℤ
                  %mo ,
                  %mi y
                  %mo :
                  %mi ℕ
                  %mo ⊢
                  %mrow
                    %mo |
                    %msub
                      %mi i
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo |
                  %msub
                    %mo =
                    %mi ℚ
                  %msub
                    %mi i
                    %mi ℕ
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}, y:\mathbb{N} \vdash \left| i_\mathbb{Z}(x + x) + \frac{1}{2} \right| =_\mathbb{Q} i_\mathbb{N}(y) + \frac{1}{2}
          %p
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/one-to-one+correspondence"} one-to-one correspondence
          %h3#sequential_cauchy_completeness  Sequential Cauchy completeness
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to \mathbb{Z}
            be a sequence of integers, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} b:\mathbb{Z}
            be an integer. Then, there is a limit relation defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isLimit
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi ϵ
                  %mo :
                  %msub
                    %mi ℤ
                    %mo +
                  %mo .
                  %mo ∃
                  %mi N
                  %mo :
                  %mi ℕ
                  %mo .
                  %mo ∀
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ≥
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi b
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isLimit}(x, b) \coloneqq \forall \epsilon:\mathbb{Z}_+.\exists N:\mathbb{N}.\forall n:\mathbb{N}.(n \geq N) \to (\vert x(n) - b \vert \lt \epsilon)
          %p
            This relation is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functional+relation"} functional relation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sequentially+Hausdorff+space"} sequentially Hausdorff space
          %p
            A
            %strong modulus of Cauchy convergence
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo :
                  %msub
                    %mi ℤ
                    %mo +
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} M:\mathbb{Z}_+ \to \mathbb{N}
            with a witness
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo ∀
                  %mi ϵ
                  %mo :
                  %msub
                    %mi ℤ
                    %mo +
                  %mo .
                  %mo ∀
                  %mi m
                  %mo :
                  %mi ℕ
                  %mo .
                  %mo ∀
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ≥
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ≥
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(M, x):\forall \epsilon:\mathbb{Z}_+.\forall m:\mathbb{N}.\forall n:\mathbb{N}.((m \geq M(\epsilon)) \wedge (n \geq M(\epsilon))) \to (\vert x(m) - x(n) \vert \lt \epsilon)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is
            %a.existingWikiWord{:href => "/nlab/show/sequentially+Cauchy+complete"} sequentially Cauchy complete
            if every sequence with a modulus of Cauchy convergence has a unique limit. But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
