                %a.existingWikiWord{:href => "/nlab/show/categorified+Dold-Kan+correspondence"} categorified Dold-Kan correspondence
          %h2#references References
          %h3#for_waldhausen_categories_2 For Waldhausen categories
          %ul
            %li#Waldhausen85
              %a.existingWikiWord{:href => "/nlab/show/Friedhelm+Waldhausen"}> Friedhelm Waldhausen
              \:
              = succeed "," do
