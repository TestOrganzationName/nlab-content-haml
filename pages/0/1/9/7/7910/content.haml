                          %mi HamSympl
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo ,
                          %mi ω
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Heis(V,\omega)
                  \&amp;\hookrightarrow&amp;
                  ESp(V,\omega) &amp;\hookrightarrow&amp; QuantMorph(V,\omega)
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  V
                  \&amp;\hookrightarrow&amp;
                  ASp(V,\omega)
                  \&amp;\hookrightarrow&amp;
                  HamSympl(V,\omega)
                  }
          %p
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ESp
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ESp(V,\omega)
            is that of those
            %a.existingWikiWord{:href => "/nlab/show/quantomorphisms"} quantomorphisms
            which come from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quadratic+Hamiltonians"} quadratic Hamiltonians
            %a.existingWikiWord{:href => "/nlab/show/symplectic+group"} symplectic group
            instead of the
            %a.existingWikiWord{:href => "/nlab/show/affine+symplectic+group"} affine symplectic group
            come from
            %a.existingWikiWord{:href => "/nlab/show/homogeneously+quadratic+Hamiltonians"} homogeneously quadratic Hamiltonians
            (e.g.
            = succeed ")." do
              %a{:href => "#RobbinSalamon93"} Robbin-Salamon 93, prop. 10.1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ESp
                %annotation{:encoding => "application/x-tex"} ESp
            is the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
            of the
            %a.existingWikiWord{:href => "/nlab/show/metaplectic+group"} metaplectic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mp
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mp(V,\omega)
            with the
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            (
            %a{:href => "#ARZ06"}> ARZ 06, prop. V.1
            , see also
            = succeed ")" do
              %a{:href => "#Low12"} Low 12
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
