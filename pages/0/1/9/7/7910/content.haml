          %h2#idea Idea
          %p
            Given a (
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"}> pre
            )
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
            %em quantomorphism group
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            that
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrates
            the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie bracket
            inside the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            of the group of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+symplectomorphisms"} Hamiltonian symplectomorphisms
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
          %p
            (Warning on terminology: A more evident name for the quantomorphism group might seem to be “Poisson group”. But this already means something different, see
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+group"} Poisson Lie group
          %h3#traditional_construction Traditional construction
          %p
            Over a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            an explicit construction of the corresponding quantomorphism group is obtained by choosing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo →
                  %mi X
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P \to X, \nabla)
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+circle+bundle"} prequantum circle bundle
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
            1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
