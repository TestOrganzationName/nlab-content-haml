                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Heis
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ⋊
                  %mi Mp
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
