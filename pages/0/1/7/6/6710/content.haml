              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi Spin
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mn 1
                                  %mi mod
                                  %mn 2
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SO
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi w
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B} Spin^c &amp;\to&amp; \mathbf{B}U(1)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{c}_1 mod 2}}
                    \\\
                    \\mathbf{B} SO &amp;\stackrel{w_2}{\to}&amp;
                    \\mathbf{B}^2 \mathbb{Z}_2
                    }
                    \\,.
          .proof
            %h6#proof Proof
            %p
              We present this as usual by
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctors"} ∞-anafunctors
            %p
              The first
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo →
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi c
                                  %mn 1
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi ℤ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}(\mathbb{Z} \to \mathbb{R})
                    \&amp;\stackrel{c_1}{\to}&amp;
                    \\mathbf{B}(\mathbb{Z} \to 1)
                    \=
                    \\mathbf{B}^2 \mathbb{Z}
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{B} U(1)
                    }
                    \\,.
            %p
              The second
              %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo →
                            %mi Spin
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi w
                                  %mn 2
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SO
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}(\mathbb{Z}_2 \to Spin)
                    \&amp;\stackrel{w_2}{\to}&amp;
                    \\mathbf{B}(\mathbb{Z}_2 \to 1)
                    \=
                    \\mathbf{B}^2 \mathbb{Z}_2
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{B} SO
                    }
                    \\,.
            %p
              Notice that the top horizontal morphism here is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              in question is given by the ordinary pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo →
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo →
                            %mi Spin
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q
                    \&amp;\to&amp;
                    \\mathbf{B}(\mathbb{Z} \to \mathbb{R})
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}(\mathbb{Z}_2 \to Spin)
                    \&amp;\to&amp;
                    \\mathbf{B}^2 \mathbb{Z}_2
                    }
                    \\,.
            %p
              This pullback is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mover
                        %mo →
                        %mo ∂
                      %mi Spin
                      %mo ×
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}(\mathbb{Z} \stackrel{\partial}{\to} Spin \times \mathbb{R})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %mi n
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mi mod
                    %mn 2
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial : n \mapsto ( n mod 2 , n)
                    \\,.
            %p This is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mo ∂
                        %mo ′
                    %mi Spin
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}(\mathbb{Z}_2 \stackrel{\partial'}{\to} Spin \times U(1))
            %p where now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo ′
                    %mo :
                    %mi σ
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial' : \sigma \mapsto (\sigma, \sigma)
                    \\,.
            %p This in turn is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B} (Spin \times_{\mathbb{Z}_2} U(1))
                    \\,,
            %p which is the original definition.
          %p
            This factors the above characterization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
            as the homotopy fiber of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi W
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbf{W}_3
          .num_prop
            %h6#proposition_2 Proposition
            %p
              We have a
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi Spin
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi c
                                    %mn 1
                                  %mspace{:width => "thinmathspace"}
                                  %mi mod
                                  %mspace{:width => "thinmathspace"}
                                  %mn 2
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SO
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi w
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi β
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B} Spin^c &amp;\to&amp; \mathbf{B}U(1) &amp;\to&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{c_1 \, mod\, 2}}
                    \&amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}SO
                    \&amp;\stackrel{\mathbf{w}_2}{\to}&amp;
                    \\mathbf{B}^2 \mathbb{Z}_2
                    \&amp;\stackrel{\mathbf{\beta}_2}{\to}&amp;
                    \\mathbf{B}^2 U(1)
                    }
                    \\,.
          %p
            This is discussed at
            = succeed "." do
              %em
                %a{:href => "spin%5Ec#AsHomotopyFiberOfSmoothW3"} Spin^c – Properties – As the homotopy fiber of smooth w3
          %h3#as_orientation
            As
            = succeed "-orientation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} X \to \ast
            is
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} generalized oriented
            in
            %a.existingWikiWord{:href => "/nlab/show/periodic+complex+K-theory"} periodic complex K-theory
            precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has a
            = succeed "-structure." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/K-orientation"} K-orientation
            for more.
          %h3#RelationToMetaplecticStructures Relation to metaplectic structures
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            hence a
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
            structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %a.existingWikiWord{:href => "/nlab/show/metaplectic+structure"} metaplectic structure
            of this data is a choice of square root
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msqrt
                    %mrow
                      %msup
                        %mi Ω
                        %mrow
                          %mn 0
                          %mo ,
                          %mi n
                %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{0,n}}
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/canonical+line+bundle"} canonical line bundle
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (see the discussion at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Theta+characteristic"} Theta characteristic
          %p
            Now given a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} L_\omega
            %a{:href => "geometric+quantization#IndexOfDolbeaultDiracOperator"} Dolbault quantization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi ω
                %annotation{:encoding => "application/x-tex"} L_\omega
            coincides with the
            %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+quantization"}
              spin
              %sup
                %i c
              quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"}
              spin
              %sup
                %i c
              structure
            induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi ω
                    %mo ⊗
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                  %annotation{:encoding => "application/x-tex"} L_\omega \otimes \sqrt{\Omega^{0,n}}
          %p
            This appears as (
            %a{:href => "#Paradan09"}> Paradan 09, prop. 2.2
            ).
          %h2#examples Examples
          %h3#FromAlmostComplexStructures From almost complex structures
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
            canonically induces a
            = succeed "-structure:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have a homotopy-
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mrow
                                      %msub
                                        %mi c
                                        %mn 1
                                  %mi mod
                                  %mn 2
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi w
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}U(n) &amp;\to&amp; \mathbf{B}U(1)
                    \\\
                    \\downarrow
                    \&amp;\swArrow&amp;
                    \\downarrow^{\mathrlap{\mathbf{c_1} mod 2}}
                    \\\
                    \\mathbf{B}SO(2n) &amp;\stackrel{\mathbf{w}_2}{\to}&amp; \mathbf{B}^2 \mathbb{Z}_2
                    }
                    \\,,
            %p
              where the vertical morphism is the canonical morphism induced from the identification of real vector spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo →
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{C} \to \mathbb{R}^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(n) \to \mathbf{B}U(1)
              (induced from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n)
              being the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⋊
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n) \simeq SU(n) \rtimes U(1)
          .proof
            %h6#proof_2 Proof
            %p
              By the general relation between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              of an
              %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} w_2
              of the underlying orthogonal structure, discussed at
              = succeed "." do
                %em
                  %a{:href => "#Stiefel-Whitney+class#RelationToChernClasses"} Stiefel-Whitney class – Relation to Chern classes
          .num_remark
            %h6#remark Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#SpinCAsHomotopyFiberProductW2C1"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              this induces a canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k \colon \mathbf{B}U(n) \to \mathbf{B}Spin^c
                    \\,.
          %p and this is the universal morphism from almost complex structures:
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \colon X \to \mathbf{B}U(n)
              modulating an
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo →
                      %mi c
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi k
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    k c \colon X \stackrel{c}{\to} \mathbf{B}U(n) \stackrel{k}{\to} \mathbf{B}Spin^c
            %p
              is the corresponding
              = succeed "-structure." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                    %annotation{:encoding => "application/x-tex"} Spin^c
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin%E1%B6%9C"}> spinᶜ
                ,
                %a.existingWikiWord{:href => "/nlab/show/MSpin%E1%B6%9C"} MSpinᶜ
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structures"} (twisted, differential) c-structures
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/spin+structure"}> spin structure
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/twisted+spin+structure"} twisted spin structure
                    %a.existingWikiWord{:href => "/nlab/show/differential+spin+structure"} differential spin structure
                  %p
                    %strong>
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi spin
                              %mi c
                          %annotation{:encoding => "application/x-tex"} spin^c
                      structure
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/twisted+spin%E1%B6%9C+structure"} twisted spinᶜ structure
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/K-orientation"} K-orientation
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/spin%E1%B6%9C+Dirac+operator"} spinᶜ Dirac operator
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/spin%CA%B0+structure"} spinʰ structure
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/string+structure"}> string structure
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/twisted+differential+string+structure"} twisted differential string structure
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/string%E1%B6%9C+2-group"}> stringᶜ 2-group
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/string%E1%B6%9C+structure"} stringᶜ structure
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/fivebrane+structure"}> fivebrane structure
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/twisted+differential+fivebrane+structure"} twisted differential fivebrane structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+quantization"} spinᶜ quantization
          %h2#references References
          %h3#general General
          %p A canonical textbook reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/H.+Blaine+Lawson"}> H. Blaine Lawson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Marie-Louise+Michelsohn"} Marie-Louise Michelsohn
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Spin+geometry"} Spin geometry
          %p Other accounts include
          %ul
            %li
              %p
                Blake Mellor,
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi Spin
                          %mi c
                      %annotation{:encoding => "application/x-tex"} Spin^c
                  \-manifolds
                (
                %a.existingWikiWord{:href => "/nlab/files/BlakeSpinC.pdf", :title => "pdf"}> pdf
                )
            %li
              %p
                %em
                  Stable complex and
                  = succeed "-structures" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Spin
                            %mi c
                        %annotation{:encoding => "application/x-tex"} Spin^c
                (
                %a.existingWikiWord{:href => "/nlab/files/StableComplexSpinC.pdf", :title => "pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"}> Peter Teichner
                , Elmar Vogt,
                %em
                  All 4-manifolds have
                  = succeed "-structures" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Spin
                            %mi c
                        %annotation{:encoding => "application/x-tex"} Spin^c
                (
                %a{:href => "http://people.mpim-bonn.mpg.de/teichner/Papers/spin.pdf"}> pdf
                )
          %p See also
          %ul
            %li#Gompf97
              %a.existingWikiWord{:href => "/nlab/show/Robert+Gompf"}> Robert Gompf
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Spin
                          %mi c
                      %annotation{:encoding => "application/x-tex"} Spin^c
                  structures and homotopy equivalences
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/9705218"} arXiv:math/9705218
          %h3#as_orientationanomaly_cancellation_in_type_ii_string_theory
            As
            = succeed "-orientation/anomaly" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
          %p
            That the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            on a
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            in
            %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            in the absense of a
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            is rather to be regarded as part of a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} spin^c
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Baryons and Branes In Anti de Sitter Space
              = succeed ")." do
                %a{:href => "http://arxiv.org/abs/hep-th/9912086"} arXiv:hep-th/9805112
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"}
              twisted spin
              %sup
                %i c
              structure
            (see there for more details) on the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            in the presence of a nontrivial
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            was discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              %em Anomalies in String Theory with D-Branes
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9907189"}> arXiv:hep-th/9907189
              )
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly+cancellation"} Freed-Witten-Kapustin anomaly cancellation
          %p A more recent review is provided in
          %ul
            %li
              Kim Laine,
              %em Geometric and topological aspects of Type IIB D-branes
              (
              %a{:href => "http://arxiv.org/abs/0912.0460"}> arXiv:0912.0460
              )
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              %em
                Geometry of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                    %annotation{:encoding => "application/x-tex"} Spin
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                    %annotation{:encoding => "application/x-tex"} Spin^c
                structures in the M-theory partition function
              (
              %a{:href => "http://arxiv.org/abs/1005.1700"}> arXiv:1005.1700
              )
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/metaplectic+corrections"} metaplectic corrections
            is discussed in
          %ul
            %li#Paradan09
              %a.existingWikiWord{:href => "/nlab/show/Paul-Emile+Paradan"}> Paul-Emile Paradan
              ,
              %em Spin-quantization commutes with reduction
              (
              %a{:href => "http://arxiv.org/abs/0911.1067"}> arXiv:0911.1067
              )
          %p See also
          %ul
            %li
              O. Hijazi, S. Montiel, F. Urbano,
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                    %annotation{:encoding => "application/x-tex"} Spin^c
                \-geometry of Kähler manifolds and the Hodge Laplacian on minimal Lagrangian submanifolds
              (
              %a{:href => "http://hal.archives-ouvertes.fr/docs/00/09/81/71/PDF/lagrangian0412.pdf"}> pdf
              )
