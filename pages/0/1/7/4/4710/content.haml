                  %div
                    %p
                      %a{:href => "/nlab/edit/monoid+theory+-+contents"} Edit this sidebar
          %blockquote
            %p
              For other kinds of units see also
              %em
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of an adjunction
              and
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit of a monad
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
          %hr/
          %h1#units Units
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#units_in_rings"} Units in rings
                %li
                  %a{:href => "#units_in_monoids"} Units in monoids
                %li
                  %a{:href => "#units_in_rngs_or_semigroups"} Units in rngs or semigroups
                %li
                  %a{:href => "#units_in_nonassocative_rings_or_magmas"} Units in nonassocative rings or magmas
                %li
                  %a{:href => "#units_in_modules"} Units in modules
                %li
                  %a{:href => "#UnitsOfMeasurement"} Units of measurement
              %li
                %a{:href => "#identities_as_units"} Identities as units
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Considering a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %em the unit element
            or
            %em the multiplicative unit
            one usually means the
            %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} 1 \in R
            with respect to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/nonunital+ring"} nonunital ring
          %p
            But more generally
            %em a unit element
            in a unital (!) ring is any element that has an
            %a.existingWikiWord{:href => "/nlab/show/inverse+element"} inverse element
            under
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
          %p
            This concept generalizes beyond
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
          %h2#definitions Definitions
          %p Exactly what this means depends on context. A very general definition is this:
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                    %mo{:lspace => "verythinmathspace"} :
                    %mi R
                    %mo ×
                    %mi M
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} {\cdot}\colon R \times M \to M
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            %strong unit
            (relative to the operation
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} {\cdot}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi a
                    %mo ⋅
                    %mi u
                  %annotation{:encoding => "application/x-tex"} x = a \cdot u
          %p
            That is, every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a multiple (in a unique way) of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} {\cdot}
          %h3#units_in_rings Units in rings
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            (or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            comes equipped with a multiplication map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                    %mo{:lspace => "verythinmathspace"} :
                    %mi R
                    %mo ×
                    %mi R
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} {\cdot}\colon R \times R \to R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            can play the role of both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            above, although there are two ways to do this: on the left and on the right.
          %p
            We find that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is a
            %strong left unit
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is a
            %strong right unit
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+inverse"} right inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            with an inverse is a unit because, given any element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mi u
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mi u
                %annotation{:encoding => "application/x-tex"} x = (x u^{-1}) u
          %p (on the left) or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi u
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi u
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x = u (u^{-1} x)
          %p (on the right). Conversely, a unit must have an inverse, since there must a solution to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo =
                  %mi a
                  %mi u
                %annotation{:encoding => "application/x-tex"} 1 = a u
          %p (on the left) or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo =
                  %mi u
                  %mi a
                %annotation{:encoding => "application/x-tex"} 1 = u a
          %p (on the right).
          %p
            The collection of all units in a unital ring form a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            (or rig), a
            %strong unit
            is an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            that has an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inverse+element"} inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            just when every non-
            %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            element is a unit.
          %h3#units_in_monoids Units in monoids
          %p
            Notice that addition plays no role in the characterisation above of a unit in a ring. Accordingly, a unit in a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            may be defined in precisely the same way.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            is precisely a monoid in which every element is a unit.
          %h3#units_in_rngs_or_semigroups Units in rngs or semigroups
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/rng"} rng
            (or, ignoring addition, in a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is a
            %strong left unit
            if, for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi a
                  %mi u
                  %mo ;
                %annotation{:encoding => "application/x-tex"} x = a u ;
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is a
            %strong right unit
            if, for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi u
                  %mi a
                  %mo .
                %annotation{:encoding => "application/x-tex"} x = u a .
          %h3#units_in_nonassocative_rings_or_magmas Units in nonassocative rings or magmas
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/nonassociative+algebra"} nonassociative ring
            (or, ignoring addition, in a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/magma"} magma
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/quasigroup"} quasigroup
            is precisely a magma in which every element is a two-sided unit.
          %h3#units_in_modules Units in modules
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            %strong unit
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} u \in M
            such that every other
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} x \in M
            can be written as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi a
                  %mi u
                %annotation{:encoding => "application/x-tex"} x = a u
            (or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi u
                  %mi a
                %annotation{:encoding => "application/x-tex"} x = u a
            for a right module) for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
            %a.existingWikiWord{:href => "/nlab/show/generator"} generator
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            as an
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            %em qua
            ring is the same as a unit in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            %em qua
            (left or right)
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#UnitsOfMeasurement Units of measurement
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/line"} line
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            element is a unit, called in this context a
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/unit+of+measurement"} unit of measurement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ≔
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} R \coloneqq \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the line in question.
          %p
            Often (but not always) these quantities form an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            line, so that nonzero quantities are either positive or negative. Then we usually also require a unit of measurement to be positive. In fact, for some dimensions, there is no physical meaning to a negative quantity, in which case the quantities actually form a module over the rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\ge 0}
            and every nonzero element is “positive.”
          %p
            For example, the
            %a.existingWikiWord{:href => "/nlab/show/kilogram"} kilogram
            is a unit of mass, because any mass may be expressed as a real multiple of the kilogram. Further, it is a positive unit; the mass of any physical object is a nonnegative quantity (so that mass quantities actually form an
            = succeed "-module)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\ge 0}
          %h2#identities_as_units Identities as units
          %p
            Often the term ‘unit’ (or ‘unity’) is used as a synonym for ‘
            %a.existingWikiWord{:href => "/nlab/show/identity+element"}> identity element
            ’, especially when this identity element is denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            itself is a unit; the converse also holds.
          %p
          .num_prop
            %h6 Proposition
            %p A rng with a unit must have an identity.
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a rng with a unit
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              %br/
            %p
              for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a,b\in R
              define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi a
                    %msup
                      %mi u
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {}_a u^{-1}
              as the unique element s.t.
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %msub
                        %mrow
                        %mi a
                      %msup
                        %mi u
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⋅
                      %mi u
                    %annotation{:encoding => "application/x-tex"} a= {}_a u^{-1} \cdot u
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi u
                      %mi b
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} u^{-1}_b
              as the unique element s.t.
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %mi u
                      %mo ⋅
                      %msubsup
                        %mi u
                        %mi b
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} b= u\cdot u^{-1}_b
              %br/
              the goal is to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi u
                      %mi u
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msub
                      %mrow
                      %mi u
                    %msup
                      %mi u
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} u^{-1}_u= {}_u u^{-1}
              which is the identity of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p Just observe that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ⋅
                        %msubsup
                          %mi u
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %msub
                          %mrow
                          %mi a
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %mi u
                        %mo ⋅
                        %msubsup
                          %mi u
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %msub
                          %mrow
                          %mi a
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %mi u
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a\cdot u^{-1}_u= {}_a u^{-1}\cdot u \cdot u^{-1}_u= {}_a u^{-1} \cdot u = a
                  for any
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} a\in R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi u
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %mi b
                        %mo =
                        %msub
                          %mrow
                          %mi u
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %mi u
                        %mo ⋅
                        %msubsup
                          %mi u
                          %mi b
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %mi u
                        %mo ⋅
                        %msubsup
                          %mi u
                          %mi b
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %mi b
                      %annotation{:encoding => "application/x-tex"} {}_u u^{-1} \cdot b= {}_u u^{-1} \cdot u\cdot u^{-1}_b=u\cdot u^{-1}_b=b
                  for any
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} b\in R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi u
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %msub
                          %mrow
                          %mi u
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %msubsup
                          %mi u
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %msub
                          %mrow
                          %mi u
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} u^{-1}_u = {}_u u^{-1} \cdot u^{-1}_u = {}_u u^{-1}
                  by the previous two points.
            %p
          %p
            It is this meaning of ‘unit’ which gives rise to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of an adjunction
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
            %li
              %p
