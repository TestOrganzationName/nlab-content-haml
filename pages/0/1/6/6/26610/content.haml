            )
          %h2#special_topological_complexities Special topological complexities
          %h3#spheres_and_tori Spheres and tori
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
              of a
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              is
            #eq:TopologicalComplexityOfSpheres.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TC
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 2
                          %mtd
                            %mi n
                            %mspace{:width => "thickmathspace"}
                            %mi odd
                        %mtr
                          %mtd
                            %mn 3
                          %mtd
                            %mi n
                            %mspace{:width => "thickmathspace"}
                            %mi even
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    S^n
                    \\big)
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    2 &amp; n \; odd
                    \\\
                    3 &amp; n \; even
                    \\end{array}
                    \\right.
            %p
              (with convention
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \operatorname{TC}(*)=1
          %p
            (
            %a{:href => "#Farber01"}> Farber 01, Theorem 8
            )
          %p This theorem can be generalized:
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
              of a product of spheres is
            #eq:TopologicalComplexityOfProductOfSpheres.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TC
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi m
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi n
                            %mo +
                            %mn 1
                          %mtd
                            %mi m
                            %mspace{:width => "thickmathspace"}
                            %mi odd
                        %mtr
                          %mtd
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                          %mtd
                            %mi m
                            %mspace{:width => "thickmathspace"}
                            %mi even
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    (S^m)^n
                    \\big)
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    n+1 &amp; m \; odd
                    \\\
                    2n+1 &amp; m \; even
                    \\end{array}
                    \\right.
            %p
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \operatorname{TC}(*)=1
          %p
            (
            %a{:href => "#Farber01"}> Farber 01, Theorem 13
            )
          %p
            A special case of this proposition is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi TC
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} TC(T^n)=n+1
            for the
            %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
          %h3#real_and_complex_projective_space Real and complex projective space
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≠
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 7
                    %annotation{:encoding => "application/x-tex"} n\neq 1,3,7
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k\in\mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
              of
              %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}P^n
              into
              %a.existingWikiWord{:href => "/nlab/show/euclidean+space"} euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{k-1}
              is the topologial complexity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{TC}(\mathbb{R}P^n)
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \operatorname{TC}(*)=1
          %p
            (
            %a{:href => "#FarberTabachnikovYuzvinsky02"}> Farber &amp; Tabachnikov &amp; Yuzvinsky 02, Theorem 12
            )
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 7
                    %annotation{:encoding => "application/x-tex"} n=1,3,7
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \operatorname{TC}(\mathbb{R}P^n)=n+1
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \operatorname{TC}(*)=1
          %p
            (
            %a{:href => "#FarberTabachnikovYuzvinsky02"}> Farber &amp; Tabachnikov &amp; Yuzvinsky 02, Proposition 18
            )
          %p
          .num_prop
            %h6 Proposition
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n\in\mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \operatorname{TC}(\mathbb{C}P^n)=2n+1
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \operatorname{TC}(*)=1
          %p
            (
            %a{:href => "#FarberTabachnikovYuzvinsky02"}> Farber &amp; Tabachnikov &amp; Yuzvinsky 02, Corollary 2
            )
          %h3#_and__surfaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                %annotation{:encoding => "application/x-tex"} \Xi
            surfaces
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
              of a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              surface is
            #eq:TopologicalComplexityOfSigmaSurface.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TC
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Σ
                      %mi g
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 3
                          %mtd
                            %mi m
                            %mo ≤
                            %mn 1
                        %mtr
                          %mtd
                            %mn 5
                          %mtd
                            %mi m
                            %mo &gt;
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    \\Sigma_g
                    \\big)
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    3 &amp; m \leq 1
                    \\\
                    5 &amp; m \gt 1
                    \\end{array}
                    \\right.
            %p
              (with convention
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} TC(*)=1
          %p
            (
            %a{:href => "#Farber01"}> Farber 01, Theorem 9
            )
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} g \geq 2
              one has
            #eq:TopologicalComplexityOfConnectedSumOfRealProjectiveSpace.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TC
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi g
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    (\mathbb{R}P^n)^g
                    \\big)
                    \\;=\;
                    2n
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/connected+sum"} connected sum
              of
              %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} TC(*)=0
          %p
            (
            %a{:href => "#CohenVandembroucq18"}> Cohen &amp; Vandembrouq 18, Theorem 1.3.
            )
          %h3#klein_bottle Klein bottle
          %p
          .num_prop
            %h6 Proposition
            %p
              The topological complexity of the
              %a.existingWikiWord{:href => "/nlab/show/Klein+bottle"} Klein bottle
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} TC(*)=0
          %p
            (
            %a{:href => "#CohenVandembroucq16"}> Cohen &amp; Vandembrouq 16, Theorem 1
            )
          %h2#configuration_space Configuration space
          %p
          .num_prop
            %h6 Proposition
            %p
              The topological complexity of a
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
              is
            #eq:TopologicalComplexityOfConfigurationSpace.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TC
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Conf
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 2
                            %mi n
                            %mo −
                            %mn 1
                          %mtd
                            %mi m
                            %mspace{:width => "thickmathspace"}
                            %mi odd
                        %mtr
                          %mtd
                            %mn 2
                            %mi n
                            %mo −
                            %mn 2
                          %mtd
                            %mi m
                            %mspace{:width => "thickmathspace"}
                            %mi even
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    Conf(\mathbb{R}^m,n)
                    \\big)
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    2n-1 &amp; m \; odd
                    \\\
                    2n-2 &amp; m \; even
                    \\end{array}
                    \\right.
            %p
              (with convention
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TC
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} TC(*)=1
          %p
            (
            %a{:href => "#FarberGrant08"}> Farber &amp; Grant 08, Theorem 1
            )
          %h2#references References
          %p Definition and basic properties of topological complexity:
          %ul
            %li#Farber01
              %a.existingWikiWord{:href => "/nlab/show/Michael+Farber"}> Michael Farber
              ,
              = succeed "," do
                %em Topological complexity of motion planning
              %strong 29
              (2001) 211–221, &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0111197"}> arXiv:math/0111197
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00454-002-0760-9"} doi:10.1007/s00454-002-0760-9
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Topological_complexity"} Topological complexity
          %p
            On topological complexity of
            %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            and connection with their
            %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
            into
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+space"} cartesian space
          %ul
            %li#FarberTabachnikovYuzvinsky02
              %a.existingWikiWord{:href => "/nlab/show/Michael+Farber"}> Michael Farber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serge+Tabachnikov"} Serge Tabachnikov
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sergey+Yuzvinsky"} Sergey Yuzvinsky
              %em Topological robotics: motion planning in projective spaces
              (2002),
              = succeed ";" do
                %a{:href => "https://arxiv.org/abs/math/0210018"} arXiv:math/0210018
          %p
            On topological complexity of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/connected+sums"} connected sums
          %ul
            %li#CohenVandembroucq18
              %a.existingWikiWord{:href => "/nlab/show/Daniel+C.+Cohen"}> Daniel C. Cohen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lucile+Vandembroucq"} Lucile Vandembroucq
              %em Motion planning in connected sums of real projective spaces
              (2018),
              %a{:href => "https://arxiv.org/abs/1807.09947"} arXiv:1807.09947
          %p
            On topological complexity of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Klein+bottle"} Klein bottle
          %ul
            %li#CohenVandembroucq16
              %a.existingWikiWord{:href => "/nlab/show/Daniel+C.+Cohen"}> Daniel C. Cohen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lucile+Vandembroucq"} Lucile Vandembroucq
              %em Topological Complexity of the Klein bottle
              (2018),
              %a{:href => "https://arxiv.org/abs/1612.03133v3"} arXiv:1612.03133v3
          %p
            On topological complexity of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
          %ul
            %li#FarberGrant08
              %a.existingWikiWord{:href => "/nlab/show/Michael+Farber"}> Michael Farber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mark+Grant"} Mark Grant
              %em Topological Complexity of the Klein bottle
              (2008),
              %a{:href => "https://arxiv.org/pdf/0806.4111.pdf"} arXiv:0806.4111
