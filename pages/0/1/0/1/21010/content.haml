                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1411.5243"} arXiv:1411.5243
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans+G%C3%BCnter+Dosch"}> Hans Günter Dosch
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Guy+de+Teramond"} Guy de Teramond
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stanley+Brodsky"} Stanley Brodsky
                = succeed "," do
                  %em Supersymmetry Across the Light and Heavy-Light Hadronic Spectrum
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1504.05112"} arXiv:1504.05112
            %li#BTDL16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Brodsky"}> Stanley Brodsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Guy+de+T%C3%A9ramond"} Guy de Téramond
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hans+G%C3%BCnter+Dosch"} Hans Günter Dosch
                = succeed "," do
                  %em Meson/Baryon/Tetraquark Supersymmetry from Superconformal Algebra and Light-Front Holography
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1606.04638"} arXiv:1606.04638
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans+G%C3%BCnter+Dosch"}> Hans Günter Dosch
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Guy+de+Teramond"} Guy de Teramond
                = succeed "," do
