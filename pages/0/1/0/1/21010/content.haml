                = succeed "," do
                  %em Supersymmetry Across the Light and Heavy-Light Hadronic Spectrum II
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1612.02370"} arXiv:1612.02370
            %li#NielsenBrodsky18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marina+Nielsen"}> Marina Nielsen
                ,
                = succeed "," do
