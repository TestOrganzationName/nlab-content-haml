                    %annotation{:encoding => "application/x-tex"} \rho _{i}(x) \ne 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi p
                      %mi i
