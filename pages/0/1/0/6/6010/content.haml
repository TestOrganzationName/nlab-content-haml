                  %annotation{:encoding => "application/x-tex"} p_{i}^{-1}(W)
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mo{:stretchy => "false"} (
