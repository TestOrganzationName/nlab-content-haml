              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                    %mo ∈
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_{j} \in V^{*}
              such that the composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mi j
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} ^{(\infty )} \to V \xrightarrow{f_{j}} \mathbb{R}
              is the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          %p
            With an assumption on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and a careful choice of partition of unity, we can ensure that our embedding so constructed has closed image.
          #theoremc.num_theorem.thplain
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a smooth manifold. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+convex+topological+vector+space"} locally convex topological vector space
              and assume that there exists a family of continuous linear functionals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi j
                    %mo :
                    %mi j
                    %mo ∈
                    %mi ℕ
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \{f_j : j \in \mathbb{N}\} \subseteq V^*
              with the properties:
            %ol
              %li
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} j \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f_j
                is non-trivial on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                          %mrow
                            %mi k
                            %mo ≠
                            %mi j
                        %mi ker
                        %msub
                          %mi f
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \bigcap_{k \ne j} \ker f_k
              %li
                The family of functionals
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi j
                          %mo ∈
                          %mi F
                      %msub
                        %mi f
                        %mi j
                      %mo :
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi F
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\sum_{j \in F} f_j : {|F|} \lt \infty\}
                is
                %a.existingWikiWord{:href => "/nlab/show/equicontinuous"} equicontinuous
            %p
              then there is an embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \psi \colon M \to V
              with closed image.
          .proof
            %h6#proof_4 Proof
            %p
              From the first property, we can find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi j
                    %mo ∈
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi k
                        %mo ≠
                        %mi j
                    %mi ker
                    %msub
                      %mi f
                      %mi k
                  %annotation{:encoding => "application/x-tex"} v_j \in \bigcap_{k \ne j} \ker f_k
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f_j(v_j) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi j
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{v_j\}
              to define a linear injection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{(\infty)} \to V
              (continuous by necessity). The functionals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                  %annotation{:encoding => "application/x-tex"} f_j
              provide the necessary coordinate projections so that the proof of Theorem
              %a.maruku-ref{:href => "#theorema"}
              works.
            %p
              In addition, we shall assume that our partition of unity used in the proof of Theorem
              %a.maruku-ref{:href => "#theorema"}
              is such that the functions therein have compact support.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_\lambda)
              be a net in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi λ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\psi(x_\lambda))
              converges in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x \ne 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊆
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} F \subseteq \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi F
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi j
                          %mo ∈
                          %mi F
                      %msub
                        %mi f
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f_F = \sum_{j \in F} f_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mi F
                    %msubsup
                      %mi f
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bigcap_F f_F^{-1}(-1,1)
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} y \in M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} N
                  %annotation{:encoding => "application/x-tex"} F \subseteq \N
              for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %msub
                        %mi f
                        %mi j
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \sum f_j(y) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to correspond to those terms in the partition of unity which are non-zero on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(M)
              has empty intersection with the above neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(M)
              can converge to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
            %p
              Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \ne 0
              and, moreover, there is some finite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} F \subseteq \mathbb{N}
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f_F(x) \ne 0
              and thus there is some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} j \in \mathbb{N}
              for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f_j(x) \ne 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi λ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} (\psi(x_\lambda)) \to x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                  %annotation{:encoding => "application/x-tex"} f_j
              is never zero. Let us pass to that subnet. Now on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ∘
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} f_i \circ \psi
              are either the functions in the partition of unity or are dominated by them. Hence there is some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
              with the property that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi λ
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \rho_i(x_\lambda) \ne 0
              (now that we’ve passed to the subnet). This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_\lambda)
              lies in the support of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ρ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \rho_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              and uniqueness of limits in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \psi(x') = x
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(M)
              is closed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p
            There are various situations in which it is straightforward to find a suitable family of functionals. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/barrelled"} barrelled
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %msub
                    %mi f
                    %mi j
                %annotation{:encoding => "application/x-tex"} \sum f_j
            weakly converges will do since then the family of partial sums is simply bounded and hence, as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is barrelled, equicontinuous.
          %p
            Thus the coordinate projections will do for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{(\infty)}
            and for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℓ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \ell^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℓ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \ell^2
            we can take weighted projections, say
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                    %mo =
                    %mfrac
                      %mn 1
                      %mi j
                    %msub
                      %mi p
                      %mi j
                  %annotation{:encoding => "application/x-tex"} f_j = \frac{1}{j} p_j
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi j
                    %msub
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{j e_j\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℓ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \ell^\infty
            we can take weighted projections corresponding to a sequence in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℓ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \ell^1
          %p
            It is interesting to note what is going on in these latter cases where we take weighted projections. If we embedded our manifold using the standard basis vectors as our “anchor points” then the structure of the ambient space is insufficient to guarantee that our manifold does not contain a convergent net with limit point outside. More exactly, there could be a net in our manifold such that in the image it converges to zero. The partition of unity is not enough to keep our points away from zero, since as we get further along the family in our partition we could need more and more terms. That is, we could have the situation where we have a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_n)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x_n
            is “seen” by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            of the functions in the partition of unity. Then we could have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi(x_n)
            to be something like
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo ,
                    %mn 0
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,\dots,0,1/n,1/n,\dots,1/n,0,\dots)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℓ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \ell^2
            then this sequence converges to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi(x_n)
            gets more and more diffuse. Introducing the weights, or rather their inverses, counters this by ensuring that terms “far down” the sequence are given more consideration.
          #sectionc.num_section
          %h3#contractibility_of_embeddings.num_section Contractibility of Embeddings
          %p
            Once we know that the space of embeddings of a compact smooth manifold in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R} ^{(\infty )}
            is not empty, its contractibility follows from rather general properties. It follows from the existence of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/shift+map"} split map
          #theoremb.num_theorem.thplain
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a smooth manifold. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a locally convex topological vector space which admits a split map. Then the space of embeddings,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Emb
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Emb(M,V)
          .proof
            %h6#proof_5 Proof
            %p
              Recall that to have a
              %a.existingWikiWord{:href => "/nlab/show/shift+map"} split map
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              means that we have a decomposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≅
                    %mi V
                    %mo ⊕
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V \cong V \oplus V
              with a non-degeneracy property. This implies that one of the induced maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V \to V
              = succeed "," do
                %em splitting map
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} S^{+} \colon V \to V
              be a splitting map and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} S^{-}
              be the remainder. Then the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} H \colon [0,1] \colon V \to V
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo +
                    %mi t
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi v
                  %annotation{:encoding => "application/x-tex"} H(t,v) = H_{t}(v) = (1 - t) v + t S^{+} v
              is a homotopy between the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} S^{+}
            %p
              At
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                    %mo =
                    %mi I
                  %annotation{:encoding => "application/x-tex"} H_{t} = I
              which is an inclusion. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t \ne 0
              then if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H_{t}(v) = 0
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi v
                    %mo =
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mi v
                  %annotation{:encoding => "application/x-tex"} S^{+} v = t^{-1}(1 - t) v
              whence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is an eigenvector of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} S^{+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} S^{+}
              is a splitting map includes the property that it has no eigenvectors, and thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H_{t}
              is an inclusion for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H_{t}
              is an embedding for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %msub
                        %mi H
                        %mi t
                      %mo +
                      %mi t
                      %msup
                        %mi S
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi v
                    %annotation{:encoding => "application/x-tex"} I = H_{t} + t S^{-} v
            %p
              Hence we can apply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H_{t}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Emb
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Emb(M,V)
              to obtain a homotopy between the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Emb
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Emb(M,V)
              and the inclusion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Emb
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Emb(M,V)
              in itself as the subspace of all embeddings that lie in the even subspace.
            %p
              Now we pick some embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \psi _{0} \colon M \to V
              which, by applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} S^{-}
              if necessary, we assume to exist in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} S^{-}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi t
                  %annotation{:encoding => "application/x-tex"} G_{t}
              on the embedding space by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi t
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %msub
                        %mi ψ
                        %mn 0
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} G_{t}(\psi ) = t \psi _{0} + (1 - t) \psi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} t \ne 1
              we can recover the embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \psi _{0}
              by composing with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} S^{-}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H_{t}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi t
                  %annotation{:encoding => "application/x-tex"} G_{t}
              as homotopies leads to the desired contraction of the embedding space.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Whitney+embedding+theorem"}> Whitney embedding theorem
                ,
                %a.existingWikiWord{:href => "/nlab/show/Nash+embedding+theorem"} Nash embedding theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hypersurface"} hypersurface
          %h2#references References
          %p Original articles:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Haefliger"}> André Haefliger
              \:
              = succeed "," do
                %em Plongements différentiables de variétés dans variétés
              %strong 36
              (1961/62) 47-82 &amp;lbrack;
              %a{:href => "https://eudml.org/doc/139228"}> eudml:139228
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Haefliger-Plongements.pdf", :title => "pdf"} pdf
          %p Monographs:
          %ul
            %li#Boothby
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+M.+Boothby"}> William M. Boothby
                , Def. III 4.11 in:
                = succeed "," do
                  %em An introduction to differentiable manifolds and Riemannian geometry
                = succeed "," do
                  %a{:href => "https://shop.elsevier.com/books/an-introduction-to-differentiable-manifolds-and-riemannian-geometry-revised/boothby/978-0-08-057475-2"} ISBN:9780121160517
                = succeed "&rbrack;" do
                  %a{:href => "https://aetemad.iut.ac.ir/sites/aetemad.iut.ac.ir/files/files_course/william_m._boothby_an_introduction_to_differentibookfi.org_.pdf"} pdf
            %li#Lee12
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lee"}> John Lee
                , Chapter 5 of:
                = succeed "," do
                  %em Introduction to Smooth Manifolds
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-1-4419-9982-5"} doi:10.1007/978-1-4419-9982-5
                = succeed "," do
                  %a{:href => "https://sites.math.washington.edu/~lee/Books/ISM/"} book webpage
                = succeed "&rbrack;" do
                  %a{:href => "https://math.berkeley.edu/~jchaidez/materials/reu/lee_smooth_manifolds.pdf"} pdf
          %p Lecture notes:
          %ul
            %li
              %p
                Paul Rapoport:
                = succeed "," do
                  %em Introduction to Immersion, Embedding and the Whitney Embedding Theorem
                = succeed ")" do
                  %a{:href => "http://schapos.people.uic.edu/MATH549_Fall2015_files/Survey%20Paul.pdf"} pdf
            %li
              %p
                Emery Thomas:
                = succeed "," do
                  %em Embedding manifolds in Euclidean space
                = succeed ")" do
                  %a{:href => "http://ir.library.osaka-u.ac.jp/metadb/up/LIBOJMK01/ojm13_01_12.pdf"} pdf
            %li
              %p
                Rodolfo De Sapio:
                = succeed "," do
                  %em
                    Embedding
                    = succeed "-manifolds" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi π
                          %annotation{:encoding => "application/x-tex"} \pi
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/pss/1970642"} jstor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Manifold+Atlas"}> Manifold Atlas
                \:
                %em
                  %a{:href => "https://web.archive.org/web/20241114020154/http://www.map.mpim-bonn.mpg.de/Embeddings_in_Euclidean_space:_an_introduction_to_their_classification"} Embeddings in Euclidean space: an introduction to their classification
          %p
            Discussion for
