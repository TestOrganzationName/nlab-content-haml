          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Γ
                        %mi t
                  %msub
                    %mi Ω
                    %mi t
                %annotation{:encoding => "application/x-tex"}
                  \\Omega_0 \xrightarrow{\Gamma_t} \Omega_t
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi t
                %annotation{:encoding => "application/x-tex"} \Omega_t
