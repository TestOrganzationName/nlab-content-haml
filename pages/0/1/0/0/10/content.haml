                  %msub
                    %mi Hom
                    %mrow
                      %msup
                        %mi Set
                        %mi G
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ×
                  %mi G
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
