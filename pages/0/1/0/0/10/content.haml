                        %mtd
                          %mo →
                        %mtd
                          %mi PSh
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{P} &amp;\to&amp; Set
                  \\\
