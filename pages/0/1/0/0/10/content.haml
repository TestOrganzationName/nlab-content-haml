            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi fp
                  %mo{:stretchy => "false"} (
                  %mi Grp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_{fp}(Grp)
            in Set, which is simply
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
            %a.existingWikiWord{:href => "/nlab/show/finitely+presentable+object"} finitely presentable
            groups. By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi fl
                    %mo{:stretchy => "false"} (
                    %mi Grp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{fl}(Grp)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
