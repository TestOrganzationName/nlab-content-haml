                  %mi G
                %annotation{:encoding => "application/x-tex"} inv : G \to G
            describing inverses, and a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mn 1
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} i: 1 \to G
            describing the identity element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
