            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            We now say this in precise manner. In the following a
            %em
              %a.existingWikiWord{:href => "/nlab/show/cartesian+site"} cartesian site
            means a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            whose underlying category is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, K)
              be
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+site"} cartesian site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              is an
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+category"} essentially small category
              and the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subcanonical+coverage"} subcanonical
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f : Sh(\mathcal{D}, K) \to Sh(\mathcal{C}, J)
            %p
              is induced by a
              %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{D}, K) \leftarrow (\mathcal{C}, J)
            %p
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              respects the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mo ←
                          %mtd
                            %mi 𝒞
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mi 𝒟
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mi 𝒞
                        %mtr
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo ,
                            %mi K
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D } &amp;\leftarrow&amp; \mathcal{C}
                    \\\
                    {}^{\mathllap{j_{\mathcal{D}}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{j_{\mathcal{C}}}}
                    \\\
                    Sh(\mathcal{D}, K) &amp;\stackrel{f^*}{\leftarrow}&amp;
                    Sh(\mathcal{C}, J)
                    }
                    \\,.
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, lemma C2.3.8
            ).
          .proof
            %h6#proof Proof
            %p It suffices to observe that the factorization, if it exists, is a morphism of sites.
          #SheafToposesAreClassifyingForTheirTheoryOfLocalAlgegras.num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},J)
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/cartesian+site"} cartesian site
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo ,
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Site
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Topos(\mathcal{E}, Sh(\mathcal{C}, J))
                    \\simeq
                    Site((\mathcal{C}, J), (\mathcal{E}, C))
            %p
              between the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J)
              and the morphisms of
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J)
              to the
              %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{E}, C)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              the
              %a.existingWikiWord{:href => "/nlab/show/canonical+coverage"} canonical coverage
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. C2.3.9
            ).
          .num_remark
            %h6#remark Remark
            %p
              This means that a sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J)
              is the classifying topos for the theory of
              %a.existingWikiWord{:href => "/nlab/show/local+algebras"} local algebras
              determined by the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C},J)
          %h2#examples Examples
          %p We list and discuss explicit examples of classifying toposes.
          %h3#for_nothing For nothing
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/empty+theory"} empty geometric theory
            has a unique model in any Grothendieck topos, its classifying topos is the terminal Grothendieck topos, namely
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            has no non-trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtoposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            follows from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕋
                    %mrow
                      %msub
                        %mi Σ
                        %mi ∅
                %annotation{:encoding => "application/x-tex"} \mathbb{T}_{\Sigma_\emptyset}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi σ
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\sigma\}
            is inconsistent. In other words, the only toposes classifying theories over the empty signature are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            and the inconsistent topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
          %p
            The empty theory is not the only theory classified by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                  %msub
                    %mo ⊢
                    %mi x
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \top\vdash_x\bot
            to the
            %a.existingWikiWord{:href => "/nlab/show/theory+of+objects"} theory of objects
            below, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is the unique sort.
          %h3#for_contradictions For contradictions
          %p
            The contradictory theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo ⊤
                  %mo ⊢
                  %mo ⊥
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\top\vdash\bot\}
            has no models in any nontrivial Grothendieck topos. Thus its classifying topos is the initial Grothendieck topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            (which is a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict initial object
          %p
            More generally, any theory that has no models in any nontrivial Grothendieck topos is classified by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero+objects"} zero objects
          %h3#ForObjects For objects
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi FinSet
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [FinSet, Set]
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
            is the classifying topos for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/theory+of+objects"} theory of objects
            %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and maybe better called in full the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/classifying+topos+for+the+theory+of+objects"} classifying topos for the theory of objects
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi FinSet
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E \to [FinSet,Set]
            is equivalently just an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FinSet(\{ * \}, -)
          %h3#ForPointedObjects For pointed objects
          %p
            Similarly, the presheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi FinSet
                    %mo *
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [FinSet_*, Set]
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSet
                    %mo *
