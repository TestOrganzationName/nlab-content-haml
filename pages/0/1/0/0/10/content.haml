          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mo !
