            and we choose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} C_{\mathcal{E}}
            to be the
            %a.existingWikiWord{:href => "/nlab/show/canonical+site"} canonical site
