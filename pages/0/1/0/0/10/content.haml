            to get a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
