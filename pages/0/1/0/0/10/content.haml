                  }
          %p
            in that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
            a morphism, the corresponding
            = succeed "-" do
