            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Polyakov"}> Alexander Polyakov
                ,
                %em Infrared instability of the de Sitter space
                (
                %a{:href => "https://arxiv.org/abs/1209.4135"}> arXiv:1209.4135
                )
            %li
              %p
                Paul R. Anderson,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emil+Mottola"} Emil Mottola
                = succeed "," do
                  %em On the Instability of Global de Sitter Space to Particle Creation
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1310.0030"} arXiv:1310.0030
            %li
              %p
                Paul Anderson,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emil+Mottola"} Emil Mottola
                = succeed "," do
                  %em Quantum Vacuum Instability of ‘Eternal’ de Sitter Space
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1310.1963"} arXiv:1310.1963
            %li#Rajaraman16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arvind+Rajaraman"}> Arvind Rajaraman
                ,
                = succeed "," do
                  %em de Sitter Space is Unstable in Quantum Gravity
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1608.07237"} arXiv:1608.07237
            %li
              %p
                Paul Anderson,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emil+Mottola"} Emil Mottola
                = succeed "," do
                  %em Decay of the de Sitter Vacuum
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1712.04522"} arXiv:1712.04522
          %h3#ReferencesInStringTheory In string/M-theory
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/no-go+theorem"} no-go theorem
            for
            %a.existingWikiWord{:href => "/nlab/show/KK-compactifications"} KK-compactifications
            of
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            down to de Sitter spacetime is claimed in
          %ul
            %li#MaldacenaNunez01
              %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"}> Juan Maldacena
              , Carlos Nunez,
              = succeed "," do
                %em Supergravity description of field theories on curved manifolds and a no go theorem
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0007018"} arXiv:hep-th/0007018
          %p
            Discussion of de Sitter
            %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory+vacua"} perturbative string theory vacua
            and their role in the
            %a.existingWikiWord{:href => "/nlab/show/landscape+of+string+theory+vacua"} landscape of string theory vacua
            or else in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/swampland"} swampland
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Kutasov"}> David Kutasov
                , Travis Maxfield, Ilarion Melnikov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"} Savdeep Sethi
                = succeed "," do
                  %em Constraining de Sitter Space in String Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1504.00056"} arXiv:1504.00056
            %li
              %p
                Jakob Moritz, Ander Retolaza, Alexander Westphal,
                = succeed "," do
                  %em Towards de Sitter from 10D
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1707.08678"} arXiv:1707.08678
            %li#Sethi17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
                ,
                %em Supersymmetry Breaking by Fluxes
                (
                %a{:href => "https://arxiv.org/abs/1709.03554"}> arXiv:1709.03554
                )
              %p re-amplified in:
              %p
                %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
                ,
                = succeed "," do
                  %em Hope or No Hope for a String Landscape?
                %a{:href => "https://indico.cern.ch/event/782251/"} StringPheno2019
                (
                %a{:href => "https://indico.cern.ch/event/782251/contributions/3441886/attachments/1870138/3076971/3_Sethi.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/SethiLandscape2019.pdf", :title => "pdf"} pdf
            %li#DanielssonVanRiet18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"}> Ulf Danielsson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"} Thomas Van Riet
                = succeed "," do
                  %em What if string theory has no de Sitter vacua?
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1804.01120"} arXiv:1804.01120
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0218271818300070"} doi:10.1142/S0218271818300070
              %p
                (problems with
                = succeed ")" do
                  %a{:href => "landscape+of+string+theory+vacua#KKLT03"} KKLT 03
            %li#vanRiet18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"}> Thomas Van Riet
                ,
                = succeed "," do
                  %em Is dS space in the Swampland
                %a{:href => "http://sp18.fuw.edu.pl/"} StringPheno18
                (
                %a{:href => "http://sp18.fuw.edu.pl/wp-content/uploads/participants-database/thomasvanriet.pdf"}> pdf slides
                )
            %li#vanRiet18a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"}> Thomas Van Riet
                ,
                = succeed "," do
                  %em Status of KKLT
                %em
                  %a{:href => "http://scgp.stonybrook.edu/archives/24870"} Simons summer workshop 2018
                (
                %a{:href => "http://scgp.stonybrook.edu/video_portal/video.php?id=3730"}> recording
                )
            %li#Danielsson18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"}> Ulf Danielsson
                ,
                %em The quantum swampland
                (
                %a{:href => "https://arxiv.org/abs/1809.04512"}> arXiv:1809.04512
                )
              %p
                (argues that the issue with
                %a.existingWikiWord{:href => "/nlab/show/string+theory"} stringy
                de Sitter
                %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
                raised in
                %a{:href => "#Sethi17"} Sethi 17
                is related to the de Sitter instability seen in QFT, according to the references
                = succeed ")" do
                  %a{:href => "#InPerturbativeQuantumGravity"} above
            %li
              %p
                Georges Obied,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hirosi+Ooguri"} Hirosi Ooguri
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em De Sitter Space and the Swampland
                (
                %a{:href => "https://arxiv.org/abs/1806.08362"}> arXiv:1806.08362
                )
            %li
              %p
                Jakob Moritz, Ander Retolaza, Alexander Westphal,
                %em On uplifts by warped anti-D3-branes
                (
                %a{:href => "https://arxiv.org/abs/1809.06618"}> arXiv:1809.06618
                )
            %li
              %p
                Iosif Bena, Emilian Dudas, Mariana Graña, Severin Lüst,
                %em Uplifting Runaways
                (
                %a{:href => "https://arxiv.org/abs/1809.06861"}> arXiv:1809.06861
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clay+Cordova"}> Clay Cordova
                , G. Bruno De Luca,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alessandro+Tomasiello"} Alessandro Tomasiello
                %em Classical de Sitter Solutions of Ten-Dimensional Supergravity
                (
                %a{:href => "https://arxiv.org/abs/1812.04147"}> arXiv:1812.04147
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Dine"}> Michael Dine
                , Jamie A.P. Law-Smith, Shijun Sun, Duncan Wood, Yan Yu,
                %em Obstacles to Constructing de Sitter Space in String Theory
                (
                %a{:href => "https://arxiv.org/abs/2008.12399"}> arXiv:2008.12399
                )
            %li
              %p
                Liam McAllister, Andreas Schachner:
                %em TASI Lectures on de Sitter Vacua
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2512.17095"}> arXiv:2512.17095
                \&amp;rbrack;
          %p
            In view of
            %a.existingWikiWord{:href => "/nlab/show/alpha%27"} alpha'
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
          %ul
            %li
              %p
                Ivano Basile, Alessia Platania,
                %em String Tension between de Sitter vacua and Curvature Corrections
                (
                %a{:href => "https://arxiv.org/abs/2103.06276"}> arXiv:2103.06276
                )
              %blockquote
                %p
                  “We show that the resulting higher-derivative
                  = succeed "-corrections" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} \alpha'
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Liam+McAllister"}> Liam McAllister
                , Jakob Moritz, Richard Nally, Andreas Schachner,
                %em Candidate de Sitter Vacua
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2406.13751"}> arXiv:2406.13751
                \&amp;rbrack;
              %blockquote
                %p “Finding vacua that demonstrably survive subleading corrections, and in which the quantization conditions are completely understood, is an important open problem for which this work has prepared the foundations.”
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
            %a.existingWikiWord{:href => "/nlab/show/cosmology"} cosmology
            realized in
            %a.existingWikiWord{:href => "/nlab/show/brane+world+models"} brane world models
            in ambient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} AdS
            %a.existingWikiWord{:href => "/nlab/show/bulk"} bulk
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %ul
            %li#BDDGS18
              %p
                Souvik Banerjee,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"} Ulf Danielsson
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"} Giuseppe Dibitetto
                %em Emergent de Sitter cosmology from decaying AdS
                (
                %a{:href => "https://arxiv.org/abs/1807.01570"}> arXiv:1807.01570
                )
            %li
              %p
                Souvik Banerjee,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"} Ulf Danielsson
                %em de Sitter Cosmology on an expanding bubble
                (
                %a{:href => "https://arxiv.org/abs/1907.04268"}> arXiv:1907.04268
                )
          %p
            Discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
          %ul
            %li
              %p
                Beatriz de Carlos, Andre Lukas, Stephen Morris,
                = succeed "," do
                  %em
                    Non-perturbative vacua for M-theory on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} G_2
                    manifolds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0409255"} arxiv:hep-th/0409255
              %p
                which concludes that with taking
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effects"} non-perturbative effects
                from
                %a.existingWikiWord{:href => "/nlab/show/membrane+instantons"} membrane instantons
                into account one gets 4d vacua with vanishing and negative
                %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
                (
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/anti-de+Sitter+spacetime"} anti-de Sitter spacetime
                %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
                (
                %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"}> de Sitter spacetime
                ). They close by speculating that
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                instantons might yield
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
            %li
              %p
                Johan Blåbäck,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"} Ulf Danielsson
                %em Constructing stable de Sitter in M-theory from higher curvature corrections
                (
                %a{:href => "https://arxiv.org/abs/1902.04053"}> arXiv:1902.04053
                )
              %p
                which suggests that including
                %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
                makes it work
            %li
              %p
                Iosif Bena, Alex Buchel, Severin Lüst,
                %em Throat destabilization (for profit and for fun)
                (
                %a{:href => "https://arxiv.org/abs/1910.08094"}> arxiv:1910.08094
                )
          %p
            For analogous discussion of embedding of the
            = succeed "-scenario" do
              %a.existingWikiWord{:href => "/nlab/show/ekpyrotic+cosmology"} ekpyrotic cosmology
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+IIA+supergravity"} type IIA supergravity
          %ul
            %li#Uzawa18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kunihito+Uzawa"}> Kunihito Uzawa
                ,
                = succeed "," do
                  %em No-Go theorems for ekpyrosis from ten-dimensional supergravity
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1803.11084"} arXiv:1803.11084
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/JHEP06(2018)041"} doi:10.1007/JHEP06(2018)041
              %p reviewed in:
              %p
                Kunihito Uzawa,
                %em Ekpyrotic scenario in string theory
                (
                %a{:href => "http://www2.yukawa.kyoto-u.ac.jp/~gc2018/slides/4th/Mar2/Uzawa.pdf"}> pdf
                )
          %p
            Discussion of
            %em asymptotic
            de Sitter spacetimes from time-dependent
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
          %ul
            %li#MarconnetTsimpis23
              Paul Marconnet,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
              = succeed "," do
                %em Universal accelerating cosmologies from 10d supergravity
              %strong 2023
              33 (2023) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2210.10813"}> arXiv:2210.10813
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/JHEP01(2023)033"} doi:10.1007/JHEP01(2023)033
          %p reviewed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"}> Dimitrios Tsimpis
              ,
              = succeed "," do
                %em Universal accelerating cosmologies from 10d supergravity
              = succeed "," do
                %em
                  %a{:href => "/nlab/show/M-Theory+and+Mathematics#2023"} M-Theory and Mathematics 2023
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/Tsimpis-MTheoryMath2023.pdf", :title => "pdf"} pdf
              = succeed "," do
                %a{:href => "https://www.youtube.com/watch?v=LEiqYz-G34g"} YT
              = succeed "&rbrack;" do
