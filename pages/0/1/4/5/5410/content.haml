                        \&amp; &amp;
                        {}^{\mathllap{f e}}\downarrow^{\mathrlap{e' g}}
                        \&amp;&amp;
                        \\downarrow^{\mathrlap{e'}}
                        \\\
                        a &amp;\underset{f}{\to}&amp; a' &amp;\stackrel{Id}{\to}&amp; a'
                        }
                        \\,.
            %p
              To see that this construction indeed yields an equivalence of categories, define a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ←
                    %mi E
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi E
                    %mo :
                    %msup
                      %mi B
                      %mi op
                    %mo ×
                    %mi A
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A\leftarrow E \to B) \mapsto (F_E : B^{op} \times A \to Set)
              by setting
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msub
                          %mi E
                          %mrow
                            %mi b
                            %mo ,
                            %mi a
                      %annotation{:encoding => "application/x-tex"} F_E(b,a) := E_{b,a}
                  ;
              %li
                %p
                  for a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mover
                          %mo →
                          %mi g
                        %mi b
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} b \stackrel{g}{\to} b'
                  let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ,
                        %mi a
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi F
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ′
                        %mo ,
                        %mi a
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi F
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ,
                        %mi a
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_E(g,a') : F_E(b',a') \to F_E(b,a')
                  be the function that sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ′
                        %mover
                          %mo →
                          %mrow
                            %mi e
                            %mo ′
                        %mi a
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} b' \stackrel{e'}{\to} a'
                  to the domain of the unique lift of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mover
                          %mo →
                          %mi g
                        %mi b
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} b \stackrel{g}{\to} b'
                  with this codomain and mapping to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Id
                            %mrow
                              %mi a
                              %mo ′
                        %annotation{:encoding => "application/x-tex"} Id_{a'}
              %li
                %p
                  for a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mover
                          %mo →
                          %mi f
                        %mi a
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} a \stackrel{f}{\to} a'
                  let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
