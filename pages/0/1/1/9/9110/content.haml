                  %msub
                    %mi{:mathvariant => "normal"} Ric
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{R}
                  \\;=\;
                  \\eta^{a b}
                  \\mathrm{Ric}_{a b}
                  \\,,
          %p
            then its
            %a.existingWikiWord{:href => "/nlab/show/Einstein+tensor"} Einstein tensor
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} G
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} Ric
                    %mrow
                      %mi a
                      %mi b
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mi{:mathvariant => "normal"} R
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mi D
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} R
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %mi D
                        %mo −
                        %mn 2
                      %mrow
                        %mn 2
                        %mi D
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} R
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{G}_{a b}
                  \\;\equiv\;
                  \\mathrm{Ric}_{a b}
                  \-
                  \\tfrac{1}{2}
                  \\mathrm{R}
                  \\,
                  \\eta_{a b}
                  \\;=\;
                  \\big(
                  \\tfrac
                  {1}
                  {D}
                  \-
                  \\tfrac{1}{2}
                  \\big)
                  \\,
                  \\mathrm{R}
                  \\,
                  \\eta_{a b}
                  \\;=\;
                  \-
                  \\tfrac
                  { D - 2 }
                  { 2 D }
                  \\,
                  \\mathrm{R}
                  \\;
                  \\eta_{a b}
          %p
            so that
            %a.existingWikiWord{:href => "/nlab/show/Einstein%27s+equations"} Einstein's equations
            equivalently say
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} G
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi Λ
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} R
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %mn 2
                        %mi D
                      %mrow
                        %mi D
                        %mo −
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mi Λ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{G}_{a b}
                  \\;=\;
                  \\Lambda \, \eta_{a b}
                  \\;\;\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;\;\;
                  \\mathrm{R}
                  \\;=\;
                  \-
                  \\tfrac{2 D}{D-2}
                  \\,
                  \\Lambda
                  \\,,
          %p implying
          #eq:CosmologicalConstantAndScalarCurvature.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center right", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi Λ
                        %mo &gt;
                        %mn 0
                      %mtd
                        %mo ⇔
                      %mtd
                        %mi{:mathvariant => "normal"} R
                        %mo &lt;
                        %mn 0
                      %mtd
                        %mo ⇔
                      %mtd
                        %mtext de Sitter spacetime
                    %mtr
                      %mtd
                        %mi Λ
                        %mo &lt;
                        %mn 0
                      %mtd
                        %mo ⇔
                      %mtd
                        %mi{:mathvariant => "normal"} R
                        %mo &gt;
                        %mn 0
                      %mtd
                        %mo ⇔
                      %mtd
                        %mtext anti de Sitter spacetime
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccr}
                  \\Lambda \gt 0
                  \&amp;\Leftrightarrow&amp;
                  \\mathrm{R} \lt 0
                  \&amp;\Leftrightarrow&amp;
                  \\text{de Sitter spacetime}
                  \\\
                  \\Lambda \lt 0
                  \&amp;\Leftrightarrow&amp;
                  \\mathrm{R} \gt 0
                  \&amp;\Leftrightarrow&amp;
                  \\text{anti de Sitter spacetime}
                  \\end{array}
          %h3#TheGeneralFreundRubinSolution The general Freund-Rubin solution
          %p
            We spell out the main argument due to
            = succeed "." do
              %a{:href => "#FreundRubin80"} Freund &amp; Rubin 1980
          %p
            %br/
          %p
            Consider a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} D \geq 3
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            which is the
            %a.existingWikiWord{:href => "/nlab/show/product+manifold"} product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi Y
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo −
                      %mi s
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X^{(D)} \;=\; X^{(s)} \times Y^{(D-s)}
          %p of
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X^{(s)}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo ≤
                        %mi s
                        %mo ≤
                        %mi D
                        %mo −
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2 \leq s \leq D-2
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Y
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y^{(D-s)}
          %p
            and assume that both factors are
            %a.existingWikiWord{:href => "/nlab/show/Einstein+manifolds"} Einstein manifolds
            by themselves, in that their
            %a.existingWikiWord{:href => "/nlab/show/Ricci+tensors"} Ricci tensors
            are of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi Ric
                          %mrow
                            %mi a
                            %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msub
                                %mi{:mathvariant => "normal"} R
                                %mi s
                            %mi s
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi η
                          %mrow
                            %mi a
                            %mi b
                    %mtr
                      %mtd
                        %msub
                          %mi Ric
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msub
                                %mi{:mathvariant => "normal"} R
                                %mrow
                                  %mi D
                                  %mo −
                                  %mi s
                            %mrow
                              %mi D
                              %mo −
                              %mi s
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi δ
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  Ric_{a b}
                  \\;=\;
                  \\tfrac
                  {\mathrm{R}_s}
                  {s}
                  \\,
                  \\eta_{a b}
                  \\\
                  Ric_{i j}
                  \\;=\;
                  \\tfrac
                  {\mathrm{R}_{D-s}}
                  {D-s}
                  \\,
                  \\delta_{i j}
                  \\,.
                  \\end{array}
          %p
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} R
                      %mi s
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} R
                      %mrow
                        %mi D
                        %mo −
                        %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathrm{R}_s, \mathrm{R}_{D-s} \,\in\, \mathbb{R}
          %p
            Then the total
            %a.existingWikiWord{:href => "/nlab/show/scalar+curvature"} scalar curvature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} R
                  %mo ≡
                  %msup
                    %mi g
                    %mrow
                      %mi μ
                      %mi ν
                  %msub
                    %mi Ric
                    %mrow
                      %mi μ
                      %mi ν
                %annotation{:encoding => "application/x-tex"} \mathrm{R} \equiv g^{\mu \nu} Ric_{\mu \nu}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} R
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} R
                    %mi s
                  %mo +
                  %msub
                    %mi{:mathvariant => "normal"} R
                    %mrow
                      %mi D
                      %mo −
                      %mi s
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{R}
                  \\;=\;
                  \\mathrm{R}_s + \mathrm{R}_{D-s}
                  \\,,
          %p
            and the non-vanishing components of the
            %a.existingWikiWord{:href => "/nlab/show/Einstein+tensor"} Einstein tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≡
                  %mi Ric
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mi{:mathvariant => "normal"} R
                  %mi g
                %annotation{:encoding => "application/x-tex"} G \equiv Ric - \tfrac{1}{2}\mathrm{R}g
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi G
                          %mrow
                            %mi a
                            %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mrow
                            %mi D
                            %mo −
                            %mn 2
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi η
                          %mrow
                            %mi a
                            %mi b
                    %mtr
                      %mtd
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mi s
                        %mo +
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi D
                              %mo −
                              %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mrow
                            %mi D
                            %mo −
                            %mn 2
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi δ
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  G_{a b}
                  \\;=\;
                  \\Big(
                  \\big(\tfrac{1}{s} - \tfrac{1}{2}\big)
                  \\mathrm{R}_s
                  \-
                  \\tfrac{1}{2}
                  \\mathrm{R}_{D-2}
                  \\Big)
                  \\,
                  \\eta_{a b}
                  \\\
                  G_{i j}
                  \\;=\;
                  \\Big(
                  \-\tfrac{1}{2}
                  \\mathrm{R}_s
                  +
                  \\big(
                  \\tfrac{1}{D-s}
                  \-
                  \\tfrac{1}{2}
                  \\big)
                  \\mathrm{R}_{D-2}
                  \\Big)
                  \\,
                  \\delta_{i j}
                  \\,.
                  \\end{array}
          %p
            Next assume that the “matter” content is that of a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            with degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            homogeneously extended over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{(s)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi s
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi ϵ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi s
                %annotation{:encoding => "application/x-tex"}
                  F_{a_1 \cdots a_s}
                  \\;\equiv\;
                  f\,
                  \\epsilon_{a_1 \cdots a_s}
          %p
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \in \mathbb{R}
          %p
            Then its
            %a.existingWikiWord{:href => "/nlab/show/energy-momentum+tensor"} energy-momentum tensor
          #eq:EnergyMomentumTensorOfHigherGaugeField.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi μ
                      %mi ν
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi s
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi μ
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi μ
                        %mi s
                  %msup
                    %mi F
                    %mrow
                      %msub
                        %mi μ
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi μ
                        %mi s
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi g
                    %mrow
                      %mi μ
                      %mi ν
                  %mo −
                  %msub
                    %mi F
                    %mrow
                      %mi μ
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi μ
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi μ
                        %mrow
                          %mi s
                          %mo −
                          %mn 1
                  %msub
                    %mi F
                    %mi ν
                  %msup
                    %mrow
                    %mrow
                      %msub
                        %mi μ
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi μ
                        %mrow
                          %mi s
                          %mo −
                          %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  T_{\mu \nu}
                  \\;=\;
                  \\big(
                  \\tfrac{1}{2s}
                  F_{\mu_1 \cdots \mu_s}
                  F^{\mu_1 \cdots \mu_s}
                  \\,
                  g_{\mu \nu}
                  \-
                  F_{\mu \, \mu_1 \cdots \mu_{s-1}}
                  F_{\nu}{}^{ \mu_1 \cdots \mu_{s-1} }
                  \\big)
          %p has non-vanishing components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi T
                          %mrow
                            %mi a
                            %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi f
                          %mn 2
                        %munder
                          %munder
                            %mrow
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo !
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi s
                                    %mo !
                                  %mrow
                                    %mn 2
                                    %mi s
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ⏟
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi s
                                  %mo −
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo !
                                %mn 2
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi η
                          %mrow
                            %mi a
                            %mi b
                    %mtr
                      %mtd
                        %msub
                          %mi T
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi f
                          %mn 2
                        %munder
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %munder
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mrow
                                      %mi s
                                      %mo !
                                    %mrow
                                      %mn 2
                                      %mi s
                              %mo ⏟
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi s
                                  %mo −
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo !
                                %mn 2
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi η
                          %mrow
                            %mi i
                            %mi j
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  T_{a b}
                  \\;=\;
                  f^2
                  \\underset{
                  +\,\tfrac{(s-1)!}{2}
                  }{
                  \\underbrace{
                  \\big(
                  (s-1)!
                  \-
                  \\tfrac{s!}{2s}
                  \\big)
                  }
                  }
                  \\,
                  \\eta_{a b}
                  \\\
                  T_{i j}
                  \\;=\;
                  f^2
                  \\underset{
                  \-\,\tfrac{(s-1)!}{2}
                  }{
                  \\big(
                  \\underbrace{
                  \-
                  \\tfrac{s!}{2s}
                  }
                  \\big)
                  }
                  \\,
                  \\eta_{i j}
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            Therefore the
            %a.existingWikiWord{:href => "/nlab/show/Einstein+equation"} Einstein equation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi T
                %annotation{:encoding => "application/x-tex"} G \;=\; T
            says in this case that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mrow
                            %mi D
                            %mo −
                            %mi s
                      %mtd
                        %mo =
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo !
                            %mn 2
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi f
                          %mn 2
                    %mtr
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mi s
                        %mo +
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi D
                              %mo −
                              %mi s
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mrow
                            %mi D
                            %mo −
                            %mi s
                      %mtd
                        %mo =
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo !
                            %mn 2
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi f
                          %mn 2
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{rcl}
                  \\big(
                  \\tfrac{1}{s} - \tfrac{1}{2}
                  \\big)
                  \\mathrm{R}_s
                  \-
                  \\tfrac{1}{2}\mathrm{R}_{D-s}
                  \&amp;=&amp;
                  + \tfrac{(s-1)!}{2}\, f^2
                  \\\
                  \-\tfrac{1}{2} \mathrm{R}_s
                  +
                  \\big(
                  \\tfrac{1}{D-s}
                  \-
                  \\tfrac{1}{2}
                  \\big)
                  \\mathrm{R}_{D-s}
                  \&amp;=&amp;
                  \- \tfrac{(s-1)!}{2} \, f^2
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            The unique solution to this system of
            %a.existingWikiWord{:href => "/nlab/show/linear+equations"} linear equations
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} R
                      %mi s
                  %annotation{:encoding => "application/x-tex"} \mathrm{R}_s
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} R
                    %mrow
                      %mi D
                      %mo −
                      %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{R}_{D-s}
            is (see
            %code WolframAlpha
            = succeed ")" do
              %a{:href => "https://www.wolframalpha.com/input?i=LinearSolve%5B+%7B+%7B++1%2Fs+-+1%2F2+%2C++-1%2F2+%7D++%2C+%7B+-1%2F2+++%2C++1%2F%28D-s%29++-+1%2F2++%7D++%7D%2C+%7B++%28s-1%29%21%2F2+%2C+-+%28s-1%29%21%2F2+%7D+%5D"} here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mi s
                      %mtd
                        %mo =
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mspace{:width => "thinmathspace"}
                        %mfrac
                          %mrow
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo −
                            %mi s
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi D
                            %mo −
                            %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi f
                          %mn 2
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mrow
                            %mi D
                            %mo −
                            %mi s
                      %mtd
                        %mo =
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mspace{:width => "thinmathspace"}
                        %mfrac
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi D
                            %mo −
                            %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi f
                          %mn 2
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{rcl}
                  \\mathrm{R}_s
                  \&amp;=&amp;
                  +
                  \\,
                  \\frac
                  { s (D - s - 1) }
                  { D - 2 }
                  \\,
                  (s-1)!
                  \\,
                  f^2
                  \\\
                  \\mathrm{R}_{D-s}
                  \&amp;=&amp;
                  \-
                  \\,
                  \\frac
                  { (s-1)(D-s) }
                  { D-2 }
                  \\,
                  (s-1)!
                  \\,
                  f^2
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            This is the result originally reported in
            %a{:href => "#FreundRubin80"} Freund &amp; Rubin 1980 (7)
            (the case where their
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi s
                %annotation{:encoding => "application/x-tex"} g_s
            is Lorentzian, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} det(g_s)
            is negative — except that they seem to drop the joint factor of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo !
                  %annotation{:encoding => "application/x-tex"} (s-1)!
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} s=2
            the factor disappears and we get their equation (4) on the nose).
          %p#Conclusion
            By comparison with
            %a.maruku-eqref{:href => "#eq:CosmologicalConstantAndScalarCurvature"} (1)
            this means that for the maximally extended solution
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X^{(s)}
                is an
                %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} anti de Sitter spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi AdS
                        %mi s
                    %annotation{:encoding => "application/x-tex"} AdS_s
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo −
                          %mi s
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X^{(D-s)}
                is a
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} sphere
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi D
                            %mo −
                            %mi s
                      %annotation{:encoding => "application/x-tex"} S^{D-s}
          %h3#examples Examples
          %p
            The case of
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            is
          %ul
            %li
