                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mi{:mathvariant => "normal"} R
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi a
                      %mo ′
                  %munder
                    %munder
                      %mrow
                        %msubsup
                          %mi δ
                          %mrow
                            %mi b
                            %mspace{:width => "thinmathspace"}
                            %mi c
                          %mrow
                            %mi a
                            %mo ′
                            %mspace{:width => "thinmathspace"}
                            %mi c
                      %mo ⏟
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi D
                            %mo −
                            %mn 1
                          %mn 2
                      %msubsup
                        %mi δ
                        %mi b
                        %mrow
                          %mi a
                          %mo ′
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi{:mathvariant => "normal"} R
                      %mi D
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Ric}_{a b}
                  \\;\equiv\;
                  \\eta_{a a'}
