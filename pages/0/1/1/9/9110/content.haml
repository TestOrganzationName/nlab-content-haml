                = succeed "," do
                  %em
                    Multi-membrane solutions of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} D = 11
                    supergravity
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/299386"} spire:299386
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-2693(91)91371-2"} doi:10.1016/0370-2693(91)91371-2
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Pilch"} Krzysztof Pilch
              = succeed "," do
                %em
                  Consistent truncation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 11
                      %annotation{:encoding => "application/x-tex"} d = 11
                  supergravity on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 4
                        %mo ×
                        %msup
                          %mi S
                          %mn 7
                      %annotation{:encoding => "application/x-tex"} AdS_4 \times S^7
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1112.6131"} arXiv:1112.6131
          %p A classification of symmetric solutions is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"}> José Figueroa-O'Farrill
                ,
                %em Symmetric M-Theory Backgrounds
                (
                %a{:href => "http://arxiv.org/abs/1112.4967"}> arXiv:1112.4967
                )
            %li
              %p
                Linus Wulff,
                %em All symmetric space solutions of eleven-dimensional supergravity
                (
                %a{:href => "https://arxiv.org/abs/1611.06139"}> arXiv:1611.06139
                )
          %p
            The class of Freund-Rubin compactifications of 6d
            %a.existingWikiWord{:href => "/nlab/show/Einstein-Maxwell+theory"} Einstein-Maxwell theory
            down to 4d is due to
          %ul
            %li#RDSS83
              S. Randjbar-Daemi,
              %a.existingWikiWord{:href => "/nlab/show/Abdus+Salam"} Abdus Salam
              and J. A. Strathdee,
              = succeed "," do
                %em Spontaneous Compactification In Six-Dimensional Einstein-Maxwell Theory
              = succeed ")" do
                %a{:href => "https://inspirehep.net/record/182427/"} spire
          %p
            now a popoular toy example for
            %a.existingWikiWord{:href => "/nlab/show/flux+compactifications"} flux compactifications
            and
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %p
            Textbook account (in
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fré formulation
          %ul
            %li#CastellaniDAuriaFre
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
              = succeed "," do
                %a{:href => "https://doi.org/10.1142/0224"} doi:10.1142/0224
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChV4.pdf", :title => "pdf"} pdf
          %p
            Discussion of compactification along the fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %msup
                    %mi S
                    %mn 7
                  %mo →
                  %mi ℂ
                  %msup
                    %mi P
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S^1 \to S^7 \to \mathbb{C}P^3
            is in
          %ul
            %li#NilssonPope84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"}> Bengt Nilsson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Pope"} Christopher Pope
                = succeed "," do
                  %em Hopf Fibration of Eleven-dimensional Supergravity
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/202535/"} Spire
            %li#ABJM08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ofer+Aharony"}> Ofer Aharony
                , Oren Bergman, Daniel Louis Jafferis,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 6
                      %annotation{:encoding => "application/x-tex"} N=6
                  superconformal Chern-Simons-matter theories, M2-branes and their gravity duals
                (
                %a{:href => "http://arxiv.org/abs/0806.1218"}> arXiv:0806.1218
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/ABJM+model"} ABJM model
          %p
            Discussion of the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 7
                %annotation{:encoding => "application/x-tex"} X_7
            is an
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            or has other
            %a.existingWikiWord{:href => "/nlab/show/singularities"} singularities
            (the case of interest for realistic
            %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenology
            in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frederik+Denef"} Frederik Denef
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"} Neil Lambert
              %em Freund-Rubin Revisited
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/0308046"}> arXiv:hep-th/0308046
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://inspirehep.net/literature/625121"} spire:625121
          %p
            Specifically, discussion of an
            %a.existingWikiWord{:href => "/nlab/show/ADE+classification"} ADE classification
            of 1/2
            = succeed "-compactifications" do
              %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                  %mo{:stretchy => "false"} /
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} S^7/\Gamma
            for a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+de+Medeiros"}> Paul de Medeiros
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"} José Figueroa-O'Farrill
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sunil+Gadhia"} Sunil Gadhia
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Elena+M%C3%A9ndez-Escobar"} Elena Méndez-Escobar
              = succeed "," do
                %em Half-BPS quotients in M-theory: ADE with a twist
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/0909.0163"} arXiv:0909.0163
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~jmf/CV/Seminars/YRM2010.pdf"} pdf slides
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/weak+G%E2%82%82+holonomy"} weak G₂ holonomy
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 7
                %annotation{:encoding => "application/x-tex"} X_7
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Adel+Bilal"}> Adel Bilal
              , J.-P. Derendinger, K. Sfetsos,
              = succeed "," do
                %em
                  (Weak)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                  Holonomy from Self-duality, Flux and Supersymmetry
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0111274"} arXiv:hep-th/0111274
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"}> Ergin Sezgin
              ,
              %em
                11D Supergravity on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi AdS
                        %mn 4
                      %mo ×
                      %msup
                        %mi S
                        %mn 7
                    %annotation{:encoding => "application/x-tex"} AdS_4 \times S^7
                versus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi AdS
                        %mn 7
                      %mo ×
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} AdS_7 \times S^4
              (
              %a{:href => "https://arxiv.org/abs/2003.01135"}> arXiv:2003.01135
              )
