                  \=
                  0
                  \\phantom{AA}\text{hence equivalently} \phantom{AA}
                  \\chi_{V}\left(g\right) \;=\; 0
                  \\,,
                  \\phantom{AAA}
                  g \neq e
          #UnitRegularRepresentation.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
                solves tadpole cancellation for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fractional+D-branes"} fractional D-branes
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.maruku-eqref{:href => "#eq:VanishingOfCharacterValuesOnNontrivialSubgroups"} (2)
              is satisfied by all multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ⋅
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} n \cdot k[G/1]
              of the
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[G/1]
              (since no non-trivial element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              has
              %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
              when acting on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")." do
                %a{:href => "table+of+marks#MarkHomomorphismIsCharactersOfPermutationRepresentation"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              and
              %a.existingWikiWord{:href => "/nlab/show/charge"} charge
              %a.maruku-eqref{:href => "#eq:ChargeMass"} (1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/fractional+D-brane"} fractional D-brane
              corresponding to the
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mrow
                        %msub
                          %mrow
                          %mrow
                            %mi k
                            %mo{:stretchy => "false"} [
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mn 1
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %msub
                      %mi Q
                      %mrow
                        %msub
                          %mrow
                          %mrow
                            %mi k
                            %mo{:stretchy => "false"} [
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mn 1
                            %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    M_{{}_{k[G/1]}}
                    \\;=\;
                    1
                    \\,,
                    \\phantom{AA}
                    Q_{{}_{k[G/1]}}(g)
                    \\;=\;
                    0
                    \\,.
            %p
              These multiples of the
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              are regarded as trivial solutions to
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:VanishingOfCharacterValuesOnNontrivialSubgroups"} (2)
          #RegularRepSpansSolutionToHomogeneousTadpoleCancellation.num_prop
            %h6#proposition Proposition
            %p
              In fact, the multiples of the
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#UnitRegularRepresentation"}
              %em only
              solutions to the local/twisted tadpole cancellation condition
              %a.maruku-eqref{:href => "#eq:VanishingOfCharacterValuesOnNontrivialSubgroups"} (2)
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fractional+D-branes"} fractional D-branes
          .proof
            %h6#proof Proof
            %p
              Consider the truncated
              %a.existingWikiWord{:href => "/nlab/show/character+morphism"} character morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Rep
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi χ
                    %msup
                      %mi k
                      %mrow
                        %mo |
                        %mi ConjCl
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo |
                    %mover
                      %mo ⟶
                      %mtext forget dimension/mass
                    %msup
                      %mi k
                      %mrow
                        %mrow
                          %mo |
                          %mi ConjCl
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo |
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Q \cdot {\vert G \vert}
                    \\;\colon\;
                    Rep_k(G)
                    \\overset{\chi}{\longrightarrow}
                    k^{\left\vert ConjCl(G)  \right\vert}
                    \\overset{ \text{forget dimension/mass}  }{\longrightarrow}
                    k^{\left\vert ConjCl(G)\right\vert -1 }
                    \\,.
            %p
              We have to show that the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of this map is the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              generated by the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Q
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo ⋅
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ker\big(
                    Q \cdot {\vert G \vert}
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Z} \cdot k[G/1]
                    \\,.
            %p
              Now over a
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              (such as the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed ")" do
                %a{:href => "character+of+a+linear+representation#NormalizedSumOfCharacters"} this Example
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo ≠
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \rho \neq \mathbf{1}
                  a non-
                  %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi g
                            %mo ∈
                            %mi G
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mi e
                            %mo{:stretchy => "false"} }
                        %msub
                          %mi Q
                          %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi G
                          %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi g
                            %mo ∈
                            %mi G
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mi e
                            %mo{:stretchy => "false"} }
                        %msub
                          %mi χ
                          %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{g \in G \setminus \{e\}}{\sum} Q_{\rho}(g) \cdot {\vert G \vert}
                        \\;\coloneqq\;
                        \\underset{g \in G \setminus \{e\}}{\sum} \chi_\rho(g)
                        \\;=\;
                        \- dim(\rho)
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \rho = \mathbf{1}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi g
                            %mo ∈
                            %mi G
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mi e
                            %mo{:stretchy => "false"} }
                        %msub
                          %mi Q
                          %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi G
                          %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi g
                            %mo ∈
                            %mi G
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mi e
                            %mo{:stretchy => "false"} }
                        %msub
                          %mi χ
                          %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo |
                          %mi G
                          %mo |
                        %mo −
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mi mod
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi G
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{g \in G \setminus \{e\}}{\sum} Q_{\rho}(g) \cdot {\vert G \vert}
                        \\;\coloneqq\;
                        \\underset{g \in G \setminus \{e\}}{\sum} \chi_\rho(g)
                        \\;=\;
                        {\left\vert G\right \vert}  - 1
                        \\;=\;
                        \- dim(\mathbf{1}) \;mod\; {\vert G\vert}
            %p
              Since every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %msub
                      %mi R
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in R_{k}(G)
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
              of these
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
              %em fractional part
              of the
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              of a
              %a.existingWikiWord{:href => "/nlab/show/fractional+D-brane"} fractional D-brane
              is recovered from its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/charges"} charges
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                    %msub
                      %mi Q
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                    %msub
                      %mi χ
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim(V)
                    \\;mod\;
                    {\vert G \vert}
                    \\;=\;
                    \-
                    \\underset{g \in G \setminus \{e\}}{\sum} Q_{V}(g) \cdot {\vert G \vert}
                    \\;\coloneqq\;
                    \-
                    \\underset{g \in G \setminus \{e\}}{\sum} \chi_V(g)
                    \\,.
            %p
              But this means that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} Q \cdot {\vert G \vert}
              must have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim(V) \;=\; 0 \;mod\; {\vert G \vert}
                    \\,.
            %p
              This is indeed the case for the multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi n
                    %mo ⋅
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} V = n\cdot k[G/1]
              of the
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#UnitRegularRepresentation"}
              %a.existingWikiWord{:href => "/nlab/show/character+morphism"} character morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
              (
              %a{:href => "character+of+a+linear+representation#InCharZeroCharacterMorphismIsInjective"}> this Prop.
              ) says that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} dim(V) = n \cdot {\vert G\vert }
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Q_V(g) = 0
              must be the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %h4#UntwistedTadpoleCancellation Global/untwisted tadpole cancellation
          %p
            On the other hand, at an
            %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
            singularity, the
            %a.existingWikiWord{:href => "/nlab/show/O-plane"} O-plane
            itself carries such charge –
            %a.existingWikiWord{:href => "/nlab/show/O-plane+charge"} O-plane charge
            (see
            = succeed "):" do
              %a{:href => "orientifold+plane#OPlaneCharge"} there
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                        %mo =
                      %annotation{:encoding => "application/x-tex"} [H] =
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mo{:stretchy => "false"} ⟨
                          %mi e
                          %mo{:stretchy => "false"} ⟩
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\langle e\rangle\right]
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi g
                            %mn 1
                          %mo{:stretchy => "false"} ⟩
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\langle g_1\rangle\right]
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi g
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\langle g_2\rangle\right]
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \cdots
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi g
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi ConjCl
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} |
                          %mo{:stretchy => "false"} ⟩
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\langle g_{\vert ConjCl(G)\vert}\rangle\right]
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi χ
                          %mi O
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \chi_O =
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi O
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} dim(O)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi tr
                          %mi O
                        %mrow
                          %mo (
                          %msub
                            %mi g
                            %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} tr_O\left( g_1\right)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi tr
                          %mi O
                        %mrow
                          %mo (
                          %msub
                            %mi g
                            %mn 2
                          %mo )
                      %annotation{:encoding => "application/x-tex"} tr_O\left(g_2\right)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \cdots
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi tr
                          %mi O
                        %mrow
                          %mo (
                          %msub
                            %mi g
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi ConjCl
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} |
                          %mo )
                      %annotation{:encoding => "application/x-tex"} tr_O\left(g_{\vert ConjCl(G)\vert}\right)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mtext O-plane
                      %annotation{:encoding => "application/x-tex"} \text{O-plane}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mtext O-plane charge in
                          %mrow
                            %mrow
                              %msub
                                %mi g
                                %mn 1
                              %mtext -twisted sector
                      %annotation{:encoding => "application/x-tex"} {\text{O-plane charge in} \atop {g_1\text{-twisted sector}}}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mtext O-plane-charge in
                          %mrow
                            %mrow
                              %msub
                                %mi g
                                %mn 2
                              %mtext -twisted sector
                      %annotation{:encoding => "application/x-tex"} {\text{O-plane-charge in} \atop {g_2\text{-twisted sector}}}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \cdots
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \cdots
          %p
            (These are
            = succeed "-plane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi O
                      %mo −
                  %annotation{:encoding => "application/x-tex"} O^-
            = succeed "-plane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi O
                      %mo +
                  %annotation{:encoding => "application/x-tex"} O^+
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi O
                      %mo −
                  %annotation{:encoding => "application/x-tex"} O^-
          %p
            Now the
            %strong untwisted (global) tadpole cancellation condition
            is that (all representations are real and) this
            %a.existingWikiWord{:href => "/nlab/show/O-plane+charge"} O-plane charge
            is cancelled against the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
          #eq:InhomogeneousTadpoleCancellation.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi V
                  %mrow
                    %mo (
                    %msub
                      %mi g
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 1
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mphantom
                    %mi AA
                  %mtext and
                  %mphantom
                    %mi AA
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\chi_{V}\left(g_{k \geq 1}\right)  \;=\; 0
                  \\phantom{AA}
                  \\text{and}
                  \\phantom{AA}
                  dim(V) = dim(O)
                  \\,.
          %p
            By Prop.
            %a.maruku-ref{:href => "#RegularRepSpansSolutionToHomogeneousTadpoleCancellation"}
            the only possible solution of this is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} dim(O)
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times the dimension of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
          #eq:VIsMultipleOfRegularRepresentation.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi N
                  %mo ⋅
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V = N \cdot k[G/1]
                  \\,.
          %p
            In basic examples the
            = succeed "-charge" do
              %a.existingWikiWord{:href => "/nlab/show/O-plane"} O-plane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo =
                  %msup
                    %mn 2
                    %mrow
                      %mi p
                      %mo −
                      %mn 4
                  %mi n
                  %mo ⋅
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  O = 2^{p-4} n \cdot  \mathbf{1}
          %p
            is for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi O
                %annotation{:encoding => "application/x-tex"} n_O
            coincident
            %a.existingWikiWord{:href => "/nlab/show/O-planes"} O-planes
            is the corresponding multiple by the
            %a.existingWikiWord{:href => "/nlab/show/O-plane+charge"} O-plane charge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi Op
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mn 2
                    %mrow
                      %mn 8
                      %mo −
                      %mn 4
                %annotation{:encoding => "application/x-tex"} \mu_{Op} = -2^{8-4}
            (
            %a{:href => "orientifold+plane#eq:OpPlaneCharge"}> here
            ) of the
            %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mn 2
                        %mrow
                          %mi p
                          %mo −
                          %mn 4
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %mo ∈
                  %mi ℕ
                  %mo ⊂
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \frac{2^{p-4}}{\vert G\vert } \in \mathbb{N} \subset \mathbb{Q}
            and is then given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %msup
                        %mn 2
                        %mrow
                          %mi p
                          %mo −
                          %mn 4
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %mo ⋅
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V \;=\; \frac{2^{p-4}}{\vert G\vert } \cdot k[G/1]
                  \\,.
          %p
            Sometimes the condition
            %a.maruku-eqref{:href => "#eq:VIsMultipleOfRegularRepresentation"} (5)
            is found with an offset by a trivial representation
          #eq:VIsMultipleOfRegularRepresentation.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi N
                  %mo ⋅
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mi triv
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V = N \cdot k[G/1] + \mathbf{p}_{triv}
                  \\,.
          %p
            This corresponds to single fractional D-branes sitting on top of the O-planes, turning
            = succeed "-planes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
