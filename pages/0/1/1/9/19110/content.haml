            One finds (
            %a{:href => "https://www.wolframalpha.com/input/?i=Nullspace+Transpose%5B%7B%7B1,1,1,1,1%7D,%7B1,1,%E2%88%921,%E2%88%921,1%7D,%7B2,%E2%88%921,0,0,%E2%88%921%7D,%7B%E2%88%922,2,0,0,%E2%88%922%7D,%7B%E2%88%924,%E2%88%922,0,0,2%7D%7D%5D"}> here
            ) that the general solution to the local/twisted tadpole cancellation condition
            %a.maruku-eqref{:href => "#eq:VanishingOfCharacterValuesOnNontrivialSubgroups"} (2)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
