            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ⋅
                  %msub
                    %mi V
                    %mn 0
                %annotation{:encoding => "application/x-tex"} N \cdot V_0
            of one single
            %a.existingWikiWord{:href => "/nlab/show/fractional+D-brane"} fractional D-brane
            %a.existingWikiWord{:href => "/nlab/show/bound+state"} bound state
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 0
                    %mo ∈
                    %msubsup
                      %mi KO
