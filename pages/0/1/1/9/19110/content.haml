          %p
            One finds (
            %a{:href => "https://www.wolframalpha.com/input/?i=Nullspace+Transpose%5B%7B%7B1,1,1,1,1,1,1,1%7D,%7B4,1,0,-1,-1,1,-1,-1%7D,%7B5,-1,1,0,0,-1,0,0%7D,%7B6,0,-2,1,1,0,1,1%7D,%7B-12,0,0,2,2,0,-2,-2%7D,%7B-8,2,0,-2,-2,-2,2,2%7D,%7B-8,-4,0,-2,-2,4,2,2%7D%7D%5D"}> here
            ) that the general solution to the local/twisted tadpole cancellation condition
            %a.maruku-eqref{:href => "#eq:VanishingOfCharacterValuesOnNontrivialSubgroups"} (2)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mn 2
                  %mi I
                %annotation{:encoding => "application/x-tex"} G = 2I
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mn 1
                  %mo ⋅
                  %msub
                    %mi V
                    %mn 1
                  %mo +
                  %mn 4
                  %mo ⋅
                  %msub
                    %mi V
                    %mn 2
                  %mo +
                  %mn 5
                  %mo ⋅
                  %msub
                    %mi V
                    %mn 3
                  %mo +
                  %mn 3
                  %mo ⋅
                  %msub
                    %mi V
                    %mn 4
                  %mo +
