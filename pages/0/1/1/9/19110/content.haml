            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %msub
                      %mi V
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pm V_0
            %a.existingWikiWord{:href => "/nlab/show/mass"} mass
            of these is
