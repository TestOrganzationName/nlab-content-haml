                          %mo{:stretchy => "false"} ⟨
                          %mi e
                          %mo{:stretchy => "false"} ⟩
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mn 2
                            %mi I
                            %mo{:stretchy => "false"} |
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mn 1
                          %mo ⋅
                          %mn 1
                          %mo +
                          %mn 4
