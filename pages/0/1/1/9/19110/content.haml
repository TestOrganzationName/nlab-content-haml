                          %mi ConjCl
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %mo ⟩
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [1]
                  \\subset
                  \\left[
                  \\left\langle
                  g_1
                  \\right\rangle
                  \\right]
                  \\subset
                  \\left[
                  \\left\langle
                  g_2
                  \\right\rangle
                  \\right]
                  \\subset
                  \\cdots
                  \\subset
                  \\left[
                  \\left\langle
                  g_{\vert ConjCl(G)\vert}
                  \\right\rangle
                  \\right]
                  \\,.
          %p
            This way every
            %a.existingWikiWord{:href => "/nlab/show/virtual+representation"} virtual representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
