                          %mo ⋅
                          %mn 8
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:stretchy => "false"} /
                          %mn 120
                      %mtr
                        %mtd
                        %mtd
                          %mo =
