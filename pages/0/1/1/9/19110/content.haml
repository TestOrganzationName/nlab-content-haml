          %p
            Specifically D5 brane models
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-dual
            to D6/D8 models:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"}> Angel Uranga
                ,
                = succeed "," do
                  %em
                    A New Orientifold of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℂ
                            %mn 2
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi ℤ
                            %mi N
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}^2/\mathbb{Z}_N
                    and Six-dimensional RG Fixed Points
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9910155"} arXiv:hep-th/9910155
            %li#FengHeKarchUranga01
              %p
                Bo Feng,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andreas+Karch"} Andreas Karch
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"} Angel Uranga
                = succeed "," do
                  %em Orientifold dual for stuck NS5 branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0103177"} arXiv:hep-th/0103177
          %p
            Specifically for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
          %ul
            %li#IshiharaKataokaSato99
              %p
                S. Ishihara, H. Kataoka, Hikaru Sato,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} D=4
                    ,
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                            %mo =
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} N=1
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9908017"} arXiv:hep-th/9908017
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mirjam+Cvetic"}> Mirjam Cvetic
                , Paul Langacker, Tianjun Li, Tao Liu,
                = succeed "," do
                  %em D6-brane Splitting on Type IIA Orientifolds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0407178"} arXiv:hep-th/0407178
          %p
            Specifically for
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/D3-branes"} D3-branes
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D7-branes"} D7-branes
          %ul
            %li
              %a{:href => "#FengHeKarchUranga01"} Feng-He-Karch-Uranga 01
          %p Various:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"}> Dieter Lüst
              , S. Reffert, E. Scheidegger, S. Stieberger,
