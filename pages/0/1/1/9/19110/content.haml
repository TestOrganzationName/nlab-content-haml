                        %mtd
                          %mo =
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  M_{2I}
                  \&amp; =
                  dim(V) / {\vert 2I \vert }
                  \\\
                  \&amp; =
                  \\chi_V([\langle e\rangle]) / {\vert 2I \vert }
                  \\\
                  \&amp; =
                  \\big(
                  1 \cdot 1
                  +
                  4 \cdot 4
                  +
                  5 \cdot 5
                  +
                  3 \cdot 6
                  +
                  3 \cdot 12
                  +
                  2 \cdot 8
                  +
                  1 \cdot 8
                  \\big) / 120
                  \\\
                  \&amp;
                  \=
                  120 / 120
                  \\\
                  \&amp; = 1
                  \\end{aligned}
