                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s: A \to K(2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
