          #sub.num_cor
            %h6#corollary Corollary
            %p
              Every canonical cofibration is an
              = succeed "-cofibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          .proof
            %h6#proof_2 Proof
            %p
              By the Galois connection induced by the lifting relation, Proposition
              %a.maruku-ref{:href => "#canonical"}
              implies that canonical cofibrations form a subset of
              = succeed "-cofibrations," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              = succeed "-cofibrations." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              = succeed "-fibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          %p
            At this point, we would like to show conversely that every
            = succeed "-cofibration" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{M}
            = succeed "-fibration," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{M}
            = succeed "-cofibration" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{M}
          %p
            For a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(S)
            be the category whose objects are the elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \to y
            for any
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x, y \in S
