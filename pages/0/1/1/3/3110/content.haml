                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          .proof
            %h6#proof_3 Proof
            %p
              First we observe that for any category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
