                  %path{:d => "M -2.485459 2.867614 C -2.03083 1.146945 -1.021606 0.334701 -0.00198909 -0.0000893275 C -1.021107 -0.334964 -2.033135 -1.147096 -2.487704 -2.869197 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.89863,0.436815,0.436815,0.89863,189.724814,129.36423)"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "235.824011", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph3-3", :y => "116.462957"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "240.546528", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph6-2", :y => "117.706973"}
                  %path{:d => "M 0.00230609 -51.372934 L 0.00230609 -92.542164 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-dasharray:3.34735,1.91277;stroke-miterlimit:10;", :transform => "matrix(0.99921,0,0,-0.99921,162.400039,116.316073)"}
                  %path{:d => "M -2.485544 2.870838 C -2.031914 1.146822 -1.01931 0.333745 0.00107357 0.0015262 C -1.019257 -0.334765 -2.03173 -1.148005 -2.485085 -2.868184 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.0000799368,0.99919,0.99919,0.0000799368,162.400819,209.022365)"}
                  %path{:d => "M 177.933594 180.261719 L 146.871094 180.261719 L 146.871094 196.648438 L 177.933594 196.648438 Z M 177.933594 180.261719 ", :style => " stroke:none;fill-rule:nonzero;fill:rgb(100%,100%,100%);fill-opacity:1;"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "150.086771", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph3-1", :y => "192.394946"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "159.424391", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph7-1", :y => "190.667561"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "158.24907", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph1-3", :y => "192.394946"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "166.476318", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph3-2", :y => "192.394946"}
            %p
              First we need to show that the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo ×
                      %mo ^
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \widehat{\times} G
              is a cofibration if both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              are. By the definition of cofibrations, this means to show that on objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mover
                      %mo ×
                      %mo ^
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (F \widehat{\times} G)_0
              is an injective map if both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} G_0
              are injective maps.
            %p
              Now, observe (see
              = succeed ")" do
                %a{:href => "Cat#OrdinaryLimitsAndColimits"} here
              = succeed "-object" do
                %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Cat
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (-)_0
                    \\,\colon\,
                    Cat \to Set
            %p
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              both
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and hence in particular preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pushout+products"} pushout products
              = succeed "." do
                %a{:href => "pushout-product#InjectionsOfSets"} this example
            %p
              Second, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is in addition a weak equivalence, we need to show that then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo ×
                      %mo ^
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \widehat{\times} G
              is a weak equivalence.
            %p
              But with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              certainly also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ×
                    %mi{:mathvariant => "normal"} Id
                  %annotation{:encoding => "application/x-tex"} F \times \mathrm{Id}
              is an injective-on-objects equivalence of categories, hence an
              %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
              in the canonical model structure. By the model category properties, it follows that also the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} q_r
              (in the above diagram) is an acyclic cofibration, hence in particular a weak equivalence; and by
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              applied to the bottom right triangle in the above diagram it follows that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ×
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} F \times Id
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} q_r
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo ×
                      %mo ^
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \widehat{\times} G
              is a weak equivalence.
          %h3#uniqueness_of_the_model_structure Uniqueness of the model structure
          %p
            Remarkably:
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
          %p
          #Uniqueness.num_prop
            %h6 Proposition
            %p
              The model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi can
                  %annotation{:encoding => "application/x-tex"} Cat_{can}
              (from Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExistenceOfTheCanonicalModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
              whose
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              are the usual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
          %p This result justifies the term “canonical”.
          %p
            The following
            %strong proof
            is adapted (with minor changes) from
            = succeed "." do
              %a{:href => "#Schommer-Pries12"} Schommer-Pries 2012
            = succeed "," do
              %a{:href => "http://mathoverflow.net/questions/18744/is-model-structure-on-catset-unique"} thread
            %a{:href => "http://mathoverflow.net/a/46471/2926"} answer
            given by
            %a.existingWikiWord{:href => "/nlab/show/Steve+Lack"} Steve Lack
            (with a pertinent comment by
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"} Denis-Charles Cisinski
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi M
                %annotation{:encoding => "application/x-tex"} \mathbf{M}
            denote any model structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            whose weak equivalences are categorical equivalences. We will prove that
            = succeed "-fibrations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{M}
            = succeed "-cofibrations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{M}
          .num_lemma
            %h6#lemma Lemma
            %p
              The terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is
              = succeed "-cofibrant," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \to 1
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
              is an
              = succeed "-cofibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be any noninitial category; by a standard result of model category theory, there is an
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi C
                        %mo{:stretchy => "false"} ˜
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \tilde{C} \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} 0 \to \tilde{C}
              is a cofibration. This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{C}
              is noninitial and therefore has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              as a retract; thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          #canonical.num_prop
            %h6#proposition Proposition
            %p
              Each acyclic
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          .proof
            %p
              Each acyclic
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f: E \to X
              has the right lifting property with respect to
              = succeed "-cofibrations." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              = succeed "-cofibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \to 1
              is exactly the condition of being surjective on objects. Thus acyclic
              = succeed "-fibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
          %p
            Before giving the next result, we recall that the lifting relation on morphisms gives a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} c: A \to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} f: c \to d
            are functors, and define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ⊥
                  %mi f
                %annotation{:encoding => "application/x-tex"} c \perp f
            if for every morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in the arrow category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cat
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} Cat^\mathbf{2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi C
                      %mtr
                        %mtd
                          %msub
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi c
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msub
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp; \to &amp; C \\
                  _\mathllap{c} \downarrow &amp; &amp; \downarrow_\mathrlap{f} \\
                  B &amp; \to &amp; D
                  }
          %p
            of functors, there is a lifting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} B \to C
            filling in to make two commutative triangles. As any relation does, this lifting relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \perp
            gives a Galois connection on subclasses of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo{:stretchy => "false"} )
