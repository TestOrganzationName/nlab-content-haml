                    %use{:x => "80.636659", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph3-3", :y => "116.462957"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "85.359177", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph6-1", :y => "118.21782"}
                  %path{:d => "M 124.862627 28.479188 L 12.340174 -92.667263 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.99921,0,0,-0.99921,162.400039,116.316073)"}
                  %path{:d => "M -2.488378 2.8682 C -2.031821 1.147322 -1.021657 0.335487 0.000515996 -0.00099186 C -1.018702 -0.334063 -2.033557 -1.148627 -2.484329 -2.869218 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.679993,0.732101,0.732101,0.679993,174.567483,209.086234)"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "234.297217", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph3-1", :y => "158.98535"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "242.459517", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph1-3", :y => "158.98535"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "250.686764", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph4-1", :y => "158.98535"}
                    %use{:x => "254.495455", "xlink:href" => "#l3gH8omSTv6l2dxLIljUXqmHnOA=-glyph4-2", :y => "158.98535"}
