                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mo ↪
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    s L_\infty Alg \hookrightarrow dgAlg^{op}
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              on those that are CE-algebras as above.
            %p
              Finally, the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              of a super
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              algebra of
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              is its
              %em
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ algebra cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
