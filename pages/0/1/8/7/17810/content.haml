                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        x \otimes (y \otimes 1) &amp; &amp;
                        \\\
                        {}^\mathllap{\alpha^{-1}_{1, x, y}} \downarrow
                        \&amp; \searrow^\mathrlap{id_x \otimes r_y} &amp;
