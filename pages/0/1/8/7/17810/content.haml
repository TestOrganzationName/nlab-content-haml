                          %mtd
                            %msub
                              %mi A
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    1_{\mathcal{c}} &amp;\overset{e_1}{\longrightarrow}&amp; A_1
                    \\\
                    \&amp; {}_{\mathllap{e_2}}\searrow &amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \&amp;&amp; A_2
                    }
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mon(\mathcal{C}, \otimes,1)
              for the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of monoids
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{C}, \otimes, 1)
              for its subcategory of commutative monoids.
          #MonoidsInVectAreAssociativeAlgebras.num_example
            %h6#example_11 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              according to def.
              %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              from example
              %a.maruku-ref{:href => "#TensorProductOfVectorSpaces"}
              is equivalently an ordinary
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over the given
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Vect
              is an ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of monoids agree with usual algebra homomorphisms. Hence there are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    Mon(Vect_k) \simeq Alg_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi CAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CMon(Vect_k) \simeq CAlg_k
                    \\,.
          #GradedAlgebras.num_example
            %h6#example_12 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              according to def.
              %a.maruku-ref{:href => "#MonoidsInVectAreAssociativeAlgebras"}
              in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Alg
                      %mi k
                      %mi G
                    %mo ≃
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Vect
                      %mi k
                      %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Alg_k^G \simeq Mon(Vect_k^G)
                    \\,.
            %p
              This means that a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %ol
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %munder
                          %mo ⊕
                          %mrow
                            %mi g
                            %mo ∈
                            %mi G
                        %msub
                          %mi A
                          %mi g
                      %annotation{:encoding => "application/x-tex"} A = \underset{g\in G}{\oplus} A_g
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                  structure on the underlying vector space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %p
              such that for two elements of homogeneous degree, i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ∈
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_1 \in A_{g_1} \hookrightarrow A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 2
                    %mo ∈
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi g
                          %mn 2
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_2 \in A_{g_2} \hookrightarrow A
              then their product is in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_1 g_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi g
                          %mn 2
                    %mo ∈
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                        %msub
                          %mi g
                          %mn 2
                    %mo ↪
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a_{g_1} a_{g_2} \in A_{g_1 g_2} \hookrightarrow A
                    \\,.
          %p
            Example
            %a.maruku-ref{:href => "#MonoidsInVectAreAssociativeAlgebras"}
            motivates the following definition:
          #SupercommutativeSuperalgebra.num_defn
            %h6#definition_19 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"}> supercommutative superalgebra
                )
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
              %a.existingWikiWord{:href => "/nlab/show/category+of+super+vector+spaces"} category of super vector spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} sCAlg_k
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              with the induced
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              between them:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sCAlg
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sCAlg_k \;\coloneqq\; CMon(sVect_k)
                    \\,.
            %p
              Unwinding what this means, then a
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
            %ol
              %li
                %p
                  a
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  = succeed ";" do
                    %a.maruku-ref{:href => "#GradedAlgebras"}
              %li
                %p
                  such that for any two elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a, b
                  of homogeneous degree, their product satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi b
                        %mi a
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        a b \; = \; (-1)^{deg(a) deg(b)}\, b a
                        \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              In view of def.
              %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              we might define a not-necessarily supercommutative superalgebra to be a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              (not necessarily commutative) in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sVect"} sVect
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sAlg
                      %mi k
                    %mo ≔
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sAlg_k \coloneqq Mon(sVect)
                    \\,.
            %p
              However, since the definition of not-necessarily commutative monoids (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              of the ambient
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              differ from
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              only via their
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              = succeed ":" do
                %a.maruku-ref{:href => "#GradedAlgebras"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sAlg
                      %mi k
                    %mo ≃
                    %msubsup
                      %mi Alg
                      %mi k
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sAlg_k \simeq Alg_k^{\mathbb{Z}/2}
                    \\,.
            %p
              Hence the heart of
              %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
              is
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} super-commutativity
          #GrassmannAlgebra.num_example
            %h6#example_13 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              which is
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} freely generated
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi θ
                      %mi i
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{\theta_i\}_{i = 1}^n
              in odd degree is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mo •
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T^\bullet \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \theta_i
              in odd degree, by the ideal generated by the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi i
                    %msub
                      %mi θ
                      %mi j
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi θ
                      %mi j
                    %msub
                      %mi θ
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\theta_i \theta_j = - \theta_j \theta_i
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i,j \in \{1, \cdots, n\}
            %p
              This is also called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              = succeed ")," do
                %a{:href => "#Grassmann1844"} Grassmann 1844
              %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              a century ahead of his time.
            %p We also denote this algebra by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi sCAlg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet_{\mathbb{R}}(\mathbb{R}^n)
                    \\;\in\;
                    sCAlg_{\mathbb{R}}
                    \\,.
          %p
            The following is an elementary but fundamental fact about the relation between commutative algebra and supercommutative superalgebra. It is implicit in much of the literature, but maybe the only place where it has been made explicit before is (
            %a{:href => "#CarchediRoytenberg12"}> Carchedi-Roytenberg 12, example 3.18
            ).
          #InclusionOfCAlgIntosCAlg.num_prop
            %h6#proposition_9 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi CAlg
                              %mi k
                          %mtd
                            %mo ↪
                          %mtd
                            %msub
                              %mi sCAlg
                              %mi k
                        %mtr
                          %mtd
                            %mo =
                          %mtd
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                            %mi CMon
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Vect
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi CMon
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi sVect
                              %mi k
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CAlg_k &amp;\hookrightarrow&amp; sCAlg_k
                    \\\
                    \= &amp;&amp; =
                    \\\
                    CMon(Vect_k) &amp;\hookrightarrow&amp; CMon(sVect_k)
                    }
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInVectAreAssociativeAlgebras"}
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              %a.maruku-ref{:href => "#MonoidsPreservedByLaxMonoidalFunctor"}
              from the full inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi k
                    %mo ↪
                    %msub
                      %mi sVect
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    i \;\colon\; Vect_k \hookrightarrow sVect_k
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InclusionOfVectorSpacesIntoSupervectorSpaces"}
            %p
              This inclusion functor has both a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              and a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              , (an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              exibiting a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              and
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              inclusion, an “
              %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"}> adjoint cylinder
              ”):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CAlg
                      %mi k
                    %munderover
                      %mo ↪
                      %munder
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi even
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi odd
                    %msub
                      %mi sCAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CAlg_k
                    \\underoverset
                    {\underset{(-)_{even}}{\longleftarrow}}
                    {\overset{(-)/(-)_{odd}}{\longleftarrow}}
                    {\hookrightarrow}
                    sCAlg_k
                    \\,.
            %p Here
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi even
                      %annotation{:encoding => "application/x-tex"} (-)_{even}
                  sends a supercommutative superalgebra to its even part
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ↦
                          %msub
                            %mi A
                            %mi even
                        %annotation{:encoding => "application/x-tex"} A \mapsto A_{even}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} (-)/(-)_{odd}
                  sends a supercommutative superalgebra to the
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                  by the ideal which is generated by its odd part
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↦
                        %mi A
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi odd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \mapsto A/(A_{odd})
                  (hence it sets all elements to zero which may be written as a product such that at least one factor is odd-graded).
          .proof
            %h6#proof_4 Proof
            %p
              The full inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is evident. To see the
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              observe their characteristic
              %a.existingWikiWord{:href => "/nlab/show/natural+bijections"} natural bijections
              between
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi ordinary
                  %annotation{:encoding => "application/x-tex"} A_{ordinary}
              is an ordinary commutative algebra regarded as a superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi ordinary
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(A_{ordinary})
              concentrated in even degree, and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is any superalgebra,
            %ol
              %li
                %p
                  then every super-algebra homomorphism of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi ordinary
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A_{ordinary} \to B
                  must factor through
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi B
                            %mi even
                        %annotation{:encoding => "application/x-tex"} B_{even}
                  = succeed "-grading." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi sCAlg
                              %mi k
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi ordinary
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi CAlg
                              %mi k
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi ordinary
                        %mo ,
                        %msub
                          %mi B
                          %mi even
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{sCAlg_k}(i(A_{ordinary}), B) \simeq Hom_{CAlg_k}(A_{ordinary},B_{even})
                        \\,,
              %li
                %p
                  every super-algebra homomorphism of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo →
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi ordinary
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B \to i(A_{ordinary})
                  must send every odd element of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  to 0, again because homomorphisms have to respect the
                  = succeed "-grading," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} B_{odd}
                  must be sent to zero, hence the homomorphism must factor through the
                  %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %mo →
                          %mi B
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi B
                            %mi odd
                        %annotation{:encoding => "application/x-tex"} B \to B/B_{odd}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi sCAlg
                              %mi k
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi ordinary
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi Alg
                              %mi k
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi B
                          %mi odd
                        %mo ,
                        %msub
                          %mi A
                          %mi ordinary
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{sCAlg_k}(B, i(A_{ordinary}))
                        \\simeq
                        Hom_{Alg_k}(B/B_{odd}, A_{ordinary})
                        \\,.
          %h3#example_super_lie_algebras_and_super_algebras
            Example: Super Lie algebras and Super
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            As an example of the general principle of
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalizing
            ordinary
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            in
            %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            in order to obtain the analogous concept in
