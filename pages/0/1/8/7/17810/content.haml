                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathfrak{g}, \mathbb{R})
                    \\;=\;
                    H^\bullet(CE(\mathfrak{g}))
                    \\,.
          #SuperLInfintiyAsFDA.num_remark
            %h6#remark_6 Remark
            %p
              In their
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              incarnations as super-graded commutative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SuperLInfinityCEAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              had secretly been introduced within the
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature already in
              %a{:href => "#DAuriaFreRegge80"} D’Auria-Fré-Regge 80
              and explicitly in
              %a{:href => "#Nieuwenhuizen82"} van Nieuwenhuizen 82
              and hence a whole decade before mathematicans considered even plain (non-super)
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              (in
              = succeed ")." do
                %a{:href => "L-infinity-algebra#LadaStasheff92"} Lada-Stasheff 92
            %p
              The concept was picked up in the
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9+formulation+of+supergravity"} D'Auria-Fré formulation of supergravity
              (
              %a{:href => "#DAuriaFre82"}> D’Auria-Fré 82
              ) and eventually came to be referred to as “FDA”s (short for “free differential algebra”) in the
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature, where in
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              one says “
              %a.existingWikiWord{:href => "/nlab/show/semifree+dga"}> semifree dga
              ” or “quasifree dga”, since these dg-algebras are crucially not required to be
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              as
              %em differential
              algebras). (If they are, then they are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebras"} Weil algebras
            %p
              The relation between super
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature is made explicit in (
              %a{:href => "#FSS13"}> FSS 13
              ).
          %h3#ZGradedSupercommutativeSuperAlgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            \-Graded Supercommutative superalgebra
          %p
            It may happen that the
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
            %a.existingWikiWord{:href => "/nlab/show/lift"} lifts
            to a finer grading with respect to some
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} A \to \mathbb{Z}/2
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mover
                      %mo ⟶
                      %mrow
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \stackrel{mod\,2}{\longrightarrow}\mathbb{Z}/2
            = succeed "-graded-commutative" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "-graded-commutative" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
          %p
            This relation is particularly interesting since there is a natural source of
            = succeed "-graded-commutative" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            (called
            = succeed "-s)" do
              %a.existingWikiWord{:href => "/nlab/show/dgca"} dgca
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            (called
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectra"} homotopy commutative ring spectra
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            which are
            = succeed "-graded-commutative" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          #SuperZGradedVectorSpaces.num_defn
            %h6#definition_27 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mi ℤ
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( Vect^{\mathbb{Z}}, \otimes_k, \tau^{super} )
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              is that of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \coloneqq (\mathbb{Z}, +)
              the additive group of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braiding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi τ
                      %mi super
