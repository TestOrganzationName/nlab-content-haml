                  which sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ∈
                        %mi CRing
                      %annotation{:encoding => "application/x-tex"} R \in CRing
                  to the groupoid of fiber functors to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
