                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p
            This appears for instance as (
            %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"}> Johnstone, page 478, cor. 1.1.9
            ).
          #AssumptionsOnCoproductInCMonGenericallySatisfied.num_remark
            %h6#remark_8 Remark
            %p
              In every
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %a.maruku-ref{:href => "#CoproductsInCMon"}
              are satisfied.
          .proof
            %h6#proof_12 Proof
            %p
              By definition, every
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              is an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdditiveAndAbelianCategories"}
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of two
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f,g
              in an abelian category is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the difference
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f-g
              (formed in the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              struture on the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/hom-space"} hom-space
              %a.existingWikiWord{:href => "/nlab/show/split+coequalizers"} split coequalizers
              required in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CoproductsInCMon"}
            %p
              Moreover, by definition every
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
              = succeed "," do
                %a.maruku-ref{:href => "#CompactClosedMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \otimes (-)
              are
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functors, and such preserve all colimits.
          #ProductsInAff.num_prop
            %h6#proposition_20 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \in CMon(\mathcal{A})
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1, A_2
              two
              = succeed "-algebas" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %a.maruku-ref{:href => "#AAlgebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_1), Spec(A_2) \in Aff(R Mod(\mathcal{C}))
              according to prop.
              %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
              and def.
              %a.maruku-ref{:href => "#Affines"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_1)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_2)
              exists in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aff(R Mod(\mathcal{C}))
              and is the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of the tensor product algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi R
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 \otimes_R A_2
              according to example
              = succeed ":" do
                %a.maruku-ref{:href => "#TensorProductOfTwoCommutativeMonoids"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi R
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spec(A_1) \times Spec(A_2) \simeq Spec(A_1 \otimes_R A_2)
                    \\,.
          .proof
            %h6#proof_13 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of the statement is given by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CoproductsInCMon"}
              = succeed "." do
                %a.maruku-ref{:href => "#AssumptionsOnCoproductInCMonGenericallySatisfied"}
          #ExtensionOfScalars.num_defn
            %h6#proposition_21 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in CMon(\mathcal{C})
              be two
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; A_1 \longrightarrow A_2
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            %p
              Then there is a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              between the
              %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟵
                        %mrow
                          %msup
                            %mi ϕ
                            %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ϕ
                            %mo *
                    %msub
                      %mi A
                      %mn 2
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_1 Mod(\mathcal{C})
                    \\underoverset
                    {\underset{\phi^\ast}{\longleftarrow}}
                    {\overset{\phi_\ast}{\longrightarrow}}
                    {}
                    A_2 Mod(\mathcal{C})
            %p where
            %ol
              %li
                %p
                  the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/restriction+of+scalars"} restriction of scalars
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} A_2
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (N, \rho)
                  to the
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} A_1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo ,
                        %mi ρ
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (N,\rho')
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  is given by precomposition with
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \phi
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                        %mo ⊗
                        %mi N
                        %mover
                          %mo ⟶
                          %mrow
                            %mi ϕ
                            %mo ⊗
                            %mi id
                        %msub
                          %mi A
                          %mn 2
                        %mo ⊗
                        %mi N
                        %mover
                          %mo ⟶
                          %mi ρ
                        %mi N
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        A_1 \otimes N
                        \\stackrel{\phi \otimes id}{\longrightarrow}
                        A_2 \otimes N
                        \\stackrel{\rho}{\longrightarrow}
                        N
                        \\,.
              %li
                %p
                  the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
                  sends an
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} A_1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (N,\rho)
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi A
                          %mn 2
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi A
                              %mn 1
                        %mi N
                      %annotation{:encoding => "application/x-tex"}
                        \\phi_\ast(N) \coloneqq A_2 \otimes_{A_1} N
                %p
                  (where we are regarding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} A_2
                  as a commutative monoid in
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} A_1
                  = succeed ")" do
                    %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  induced by the multiplication in
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} A_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                    %mo ⊗
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mn 2
                    %mo ⊗
                    %msub
                      %mi A
                      %mn 2
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %mi N
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi μ
                          %mrow
                            %msub
                              %mi A
                              %mn 2
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi A
                              %mn 1
                        %mi N
                    %msub
                      %mi A
                      %mn 2
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %mi N
                    %mo =
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_2 \otimes \phi^\ast(N)
                    \=
                    A_2 \otimes A_2 \otimes_{A_1} N
                    \\stackrel{\mu_{A_2} \otimes_{A_1} N }{\longrightarrow}
                    A_2 \otimes_{A_1} N
                    \=
                    \\phi^\ast(N)
                    \\,.
          .proof
            %h6#proof_14 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              in question has the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟵
                        %mi U
                      %mover
                        %mo ⟶
                        %mi F
                    %msub
                      %mi A
                      %mn 2
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_1 Mod(\mathcal{C})
                    \\underoverset
                    {\underset{U}{\longleftarrow}}
                    {\overset{F}{\longrightarrow}}
                    {}
                    A_2 Mod( (A_1 Mod, \otimes_{A_1}, A_1) )
            %p
              and hence the statement follows with prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidModuleOverItself"}
          .num_remark
            %h6#remark_9 Remark
            %p
              In the dual interpretation of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              as generalized
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              (namely:
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(R)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Affines"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi \colon A_1 \to A_2
              becomes a map of spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spec(\phi)
                    \\colon
                    Spec(A_2)
                    \\longrightarrow
                    Spec(A_1)
            %p
              and then
              %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
              according to prop.
              %a.maruku-ref{:href => "#ExtensionOfScalars"}
              corresponds to the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of vector bundles from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_1)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(A_2)
          %h2#GroupsAsHopfAlgebras Super-Groups as super-commutative Hopf algebras
          %p
            Above we have considered affine spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(A)
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Affines"}
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            A (possibly) familiar example arises in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            and all whose operations (product, inverses) are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi G
                  %mo ×
                  %mi V
                  %mo ⟶
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\colon\; G \times V \longrightarrow V
          %p such that
          %ol
            %li
              %p
                (
                %a.existingWikiWord{:href => "/nlab/show/linear+map"}> linearity
                ) for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
                the function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi V
                      %mo ⟶
                      %mi V
                    %annotation{:encoding => "application/x-tex"}
                      \\rho(g) \colon V \longrightarrow V
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            %li
              %p
                (
                %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                ) for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} e \in G
                the
                %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(e)
                is the
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                function;
            %li
              %p
                (
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                property) for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g_1, g_2 \in G
                any two elements, then acting with them consecutively is the same as acting with their product:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\rho(g_2) \circ  \rho(g_1) = \rho(g_2 g_1)
                      \\,.
          %p
            But here we need to consider groups with more general geometric structure. The key to the generalization is to regard
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            dually via their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
          %p
            In the above example, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi SmthMfd
                  %mo ↪
                  %msubsup
                    %mi SmthAlg
                    %mi ℝ
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(-) \;\colon\; SmthMfd \hookrightarrow SmthAlg_{\mathbb{R}}^{op}
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"} embedding of smooth manifolds into formal duals of R-algebras
            from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#EmbeddingOfSmoothManifoldsIntoRAlgebras"}
          %p
            Moreover, the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(-)
            sends
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            of smooth manifolds to “completed tensor products”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ⊗
                    %mi c
                %annotation{:encoding => "application/x-tex"} \otimes^c
            of function algebras (namely to the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo ⊗
                    %mi c
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X \times Y) \simeq C^\infty(X) \otimes^c C^\infty(Y)
                  \\,.
          %p
            Together this means that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = G
            is equipped with the structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi product
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi G
                          %mo ×
                          %mi G
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo ⊗
                            %mi c
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟵
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %msup
                            %mi product
                            %mo *
                          %mo =
                          %mi coproduct
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  product &amp;\colon&amp; G \times G &amp;\longrightarrow&amp; G
                  \\\
                  \&amp;&amp; C^\infty(G) \otimes^c C^\infty(G) &amp;\longleftarrow&amp; C^\infty(G) &amp;\colon&amp; product^\ast = coproduct
                  }
                  \\,.
          %p
            Now the
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            of the group product translates into a corresponding dual property of its dual, called “
            %a.existingWikiWord{:href => "/nlab/show/co-associativity"}> co-associativity
            ”, and so forth. The resulting algebraic structure is called a
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
          %p
            While the explicit definition of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            may look involved at first sight, Hopf algebras are simply
            %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
          %p A simple illustrative archetype of the following construction of commutative Hopf algebroids from homotopy commutative ring spectra is the following situation:
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            consider
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∘
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi pr
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi pr
                                  %mn 3
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi s
                                %mo =
                                %msub
                                  %mi pr
                                  %mn 1
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↑
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi t
                                %mo =
                                %msub
                                  %mi pr
                                  %mn 2
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \times X \times X
                  \\\
                  \\downarrow^{\mathrlap{\circ = (pr_1, pr_3)}}
                  \\\
                  X \times X
                  \\\
                  {}^{\mathllap{s = pr_1}}\downarrow
                  \\uparrow
                  \\downarrow^{\mathrlap{t = pr_2}}
                  \\\
                  X
                  }
          %p
            as the (“
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"}> codiscrete
            ”)
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and precisely one morphism from every object to every other. Hence the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            and
            %a.existingWikiWord{:href => "/nlab/show/target"} target
            maps are simply projections as shown. The identity morphism (going upwards in the above diagram) is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
          %p
            Then consider the image of this structure under forming the
            %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            under pointwise multiplication.
          %p Since
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}[X \times X]
                  \\simeq
                  \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
          %p this yields a diagram of homomorphisms of commutative rings of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ⊗
                            %mrow
                              %mi ℤ
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (\mathbb{Z}[X] \otimes \mathbb{Z}[X] )
                  \\otimes_{\mathbb{Z}[X]}
                  (\mathbb{Z}[X] \otimes \mathbb{Z}[X])
                  \\\
                  \\uparrow^{\mathrlap{} }
                  \\\
                  \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
                  \\\
                  \\uparrow
                  \\downarrow
                  \\uparrow
                  \\\
                  \\mathbb{Z}[X]
                  }
          %p satisfying some obvious conditions. Observe that here
          %ol
            %li
              %p
                the two morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⇉
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X] \rightrightarrows \mathbb{Z}[X] \otimes \mathbb{Z}[X]
                are
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo ⊗
                      %mi e
                    %annotation{:encoding => "application/x-tex"} f \mapsto f \otimes e
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ↦
                        %mi e
                        %mo ⊗
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f \mapsto e \otimes f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
                denotes the unit element in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %li
              %p
                the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X] \otimes \mathbb{Z}[X] \to \mathbb{Z}[X]
                is the multiplication in the ring
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %li
              %p the morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
                      \\longrightarrow
                      \\mathbb{Z}[X] \otimes \mathbb{Z}[C] \otimes \mathbb{Z}[C]
                      \\overset{\simeq}{\longrightarrow}
                      (\mathbb{Z}[X] \otimes \mathbb{Z}[X] ) \otimes_{\mathbb{Z}[X]} (\mathbb{Z}[X] \otimes \mathbb{Z}[X])
              %p
                is given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ⊗
                        %mi g
                        %mo ↦
                        %mi f
                        %mo ⊗
                        %mi e
                        %mo ⊗
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \otimes g \mapsto f \otimes e \otimes g
          %p We now say this again, in generality:
          #CommutativeHopfAlgebroid.num_defn
            %h6#definition_34 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TensorCategory"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is an
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              in the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})^{op}
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              structure according to prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ProductsInAff"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "commutative+Hopf+algebroid#Ravenel86"} Ravenel 86, def. A1.1.1
          %p
            We unwind def.
            = succeed "." do
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \in CMon(\mathcal{A})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(R)
            for same same object, but regarded as an object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})^{op}
          #CommutativeHopfAlgebroidSpelledOut.num_prop
            %h6#proposition_22 Proposition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})^{op}
              is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})^{op}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi Spec
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∘
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi s
                            %mo{:stretchy => "false"} ↓
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi i
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi t
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Spec(\Gamma) \underset{Spec(A)}{\times} Spec(\Gamma)
                    \\\
                    \\downarrow^{\mathrlap{\circ}}
                    \\\
                    Spec(\Gamma)
                    \\\
                    {}^{\mathllap{s}}\downarrow \; \uparrow^{\mathrlap{i}} \downarrow^{\mathrlap{t}}
                    \\\
                    Spec(A)
                    }
                    \\,,
            %p
              (where the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              at the top is over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              on the left and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              on the right) such that the pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
              defines an
              %a.existingWikiWord{:href => "/nlab/show/associativity+law"} associative
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(A)
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              if it is furthemore equipped with a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    inv \;\colon\; Spec(\Gamma) \longrightarrow Spec(\Gamma)
            %p
              acting as assigning
              %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                    %annotation{:encoding => "application/x-tex"} \circ
            %p
              The key fact to use now is prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#ProductsInAff"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of commutative monoids exhibits the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CMon
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})^{op}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mn 3
                        %mo{:stretchy => "false"} )
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi R
                          %mn 3
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spec(R_1) \underset{Spec(R_3)}{\times} Spec(R_2)
                    \\simeq
                    Spec(R_1 \otimes_{R_3} R_2)
                    \\,.
            %p
              This means that def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              is equivalently a diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CMon(\mathcal{A})
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                            %munder
                              %mo ⊗
                              %mi A
                            %mi Γ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi Ψ
                        %mtr
                          %mtd
                            %mi Γ
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi L
                            %mo{:stretchy => "false"} ↑
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϵ
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi R
                        %mtr
                          %mtd
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma \underset{A}{\otimes} \Gamma
                    \\\
                    \\uparrow^{\mathrlap{\Psi}}
                    \\\
                    \\Gamma
                    \\\
                    {}^{\mathllap{\eta_L}}\uparrow
                    \\downarrow^{\mathrlap{\epsilon}} \;
                    \\uparrow^{\mathrlap{\eta_R}}
                    \\\
                    A
                    }
            %p as well as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    c \; \colon \; \Gamma \longrightarrow \Gamma
            %p
              and satisfying
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
              conditions, spelled out as def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              below. Here
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi L
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} etaR
                      %annotation{:encoding => "application/x-tex"} \eta_L, \etaR
                  are called the left and right
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                      maps
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  is called the
                  = succeed ";" do
                    %em co-unit
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ψ
                      %annotation{:encoding => "application/x-tex"} \Psi
                  is called the
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/antipode"} antipode
                  or
                  %em conjugation
          #HopfAlgebrasAsHopfAlgebroids.num_remark
            %h6#remark_10 Remark
            %p
              Generally, in a commutative Hopf algebroid, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                    %mo ,
                    %msub
                      %mi η
                      %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R\colon A \to \Gamma
              from remark
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
              need not coincide, they make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              genuinely into a
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              that appears in remark
              = succeed "." do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %munder
                        %mo ⟶
                        %mi t
                      %mover
                        %mo ⟶
                        %mi s
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{\overset{s}{\longrightarrow}}{\underset{t}{\longrightarrow}} \mathcal{G}_0
              for which the
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              and
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              morphisms coincide,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"} s = t
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
            %p
              Dually, a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mover
                      %munder
                        %mo ⟵
                        %mrow
                          %msub
                            %mi η
                            %mi R
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi η
                            %mi L
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \stackrel{\overset{\eta_L}{\longleftarrow}}{\underset{\eta_R}{\longleftarrow}} A
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \eta_L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \eta_R
              happen to coincide is equivalently a
              %strong
                commutative
                %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            Writing out the formally dual axioms of an
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
            as in remark
            %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
            yields the following equivalent but maybe more explicit definition of commutative Hopf algebroids, def.
            %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
          #CommutativeHopfAlgebroidDefinitionInExplicitComponents.num_defn
            %h6#definition_35 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              is
            %ol
              %li
                %p
                  two
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  ring
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                %ol
                  %li
                    %p (left/right unit)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi η
                              %mi L
                            %mo ,
                            %msub
                              %mi η
                              %mi R
                            %mo{:lspace => "verythinmathspace"} :
                            %mi A
                            %mo ⟶
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \eta_L,\eta_R \colon A \longrightarrow \Gamma
                      ;
                  %li
                    %p (comultiplication)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi Ψ
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi Γ
                            %munder
                              %mo ⊗
                              %mi A
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Psi \colon \Gamma \longrightarrow \Gamma \underset{A}{\otimes} \Gamma
                      ;
                  %li
                    %p (counit)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi ϵ
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi A
                          %annotation{:encoding => "application/x-tex"} \epsilon \colon \Gamma \longrightarrow A
                      ;
                  %li
                    %p (conjugation)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} c \colon \Gamma \longrightarrow \Gamma
            %p such that
            %ol
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                  )
                %ol
                  %li
                    %p (identity morphisms respect source and target)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi ϵ
                            %mo ∘
                            %msub
                              %mi η
                              %mi L
                            %mo =
                            %mi ϵ
                            %mo ∘
                            %msub
                              %mi η
                              %mi R
                            %mo =
                            %msub
                              %mi id
                              %mi A
                          %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta_L = \epsilon \circ \eta_R = id_A
                      ;
                  %li
                    %p (identity morphisms are units for composition)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %msub
                              %mo ⊗
                              %mi A
                            %msub
                              %mi id
                              %mi Γ
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %msub
                              %mi id
                              %mi Γ
                          %annotation{:encoding => "application/x-tex"} (id_\Gamma \otimes_A \epsilon) \circ \Psi  = (\epsilon \otimes_A id_\Gamma) \circ \Psi = id_\Gamma
                      ;
                  %li
                    %p (composition respects source and target)
                    %ol
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                            %semantics
                              %mrow
                                %mi Ψ
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi R
                                %mo =
                                %mo{:stretchy => "false"} (
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mi A
                                %msub
                                  %mi η
                                  %mi R
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi R
                              %annotation{:encoding => "application/x-tex"} \Psi \circ \eta_R = (id \otimes_A \eta_R) \circ \eta_R
                          ;
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi Ψ
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi L
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi η
                                  %mi L
                                %msub
                                  %mo ⊗
                                  %mi A
                                %mi id
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi L
                              %annotation{:encoding => "application/x-tex"} \Psi \circ \eta_L = (\eta_L \otimes_A id) \circ \eta_L
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
                  )
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi id
                            %mi Γ
                          %msub
                            %mo ⊗
                            %mi A
                          %mi Ψ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi Ψ
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi Ψ
                          %msub
                            %mo ⊗
                            %mi A
                          %msub
                            %mi id
                            %mi Γ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi Ψ
                        %annotation{:encoding => "application/x-tex"} (id_\Gamma \otimes_A \Psi) \circ \Psi = (\Psi \otimes_A id_\Gamma) \circ \Psi
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/inverses"}> inverses
                  )
                %ol
                  %li
                    %p (inverting twice is the identity)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi c
                            %mo ∘
                            %mi c
                            %mo =
                            %msub
                              %mi id
                              %mi Γ
                          %annotation{:encoding => "application/x-tex"} c \circ c = id_\Gamma
                      ;
                  %li
                    %p (inversion swaps source and target)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi c
                            %mo ∘
                            %msub
                              %mi η
                              %mi L
                            %mo =
                            %msub
                              %mi η
                              %mi R
                          %annotation{:encoding => "application/x-tex"} c \circ \eta_L = \eta_R
                      ;
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi c
                              %mo ∘
                              %msub
                                %mi η
                                %mi R
                              %mo =
                              %msub
                                %mi η
                                %mi L
                            %annotation{:encoding => "application/x-tex"} c \circ \eta_R = \eta_L
                  %li
                    %p (inverse morphisms are indeed left and right inverses for composition)
                    %p
                      the morphisms
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                          %annotation{:encoding => "application/x-tex"} \alpha
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi β
                          %annotation{:encoding => "application/x-tex"} \beta
                      induced via the
                      %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                      property of the
                      %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                      from
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi c
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (-) \cdot c(-)
                      and
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi c
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} c(-)\cdot (-)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi Γ
                                    %mo ⊗
                                    %mi A
                                    %mo ⊗
                                    %mi Γ
                                  %mtd
                                    %munderover
                                      %mrow
                                      %mo ⟶
                                      %mo ⟶
                                  %mtd
                                    %mi Γ
                                    %mo ⊗
                                    %mi Γ
                                  %mtd
                                    %mover
                                      %mo ⟶
                                      %mi coeq
                                  %mtd
                                    %mi Γ
                                    %msub
                                      %mo ⊗
                                      %mi A
                                    %mi Γ
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %msub
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mrow
                                          %mo{:stretchy => "false"} (
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mo{:stretchy => "false"} )
                                          %mo ⋅
                                          %mi c
                                          %mo{:stretchy => "false"} (
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} ↓
                                  %mtd
                                    %msub
                                      %mo ↙
                                      %mpadded{:width => "0"}
                                        %mi α
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mi Γ
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            \\Gamma \otimes A \otimes \Gamma
                            \&amp;
                            \\underoverset
                            {\longrightarrow}
                            {\longrightarrow}
                            {}
                            \&amp;
                            \\Gamma \otimes \Gamma
                            \&amp;
                            \\overset{coeq}{\longrightarrow}
                            \&amp;
                            \\Gamma \otimes_A \Gamma
                            \\\
                            \&amp;&amp;
                            {}_{\mathllap{(-)\cdot c(-)}}\downarrow
                            \&amp;
                            \\swarrow_{\mathrlap{\alpha}}
                            \\\
                            \&amp;&amp; \Gamma
                            }
                    %p and
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi Γ
                                    %mo ⊗
                                    %mi A
                                    %mo ⊗
                                    %mi Γ
                                  %mtd
                                    %munderover
                                      %mrow
                                      %mo ⟶
                                      %mo ⟶
                                  %mtd
                                    %mi Γ
                                    %mo ⊗
                                    %mi Γ
                                  %mtd
                                    %mover
                                      %mo ⟶
                                      %mi coeq
                                  %mtd
                                    %mi Γ
                                    %msub
                                      %mo ⊗
                                      %mi A
                                    %mi Γ
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %msub
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mrow
                                          %mi c
                                          %mo{:stretchy => "false"} (
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mo{:stretchy => "false"} )
                                          %mo ⋅
                                          %mo{:stretchy => "false"} (
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} ↓
                                  %mtd
                                    %msub
                                      %mo ↙
                                      %mpadded{:width => "0"}
                                        %mi β
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mi Γ
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            \\Gamma \otimes A \otimes \Gamma
                            \&amp;
                            \\underoverset
                            {\longrightarrow}
                            {\longrightarrow}
                            {}
                            \&amp;
                            \\Gamma \otimes \Gamma
                            \&amp;
                            \\overset{coeq}{\longrightarrow}
                            \&amp;
                            \\Gamma \otimes_A \Gamma
                            \\\
                            \&amp;&amp;
                            {}_{\mathllap{c(-)\cdot (-)}}\downarrow
                            \&amp;
                            \\swarrow_{\mathrlap{\beta}}
                            \\\
                            \&amp;&amp; \Gamma
                            }
                    %p satisfy
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %msub
                              %mi η
                              %mi L
                            %mo ∘
                            %mi ϵ
                          %annotation{:encoding => "application/x-tex"} \alpha \circ \Psi = \eta_L \circ \epsilon
                    %p and
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi β
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %msub
                              %mi η
                              %mi R
                            %mo ∘
                            %mi ϵ
                          %annotation{:encoding => "application/x-tex"} \beta \circ \Psi = \eta_R \circ \epsilon
                      \.
          %p
            e.g. (
            %a{:href => "commutative+Hopf+algebroid#Ravenel86"}> Ravenel 86, def. A1.1.1
            )
          %p
            By internalizing all of the above from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Vect
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sVect
                  %annotation{:encoding => "application/x-tex"} sVect
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supergroups"} supergroups
          #Supergroup.num_defn
            %h6#definition_36 Definition
            %p
              An affine algebraic
              %em
                %a.existingWikiWord{:href => "/nlab/show/supergroup"} supergroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is equivalently
            %ul
              %li
                %p
                  a pointed, one-object
                  %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Aff
                        %mo{:stretchy => "false"} (
                        %mi sVect
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi CMon
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi sVect
                          %mi k
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"} Aff(sVect) = CMon(sVect_k)^{op}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Affines"}
                  %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
                  from def.
                  %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
                  of a
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/super-commutative+Hopf+algebra"} super-commutative Hopf algebra
                  %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebra"} commutative Hopf algebra
                  (prop.
                  = succeed "," do
                    %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
                  = succeed ")." do
                    %a.maruku-ref{:href => "#HopfAlgebrasAsHopfAlgebroids"}
          %p
            We will often just say “supergroup” for short in the following. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the corresponding
            %a.existingWikiWord{:href => "/nlab/show/supercommutative+Hopf+algebra"} supercommutative Hopf algebra
            then we also write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(H)
            for this supergroup.
          %p
            The following asks that the parity involution (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ParityAutomorphism"}
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inner+automorphism"} inner automorphism
          #InnerParity.num_defn
            %h6#definition_37 Definition
            %p
              An
              %strong inner parity
              of a
              %a.existingWikiWord{:href => "/nlab/show/supergroup"} supergroup
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.maruku-ref{:href => "#Supergroup"}
              is an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi G
                      %mi even
                  %annotation{:encoding => "application/x-tex"} \epsilon \in G_{even}
              such that
            %ol
              %li
                %p
                  it is
                  %a.existingWikiWord{:href => "/nlab/show/involution"} involutive
                  i.e.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϵ
                          %mn 2
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \epsilon^2 = 1
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is the parity involution of def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#ParityAutomorphism"}
            %p
              Dually this mean that an inner pariy is an algebra homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \epsilon^\ast \colon\mathcal{O}(G) \to k
              such that
            %ol
              %li
                %p the composite
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mi Ψ
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi ϵ
                              %mo *
                            %msub
                              %mo ⊗
                              %mi k
                            %msup
                              %mi ϵ
                              %mo *
                        %mi k
                        %msub
                          %mo ⊗
                          %mi k
                        %mi k
                        %mo ≃
                        %mi k
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{O}(G) \stackrel{\Psi}{\longrightarrow} \mathcal{O}(G) \otimes_k \mathcal{O}(G) \stackrel{\epsilon^\ast \otimes_k \epsilon^\ast}{\longrightarrow} k \otimes_k k \simeq k
                %p is the counit of the Hopf algebra (hence the formal dual of the neutral element)
              %li
                %p
                  the parity involution
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}(G) \stackrel{\simeq}{\longrightarrow} \mathcal{O}(G)
                  conincides with the composite
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi id
                            %msub
                              %mo ⊗
                              %mi k
                            %mi Ψ
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi Ψ
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi ϵ
                              %mo *
                            %msub
                              %mo ⊗
                              %mi k
                            %mi id
                            %msub
                              %mo ⊗
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ∘
                            %msup
                              %mi ϵ
                              %mo *
                            %mo{:stretchy => "false"} )
                        %mi k
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi k
                        %mi k
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{O}(G)
                        \\stackrel{(id \otimes_k \Psi) \circ \Psi}{\longrightarrow}
                        \\mathcal{O}(G) \otimes_k \mathcal{O}(G) \otimes_k \mathcal{O}(G)
                        \\stackrel{\epsilon^\ast \otimes_k id \otimes_k (c \circ \epsilon^\ast)}{\longrightarrow}
                        k \otimes_k \mathcal{O}(G) \otimes_k k
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, 0.3
            )
          #InnerParityInBosonicSupergroup.num_example
            %h6#example_27 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              an ordinary affine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon \in Z(G)
              in the
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              defines an inner parity, def.
              = succeed "." do
                %a.maruku-ref{:href => "#InnerParity"}
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, 0.4 i)
            )
          .num_remark
            %h6#remark_11 Remark
            %p
              In view of remak
              = succeed "," do
                %a.maruku-ref{:href => "#InnerParityInBosonicSupergroup"}
              = succeed ")." do
                %a{:href => "#Mueger06"} Müger 06
          %p Demanding the existence of inner parity is not actually a restriction of the theory:
          .num_example
            %h6#example_28 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              any supergroup, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Supergroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi id
                    %mo ,
                    %mi par
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 = \{id,par\}
              acting on it by parity involution, def.
              %a.maruku-ref{:href => "#ParityAutomorphism"}
              then the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ⋉
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \ltimes G
              has inner parity, def.
              = succeed "," do
                %a.maruku-ref{:href => "#InnerParity"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ≔
                      %mi par
                      %mo ∈
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ↪
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ⋉
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \epsilon \coloneqq par \in \mathbb{Z}_2 \hookrightarrow \mathbb{Z}_2 \ltimes G
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, 0.4 ii)
            )
          %h2#LinearRepresentationsAsComodules Linear super-representations as Comodules
          #CommutativeHopfAlgebroidComodule.num_defn
            %h6#definition_38 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TensorCategory"}
              %strong
                left
                %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is
            %ol
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  (co-action)
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Ψ
                          %mi N
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mo ⟶
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi N
                      %annotation{:encoding => "application/x-tex"} \Psi_N \;\colon\; N \longrightarrow \Gamma \otimes_A N
                  ;
            %p such that
            %ol
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                  )
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi id
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                        %mo =
                        %msub
                          %mi id
                          %mi N
                      %annotation{:encoding => "application/x-tex"} (\epsilon \otimes_A id_N) \circ \Psi_N = id_N
                  ;
              %li
                %p (co-action property)
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ψ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi id
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi Ψ
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                      %annotation{:encoding => "application/x-tex"} (\Psi \otimes_A id_N) \circ \Psi_N = (id_\Gamma \otimes_A \Psi_N)\circ \Psi_N
                  \.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between comodules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1 \to N_2
              is a homomorphism of underlying
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              with the co-action morphism. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma CoMod(\mathcal{A})
            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of (left) comodules over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
          #ComoduleStructureOnGroundRing.num_example
            %h6#example_29 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              becomes a left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi R
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \overset{\eta_R}{\longrightarrow} \Gamma \simeq \Gamma \otimes_A A
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p
              The required co-unitality property is the dual condition in def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∘
                    %msub
                      %mi η
                      %mi R
                    %mo =
                    %msub
                      %mi id
                      %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \circ \eta_R  = id_A
            %p
              of the fact in def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              that identity morphisms respect sources:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi R
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %mi ϵ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi id
                    %mi A
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    id
                    \\;\colon\;
                    A
                    \\overset{\eta_R}{\longrightarrow}
                    \\Gamma
                    \\simeq
                    \\Gamma \otimes_A A
                    \\overset{\epsilon \otimes_A id}{\longrightarrow}
                    A \otimes_A A
                    \\simeq
                    A
            %p The required co-action property is the dual condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo ∘
                    %msub
                      %mi η
                      %mi R
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi id
                    %msub
                      %mo ⊗
                      %mi A
                    %msub
                      %mi η
                      %mi R
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi R
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi \circ \eta_R = (id \otimes_A \eta_R) \circ \eta_R
            %p
              of the fact in def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              that composition of morphisms in a groupoid respects sources
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi R
                          %mtd
                            %mi Γ
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi R
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
