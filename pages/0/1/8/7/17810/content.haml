                  \\,.
          #RepresentableAutomorphismGroup.num_defn
            %h6#definition_43 Definition
            %p We say that a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo =
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"}
                    \\underline{Aut}(\omega)
                    \\;\colon\;
                    Aff(sVect)^{op}
                    \=
                    CMon(sVect)
                    \\longrightarrow
                    Grp
            %p
              is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+Hopf+algebra"} supercommutative Hopf algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
