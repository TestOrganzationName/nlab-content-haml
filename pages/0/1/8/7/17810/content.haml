                              %mi 𝒞
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; 1_{\mathcal{D}}
                    \\\
                    \&amp; {}^{\mathllap{\epsilon_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{\epsilon_2}}
                    \\\
                    F_1(1_{\mathcal{C}})
                    \&amp;&amp;\underset{f(1_{\mathcal{C}})}{\longrightarrow}&amp;&amp;
                    F_2(1_{\mathcal{C}})
                    }
                    \\,.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MonFun
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} MonFun(\mathcal{C},\mathcal{D})
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of lax monoidal functors between monoidal categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              = succeed "," do
