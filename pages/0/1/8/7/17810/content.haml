                  Grp
          %p
            such that the underlying points are those of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(\omega)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi Aut
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
