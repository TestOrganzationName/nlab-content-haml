                  %mo{:stretchy => "false"} (
                  %mi sVect
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Grp
                %annotation{:encoding => "application/x-tex"}
                  \\underline{Aut}(\omega)
                  \\;\colon\;
                  Aff(sVect)^{op} \simeq CMon(sVect)
