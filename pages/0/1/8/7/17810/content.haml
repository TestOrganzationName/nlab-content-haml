              %li
                %p
                  (not needed here) a general
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Tannakian+category"} Tannakian category
                  if the
                  %a.existingWikiWord{:href => "/nlab/show/stack"} stack
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Aff
                          %mi k
