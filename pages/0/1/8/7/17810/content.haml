              which is that of the underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
