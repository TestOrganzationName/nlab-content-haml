                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo ,
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
