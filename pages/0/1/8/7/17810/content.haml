                      %mi μ
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
