          #SchurFunctorAnnihilatingFiniteDimensionalSuperVectorSpace.num_prop
            %h6#proposition_27 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} V = V_{even} \oplus V_{odd}
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              of degreewise finite dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi even
                      %mo ,
                      %msub
                        %mi d
                        %mi odd
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d_{even}, d_{odd} \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} S_\lambda
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchurFunctor"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_\lambda(V) \simeq 0
                    \\,.
            %p
              Specifically, this is the case precisely if the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Young+tableau"} Young tableau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\lambda]
              satifies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mo ≤
                      %msub
                        %mi d
                        %mi even
                      %mo ,
                      %mi j
                      %mo ≤
                      %msub
                        %mi d
                        %mi odd
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\lambda] \subset \left\{ (i,j)\;\vert\; i \leq d_{even}, j \leq d_{odd} \right\}
                    \\,.
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, corollary 1.9
            )
          %h2#_tannaka_duality_between_tensor_categories_and_supergroups Tannaka duality between tensor categories and supergroups
          %p Above we saw that
          %ol
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} super fiber functor
                gives rise to an affine supergroup (prop.
                = succeed ");" do
                  %a.maruku-ref{:href => "#AutomorphismSupergroupOfFiberFunctorIsRepresentable"}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/category+of+representations"} category of representations
                of an affine
                %a.existingWikiWord{:href => "/nlab/show/supergroup"} supergroup
                is a tensor category, prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#RegularTensorCategoriesOfSuperrepresentations"}
          %p
            Indeed, the relation between tensor categories and supergroups is intimate. The following states that under mild size constraints,
            %em every
            tensor category is the category of representations of
            %em some
            affine algebraic supergroup. This shows that the concept of
            %a.existingWikiWord{:href => "/nlab/show/supergroups"} supergroups
            is fundamental and not accidental.
          #TheTheorem.num_theorem
