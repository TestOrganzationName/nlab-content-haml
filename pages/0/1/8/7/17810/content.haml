                  %mo ⟶
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A_1 \longrightarrow A_2
            is an algebra homomorphism, hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spec(A_2) \longrightarrow Spec(A_1)
          %p
            a map of affine super schemes according to def.
            = succeed "," do
              %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi Aut
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟵
                  %munder
                    %mi Aut
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\underline{Aut}(\omega)(Spec(A_2))
                  \\longleftarrow
                  \\underline{Aut}(\omega)(Spec(A_1))
          %p
            that expresses how a
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(\omega)
            becomes a
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A_1)
          %p
            For a minimum of consistency, this assignment must be such that the identity map on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
