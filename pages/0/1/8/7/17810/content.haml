                    %mo ,
                    %msub
                      %mo ⊗
                      %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A Mod, \otimes_A, A)
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              itself, regarded as an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidModuleOverItself"}
            %p
              If moreover all
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
              exist, then this is a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              given by the function modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hom
                      %mi A
                  %annotation{:encoding => "application/x-tex"} hom_A
              of def.
              = succeed "." do
                %a.maruku-ref{:href => "#TensorProductOfModulesOverCommutativeMonoidObject"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#HoveyShipleySmith00"} Hovey-Shipley-Smith 00, lemma 2.2.2, lemma 2.2.8
          .proof
            %h6#proof_sketch Proof sketch
            %p
              The associators and braiding for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \otimes_{A}
              are induced directly from those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              and the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coequalizers"} coequalizers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the tensor unit for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \otimes_{A}
              follows with the same kind of argument that we give in the proof of example
              %a.maruku-ref{:href => "#FreeModulesTensorProduct"}
              below.
          #FreeModulesTensorProduct.num_example
            %h6#example_26 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu,e)
              a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes, 1)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorProductOfModulesOverCommutativeMonoidObject"}
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidModuleOverItself"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A\otimes C_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A \otimes C_2
              always exists and is the free module over the tensor product in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the two generators:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (A \otimes C_1) \otimes_A (A \otimes C_2)
                    \\simeq
                    A \otimes (C_1 \otimes C_2)
                    \\,.
            %p
              Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              has all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coequalizers"} coequalizers
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A Mod, \otimes_A, A)
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidModuleOverItself"}
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\;\colon\;
                    (\mathcal{C}, \otimes, 1)
                    \\longrightarrow
                    (A Mod, \otimes_A, A)
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p It is sufficient to show that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %munderover
                      %mphantom
                        %mi AAAA
                      %munder
                        %mo ⟶
                        %mrow
                          %mi id
                          %mo ⊗
                          %mi μ
                      %mover
                        %mo ⟶
                        %mrow
                          %mi μ
                          %mo ⊗
                          %mi id
                    %mi A
                    %mo ⊗
                    %mi A
                    %mover
                      %mo ⟶
                      %mi μ
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \otimes A \otimes A
                    \\underoverset
                    {\underset{id \otimes \mu}{\longrightarrow}}
                    {\overset{\mu \otimes id}{\longrightarrow}}
                    {\phantom{AAAA}}
                    A \otimes A
                    \\overset{\mu}{\longrightarrow}
                    A
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              diagram (we are notationally suppressing the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/associators"} associators
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ⊗
                        %mi A
                      %mi A
                      %mo ≃
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \otimes_A A \simeq A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} C_1 = 1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} C_2 = 1
            %p
              To that end, we check the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            %p
              First observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              indeed coequalizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo ⊗
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} id \otimes \mu
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo ⊗
                      %mi id
                    %annotation{:encoding => "application/x-tex"} \mu \otimes id
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              clause in def.
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⟶
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f \colon A \otimes A \longrightarrow Q
              any other morphism with this property, we need to show that there is a unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \phi \colon A \longrightarrow Q
              which makes this
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi μ
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A &amp;\overset{\mu}{\longrightarrow}&amp; A
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp; \swarrow_{\mathrlap{\phi}}
                    \\\
                    Q
                    }
                    \\,.
            %p We claim that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msup
                          %mi r
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mi A
                    %mo ⊗
                    %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ⊗
                        %mi e
                    %mi A
                    %mo ⊗
                    %mi A
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    A
                    \\underoverset{\simeq}{r^{-1}}{\longrightarrow}
                    A \otimes 1
                    \\overset{id \otimes e}{\longrightarrow}
                    A \otimes A
                    \\overset{f}{\longrightarrow}
                    Q
                    \\,,
            %p
              where the first morphism is the inverse of the right
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              First to see that this does make the required triangle commute, consider the following pasting composite of
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi μ
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %msup
                                    %mi r
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi r
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi μ
                                %mo ⊗
                                %mi id
                          %mtd
                            %mi A
                            %mo ⊗
                            %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mi e
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mi e
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi μ
                                %mo ⊗
                                %mi id
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mi μ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A &amp;\overset{\mu}{\longrightarrow}&amp; A
                    \\\
                    {}^{\mathllap{id \otimes r^{-1}}}_{\mathllap{\simeq}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{r^{-1}}}_{\simeq}
                    \\\
                    A \otimes A \otimes 1
                    \&amp;\overset{\mu \otimes id}{\longrightarrow}&amp;
                    A \otimes 1
                    \\\
                    {}^{\mathllap{id \otimes e}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{id \otimes e} }
                    \\\
                    A \otimes A \otimes A
                    \&amp;\overset{\mu \otimes id}{\longrightarrow}&amp;
                    A \otimes A
