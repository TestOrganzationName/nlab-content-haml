                      %annotation{:encoding => "application/x-tex"} \ell
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                  denote the left and right
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A^\ast
              is the right
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A^\ast
              and the structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as a right dual of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              is equipped with the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            %p
              If in a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              every object has a left and right dual, then it is called a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
          #FiniteDimensionalVectorSpaces.num_example
            %h6#example_6 Example
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinDimVect
                      %mi k
                    %mo ↪
                    %msub
                      %mi Vect
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    FinDimVect_k \hookrightarrow Vect_k
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %a.existingWikiWord{:href => "/nlab/show/FinDimVect"} FinDimVect
              of that of all
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              (over the given
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
            %p
              Clearly the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorProductOfVectorSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              structure from example
              %a.maruku-ref{:href => "#VectAsAMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi FinDimVect
                      %mi k
                    %mo ,
                    %mo ⊗
                    %mo =
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mn 1
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (FinDimVect_k, \otimes = \otimes_k, 1 = k )
                    \\hookrightarrow
                    (Vect_k, \otimes_k, k)
                    \\,.
            %p
              This is a a
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DualizableObject"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo *
                    %mo ≔
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V^\ast \coloneqq hom(V,k)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              in the abstract sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#DualizableObject"}
            %p
              Here the evaluation map is literally the defining
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              map of linear duals (whence the name of the abstract concept)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mi V
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi V
                      %mo *
                    %msub
                      %mo ⊗
                      %mi k
                    %mi V
                    %mo ≃
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi k
                    %mi k
                    %mover
                      %mo ⟶
                      %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"}
                    ev_{V} \;\colon\;  V^\ast \otimes_k V \simeq hom(V,k) \otimes_k k \overset{}{\longrightarrow} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mover
                      %mo →
                      %mi ϕ
                    %mi k
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ev
                    \\;\colon\;
                    (V \stackrel{\phi}{\to} k, v)
                    \\;\;\mapsto \;\;
                    \\phi(v)
                    \\,.
            %p The co-evaluation map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi V
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo ⟶
                    %mi V
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    i_V
                    \\;\colon\;
                    k \longrightarrow V \otimes V^\ast
            %p
              is the linear map that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 1 \in k
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi V
                    %mo ∈
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi V
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} id_V \in End(V) \simeq V \otimes_k V^\ast
              under the canonical identification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V \otimes_k V^\ast
              with the linear space of
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              If we choose a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e_i\}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              and a corresponding dual bases
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e^i\}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mo *
                    %annotation{:encoding => "application/x-tex"} V^\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi i
                    %mo ,
                    %msub
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi δ
                      %mi j
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    ev \;\colon\; (e^i, e_j) \mapsto e^i(e_j) =  \delta^i_j
            %p
              (with the
              %a.existingWikiWord{:href => "/nlab/show/Kronecker+delta"} Kronecker delta
              on the right) and the co-evaluation map is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %mo ,
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    1 \mapsto \underset{i}{\sum} (e_i,  e^i)
                    \\,.
            %p
              In this perspective the
              %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              are the statements that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mi j
                    %mo =
                    %msup
                      %mi e
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{j}{\sum} e^i(e_j) e^j = e^i
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi e
                      %mi j
                    %msup
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi e
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{j}{\sum} e_j e^j(e_i) = e_i
                    \\,.
            %p
              Physicists will recognize this as just the basic rules for
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              calculus in index-notation.
          #FiniteDimensionalSuperVectorSpaces.num_example
            %h6#example_7 Example
            %p Similarly, the full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sFinDimVect
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (sFinDimVect, \otimes_k, k, \tau^{super})
                    \\hookrightarrow
                    (sVect, \otimes_k, k, \tau^{super})
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            %p
              Here we say that a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              has
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    (p\vert q)
                    \\in \mathbb{N} \times \mathbb{N}
            %p
              if its even part has dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and its odd part has dimension
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi even
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi odd
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi q
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim(V) = (p\vert q)
                    \\;\;\;
                    \\Leftrightarrow
                    \\;\;\;
                    \\left( dim(V_{even}) = p \;\;\;\;\text{and}\;\;\;\; dim(V_{odd}) = q \right)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              of such a finite dimensional super vector space is just the linear
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#FiniteDimensionalVectorSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi V
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi even
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi odd
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V = V_{even} \oplus V_{odd}
                    \\;\;\;\; \Rightarrow
                    \\;\;\;\;
                    V^\ast = (V_{even}^\ast) \oplus (V_{odd}^\ast)
                    \\,.
          #CompactClosedMonoidalCategory.num_prop
            %h6#proposition_5 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid
              (def. \refDualizableObject)
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              between two objects given by the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of the
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              object with the
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              of the domain object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msup
                      %mi A
                      %mo *
                    %mo ⊗
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [A,B] \simeq A^* \otimes B
                    \\,.
            %p
              (The closed monoidal categories arising this way are called
              = succeed ")." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/compact+closed+categories"} compact closed categories
          .proof
            %h6#proof_3 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              that characterizes the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [A,-]
              as being
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \otimes (-)
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              natural isomorphism that characterizes
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msup
                      %mi A
                      %mo *
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊗
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(C,[A,B])
                    \\simeq
                    \\mathcal{C}(C, A^\ast \otimes B)
                    \\simeq
                    \\mathcal{C}(C \otimes A, B)
                    \\,.
          %p
            There are many
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            whose “
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"}> tensor product
            ” operation is quite unlike the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            %em
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
            for monoidal categories that are also
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/linear+categories"} linear categories
            and such that the tensor product functor suitably reflects that linear structure. There are slight variants of what people mean by a “
            %a.existingWikiWord{:href => "/nlab/show/tensor+category"}> tensor category
            ”. Here we mean precisely the following:
          #TensorCategory.num_defn
            %h6#definition_12 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is an
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/essentially+small+category"} essentially small
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/linear+category"} k-linear
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LinearCategory"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DualizableObject"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidalCategory"}
            %p such that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒜
                        %mo ×
                        %mi 𝒜
                        %mo ⟶
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \otimes \colon \mathcal{A} \times \mathcal{A} \longrightarrow \mathcal{A}
                  is in both arguments separately
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi k
                          %annotation{:encoding => "application/x-tex"} k
                      \-linear (def.
                      = succeed ");" do
                        %a.maruku-ref{:href => "#LinearCategory"}
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/exact+functor"}> exact
                      \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi End
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi k
                      %annotation{:encoding => "application/x-tex"} End(1) \simeq k
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  coincides with
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
          %p
            In this form this is considered in (
            %a{:href => "#Deligne02"}> Deligne 02, 0.1
            ).
          %p
            We consider now various types of size constraints on tensor categories. The Tannaka reconstruction theorem (theorem
            %a.maruku-ref{:href => "#TheTheorem"}
            below) only assumes one of them (subexponential growth, def.
            = succeed ")," do
              %a.maruku-ref{:href => "#SubexponentialGrowth"}
          %ol
            %li
              %p
                finiteness (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FiniteTensorCategory"}
            %li
              %p
                finite
                = succeed "-generation" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
                = succeed ")" do
                  %a.maruku-ref{:href => "#FiniteTensorGeneration"}
            %li
              %p
                subexponential growth (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SubexponentialGrowth"}
          %p
            Recall the concept of
            %a.existingWikiWord{:href => "/nlab/show/length+of+an+object"} length of an object
            in an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
          #FiniteLength.num_defn
            %h6#definition_13 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Jordan-H%C3%B6lder+sequence"} Jordan-Hölder sequence
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/composition+series"} composition series
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              unclusions into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/zero+objects"} zero objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mi n
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    0 = X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X_{n-1} \hookrightarrow X_n = X
            %p
              such that at each stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_i/X_{i-1}
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/coimage"} coimage
              of the
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi i
                          %mo −
                          %mn 1
                      %mo ↪
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} X_{i-1} \hookrightarrow X_i
              %a.existingWikiWord{:href => "/nlab/show/simple+object"} simple object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              If a Jordan-Hölder sequence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              exists at all, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is said to be of
              = succeed "." do
                %em finite length
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, def. 1.5.3
          #JordanHolderSequenceHasDefiniteLength.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Jordan-H%C3%B6lder+theorem"}> Jordan-Hölder theorem
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              has finite length according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiniteLength"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              have the same length
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, theorem 1.5.4
          #LengthOfAnObject.num_defn
            %h6#definition_14 Definition
            %p
              If an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              has finite length according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiniteLength"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              of any of its Jordan-Hölder sequences, which is uniquely defined according to prop.
              = succeed "," do
                %a.maruku-ref{:href => "#JordanHolderSequenceHasDefiniteLength"}
              %em length of the object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, def. 1.5.5
          #FiniteTensorCategory.num_defn
            %h6#definition_15 Definition
            %p
              A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %strong finite
              (over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %ol
              %li
                %p
                  There are only
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finitely many
                  %a.existingWikiWord{:href => "/nlab/show/simple+objects"} simple objects
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  (hence it is a
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+abelian+category"} finite abelian category
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/projective+presentation"} projective presentation
              %li
                %p
                  Each object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/object+of+finite+length"} finite length
              %li
                %p
                  For any two
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                  %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"}> vector space
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hom(a, b)
                  has
                  %a.existingWikiWord{:href => "/nlab/show/finite"} finite
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
          .num_example
            %h6#example_8 Example
            %p
              The category of
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a finite tensor category according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#FiniteTensorCategory"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simple+objects"} simple objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              itself.
            %p
              Also category of finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              is a finite tensor category. This has two isomorphism classes of simple objects,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} k = k^{1 \vert 0}
              regarded in even degree, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{0\vert 1}
              regarded in odd degree.
          %p
            The following finiteness condition is useful in the proof of the main theorem, but not necessary for its statement (according to
            = succeed "):" do
              %a{:href => "#Deligne02"} Deligne 02, bottom of p. 3
          #FiniteTensorGeneration.num_defn
            %h6#definition_16 Definition
            %p
              A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %em
                finitely
                = succeed "-generated" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
              if there exists an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} E \in \mathcal{A}
              such that every other object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              is a
              %a.existingWikiWord{:href => "/nlab/show/subquotient"} subquotient
              of a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/tensor+products"} tensor products
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %msup
                            %mo ⊗
                            %mi n
                    %annotation{:encoding => "application/x-tex"} E^{\otimes^n}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo ⊕
                              %mi i
                            %msup
                              %mi E
                              %mrow
                                %msup
                                  %mo ⊗
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ↪
                          %mtd
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo ⊕
                              %mi i
                            %msup
                              %mi E
                              %mrow
                                %msup
                                  %mo ⊗
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \underset{i}{\oplus} E^{\otimes^{n_i}}
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    X &amp;\hookrightarrow&amp; (\underset{i}{\oplus} E^{\otimes^{n_i}})/Q
                    }
                    \\,.
            %p
              Such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is called an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                \-generator
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
            (
            %a{:href => "#Deligne02"}> Deligne 02, 0.1
            )
          %p
            The following is the main size constraint needed in the theorem. Notice that it is a “mild” constraint at least in the intuitive sense that it states just a minimum assumption on the expected behaviour of dimension (
            %a.existingWikiWord{:href => "/nlab/show/length+of+an+object"}> length
            ) under tensor powers.
          #SubexponentialGrowth.num_defn
            %h6#definition_17 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              = succeed "*" do
                %strong subexponential growth
              %a.existingWikiWord{:href => "/nlab/show/length"} length
              of tensor exponentials is no larger than the exponential of the length: for every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi X
                  %annotation{:encoding => "application/x-tex"} N_X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is of
              %a.existingWikiWord{:href => "/nlab/show/length+of+an+object"} length
              at most
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi X
                    %annotation{:encoding => "application/x-tex"} N_X
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are of length bounded by the corresponding powers of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi X
                    %annotation{:encoding => "application/x-tex"} N_X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo ∃
                      %mrow
                        %msub
                          %mi N
                          %mi X
                        %mo ∈
                        %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo ∀
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi length
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mo ⊗
                          %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X \in \mathcal{A}}{\forall}
                    \\,
                    \\underset{N_X \in \mathbb{N}}{\exists}
                    \\,
                    \\underset{n \in \mathbb{N}}{\forall}
                    \\;\;
                    length(X^{\otimes^n}) \leq (N_X)^n
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EGNO15"} EGNO 15, def. 9.11.1
          %p The evident example is the following:
          .num_example
            %h6#example_9 Example
            %p
              The tensor category
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/FinDimVect"} FinDimVect
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              from example
              %a.maruku-ref{:href => "#FiniteDimensionalVectorSpaces"}
              has subexponential growth (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SubexponentialGrowth"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi X
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_X = dim(X)
              the
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              of a vector space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mrow
                      %mo (
                      %msup
                        %mi X
                        %mrow
                          %msup
                            %mo ⊗
                            %mi n
                      %mo )
                    %mo =
                    %msup
                      %mrow
                        %mo (
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim\left( X^{\otimes^n} \right) = \left(dim(X)\right)^n
                    \\,.
          %p
            While many linear monoidal categories of interest do not satisfy finiteness or
            %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigidity
            (def.
            = succeed ")," do
              %a.maruku-ref{:href => "#DualizableObject"}
            %a.existingWikiWord{:href => "/nlab/show/inductive+limits"} inductive limits
            over “small” objects that do form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
          #IndObjectsInATensorCategory.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              a
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TensorCategory"}
            %ol
              %li
                %p
                  all
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/object+of+finite+length"} objects have finite length
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/hom+spaces"} hom spaces
                  are of
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %p
              then for its
              %a.existingWikiWord{:href => "/nlab/show/category+of+ind-objects"} category of ind-objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ind(\mathcal{A})
              the following holds
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ind(\mathcal{A})
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                        %mo ↪
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{A} \hookrightarrow Ind(\mathcal{A})
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %ol
                  %li
                    %p
                      which stable under forming
                      %a.existingWikiWord{:href => "/nlab/show/subquotients"} subquotients
                  %li
                    %p
                      such that that every
                      %a.existingWikiWord{:href => "/nlab/show/object"} object
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ∈
                            %mi Ind
                            %mo{:stretchy => "false"} (
                            %mi 𝒜
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} X \in Ind(\mathcal{A})
                      is the
                      %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
                      of those of its
                      %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
                      that are in
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒜
                            %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Ind(\mathcal{A})
                  inherits a
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mi X
                                %mo ⊗
                                %mi Y
                              %mtd
                                %mo ≃
                                %mo{:stretchy => "false"} (
                                %msub
                                  %munder
                                    %mi lim
                                    %mo ⟶
                                  %mi i
                                %msub
                                  %mi X
                                  %mi i
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %msub
                                  %munder
                                    %mi lim
                                    %mo ⟶
                                  %mi i
                                %msub
                                  %mi Y
                                  %mi i
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %msub
                                  %munder
                                    %mi lim
                                    %mo ⟶
                                  %mrow
                                    %mi i
                                    %mo ,
                                    %mi j
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi X
                                  %mi i
                                %mo ⊗
                                %msub
                                  %mi X
                                  %mi j
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        X \otimes Y
                        \&amp; \simeq
                        (\underset{\longrightarrow}{\lim}_i X_i)
                        \\otimes
                        (\underset{\longrightarrow}{\lim}_i Y_i)
                        \\\
                        \&amp; \simeq
                        \\underset{\longrightarrow}{\lim}_{i,j} (X_i \otimes X_j)
                        \\end{aligned}
                %p
                  where
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi i
                          %mo ,
                          %msub
                            %mi X
                            %mi j
                          %mo ∈
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} X_i,X_j \in \mathcal{A}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ind(\mathcal{A})
                  satisfies all the axioms of def.
                  %a.maruku-ref{:href => "#TensorCategory"}
                  except that it fails to be
                  %a.existingWikiWord{:href => "/nlab/show/essentially+small+category"} essentially small
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/rigid+category"} rigid category
                %ul
                  %li
                    an object in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ind
                          %mo{:stretchy => "false"} (
                          %mi 𝒜
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Ind(\mathcal{A})
                    is
                    %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable
                    precisely if it is in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒜
                          %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .num_example
            %h6#example_10 Example
            %p
              The category of all vector spaces is the category of
              %a.existingWikiWord{:href => "/nlab/show/ind-objects"} ind-objects
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#FiniteDimensionalVectorSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo ≃
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi FinDimVect
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Vect \simeq Ind(FinDimVect)
                    \\,.
            %p
              Similarly the category of all
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              (def.
              = succeed ")" do
