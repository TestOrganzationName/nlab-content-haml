            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              given on representatives elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
