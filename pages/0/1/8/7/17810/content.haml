              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} s \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ↪
                    %mi s
                    %mi 𝒜
                    %mover
                      %mo ⟶
                      %mi ω
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\hookrightarrow
                    s \mathcal{A}
                    \\overset{\omega}{\longrightarrow}
                    R Mod(sVect)
                    \\,,
            %p
              Finally check (
              %a{:href => "#Deligne02"}> Deligne 02, prop. 4.5
              ) that if a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} super fiber functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ⟶
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\longrightarrow
                    R Mod(sVect)
            %p
              then it also admits a super fiber functor over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              itself, i.e. a fiber functor to
              %a.existingWikiWord{:href => "/nlab/show/sVect"} sVect
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ⟶
                    %mi k
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi sVect
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\longrightarrow
                    k Mod(sVect)
                    \\simeq
                    sVect
                    \\,.
            %p
              This is argued by expressing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              as an
              %a.existingWikiWord{:href => "/nlab/show/inductive+limit"} inductive limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi β
                    %msub
                      %mi R
                      %mi β
                  %annotation{:encoding => "application/x-tex"}
                    R = \underset{\longrightarrow}{\lim}_\beta R_\beta
            %p
              over
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi β
                  %annotation{:encoding => "application/x-tex"} R_\beta
              of finite type over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and observing (…) that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi β
                  %annotation{:encoding => "application/x-tex"} \omega_\beta
              is still a fiber functor and such that there exists an algebra homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi β
                      %mo →
                      %mi k
                    %annotation{:encoding => "application/x-tex"} R_\beta \to k
            %p Finally then the fiber functor in question is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi β
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi R
                          %mi β
                    %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒜
                    %mo ⟶
                    %msub
                      %mi sVect
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_\beta \otimes_{R_\beta} k
                    \\;\colon\;
                    \\mathcal{A}
                    \\longrightarrow
                    sVect_k
                    \\,.
          #DeligneTannakaReconstruction.num_prop
            %h6#proposition_30 Proposition
            %p
              For every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} super fiber functor
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒜
                    %mo ⟶
                    %msub
                      %mi sVect
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\;\colon\;
                    \\mathcal{A}
                    \\longrightarrow
                    sVect_k
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\stackrel{\simeq}{\longrightarrow}
                    Rep( \underline{Aut}(\omega),\epsilon)
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+representations"} category of finite dimensional representations
              %a.maruku-ref{:href => "#Superrepresentation"}
              and prop.
              = succeed "," do
                %a.maruku-ref{:href => "#RegularTensorCategoriesOfSuperrepresentations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{Aut}(\omega)
              (example.
              = succeed "," do
                %a.maruku-ref{:href => "#AutomorphismSuperGroupOfSuperFiberFunctor"}
              = succeed ")" do
                %a.maruku-ref{:href => "#AutomorphismSupergroupOfFiberFunctorIsRepresentable"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              is te image of the unique nontrivial element in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\underline{Aut}(sVect) \simeq \mathbb{Z}/2
            %p
              (according to example
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalGroupOfCategoryOfSuperVectorSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(sVect) \longrightarrow \omega(\pi(\mathcal{A}))
                    \\simeq \underline{Aut}(\omega)
            %p
              from prop.
              %a.maruku-ref{:href => "#HomomorphismFromPiT2ToEtaPiT1"}
              and using the isomorphism from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AutOfFibFuncIsImagUnderFibFuncOfFundamentalGroup"}
          %p
            This is the main
            %a.existingWikiWord{:href => "/nlab/show/Tannaka+reconstruction"} Tannaka reconstruction
            theorem (
            %a{:href => "#Deligne90"}> Deligne 90, 8.17
            ) specialized to super fiber functors (
            %a{:href => "#Deligne90"}> Deligne 90, 8.19
            ).
          %h2#references References
          %p
            Monoidal categories were introduced independently by
            %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"} Jean Bénabou
            and
            %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
            under the name ‘categories with multiplication’. The current name is due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} Samuel Eilenberg
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                %em Catégories avec multiplication
                , C. R. Acad. Sci. Paris
                %strong 256
                (1963) pp.1887-1890. (
                %a{:href => "http://gallica.bnf.fr/ark:/12148/bpt6k3208j/f1965.image"}> gallica
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                %em Algèbre élémentaire dans les catégories avec multiplication
                , C. R. Acad. Sci. Paris
                %strong 258
                (1964) pp.771-774. (
                %a{:href => "gallica.bnf.fr/ark:/12148/bpt6k40102/f817.image"}> gallica
                )
            %li#MacLane63
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"}> Saunders Mac Lane
                ,
                %em Natural Associativity and Commutativity
                , Rice University Studies
                %strong 49
                (1963) pp.28-46.
          %p Shortly after Mac Lane’s definition appeared, Max Kelly showed how the coherence axioms could be whittled down to just two:
          %ul
            %li#Kelly64
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              %em On MacLane’s Conditions for Coherence of Natural Associativities, Commutativities, etc.
              , Journal of Algebra
              %strong 1
              (1964) pp.397-402.
          %p The first monograph:
          %ul
            %li#EilenbergKelly66
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
              = succeed "," do
                %em Closed Categories
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} S. Eilenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/D.+K.+Harrison"} D. K. Harrison
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S.+MacLane"} S. MacLane
              %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
              (eds.):
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
          %p
            A more recnt texbook account with emphasis on
            %a.existingWikiWord{:href => "/nlab/show/tensor+categories"} tensor categories
            is
          %ul
            %li#EGNO15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pavel+Etingof"}> Pavel Etingof
                , Shlomo Gelaki, Dmitri Nikshych,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Victor+Ostrik"} Victor Ostrik
                = succeed "," do
                  %em Tensor categories
              %p ))
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pavel+Etingof"}> Pavel Etingof
                , Shlomo Gelaki, Dmitri Nikshych,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Victor+Ostrik"} Victor Ostrik
                = succeed "," do
                  %em Topics in Lie theory and Tensor categories
                = succeed ")" do
                  %a{:href => "http://ocw.mit.edu/courses/mathematics/18-769-topics-in-lie-theory-tensor-categories-spring-2009/lecture-notes/"} web
          %p Commutative algebra internal to symmetric monoidal categories is discussed in
          %ul
            %li#EKMM97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Rings, modules and algebras in stable homotopy theory
            %li#HoveyShipleySmith00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"} Jeff Smith
                = succeed "," do
                  %em Symmetric spectra
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/9801077"} arXiv:math/9801077
          %p
            and specifically for
            %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroids"} commutative Hopf algebroids
            in
          %ul
            %li#Ravenel86
              %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"}> Doug Ravenel
              , chapter 2 and appendix A.1 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Complex+cobordism+and+stable+homotopy+groups+of+spheres"} Complex cobordism and stable homotopy groups of spheres
              = succeed ")" do
                %a{:href => "http://www.math.rochester.edu/people/faculty/doug/mybooks/ravenelA1.pdf"} pdf
          %p
            (These authors are motivated by the application of the general theory of algebra in monoidal categories to “
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"}> higher algebra
            ” (“
            %a.existingWikiWord{:href => "/nlab/show/brave+new+algebra"}> brave new algebra
            ”) in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
            via example
            %a.maruku-ref{:href => "#HomotopyCommutativeRingSpectrum"}
            above.)
          %p
            Free supercommutative superalgebras (
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebras"}> Grassmann algebras
            ) were first considered in
          %ul
            %li#Grassmann1844
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Grassmann"}> Hermann Grassmann
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Ausdehnungslehre"} Ausdehnungslehre
          %p Review of basic superalgebra includes
          %ul
            %li#Manin88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"}> Yuri Manin
                , chapter 3 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Gauge+Field+Theory+and+Complex+Geometry"} Gauge Field Theory and Complex Geometry
            %li#Westra09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dennis+Westra"}> Dennis Westra
                ,
                = succeed "," do
                  %em Superrings and supergroups
                = succeed ")" do
                  %a{:href => "http://www.mat.univie.ac.at/~michor/westra_diss.pdf"} pdf
          %p
            Discussion of superalgebras enhanced to
            %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
            (
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"}> synthetic differential supergeometry
            ) is in
          %ul
            %li#CarchediRoytenberg12
              %a.existingWikiWord{:href => "/nlab/show/David+Carchedi"}> David Carchedi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitry+Roytenberg"} Dmitry Roytenberg
              = succeed "," do
                %em On theories of superalgebras of differentiable functions
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1211.6134"} arxiv:1211.6134
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/28/30/28-30abs.html"} TAC
          %p
            %a.existingWikiWord{:href => "/nlab/show/Deligne%27s+theorem+on+tensor+categories"} Deligne's theorem on tensor categories
            is due to
          %ul
            %li#Deligne02
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %em Catégorie Tensorielle
              = succeed ")" do
                %a{:href => "https://www.math.ias.edu/files/deligne/Tensorielles.pdf"} pdf
          %p
            building on the general results on
            %a.existingWikiWord{:href => "/nlab/show/Tannakian+categories"} Tannakian categories
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cat%C3%A9gories+Tannakiennes"} Catégories Tannakiennes
              = succeed ")" do
                %a{:href => "https://publications.ias.edu/sites/default/files/60_categoriestanna.pdf"} pdf
          %p which are reviewed and further generalized in
          %ul
            %li#DeligneMilne12
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/James+Milne"} James Milne
              = succeed "," do
                %em Tannakian categories
              = succeed ")" do
                %a{:href => "http://www.jmilne.org/math/xnotes/tc.pdf"} pdf
          %p Surveys are in
          %ul
            %li#Ostrik04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Victor+Ostrik"}> Victor Ostrik
                ,
                %em Tensor categories (after P. Deligne)
                (
                %a{:href => "http://arxiv.org/abs/math/0401347"}> arXiv:math/0401347
                )
            %li
              %p
                %a{:href => "#EGNO15"} EGNO 15, chapter 9.11
          %p
            The special case of Tannaka duality for ordinary compact groups regarded as supergroups (hence equipped with “inner parity”, def.
            = succeed "," do
              %a.maruku-ref{:href => "#InnerParity"}
          %ul
            %li#Mueger06
              %a.existingWikiWord{:href => "/nlab/show/Michael+M%C3%BCger"}> Michael Müger
              ,
              %em
                Abstract Duality Theory for Symmetric Tensor
                = succeed "-Categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
              appendix (
              %a{:href => "http://www.math.ru.nl/~mueger/PDF/16.pdf"}> pdf
              ), in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hans+Halvorson"} Hans Halvorson
              %em Algebraic quantum field theory
              (
              %a{:href => "http://arxiv.org/abs/math-ph/0602036"}> arXiv:math-ph/0602036
              ), in J. Butterfield &amp; J. Earman (eds.)
              %em Handbook of Philosophy and Physics
          %p
            as a proof of
            %a.existingWikiWord{:href => "/nlab/show/Doplicher-Roberts+reconstruction"} Doplicher-Roberts reconstruction
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+quantum+field+theory"} algebraic quantum field theory
          %p
            In their
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            incarnations as super-graded commutative
            %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            (super
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            had secretly been introduced in
          %ul
            %li#DAuriaFreRegge80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"}> Riccardo D'Auria
                ,
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tullio+Regge"} Tullio Regge
                = succeed "," do
                  %em Graded Lie algebra, cohomology and supergravity
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/156191"} spire
            %li#Nieuwenhuizen82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+van+Nieuwenhuizen"}> Peter van Nieuwenhuizen
                ,
                = succeed "," do
                  %em Free Graded Differential Superalgebras
                = succeed "," do
                  %em Istanbul 1982, Proceedings, Group Theoretical Methods In Physics
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/182644/"} spire
          %p
            and hence a whole decade before the explicit appearance of plain (non-super)
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            in
            = succeed "." do
              %a{:href => "L-infinity-algebra#LadaStasheff92"} Lada-Stasheff 92
          %p
            The concept was picked up in the
            %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9+formulation+of+supergravity"} D'Auria-Fré formulation of supergravity
          %ul
            %li#DAuriaFre82
              %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"}> Riccardo D'Auria
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/files/GeometricSupergravity.pdf", :title => "Geometric Supergravity in D=11 and its hidden supergroup"} Geometric Supergravity in D=11 and its hidden supergroup
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/GeometricSupergravityErrata.pdf", :title => "errata"} errata
          %p
            and eventually came to be referred to as “FDA”s (short for “free differential algebra”) in the
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            literature (where in
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            one says “
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"}> semifree dga
            ”, since these dg-algebras are crucially not required to be free as
            %em differential
            algebras).
          %p
            The relation between super
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            literature is made explicit in
          %ul
            %li#FSS13
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} Super Lie n-algebra extensions, higher WZW models and super p-branes with tensor multiplet fields
              International Journal of Geometric Methods in Modern Physics Volume 12, Issue 02 (2015) 1550018, (
              %a{:href => "http://arxiv.org/abs/1308.5264"}> arXiv:1308.5264
              )
        .revisedby
          %p
