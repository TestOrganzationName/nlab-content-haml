                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A_1, \mu_1, e_1)\longrightarrow (A_2, \mu_2, f_2)
              is a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; A_1 \longrightarrow A_2
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ⊗
                                %mi f
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                            %mo ⊗
                            %msub
                              %mi A
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_1 \otimes A_1
                    \&amp;\overset{f \otimes f}{\longrightarrow}&amp;
                    A_2 \otimes A_2
                    \\\
                    {}^{\mathllap{\mu_1}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\mu_2}}
                    \\\
                    A_1 &amp;\underset{f}{\longrightarrow}&amp; A_2
                    }
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mn 1
                              %mi 𝒸
                          %mtd
                            %mover
                              %mo ⟶
