                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  (
                  %a{:href => "#DeligneMilne12"}> Deligne-Milne 12, def. 3.7
                  ).
          %p
            Given a super fiber functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
