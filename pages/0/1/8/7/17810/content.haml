            from example
            = succeed "," do
              %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/2
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+two"} cyclic group of order two
          #Z2Zgradedvectorspaces.num_example
            %h6#example_4 Example
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                \-
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of two vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    V = V_{even} \oplus V_{odd}
                    \\,,
            %p
              where we think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi even
                  %annotation{:encoding => "application/x-tex"} V_{even}
              as the summand that is graded by the
              %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} V_{odd}
              as being the summand that is graded by the single non-trivial element.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; V_1 \longrightarrow V_2
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              of the underlying vector spaces that respects the grading, hence equivalently a pair of linear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi even
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                  %annotation{:encoding => "application/x-tex"}
                    f_{even} \;\colon\; (V_1)_{even} \longrightarrow (V_1)_{even}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi odd
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    f_{odd} \;\colon\; (V_1)_{odd} \longrightarrow (V_1)_{odd}
            %p between then summands in even degree and in odd degree, respectively:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msub
                      %mi f
                      %mi even
                    %mo ⊕
                    %msub
                      %mi f
                      %mi odd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = f_{even} \oplus f_{odd}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
              of the underlying vector spaces, but with the grading obtained from multiplying the original gradings in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mo )
                    %mo ⊕
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi odd
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi odd
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (V_1 \otimes V_2)_{even}
                    \\;\coloneqq\;
                    \\left((V_1)_{even} \otimes (V_2)_{even}\right)
                    \\oplus
                    \\left((V_1)_{odd} \otimes (V_2)_{odd}\right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi odd
                      %mo )
                    %mo ⊕
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi odd
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (V_1 \otimes V_2)_{odd}
                    \\;\coloneqq\;
                    \\left((V_1)_{even} \otimes (V_2)_{odd}\right)
                    \\oplus
                    \\left((V_1)_{odd} \otimes (V_2)_{even}\right)
                    \\,.
            %p
              As in example
              = succeed "," do
                %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              def.
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidalCategory"}
          #TheTwoNontrivialBraidingsOnZ2GradedVectorSpaces.num_prop
            %h6#proposition Proposition
            %p
              There are, up to
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi τ
                          %mrow
                            %msub
                              %mi V
                              %mn 1
                            %mo ,
                            %msub
                              %mi V
                              %mn 2
                    %msub
                      %mi V
                      %mn 2
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    V_1 \otimes V_2
                    \\stackrel{\tau_{V_1,V_2}}{\longrightarrow}
                    V_2 \otimes V_1
            %p
              on the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Vect
                      %mi k
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Vect_k^{\mathbb{Z}/2}, \otimes_k)
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#Z2Zgradedvectorspaces"}
            %ol
              %li
                %p
                  the
                  %strong trivial braiding
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                  given on tuples
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (v_1,v_2)
                  representing an element in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi V
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} V_1 \otimes V_2
                  (according to def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TensorProductOfVectorSpaces"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi τ
                          %mrow
                            %msub
                              %mi V
                              %mn 1
                            %mo ,
                            %msub
                              %mi V
                              %mn 2
                          %mi triv
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\tau^{triv}_{V_1, V_2} \;\colon\; (v_1,v_2) \mapsto (v_2, v_1)
              %li
                %p
                  the
                  %strong super-braiding
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
                  %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
                  given on tuples
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (v_1,v_2)
                  of
                  %em homogeneous degree
                  (i.e.
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi v
                            %mi i
                          %mo ∈
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi σ
                                %mi i
                          %mo ↪
                          %msub
                            %mi V
                            %mi i
                        %annotation{:encoding => "application/x-tex"} v_i \in (V_i)_{\sigma_i} \hookrightarrow V_i
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi i
                          %mo ∈
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \sigma_i \in \mathbb{Z}/2
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi τ
                          %mrow
                            %msub
                              %mi V
                              %mn 1
                            %mo ,
                            %msub
                              %mi V
                              %mn 2
                          %mi super
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tau^{super}_{V_1, V_2}
                        \\;\colon\;
                        (v_1, v_2)
                        \\mapsto
                        (-1)^{deg(v_1) deg(v_2)}
                        \\,
                        (v_2,v_1)
                        \\,.
          .proof
            %h6#proof Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Line(\mathcal{C}), \otimes, 1)
                    \\hookrightarrow
                    (\mathcal{C}, \otimes, 1)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L \in \mathcal{C}
              which are
              %a.existingWikiWord{:href => "/nlab/show/invertible+objects"} invertible objects
              under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L^{-1} \in \mathcal{C}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊗
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ≃
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} L \otimes L^{-1} \simeq 1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⊗
                      %mi L
                      %mo ≃
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} L^{-1} \otimes L \simeq 1
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is clearly in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(L)
              (with
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ≃
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1^{-1} \simeq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ,
                    %msub
                      %mi L
                      %mn 2
                    %mo ∈
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L_1, L_2 \in Line(\mathcal{C}) \hookrightarrow \mathcal{C}
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi L
                      %mn 2
                    %mo ∈
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_1 \otimes L_2 \in Line(\mathcal{C})
              (with
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mn 1
                      %mo ⊗
                      %msub
                        %mi L
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ≃
                      %msubsup
                        %mi L
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⊗
                      %msubsup
                        %mi L
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (L_1 \otimes L_2)^{-1} \simeq L_2^{-1} \otimes L_1^{-1}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              restricts to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Line(\mathcal{C})
            %p
              Accordingly any
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes,1)
              restricts to a braiding on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}), \otimes, 1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}), \otimes, 1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}, \otimes , 1))
              is necessarily a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              (the “
              %a.existingWikiWord{:href => "/nlab/show/Picard+groupoid+of+a+monoidal+category"}> Picard groupoid
              ” of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
              %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
              with group structure, and as such it it is equivalent to its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo ⊗
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B_\otimes Line(\mathcal{C})
            %p
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+type"} pointed homotopy type
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(Line(\mathcal{C}))
                    \\simeq
                    \\pi_1(B Line(\mathcal{C}))
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of the delooping space.
            %p
              Now a symmetric braiding on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(\mathcal{C})
              is precisely the structure that makes it a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+2-group"} symmetric 2-group
              which is equivalently the structure of a second
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 2
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^2 Line(\mathcal{C})
              (for the braiding) and then a third delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 3
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^3 Line(\mathcal{C})
              (for the symmetry), regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+type"} pointed homotopy type
            %p
              This way we have rephrased the question equivalently as a question about the possible
              %a.existingWikiWord{:href => "/nlab/show/k-invariants"} k-invariants
              of spaces of this form.
            %p
              Now in the case at hand,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              has precisely two
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of objects, namely the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              itself, regarded as being in even degree and regarded as being in odd degree. We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} k^{1\vert 0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{0 \vert 1}
              for these, respectively. By the rules of the tensor product of
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    k^{1\vert 0} \otimes_k k^{1\vert 0} \simeq k^{1\vert 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    k^{1\vert 0} \otimes_k k^{0\vert 1} \simeq k^{0\vert 1}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k^{0 \vert 1} \otimes_k k^{0 \vert 1} \simeq k^{1 \vert 0}
                    \\,.
            %p In other words
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(Line(Vect^{\mathbb{Z}/2})) \simeq \mathbb{Z}/2
                    \\,.
            %p Now under the above homotopical identification the non-trivial braiding is identified with the elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi τ
                          %mrow
                            %msup
                              %mi k
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                            %mo ,
                            %msup
                              %mi k
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                          %mi super
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    1 =
                    k^{1 \vert 0}
                    \\simeq
                    k^{0\vert 1} \otimes_k k^{0 \vert 1}
                    \\stackrel{\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}}}{\longrightarrow}
                    k^{0\vert 1} \otimes_k k^{0\vert 1}
                    \\simeq
                    k^{1 \vert 0}
                    \= 1
            %p
              Due to the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetry
              condition (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi τ
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mo ,
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                      %mi super
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    (\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}})^2 = id
            %p which implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi τ
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mo ,
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                      %mi super
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi id
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi id
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}}
                    \\in
                    \\{+ id, -id\}
                    \\,.
            %p
              Therefore for classifying just the symmetric braidings, it is sufficient to restrict the
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              from being either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              or empty, to
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              being
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2 = \{+1-1\} \hookrightarrow k
              or empty. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Line
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde{Line}(Vect^{\mathbb{Z}/2})
              for the resulting
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            %p
              In conclusion then the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of possible
              %a.existingWikiWord{:href => "/nlab/show/k-invariants"} k-invariants
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mn 3
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Vect
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B^3 Line(Vect^{\mathbb{Z}/2})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              are in the degree-4
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ,
                    %mn 3
