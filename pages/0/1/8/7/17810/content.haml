                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(x) \otimes_{\mathcal{C}} F(y)
                    \&amp;\overset{\tau^{\mathcal{D}}_{F(x), F(y)}}{\longrightarrow}&amp;
