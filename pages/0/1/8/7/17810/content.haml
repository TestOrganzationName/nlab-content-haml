                        \\,,
                %p
                  where
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℓ
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \ell^{\mathcal{C}}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℓ
                            %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \ell^{\mathcal{D}}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
