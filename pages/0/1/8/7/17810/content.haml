            %h6#definition_7 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
