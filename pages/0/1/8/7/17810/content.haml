                %semantics
                  %mrow
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{Aut}(\omega)(Spec(A))
          %p
            In conclusion, this says that an algebraic supergeometric structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(\omega)
            is the datum of a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            of groups, hence of a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi Aut
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Aff
                  %mo{:stretchy => "false"} (
                  %mi sVect
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ≃
