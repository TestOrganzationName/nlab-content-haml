            %ol
              %li
                %p
                  a
                  %strong
                    neutral
                    %a.existingWikiWord{:href => "/nlab/show/Tannakian+category"} Tannakian category
                  if it admits a fiber functor (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FiberFunctor"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
