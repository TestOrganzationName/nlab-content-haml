              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              and regard the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              functor on it as a fiber functor (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FiberFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} id_{\mathcal{A}}
              according to def.
              %a.maruku-ref{:href => "#AutomorphismSuperGroupOfSuperFiberFunctor"}
              is called the
              %strong fundamental group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(\mathcal{A})
                    \\coloneqq
                    \\underline{Aut}(id_{\mathcal{A}})
          %p
            (
            %a{:href => "#Deligne90"}> Deligne 90, 8.12, 8.13
            )
          #FundamentalGroupOfCategoryOfSuperVectorSpaces.num_example
            %h6#example_32 Example
            %p
              The fundamental group (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalSupergroup"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+super+vector+spaces"} category of super vector spaces
              %a.existingWikiWord{:href => "/nlab/show/sVect"} sVect
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(sVect)
                    \\simeq
                    \\mathbb{Z}/2
                    \\,.
            %p
              The non-trivial element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi(sVect)
              acts on any super-vector space as the
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              which is the identity on even graded elements, and multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
              on odd graded elements.
          %p
            (
            %a{:href => "#Deligne90"}> Deligne 90, 8.14 iv)
            )
          #AutOfFibFuncIsImagUnderFibFuncOfFundamentalGroup.num_prop
            %h6#proposition_25 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} super fiber functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒜
                    %mo →
                    %mi sVect
                  %annotation{:encoding => "application/x-tex"} \omega \colon \mathcal{A} \to sVect
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FiberFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is the image under the super fiber functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              of the fundamental group of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed ":" do
                %a.maruku-ref{:href => "#FundamentalSupergroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Aut
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underline{Aut}(\omega)
                    \\simeq
                    \\omega(\pi(\mathcal{A}))
                    \\,.
            %p
              Here on the right we are using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              so that it preserves
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              as well as
              %a.existingWikiWord{:href => "/nlab/show/comonoids"} comonoids
              by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidsPreservedByLaxMonoidalFunctor"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebras"} commutative Hopf algebras
          %p
            (
            %a{:href => "#Deligne90"}> Deligne 90 (8.13.1)
            )
          #HomomorphismFromPiT2ToEtaPiT1.num_prop
            %h6#proposition_26 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_1, \mathcal{A}_2
              be two
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+categories"} tensor categories
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒜
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi 𝒜
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \mathcal{A}_1 \longrightarrow \mathcal{A}_2
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which is
              = succeed "-linear," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} monoidal
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒜
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒜
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(\mathcal{A}_2)
                    \\longrightarrow
                    \\eta(\pi(\mathcal{A}_1))
            %p
              from the fundamental group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_1
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalSupergroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              of the fundamental group of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒜
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}_2
          %p
            (
            %a{:href => "#Deligne90"}> Deligne 90, 8. 15. 2
            )
          %h2#superexterior_powers_and_schur_functors Super-exterior powers and Schur functors
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            has the property that a high enough
            %a.existingWikiWord{:href => "/nlab/show/alternating+power"} alternating power
            of it vanishes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mi n
                    %mi V
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \wedge^n V = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \gt dim(V)
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of degreewise finite dimension an analog statement is still true, but one needs to form not just alternating powers but also
            %a.existingWikiWord{:href => "/nlab/show/symmetric+powers"} symmetric powers
            (prop.
            %a.maruku-ref{:href => "#SchurFunctorAnnihilatingFiniteDimensionalSuperVectorSpace"}
            below), in fact one needs to apply a generalization of both of these constructions, a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
          %p
            The operation of forming
            %a.existingWikiWord{:href => "/nlab/show/symmetric+powers"} symmetric powers
            and
            %a.existingWikiWord{:href => "/nlab/show/alternating+powers"} alternating powers
            makes sense in every
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Schur+functors"} Schur functors
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and given any choice of
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi λ
                %annotation{:encoding => "application/x-tex"} V_\lambda
            of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma_n
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msup
                        %mo ⊗
                        %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S_\lambda(X^{\otimes^n})
            of the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/tensor+power"} tensor power
            that is
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under this action.
          %p
            The first step in the proof of the main theorem (theorem
            %a.maruku-ref{:href => "#TheTheorem"}
            below) is the proposition (prop.
            %a.maruku-ref{:href => "#LengthOfObjectIsBounded"}
            below) that all objects that have subexponential growth of length (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SubexponentialGrowth"}
            %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
          #SchurFunctor.num_defn
            %h6#definition_46 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{A},\otimes)
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
              as in def.
              %a.maruku-ref{:href => "#TensorCategory"}>
              , for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
              and hence as a
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} V_\lambda
              %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} S_\lambda
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mi λ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mi λ
                            %mo ⊗
                            %msup
                              %mi X
                              %mrow
                                %msub
                                  %mo ⊗
                                  %mi n
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi S
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi n
                                  %mo !
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi g
                                  %mo ∈
                                  %msub
                                    %mi S
                                    %mi n
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mrow
                              %mo (
                              %msub
                                %mi V
                                %mi λ
                              %mo ⊗
                              %msup
                                %mi X
                                %mrow
                                  %msub
                                    %mo ⊗
                                    %mi n
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_{\lambda}(X)
                    \&amp; \coloneqq
                    (V_\lambda \otimes X^{\otimes_n})^{S_n}
                    \\\
                    \&amp; =
                    \\left(
                    \\frac{1}{n!}
                    \\underset{g\in S_n}{\sum}
                    \\rho(g)
                    \\right)
                    \\left(
                    V_\lambda \otimes X^{\otimes_n}
                    \\right)
                    \\end{aligned}
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi S
                              %mi n
                      %annotation{:encoding => "application/x-tex"} (-)^{S_n}
                  is the subobject of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
