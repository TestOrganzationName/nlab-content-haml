                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} pho
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \pho_{0,1}
              under the given functor, and every choice of components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \phi_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_1
              extends to a mophism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
