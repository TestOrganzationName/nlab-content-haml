              for the category of braided monoidal functors between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
          #SymmetricMonoidalFunctor.num_remark
            %h6#remark_4 Remark
            %p
              In the literature the term “monoidal functor” often refers by default to what in def.
              %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              is called a
              = succeed "." do
                %em strong monoidal functor
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}} )
              are
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
          .num_example
            %h6#example_5 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} Vect^{\mathbb{Z}/2}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Z2Zgradedvectorspaces"}
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sVect
