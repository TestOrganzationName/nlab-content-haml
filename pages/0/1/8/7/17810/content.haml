                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          #ModulesOverRbeta.num_prop
            %h6#proposition_13 Proposition
            %p Write again
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msubsup
                      %mi{:mathvariant => "normal"} sCAlg
                      %mi ℝ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}[\beta,\beta^{-1}] \in \mathrm{sCAlg}^{\mathbb{Z}}_{\mathbb{R}}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              of even degree from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#kbetaModules"}
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mi β
                      %mo ,
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}[\beta,\beta^{-1}]
              = succeed ")" do
                %a.maruku-ref{:href => "#AAlgebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi sCAlg
                      %mi ℝ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} sCAlg^{\mathbb{Z}}_{\mathbb{R}}
              equipped with a homomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mi β
                      %mo ,
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}[\beta, \beta^{-1}] \to A
              = succeed ")" do
                %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Alg
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi sCAlg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}[\beta,\beta^{-1}] Alg
                    \\;\simeq\;
                    sCAlg_{\mathbb{R}}
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#kbetaModules"}
              and prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
          %p
            As before, all these considerations of course work also for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            replaced by any other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
          #SpectralSuperSchemes.num_example
            %h6#example_17 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be an
              %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
              %a.existingWikiWord{:href => "/nlab/show/periodic+ring+spectrum"} 2-periodic
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MP"} MP
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
              or the spectrum underlying any
              %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology+theory"} elliptic cohomology theory
              or
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E-theory
              = succeed "-graded-commutative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              according to example
              %a.maruku-ref{:href => "#HomotopyCommutativeRingSpectrum"}
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(E) \simeq \pi_0(E)[\beta, \beta^{-1}]
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              an invertible generator in degree 2 (the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex orientation
            %p
              Accordingly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+algebra"} E-infinity algebra
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
              equipped with an
              = succeed "-homomorphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} E \to A
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              (according to example
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyCommutativeRingSpectrum"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi β
                      %mo ,
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_0(E)[\beta, \beta^{-1}]
              %a.maruku-ref{:href => "#kbetaModules"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(A)
              is canonically identified with a
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi β
                      %mo ,
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_0(E)[\beta, \beta^{-1}]
            %p
              This is amplified in
              = succeed "." do
                %a{:href => "periodic+ring+spectrum#Rezk09"} Rezk 09, section 2
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+super-scheme"} spectral super-scheme
              for more.
          %p
            Beware that for this equivalence of categories in prop.
            %a.maruku-ref{:href => "#ModulesOverRbeta"}
            the action of the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is crucual. The following proposition shows that it is not sufficient to just consider 2-periodically
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          #2PeriodicZGradedSupercommutativeSuperalgebras.num_prop
            %h6#proposition_14 Proposition
            %p
              There is a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sCAlg
                      %mi ℝ
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi per
                      %mover
                        %mo ⟵
                        %mi forget
                    %msubsup
                      %mi sCAlg
                      %mi ℝ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    sCAlg_{\mathbb{R}}
                    \\underoverset
                    {\underset{per}{\longrightarrow}}
                    {\overset{forget}{\longleftarrow}}
                    {\bot}
                    sCAlg^{\mathbb{Z}}_{\mathbb{R}}
            %p
              between the categories of
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "," do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebraZGraded"}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  simply forgets the lift to a
                  = succeed "-grading," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  sends a supercommutative superalgebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi even
                        %mo ⊕
                        %msub
                          %mi A
                          %mi odd
                        %mo ,
                        %mo ⋅
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A = (A_{even} \oplus A_{odd}, \cdot)
                  to the
                  %em periodically
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi per
                      %annotation{:encoding => "application/x-tex"} A_{per}
                  with
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi per
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi A
                                    %mi even
                                %mtd
                                  %mo{:stretchy => "false"} |
                                  %mi n
                                  %mspace{:width => "thickmathspace"}
                                  %mtext is even
                              %mtr
                                %mtd
                                  %msub
                                    %mi A
                                    %mi odd
                                %mtd
                                  %mo{:stretchy => "false"} |
                                  %mi n
                                  %mspace{:width => "thickmathspace"}
                                  %mtext is odd
                      %annotation{:encoding => "application/x-tex"}
                        (A_{per})_n \coloneqq
                        \\left\{
                        \\array{
                        A_{even} &amp; \vert n \; \text{is even}
                        \\\
                        A_{odd} &amp; \vert n \; \text{is odd}
                        }
                        \\right.
                %p
                  whose product is elementwise that of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi per
                  %annotation{:encoding => "application/x-tex"} per
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
          .proof
            %h6#proof_7 Proof
            %p
              It is immediate to check the
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              between
              %a.existingWikiWord{:href => "/nlab/show/hom+sets"} hom sets
              that characterizes the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi sCAlg
                      %mi ℝ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} A \in sCAlg^{\mathbb{Z}}_{\mathbb{R}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %msub
                      %mi sCAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} B \in sCAlg_{\mathbb{R}}
              then a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %msub
                      %mi B
                      %mi per
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; A \longrightarrow B_{per}
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi sCAlg
                      %mi ℝ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} sCAlg^{\mathbb{Z}}_{\mathbb{R}}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of the underlying
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mi per
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi B
                                %mi even
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mtext is even
                          %mtr
                            %mtd
                              %msub
                                %mi B
                                %mi odd
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mtext is odd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(A_n)
                    \\subset
                    (B_{per})_n
                    \=
                    \\left\{
                    \\array{
                    B_{even} &amp; \vert n\; \text{is even}
                    \\\
                    B_{odd} &amp; \vert n \; \text{is odd}
                    }
                    \\right.
                    \\,.
            %p This constraint is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ⊕
                      %mrow
                        %mn 2
                        %mi n
                    %msub
                      %mi A
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi B
                      %mi even
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ⊕
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mi A
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi B
                      %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(\oplus_{2n} A_{2n})
                    \\subset
                    B_{even}
                    \\;\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;\;
                    \\phi(\oplus_{2n+1} A_{2n+1})
                    \\subset
                    B_{odd}
            %p which in turn is equivalently the constraint on an algebra homomorphism to constitute a morphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi forget
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \phi \;\colon\; forget(A) \longrightarrow B
                    \\,.
            %p
              This establishes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %p
              It is immediate to see by direct inspection that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi per
                  %annotation{:encoding => "application/x-tex"} per
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit of the adjunction
              is on a superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              given by the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mo ⊕
                        %mrow
                          %mn 2
                          %mi n
                      %msub
                        %mi A
                        %mi even
                      %mo )
                    %mo ⊕
                    %mrow
                      %mo (
                      %msub
                        %mo ⊕
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %msub
                        %mi A
                        %mi odd
                      %mo )
                    %mo ⟶
                    %msub
                      %mi A
                      %mi even
                    %mo ⊕
                    %msub
                      %mi A
                      %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\oplus_{2n} A_{even}\right) \oplus \left(\oplus_{2n+1} A_{odd}\right)
                    \\longrightarrow
                    A_{even} \oplus A_{odd}
            %p
              which is componentwise the identity. This is clearly an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (
              %a{:href => "adjoint+functor#FullyFaithfulAndInvertibleAdjoints"}> this prop.
              ), this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              but not a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
          %h3#affine_superschemes Affine superschemes
          %p
            It is useful to make explicit the following
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            perspective on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
          #Affines.num_defn
            %h6#definition_28 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    Aff(\mathcal{C}) \coloneqq CMon(\mathcal{C})^{op}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+commutative+monoids"} category of commutative monoids
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \in CMon(\mathcal{C})
              we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spec(A)
                    \\in
                    Aff(\mathcal{C})
            %p
              for the same object, regarded in the opposite category. We also call this the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi Aff
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \in Aff(\mathcal{C})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(X) \in CMon(\mathcal{C})
            %p
              for the same object, regarded in the category of commutative monoids. We also call this the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #AffineSuperSchemes.num_defn
            %h6#definition_29 Definition
            %p
              For the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} mathal
                    %mi C
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathal{C} =
              %a.existingWikiWord{:href => "/nlab/show/sVect"} sVect
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
              = succeed "," do
                %a.maruku-ref{:href => "#Affines"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi scAlg
                      %mi k
                      %mi op
                    %mo =
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    Aff(sVect_k) = scAlg_k^{op} =  CMon(sVect_k)^{op}
            %p
              are
              %strong
                %a.existingWikiWord{:href => "/nlab/show/affine+super+schemes"} affine super schemes
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          #OrdinaryCAlgAssCAlg.num_example
            %h6#example_18 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi CAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} A \in CAlg_{\mathbb{R}}
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              by regarding it as being concentrated in even degrees. Accordingly, via def.
              = succeed "," do
                %a.maruku-ref{:href => "#Affines"}
              %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} fully embed
              into
              %a.existingWikiWord{:href => "/nlab/show/affine+super+schemes"} affine super schemes
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AffineSuperSchemes"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aff(Vect_k)
                    \\hookrightarrow
                    Aff(sVect_k)
                    \\,.
            %p
              In particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^p
              an ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/affine+superscheme"} affine superscheme
              in even degree, under the above embedding. As such, it is usually written
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ∈
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{p \vert 0}
                    \\in
                    Aff(sVect_k)
                    \\,.
          #Superpoint.num_example
            %h6#example_19 Example
            %p
              The formal dual space, according to def.
              %a.maruku-ref{:href => "#Affines"}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Affines"}
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet_{\mathbb{R}}(\mathbb{R}^q)
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GrassmannAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/Taylor+expansion"} Taylor expansion
              of any real-valued function on it become “so very small” as to be actually equal to zero, at least after the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            %p
              For instance for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} q = 2
              then a general element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet_{\mathbb{R}}(\mathbb{R}^q)
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msub
                      %mi a
                      %mn 0
                    %mo +
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi θ
                      %mn 1
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %msub
                      %mi θ
                      %mn 2
                    %mo +
                    %msub
                      %mi a
                      %mn 12
                    %msub
                      %mi θ
                      %mn 1
                    %msub
                      %mi θ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi q
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = a_0 + a_1 \theta_1 + a_2 \theta_2 + a_{12} \theta_1 \theta_2
                    \\;\;\;\in
                    \\wedge^\bullet_{\mathbb{R}}(\mathbb{R}^q)
                    \\,.
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %msub
                        %mi a
                        %mn 2
                      %mo ,
                      %msub
                        %mi a
                        %mn 12
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} a_1,a_2, a_{12} \in \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/Taylor+expansion"} Taylor expansion
              of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} g \colon \mathbb{R}^2 \to \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi g
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi g
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi x
                      %mn 2
                    %mo +
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mn 2
                        %mi g
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mn 1
                        %mo ∂
                        %msub
                          %mi x
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi x
                      %mn 1
                    %msub
                      %mi x
                      %mn 2
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g(x_1, x_2) =
                    g(0) + \frac{\partial g}{\partial x_1}(0)\, x_1 + \frac{\partial g}{\partial x_2}(0)\, x_2
                    +
                    \\frac{\partial^2 g}{\partial x_1 \partial x_2}(0) \, x_1 x_2
                    +
                    \\cdots
                    \\,.
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              %a.existingWikiWord{:href => "/nlab/show/space"} space
              to a
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              behaves like an infinitesimal neighbourhood of a point. Hence these are also called
              %strong
                %a.existingWikiWord{:href => "/nlab/show/superpoints"} superpoints
              and one writes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ≔
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∧
                      %mi ℝ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{0\vert q}
                    \\coloneqq
                    Spec(\wedge^\bullet_{\mathbb{R}}(\mathbb{R}^q))
                    \\,.
          #SuperCartesianSpace.num_example
            %h6#example_20 Example
            %p
              Combining example
              %a.maruku-ref{:href => "#OrdinaryCAlgAssCAlg"}
              with example
              = succeed "," do
                %a.maruku-ref{:href => "#Superpoint"}
              = succeed "," do
                %a.maruku-ref{:href => "#ProductsInAff"}
              %a.existingWikiWord{:href => "/nlab/show/affine+super+schemes"} affine super schemes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ≃
                    %mi Spec
                    %mrow
                      %mo (
                      %munder
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mi p
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %msub
                        %mo ⊗
                        %mi ℝ
                      %msubsup
                        %mo ∧
                        %mi ℝ
                        %mo •
                      %msup
                        %mi ℝ
                        %mi q
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{p \vert q}
                    \\coloneqq
                    \\mathbb{R}^{p\vert 0}
                    \\times
                    \\mathbb{R}^{0\vert q}
                    \\simeq
                    Spec\left(
                    \\underbrace{C^\infty(\mathbb{R}^p)}
                    \\otimes_{\mathbb{R}}
                    \\wedge^\bullet_{\mathbb{R}} \mathbb{R}^q
                    \\right)
                    \\,.
            %p
              These may be called the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              as the ordinary
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              do for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} geometry of physics – supergeometry
              for more on this.
          #ParityAutomorphism.num_defn
            %h6#definition_30 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              %strong parity involution
              is the algebra
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi par
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    par \;\colon\; A \overset{\simeq}{\longrightarrow} A
            %p
              which on homogeneously graded elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi even
                    %mo ,
                    %mi odd
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} deg(a) \in \{even,odd\} = \mathbb{Z}/2\mathbb{Z}
              is multiplication by the degree
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a \mapsto (-1)^{deg(a)}a
                    \\,.
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1303.1916"} arXiv:1303.1916, 7.5
            %p
              Dually, via def.
              = succeed "," do
                %a.maruku-ref{:href => "#Affines"}
              %a.existingWikiWord{:href => "/nlab/show/affine+super+scheme"} affine super scheme
              has a canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/involution"} involution
          %p Here are more general and more abstract examples of commutative monoids, which will be useful to make explicit:
          #MonoidGivenByTensorUnit.num_example
            %h6#example_21 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mn 1
                    %mo =
                    %msub
                      %mi r
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo ⊗
                    %mn 1
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell_1 = r_1 \;\colon\; 1 \otimes 1 \overset{\simeq}{\longrightarrow} 1
                    \\,.
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#kel1"}
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              product with unit the identity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} id \colon 1 \to 1
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes , 1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid
          #TensorProductOfTwoCommutativeMonoids.num_example
            %h6#example_22 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoids
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi i
                      %mo ,
                      %msub
                        %mi μ
                        %mi i
                      %mo ,
                      %msub
                        %mi e
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_i, \mu_i, e_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_1 \otimes E_2
              becomes itself a commutative monoid with unit morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mn 1
                    %mo ⊗
                    %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi e
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi e
                          %mn 2
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    e \;\colon\;
                    1
                    \\overset{\simeq}{\longrightarrow}
                    1 \otimes 1
                    \\overset{e_1 \otimes e_2}{\longrightarrow}
                    E_1 \otimes E_2
            %p
              (where the first isomorphism is,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℓ
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msubsup
                      %mi r
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \ell_1^{-1} = r_1^{-1}
              (lemma
              = succeed "))" do
                %a.maruku-ref{:href => "#kel1"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ⊗
                        %msub
                          %mi τ
                          %mrow
                            %msub
                              %mi E
                              %mn 2
                            %mo ,
                            %msub
                              %mi E
                              %mn 1
                        %mo ⊗
                        %mi id
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi μ
                          %mn 2
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    E_1 \otimes E_2
                    \\otimes
                    E_1 \otimes E_2
                    \\overset{id \otimes \tau_{E_2, E_1} \otimes id}{\longrightarrow}
                    E_1 \otimes E_1 \otimes E_2 \otimes E_2
                    \\overset{\mu_1 \otimes \mu_2}{\longrightarrow}
                    E_1 \otimes E_2
            %p
              (where we are notationally suppressing the
              %a.existingWikiWord{:href => "/nlab/show/associators"} associators
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              That this definition indeed satisfies associativity and commutativity follows from the corresponding properties of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi i
                      %mo ,
                      %msub
                        %mi μ
                        %mi i
                      %mo ,
                      %msub
                        %mi e
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_i,\mu_i, e_i)
              = succeed ")" do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
            %p
              Similarly one checks that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo =
                    %msub
                      %mi E
                      %mn 2
                    %mo =
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E_1 = E_2 = E
              then the unit maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≃
                    %mi E
                    %mo ⊗
                    %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ⊗
                        %mi e
                    %mi E
                    %mo ⊗
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    E \simeq E \otimes 1
                    \\overset{id \otimes e}{\longrightarrow}
                    E \otimes E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≃
                    %mn 1
                    %mo ⊗
                    %mi E
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ⊗
                        %mn 1
                    %mi E
                    %mo ⊗
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    E \simeq 1 \otimes E
                    \\overset{e \otimes 1}{\longrightarrow}
                    E \otimes E
            %p and the product map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⊗
                    %mi E
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\mu
                    \\;\colon\;
                    E \otimes E
                    \\longrightarrow
                    E
            %p and the braiding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi E
                        %mo ,
                        %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⊗
                    %mi E
                    %mo ⟶
                    %mi E
                    %mo ⊗
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{E,E}
                    \\;\colon\;
                    E \otimes E
                    \\longrightarrow
                    E \otimes E
            %p
              are monoid homomorphisms, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊗
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E \otimes E
              equipped with the above monoid structure.
          %p
            Monoids are preserved by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} lax monoidal functors
          #MonoidsPreservedByLaxMonoidalFunctor.num_prop
            %h6#proposition_15 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, \otimes_{\mathcal{D}},1_{\mathcal{D}})
              be two
              %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
              be a
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mi μ
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu_A,e_A)
              a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F(A) \in \mathcal{D}
              becomes a monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi μ
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi e
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F(A), \mu_{F(A)}, e_{F(A)})
              by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi μ
                          %mi A
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{F(A)}
                    \\;\colon\;
                    F(A) \otimes_{\mathcal{C}} F(A)
                    \\overset{}{\longrightarrow}
                    F(A \otimes_{\mathcal{C}} A)
                    \\overset{F(\mu_A)}{\longrightarrow}
                    F(A)
            %p
              (where the first morphism is the structure morphism of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mi A
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    e_{F(A)}
                    \\;\colon\;
                    1_{\mathcal{D}}
                    \\longrightarrow
                    F(1_{\mathcal{C}})
                    \\overset{F(e_A)}{\longrightarrow}
                    F(A)
            %p
              (where again the first morphism is the corresponding structure morphism of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %p This construction extends to a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Mon(F)
                    \\;\colon\;
                    Mon(\mathcal{C}, \otimes_{\mathcal{C}}, 1_{\mathcal{C}})
                    \\longrightarrow
                    Mon(\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}})
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of monoids
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              are
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CMon(F)
                    \\;\colon\;
                    CMon(\mathcal{C}, \otimes_{\mathcal{C}}, 1_{\mathcal{C}})
                    \\longrightarrow
                    CMon(\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}})
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              This follows immediately from combining the associativity and unitality (and symmetry) constraints of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              with those of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %h2#ModulesInTensorCategories Modules in tensor categories and Super vector bundles
          %p
            Above (in def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Affines"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from a dual perspective, as determined by their
            %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(X)
          %p
            A key such construction is that of
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mover
                    %mo →
                    %mi p
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \stackrel{p}{\to} X
            is an ordinary smooth real
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of this vector bundle is a smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \sigma \colon X \to V
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∘
                  %mi σ
                  %mo =
                  %mi id
                %annotation{:encoding => "application/x-tex"} p \circ \sigma = id
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi σ
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo =
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; V
                  \\\ &amp; {}^{\mathllap{\sigma}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                  \\\
                  X &amp;=&amp; X
                  }
                  \\,.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_X(V)
            for the set of all such sections. Observe that this set inherits various extra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure
          %p
            First of all, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \to X
            is a vector bundle, we have
            = succeed "-wise" do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} c_1, c_2 \in \mathbb{R}
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \sigma_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sigma_2
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi x
                %annotation{:encoding => "application/x-tex"} V_x
            the
            %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mi σ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi c
                      %mn 2
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1 \sigma_1(x) + c_2 \sigma_2(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mi σ
                      %mn 1
                    %mo +
                    %msub
                      %mi c
                      %mn 2
                    %msub
                      %mi σ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \sigma_1 + c_2 \sigma_2
          %p
            But there is more structure. We need not multiply with the same element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            in each fiber, but we may multiply the section in each fiber by a different element, as long as the choice of element varies smoothly with the fibers, so that the resulting section is still smooth.
          %p
            In other words, every element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(X)
            in the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to a new smooth section
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} f \cdot \sigma
            %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
            in the real vector spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_X(V)
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/action"} action property
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi σ
                  %mo =
                  %mi f
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ⋅
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (f g) \cdot \sigma = f\cdot (g \cdot \sigma)
          %p
            for any two smooth functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
