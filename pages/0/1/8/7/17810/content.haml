                                        %mi μ
                                        %mrow
                                          %mi x
                                          %mo ,
                                          %msub
                                            %mn 1
                                            %mi 𝒞
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟵
