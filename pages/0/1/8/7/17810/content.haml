            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mn 1
                    %mo ,
                    %msub
                      %mi μ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϵ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mn 2
                    %mo ,
                    %msub
                      %mi μ
                      %mn 2
                    %mo ,
                    %msub
                      %mi ϵ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\;\colon\; (F_1,\mu_1, \epsilon_1) \longrightarrow (F_2, \mu_2, \epsilon_2)
              between two (braided) lax monoidal functors is a
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformation"} monoidal natural transformation
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi F
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_x \;\colon\; F_1(x) \longrightarrow F_2(x)
              of the underlying functors
            %p
              compatible with the product and the unit in that the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
              for all objects
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} x,y \in \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi 𝒟
                            %msub
                              %mi F
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo ⊗
                                  %mi 𝒟
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi F
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi 𝒟
                            %msub
                              %mi F
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
