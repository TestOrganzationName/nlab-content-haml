                  %annotation{:encoding => "application/x-tex"} a,b
              of homogeneous degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} deg(a), deg(b) \in \mathbb{Z}
              the product satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                    %mi b
                    %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a b \;=\; (-1)^{deg(a) deg(b)} b a
                    \\,.
            %p
              These are often called
              = succeed "." do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebras"} graded commutative algebras
          %p
            Of course analogous definitions apply for the
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            replaced by any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
          %p
            One reason why example
            %a.maruku-ref{:href => "#SupercommutativeSuperalgebraZGraded"}
            is of interest is that commutative algebras in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            and in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            give examples:
          .num_example
            %h6#example_15 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(k)
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              given degreewise by the tensor product of underlying
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              given on elements in homogeneous degree by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %mi V
                        %mo ⊗
                        %mi W
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi V
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %msub
                      %mo ∂
                      %mi W
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_{V \otimes W} ( v, w)
                    \\;\coloneqq\;
                    (\partial_V v, w)
                    +
                    (-1)^{deg(v)} (v, \partial_W w)
                    \\,.
            %p
              See at the chapter
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} on homotopy types
              the section
              = succeed "." do
                %em
                  %a{:href => "geometry+of+physics+--+homotopy+types#CategoriesOfChainComplexes"} Categories of chain complexes
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
                is a
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi k
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} Ch(k)_\bullet
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgCAlg
                      %mi k
                    %mo ≔
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dgCAlg_k \coloneqq CMon(Ch_\bullet(k))
                    \\,.
            %p
              Under passing to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed ":" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebraZGraded"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgCAlg
                      %mi k
                    %mo ⟶
                    %msubsup
                      %mi sCAlg
                      %mi k
                      %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_\bullet
                    \\;\colon\;
                    dgCAlg_k
                    \\longrightarrow
                    sCAlg_k^{\mathbb{Z}}
                    \\,.
          #HomotopyCommutativeRingSpectrum.num_example
            %h6#example_16 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (i.e., via the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology theory
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              inherit the structure of a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "." do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebraZGraded"}
            %p
              See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory"} Introduction to Stable homotopy theory
              in the section
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyRingSpectra"} 1-2 Homotopy commutative ring spectra
              = succeed "." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"} this proposition
          %p
            The following relation between
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed ":" do
              %a{:href => "periodic+ring+spectrum#Rezk09"} Rezk 09, section 2
          #kbetaModules.num_prop
            %h6#proposition_12 Proposition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Vect
                      %mi k
                      %mi ℤ
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    k[\beta, \beta^{-1}]
                    \\in
                    CMon( Vect^{\mathbb{Z}}_k, \otimes_k, \tau^{super} )
            %p
              for the
              = succeed "-graded-commutative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebraZGraded"}
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} freely generated
              from a single invertible generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              in degree 2:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi β
                        %mo ,
                        %msup
                          %mi β
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi k
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mtext even
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mtext odd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    k[\beta,\beta^{-1}]
                    \\right)_n
                    \\;=\;
                    \\left\{
                    \\array{
                    k &amp; \vert n\;\text{even}
                    \\\
                    0 &amp; \vert n \; \text{odd}
                    }
                    \\right.
                    \\,.
            %p
              Then there are
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Mod
                    %munderover
                      %mo ≃
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %mn 0
                              %mo ,
                              %mn 1
                      %mover
                        %mo ⟵
                        %mrow
                    %msub
                      %mi sVect
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    k[\beta,\beta^{-1}] Mod
                    \\underoverset
                    {\underset{(-)|_{0,1}}{\longrightarrow}}
                    {\overset{}{\longleftarrow}}
                    {\simeq}
                    sVect_k
            %p
              which exhibit an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between its
              %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
            %p
              Here the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (-)|_{0,1}
              sends a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %munder
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %msub
                      %mi V
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V = \underset{n \in \mathbb{Z}}{\oplus} V_n
              to the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 0
                      %mo ⊕
                      %msub
                        %mi V
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V_0 \oplus V_1
          .proof
            %h6#proof_5 Proof
            %p
              It is clear that the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (-)|_{0,1}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              is multiplicatively invertible, by definition, the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} N \in k[\beta,\beta^{-1}]Mod
              then the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \beta^{-1}
              establish
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi n
                    %munderover
                      %mo ≃
                      %munder
                        %mo ⟶
                        %mi β
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi β
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                    %msub
                      %mi N
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    N_n
                    \\underoverset
                    {\underset{\beta }{\longrightarrow}}
                    {\overset{\beta^{-1}}{\longleftarrow}}
                    {\simeq}
                    N_{n+2}
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi \colon N_1 \to N_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} k[\beta, \beta^{-1}] Mod
              respect the multiplication by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \phi_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
