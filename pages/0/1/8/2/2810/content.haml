          %p
          #DefinitionViaRectilinearEmbeddings.num_defn
            %h6 Definition
            %p
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \geq 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\square^k
                    \\;\coloneqq\;
                    (-1, 1)^k
            %p
              for the open
              %a.existingWikiWord{:href => "/nlab/show/cube"} cube
              of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of the
              %a.existingWikiWord{:href => "/nlab/show/open+interval"} open interval
              with itself). We will say that a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mo □
                      %mi k
                    %mo →
                    %msup
                      %mo □
                      %mi k
                  %annotation{:encoding => "application/x-tex"} f \colon \square^k \to \square^k
              is a
              %em rectilinear embedding
              if, with respect to the canonical
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ⊂
                      %mspace{:width => "thinmathspace"}
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} (-1,1) \,\subset\, \mathbb{R}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/affine+function"} affine function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi k
                    %msub
                      %mi x
                      %mi k
                    %mo +
                    %msub
                      %mi b
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f (x_1 , \cdots , x_k )
                    \\;=\;
                    (a_1 x_1 + b_1 , \cdots , a_k x_k + b_k )
            %p
              for some
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} b_i
              , with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi i
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} a_i \gt 0
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                    %mo ×
                    %mi S
                    %mo →
                    %msup
                      %mo □
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \square^k  \times S \to \square^k
              is a
              %em rectilinear embedding
              if it is an
              %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open embedding
              whose restriction to each connected component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                    %mo ×
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \square^k\times S
              is rectilinear in the above sense.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rect
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo □
                      %mi k
                    %mo ×
                    %mi S
                    %mo ,
                    %msup
                      %mo □
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rect(\square^k \times S, \square^k )
              denote the collection of all rectitlinear embeddings from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                    %mo ×
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \square^k \times S
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \square^k
              \. We will regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rect
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo □
                      %mn 2
                    %mo ×
                    %mi S
                    %mo ,
                    %msup
                      %mo □
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rect(\square^2\times S, \square^k )
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/topological+product+space"} topological product space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %mrow
                          %mn 2
                          %mi k
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \big(\mathbf{R}^{2k} \big)^S
            %p
              The spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rect
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo □
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msup
                      %mo □
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rect(\square^k \times \{1, . . . , n\}, \square^k)
              constitute the
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+operad"} topological operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi t
                    %msub
                      %mi 𝔼
                      %mi k
                  %annotation{:encoding => "application/x-tex"} {}^{t} \mathbb{E}_k
              and refer to as the
              = succeed "." do
                %em little k-cubes operad
            %p
          %p
            This is Definition 5.1.0.1 in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          .num_defn
            %h6#definition_2 Definition
            %p
              We define a topological category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi t
                    %msubsup
                      %mi 𝔼
                      %mi k
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} {}^t \mathbb{E}^\otimes_k
              as follows:
            %ul
              %li
                %p
                  The objects of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mrow
                          %mi t
                        %msubsup
                          %mi 𝔼
                          %mi k
                          %mo ⊗
                      %annotation{:encoding => "application/x-tex"} {}^t \mathbb{E}^\otimes_k
                  are the objects
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %msub
                            %mi Fin
                            %mo *
                        %annotation{:encoding => "application/x-tex"} [n] \in Fin_*
              %li
                %p
                  Given a pair of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mrow
                          %mi t
                        %msubsup
                          %mi 𝔼
                          %mi k
                          %mo ⊗
                      %annotation{:encoding => "application/x-tex"} [m], [n] \in {}^t \mathbb{E}^\otimes_k
                  , a morphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [m]
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [n]
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %msubsup
                          %mi E
                          %mi k
                          %mo ⊗
                      %annotation{:encoding => "application/x-tex"} t E^\otimes_k
                  consists of the following data:
                %ul
                  %li
                    %p
                      A morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                            %mo :
                            %mo{:stretchy => "false"} [
                            %mi m
                            %mo{:stretchy => "false"} ]
                            %mo →
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} \alpha : [m] \to [n]
                      in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Fin
                              %mo *
                          %annotation{:encoding => "application/x-tex"} Fin_*
                      \.
                  %li
                    %p
                      For each
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi j
                            %mo ∈
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo ∘
                          %annotation{:encoding => "application/x-tex"} j \in [n]^\circ
                      a rectilinear embedding
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mo □
                                %mi k
                              %mo ×
                              %msup
                                %mi α
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} {
                              %mi j
                              %mo{:stretchy => "false"} }
                              %mo →
                              %msup
                                %mo □
                                %mi k
                            %annotation{:encoding => "application/x-tex"} \square^k \times \alpha^{-1} \{j\} \to \square^k
              %li
                %p
                  For every pair of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msubsup
                          %mi tE
                          %mi k
                          %mo ⊗
                      %annotation{:encoding => "application/x-tex"} [m], [n] \in tE^\otimes_k
                  , we regard
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mrow
                            %msubsup
                              %mi tE
                              %mi k
                              %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_{tE^\otimes_k} ([m], [n])
                  as endowed with the
