          %title References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical singular complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi X
                  %annotation{:encoding => "application/x-tex"} K X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo □
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S^\square X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has an additional structure of compositions.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi m
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (m) = (m_1, \ldots\, , m_n)
            be an
            = succeed "-tuple" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi I
                    %mi n
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %msub
                    %mi m
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi ⋯
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %msub
                    %mi m
                    %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\phi_{(m)} : I^n \rightarrow [0, m_1] \times \cdots \times [0,
                  m_n]
          %p
            be the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi m
                    %mi n
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (x_1 , \ldots \, , x_n) \mapsto (m_1 x_1, \ldots  \, ,
                  m_n x_n).
            Then a
            %em
              subdivision of type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m)
            of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %msup
                    %mi I
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\alpha : I^n
                  \\rightarrow X
            is a factorisation
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mi α
                    %mo ′
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha = \alpha' \circ
                    \\phi_{(m)}
            %em parts
            are the cubes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha_{(r)}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r) = (r_1, \ldots \,, r_n)
            is an
            = succeed "-tuple" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %msub
                      %mi r
                      %mi i
                    %mo ≤
                    %msub
                      %mi m
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    1
                    \\leq r_i \leq m_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo =
                  %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mi n
                  %mo ,
                %annotation{:encoding => "application/x-tex"} i = 1, \ldots\, , n,
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi I
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \alpha_{(r)} : I^n \rightarrow X
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi α
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo +
                  %msub
                    %mi r
                    %mn 1
                  %mo −
                  %mn 1
                  %mo ,
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo +
                  %msub
                    %mi r
                    %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (x_1, \ldots \, , x_n) \mapsto
                  \\alpha'(x_1 + r_1 - 1, \ldots \, , x_n + r_n - 1).
          %p
            We then say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is the
            %em composite
            of the cubes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha_{(r)}
            and write
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
