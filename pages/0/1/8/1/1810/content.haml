                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ,
