          %h1#idea Idea
          %p
            A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enhanced+triangulated+category"} enhanced triangulated category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stable (infinity,1)-category
            %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category+of+spectra"} stable (infinity,1)-category of spectra
            of
            = succeed "s." do
