            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+system"} Postnikov system
          %p A Postnikov system in a general triangulated category is an abstraction of that topological construction to the general case.
          %h1#definition Definition
          %p
            Given a triangulated category
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            a finite complex over
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is any sequence of objects and morphisms in
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
          .maruku-equation
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_4.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo •
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi X
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mn 0
                  %msup
                    %mi X
                    %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mn 1
                  %msup
                    %mi X
                    %mn 2
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                  %mi …
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mi n
                  %msup
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  X^\bullet = \{ X^0 \stackrel{d^0}\to X^1 \stackrel{d^1}\to X^2 \stackrel{d^2}\to\ldots \stackrel{d^n}\to X^n\}
          %p
            in which
            = succeed "." do
              %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi k
                    %mo ∘
                    %msub
                      %mi d
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_k\circ d_{k-1} = 0
          %p
            A
            %strong right Postnikov system subordinated to
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X^\bullet
            is given by the following data
          %ul
            %li a sequence of objects and morphisms
          .maruku-equation
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_7.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mn 0
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                  %msup
                    %mi Y
                    %mn 1
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                  %msup
                    %mi Y
                    %mn 2
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mn 3
                  %mi …
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                  %msup
                    %mi Y
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mi n
                  %msup
                    %mi Y
                    %mi n
                  %mo =
                  %msup
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y^0\stackrel{f_1}\leftarrow Y^1\stackrel{f_2}\leftarrow Y^2 \stackrel{f_3}\leftarrow\ldots\stackrel{f_{n-1}}\leftarrow Y^{n-1}\stackrel{f_n}\leftarrow Y^n= X^n[1]
          %ul
            %li
              %p
                morphisms
                = succeed "," do
                  %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi j
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mo :
                        %msup
                          %mi Y
                          %mi k
                        %mo →
                        %msup
                          %mi X
                          %mi k
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo −
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} j_{k-1}: Y^k\to X^k[n-k+1]
                %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k = 0,\ldots,n-1
                with
                %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo =
                      %mi id
                      %mo :
                      %msup
                        %mi Y
                        %mi n
                      %mo =
                      %msup
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %msup
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} j_{n-1} = id : Y^n = X^n[1]\to X^n[1]
            %li
              %p
                morphisms
                = succeed "," do
                  %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi k
                        %mo :
                        %msup
                          %mi X
                          %mi k
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo −
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %msup
                          %mi Y
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} i_k : X^k[n-k]\to Y^{k+1}
                %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k = 0,\ldots,n-1
          %p such that
          .maruku-equation
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_13.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi k
                  %mo ∘
                  %msub
                    %mi i
                    %mi k
                  %mo =
                  %msup
                    %mi d
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %msup
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
