                  %mn 0
                  %mo &lt;
                  %mi k
                  %mo &lt;
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} j_k\circ i_k = d^k[n-k]: X^k[n-k]\to X^{k+1}[n-k], \,\,\,\,\,\,\,for\,\,\,all\,\,\,\,\,\,\,\,  0\lt k \lt n-1
          %p
            (in particular,
            = succeed ")" do
              %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo =
                    %msup
                      %mi d
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} i_{n-1} = d^{n-1}
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %mi k
                  %mo ≤
                  %mi n
                %annotation{:encoding => "application/x-tex"} 0\leq k\leq n
            the triangles
          .maruku-equation
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mi k
                  %msup
                    %mi Y
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi f
                        %mi k
                  %msup
                    %mi Y
                    %mi k
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi j
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                  %msup
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  X^k[n-k]\stackrel{i_k}\to Y^{k+1}\stackrel{f_k}\to Y^k
                  \\stackrel{j_{k-1}}\to X^k[n-k+1]
          %p are distinguished.
          %p
            A
            %strong right convolution
            of complex
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X^\bullet
            is any object in
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            of the form
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y^0[n-1]
            where
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Y^0
            is the target end of the sequence as above in some right Postnikov system subordinated to
            = succeed "." do
              %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X^\bullet
          %p
            There is also a left-hand version of Postnikov systems and convolutons; however the classes of left and right convolutions of complex
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X^\bullet
            coincide; denote that class
            = succeed "." do
              %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tot(X^\bullet)
            = succeed "." do
              %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tot(X^\bullet)
          %p
            If
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %msup
                    %mi K
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D = K^b(A)
            is the triangulated category of bounded complexes in an additive category
            %math#mathml_3d93e2b08539efb84a0785b42244b1d5d9ba8886_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            then many examples can be obtained via
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+complex"} twisted complex
