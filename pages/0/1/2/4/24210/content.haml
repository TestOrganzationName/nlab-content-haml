          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %em homotopy pushout type
            is a kind of
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            whose
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            is that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushouts"} homotopy pushouts
          %h2#definition Definition
          %h3#AsAHigherInductiveType As a higher inductive type
          %p
            The (homotopy) pushout of a span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi f
                  %mi C
                  %mover
                    %mo →
                    %mi g
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \xleftarrow{f} C \xrightarrow{g} B
            is the
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msubsup
                    %mo ⊔
                    %mrow
                      %mi f
                      %mo ;
                      %mi g
                    %mi C
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \sqcup^{C}_{f ; g} B
            (or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msup
                      %mo ⊔
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \sqcup^C B
          %ul
            %li
              a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inl
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %msup
                      %mo ⊔
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} inl : A \to A \sqcup^{C} B
            %li
              a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inr
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                    %msup
                      %mo ⊔
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} inr : B \to A \sqcup^{C} B
            %li
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c:C
              a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi glue
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi inl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi inr
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} glue(c) : inl (f (c)) = inr (g( c))
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            pseudocode:
          %pre
            %code
              :preserve
                Inductive hpushout {A B C : Type} (f : A -> B) (g : A -> C) : Type :=
                | inl : B -> hpushout f g
                | inr : C -> hpushout f g
                | glue : forall (a : A), inl (f a) == inr (g a).          %h3#InferenceRules Inference rules
          %p
