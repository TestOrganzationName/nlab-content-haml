              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1605.03227"} arXiv.1605.03227
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1145/2933575.2934545"} doi:10.1145/2933575.2934545
          %p as well as in section 6 of:
