          %h3#for_chain_homology For chain homology
          .num_example
            %h6#example_2 Example
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi C
                      %mn 3
                    %mo →
                    %msub
                      %mi C
                      %mn 2
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to C_3 \to C_2 \to C_1 \to C_0
            %p
              be a tower of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              = succeed "," do
                %a.maruku-ref{:href => "#MittagLefflerCondition"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    C \coloneqq \underset{\longleftarrow}{\lim}_n C_n
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}
              the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_q(-)
              of the limit sits in a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              with the ordinary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ⟵
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}
              and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}^1
              of the chain homologies:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                      %mn 1
                    %msub
                      %mi H
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \underset{\longleftarrow}{\lim}^1_i H_{q+1}(C_i)
                    \\longrightarrow H_q(C)
                    \\longrightarrow \underset{\longleftarrow}{\lim}_i H_q(C_i)
                    \\to 0
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Weibel94"} Weibel 94, prop. 3.5.8
          %h3#MilnorSequenceForGeneralizedCohomology For generalized cohomology groups
          %h4#of_spaces Of spaces
          #MilorSequenceForReducedCohomologyOnCWComplex.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong (Milnor exact sequence for generalized cohomology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \underset{\longrightarrow}{\lim}_n X_n
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet
              be an additive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology+theory"} reduced cohomology theory
            %p
              Then the canonical morphisms make a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{\longleftarrow}{\lim}^1_n \tilde E^{\bullet-1}(X_n)
                    \\longrightarrow
                    \\tilde E^{\bullet}(X)
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_n \tilde E^{\bullet}(X_n)
                    \\to
                    0
                    \\,,
            %p saying that
            %ol
              %li
                %p
                  the failure of the canonical comparison map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %munder
                          %mi lim
                          %mo ⟵
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde E^\bullet(X) \to \underset{\longleftarrow}{\lim} \tilde E^\bullet(X_n)
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
                  on the finite stages to be an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  is at most in a non-vanishing
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              %li
                %p
                  this kernel is precisely the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi lim
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \lim^1
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Lim1ViaCokernel"}
          %p
            e.g. (
            %a{:href => "#Switzer75"}> Switzer 75, prop. 7.66
            ,
            = succeed ")" do
              %a{:href => "#Kochmann96"} Kochmann 96, prop. 4.2.2
          .proof
            %h6#proof_7 Proof
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo =
                    %mrow
                      %mo (
                      %msub
                        %mi X
                        %mn 0
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msub
                        %mi X
                        %mn 1
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                      %msub
                        %mi X
                        %mn 2
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                      %mi ⋯
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet
                    \=
                    \\left(
                    X_0
                    \\overset{i_0}{\hookrightarrow}
                    X_1
                    \\overset{i_1}{\hookrightarrow}
                    X_2
                    \\overset{i_1}{\hookrightarrow}
                    \\cdots
                    \\right)
            %p
              the sequence of stages of the (
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"}> pointed
              )
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi n
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X = \underset{\longleftarrow}{\lim}_n X_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi X
                          %mtd
                            %mo ≔
                            %munder
                              %mo ⊔
                              %mrow
                                %mi n
                                %mo ∈
                                %mi ℕ
                            %msub
                              %mi X
                              %mrow
                                %mn 2
                                %mi n
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %mi n
                            %mo ,
                            %mrow
                              %mn 2
                              %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ;
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mi X
                          %mtd
                            %mo ≔
                            %munder
                              %mo ⊔
                              %mrow
                                %mi n
                                %mo ∈
                                %mi ℕ
                            %msub
                              %mi X
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                            %mrow
                              %mn 2
                              %mi n
                            %mo +
                            %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_X
                    \&amp;\coloneqq
                    \\underset{n \in \mathbb{N}}{\sqcup} X_{2n} \times [2n,{2n}+1];
                    \\\
                    B_X
                    \&amp;\coloneqq
                    \\underset{n \in \mathbb{N}}{\sqcup} X_{(2n+1)} \times [2n+1,{2n}+2].
                    \\end{aligned}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
              of the
              %a.existingWikiWord{:href => "/nlab/show/cylinders"} cylinders
              over all the stages in even and all those in odd degree, respectively.
            %p
              These come with canonical inclusion maps into the
              %a.existingWikiWord{:href => "/nlab/show/mapping+telescope"} mapping telescope
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tel
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tel(X_\bullet)
              (
              %a{:href => "mapping+telescope#MappingTelescope"}> def.
              ), which we denote by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi B
                              %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mrow
                                      %msub
                                        %mi A
                                        %mi x
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mrow
                                      %msub
                                        %mi B
                                        %mi x
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Tel
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_X &amp;&amp; &amp;&amp; B_X
                    \\\
                    \&amp; {}_{\mathllap{\iota_{A_x}}}\searrow &amp;&amp; \swarrow_{\mathrlap{\iota_{B_x}}}
                    \\\
                    \&amp;&amp; Tel(X_\bullet)
                    }
                    \\,.
            %p Observe that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi X
                        %mo ∪
                        %msub
                          %mi B
                          %mi X
                        %mo ≃
                        %mi Tel
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A_X \cup B_X \simeq Tel(X_\bullet)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi X
                        %mo ∩
                        %msub
                          %mi B
                          %mi X
                        %mo ≃
                        %munder
                          %mo ⊔
                          %mrow
                            %mi n
