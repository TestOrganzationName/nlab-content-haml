                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\longrightarrow}{\lim}_n \tilde E_\bullet(X_n)
                    \\overset{\simeq}{\longrightarrow}
                    \\tilde E_\bullet(X)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            (
            %a{:href => "#Switzer75"}> Switzer 75, prop. 7.53
            )
          %h4#ForGeneralizedCohomologyOfSpectra Of spectra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi E
                  %mo ∈
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X, E \in Ho(Spectra)
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed "-generalized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the graded group of homs in the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
            ,
            = succeed ")" do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ForASpectrumXGeneralizedECohomology"} exmpl.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi E
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≔
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi E
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo •
                      %mtr
                        %mtd
                        %mtd
                          %mo ≔
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Σ
                            %mo •
                          %mi X
                          %mo ,
                          %mi E
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  E^\bullet(X)
                  \&amp; \coloneqq
                  [X,E]_{-\bullet}
                  \\\
                  \&amp; \coloneqq
                  [\Sigma^\bullet X, E]
                  \\end{aligned}
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            is, in particular, the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
            of the stable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+orthogonal+spectra"} model structure on orthogonal spectra
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            at the
            %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalences"} stable weak homotopy equivalences
            is of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi OrthSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi stable
                  %mo ⟶
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\gamma
                  \\;\colon\;
                  OrthSpec(Top_{cg})_{stable}
                  \\longrightarrow
                  Ho(Spectra)
                  \\,.
          %p
            In the following when considering an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectrum"} orthogonal spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in OrthSpec(Top_{cg})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
          #CohomologyOfSpectraMilnorSequence.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∈
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, E \in OrthSpec(Top_{cg})
              two
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
              (or two
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/semistable+symmetric+spectrum"} semistable symmetric spectrum
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{\longleftarrow}{\lim}^1_n E^{\bullet + n -1}(X_{n})
                    \\longrightarrow
                    E^\bullet(X)
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_n E^{\bullet + n}(X_n)
                    \\to
                    0
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}^1
              denotes the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lim%5E1"} lim^1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi E
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Σ
                          %mi n
                          %mi X
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\bullet + n + 1}(X_{n+1})
                    \\overset{E^{\bullet+1n+1}(\Sigma^X_n)}{\longrightarrow}
                    E^{\bullet+n+1}(X_n \wedge S^1)
                    \\overset{\simeq}{\longrightarrow}
                    E^{\bullet + n}(X_n)
                    \\,.
          %p
            (
            %a{:href => "#Schwede12"}> Schwede 12, chapter II prop. 6.5 (ii)
            ) (using that symmetric spectra underlying orthogonal spectra are semistable (
            %a{:href => "#Schwede12"}> Schwede 12, p. 40
            ))
          #WithSomeLefflerTheHomsOfSpectraAreHomotopicIfComponentsAre.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,E \in Ho(Spectra)
              two
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              such that the tower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ↦
                    %msup
                      %mi E
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \mapsto E^{n -1}(X_{n})
              satisfies the
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MittagLefflerCondition"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow E
              are homotopic already if all their morphisms of component spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n \to E_n
              are.
          .proof
            %h6#proof_8 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#Lim1VanihesUnderMittagLeffler"}
              the assumption implies that the
              = succeed "-term" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi lim
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} lim^1
              %a.maruku-ref{:href => "#CohomologyOfSpectraMilnorSequence"}
              vanishes, hence by exactness it follows that in this case there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msup
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]
                    \\simeq
                    E^0(X)
                    \\overset{\simeq}{\longrightarrow}
                    \\underset{\longleftarrow}{\lim}_n [X_n, E_n]
                    \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+tower+of+fibrations"} spectral sequence of a tower of fibrations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/conditional+convergence+of+spectral+sequences"}> conditional convergence of spectral sequences
                )
          %h2#references References
          %ul
            %li#Milnor62
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %em On axiomatic homology theory
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.pjm/1103036730"} Euclid
            %li
              %p
                Z. Z. Yeh,
                = succeed "," do
                  %em Higher Inverse Limits and Homology Theories
            %li#BousfieldKan72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                = succeed "," do
                  %em Homotopy limits, completions and localization
            %li#Switzer75
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Switzer"}> Robert Switzer
                , section 7 from def. 7.57 on in
                = succeed "," do
                  %em Algebraic Topology - Homotopy and Homology
            %li#Weibel94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                , section 3.5 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 4.2 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#GoerssJardine99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Rick Jardine
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
              %p
                (that’s section VII.6 of the 1996
                %em Progress of Mathematics
                edition )
          %p For generalized cohomology of spectra
          %ul
            %li#Schwede12
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              , around prop.6.5 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Symmetric spectra
              = succeed ")" do
                %a{:href => "http://www.math.uni-bonn.de/~schwede/SymSpec-v3.pdf"} pdf
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/categories+of+fibrant+objects"} categories of fibrant objects
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
              , section 5 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Abstract+Homotopy+Theory+and+Generalized+Sheaf+Cohomology"} Abstract Homotopy Theory and Generalized Sheaf Cohomology
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/conditional+convergence+of+spectral+sequences"} conditional convergence of spectral sequences
            is in
          %ul
            %li#Boardman99
              %a.existingWikiWord{:href => "/nlab/show/Michael+Boardman"}> Michael Boardman
              , section I.1 of
              = succeed "," do
                %em Conditionally convergent spectral sequences
              = succeed ")" do
                %a{:href => "http://www.uio.no/studier/emner/matnat/math/MAT9580/v12/undervisningsmateriale/boardman-conditionally-1999.pdf"} pdf
