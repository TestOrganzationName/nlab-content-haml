            )
          .proof
            %h6#proof_3 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#TowersOfAbelianGroupsHasEnoughInjectives"}
              there are
              %a.existingWikiWord{:href => "/nlab/show/enough+injectives"} enough injectives
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ab
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi ℕ
                          %mo ,
                          %mo ≥
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ab^{(\mathbb{N}, \geq)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
