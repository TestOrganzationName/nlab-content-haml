                    \\array{
                    holim X_\bullet &amp;\longrightarrow&amp; \underset{n}{\prod} Path(X_n)
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    \\underset{n}{\prod} X_n &amp;\underset{(id,p_n)_n}{\longrightarrow}&amp;
                    \\underset{n}{\prod} X_ n \times X_n
