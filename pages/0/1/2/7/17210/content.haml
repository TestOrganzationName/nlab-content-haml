          #MittagLefflerCondition.num_defn
            %h6#definition_4 Definition
            %p
              A tower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                    %mo →
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to A_3 \to A_2 \to A_1 \to A_0
            %p
              is said to satisfy the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i \geq k
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≥
                    %mi i
                    %mo ≥
                    %mi k
                  %annotation{:encoding => "application/x-tex"} j \geq i \geq k
              the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %msub
                      %mi A
                      %mi k
                  %annotation{:encoding => "application/x-tex"} A_i \to A_k
              equals that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi j
                    %mo →
                    %msub
                      %mi A
                      %mi k
                  %annotation{:encoding => "application/x-tex"} A_j \to A_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %msub
                      %mi A
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi j
                    %mo →
                    %msub
                      %mi A
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    im(A_i \to A_k) \simeq im(A_j \to A_k)
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Switzer75"} Switzer 75, def. 7.74
          #MittagLefflerSatisfiedInParticularForTowerOfSurjections.num_example
