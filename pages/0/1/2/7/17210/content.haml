                    %annotation{:encoding => "application/x-tex"} Hom(-,-) = Ext^0(-,-)
          .proof
            %h6#proof_5 Proof
            %p Consider the homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ⟶
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \partial
                    \\;\colon\;
                    \\underset{n}{\oplus} A_n
                    \\longrightarrow
                    \\underset{n}{\oplus} A_n
            %p
              which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi n
                    %mo ∈
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} a_n \in A_n
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi n
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a_n - f_n(a_n)
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              is the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over the cotower, but its
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is trivial (in contrast to the otherwise
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              situation in remark
              = succeed ")." do
                %a.maruku-ref{:href => "#LimitAsKernelAnalogousToLim1"}
              = succeed ")" do
                %a.maruku-ref{:href => "#Lim1ViaCokernel"}
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mover
                      %mo ⟶
                      %mover
                        %mo ∂
                        %mo{:stretchy => "false"} ˜
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{n}{\oplus} A_n
                    \\overset{\tilde \partial}{\longrightarrow}
                    \\underset{n}{\oplus} A_n
                    \\overset{}{\longrightarrow}
                    \\underset{\longrightarrow}{lim}_n A_n
                    \\to
                    0
                    \\,.
            %p
              Every short exact sequence gives rise to a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              (
              %a{:href => "derived+functor+in+homological+algebra#LongExactSequenceOfRightDerivedFunctorsFromShortExactSequence"}> prop.
              ) which in the present case starts out as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi n
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ∂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi n
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ∂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Hom(\underset{\longrightarrow}{\lim}_n A_n,B)
                    \\longrightarrow
                    \\underset{n}{\prod} Hom( A_n, B )
                    \\overset{\partial}{\longrightarrow}
                    \\underset{n}{\prod} Hom( A_n, B )
                    \\longrightarrow
                    Ext^1(\underset{\longrightarrow}{\lim}_n A_n,B)
                    \\longrightarrow
                    \\underset{n}{\prod} Ext^1(  A_n, B )
                    \\overset{\partial}{\longrightarrow}
                    \\underset{n}{\prod} Ext^1(  A_n, B )
                    \\longrightarrow
                    \\cdots
            %p
              where we used that
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              is the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              in abelian groups, so that homs out of it yield a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              is the one from def.
              %a.maruku-ref{:href => "#TheBoundaryMapDefiningLim1"}
              corresponding to the
              %a.existingWikiWord{:href => "/nlab/show/tower"} tower
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mo •
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(A_\bullet,B)
                    \=
                    (  \cdots \to Hom(A_2,B) \to Hom(A_1,B) \to  Hom(A_0,B) )
                    \\,.
            %p
              Hence truncating this long sequence by forming kernel and cokernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} \partial
          %h2#MilnorSequences Milnor exact sequences
          %h3#for_homotopy_groups For homotopy groups
          #MilnorExactSequence.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong (Milnor exact sequence for homotopy groups)
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi X
                      %mn 3
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 0
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to X_3 \overset{p_2}{\longrightarrow} X_2 \overset{p_1}{\longrightarrow} X_1 \overset{p_0}{\longrightarrow} X_0
            %p
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tower+of+fibrations"} tower of fibrations
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              with each map a
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              (and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              with each map a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{N}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                      %mn 1
                    %msub
                      %mi π
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{\longleftarrow}{\lim}^1_i \pi_{q+1}(X_i)
                    \\longrightarrow
                    \\pi_q(\underset{\longleftarrow}{\lim}_i X_i)
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_i \pi_q(X_i)
                    \\to
                    0
                    \\,,
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet
              the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i = 0
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              for
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i \geq 1
            %ol
              %li
                %p
                  the failure of the
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  over the homotopy groups of the stages of the tower to equal the homotopy groups of the
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of the tower is at most in the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of the canonical comparison map;
              %li
                %p
                  that kernel is the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %munder
                            %mi lim
                            %mo ⟵
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}^1
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Lim1ViaCokernel"}
          %p
            e.g. (
            %a{:href => "#BousfieldKan72"}> Bousfield-Kan 72, chapter IX, theorem 3.1
            ,
            = succeed ")" do
              %a{:href => "#GoerssJardine96"} Goerss-Jardine 96, section VI. prop. 2.15
          .proof
            %h6#proof_6 Proof
            %p
              With respect to the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              or the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo ≥
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} [(\mathbb{N},\geq), sSet]_{inj}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo ≥
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} [(\mathbb{N},\geq), Top]_{inj}
              ) (
              %a{:href => "projectively+cofibrant+diagram#CofibrantCotowerDiagram"}> prop
              ). Hence the plain
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over this diagram represents the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi holim
                            %msub
                              %mi X
                              %mo •
                          %mtd
                            %mo ⟶
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi n
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi n
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %munder
