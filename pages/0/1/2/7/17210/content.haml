                        %mi ℕ
                        %mo ,
                        %mo ≥
                        %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}^1 \colon Ab^{(\mathbb{N}, \geq)} \longrightarrow Ab
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Lim1ViaCokernel"}
            %ol
              %li
