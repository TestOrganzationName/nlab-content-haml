                  %annotation{:encoding => "application/x-tex"} Ext^1(-,-)
              denotes the first
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
