                        %msub
                          %mi p
                          %mi n
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}_n A_n \overset{p_n}{\to} A_n
              such that all
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %msub
                              %mi A
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                            %mo ↙
