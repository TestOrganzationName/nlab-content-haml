                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %msub
                      %mi A
                      %mn 2
                    %mo →
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_\bullet = (A_0 \overset{f_0}{\to} A _1 \overset{f_1}{\to} A_2 \to \cdots)
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} B \in Ab
              there is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{\longleftarrow}{\lim}^1_n Hom(A_n, B)
                    \\longrightarrow
                    Ext^1( \underset{\longrightarrow}{\lim}_n A_n, B )
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_n Ext^1( A_n, B)
                    \\to
                    0
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(-,-)
              denotes the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
