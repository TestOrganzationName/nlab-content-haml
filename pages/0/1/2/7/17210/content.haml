                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi n
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \underset{\longleftarrow}{\lim}_n A_n
                    \\\
                    \&amp; {}^{\mathllap{p_{n+1}}}\swarrow &amp;&amp; \searrow^{\mathrlap{p_n}}
                    \\\
                    A_{n+1} &amp;&amp; \overset{f_n}{\longrightarrow} &amp;&amp; A_n
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commute
              – is equivalently the
