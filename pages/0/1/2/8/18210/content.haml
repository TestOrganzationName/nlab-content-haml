          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"}> Tychonoff theorem
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              of a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small
              family of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
              with the
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              is itself compact.
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi α
                        %mo &lt;
                        %mi κ
                  %annotation{:encoding => "application/x-tex"} (X_\alpha)_{\alpha \lt \kappa}
              be a family of compact spaces indexed by an
              %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %a.maruku-ref{:href => "#char"}
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ×
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi α
                        %mo &lt;
                        %mi κ
                    %msub
                      %mi X
                      %mi α
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y \times \prod_{\alpha \lt \kappa} X_\alpha \to Y
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              for any space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
