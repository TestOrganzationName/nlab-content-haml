              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} X^\gamma
              denote the product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ×
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi α
                        %mo &lt;
                        %mi γ
                    %msub
                      %mi X
                      %mi α
                  %annotation{:encoding => "application/x-tex"} Y \times \prod_{\alpha \lt \gamma} X_\alpha
              (so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 0
                    %mo =
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X^0 = Y
              in this notation), and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ≤
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \beta \leq \gamma
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
