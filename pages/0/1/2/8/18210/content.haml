            %p
              Assume as inductive hypothesis that starting with any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ∈
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0 \in K_0
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi β
                    %mo ∈
                    %msub
                      %mi K
                      %mi β
                  %annotation{:encoding => "application/x-tex"} x_\beta \in K_\beta
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo &lt;
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \beta \lt \kappa
              such that whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo &lt;
                      %mi γ
                      %mo &lt;
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \beta \lt \gamma \lt \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mi β
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mi β
                  %annotation{:encoding => "application/x-tex"} \pi_\beta^\gamma(x_\gamma) = x_\beta
              holds. In particular,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 0
                      %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0^\beta(x_\beta) = x_0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo &lt;
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \beta \lt \kappa
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo =
                    %mi β
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \kappa = \beta + 1
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/successor+ordinal"} successor ordinal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi X
                      %mi β
                    %mo ×
                    %msub
                      %mi X
                      %mi β
                    %mo →
                    %msup
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} \pi_\beta^\kappa \;\colon\; X^\beta \times X_\beta \to X^\beta
            %p
              is a closed map since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X_\beta
              is compact. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi K
                      %mi β
                  %annotation{:encoding => "application/x-tex"} \pi_\beta^\kappa(K) = Cl(\pi_\beta^\kappa(K)) = K_\beta
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is closed, so there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi κ
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} x_\kappa \in K
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mi β
                        %mi κ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi κ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi x
                        %mi β
                    %annotation{:encoding => "application/x-tex"} \pi_\beta^\kappa(x_\kappa) = x_\beta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 0
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi π
                      %mn 0
                      %mi β
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi π
                      %mn 0
                      %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0^\kappa(x_\kappa) = \pi_0^\beta \pi_\beta^\kappa (x_\kappa) = \pi_0^\beta(x_\beta) = x_0
            %p as desired.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi κ
                  %annotation{:encoding => "application/x-tex"} X^\kappa
              as the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              of spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi β
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi β
                        %mo &lt;
                        %mi κ
                  %annotation{:encoding => "application/x-tex"} (X^\beta)_{\beta \lt \kappa}
              with the obvious transition maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mi β
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} \pi_\beta^\gamma
              between them. Hence the tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi β
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi β
                        %mo &lt;
                        %mi κ
                  %annotation{:encoding => "application/x-tex"} (x_\beta)_{\beta \lt \kappa}
              defines an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi κ
                  %annotation{:encoding => "application/x-tex"} x_\kappa
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi κ
                    %annotation{:encoding => "application/x-tex"} X^\kappa
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi κ
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} x_\kappa \in K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is closed, lemma
              %a.maruku-ref{:href => "#LemmaTychonoff"}
              says that it is sufficient to check that for every finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of ordinals below
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_F(x_\kappa) \in Cl(\pi_F(K))
              (as a subspace of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi α
                          %mo ∈
                          %mi F
                      %msub
                        %mi X
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \prod_{\alpha \in F} X_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              there is some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo &lt;
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \beta \lt \kappa
              that dominates all the elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi π
                      %mi F
                      %mi β
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi π
                      %mi F
                      %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi π
                      %mi F
                      %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi π
                      %mi F
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mi F
                      %mi β
                    %msubsup
                      %mi π
                      %mi β
                      %mi κ
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_F(x_\kappa) = \pi_F^\beta \pi_\beta^\kappa(x_\kappa) = \pi_F^\beta(x_\beta) \in \pi_F^\beta(K_\beta) = \pi_F^\beta(Cl(\pi_\beta^\kappa(K))) \subseteq Cl(\pi_F^\beta \pi_\beta^\kappa(K)) = Cl(\pi_F(K))
            %p
              where the inclusion indicated as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊆
                  %annotation{:encoding => "application/x-tex"} \subseteq
              just results from continuity of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mi F
                        %mi β
                    %annotation{:encoding => "application/x-tex"} \pi_F^\beta
          %h3#TubeLemma Tube lemma
          %p
            The following useful lemma was effectively proved already within the proof of prop.
            = succeed "," do
              %a.maruku-ref{:href => "#onlyif"}
          #tube.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tube+lemma"}> tube lemma
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  a point,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %munder
                          %mo ⊂
                          %mtext open
                        %mi X
                        %mo ×
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} W \underset{\text{open}}{\subset} X \times Y
                  an open subset in the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
            %p
              such that the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is contained in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo ⊆
                    %mspace{:width => "thickmathspace"}
                    %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \times Y \;\subseteq\; W
                    \\,.
            %p
              Then there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighborhood"} open neighborhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that the “tube”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U_x \times Y
              around the fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \{x \} \times Y
              is still contained:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ×
                    %mi Y
                    %mo ⊆
                    %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_x \times Y \subseteq W
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi W
                  %annotation{:encoding => "application/x-tex"}
                    C \coloneqq (X \times Y) \backslash W
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.maruku-ref{:href => "#onlyif"}
              also its projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p_X(C) \subset X
              is closed.
            %p Now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi Y
                            %mo ⊂
                            %mi W
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi Y
                            %mspace{:width => "thickmathspace"}
                            %mo ∩
                            %mspace{:width => "thickmathspace"}
                            %mi C
                            %mo =
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ∩
                            %msub
                              %mi p
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\{x\} \times Y \subset W
                    \&amp; \;\Leftrightarrow\;
                    \\{x\} \times Y \; \cap \; C = \emptyset
                    \\\
                    \&amp; \;\Rightarrow\;
                    \\{x\} \cap  p_X(C) = \emptyset
                    \\end{aligned}
            %p
              and hence by the closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_X(C)
              there is (by
              = succeed ")" do
                %a{:href => "Introduction+to+Topology+--+1#UnionOfOpensGivesClosure"} this lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ∩
                    %msub
                      %mi p
                      %mi X
