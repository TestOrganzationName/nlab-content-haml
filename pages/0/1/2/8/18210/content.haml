              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %msub
                      %mi U
                      %mi i
                    %mo ⊆
                    %msub
                      %mi W
                      %mi i
                    %mo ×
                    %msub
                      %mi U
                      %mi i
                    %mo ⊆
                    %mo ¬
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \times U_i \subseteq W_i \times U_i \subseteq \neg C
              (the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ×
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi U
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mi V
                    %mo ×
                    %msub
                      %mi U
                      %mi i
                    %mo ⊆
                    %mo ¬
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \times X \;=\; V \times \bigcup_{i=1}^n U_i \;=\; \bigcup_{i=1}^n V \times U_i \subseteq \neg C
            %p
              so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ×
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ∩
