                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (y, x)
              that doesn’t intersect
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              has a
              %a.existingWikiWord{:href => "/nlab/show/finite+cover"} finite
              subcover, say
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi U
                        %mi n
