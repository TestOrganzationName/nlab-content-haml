              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              there is a corresponding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi i
                  %annotation{:encoding => "application/x-tex"} W_i
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi i
                    %mo ×
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi C
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} (W_i \times U_i) \cap C = \emptyset
              (in fact there is a unique largest such
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi i
                    %annotation{:encoding => "application/x-tex"} W_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ≔
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi W
                        %mi i
