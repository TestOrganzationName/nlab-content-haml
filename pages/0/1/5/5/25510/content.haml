                              %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\widehat{T}{}^2 \in \{\pm id\}
                          \\mathrlap{\,,}
                %li
                  %p
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo ∈
                          %mi G
                        %annotation{:encoding => "application/x-tex"} C \in G
                    then
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mover
                            %mi C
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %annotation{:encoding => "application/x-tex"} \big[\widehat{C}\big]
                    has a representative
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi C
                            %mo ^
                        %annotation{:encoding => "application/x-tex"} \widehat{C}
                    %a.maruku-eqref{:href => "#eq:RepresentativeOfPCTQuantumSymmetry"} (4)
                    such that
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi C
                            %mo ^
                          %msup
                            %mrow
                            %mn 2
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mo ±
                          %mi id
                          %mo{:stretchy => "false"} }
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\widehat{C}{}^2 \in \{\pm id\}
                          \\mathrlap{\,,}
              %p and all these cases occur.
              %p
            .proof
              %h6 Proof
              %p
              %ol
                %li
                  %p
                    That
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mover
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %annotation{:encoding => "application/x-tex"} \big[\widehat{(-)}\big]
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
                    means equivalently that
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                %mtd
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                  %mover
                                    %mi P
                                    %mo ^
                                  %msup
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                                    %mn 2
                                  %mspace{:width => "thickmathspace"}
                                  %mo =
                                  %mspace{:width => "thickmathspace"}
                                  %mi id
                              %mtr
                                %mtd
                                  %mo ⇔
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %msup
                                    %mover
                                      %mi P
                                      %mo ^
                                    %mn 2
                                  %mspace{:width => "thickmathspace"}
                                  %mo =
                                  %mspace{:width => "thickmathspace"}
                                  %mi ω
                                  %mspace{:width => "thinmathspace"}
                                  %mi id
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                  %mtext for some
                                  %mspace{:width => "thickmathspace"}
                                  %mi ω
                                  %mo ∈
                                  %mi{:mathvariant => "normal"} U
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mspace{:width => "thinmathspace"}
                                  %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \&amp; \big[\widehat{P}\big]^2 \;=\; id
                          \\\
                          \\Leftrightarrow
                          \\;\;
                          \&amp;
                          \\widehat{P}^2 \;=\; \omega\, id
                          \\;\;\;
                          \\text{for some}
                          \\;
                          \\omega \in \mathrm{U}(1)
                          \\,.
                          \\end{aligned}
                  %p
                    But since for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo =
                          %msubsup
                            %mi C
                            %mn 2
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} G = C_2^{(p)}
                    the operator
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi P
                            %mo ^
                        %annotation{:encoding => "application/x-tex"} \widehat{P}
                    must be unitary according to
                    %a.maruku-eqref{:href => "#eq:GroupOfUnitaryAndAntiUnitaryOperators"} (1)
                    and hence in particular complex-linear, its rescaling by any
                    %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msqrt
                            %mi ω
                          %mo ∈
                          %mi{:mathvariant => "normal"} U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \sqrt{\omega} \in \mathrm{U}(1)
                    yields an alternative representative
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %msqrt
                                %mi ω
                          %mover
                            %mi P
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mover
                            %mi P
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %annotation{:encoding => "application/x-tex"}
                          \\big[ \tfrac{1}{\sqrt{\omega}} \widehat{P} \big]
                          \\;=\;
                          \\big[ \widehat{P} \big]
                  %p with the desired property:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %msqrt
                                        %mi ω
                                  %mover
                                    %mi P
                                    %mo ^
                                  %msup
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                    %mn 2
                                %mtd
                                  %mo =
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %msqrt
                                        %mi ω
                                  %mover
                                    %mi P
                                    %mo ^
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %msqrt
                                        %mi ω
                                  %mover
                                    %mi P
                                    %mo ^
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %msqrt
                                        %mi ω
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %msqrt
                                        %mi ω
                                  %mover
                                    %mi P
                                    %mo ^
                                  %mover
                                    %mi P
                                    %mo ^
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mi id
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mspace{:width => "thinmathspace"}
                                      %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \\big( \tfrac{1}{\sqrt{\omega}} \widehat{P} \big)^2
                          \&amp; =
                          \\tfrac{1}{\sqrt{\omega}} \widehat{P}
                          \\tfrac{1}{\sqrt{\omega}} \widehat{P}
                          \\\
                          \&amp; =
                          \\tfrac{1}{\sqrt{\omega}}
                          \\tfrac{1}{\sqrt{\omega}}
                          \\widehat{P}
                          \\widehat{P}
                          \\\
                          \&amp; =
                          id
                          \\mathrlap{\,.}
                          \\end{aligned}
                %li
                  %p Group homomorphy again requires that
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                %mtd
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                  %mover
                                    %mi T
                                    %mo ^
                                  %msup
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                                    %mn 2
                                  %mspace{:width => "thickmathspace"}
                                  %mo =
                                  %mspace{:width => "thickmathspace"}
                                  %mi id
                              %mtr
                                %mtd
                                  %mo ⇔
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %msup
                                    %mover
                                      %mi T
                                      %mo ^
                                    %mn 2
                                  %mspace{:width => "thickmathspace"}
                                  %mo =
                                  %mspace{:width => "thickmathspace"}
                                  %mi ω
                                  %mspace{:width => "thinmathspace"}
                                  %mi id
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                  %mtext for some
                                  %mspace{:width => "thickmathspace"}
                                  %mi ω
                                  %mo ∈
                                  %mi{:mathvariant => "normal"} U
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mspace{:width => "thinmathspace"}
                                  %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \&amp; \big[\widehat{T}\big]^2 \;=\; id
                          \\\
                          \\Leftrightarrow
                          \\;\;
                          \&amp;
                          \\widehat{T}^2 \;=\; \omega\, id
                          \\;\;\;
                          \\text{for some}
                          \\;
                          \\omega \in \mathrm{U}(1)
                          \\,,
                          \\end{aligned}
                  %p
                    but now that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi T
                            %mo ^
                        %annotation{:encoding => "application/x-tex"} \widehat{T}
                    is
                    %a.existingWikiWord{:href => "/nlab/show/anti-unitary+operator"} anti-unitary
                    and hence in particular complex-
                    %a.existingWikiWord{:href => "/nlab/show/anti-linear+map"}> antilinear
                    , there is first all a further constraint, namely
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                %mtd
                                  %mover
                                    %mi T
                                    %mo ^
                                  %msup
                                    %mover
                                      %mi T
                                      %mo ^
                                    %mn 2
                                  %mo =
                                  %msup
                                    %mover
                                      %mi T
                                      %mo ^
                                    %mn 2
                                  %mo{:lspace => "0em", :rspace => "thinmathspace"} widehatT
                              %mtr
                                %mtd
                                  %mo ⇒
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %msup
                                    %mi ω
                                    %mo *
                                  %mover
                                    %mi T
                                    %mo ^
                                  %mo =
                                  %mi ω
                                  %mover
                                    %mi T
                                    %mo ^
                              %mtr
                                %mtd
                                  %mo ⇔
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %msup
                                    %mi ω
                                    %mo *
                                  %mo =
                                  %mi ω
                              %mtr
                                %mtd
                                  %mo ⇔
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %mi ω
                                  %mspace{:width => "thinmathspace"}
                                  %mo ∈
                                  %mspace{:width => "thinmathspace"}
                                  %mi{:mathvariant => "normal"} U
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi ℝ
                              %mtr
                                %mtd
                                  %mo ⇔
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                                %mtd
                                  %mi ω
                                  %mspace{:width => "thinmathspace"}
                                  %mo ∈
                                  %mspace{:width => "thinmathspace"}
                                  %mo{:stretchy => "false"} {
                                  %mo ±
                                  %mn 1
                                  %mo{:stretchy => "false"} }
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mspace{:width => "thinmathspace"}
                                      %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \&amp;
                          \\widehat{T} \widehat{T}^2 = \widehat{T}^2 \widehatT
                          \\\
                          \\Rightarrow\;\;
                          \&amp;
                          \\omega^\ast \widehat{T} = \omega \widehat{T}
                          \\\
                          \\Leftrightarrow\;\;
                          \&amp;
                          \\omega^\ast = \omega
                          \\\
                          \\Leftrightarrow\;\;
                          \&amp;
                          \\omega \,\in\, \mathrm{U}(1) \cap \mathbb{R}
                          \\\
                          \\Leftrightarrow\;\;
                          \&amp;
                          \\omega \,\in\, \{\pm 1\}
                          \\mathrlap{\,.}
                          \\end{aligned}
                  %p
                    On the other hand, for the same reason the single non-trivial value for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
                    may no longer be scaled away as before, since now
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %mo ±
                                  %mi{:mathvariant => "normal"} i
                                  %mover
                                    %mi T
                                    %mo ^
                                  %msup
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                    %mn 2
                                %mtd
                                  %mo =
                                  %mo{:stretchy => "false"} (
                                  %mo ±
                                  %mi{:mathvariant => "normal"} i
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi T
                                    %mo ^
                                  %mo{:stretchy => "false"} (
                                  %mo ±
                                  %mi{:mathvariant => "normal"} i
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi T
                                    %mo ^
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mo{:stretchy => "false"} (
                                  %mo ±
                                  %mi{:mathvariant => "normal"} i
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %mo ∓
                                  %mi{:mathvariant => "normal"} i
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi T
                                    %mo ^
                                  %mover
                                    %mi T
                                    %mo ^
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %msup
                                    %mover
                                      %mi T
                                      %mo ^
                                    %mn 2
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mspace{:width => "thinmathspace"}
                                      %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \\big( \pm \mathrm{i} \widehat{T} \big)^2
                          \&amp; =
                          (\pm\mathrm{i})\widehat{T}
                          (\pm\mathrm{i})\widehat{T}
                          \\\
                          \&amp; =
                          (\pm\mathrm{i})(\mp\mathrm{i})\widehat{T}\widehat{T}
                          \\\
                          \&amp; =
                          \\widehat{T}^2
                          \\mathrlap{\,.}
                          \\end{aligned}
                %li
                  %p Same argument as in (2.).
              %p
            %p
            #TenFoldWayOfPCTQuantumSymmetries.num_cor
              %h6 Corollary
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/10-fold+way"} 10-fold way
                  of PCT quantum symmetries)
                %br/
                The set of
                %em PCT quantum symmetries
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PCTQuantumSymmetry"}
                = succeed "," do
                  %a.maruku-ref{:href => "#ClassificationOfPCTQuantumSymmetries"}
              %div{:style => "margin: -30px 0px 20px 30px"}
                %img{:src => "/nlab/files/PCTquantumSymmetries-251106.png", :width => "800px"}/
              %p
            %p
            .num_remark
              %h6 Remark
              %p
                The labels in the last row of the table in Cor.
                %a.maruku-ref{:href => "#TenFoldWayOfPCTQuantumSymmetries"}
                are traditional — early appearance in
                %a{:href => "ten-fold+way#SchnyderRyuFurusakiLudwig2008"} Schnyder, Ryu, Furusaki &amp; Ludwig 2008 table 1
                (where, beware, the labels “DII” and “CII” are swapped with regards to the modern convention), reviewed in
                = succeed ")," do
                  %a{:href => "ten-fold+way#ChiuTeoSchnyderRyu2016"} Chiu, Teo, Schnyder &amp; Ryu 2016
                %a{:href => "symmetric+space#Cartan1926"} Cartan’s 1926
                classification of
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spaces"} symmetric spaces
                in terms of
                %a.existingWikiWord{:href => "/nlab/show/simple+Lie+algebras"} simple Lie algebras
                (see
                = succeed ")." do
                  %a{:href => "simple+Lie+algebra#Classification"} there
          %h3#further Further
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-J%C3%A4nich+theorem"}> Atiyah-Jänich theorem
                –
                %a{:href => "Atiyah-Jänich+theorem#SummaryInTermsOfGradedFredholmOperators"} In terms of graded Fredholm operators
            %li
              %p …
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+topological+phases+of+matter"} K-theory classification of topological phases of matter
          %h2#references References
          %ul
            %li#Dyson62
              %p
                %a.existingWikiWord{:href => "/nlab/show/Freeman+Dyson"}> Freeman Dyson
                ,
                = succeed "," do
                  %em The Threefold Way. Algebraic Structure of Symmetry Groups and Ensembles in Quantum Mechanics
                %strong 3
                1199 (1962) &amp;lbrack;
                %a{:href => "https://doi.org/10.1063/1.1703863"}> doi:10.1063/1.1703863
                \&amp;rbrack;
            %li#AZ97
              %p
                Alexander Altland and Martin R. Zirnbauer,
                = succeed "," do
                  %em Nonstandard symmetry classes in mesoscopic normal-superconducting hybrid structures
                %strong 55
                (1997) 1142 &amp;lbrack;
                %a{:href => "https://doi.org/10.1103/PhysRevB.55.1142"}> doi:10.1103/PhysRevB.55.1142
                \&amp;rbrack;
            %li#HHZ04
              %p
                P. Heinzner, A. Huckleberry, M.R. Zirnbauer,
                %em Symmetry classes of disordered fermions
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math-ph/0411040"}> arXiv:math-ph/0411040
                \&amp;rbrack;
            %li#Z10
              %p
                Martin R. Zirnbauer,
                %em Symmetry Classes
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1001.0722"}> arXiv:1001.0722
                \&amp;rbrack;
            %li#SchnyderRyuFurusakiLudwig2008
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andreas+P.+Schnyder"}> Andreas P. Schnyder
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shinsei+Ryu"} Shinsei Ryu
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Akira+Furusaki"} Akira Furusaki
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Andreas+W.+W.+Ludwig"} Andreas W. W. Ludwig
                = succeed "," do
                  %em Classification of topological insulators and superconductors in three spatial dimensions
                %strong 78
                195125 (2008)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://doi.org/10.1103/PhysRevB.78.195125"} doi:10.1103/PhysRevB.78.195125
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/0803.2786"} arXiv:0803.2786
            %li#Kitaev09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"}> Alexei Kitaev
