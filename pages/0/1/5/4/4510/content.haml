          %p (…)
          %h3#Locatization Localization
          %p (…)
          %h3#techniques_for_constructing_
            Techniques for constructing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ext
                    %mi n
                %annotation{:encoding => "application/x-tex"} Ext^n
          %p
            We discuss some facts helpful for the construction of
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Ext^n
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Ext^n(X, -)  = 0
            %p
              is the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
          .proof
            %h6#proof_2 Proof
            %p
              The covariant
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(X,-)
              is generally a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Ext^n
              via
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+resolutions"} projective resolutions
              = succeed "," do
                %a.maruku-ref{:href => "#OfSingleObjByProjResolution"}
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is projective. In fact, this is one of the equivalent characterizations of
              %em
                %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
              (ee the section
              %a{:href => "projective+object#EquivalentCharacterizationInAbelianCats"} projective object – in abelian categories – equivalent characterizations
              for details).
          #Ext1FromProjectivePresentation.num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X, A \in \mathcal{A}
              two objects, and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi N
                    %mover
                      %mo ↪
                      %mi i
                    %mi P
                    %mover
                      %mo →
                      %mi p
                    %mi X
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to N \stackrel{i}{\hookrightarrow} P \stackrel{p}{\to} X \to 0
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %a.existingWikiWord{:href => "/nlab/show/projective+presentation"} projective presentation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ↪
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \simeq coker(N \hookrightarrow P)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Hom(X,A)
                    \\stackrel{Hom(p,A)}{\to}
                    Hom(P, A)
                    \\stackrel{Hom(i,A)}{\to}
                    Hom(N,A)
                    \\to
                    Ext^1(X,A)
                    \\to
                    0
            %p
              exhibiting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext^1(X,A)
              as the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(i,A)
          %h3#yoneda_product Yoneda product
          %p
            The
            %span.newWikiWord
              Yoneda product
              %a{:href => "/nlab/new/Yoneda+product"} ?
            is a pairing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ext
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi Ext
                    %mi m
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ext
                    %mrow
                      %mi n
                      %mo +
                      %mi m
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ext^n(A,M) \otimes Ext^m(A,N) \to Ext^{n+m}(A,M\otimes_A N).
          %p (…)
          %h2#applications_in_cohomology Applications in cohomology
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
            such as the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                %annotation{:encoding => "application/x-tex"} Ext
            on chain complexes compute general notions of
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            (see the discussion there). Here we list some specific incarnations of the
            = succeed "-construction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                  %annotation{:encoding => "application/x-tex"} Ext
          %h3#universal_coefficient_theorem Universal coefficient theorem
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            identifies, under suitable conditions,
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            to the
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            of
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            up to
            = succeed "-groups." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Ext^1
          %h3#various_notions_of_cohomology_expressed_by_
            Various notions of cohomology expressed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                %annotation{:encoding => "application/x-tex"} Ext
          %p
            Various notions of
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            in the context of
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            can be expressed as
            = succeed "-groups," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                  %annotation{:encoding => "application/x-tex"} Ext
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} K[G]
                its
                %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
                over a commutative ring K, and for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                a
                = succeed "-linear" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                (hence a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} K[G]
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ext
                        %mrow
                          %mi K
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mi Mod
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ext^\bullet_{K[G]Mod}(K, N)
                      \\,.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                an
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                over some
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %msup
                          %mi A
                          %mi op
                      %annotation{:encoding => "application/x-tex"} A \otimes A^{op}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ext
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ⊗
                          %msup
                            %mi A
                            %mi op
                          %mo{:stretchy => "false"} )
                          %mi Mod
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Ext^\bullet_{(A \otimes A^{op})Mod}(A, N)
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                over a commutative ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{U}(\mathfrak{g})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                a Lie algebra module (hence an
                = succeed "-module)," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{U}(\mathfrak{g})
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ext
                        %mrow
                          %mi 𝒰
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mi Mod
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ext^\bullet_{\mathcal{U}(\mathfrak{g}) Mod}(K, N)
                      \\,.
          %h2#Examples Examples
          #ExtensionsOfTheIntegersAreTrivial.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+extensions"} group extensions
                of the
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
            %p
              The
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              with coefficients in any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/AbelianGroups"} AbelianGroups
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1\big(
                    \\mathbb{Z},
                    \\,
                    A
                    \\big)
                    \\;\simeq\; 0
                    \\,.
          %p
            (since the integers are already projective, e.g.
            = succeed ")" do
              %a{:href => "#Boardman"} Boardman, Prop. 19
          #GroupExtensionsOfFiniteCyclicGroups.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+extensions"} group extensions
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            %p
              The
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              with coefficients in any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/AbelianGroups"} AbelianGroups
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mi A
                      %mo ≔
                      %mi coker
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                      %mi A
                      %mover
                        %mo ⟶
                        %mrow
                          %mi n
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi A
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %annotation{:encoding => "application/x-tex"} A/n A \coloneqq coker\Big( A \overset{n \cdot(-)}{\longrightarrow} A \Big)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1
                    \\big(
                    \\mathbb{Z} / n\mathbb{Z},
                    \\,
                    A
                    \\big)
                    \\;\simeq\;
                    A / n A
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Boardman"} Boardman, Prop. 20
          %p But:
          %p
          .num_prop
            %h6 Proposition
            %p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mrow
                        %mo ≥
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^{\geq 2}
                    \\big(
                    \\mathbb{Z} / n\mathbb{Z},
                    \\,
                    A
                    \\big)
                    \\;\simeq\;
                    0
                    \\,.
            %p
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "https://www.math.purdue.edu/~arapura/algebra/homological3.pdf#page=8"} here
          #ExamplesOfExtGroupsOfFiniteCyclicGroups.num_example
            %h6#examples_2 Examples
            %p
              As special cases of Prop.
              %a.maruku-ref{:href => "#GroupExtensionsOfFiniteCyclicGroups"}
              we have:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi ℤ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Ext^1
                        \\big(
                        \\mathbb{Z} / n\mathbb{Z},
                        \\,
                        \\mathbb{Z}
                        \\big)
                        \\;\simeq\;
                        \\mathbb{Z} / n\mathbb{Z}
                        \\,.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi m
                        %mi ℤ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi d
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Ext^1
                        \\big(
                        \\mathbb{Z} / n\mathbb{Z},
                        \\,
                        \\mathbb{Z} / m\mathbb{Z}
                        \\big)
                        \\;\simeq\;
                        \\mathbb{Z} / d\mathbb{Z}
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ≔
                      %annotation{:encoding => "application/x-tex"} d \coloneqq
                  %a.existingWikiWord{:href => "/nlab/show/gcd"} gcd
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi m
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n,m)
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi ℚ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Ext^1
                        \\big(
                        \\mathbb{Z} / n\mathbb{Z},
                        \\,
                        \\mathbb{Q}
                        \\big)
                        \\;\simeq\;
                        0
                        \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Boardman"} Boardman, Cor. 21
          %p
            In fact the last case of Example
            %a.maruku-ref{:href => "#ExamplesOfExtGroupsOfFiniteCyclicGroups"}
            generalizes beyond cyclic groups:
          #ExtensionsByRationalNumebrsAreTrivial.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
                by the
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                are trivial)
            %p
              The
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/AbelianGroups"} AbelianGroups
              with coefficients in the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              is trivial:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi A
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1\big(
                    A,
                    \\,
                    \\mathbb{Q}
                    \\big)
                    \\;\simeq\; 0
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Boardman"} Boardman, Prop. 22
          %p Less immediate is this example:
          #ExtensionsByRationalNumebrsAreTrivial.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
                of
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                by the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %p
              The
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              by the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo{:stretchy => "false"} /
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}/\mathbb{Q}
            %ul
              %li
                %p
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} group of adeles
                  (without the
                  = succeed "-factor)," do
                    %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  %a.existingWikiWord{:href => "/nlab/show/restricted+product"} restricted product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔸
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %munderover
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi p
                            %mspace{:width => "thickmathspace"}
                            %mi prime
                          %mstyle{:scriptlevel => "0"}
                            %mo ′
                        %msub
                          %mi ℚ
                          %mi p
                      %annotation{:encoding => "application/x-tex"} \mathbb{A} \,\coloneqq\, \underoverset{p\;prime}{\prime}{\prod} \mathbb{Q}_p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℚ
                          %mi p
