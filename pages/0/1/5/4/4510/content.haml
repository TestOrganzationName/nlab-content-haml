            its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            a linear
            = succeed "-" do
