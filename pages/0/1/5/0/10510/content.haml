                      %mo ˜
                  %annotation{:encoding => "application/x-tex"}
                    X \xhookrightarrow{\;\; \iota_X \;\;} \widetilde{X}
            %p
              together with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{X}
              itself.
            %p
          %p
            (
            %a{:href => "#MaySigurdsson06"}> MaSi06, Def. 1.3.6
            )
          %p
