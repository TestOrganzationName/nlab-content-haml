                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi hFib
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_X, p_A \,\in\, hFib
                    \\;\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;\;
                    p_{ Map\big( (X,p_X) , (A,p_A)\big) }
                    \\;\in\;
                    hFib
                    \\,.
            %p
          (This is due to
          = succeed "," do
            %a{:href => "#Booth70"} Booth 1970, §6.1
          = succeed ".)" do
            %a{:href => "#MaySigurdsson06"} MaSi06, Prop. 1.3.11
          %p
          #FibMapSpaceDoesNotPreserveWeakHausdorffness.num_remark
            %h6 Remark
            %p
              %strong (fiberwise mapping space does not preserve weak Hausdorffness)
              %br/
              Even if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are
              %a.existingWikiWord{:href => "/nlab/show/weak+Hausdorff+spaces"} weak Hausdorff spaces
              over the weak Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:kwHausBaseSpace"} (1)
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberwiseMappingSpace"}
              = succeed ")." do
                %a{:href => "#BoothBrown74a"} Booth &amp; Brown 1974a
              %a{:href => "#Lewis85"} Lewis 1985, Prop. 1.5
            %p
              On the other hand, the suitable
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              of the fiberwise mapping space will again be weak Hausdorff (see
              = succeed ")." do
                %a{:href => "#MaySigurdsson06"} MaSi06, p. 19
