            %p
              (where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
