                                  %mover
                                    %mrow
                                      %msub
                                        %mi p
                                        %mi A
                                    %mo ˜
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %mi B
