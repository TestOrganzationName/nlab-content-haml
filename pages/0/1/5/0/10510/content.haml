                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (p_B)_*
                gives the
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
                of a fibration.
          %p
            Eventually we consider
            %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi p
                    %mi X
                  %mo ,
                  %msub
                    %mi σ
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi kTop
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi B
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} /
                  %mspace{:width => "thickmathspace"}
