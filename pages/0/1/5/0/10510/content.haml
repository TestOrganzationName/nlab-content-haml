                      %mi B
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  (X, p_X, \sigma_X) \;\in\; \big( kTop_{/B}\big)^{B/} \;=\; kTop_{/B}^{B/}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            of such a base space – hence topological “
            %a.existingWikiWord{:href => "/nlab/show/bundles"}> bundles
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mi X
                  %mi B
                %annotation{:encoding => "application/x-tex"} X \xrightarrow{p_X} B
            (in the most general sense, without any condition on the bundle projection, except
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuity
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
