                %annotation{:encoding => "application/x-tex"} \sigma_X
            (sometimes called “ex-spaces”, see &amp;lbrack;
            %a{:href => "#MaySigurdsson06"}> May &amp; Sigurdsson 2006, p. 19, footnote 1
            \&amp;rbrack;).
          %h3#FiberwiseMappingSpaces Fiberwise mapping spaces
          %blockquote
            %p
              Parametrized mapping spaces are especially delicate &amp;lbrack;
              %a{:href => "#MaySigurdsson06"}> May &amp; Sigurdsson 2006, p. 15
              , see Rem.
              %a.maruku-ref{:href => "#FibMapSpaceDoesNotPreserveWeakHausdorffness"}
              below&amp;rbrack;
          %p
          #PartialMapClassifierSpace.num_defn
            %h6 Definition
            %p
              %strong (partial map classifier space)
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi kTop
                    %annotation{:encoding => "application/x-tex"} X \,\in\, kTop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo ˜
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi kTop
                  %annotation{:encoding => "application/x-tex"} \widetilde X \,\in\, kTop
              for its continuous
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/partial+map+classifier"} partial map classifier
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a
              %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo ⊥
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\bot\}
              and declaring the
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              on the result to be those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under the defining
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
