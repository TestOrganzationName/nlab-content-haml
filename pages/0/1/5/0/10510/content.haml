          %p
          #FiberwiseMappingSpaceSatisfiesExponentialLaw.num_prop
            %h6 Proposition
            %p
              %strong (fiberwise mapping space satisfies the exponential law)
              %br/
              With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              as above
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:kwHausBaseSpace"} (1)
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberwiseMappingSpace"}
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              (satisfies the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/exponential+law+for+spaces"} exponential law
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            #eq:ExponentialLawForFiberwiseMappingSpace.maruku-equation
