          %h3#homotopy_theory_of_the_fiberwise_mapping_space Homotopy theory of the fiberwise mapping space
          %p
          #FiberwiseMappingSpacePreservesHFibrations.num_prop
            %h6 Proposition
            %p
              %strong (fiberwise mapping space preserves h-fibrations)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p_X \colon X \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p_A \colon A \to B
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibrations"} Hurewicz fibrations
              %a.maruku-eqref{:href => "#eq:FiberwiseMappingSpaceAsPullback"} (6)
              out of their fiberwise mapping space (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#FiberwiseMappingSpace"}
            .maruku-equation
