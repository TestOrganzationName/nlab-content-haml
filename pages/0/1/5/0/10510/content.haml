              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi Map
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi p
                      %mi B
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Map(X,A) \underset{Map(X,B)}{\times} \{p_B\}
              (see e.g. at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
