                  %annotation{:encoding => "application/x-tex"} \mathcal{A} = Sh(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ″
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}'' = Sh(U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\subset X
            is an
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi X
                  %mo \
                  %mi U
                %annotation{:encoding => "application/x-tex"} C = X\backslash U
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} sheaf categories
            are induced by the
            %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} j \colon U\hookrightarrow X
            and
            %a.existingWikiWord{:href => "/nlab/show/closed+embedding"} closed embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon C\hookrightarrow X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Artin+gluing"} Artin gluing
          %h2#definition Definition
          %p
            A modern treatment for the recollement of abelian categories is in (
            %a{:href => "#FranjouPirashvili04"}> Franjou-Pirashvili 04
            ), where the following axioms are listed:
          %p
            (i)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                  %mo ⊣
                  %msup
                    %mi j
                    %mo *
                  %mo ⊣
                  %msub
                    %mi j
                    %mo *
                %annotation{:encoding => "application/x-tex"} j_!\dashv j^*\dashv j_*
          %p
            (ii) the
            %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mi 𝒜
                      %mo ″
                  %mo →
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} Id_{\mathcal{A}''}\to j^* j_!
            and the
            %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi j
                    %mo *
                  %mo →
                  %msub
                    %mi Id
                    %mrow
                      %mi 𝒜
                      %mo ″
                %annotation{:encoding => "application/x-tex"} j^* j_*\to Id_{\mathcal{A}''}
            are
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} iso
            (
            %a{:href => "adjoint%20functor#FullyFaithfulAndInvertibleAdjoints"} hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo *
                %annotation{:encoding => "application/x-tex"} j_\ast
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j_!
            are
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
          %p
            (iii)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo ⊣
                  %msub
                    %mi i
                    %mo *
                  %mo ⊣
                  %msup
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} i^*\dashv i_*\dashv i^!
          %p
            (iv) the unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mi 𝒜
                      %mo ′
                  %mo →
                  %msup
                    %mi i
                    %mo !
                  %msub
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} Id_{\mathcal{A}'}\to i^! i_*
            and the counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mo →
                  %msub
                    %mi Id
                    %mrow
                      %mi 𝒜
                      %mo ′
                %annotation{:encoding => "application/x-tex"} i^* i_*\to Id_{\mathcal{A}'}
            are iso
          %p
            (v) the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                  %mo :
                  %mi 𝒜
                  %mo ′
                  %mo →
                  %mi Ker
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i_*:\mathcal{A}'\to Ker(j^*)
            is an equivalence of categories.
          %p
            In fact (i) and (ii) for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mo :
                  %mi 𝒜
                  %mo →
                  %mi 𝒜
                  %mo ″
                %annotation{:encoding => "application/x-tex"} j^*:\mathcal{A}\to\mathcal{A}''
            enable one to define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{A}'
            as the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            satisfy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mi a
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} j^* a = 0
            such that one satisfies the recollement situation.
          %p A standard treatment for the sequence of triangulated functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                  %mo ′
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mo *
                  %mi 𝒟
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi j
                        %mo *
                  %mi 𝒟
                  %mo ″
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{D}'
                  \\overset{i_*}{\to}
                  \\mathcal{D}\overset{j^*}{\to}\mathcal{D}''
          %p
            is in (
            %a{:href => "#BeilinsonBernsteinDeligne82"}> Beilinson-Bernstein-Deligne 82
            ) where in 1.4.3 the following axioms are listed
          %p
            (a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                  %mo =
                  %msub
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} i_* = i_!
            admits a triangulated left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i^*
            and triangulated right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} i^!
          %p
            (b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mo =
                  %msup
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j^* = j^!
            admits a triangulated left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j_!
            and triangulated right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo *
                %annotation{:encoding => "application/x-tex"} j_*
          %p
            (c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} j^* i_* = 0
            (hence by adjointness, also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %msub
                    %mi j
                    %mo !
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} i^*j_! = 0
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo !
                    %msub
                      %mi j
                      %mo *
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i^! j_*=0
          %p
            (d) given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi Ob
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d\in Ob{\mathcal{D}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %msup
                    %mi i
                    %mo !
                  %mi d
                  %mo →
                  %mi d
                  %mo →
                  %msub
                    %mi j
                    %mo *
                  %msup
                    %mi j
                    %mo *
                  %mi d
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mo !
                  %msup
                    %mi i
                    %mo !
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  i_! i^! d \to d\to j_* j^* d\to (i_! i^! d) [1]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                  %msup
                    %mi j
                    %mo !
                  %mi d
                  %mo →
                  %mi d
                  %mo →
                  %msub
                    %mi i
                    %mo *
                  %msup
                    %mi i
                    %mo *
                  %mi d
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi j
                    %mo !
                  %msup
                    %mi j
                    %mo !
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  j_! j^! d \to d\to i_* i^* d\to (j_! j^! d) [1]
          %p
            (e)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                  %mo ,
                  %msub
                    %mi j
                    %mo *
                  %mo ,
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} i_*, j_*, j_!
            are full embeddings.
          %p Again in good situations, less data is needed to provide the recollement.
          %h2#examples Examples
          %ul
            %li The prototypical example of recollement is provided by a closed-open decomposition. In this setup (which works equally well for locally compact Hausdorff spaces and schemes) there is the following diagram of inclusions.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi Z
                      %mtd
                        %mover
                          %mo ↪
                          %mi i
                      %mtd
                        %mi X
                      %mtd
                        %mover
                          %mo ↩
                          %mi j
                      %mtd
                        %mi U
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccc}
                  Z &amp; \xhookrightarrow{i} &amp; X &amp; \xhookleftarrow{j} &amp; U \\
                  \\end{array}
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is a
            %em closed
            inclusion and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is an
            %em open
            inclusion. Then the categories of sheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Z
                %annotation{:encoding => "application/x-tex"} X,Z
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            fit into the recollement structure described above. The recollement structure on the category of sheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            enables one to argue inductively about sheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo .
                %annotation{:encoding => "application/x-tex"} X.
            This idea is usually referred to as
            %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} well-founded
            or
            = succeed "." do
              %span.newWikiWord
                Noetherian induction
                %a{:href => "/nlab/new/Noetherian+induction"} ?
            = succeed "." do
              %a{:href => "#Achar2021"} Achar Exercise 1.3.4, Lemma 2.2.1
          %ul
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+stable+homotopy+theory"} global equivariant stable homotopy theory
              to plain
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
              exhibits a recollement,
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "global+equivariant+stable+homotopy+theory#RelationToPlainStableHomotopyTheory"} global equivariant stable homotopy theory – Relation to plain stable homotopy theory
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
          %h2#references References
          %ul
            %li#FranjouPirashvili04
              %p
                V. Franjou,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/T.+Pirashvili"} T. Pirashvili
                = succeed "," do
                  %em Comparison of abelian categories recollements
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2054979"} MR2005c:18008
                %a{:href => "http://www.math.uni-bielefeld.de/documenta/vol-09/03.pdf"} pdf
            %li#BeilinsonBernsteinDeligne82
              %p
                A.A. Beilinson, J. Bernstein,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
                = succeed "," do
                  %em Faisceaux pervers. Analysis and topology on singular spaces
            %li#Achar2021
              %p
                P. Achar.
                %em Perverse Sheaves and Applications to Representation Theory.
                Vol. 258. Mathematical Surveys and Monographs. Providence, Rhode Island: American Mathematical Society, 2021.
                = succeed "." do
                  %a{:href => "https://doi.org/10.1090/surv/258"} doi:10.1090/surv/258
          %p In references
          %ul
            %li
              E. Cline, B. Parshall, L. Scott,
              = succeed "," do
                %em Finite dimensional algebras and highest weight categories
              = succeed "," do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=961165"} MR90d:18005
              %a{:href => "http://resolver.sub.uni-goettingen.de/purl?GDZPPN002205971"} goettingen
            %li
              E. Cline, B. Parshall, L. Scott,
              = succeed "," do
                %em Algebraic stratification in representative categories
          %p
            one studies the following kind of sources of recollement situations for triangulated categories:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a commutative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            a finite dimensional unital associative
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            an idempotent, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^b(A)
            the bounded derived category of right
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi eA
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} eA(1-e) = 0
            and the global dimension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is finite. Then there is a recollement of triangulated categories involving
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi eAe
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^b(eAe)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^b(A)
            and
            = succeed "." do
