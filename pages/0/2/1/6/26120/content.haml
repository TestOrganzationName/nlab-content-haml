                    %mi.mathscript ℋ
                    %mo ⊸
                    %mi 𝟙
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi.mathscript ℋ
                    %mo ⊗
                    %msup
                      %mi.mathscript ℋ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}Store(\mathbb{1})
                    \\;\equiv\;
                    \\mathscr{H}
                    \\otimes
                    \\big(
                    \\mathscr{H}
                    \\multimap
                    \\mathbb{1}
                    \\big)
                    \\;=\;
                    \\mathscr{H} \otimes \mathscr{H}^\ast
            %p
              is the home of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/density+matrices"} density matrices
              %a.existingWikiWord{:href => "/nlab/show/mixed+quantum+states"} mixed quantum states
              generalizing the
              %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
              in
