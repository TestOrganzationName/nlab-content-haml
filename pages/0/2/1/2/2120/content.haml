          .num_remark
            %h6#remark Remark
            %p
              The collection of open subsets in def.
              %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
              constitutes a
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              in a metric space constitute the
              %a.existingWikiWord{:href => "/nlab/show/basis+of+a+topology"} basis of a topology
              for the
              = succeed "." do
