          .num_prop
            %h6#proposition Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/epsilontic+analysis"} epsilontic
              sense of def.
              %a.maruku-ref{:href => "#EpsilonDeltaDefinitionOfContinuity"}
              precisely if it has the property that its
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (in the sense of def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof Proof
            %p
              First assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous in the epsilontic sense. Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi Y
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} O_Y \subset Y
              any
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi O
                          %mi Y
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in f^{-1(O_Y)}
              any point in the pre-image, we need to show that there exists a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B_x^\circ(\epsilon)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi B
                        %mi X
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi O
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} f(B_X^\circ(\epsilon)) \subset O_Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(O_Y)
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Conversely, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              takes open subsets to open subsets. Then for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B_{f(x)}^\circ(\epsilon)
              an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              around its image, we need to produce an open ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B_x^\circ(\delta)
              in its pre-image. But by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi B
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(B_{f(x)}^\circ(\epsilon))
              contains a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              which by definition means that it contains such an open ball around
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %h3#for_topological_spaces For topological spaces
          #topological.num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X\to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is a
              %strong continuous map
              (or is said to be
              = succeed ")" do
                %em continuous
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} U \subset Y
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(U)
              is an open subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nonstandard+analysis"} nonstandard analysis
          #nonstandard.num_defn
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X\to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is a
              %strong continuous map
              (or is said to be
              = succeed ")" do
                %em continuous
              %span.newWikiWord
                standard point
                %a{:href => "/nlab/new/standard+point"} ?
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              and every
              %span.newWikiWord
                hyperpoint
                %a{:href => "/nlab/new/hyperpoint"} ?
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              are
              %span.newWikiWord
                adequal
                %a{:href => "/nlab/new/adequality"} ?
              (infinitely close, or in other words if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              is in the
              %a.existingWikiWord{:href => "/nlab/show/halo"} halo
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mmultiscripts
                      %mi f
                      %mprescripts
                      %none
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \multiscripts{^*}f{}(x_2)
              are adequal (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mmultiscripts
                      %mi f
                      %mprescripts
                      %none
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \multiscripts{^*}f{}
              is the
              %span.newWikiWord
                nonstandard extension
                %a{:href => "/nlab/new/nonstandard+extension"} ?
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mmultiscripts
                      %mi f
                      %mprescripts
                      %none
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \multiscripts{^*}f{}
              is
              = succeed "." do
                %span.newWikiWord
                  microcontinuous
                  %a{:href => "/nlab/new/microcontinuous+function"} ?
          %h3#further_variants Further variants
          %p
            A function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            between
            %a.existingWikiWord{:href => "/nlab/show/convergence+spaces"} convergence spaces
            is
            %strong continuous
            if for any
            %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \to x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(F) \to f(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(F)
            is the filter generated by the filterbase
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{F(A) \;|\; A \in F\}
          %p
            A
            %strong continuous map
            between
            %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            is simply a
            %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            in the opposite direction. Equivalently (via the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            %a.existingWikiWord{:href => "/nlab/show/inflattices"} inflattices
            whose
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            preserves finitary
            %a.existingWikiWord{:href => "/nlab/show/meets"} meets
            (and hence is a frame homomorphism).
          %h2#properties Properties
          %p
            Since continuity is defined in terms of
            %em preservation of property
            (namely preserving “openness” under preimages), it is natural to ask what other properties they preserve.
            %br>/
            Also, when a property is not always preserved it is useful to label those maps which do preserve it for closer study.
          %h3#properties_preserved Properties preserved
          %p
          #PropertiesPreservedByAContinuousFunction.num_prop
            %h6 Proposition
            %p
            %p
              Under a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  is open;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                  is closed;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected subset
                  is again connected;
              %li
                %p
                  theimage of a
                  %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact subset
                  is again compact (see at
                  = succeed ")." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
            %p
          %h3#special_maps Special maps
          %ol
            %li
              %p
                The preimage of a compact set need not be compact; a continuous map for which this is true is known as a
                = succeed "." do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
            %li
              %p
                The image of an open set need not be open; a continuous map for which this is true is said to be an
                = succeed "." do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                with just this property.)
            %li
              %p
                The image of an closed set need not be closed; a continuous map for which this is true is said to be an
                = succeed "." do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
            %li
              %p
                A continuous map of topological spaces which is invertible as a function of sets is a
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                if the
                %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
                is a continuous map as well.
          %h3#special_cases_in_specific_contexts Special cases in specific contexts
          %p
            Although these don’t make sense for arbitrary topological spaces (convergence spaces, locales, etc), they are special kinds of continuous maps in contexts such as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous+maps"}> uniformly continuous maps
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lipschitz+maps"}> Lipschitz maps
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/short+maps"}> short maps
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/differentiable+maps"}> differentiable maps
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/smooth+maps"}> smooth maps
              \.
          %h2#in_constructive_mathematics In constructive mathematics
          %p
            Various notions of continuous function are used in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (say
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
          %ul
            %li
              %em pointwise-continuous
              if it
              %a.existingWikiWord{:href => "/nlab/show/pointwise+continuous+function"} pointwise continuous
              in the usual
              %a.existingWikiWord{:href => "/nlab/show/epsilon-delta"} epsilon-delta
              (or equivalently
              = succeed ")" do
                %span.newWikiWord
                  open-subset
                  %a{:href => "/nlab/new/open-subset"} ?
            %li
              %em uniformly continuous
              if it
              %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous+map"} uniformly continuous
              in the usual epsilon-delta (or equivalently
              = succeed "-theoretic)" do
                %a.existingWikiWord{:href => "/nlab/show/entourage"} entourage
            %li
              %em Bishop-continuous
              or
              %em locally uniformly continuous
              if it is pointwise continuous and furthermore, the restriction to any closed and bounded interval is uniformly continuous;
            %li
              %em Bridges-continuous
              if … (this one's kind of complicated).
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+mathematics"} intuitionistic mathematics
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fan+theorem"} fan theorem
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Russian+constructivism"} Russian constructivism
          %p
            In fact, assuming that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is defined as the set of located
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+cuts"} Dedekind cuts
            %a.existingWikiWord{:href => "/nlab/show/Franka+Waaldijk"} Franka Waaldijk
            (
            %a{:href => "#Waaldijk2005"}> Waaldijk2005
            ): Without the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fan+theorem"} fan theorem
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          %ul
            %li
              A function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [0,1] \to \mathbb{R}
              is kontinuous if and only if it is
              %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous"} uniformly continuous
              in the usual sense.
            %li The composition of kontinuous functions is kontinuous.
            %li
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mo +
                    %mo →
                    %mi ℝ
                    %mo ,
                    %mi x
                    %mo ↦
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^+ \to \mathbb{R}, x \mapsto 1/x
              is kontinuous.
          %p
            The key problem is that a uniformly continuous,
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,1]
            might fail to be bounded below by a positive number, since the interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,1]
            might fail to be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
          %p
            Waaldijk’s negative result can be circumvented by dropping the insistence on points and instead working with maps between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+topology"} formal topology
