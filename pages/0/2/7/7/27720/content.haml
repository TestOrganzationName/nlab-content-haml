                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} lem
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} toBool
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi q
                      %mo :
                      %mi A
                      %mo ∨
                      %mo ¬
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash p:\mathrm{isProp}(A) \quad \Gamma \vdash q:A \vee \neg A}{\Gamma \vdash \mathrm{lem}(\mathrm{toBool}_A(p)(q)) \equiv q:A \vee \neg A}
          %p Uniqueness rules for the type of booleans:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} toBool
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} proptrunc
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} lem
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Bool}}{\Gamma \vdash \mathrm{toBool}_{A}(\mathrm{proptrunc}(A))(\mathrm{lem}(A)) \equiv A:\mathrm{Bool}}
          %p Extensionality principle for the type of booleans:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ext
                        %mi{:mathvariant => "normal"} Bool
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} idToEquiv
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:\mathrm{Bool} \quad \Gamma \vdash B:\mathrm{Bool}} {\Gamma \vdash \mathrm{ext}_\mathrm{Bool}(A, B):\mathrm{isEquiv}(\mathrm{idToEquiv}(A, B))}
          %h3#as_the_0sphere_type As the 0-sphere type
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pushout+types"} pushout types
            %a.existingWikiWord{:href => "/nlab/show/sphere+type"} sphere type
            of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
            and as such as the beginning of the
            = succeed "-tower" do
              %a.existingWikiWord{:href => "/nlab/show/suspension+type"} suspension type
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sphere+types"} sphere types
          %center
            %img{:src => "/nlab/files/HigherHomotopyBits-230106.jpg", :width => "450"}/
          %p
            %br/
          %h2#properties Properties
          %h3#descent_and_large_recursion Descent and large recursion
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            for the type of booleans states that given any types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            one can construct a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi 𝟚
                  %mo ⊢
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:\mathbb{2} \vdash \mathrm{descFam}_\mathbb{2}^{A, B}(x)
            with
            %a.existingWikiWord{:href => "/nlab/show/equivalences+of+types"} equivalences of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} descEquiv
                    %mi A
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi A
                  %mspace{:width => "1em"}
                  %mi{:mathvariant => "normal"} and
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} descEquiv
                    %mi B
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{descEquiv}_A:\mathrm{descFam}_\mathbb{2}^{A, B}(0) \simeq A \quad \mathrm{and} \quad \mathrm{descEquiv}_B:\mathrm{descFam}_\mathbb{2}^{A, B}(1) \simeq B
          %p
            Large recursion for the type of booleans strengthens the equivalences of types in descent to
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality+of+types"} judgmental equality of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi A
                  %mspace{:width => "1em"}
                  %mi{:mathvariant => "normal"} and
                  %mspace{:width => "1em"}
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{descFam}_\mathbb{2}^{A, B}(0) \equiv A \quad \mathrm{and} \quad \mathrm{descFam}_\mathbb{2}^{A, B}(1) \equiv B
          %p
            If one is working in a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory+with+type+variables"} dependent type theory with type variables
            which has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type#IdentityTypesBetweenTypes"} identity types between types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} descId
                    %mi A
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi A
                  %mspace{:width => "1em"}
                  %mi{:mathvariant => "normal"} and
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} descId
                    %mi B
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mi 𝟚
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{descId}_A:\mathrm{descFam}_\mathbb{2}^{A, B}(0) = A \quad \mathrm{and} \quad \mathrm{descId}_B:\mathrm{descFam}_\mathbb{2}^{A, B}(1) = B
          %h3#extensionality_principle_of_the_type_of_booleans Extensionality principle of the type of booleans
          %p
            The elements of the type of booleans represent certain truth values or propositions, namely,
            %a.existingWikiWord{:href => "/nlab/show/true"} true
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/false"} false
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositions+as+some+types"} propositions as some types
            %a.existingWikiWord{:href => "/nlab/show/true"} true
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            %a.existingWikiWord{:href => "/nlab/show/false"} false
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟘
                  %annotation{:encoding => "application/x-tex"} \mathbb{0}
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            through the following type family:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi{:mathvariant => "normal"} Bool
                  %mo ⊢
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} Bool
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} Bool
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:\mathrm{Bool} \vdash \mathrm{El}(x) \coloneqq (x =_\mathrm{Bool} 1) \times \neg (x =_\mathrm{Bool} 0)
          %p
            The extensionality principle of the type of booleans is then given by the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                      %mo ,
                      %mi y
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                      %mo ⊢
                      %mi{:mathvariant => "normal"} ua
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi{:mathvariant => "normal"} Bool
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi{:mathvariant => "normal"} El
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma, x:\mathrm{Bool}, y:\mathrm{Bool} \vdash \mathrm{ua}(x, y):\mathrm{Id}_\mathrm{Bool}(x, y) \simeq (\mathrm{El}(x) \simeq \mathrm{El}(y))}
          %p
            Since the empty type is not equivalent to the unit type, this automatically implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is not equal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a{:href => "#Sattler23"} Sattler 2023
            for a proof.
          %h3#relation_to_sum_types Relation to sum types
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/sum+types"} sum types
            can be defined in terms of the type of booleans and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo +
                  %mi B
                %annotation{:encoding => "application/x-tex"} A + B
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo +
                  %mi B
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} Bool
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} Bool
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A + B \coloneqq \sum_{x:\mathrm{Bool}} ((x =_\mathrm{Bool} 1) \to A) \times ((x =_\mathrm{Bool} 0) \to B)
          %h3#boolean_logic Boolean logic
          %p
            One could recursively define the logical functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            as follows
          %ul
            %li
              For negation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mn 0
                        %mo :
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \neg 0 := 1
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mn 1
                        %mo :
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \neg 1 := 0
            %li
              For conjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ∧
                        %mi a
                        %mo :
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0 \wedge a := 0
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∧
                        %mi a
                        %mo :
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} 1 \wedge a := a
            %li
              For disjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                  %annotation{:encoding => "application/x-tex"} \vee
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ∨
                        %mi a
                        %mo :
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} 0 \vee a := a
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∨
                        %mi a
                        %mo :
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1 \vee a := 1
            %li
              For implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \implies
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ⇒
                        %mi a
                        %mo :
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 0 \implies a := 1
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⇒
                        %mi a
                        %mo :
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} 1 \implies a := a
            %li
              For the biconditional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇔
                  %annotation{:encoding => "application/x-tex"} \iff
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ⇔
                        %mi a
                        %mo :
                        %mo =
                        %mo ¬
                        %mi a
                      %annotation{:encoding => "application/x-tex"} 0 \iff a := \neg a
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⇔
                        %mi a
                        %mo :
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} 1 \iff a := a
          %p
            One could prove that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Bool
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mo ¬
                  %mo ,
                  %mo ∧
                  %mo ,
                  %mo ∨
                  %mo ,
                  %mo ⇒
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{Bool}, 0, 1, \neg, \wedge, \vee, \implies)
            form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            structure is given by implication.
          %p
            One could also inductively define
            %a.existingWikiWord{:href => "/nlab/show/observational+equality"} observational equality
            on the booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Eq
                    %mi{:mathvariant => "normal"} Bool
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Eq}_\mathrm{Bool}(x, y)
            as an indexed inductive type on the boolean type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            with the following constructors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} eq
                    %mn 0
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Eq
                    %mi 𝟚
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{eq}_0: \mathrm{Eq}_\mathbb{2}(0, 0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} eq
                    %mn 1
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Eq
                    %mi 𝟚
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{eq}_1: \mathrm{Eq}_\mathbb{2}(1, 1)
          %p
            A
            %em boolean predicate
            valued in a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi T
                    %mo →
                    %mi{:mathvariant => "normal"} Bool
                  %annotation{:encoding => "application/x-tex"} P: T \rightarrow \mathrm{Bool}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} T \to \mathrm{Bool}
            is a boolean
            %a.existingWikiWord{:href => "/nlab/show/function+algebra"} function algebra
            for finite types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/path+types"} path types
            exist, for all types
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi U
                    %mo →
                    %mi BoolAlg
                  %annotation{:encoding => "application/x-tex"} F: U \to BoolAlg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi T
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} F(T) = T \to \mathrm{Bool}
            for a
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Boolean+hyperdoctrine"} Boolean hyperdoctrine
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
            %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
            inside
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            and path types exist in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            In fact, just with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/two-valued+logic"} two-valued logic
            could be done inside
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/disjoint+coproducts"} disjoint coproducts
            exist when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            exists, all finite types exist in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %span.newWikiWord
                finitely-valued logic
                %a{:href => "/nlab/new/finitely-valued+logic"} ?
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of a
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            %a.existingWikiWord{:href => "/nlab/show/cartesian+power"} cartesian power
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p For finite types, one could also inductively define specific functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi A
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \forall a \in A.(-)(a):(A \to \mathrm{Bool}) \to \mathrm{Bool}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi a
                  %mo ∈
                  %mi A
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \exists a \in A.(-)(a):(A \to \mathbf{2}) \to \mathrm{Bool}
          %p
            from the type of boolean predicates on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            such that they behave like
            %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+quantification"} universal quantification
          %h3#other_properties Other properties
          %ul
            %li
              %p
                The type of booleans is the
                %a.existingWikiWord{:href => "/nlab/show/suspension+type"} suspension type
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            %li
              %p
                The type of booleans is
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalent"} homotopy equivalent
                to the type of
                %a.existingWikiWord{:href => "/nlab/show/decidable+propositions"} decidable propositions
                in a universe
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒰
                      %annotation{:encoding => "application/x-tex"} \mathcal{U}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi P
                      %mo :
                      %mi 𝒰
                  %mi isProp
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi isDecidable
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool} \cong \sum_{P:\mathcal{U}} isProp(P) \times isDecidable(P)
          %p
            As a result, sometimes the type of booleans is called a
            = succeed "." do
              %strong decidable subtype classifier
          %h2#related_concepts  Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of propositions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
          %h2#references References
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            as a simple example of an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Per+Martin-L%C3%B6f"} Per Martin-Löf
              (notes by
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Giovanni+Sambin"} Giovanni Sambin
              %a{:href => "https://ncatlab.org/nlab/files/MartinLofIntuitionisticTypeTheory.pdf#page=43"} p. 37
              of
              = succeed "," do
                %em Intuitionistic type theory
              = succeed "," do
                %a{:href => "https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/MartinLofIntuitionisticTypeTheory.pdf", :title => "pdf"} pdf
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#AwodeyGambinoSojakova
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"}> Steve Awodey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicola+Gambino"} Nicola Gambino
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kristina+Sojakova"} Kristina Sojakova
                = succeed "," do
                  %em Inductive types in homotopy type theory
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1201.3898"} arXiv:1201.3898
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1109/LICS.2012.21"} doi:10.1109/LICS.2012.21
            %li
              %p
                Univalent Foundations Project,
                %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} Homotopy Type Theory – Univalent Foundations of Mathematics
                (2013)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
                , Exc. 4.2 (pp. 35) in:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Homotopy+Type+Theory"} Introduction to Homotopy Type Theory
                (2023) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2212.11082"}> arXiv:2212.11082
                \&amp;rbrack;
          %p …
          %ul
            %li#LumsdaineShulman16
              %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"}> Peter LeFanu Lumsdaine
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
              = succeed "," do
                %em Abstracting away from cell complexes
              = succeed "&rbrack;" do
                %a{:href => "http://home.sandiego.edu/~shulman/papers/cellcxs.pdf"} pdf
          %p Large recursion and descent of the type of booleans can be found in
          %ul
            %li#Sattler23
              %a.existingWikiWord{:href => "/nlab/show/Christian+Sattler"}> Christian Sattler
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+W%C3%A4rn"} David Wärn
              = succeed "," do
                %em Natural numbers from integers
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/2405.18388"} arXiv:2405.18388
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1145/3661814.3662129"} doi:10.1145/3661814.3662129
        .revisedby
