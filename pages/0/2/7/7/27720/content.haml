              %strong dependent universal property of the type of booleans
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
