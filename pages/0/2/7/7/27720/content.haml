                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} typerec
                        %mi{:mathvariant => "normal"} Bool
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
