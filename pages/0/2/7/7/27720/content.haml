                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type}}{\Gamma \vdash \beta_{\mathrm{Bool}}^{1, A, B}:\mathrm{typerec}_{\mathrm{Bool}}^{A, B}(1) \simeq B}
          %h3#as_the_type_of_decidable_propositions As the type of decidable propositions
          %p
            The
            %strong type of booleans
            can also be defined as the
            = succeed "," do
              %em
                type of all
                %a.existingWikiWord{:href => "/nlab/show/decidable+propositions"} decidable propositions
            %a.existingWikiWord{:href => "/nlab/show/disjunctions"} disjunctions
            and the
            %a.existingWikiWord{:href => "/nlab/show/negations"} negations
            defined in the type theory:
          %ul
            %li
              %p
                using the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/decidable+propositions"} decidable propositions
            %li
              %p
                as a homotopy-
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                univalent type family of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/decidable+propositions"} decidable propositions
            %li
              %p
                as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
                that mimic that of the
                %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi P
                          %mo :
                          %mi U
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi{:mathvariant => "normal"} isDecidable
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sum_{P:U} \mathrm{isProp}(P) \times \mathrm{isDecidable}(P)
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi P
                          %mo :
                          %mi U
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi{:mathvariant => "normal"} isDecidable
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sum_{P:U} \mathrm{isProp}(T(P)) \times \mathrm{isDecidable}(T(P))
                respectively, but for all types, not just the
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
          %h4#using_the_type_of_all_propositions Using the type of all propositions
          %p
            Suppose that we have a
            %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of propositions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
            %strong type of booleans
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %mi P
                  %mo ∨
                  %mo ¬
                  %mi P
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool} \equiv \sum_{P:\mathrm{Prop}} P \vee \neg P
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \vee B
            is the
            %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            of two types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi A
                  %mo ≡
                  %mi A
                  %mo →
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \neg A \equiv A \to \emptyset
            is the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of the type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+function+types"} dependent function types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
          %h4#as_a_homotopyterminal_type As a homotopy-terminal type
          %p
            A
            %strong univalent family of decidable propositions
            consists of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} (B(x))_{x:A}
            such that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(x)
                is a
                %a.existingWikiWord{:href => "/nlab/show/decidable+proposition"} decidable proposition
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x:A
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/transport"} transport
                function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi{:mathvariant => "normal"} tr
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{tr}^B(x, y):x =_A y \to (B(x) \simeq B(y))
              %p
                is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
          %p
            A morphism of univalent families of decidable propositions between univalent families of decidable propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, B)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi B
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A', B')
            consists of a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f_A:A \to A'
            and a family of functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_B(x):B(x) \to B'(f_A(x))
          %p
            The
            %strong type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Bool
                  %mo ,
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{Bool}, \mathrm{El})
            is the homotopy-terminal univalent family of decidable propositions: given any other univalent family of decidable propositions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, B)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} u_A:A \to \mathrm{Bool}
            and a unique family of functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi A
