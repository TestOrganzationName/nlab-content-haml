          %h2#idea  Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %h2#definition Definition
          %p
            The
            = succeed "," do
              %strong type of booleans
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Bool
                  %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟚
                  %annotation{:encoding => "application/x-tex"} \mathbb{2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            in many different ways:
          %ul
            %li
              %p
                as a
                %a.existingWikiWord{:href => "/nlab/show/positive+type"} positive
                %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
                representing the homotopy-
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
                type with two elements.
            %li
              %p
                as the type of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/decidable+propositions"} decidable propositions
            %li
              %p
                as the 0-sphere type, the
                %a.existingWikiWord{:href => "/nlab/show/suspension+type"} suspension type
                of the
                %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
          %h3#as_an_inductive_type As an inductive type
          %p
            Assuming that
            %a.existingWikiWord{:href => "/nlab/show/identification+types"} identification types
            and
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            exist in the type theory, the type of booleans is the
            %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
            generated by two elements, and is defined by the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/type+formation+rules"} type formation rules
            for the type of booleans
