          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/first-order+structure"} model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            of a (not necessarily complete)
            %a.existingWikiWord{:href => "/nlab/show/first-order+theory"} first-order theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Diag
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_{\mathsf{Diag}(M)}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi EDiag
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
