                %semantics
                  %mrow
                    %mi ℒ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}(M)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            models
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi EDiag
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{EDiag}(M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            contains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            as an elementary substructure. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            models
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Diag
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Diag}(M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            contains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            as an induced substructure.
          %p
            If we are given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            as above, we simply obtain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Diag
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_{\mathsf{Diag}(M)}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi EDiag
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_{\mathsf{EDiag}(M)}
            as the union of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (viewed as an
            = succeed "-theory)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}(M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Diag
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Diag}(M)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi EDiag
                    %mo{:stretchy => "false"} (
