                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                while ensuring it no longer satisfies the almost-sure theory of finite graphs. (For example, we could add a new vertex and connect it to all the vertices from
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
          %h2#remarks Remarks
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                    %mo =
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T' = T_{\mathsf{Diag}(M)}
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi EDiag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_{\mathsf{EDiag}(M)}
              there is an obvious interpretation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T \to T'
              which induces for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ⊧
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} N \models T'
              a map of automorphism groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                        %mrow
                          %mi ℒ
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                        %mi ℒ
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \operatorname{Aut}_{\mathcal{L}(M)}(N) \to \operatorname{Aut}_{\mathcal{L}}(N)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                    %mi ℒ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} /
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                    %mi ℒ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\operatorname{Aut}_{\mathcal{L}}(N/M) \hookrightarrow \operatorname{Aut}_{\mathcal{L}}(N)
          %p
            of the pointwise
            %a.existingWikiWord{:href => "/nlab/show/stabilizer"} stabilizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            into the full automorphism group of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
          %ul
            %li
              %p
                To add a distinct constant symbol to a theory is to adjoin a new
                %a.existingWikiWord{:href => "/nlab/show/global+point"} global point
                to its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type+%28in+model+theory%29"} type
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
                of subobjects above it. When we pass to the quantifier-free diagram of a model, we specify constants named after the model up to quantifier-free types, and when we pass to the elementary diagram of a model, we specify constants named after the model up to complete types.
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/first-order+theory"} first-order theory
                T
                %a.existingWikiWord{:href => "/nlab/show/quantifier+elimination"} eliminates quantifiers
                if and only if it is “substructure-complete”: given any model
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                and any
                %em substructure
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ⊆
                        %mi M
                      %annotation{:encoding => "application/x-tex"} N \subseteq M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi Diag
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{\mathsf{Diag}(N)}
                is complete.
          .num_remark
            %h6#remark Remark
            %p
              The process of passing from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_{\mathsf{Diag}(M)}
              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi EDiag
                    %annotation{:encoding => "application/x-tex"} \mathsf{EDiag}
              %a.existingWikiWord{:href => "/nlab/show/functorial"} functorial
              in the way you would expect the process of passing from a category of models to a co-slice category of models to be on corepresenting objects.
            %p
              That is (now
              %a.existingWikiWord{:href => "/nlab/show/elimination+of+imaginaries"} eliminating imaginaries
              and working with the
              %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completions
              of
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T'
              is an
              = succeed "-theory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is an
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is an
              = succeed "-theory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T'
              via an interpretation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mover
                        %mo →
                        %mi F
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T \overset{F}{\to} T'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi F
                          %mo *
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T'_{\mathsf{Diag}(F^*M)} \to T_{\mathsf{Diag}(M)}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi EDiag
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi F
                          %mo *
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi EDiag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} T'_{\mathsf{EDiag}(F^*M)} \to T_{\mathsf{EDiag}(M)}.
          .proof
            %h6#proof Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/interpretation"} interpretation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              induces a “taking reducts” functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mover
                      %mo =
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} df
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi Pretop
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} F^* \overset{\operatorname{df}}{=} \mathbf{Mod}(F) = \mathbf{Pretop}(F, \mathbf{Set}) : \mathbf{Mod}(T) \to \mathbf{Mod}(T').
            %p
              We restrict
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
              to the full subcategory consisting of those models of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              embedding (resp. elementarily embedding) the structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/elementary+class"} elementary classes
              %a.existingWikiWord{:href => "/nlab/show/ultracategory"} ultracategories
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Mod}(T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
              are ultrafunctors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi F
                          %mo *
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{\mathbf{Mod}}(T_{\mathsf{Diag}(M)}) \to  \underline{\mathbf{Mod}}(T'_{\mathsf{Diag}(F^*M)})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi EDiag
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi EDiag
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi F
                          %mo *
                        %mi M
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{\mathbf{Mod}}(T_{\mathsf{EDiag}(M)}) \to \underline{\mathbf{Mod}}(T'_{\mathsf{EDiag}(F^*M)})
            %p
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
              already was, and so by Makkai’s
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+conceptual+completeness"} strong conceptual completeness
            %p
              (That the latter functor is well-defined just follows from the fact that specifying an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} c \in \mathbf{C}
              and a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} G : \mathbf{C} \to \mathbf{D}
              naturally induces a functor on the
              %a.existingWikiWord{:href => "/nlab/show/co-slice+category"} co-slice categories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                    %annotation{:encoding => "application/x-tex"} c/\mathbf{C} \to G(c)/\mathbf{D}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/first-order+structure"} first-order structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/first-order+theory"} first-order theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quantifier+elimination"} quantifier elimination
            %li
              %p
                For the
                %a.existingWikiWord{:href => "/nlab/show/property"} property
                of a theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi Diag
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{\mathsf{Diag}(A)}
                is complete for all substructures
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/substructure+completeness"} substructure completeness
            %li
              %p
                For the
                %a.existingWikiWord{:href => "/nlab/show/property"} property
                of a theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi EDiag
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{\mathsf{EDiag}(M)}
                is complete for all models
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/model+completeness"} model completeness
