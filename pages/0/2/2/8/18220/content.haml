                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                be the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/countable+random+graph"} countable random graph
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/omega-categorical+structure"} omega-categorical structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi EDiag
