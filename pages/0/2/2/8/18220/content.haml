                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{EDiag}(M)
          %h2#examples Examples
          %ul
            %li
              %p
                A trivial example is
                %a.existingWikiWord{:href => "/nlab/show/ACF"} ACF
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} _0
                %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed fields
                of characteristic zero (in the language of rings). Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                is the prime field of characteristic zero, any algebraically closed field models
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Diag
