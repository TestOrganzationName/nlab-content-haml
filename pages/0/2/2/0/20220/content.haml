          %ul
            %li#Sethi07
              %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
              , around (2) in
              = succeed "," do
                %em A Note on Heterotic Dualities via M-theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0707.0295"} arXiv:0707.0295
          %p
            Application in
            %a.existingWikiWord{:href => "/nlab/show/string+phenomenology"} string phenomenology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mirjam+Cvetic"}> Mirjam Cvetic
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/James+Halverson"} James Halverson
