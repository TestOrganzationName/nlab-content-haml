            %p
              Hence it is now sufficient to show that the first two summands on the right of
              %a.maruku-eqref{:href => "#eq:ExpressingDasgupteMukhInTildeG4"} (4)
              are both
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mn 3
                      %mo ×
                      %mi K
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} K3 \times K3
            %p But we have
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} [
                        %mi K
                        %mn 3
                        %mo ×
                        %mi K
                        %mn 3
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mn 24
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \chi[K3\times K3] \;=\; 24^2
                  (by
                  = succeed ")" do
                    %a{:href => "K3+surface#EulerCharacteristicOfK3TimesK3"} this Prop.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} [
                        %mi K
                        %mn 3
                        %mo ×
                        %mi K
                        %mn 3
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mn 2
                        %mo ×
                        %mn 48
                      %annotation{:encoding => "application/x-tex"} p_1[K3 \times K3] \;=\; - 2 \times 48
                  (by
                  = succeed ")" do
                    %a{:href => "K3+surface#FirstPontryaginClassOfK3TimesK3"} this Prop.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 24
                            %mi χ
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mn 3
                            %mo ×
                            %mi K
                            %mn 3
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 24
                            %msup
                              %mn 24
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 24
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tfrac{1}{24}\chi[K3 \times K3]
                    \&amp; = \tfrac{1}{24} 24^2
                    \\\
                    \&amp; = 24 \;\in\; \mathbb{Z}
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 32
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi p
                              %mn 1
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mn 3
                            %mo ×
                            %mi K
                            %mn 3
                            %mo{:stretchy => "false"} ]
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 32
                            %mo ×
                            %mo{:stretchy => "false"} (
                            %munder
                              %munder
                                %mrow
                                  %mn 2
                                  %mo ×
                                  %mn 48
                                %mo ⏟
                              %mpadded{:lspace => "-50%width", :width => "0"}
                                %mrow
                                  %mo =
                                  %mn 3
                                  %mo ×
                                  %mn 32
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 9
                            %mo ×
                            %mn 32
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tfrac{1}{32} (p_1[K3 \times K3])^2
                    \&amp; =
                    \\tfrac{1}{32} \times
                    (
                    \\underset{
                    \\mathclap{
                    \= 3 \times 32
                    }
                    }
                    {
                    \\underbrace{ 2 \times 48}
                    }
                    )^2
                    \\\
                    \&amp; =
                    9 \times 32
                    \\;\in\;
                    \\mathbb{Z}
                    \\end{aligned}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/RR-field+tadpole+cancellation"} RR-field tadpole cancellation
                in
                %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/shifted+C-field+flux+quantization"} shifted C-field flux quantization
                in
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/24+branes+transverse+to+K3"} 24 branes transverse to K3
                in
                %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
                and
                %a.existingWikiWord{:href => "/nlab/show/HET-theory"} HET-theory
          %h2#References References
          %p The C-field tadpole cancellation condition is claimed in
          %ul
            %li#SethiVafaWitten96
              %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em Constraints on Low-Dimensional String Compactifications
              %strong 480
              (1996) 213-224 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9606122"}> arXiv:hep-th/9606122
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0550-3213(96)00483-X"} doi:10.1016/S0550-3213(96)00483-X
          %p referring for proof to the computation in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em A One-Loop Test Of String Duality
              %strong 480
              (1996) 213-224 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9505053"}> arxiv:hep-th/9505053
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/0550-3213(95)00280-6"} doi:10.1016/0550-3213(95)00280-6
          %p A comment is also in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              , p. 3 of
              = succeed "," do
                %em On Flux Quantization In M-Theory And The Effective Action
              %strong 22
              (1997) 1-13 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9609122"}> arXiv:hep-th/9609122
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0393-0440(96)00042-3"} doi:10.1016/S0393-0440(96)00042-3
          %p Another condition appears in
          %ul
            %li#BeckerBecker96
              %a.existingWikiWord{:href => "/nlab/show/Katrin+Becker"}> Katrin Becker
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Melanie+Becker"} Melanie Becker
              = succeed "," do
                %em M-Theory on Eight-Manifolds
              %strong 477
              (1996) 155-167 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9605053"}> arXiv:hep-th/9605053
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/0550-3213(96)00367-7"} doi:10.1016/0550-3213(96)00367-7
          %p
            The formulas of
            %a{:href => "#SethiVafaWitten96"} Sethi-Vafa-Witten 96
            and
            %a{:href => "#BeckerBecker96"} Becker-Becker 96
            have been plugged together in
          %ul
            %li#DasguptaMukhi97
              Keshav Dasgupta,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sunil+Mukhi"} Sunil Mukhi
              = succeed "," do
                %em A Note on Low-Dimensional String Compactifications
              %strong 398
              (1997) 285-290 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9612188"}> arXiv:hep-th/9612188
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0370-2693(97)00216-5"} doi:10.1016/S0370-2693(97)00216-5
          %p Further discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em CFT’s From Calabi-Yau Four-folds
                %strong 584
                (2000) 69-108, Erratum-ibid.
                %strong 608
                (2001) 477-478 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9906070"}> arXiv:hep-th/9906070
                \&amp;rbrack;
            %li
              %p
                Keshav Dasgupta, Govindan Rajesh,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"} Savdeep Sethi
                = succeed "," do
                  %em M Theory, Orientifolds and G-Flux
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9908088"} arXiv:hep-th/9908088
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/1999/08/023"} doi:10.1088/1126-6708/1999/08/023
          %p Lecture notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Timo+Weigand"}> Timo Weigand
              , p. 86 of
              %em TASI Lectures on F-theory
              (
              %a{:href => "https://arxiv.org/abs/1806.01854"}> arXiv:1806.01854
              )
          %p
            Application in
            = succeed ":" do
