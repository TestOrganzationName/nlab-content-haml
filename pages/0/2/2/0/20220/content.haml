                    \\end{aligned}
            %p
              where the summand over the brace is an integral class (by
              = succeed ")," do
                %a{:href => "Wu+class#DivisibilityOfCupSquare"} this Corollary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mn 3
