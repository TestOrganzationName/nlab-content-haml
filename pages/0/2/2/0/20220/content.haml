                              %mi p
                              %mn 1
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mn 2
                            %mo −
                            %munder
                              %munder
                                %mrow
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %mn 2
                                  %msub
                                    %mover
                                      %mi G
                                      %mo ˜
                                    %mn 4
                                  %mo ⋅
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %msub
                                    %mover
