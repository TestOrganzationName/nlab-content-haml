                                %mo ∈
                                %mi ℤ
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp;
                    \\tfrac{1}{24}\chi
                    \-
                    \\tfrac{1}{2} \big( G_4\big)^2
                    \\\
                    \&amp; =
                    \\tfrac{1}{24}\chi
                    \-
                    \\tfrac{1}{2}\big( \tfrac{1}{4} p_1 \big)^2
                    \-
                    \\underset{
                    \\in \mathbb{Z}
                    }{
                    \\underbrace{
                    \\tfrac{1}{2}
                    \\widetilde G_4 \cdot \big( \widetilde G_4 - \tfrac{1}{2}p_1\big)
                    }
                    }
