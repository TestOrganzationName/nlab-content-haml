                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒩
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{N}=(3,0)
                    from
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 3
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} timesS
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} S^3 \timesS^3
                    fibrations
                %a{:href => "https://arxiv.org/abs/1912.10509"} arXiv:1912.10509
          %div
            %h3#CSWilsonLinesInAdS3
              Wilson lines computing holographic entropy in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi AdS
                      %mn 3
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi CFT
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} AdS_3/CFT_2
            %p
              Discussion of
              %a.existingWikiWord{:href => "/nlab/show/BTZ+black+hole"} BTZ
              %a.existingWikiWord{:href => "/nlab/show/black+hole+entropy"} black hole entropy
              and more generally of
              %a.existingWikiWord{:href => "/nlab/show/holographic+entanglement+entropy"} holographic entanglement entropy
              in
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/3d+quantum+gravity"} 3d quantum gravity
              %a.existingWikiWord{:href => "/nlab/show/AdS3%2FCFT2"} AdS3/CFT2
              via
              %a.existingWikiWord{:href => "/nlab/show/Wilson+line+observables"} Wilson line observables
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %ul
              %li
                %p
                  Martin Ammon, Alejandra Castro, Nabil Iqbal,
                  = succeed "," do
                    %em Wilson Lines and Entanglement Entropy in Higher Spin Gravity
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/1306.4338"} arXiv:1306.4338
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jan+de+Boer"}> Jan de Boer
                  , Juan I. Jottar,
                  = succeed "," do
                    %em
                      Entanglement Entropy and Higher Spin Holography in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi AdS
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} AdS_3
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/1306.4347"} arXiv:1306.4347
              %li
                %p
                  Alejandra Castro, Stephane Detournay, Nabil Iqbal,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Eric+Perlmutter"} Eric Perlmutter
                  = succeed "," do
                    %em Holographic entanglement entropy and gravitational anomalies
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/1405.2792"} arXiv:1405.2792
              %li
                %p
                  Mert Besken, Ashwin Hegde, Eliot Hijano,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Per+Kraus"} Per Kraus
                  = succeed "," do
                    %em Holographic conformal blocks from interacting Wilson lines
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/1603.07317"} arXiv:1603.07317
              %li
                %p
                  Andreas Blommaert, Thomas G. Mertens, Henri Verschelde,
                  = succeed "," do
                    %em The Schwarzian Theory - A Wilson Line Perspective
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/1806.07765"} arXiv:1806.07765
              %li
                %p
                  Ashwin Dushyantha Hegde,
                  = succeed "," do
                    %em Role of Wilson Lines in 3D Quantum Gravity
                  = succeed ")" do
                    %a{:href => "http://inspirehep.net/record/1763572"} spire:1763572
              %li
                %p
                  Xing Huang, Chen-Te Ma, Hongfei Shu,
                  %em
                    Quantum Correction of the Wilson Line and Entanglement Entropy in the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} AdS_3
                    Chern-Simons Gravity Theory
                  (
                  %a{:href => "https://arxiv.org/abs/1911.03841"}> arXiv:1911.03841
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Eric+D%27Hoker"}> Eric D'Hoker
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Per+Kraus"} Per Kraus
                  %em
                    Gravitational Wilson lines in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} AdS_3
                  (
                  %a{:href => "https://arxiv.org/abs/1912.02750"}> arXiv:1912.02750
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"}> Marc Henneaux
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Wout+Merbis"} Wout Merbis
                  %em
                    Asymptotic dynamics of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} AdS_3
                    gravity with two asymptotic regions
                  (
                  %a{:href => "https://arxiv.org/abs/1912.09465"}> arXiv:1912.09465
                  )
            %p and similarly for 3d flat-space holography:
            %ul
              %li
                %p
                  Arjun Bagchi, Rudranil Basu, Daniel Grumiller,
