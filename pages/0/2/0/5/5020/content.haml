            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-epimorphism"} n-epimorphism
          %h2#definition Definition
          %p
          #EpimorphismInAnInfinityCategory.num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %strong epimorphism
              if for all
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
              the induced morphism on
              %a.existingWikiWord{:href => "/nlab/show/hom+infinity-groupoids"}
                hom
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(f,A)
                    \\,\colon\,
                    \\mathcal{C}(Y,A)
                    \\xhookrightarrow{\;\;}
                    \\mathcal{C}(X,A)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28%E2%88%9E%2C1%29-category"} monomorphism in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %h2#Examples Examples
          %p
          #TerminalEpimorphismsInInfinityGroupoids.num_remark
            %h6 Example
            %p
              %strong
                (terminal epimorphisms of
                = succeed "-groupoids)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \,\in\,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Grpd
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} Grpd_\infty
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28infinity%2C1%29-category"} terminal map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \to \ast
              is an epimorphism in the sense of Def.
              %a.maruku-ref{:href => "#EpimorphismInAnInfinityCategory"}
              then
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒳
                      %annotation{:encoding => "application/x-tex"} \mathcal{X}
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/connected+homotopy+type"} connected
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+group"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi 𝒳
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_1(\mathcal{X})
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/perfect+group"} perfect
            %p
              (
              %a{:href => "#Hoyois19"}> Hoyois 2019, Lem. 3
              )
            %p
              In particular, this means that in order for the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              of a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(G,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \ast
              is epi, the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              must be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perfect+group"} perfect
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (terminal epimorphisms of 1-groupoids)
              In contrast to Ex.
              = succeed "," do
                %a.maruku-ref{:href => "#TerminalEpimorphismsInInfinityGroupoids"}
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %a.existingWikiWord{:href => "/nlab/show/Grpd"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Grpd
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Grpd_1
              of
              %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              the maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mover
                      %mo →
                      %mrow
                        %mi Map
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi G
                        %mo →
                        %mo *
                        %mo ,
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{X}
                    \\xrightarrow{Map(B G \to \ast, \mathcal{X})}
                    Map(B G, \mathcal{X})
            %p
              are always
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo ∈
                      %msub
                        %mi Grpd
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{X} \in Grpd_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ≃
                    %mi B
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \simeq B K
              (to which the general situation reduces by
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensivity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi B
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi c
                        %mo ∈
                        %msubsup
                          %mi H
                          %mi Grp
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mi K
                        %mo{:stretchy => "false"} )
                    %mi B
                    %msub
                      %mi Stab
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo ⊔
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi c
                            %mo ∈
                            %msubsup
                              %mi H
                              %mi Grp
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo ,
                            %mi K
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi c
                            %mo ≠
                            %mn 1
                    %mi B
                    %msub
                      %mi Stab
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Map(B G, \, B K)
                    \\;\simeq\;
                    \\underset{
                    c \in H^1_{Grp}(G,K)
                    }{\coprod}
                    B Stab_K(c)
                    \\;\;\;\simeq\;\;\;
                    B K
                    \\,
                    \\sqcup
                    \\,
                    \\underset{
                    {
                    c \in H^1_{Grp}(G,K)
                    }
                    \\atop
                    {
                    c \neq 1
                    }
                    }{\coprod}
                    B Stab_K(c)
            %p
              which plays a central role in discussion such as of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inertia+orbifolds"} inertia orbifolds
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+principal+bundles"} equivariant principal bundles
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              and other aspects of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            %p
              The point is that a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              into a
              %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              has only a single component, corresponding to the point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \ast \to B G
              %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformation"} pseudonatural transformation
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              into a
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              (and higher) has in addition a component for each element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \ast \to B G
          %p
            In generalization of Ex.
            = succeed ":" do
              %a.maruku-ref{:href => "#TerminalEpimorphismsInInfinityGroupoids"}
          .num_remark
            %h6 Example
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/connected+spaces"} connected spaces
              is an epimorphism iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is formed via a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+plus+construction"} Quillen plus construction
              from a
              %a.existingWikiWord{:href => "/nlab/show/perfect+group"} perfect
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X)
            %p
              More generally, a map of spaces is an epi iff all its fibers are acyclic spaces in the sense that their
              %a.existingWikiWord{:href => "/nlab/show/suspensions"} suspensions
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              %br/
          This is discussed in
          = succeed "." do
            %a{:href => "#Raptis17"} Raptis 2017
          %p
            A generalization of this to epimorphisms and acyclic spaces in
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-toposes
            is discussed in
            = succeed "." do
              %a{:href => "#Hoyois19"} Hoyois 19
          %p
          .num_remark
            %h6 Example
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
              of
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+rings"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
                \-rings
              is an epimorphism iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is
              %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %msub
                        %mo ∧
                        %mi A
                      %mi B
                      %mo ≈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B \wedge_A B \approx B
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Quillen+plus+construction"} Quillen plus construction
          %h2#references References
          %ul
            %li#Raptis17
              %p
                %a.existingWikiWord{:href => "/nlab/show/George+Raptis"}> George Raptis
                ,
                = succeed "," do
                  %em Some characterizations of acyclic maps
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1711.08898"} arxiv:1711.08898
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s40062-019-00231-6"} doi:10.1007/s40062-019-00231-6
            %li#Hoyois19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"}> Marc Hoyois
                ,
                = succeed "," do
                  %em On Quillen’s plus construction
                = succeed "," do
                  %a{:href => "https://hoyois.app.uni-regensburg.de/papers/acyclic.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Hoyois_PlusConstruction.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Oren+Ben-Bassat"}> Oren Ben-Bassat
                , D. Mukherjee,
                = succeed "," do
                  %em Analytification, localization and homotopy epimorphisms
                %strong 176
                (2022) 103129
                %a{:href => "https://arxiv.org/pdf/2111.04184"} arXiv:2111.04184
                %a{:href => "https://doi.org/10.1016/j.bulsci.2022.103129"} doi
        .revisedby
