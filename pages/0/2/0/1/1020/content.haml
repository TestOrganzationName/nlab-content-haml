            %p
              Depending upon one’s interpretation of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathsf{Set}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              categories for this equivalence to parse.
          %p
          %h3#section_For_enriched_categories For enriched categories
          %p
