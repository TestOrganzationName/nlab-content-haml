            %a.maruku-ref{:href => "#DefinitionLeftAdjointForCategories"}
            given in Remark
            %a.maruku-ref{:href => "#RemarkEquivalentDefinitionLeftAdjointForCategories"}
            generalises immediately to the setting of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched categories
