            %p
          %p
          #RemarkEquivalentDefinitionLeftAdjointForCategories.num_remark
            %h6 Remark
            %p
              Definition
              %a.maruku-ref{:href => "#DefinitionLeftAdjointForCategories"}
              is equivalent to requiring that there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} Hom functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mrow
                      %mo (
                      %mi L
