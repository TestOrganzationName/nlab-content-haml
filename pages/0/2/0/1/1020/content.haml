          %p
          #DefinitionLeftAdjointForCategories.num_defn
            %h6 Definition
            %p
              Given categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              and a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo :
                      %mi 𝒟
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} R: \mathcal{D} \to \mathcal{C}
              %em left adjoint
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} L: \mathcal{C} \to \mathcal{D}
              together with
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo :
                    %msub
                      %mi id
                      %mi 𝒞
                    %mo →
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \iota: id_\mathcal{C} \to R \circ L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi L
                    %mo ∘
                    %mi R
                    %mo →
                    %msub
                      %mi id
                      %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \epsilon: L \circ R \to id_\mathcal{D}
              such that the following diagrams (known as the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
              denotes
              %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
              of a functor with a natural transformation.
