                    \\downarrow^{\mathrlap{\in Fib}}
                    \\\
                    B
                    \&amp;\underset{\in W_{loc} \cap Cof}{\longrightarrow}&amp;
                    \\widehat{B}
                    \&amp;\underset{ \in Fib_{loc} }{\longrightarrow}&amp;
                    Y \mathrlap{\in Fib_{loc}}
                    }
            %p
              It follows that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo ^
                      %mo ,
                      %mover
                        %mi B
                        %mo ^
                      %mo ∈
                      %msub
                        %mi Fib
                        %mi loc
                    %annotation{:encoding => "application/x-tex"} \widehat{A}, \widehat{B} \in Fib_{loc}
            %p
              Consider next the further factorization of the middle vertical morphism as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi W
                          %mi loc
                        %mo ∩
                        %mi Cof
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi Fib
                          %mi loc
                  %annotation{:encoding => "application/x-tex"} \overset{W_{loc} \cap Cof}{\longrightarrow} \overset{\in Fib_{loc}}{\longrightarrow}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
