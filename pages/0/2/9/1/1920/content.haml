                    %annotation{:encoding => "application/x-tex"} T
                is the monad on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %mi ob
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Set^{ob(A)}
                whose algebras are functors
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} A\to Set
                = succeed "-multicategory" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cat
                        %mo{:stretchy => "false"} /
                        %mi A
                      %annotation{:encoding => "application/x-tex"} Cat/A
          %h3#kleisli_bicategories Kleisli bicategories
          %p
            Note that when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a cartesian monad on a finitely complete category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad
            on the bicategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            preserves pullbacks. The unit of this 2-monad is given by the spans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ←
                    %mi id
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mi η
                      %mi X
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \overset{id}{\leftarrow} X \overset{\eta X}{\to} T X
          %p and its multiplication by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi T
                  %mi X
                  %mover
                    %mo ←
                    %mi id
                  %mi T
                  %mi T
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mi μ
                      %mi X
                  %mi T
                  %mi X
                  %mo ;
                %annotation{:encoding => "application/x-tex"} T T X \overset{id}{\leftarrow} T T X \overset{\mu X}{\to} T X;
          %p
            these are
            %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformations"} pseudonatural transformations
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            are cartesian natural transformations.
          %p
            Moreover, the bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span(V,T)
            defined above is easily seen to be precisely the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli bicategory
            of this extended 2-monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V)
          %h4#examples_2 Examples
          %p
            Are ordinary
            %em symmetric
            multicategories the
            = succeed "-multicategories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f\colon (x_1,\dots,x_n) \to y
            is still an
            %em ordered
            list, but we have an action of the symmetric groups on the morphisms, in such a way that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ∈
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sigma\in S_n
            we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ⋅
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi σ
                        %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi σ
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \sigma \cdot f \colon (x_{\sigma 1}, \dots, x_{\sigma n}) \to y
          %p
            It doesn’t work to let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be the “free commutative monoid” monad, since that would destroy all ordering on the lists. (Also, that monad is not cartesian.) Really what we want is to let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be the “free symmetric strict monoidal category” monad, since for a discrete set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi A
                  %mo =
                %annotation{:encoding => "application/x-tex"} T A =
            the set of finite ordered lists of elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            However, of course this monad does not live on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            analogously to how
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            extends
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Prof
            of categories and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            does extend to a pseudomonad on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mi ⇸
                  %mi T
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C_0 &amp;#8696; T C_0
            in the Kleisli bicategory of this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C_0
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
          %h3#double_categories Double categories
          %p
            While the bicategorical framework is very nice, it does not provide a good definition of the
            %em functors
            between generalized multicategories. From the explicit point of view, a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f\colon C\to D
            between
            = succeed "-multicategories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mi C
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi T
                          %msub
                            %mi C
                            %mn 0
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mrow
                              %msub
                                %mi f
                                %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo
                            %mrow
                              %msub
                                %mi f
                                %mn 1
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi T
                              %msub
                                %mi f
                                %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi D
                            %mn 0
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mi D
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi T
                          %msub
                            %mi D
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\array { C_0 &amp; \leftarrow &amp; C_1 &amp; \to &amp; T C_0 \\
                  ^{f_0} \downarrow &amp; &amp; ^{f_1}\downarrow &amp; &amp; \downarrow^{T f_0}\\
                  D_0 &amp; \leftarrow &amp; D_1 &amp; \to &amp; T D_0 }
          %p
            which respect the identity and structure maps. This reduces to the natural notion of functor in all the examples mentioned above. However, such morphisms cannot be identified with any of the usual notions of “morphisms of monads” in the bicategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V,T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f_0
            to be an arbitrary
            %em span
            rather than a morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            We can remedy this problem if instead of the bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V,T)
            %a.existingWikiWord{:href => "/nlab/show/pseudo+double+category"} pseudo double category
            whose horizontal bicategory is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V,T)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %em monoid
            in a double category to be the same as monad in its horizontal bicategory, we can also define a
            %em monoid homomorphism
            in a double category to consist of a vertical arrow and a square respecting the multiplication and identities, in such a way that monoid homomorphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span(V,T)
            are precisely the correct functors of
            = succeed "-multicategories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            Thus, a better definition of
            = succeed "-multicategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ",\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V,T)
          %h3#equipments Equipments
          %p
            When we try to make the notion of “Kleisli double category” precise, however, we run into some issues. We want the “Kleisli-ness” to happen
            = succeed "," do
              %em horizontally
            %em vertical
            natural transformations. For example, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a monad on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Id_{Span(V)} \to Span(T)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo →
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(T)^2 \to Span(T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span(T)
            denotes the induced functor on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(V)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            = succeed "," do
              %em functors
          %p
            However, in general, if all we know is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a monad on a double category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in the “vertical” sense, then there is no way to define a “horizontally Kleisli” double category of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi T
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\to T B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi T
                  %mi C
                %annotation{:encoding => "application/x-tex"} B \to T C
            in such a double category would have to be the composite
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi T
                    %mi B
                    %mo →
                    %mi T
                    %mi T
                    %mi C
                    %mover
                      %mo →
                      %mi μ
                    %mi T
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A\to T B \to T T C \overset{\mu}{\to} T C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi T
                  %mi T
                  %mi C
                %annotation{:encoding => "application/x-tex"} A\to T T C
            with the vertical arrow
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi T
                    %mi C
                    %mo →
                    %mi T
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mu\colon T T C \to T C
          %p
            There are two solutions to this problem, and it turns out that the best approach is to use them both. The first, and most obvious, is to generalize the way in which the monads in these two examples do, in fact, induce pseudomonads on the horizontal bicategory. Namely, in both of the double categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            gives rise to a horizontal arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} B(1,f)\colon A\to B
            in a universal way. This construction, along with its dual, makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Prof
            into
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/framed+bicategories"} framed bicategories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proarrow+equipments"} proarrow equipments
          %p
            Now in general, a vertical transformation between double categories that are proarrow equipments does not quite induce a
            %em pseudo
            natural transformation on horizonal bicategories, but only an
            %em oplax
            natural transformation. However, in the examples we have considered so far, the oplax transformations are in fact pseudo, and so there is a horizontally-Kleisli double category (which is easily seen to be, itself, a proarrow equipment).
          %h3#virtual_double_categories Virtual double categories
          %p
            From the double-category point of view, it seems unnatural to require that the unit and multiplication of the monad induce “horizontally pseudo” transformations; the vertical transformation of double categories is surely the more basic notion. Moreover, it is also unnatural to require the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            to be pseudo; there are interesting examples where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is only a (horizontally)
            %em lax
            functor. Note that unlike the case for bicategories, there is a 2-category of double categories, lax functors, and vertical transformations, so we can talk about monads in such a 2-category.
          %p
            However, at this level of generality, the horizontal Kleisli construction does not yield a double category. It does, however, yield a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/virtual+double+category"} virtual double category
            %em input
            a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on a virtual double category
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HKl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HKl(X,T)
            %em lax
            functors of pseudo double categories.) Thus a natural and even more general notion of generalized multicategory is “a monoid in the horizontal-Kleisli virtual double category for some monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on a virtual double category;” we call such a thing a
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                \-monoid
          %p
            Note also that for any virtual double category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(X)
            whose objects are monoids in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on a virtual double category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KMod
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi HKl
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} KMod(X,T) = Mod(HKl(X,T))
            whose objects are
            = succeed "-monoids," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %h4#examples_3 Examples
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                has pullbacks and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is a monad preserving pullbacks (no condition on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                and
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi μ
                      %annotation{:encoding => "application/x-tex"} \mu
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                induces a monad on the virtual double category (which is actually, of course, a pseudo double category)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Span
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Span(V)
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span(V)
                are then precisely the
                = succeed "-multicategories," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                The “free symmetric strict monoidal category” monad on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Prof
                can also be regarded as a monad on the virtual double category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} Prof
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategories"} symmetric multicategories
            %li
              %p
                If we use instead the “free category with finite products” monad on the virtual double category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} Prof
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+multicategories"} cartesian multicategories
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lawvere+theories"} Lawvere theories
            %li
              %p
                More basically, we also have a “free strict monoidal category” monad on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} Prof
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Prof
                        %mo =
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi Span
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Prof = Mod(Span)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is also
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Mod(S)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is the “free monoid” monad on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Span
                        %mo =
                        %mi Span
                        %mo{:stretchy => "false"} (
                        %mi Set
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Span = Span(Set)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                on a virtual double category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Mod(S)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mod(X)
                on “discrete objects.”
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter+monad"} ultrafilter monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                has a “canonical” extension to the virtual double category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                of sets, functions, and binary relations. Although
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                is a pseudo double category and this monad is a strict functor,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                is only oplax. The
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                can be identified with
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relational+beta-modules"} relational beta-modules
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
                is another name for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
            %li
              %p
                Similarly, the powerset monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                extends to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                in a canonical way, and the
                = succeed "-monoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                are
                = succeed "s." do
                  %span.newWikiWord
                    closure space
                    %a{:href => "/nlab/new/closure+space"} ?
                = succeed "," do
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo ,
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (T,V)
                    \-algebras
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                denotes a Set-monad like
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                or
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                a category (usually a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
            %li
              %p
                There is a 2-monad on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo −
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Cat-Prof
                (whose objects are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-categories+with+contravariance"} 2-categories with contravariance
          %h3#units_and_transformations Units and transformations
          %p …
          %h3#equipments_and_normalization Equipments and normalization
          %p …
          %h2#obtaining_the_relevant_monads Obtaining the relevant monads
          %p Each of the above contexts for generalized multicategories requires a monad of a certain sort. Various technologies exist for producing examples of such monads, for instance:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/clubs"} clubs
              and
              %a.existingWikiWord{:href => "/nlab/show/polynomial+monads"} polynomial monads
              give ways to construct cartesian monads.
            %li
              %a.existingWikiWord{:href => "/nlab/show/relative+pseudomonads"} relative pseudomonads
              give a way to construct pseudomonads on bicategories like
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Prof
            %li
              %a.existingWikiWord{:href => "/nlab/show/double+clubs"} double clubs
              and
