                        %mtd
                          %mi TZ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; &amp; &amp; R \circ S &amp; &amp; &amp; &amp;\\
                  \&amp; &amp; &amp; \swarrow &amp; &amp; \searrow &amp; &amp; &amp; \\
                  \&amp; &amp; R &amp; &amp; &amp; &amp; T S &amp; &amp;\\
                  \&amp; ^f \swarrow &amp; &amp; \searrow ^g &amp; &amp; ^{T h} \swarrow &amp; &amp; \searrow ^{T k} &amp; \\
                  X &amp; &amp; &amp; &amp; T Y &amp; &amp; &amp; &amp; T T Z &amp; \overset{\mu Z}{\rightarrow} &amp; TZ}
          %p
            A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            %strong -multicategory
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is by definition a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            in the bicategory described above. However, it is convenient to use the alternate word
            %em monoid
            rather than
            %em monad
            here, to avoid confusion with the monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            which lives
            %em on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            If we spell out what this means more explicitly, a
            = succeed "-multicategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
