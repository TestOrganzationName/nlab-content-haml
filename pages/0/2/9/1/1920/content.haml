                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                        %mtd
                        %mtd
                        %mtd
                        %mtd
