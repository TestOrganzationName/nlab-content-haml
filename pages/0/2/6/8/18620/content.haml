          %h2#idea Idea
          %p
            In (
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"}> perturbative
            )
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            = succeed "," do
              %em Bogoliubov’s formula
            = succeed ")" do
              %a{:href => "#BogoliubovShirkov59"} Bogoliubov-Shirkov 59
            %a.existingWikiWord{:href => "/nlab/show/interacting+quantum+observables"} interacting quantum observables
            as the
            %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
            with respect to a
            %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
            of the
            %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
            corresponding to a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
          %p
            Originally this is an ad-hoc formula, motivated by the would-be
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            picture of the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            (remark
            %a.maruku-ref{:href => "#InterpretationOfPerturbativeSMatrix"}
            below) and mathematically justified by the fact that it does yield a
            %a.existingWikiWord{:href => "/nlab/show/causally+local+net+of+observables"} causally local net of observables
            in
            %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            (prop.
            %a.maruku-ref{:href => "#CausalLocalityOfBogoliubovFormula"}
            below).
          %p
            Much more recently it was shown that Bogoliubov’s formula indeed expresses quantum observables as systematically obtained by
            %a.existingWikiWord{:href => "/nlab/show/Fedosov+deformation+quantization"} Fedosov deformation quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            (
            %a{:href => "#Collini16"}> Collini 16
            ,
            = succeed ")." do
              %a{:href => "#HawkinsRejzner16"} Hawkins-Rejzner 16
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p + 1
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mover
                    %mo ⟶
                    %mi fb
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} E \overset{fb}{\longrightarrow} \Sigma
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi free
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi Σ
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{L}_{free}\in \Omega^{p+1,0}_\Sigma(E)
            be a
            %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
            for a
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            with
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            of type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒲
                %annotation{:encoding => "application/x-tex"} \mathcal{W}
            be the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
            of the free field, with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                  %mi PolyObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  LocObs(E_{\text{BV-BRST}})
                  \\overset{:(-):}{\longrightarrow}
                  PolyObs(E_{\text{BV-BRST}})
          %p
            the corresponding quantization map from
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            (“
            %a.existingWikiWord{:href => "/nlab/show/normal+ordering"}> normal ordering
            ”).
          %p Let then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi LocObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo ,
                  %mi g
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mi PolyObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi ℏ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{S}
                  \\;\colon\;
                  LocObs(E_{\text{BV-BRST}})[ [\hbar, g, j] ]
                  \\longrightarrow
                  PolyObs(E_{\text{BV-BRST}})((\hbar))[ [g,j] ]
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/perturbative+S-matrix"} perturbative S-matrix
            scheme. Moreover let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo ∈
                  %mi LocObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  g S_{int} \in LocObs(E_{\text{BV-BRST}})[ [\hbar, g] ]
          %p
            be an
            %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} functional
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi ℱ
                    %mi loc
                %annotation{:encoding => "application/x-tex"} A \in \mathcal{F}_{loc}
            a
            %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \in C^\infty_{cp}(\Sigma)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒵
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒮
                  %mo{:stretchy => "false"} (
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi 𝒮
                  %mo{:stretchy => "false"} (
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{Z}_{g S_{int}}(j A)
                  \\; \coloneqq \;
                  \\mathcal{S}(g S_{int})^{-1} \mathcal{S}( g S_{int} + j A )
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
            induced by the perturbative
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            (where the product shown by juxtaposition is that in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
            induced by the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
          #GeneratingFunctionsForCorrelationFunctions.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"}> Bogoliubov's formula
                )
            %p
              The perturbative
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observable"} interacting field observable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    A_{int}
                    \\;\in\;
                    PolyObs(E_{\text{BV-BRST}})[ [ \hbar, g] ]
            %p
              corresponding to a
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in LocObs(E_{\text{BV-BRST}})
              is the
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              in the
              %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              (
              %a{:href => "S-matrix#SchemeGeneratingFunction"}> this def.
              ) of the term linear in the
              %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              strenght
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mi ℏ
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi j
                    %msub
                      %mi 𝒵
                      %mrow
                        %mi g
                        %msub
                          %mi S
                          %mi int
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi j
                        %mo =
                        %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_{int}
                    \\;\coloneqq\;
                    i \hbar \frac{d}{d  j } \mathcal{Z}_{ g S_{int}}( j  A)\vert_{j = 0}
                    \\,.
          %p
            This is due to
            = succeed "," do
              %a{:href => "#BogoliubovShirkov59"} Bogoliubov-Shirkov 59
            %em Bogoliubov’s formula
            (e.g.
            = succeed ")." do
              %a{:href => "#Rejzner16"} Rejzner 16 (6.12)
            %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            was formulated in (
            %a{:href => "#EpsteinGlaser73"}> Epstein-Glaser 73 around (74)
            ). Review includes (
            %a{:href => "#DuetschFredenhagen00"}> Dütsch-Fredenhagen 00, around (17)
            ).
          %p
            The assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↦
                  %msub
                    %mi A
                    %mi int
                %annotation{:encoding => "application/x-tex"} A \mapsto A_{int}
            is also called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+M%C3%B8ller+operator"} quantum Møller operator
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi int
                %annotation{:encoding => "application/x-tex"} A_{int}
            as a
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            in the
            %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            and
            %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
            are called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/retarded+products"} retarded products
          #PowersInPlancksConstant.num_remark
            %h6#remark Remark
            %p
              %strong
                (powers in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
            %p
              That the observables as defined in def.
              %a.maruku-ref{:href => "#GeneratingFunctionsForCorrelationFunctions"}
              indeed are
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              as opposed to more general
              %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
              requires a little argument.
            %p
              The explicit
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi T
                    %mi exp
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi i
                            %mi ℏ
                      %mrow
                        %mo (
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo +
                        %mi j
                        %mi A
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(g S_{int} + j A)
                    \=
                    T \exp\left(
                    \\tfrac{1}{i \hbar}
                    \\left(
                    g S_{int} + j A
                    \\right)
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(-)
              denotes
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mrow
                        %msub
                          %mi S
                          %mi int
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{Z}_{S_{int}}(j A)
                    \\;\coloneqq\;
                    \\mathcal{S}(S_{int})^{-1} \star_H \mathcal{S}(g S_{int} + j A)
            %p
              involves the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              of the free theory (the
              %a.existingWikiWord{:href => "/nlab/show/normal-ordered+product"} normal-ordered product
              of the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              in this algebra is a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              that however has no constant term in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              (but starts out with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              times the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi L
                      %mi int
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ℏ
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [L_{int},A] \;=\; \hbar(\cdots)
                    \\,.
            %p Now schematically the derivative of the generating function is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi int
                          %mtd
                            %mo ≔
                            %mi i
                            %mi ℏ
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi j
                            %msub
                              %mi 𝒵
                              %mrow
                                %msub
                                  %mi S
                                  %mi int
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mi A
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %mi j
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %mi i
                                    %mi ℏ
                              %mo{:stretchy => "false"} [
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                              %mo )
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_{int}
                    \&amp; \coloneqq
                    i \hbar \frac{d}{d j }
                    \\mathcal{Z}_{ S_{int}}(j A)\vert_{j  = 0}
                    \\\
                    \&amp; =
                    \\exp\left(
                    \\tfrac{1}{i \hbar}[g S_{int}, -]
                    \\right)
                    (A)
                    \\end{aligned}
                    \\,.
            %p
              (The precise expression is given by the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/retarded+products"} retarded products
              %a{:href => "#DuetschFredenhagen00"} Dütsch-Fredenhagen 00, prop. 2 (ii)
              = succeed "," do
                %a{:href => "#Rejzner16"} Rejzner 16, prop. 6.1
              = succeed ".)" do
                %a{:href => "#HawkinsRejzner16"} Hawkins-Rejzner 16, cor. 5.2
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            %p
              That the quantum observables takes values in formal power series of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              is the hallmark of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              proceeds from an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              which is axiomatized by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the interacting field theory. This is indeed the case (
              %a{:href => "#Collini16"}> Collini 16
              ,
              = succeed ")." do
                %a{:href => "#HawkinsRejzner16"} Hawkins-Rejzner 16
            %p
              For the analogous analysis of powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              in the
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              itself, see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
              the section
              = succeed "." do
                %em
                  %a{:href => "loop%20order#RelationToPowersInPlancksConstant"} Relation to powers in Planck’s constant
          %h2#properties Properties
          %h3#relation_to_the_wouldbe_path_integral Relation to the would-be path integral
          #InterpretationOfPerturbativeSMatrix.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (interpretation of Bogoliubov’s formula via a “
                %a.existingWikiWord{:href => "/nlab/show/path+integral"}> path integral
                ”)
            %p
              In informal heuristic discussion of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
              the
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              is thought of as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi g
                          %mi ℏ
                      %msub
                        %mi L
                        %mi int
                      %mo +
                      %mi j
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo =
                      %mtext not really!
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %mi Φ
                        %mo ∈
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi asmpt
                    %mi exp
                    %mrow
                      %mo (
                      %msub
                        %mo ∫
                        %mi X
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi g
                            %mrow
                              %mi i
                              %mi ℏ
                        %msub
                          %mi L
                          %mi int
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi i
                              %mi ℏ
                        %msub
                          %mo ∫
                          %mi X
                        %msub
                          %mi L
                          %mi free
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                    %mi D
                    %mo{:stretchy => "false"} [
                    %mi Φ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    S\left(
                    \\tfrac{g}{\hbar} L_{int} + j
                    \\right)
                    \\;\overset{\text{not really!}}{=}\;
                    \\underset{\Phi \in \Gamma_\Sigma(E)_{asmpt}}{\int}
                    \\exp\left(
                    \\int_X
                    \\left(
                    \\tfrac{g}{i \hbar} L_{int}(\Phi) + j A(\Phi)
                    \\right)
                    \\right)  e^{\tfrac{1}{i \hbar}\int_X L_{free}(\Phi) }D[\Phi]
            %p
              where the integration is thought to be over the
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi asmpt
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)_{asmpt}
              of
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              (the
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              of the given
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                      %mo →
                      %mo ±
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} x^0 \to \pm \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒲
                    %annotation{:encoding => "application/x-tex"} \mathcal{W}
            %p
              With the perturbative S-matrix informally thought of as a path integral this way, the the Bogoliubov formula in def.
              %a.maruku-ref{:href => "#GeneratingFunctionsForCorrelationFunctions"}
              similarly would have the following interpretation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo =
                      %mtext not really!
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo ∫
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mi exp
                        %mrow
                          %mo (
                          %msub
                            %mo ∫
                            %mi X
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi g
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mi L
                              %mi int
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo )
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mo ∫
                              %mi X
                            %msub
                              %mi L
                              %mi free
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                        %mi D
                        %mo{:stretchy => "false"} [
                        %mi Φ
                        %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ∫
                        %mi exp
                        %mrow
                          %mo (
                          %msub
                            %mo ∫
                            %mi X
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi g
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mi L
                              %mi int
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo )
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mo ∫
                              %mi X
                            %msub
                              %mi L
                              %mi free
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                        %mi D
                        %mo{:stretchy => "false"} [
                        %mi Φ
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    A_{int}
                    \\;\overset{\text{not really!}}{=}\;
                    \\frac{
                    \\int
                    j A(\Phi)
                    \\exp\left(
                    \\int_X
                    \\left(
                    \\tfrac{g}{i \hbar} L_{int}(\Phi)
                    \\right)
                    \\right)  e^{\tfrac{1}{i \hbar}\int_X L_{free}(\Phi) }D[\Phi]
                    }
                    {
                    \\int
                    \\exp\left(
                    \\int_X
                    \\left(
                    \\tfrac{g}{i \hbar} L_{int}(\Phi)
                    \\right)
                    \\right)  e^{\tfrac{1}{i \hbar}\int_X L_{free}(\Phi) }D[\Phi]
                    }
            %p If here we were to regard the expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ≔
                      %mtext not really
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi exp
                        %mrow
                          %mo (
                          %msub
                            %mo ∫
                            %mi X
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi g
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mi L
                              %mi int
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo )
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                            %msub
                              %mo ∫
                              %mi X
                            %msub
                              %mi L
                              %mi free
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                        %mi D
                        %mo{:stretchy => "false"} [
                        %mi Φ
