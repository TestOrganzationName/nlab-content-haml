          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#classical_oscillator"} Classical oscillator
              %li
                %a{:href => "#quantum_harmonic_oscillator"} Quantum harmonic oscillator
              %li
