          %h2#idea Idea
          %p
            One thinks of
            %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantification
            as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
          %p
            For example, suppose we’re working in the theory of a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            over a fixed field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a linear transformation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔽
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %msup
                      %mi 𝔽
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}^{n+1} \to \mathbb{F}^m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{b}
            be an
            = succeed "-tuple," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            a variable, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{y}
            an
            = succeed "-tuple" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"}
                  \\exists x A(x, \vec{y}) = \vec{b}
          %p is the projection of the solution set for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"}
                  A(x, \vec{y}) = \vec{b}
          %p
            to the
            = succeed "-hyperplane." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{y}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %msup
                    %mi 𝔽
                    %mi n
                  %mo →
                  %msup
                    %mi 𝔽
                    %mi m
                %annotation{:encoding => "application/x-tex"} B : \mathbb{F}^n \to \mathbb{F}^m
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"} B(\vec{y}) = \vec{b} \iff (\exists x) \left(A(x, \vec{y}) = \vec{b}\right).
          %p
            This is an instance of the fact that the theories of
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector spaces
            over division rings admits quantifier elimination. It’s nice when this happens, and when it doesn’t, one asks for minimal ways to expand the language to make it happen. That
            %a.existingWikiWord{:href => "/nlab/show/ACF"} ACF
            eliminates quantifiers is a special case of
            %a.existingWikiWord{:href => "/nlab/show/Chevalley%27s+theorem+on+constructible+sets"} Chevalley's theorem on constructible sets
            (“the image of a constructible set is constructible”).
          %p
            Often, in order to prove quantifier-elimination, one develops an
            %em effective
            procedure for reducing an arbitrary sentence to a quantifier-free one, which shows that the theory is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/decidability"} decidable
            %span.newWikiWord
              RCF
              %a{:href => "/nlab/new/RCF"} ?
            of real closed fields is decidable.
          %h2#definition Definition
          %p
            An
            = succeed "-theory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            %strong eliminates quantifiers
            if every
            = succeed "-formula" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varphi(x)
            is equivalent to a quantifier-free
            = succeed "-formula" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ⊧
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ↔
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T \models \varphi(x) \leftrightarrow \psi(x).
          %h2#remarks Remarks
          %ul
            %li
              %p
                Any theory is
                %a.existingWikiWord{:href => "/nlab/show/interpretation"} bi-interpretable
                with an expanded theory where every definable set is named with a predicate, called its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} Morleyization
            %li
              %p Therefore, whether or not a structure has quantifier elimination depends on the language being used to describe the structure.
            %li
              %p
                Quantifier elimination implies
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/model+complete+theory"} model completeness
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/existentially+closed+theory"} existentially closed
            %li
              %p
                It is an informative exercise to try to prove QE syntactically (a “tractable” case like
                %a.existingWikiWord{:href => "/nlab/show/DLO"} DLO
                suffices) to appreciate the usefulness of the semantic/model-theoretic characterization of QE below.
            %li
              %p
                The characterizations below (and in general important tools in model theory like the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/compactness+theorem"} compactness theorem
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lowenheim-Skolem+theorem"} Lowenheim-Skolem theorem
                %em infinite
                models.
            %li
              %p
                Since quantifier elimination is equivalent to
                %a.existingWikiWord{:href => "/nlab/show/substructure+complete+theory#substructureconverse"} substructure completeness
                and
                %a.existingWikiWord{:href => "/nlab/show/elementary+equivalence"} elementarily equivalent
                finite structures are isomorphic, (the theory of a) finite
                %a.existingWikiWord{:href => "/nlab/show/first-order+structure"} first-order structure
                eliminates quantifiers if and only if it is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Fraisse+limit"} ultrahomogeneous
          %h2#semantic_characterizations_of_qe Semantic characterizations of QE
          .num_prop
            %h6#proposition Proposition
            %p
              A first-order theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              eliminates quantifiers if and only if it is substructure-complete:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              plus the
              %a.existingWikiWord{:href => "/nlab/show/quantifier-free+diagram"} quantifier-free diagram
              of any substructure of any model of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              form a complete theory.
          .proof
            %h6#proof Proof
            %p
              See
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/substructure+complete+theory#QEiffsubstructurecomplete"} substructure completeness
          #QEcriterion.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be a theory. The following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  eliminates quantifiers.
              %li
                %p
                  For every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  models of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi M
                          %msup
                            %mo{:stretchy => "false"} |
                            %mo +
                        %annotation{:encoding => "application/x-tex"} |M|^+
                  %a.existingWikiWord{:href => "/nlab/show/type+%28in+model+theory%29"} saturated
                  and every proper substructure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊆
                        %mi M
                      %annotation{:encoding => "application/x-tex"} A \subseteq M
                  such that there is an embedding
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                          %mo →
                          %mi N
                        %annotation{:encoding => "application/x-tex"} i \colon A \to N
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} A'
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊊
                        %mi A
                        %mo ′
                        %mo ⊆
                        %mi M
                      %annotation{:encoding => "application/x-tex"} A \subsetneq A' \subseteq M
                  and an extension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ′
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo ′
                        %mo →
                        %mi N
                      %annotation{:encoding => "application/x-tex"} i' \colon A' \to N
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} A'
          .proof
            %h6#proof_2 Proof
            %p
              (1.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \implies
              2.) Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              eliminates quantifiers. Since this is equivalent to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/substructure-completeness"} substructure-completeness
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi M
                      %mo \
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in M \backslash A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mover
                      %mo =
                      %mi df
                    %mo{:stretchy => "false"} ⟨
                    %mi A
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} B \overset{df}{=} \langle A \cup \{x\} \rangle
              be the substructure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} A \cup \{x\}.
              Then, since quantifier-free statements are transferred by embeddings, the
              %a.existingWikiWord{:href => "/nlab/show/type+%28in+model+theory%29"} type (in model theory)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is finitely realized in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              and therefore realized via
              = succeed "-saturation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi M
                      %msup
                        %mo{:stretchy => "false"} |
                        %mo +
                    %annotation{:encoding => "application/x-tex"} |M|^+
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x'
            %p
              A standard
              %a.existingWikiWord{:href => "/nlab/show/back-and-forth+argument"} back-and-forth argument
              starting at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x'
              lets us build our required extension.
            %p
              (2.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \implies
              1.) By possibly transfinitely iterating 2., we obtain an embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo →
                    %mi N
                    %mo .
                  %annotation{:encoding => "application/x-tex"} M \to N.
              As we can always embed a
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-model," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+completeness"} amalgamation
            %p
              This gives
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/model+completeness"} model completeness
              = succeed "-submodel" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/elementary+embedding"} elementary submodel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is a tuple from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(x,y)
              is a quantifier-free formula, and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ⊧
                      %mo ∃
                      %mi x
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N \models \exists x \varphi(x, m)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊧
                    %mo ∃
                    %mi x
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \models \exists x \varphi(x,m)
              (i.e. that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/existentially+closed"} existentially closed
            %p
              Embed
