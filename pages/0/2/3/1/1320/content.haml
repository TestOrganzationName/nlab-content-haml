                    %mi T
                    %mo =
                    %mi U
                    %mi F
                    %mi U
                    %mi F
                    %mo →
                    %mi U
                    %mi F
                    %mo =
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \mu = U \epsilon F: T T = U F U F \to U F = T
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mstyle{:mathvariant => "bold"}
                      %mi T
