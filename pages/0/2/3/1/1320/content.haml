                    %mi C
                  %mo →
                  %mi U
                  %mo ∘
                  %mi F
                %annotation{:encoding => "application/x-tex"} \eta: Id_C \to U \circ F
            and counit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi F
                    %mo ∘
                    %mi U
                    %mo →
                    %msub
                      %mi Id
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \epsilon: F \circ U \to Id_D
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi T
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{T}=(T,\mu,\eta)
            setting
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %mi U
                    %mo ∘
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} T = U \circ F: C \to C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
