          %p
            We put
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi I
                %annotation{:encoding => "application/x-tex"} S_{0}(V)=I
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} S_{1}(V)=V
          %p If the category possess the countable coproducts, then we can form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %msub
                    %mi S
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(V) = \underset{n \ge 0}{\coprod}S_{n}(V)
          %p
            As above, if the tensor product distributes over the countable coproducts and preserve the finite colimits in each argument, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(V)
            will be the free
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+object"} commutative monoid object
            on V.
          %p
            For example, in the category
            %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
            of sets and relations, this construction gives the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M}(V)
            of multisets with elements in the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %h2#examples Examples
          #SymmetricAlgebraInCoChainComplexes.num_example
            %h6#example Example
            %p
              %strong
                (symmetric algebra in
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
            %p
              Let the ambient
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              be the
              %a.existingWikiWord{:href => "/nlab/show/category+of+cochain+complexes"} category of cochain complexes
              over a
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo •
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V^\bullet, d)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo •
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ch
                      %mo •
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sym\left( (V^\bullet, d) \right)
                    \\;\in\; CMon( Ch^\bullet, \otimes )
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mo •
                    %annotation{:encoding => "application/x-tex"} V^\bullet
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is the original
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of degree +1.
          %h2#properties Properties
          #CochainCohomologyOfSymmetricAlgebraOnCochainComplex.num_prop
            %h6#proposition Proposition
            %p
              Let the ambient
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              be the
              %a.existingWikiWord{:href => "/nlab/show/category+of+cochain+complexes"} category of cochain complexes
              over a
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              via the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              and consider the
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo •
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(V^\bullet,d)
              free on a cochain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo •
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V^\bullet,d)
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#SymmetricAlgebraInCoChainComplexes"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              (of the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} underlying
              cochain complex) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo •
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(V^\bullet,d)
              is the graded symmetric algebra on the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo •
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V^\bullet,d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mrow
                      %mo (
                      %mi Sym
                      %mrow
                        %mo (
                        %msup
                          %mi V
                          %mo •
                        %mo ,
                        %mi d
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sym
                    %mrow
                      %mo (
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo •
