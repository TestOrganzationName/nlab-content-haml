                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet\left(
                    Sym\left(V^\bullet,d\right)
                    \\right)
                    \\;\simeq\;
                    Sym\left( H^\bullet(V^\bullet,d) \right)
                    \\,.
          %p
            See also
            = succeed "." do
              %a{:href => "https://mathoverflow.net/a/91243/381"} this MO discussion
