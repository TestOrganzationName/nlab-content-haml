                  %li
                    %a{:href => "#InterpretationInTMFCohomology"} Conjectural interpretation in tmf-cohomology
                  %li
                    %a{:href => "#occurrences_in_string_theory"} Occurrences in string theory
                  %ul
                    %li
                      %a{:href => "#ReferencesEllipticGeneraAsPartitionFunctionsOfHStrings"} H-string elliptic genus
                    %li
                      %a{:href => "#ReferencesEllipticGeneraAsPartitionFunctionsOfM5Branes"} M5-brane elliptic genus
                    %li
