                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#EllipticGeneraAsBranePartitionFunctionsReferences"}
                    Elliptic genera as super
                    = succeed "-brane" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
