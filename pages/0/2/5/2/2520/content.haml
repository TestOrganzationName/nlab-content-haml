                    %a.existingWikiWord{:href => "/nlab/show/measure"} measure
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math#mathml_66547e90e66a0bf33e020921b1eaa3943837feb2_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
