                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Einstein-Yang-Mills+theory"} Einstein-Yang-Mills theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Einstein-Yang-Mills-Dirac+theory"} Einstein-Yang-Mills-Dirac theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Einstein-Maxwell-Yang-Mills-Dirac-Higgs+theory"} Einstein-Maxwell-Yang-Mills-Dirac-Higgs theory
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/branes"} branes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nambu-Goto+action"} Nambu-Goto action
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac-Born-Infeld+action"} Dirac-Born-Infeld action
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Perry-Schwarz+action"} Perry-Schwarz action
            %li
              %p
                A large class of examples of action functionals arises in
                = succeed "." do
                  %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          %h2#related_concepts Related concepts
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
