            %li#OrchPet
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dominic+Orchard"}> Dominic Orchard
                , Tomas Petricek,
                = succeed "," do
                  %em Embedding effect systems in Haskell
                = succeed ")" do
