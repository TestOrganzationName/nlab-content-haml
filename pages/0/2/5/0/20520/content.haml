            %li#FKM
              %p
                Soichiro Fujii, Shin-ya Katsumata, and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul-Andr%C3%A9+Melli%C3%A8s"} Paul-André Melliès
                = succeed "," do
                  %em Towards a Formal Theory of Graded Monads
                = succeed ")" do
                  %a{:href => "https://www.irif.fr/~mellies/papers/fossacs2016-final-paper.pdf"} pdf
            %li
              %p
                Soichiro Fujii,
                = succeed "," do
                  %em A 2-Categorical Study of Graded and Indexed Monads
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1904.08083"} arXiv:1904.08083
            %li
              %p
                Ulrich Dorsch, Stefan Milius and Lutz Schröder,
                = succeed "," do
                  %em Graded Monads and Graded Logics for the Linear Time – Branching Time Spectrum
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1812.01317"} arXiv:1812.01317
            %li#Perrone
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"}> Paolo Perrone
                ,
                = succeed "," do
                  %em Categorical Probability and Stochastic Dominance in Metric Spaces
                = succeed ")" do
                  %a{:href => "http://www.paoloperrone.org/phdthesis.pdf"} thesis
            %li#FPKan
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"}> Tobias Fritz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
                = succeed "," do
                  %em A Criterion for Kan Extensions of Lax Monoidal Functors
                = succeed ")." do
                  %a{:href => "https://arxiv.org/abs/1809.10481"} arXiv:1809.10481
            %li#FPKant
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"}> Tobias Fritz
                ,
                = succeed "," do
