          #HorizontalVariationalComplexOfTrivialFieldBundleIsExact.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/horizontal+variational+complex"} horizontal variational complex
                of
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              which is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi s
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{s,0}_\Sigma(E)
              with the
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              (
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"}> horizontal derivative
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            #eq:ExactSequenceTotalSpacetimeDerivative.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mover
                      %mo ↪
                      %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\overset{}{\hookrightarrow}
                    \\Omega^{0,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{1,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{2,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\cdots
                    \\overset{d}{\longrightarrow}
                    \\Omega^{p,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{p+1,0}_\Sigma(E)
            %p
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi s
                    %mo ≤
                    %mi p
                  %annotation{:encoding => "application/x-tex"} 0 \leq s \leq p
              the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi s
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^{s,0}_\Sigma(E)
            %p
              More explicitly, this means that not only is every horizontally exact differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mi d
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \omega = d \alpha
              horizontally closed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d \omega = 0
              (which follows immediately from the fact that we have a
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              in the first place, hence that
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d^2 = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi s
                        %mo ≤
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{0 \leq s \leq p,0}_\Sigma(E)
              satisfies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi ω
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d \omega = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi s
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^{s-1,0}_\Sigma(E)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %mi d
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \omega = d \alpha
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "variational+bicomplex#Anderson89"} Anderson 89, prop. 4.3
          #EulerLagrangeComplex.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"}> Euler-Lagrange complex
                )
            %p
              In fact the exact sequence
              %a.maruku-eqref{:href => "#eq:ExactSequenceTotalSpacetimeDerivative"} (12)
              from prop.
              %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
              continues further to the right, as such called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              and then then next is the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Helmholtz+operator"} Helmholtz operator
            %p
              Here we do not discuss this in detail, but we encounter aspects of the exactness further to the right below in example
              %a.maruku-ref{:href => "#TrivialLagrangianDensities"}
              and in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#EvolutionaryDerivativeOfEulerLagrangeFormIsFormallySelfAdjoint"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            on the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a{:href => "#Lagrangians"} next chapter
            we apply this to
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
