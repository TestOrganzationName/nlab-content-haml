          #JetBundleInTermsOfSyntheticDifferentialGeometry.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                in terms of
                = succeed ")" do
