            %p
              In terms of the
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} infinitesimal geometry
              of
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSet"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
