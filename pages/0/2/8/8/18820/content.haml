                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \subset J^\infty_\Sigma(E)
              on which it is given by a function on a smooth function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^k_\Sigma(E)
              for some finite
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            (see
            = succeed ")" do
              %a{:href => "locally+pro-manifold#KhavkineSchreiber17"} Khavkine-Schreiber 17, section 2.2 and 3.3
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#DifferentialOperators
            %strong
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
          %p
            Example
            %a.maruku-ref{:href => "#JetFaraday"}
            shows that the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#deRhamDifferential"}
            %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
            with a suitable function on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
          #DifferentialOperator.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"}> differential operator
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 1
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E_1 \overset{fb_1}{\to} \Sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 2
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E_2 \overset{fb_2}{\to} \Sigma
              be two smooth
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
              over a common base space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              from
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              to sections of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              is a
              %a.existingWikiWord{:href => "/nlab/show/bundle+morphism"} bundle morphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi D
                                %mo{:stretchy => "false"} ˜
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J^\infty_\Sigma(E_1)
                    \&amp;&amp; \overset{\tilde D}{\longrightarrow} &amp;&amp;
                    E_2
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \Sigma
                    }
            %p
              or rather the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              between the
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
              of these bundles which this induces after
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              with
              %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#JetProlongation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi j
                          %mi Σ
                          %mn ∞
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mover
                          %mi D
                          %mo{:stretchy => "false"} ˜
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D
                    \\;\colon\;
                    \\Gamma_\Sigma(E_1)
                    \\overset{j^\infty_\Sigma}{\longrightarrow}
                    \\Gamma_\Sigma(J^\infty_\Sigma(E_1))
                    \\overset{\tilde D \circ (-)}{\longrightarrow}
                    \\Gamma_\Sigma(E_2)
                    \\,.
            %p
              If both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              are
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
              canonically are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/linear+differential+operator"} linear differential operator
              if it is a
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
              between these vector spaces. This means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde D
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
              in jet coordinates.
          #NormallyHyperbolicDifferentialOperator.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/normally+hyperbolic+differential+operator"} normally hyperbolic differential operator
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mover
                      %mo →
                      %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E^\ast \overset{}{\to} \Sigma
              for its
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DualVectorBundle"}
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/linear+differential+operator"} linear differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialOperator"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P
                    \\;\colon\;
                    \\Gamma_\Sigma(E)
                    \\longrightarrow
                    \\Gamma_{\Sigma}(E^\ast)
            %p
              is of
              %em second order
              if it has a coordinate expansion of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi Φ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mn 2
                        %msup
                          %mi Φ
                          %mi b
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi μ
                        %mo ∂
                        %msup
                          %mi x
                          %mi ν
                    %mo +
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mi μ
                    %mfrac
                      %mrow
                        %mo ∂
                        %msup
                          %mi Φ
                          %mi b
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi μ
                    %mo +
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi Φ
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    (P \Phi)_a
                    \\;=\;
                    P^{\mu \nu}_{a b} \frac{\partial^2 \Phi^b}{\partial x^\mu \partial x^\nu}
                    +
                    P^\mu_{a b} \frac{\partial \Phi^b}{\partial x^\mu}
                    +
                    P_{a b} \Phi^b
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(P^{\mu \nu}_{a b}), (P^\mu_{a b}), P_{a b}\}
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              This is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/normally+hyperbolic+differential+operator"} normally hyperbolic differential operator
              if its
              %em
                %a.existingWikiWord{:href => "/nlab/show/principal+symbol"} principal symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P^{\mu \nu}_{a b})
              is proportional to the inverse
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              (prop./def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\eta^{\mu \nu})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi Q
                      %mrow
                        %mi a
                        %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P^{\mu \nu}_{a b} = \eta^{\mu \nu} Q_{a b}
                    \\,.
          #FormallyAdjointDifferentialOperators.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"}> formally adjoint differential operators
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E^\ast \to \Sigma
              for the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DualVectorBundle"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+differential+operators"} linear differential operators
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialOperator"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %msup
                      %mi P
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P, P^\ast
                    \\;\colon\;
                    \\Gamma_\Sigma(E_1)
                    \\longrightarrow
                    \\Gamma_\Sigma(E^\ast)
            %p
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"} formally adjoint differential operators
              via a
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
            #eq:FormallyAdjointDifferentialOperatorWitness.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mi p
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K \;\colon\;
                    \\Gamma_\Sigma(E) \otimes \Gamma_\Sigma(E)
                    \\longrightarrow
                    \\Gamma_\Sigma(\wedge^{p} T^\ast \Sigma)
            %p
              with values in
              %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential p-forms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialnForms"}
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 1
                    %mo ,
                    %msub
                      %mi Φ
                      %mn 2
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_1, \Phi_2 \in \Gamma_\Sigma(E)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Φ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %msub
                        %mi Φ
                        %mn 2
                      %mo −
                      %msub
                        %mi Φ
                        %mn 1
                      %mo ⋅
                      %msup
                        %mi P
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Φ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo )
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 1
                    %mo ,
                    %msub
                      %mi Φ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    P(\Phi_1) \cdot \Phi_2
                    \-
                    \\Phi_1 \cdot P^\ast(\Phi_2)
                    \\right) dvol_\Sigma
                    \\;=\;
                    d K(\Phi_1, \Phi_2)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} dvol_\Sigma
              is the
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.maruku-eqref{:href => "#eq:MinkowskiVolume"} (?)
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              denoted the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#deRhamDifferential"}
            %p
              This implies by
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#StokesTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              that under an
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P^\ast
              are related via
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
          %p
            (
            %a{:href => "Green+hyperbolic+partial+differential+equation#Khavkine14"}> Khavkine 14, def. 2.4
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#VariationaCalculusAndVariationalBicomplex
            %strong
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              and the
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
          #ReplacingBundleMorphismsByDifferentialOperators.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
                – replacing plain
                %a.existingWikiWord{:href => "/nlab/show/bundle+morphisms"} bundle morphisms
                by
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
            %p
              Various concepts in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              %em
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              (def.
              %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              below) and
              %em
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
                implicit
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              (def.
              %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              below) follow from concepts in plain
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
              by systematically replacing plain
              %a.existingWikiWord{:href => "/nlab/show/bundle+morphisms"} bundle morphisms
              by bundle morphisms out of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde D
              as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentialOperator"}
          #VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                and
                %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
                – the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              of a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              as in def.
              %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              we may consider its
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#DifferentialFormOnSuperCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#deRhamDifferential"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \;\colon\; \Omega^\bullet(J^\infty_\Sigma(E)) \longrightarrow \Omega^{\bullet+1}(J^\infty_\Sigma(E))
                    \\,.
            %p
              Since the jet bundle unifies spacetime with field values, we want to decompose this differential into a contribution coming from forming the
              %a.existingWikiWord{:href => "/nlab/show/total+derivatives"} total derivatives
              of fields along spacetime (“
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivatives"}> horizontal derivatives
              ”), and actual
              %em variation
              of fields at a fixed spacetime point (“
              %a.existingWikiWord{:href => "/nlab/show/vertical+derivatives"}> vertical derivatives
              ”):
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              is the map on
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              on the jet bundle of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d
                    \\;\colon\;
                    \\Omega^\bullet( J^\infty_\Sigma(E) )
                    \\longrightarrow
                    \\Omega^{\bullet+1}( J^\infty_\Sigma(E) )
            %p
              which on functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon J^\infty_\Sigma(E) \to \mathbb{R}
              (i.e. on 0-forms) is defined by
            #eq:SpacetimeTotalDerivativeOnSmoothFunctions.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %mi f
                          %mtd
                            %mo ≔
                            %mfrac
                              %mrow
                                %mi d
                                %mi f
                              %mrow
                                %mi d
                                %msup
                                  %mi x
                                  %mi μ
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mi μ
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi f
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi x
                                    %mi μ
                              %mo +
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi f
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi a
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                                %mi a
                              %mo +
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi f
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi ν
                                    %mi a
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi ν
                                  %mi μ
                                %mi a
                              %mo +
                              %mi ⋯
                              %mo )
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d f
                    \&amp; \coloneqq
                    \\frac{d f}{d x^\mu}
                    \\mathbf{d} x^\mu
                    \\\
                    \&amp; \coloneqq
                    \\left(
                    \\frac{\partial f}{\partial x^\mu}
                    +
                    \\frac{\partial f}{\partial \phi^a}
                    \\phi^a_{,\mu}
                    +
                    \\frac{ \partial f }{ \partial \phi^a_{,\nu}}
                    \\phi^a_{,\nu \mu }
                    +
                    \\cdots
                    \\right)
                    \\mathbf{d} x^\mu
                    \\end{aligned}
            %p
              and extended to all forms by the graded
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of degree +1.
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/vertical+derivative"} vertical derivative
            #eq:VariationalDerivative.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta
                    \\;\colon\;
                    \\Omega^\bullet( J^\infty_\Sigma(E) )
                    \\longrightarrow
                    \\Omega^{\bullet+1}( J^\infty_\Sigma(E) )
            %p
              is what remains of the full
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              when the total spacetime derivative (
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"}> horizontal derivative
              ) is subtracted:
            #eq:VerticalDerivative.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo −
                    %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \coloneqq \mathbf{d} - d
                    \\,.
            %p
              We may then extend the
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
              from functions on the jet bundle to all
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              on the jet bundle by declaring that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∘
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo ∘
                    %mi d
                  %annotation{:encoding => "application/x-tex"}
                    d \circ \mathbf{d} \;\coloneqq\; - \mathbf{d} \circ d
            %p
              which by
              %a.maruku-eqref{:href => "#eq:VerticalDerivative"} (8)
              is equivalent to
            #eq:HorizontalAndVerticalDerivativeAnticommute.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∘
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi δ
                    %mo ∘
                    %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \circ \;\delta\; = - \delta \circ d
                    \\,.
            %p For example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %mi δ
                            %mi ϕ
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %mi d
                            %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %mrow
                              %mo (
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %mi d
                              %msup
                                %mi x
                                %mi μ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %msub
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi μ
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \delta \phi
                    \&amp; =
                    \- \delta d  \phi
                    \\\
                    \&amp; =
                    \- \delta \left( \phi_{,\mu} d x^\mu \right)
                    \\\
                    \&amp; = - \delta \phi_{,\mu} \wedge d x^\mu
                    \\,.
                    \\end{aligned}
            %p
              This defines a bigrading on the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              and vertical degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mrow
                      %mo (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                    %msup
                      %mi Ω
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet\left( J^\infty_\Sigma(E) \right)
                    \\;\coloneqq\;
                    \\underset{r,s}{\oplus} \Omega^{r,s}(E)
