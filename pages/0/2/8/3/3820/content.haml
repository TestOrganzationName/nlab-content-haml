                %annotation{:encoding => "application/x-tex"} \exp(i S) : C \to \mathbb{R}/\mathbb{Z}
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            such that its 0-locus is an sub-manifold.
          %p
            Then a presentation for the homotopy fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S)
            is given by the formal dual of the
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mo ∧
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo •
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi ι
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mi d
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo [
                    %mi ⋯
                    %mo →
                    %msubsup
                      %mo ∧
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mn 2
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mi d
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mi d
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi S
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  (\wedge^{-\bullet}_{C^\infty(X)}\Gamma(T X), \iota_{(-)} d \exp(i S))
                  \=
                  \\left[
                  \\cdots \to \wedge_{C^\infty(X)}^2\Gamma(T X) \stackrel{{\iota_{(-)}d \exp(i S)}}{\to} \Gamma(T X) \stackrel{\iota_{(-)}d \exp(i S)}{\to} C^\infty(X)
                  \\right]
          %p
            concentrated in non-positive degree, which in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            has the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and whose differential is given by contracting a tangent vector with the 1-form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \exp(i S)
          %p
            This is a
            = succeed "-type" do
              %a.existingWikiWord{:href => "/nlab/show/Koszul+resolution"} Koszul resolution
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
