                %mrow
                  %mi s
                  %mo :
                  %mi E
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} s:E \to V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
