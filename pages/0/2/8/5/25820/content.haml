                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} trans
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi{:mathvariant => "normal"} sym
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} refl
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{trans}(a, b, a)(f, \mathrm{sym}(a, b)(f)) = \mathrm{refl}(a)
            %li
              %p
                for every vertex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi V
                          %mi G
                      %annotation{:encoding => "application/x-tex"} a \in V_G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msub
                        %mi V
                        %mi G
                    %annotation{:encoding => "application/x-tex"} b \in V_G
                and edge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mi E
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f:E_G(a, b)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} trans
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} sym
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} refl
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{trans}(b, a, b)(\mathrm{sym}(a, b)(f), f) = \mathrm{refl}(b)
          %p
            Every pseudo-equivalence relation has at least one subgroupoid given by only the
            %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} refl
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi E
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{refl}(a):E_A(a, a)
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of a pseudo-equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a maximal subgroupoid if the dagger functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi G
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f:G \to A
            is bijective-on-objects, and additionally if, for every other subgroupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with faithful injective-on-objects dagger functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi H
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g:H \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi H
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} h:H \to G
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
                    %mi f
                    %mo =
                    %mi g
                  %annotation{:encoding => "application/x-tex"} h \circ f = g
          %h2#category_of_pseudoequivalence_relations Category of pseudo-equivalence relations
          %p
            Let the category
            %a.existingWikiWord{:href => "/nlab/show/Set"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            be defined as a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            that is
            %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete
            and
            %a.existingWikiWord{:href => "/nlab/show/well-pointed+category"} well-pointed
            (i.e. whose
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            is a
            %a.existingWikiWord{:href => "/nlab/show/extremal+epimorphism"} extremal
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/separator"} generating object
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            %a.existingWikiWord{:href => "/nlab/show/set-level+type+theory"} set-level
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
            %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
            and
            %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            without the
            %a.existingWikiWord{:href => "/nlab/show/powerset"} powerset
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            of sets with pseudo-equivalence relations is then the
            %a.existingWikiWord{:href => "/nlab/show/exact+completion"} ex/lex completion
            of Set.
          %p
            More specifically, using the definition of pseudo-equivalence relation with two sets: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi R
                  %mo ,
                  %msub
                    %mi t
                    %mi R
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi R
                  %mo ⇉
                  %mi X
                %annotation{:encoding => "application/x-tex"} (s_R, t_R):R\rightrightarrows X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi S
                  %mo ,
                  %msub
                    %mi t
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi S
                  %mo ⇉
                  %mi Y
                %annotation{:encoding => "application/x-tex"} (s_S, t_S):S\rightrightarrows Y
            are two pseudo-equivalence relations, a morphism between them in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            is defined to be a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            with functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 1
                  %mo :
                  %mi R
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} f_1:R \to S
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi S
                  %mo ∘
                  %msub
                    %mi f
                    %mn 1
                  %mo =
                  %mi f
                  %mo ∘
                  %msub
                    %mi s
                    %mi R
                %annotation{:encoding => "application/x-tex"} s_S \circ f_1 = f \circ s_R
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi S
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi t
                      %mi R
                  %annotation{:encoding => "application/x-tex"} t_S \circ f_1 = f \circ t_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f,g:X\to Y
            to be
            %em equal
            if there exists a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} h:X\to S
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∘
                  %mi h
                  %mo =
                  %mi f
                %annotation{:encoding => "application/x-tex"} s \circ h = f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∘
                    %mi h
                    %mo =
                    %mi g
                  %annotation{:encoding => "application/x-tex"} t \circ h = g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi S
                  %mo ,
                  %msub
                    %mi t
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi S
                  %mo ⇉
                  %mi Y
                %annotation{:encoding => "application/x-tex"} (s_S, t_S):S\rightrightarrows Y
            is a pseudo-equivalence relation, this defines an actual
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on the morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            of pseudo-equivalence relations, which is the ex/lex completion of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
            We have a
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo →
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} Set\to \mathrm{PseudoEquivRel}
            sending an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the pseudo-equivalence relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi X
                    %mo ,
                    %msub
                      %mi t
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi X
                    %mo ⇉
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (s_X, t_X):X\rightrightarrows X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            is exact, that this embedding preserves finite limits, and that it is universal with respect to lex functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            into exact categories.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/presentation+axiom"} presentation axiom
            (a weak form of the full axiom of choice) holds in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} PseudoEquivRel
                  %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            could be thought of as the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/completely+presented+sets"} completely presented sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+presentation"} projective presentation
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            holds in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} PseudoEquivRel
                  %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is its own free exact completion, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            because the free functor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PseudoEquivRel
                %annotation{:encoding => "application/x-tex"} \mathrm{PseudoEquivRel}
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            This construction could be generalized to any
            %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/internal+pseudo-equivalence+relations"} internal pseudo-equivalence relations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/ex%2Flex+completion"} ex/lex completion
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi ex
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} C_{ex/lex}
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is additionally a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is its own free exact completion.
          %h2#in_type_theory In type theory
          %p
            Many
            %a.existingWikiWord{:href => "/nlab/show/set-level+type+theories"} set-level type theories
            use
            %a.existingWikiWord{:href => "/nlab/show/type"} types
            which are
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
            and thus
            %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            by default because of the inclusion of
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            or
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            to the rule system of the type theory. Sometimes, these type theories do not have
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotients
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/image+factorizations"} image factorizations
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            where not all types are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
