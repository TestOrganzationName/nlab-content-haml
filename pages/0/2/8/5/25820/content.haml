          %h3#extensional_functions_dagger_functors_and_isomorphisms Extensional functions, dagger functors, and isomorphisms
          %p
            We define an
            %strong
              %a.existingWikiWord{:href => "/nlab/show/extensional+function"} extensional function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            between two sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with pseudo-equivalence relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi A
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} sym
                    %mi A
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} trans
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_A, \mathrm{refl}_A, \mathrm{sym}_A, \mathrm{trans}_A)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi B
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi B
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} sym
                    %mi B
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} trans
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_B, \mathrm{refl}_B, \mathrm{sym}_B, \mathrm{trans}_B)
            to be a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi V
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f_V:A \to B
            and a family of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi E
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi E
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi f
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_E(a, b):E_A(a, b) \to E_B(f_V(a), f_V(b))
          %p Composition of extensional functions is defined as composition of the vertex function and of each edge function.
          %p
            An extensional function between two sets with pseudo-equivalence relations is
            %strong full
            if every edge function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi E
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi E
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi f
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi b
