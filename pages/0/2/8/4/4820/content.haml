                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi cosk
                            %mn 7
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 7
                          %mi U
                          %mo{:stretchy => "false"} (
