            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            (Prop.
            %a.maruku-ref{:href => "#QuillenEquivalenceBetweenSimplicialGroupsAndReducedSimplicialSets"}
