            %p
              Finally this means that the simplicial classifying complex
              %a.maruku-eqref{:href => "#eq:OverlineWGAsQuotientOfWG"} (4)
              of an ordinary group is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ⇉
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W}G
                    \\;\simeq\;
                    N
                    \\big(
                    G \rightrightarrows \ast
                    \\big)
                    \\,.
            %p
          %h3#ViaTotalSimplicialSets Via total simplicial sets
          %p
            Equivalently,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{W}(-)
            is the following
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi Groups
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi Groupoids
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi SimplicialSets
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi σ
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi SimplicialSets
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\overline{W}
                  \\;\colon\;
                  [\Delta^{op}, Groups]
                  \\overset
                  {\;\;[\Delta^{op}, \mathbf{B}]\;\;}
                  {\longrightarrow}
                  [\Delta^{op}, Groupoids]
                  \\overset
                  {\;\;[\Delta^{op}, N]\;\;}
                  {\longrightarrow}
                  [\Delta^{op}, SimplicialSets]
                  \\overset
                  {\;\;\sigma_\ast\;\;}
                  {\longrightarrow}
                  SimplicialSets
                  \\,.
          %p
            (
            %a{:href => "#Stevenson11"} Stevenson 11, Lemma 15
            following
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/John+Duskin"} John Duskin
            = succeed ")" do
              %a{:href => "#NSS12"} NSS 12, Def. 3.26
          %p Here:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Groups
                      %mo →
                      %mi Groupoids
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} \;\colon\; Groups \to Groupoids
                forms the one-object groupoid with
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                the given group (the
                = succeed ");" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Groupoids
                      %mo ⟶
                      %mi SimplicialSets
                    %annotation{:encoding => "application/x-tex"} N \;\colon\; Groupoids \longrightarrow SimplicialSets
                is the
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                construction;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \sigma_\ast
                is the
                = succeed "-functor" do
                  %a.existingWikiWord{:href => "/nlab/show/total+simplicial+set"} total simplicial set
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                to pre-composition with
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/ordinal+sum"} ordinal sum
          %h3#as_a_bar_construction As a bar construction
          %p
            One may understand the construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi G
                %annotation{:encoding => "application/x-tex"} W G
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#WGInComponents"}
            %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
            for the
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            that forms
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            = succeed "-actions," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a{:href => "bar+construction#UniversalPrincipalBundle"} there
            for more.
          %h2#properties Properties
          %p
            In all of the following,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is any simplicial group.
          %h3#KanFibrancy Basic properties
          %p
          #SimplicialClassifyingSpaces.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+spaces"} simplicial classifying spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              %br/
              The underlying simplicial set of any simplicial classifying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W}G
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BarWGInComponents"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          (e.g.
          = succeed ")" do
            %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, Sec. V Cor. 6.8 (p. 287)
          .proof
            %h6 Proof
            %p This follows as the combination of the following facts:
            %ol
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                  is fibrant in the projective
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  (
                  %a{:href => "model+structure+on+simplicial+groups#EveryObjectIsFibrant"}> this Prop.
                  );
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \overline{W}(-)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                  from there to the injective
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
                  (Prop.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#QuillenEquivalenceBetweenSimplicialGroupsAndReducedSimplicialSets"}
              %li
                %p
                  every injectively fibrant reduced simplicial set is a Kan complex (
                  %a{:href => "model+structure+on+reduced+simplicial+sets#FibrationsInTermsOfKanFibrations"}> this Prop.
                  ).
            %p
          %p
          #CoprojectionOutOfBorelConstructionIsKanFibration.num_prop
            %h6 Proposition
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group+action"} simplicial group action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
              to the simplicial classifying space is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mi Fib
                        %mspace{:width => "thickmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (W G \times X)/G
                    \\xrightarrow{ \;\in Fib \; }
                    \\overline{W}G
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              By the fact (
              %a{:href => "Borel+model+structure#QuillenEquivalenceToSliceOverSimplicialClassifyingSpace"}> this Prop.
              ) that the
              %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+group+actions"} model structure on simplicial group actions
              to the
              %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              over the simplicial classifying space; see
              = succeed "." do
                %a{:href => "Borel+construction#ProjectionToSimplicialClassifyingSpaceIsKanFibration"} this Example
          %p
            In particular:
          #UniversalSimplicialPrincipalBundleIsKanFibration.num_prop
            %h6 Proposition
            %p
              The coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mover
                      %mo ⟶
                      %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G \overset{}{\longrightarrow} \overline{W}G
              %a.maruku-eqref{:href => "#eq:TheUniversalSimplicialPrincipalBundle"} (5)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          (e.g
          = succeed ")" do
            %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, Sec. V Lemma 4.1 (p. 270)
          .proof
            %h6 Proof
            %p
              This is the special case of Prop.
              %a.maruku-ref{:href => "#CoprojectionOutOfBorelConstructionIsKanFibration"}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X = G
              equipped with the left multiplication
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group+action"} action
              on itself, using again that the underlying simplicial set of any simplicial group is a Kan complex (
              %a{:href => "model+structure+on+simplicial+groups#EveryObjectIsFibrant"}> this Prop.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Fib
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi W
                              %mo ¯
                            %mi G
                    %mphantom
                      %mi AAAAAA
                    %mo ≃
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mo (
                      %mi W
                      %mi G
                      %mo ×
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi G
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mo *
                        %mo )
                      %mo )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\longrightarrow&amp; W G
                    \\\
                    \&amp;&amp;
                    \\big\downarrow{}^{\mathrlap{\in Fib}}
                    \\\
                    \&amp;&amp; \overline{W}G
                    }
                    {\phantom{AAAAAA}}
                    \\simeq
                    {\phantom{AAAA}}
                    \\left(
                    W G \times
                    \\left(
                    \\array{
                    G
                    \\\
                    \\downarrow
                    \\\
                    \\ast
                    }
                    \\right)
                    \\right)
                    \\big/ G
                    \\,.
            %p
          %p
          #UniversalPrincipalSimplicialComplexIsContractible.num_prop
            %h6 Proposition
            %p
              The simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          (e.g
          = succeed "," do
            %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, Sec. V Lemma 4.6 (p. 270)
          = succeed ")" do
            %em
              %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"} décalage
          %p
          #HomotopyGroupsOfBarWG.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W} G
              are those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_n(G) \;\simeq\; \pi_{n+1}\big(\overline{W}(G)\big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#UniversalSimplicialPrincipalBundleIsKanFibration"}
              the
              %a.existingWikiWord{:href => "/nlab/show/universal+simplicial+principal+bundle"} universal simplicial principal bundle
              %a.maruku-eqref{:href => "#eq:TheUniversalSimplicialPrincipalBundle"} (5)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              between
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              (by Prop.
              %a.maruku-ref{:href => "#SimplicialClassifyingSpaces"}
              and
              = succeed ")." do
                %a{:href => "simplicial+group#EverySimplicialGroupIsAKanComplex"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              (by
              = succeed ")" do
                %a{:href => "homotopy+pullback#HomotopyPullbackByOrdinaryPullback"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo →
                      %mi hofib
                    %mi W
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi q
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G
                    \\xrightarrow{hofib}
                    W G
                    \\xrightarrow{\;\;q\;\;}
                    \\overline{W}G
                    \\,.
            %p
              This implies a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\xrightarrow{\;}
                    \\pi_{n+1}(W G)
                    \\xrightarrow{\;\;}
                    \\pi_{n+1}(\overline{W}G)
                    \\xrightarrow{\;\;}
                    \\pi_n(G)
                    \\xrightarrow{\;\;}
                    \\pi_n(W G)
                    \\xrightarrow{\;}
                    \\cdots
                    \\,.
            %p
              But Prop.
              %a.maruku-ref{:href => "#UniversalPrincipalSimplicialComplexIsContractible"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(W G)
              is
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\xrightarrow{\;\;}
                    \\pi_{n+1}(\overline{W}G)
                    \\xrightarrow{\;\simeq\;}
                    \\pi_n(G)
                    \\xrightarrow{\;\;}
                    0
            %p which exhibit the claim to be proven.
          %p
          #DeloopedKanFibrationOfHomomorphismOfSimplicialGroups.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %mo →
                      %mi ϕ
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \xrightarrow{\phi} \mathcal{G}_2
              be a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
              which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+spaces"} simplicial classifying spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mover
                      %mi W
                      %mo ¯
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \overline{W}\mathcal{G}_1 \xrightarrow{ \overline{W}(\phi)} \overline{W}\mathcal{G}_2
              is a
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒢
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↠
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒢
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0(\phi) \colon \pi_0(\mathcal{G}_1) \twoheadrightarrow{\;} \pi_0(\mathcal{G}_1)
          (
          %a{:href => "#GoerssJardine09"}> Goerss &amp; Jardine, Ch. V, Cor. 6.9
          , see the proof
          = succeed ")" do
            %a{:href => "model+structure+on+reduced+simplicial+sets#DeloopedKanFibrationOfHomomorphismOfSimplicialGroups"} here
          %h3#ClassificationOfSimplicialPrincipalBundles Classification of simplicial principal bundles
          %p
            The object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} \overline{W}G
            serves as the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundles"} simplicial principal bundles
            (
            %a{:href => "#May67"}> May 67, §21
            ,
            = succeed "," do
              %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, Section V, Thm. 3.9
            = succeed ")." do
              %a{:href => "#NSS12"} NSS 12, Section 4.1
          %h3#quillen_equivalence_between_simplicial_groups_and_reduced_simplicial_sets Quillen equivalence between simplicial groups and reduced simplicial sets
          %p
          #QuillenEquivalenceBetweenSimplicialGroupsAndReducedSimplicialSets.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence+between+simplicial+groups+and+reduced+simplicial+sets"}> Quillen equivalence between simplicial groups and reduced simplicial sets
                )
              %br/
              The
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{W}(-)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BarWGInComponents"}
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              in a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
              and the injective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Groups
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ≃
                          %mpadded{:width => "0"}
                            %mi Qu
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mover
                          %mi W
                          %mo ¯
                      %mover
                        %mo ⟵
                        %mi Ω
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sSet
                      %mrow
                        %mo ≥
                        %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi inj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Groups(sSet)_{proj}
                    \\underoverset
                    {\underset{\overline{W}}{\longrightarrow}}
                    {\overset{ \Omega }{\longleftarrow}}
                    {\;\;\;\;\; \simeq_{\mathrlap{Qu}} \;\;\;\;\;}
                    (sSet_{\geq 0})_{inj}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is the
              = succeed "-construction." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+loop+space"} simplicial loop space
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, V Prop. 6.3
          %h3#SliceModelStructure Slice model structure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/slice+model+category"} slice model category
            of the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            over the simplicial classifying complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} \overline{W}G
            is
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to the
            %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi SimplicialSets
                    %mi Qu
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mover
                        %mi W
                        %mo ¯
                      %mi G
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ≃
                    %mi Qu
                  %mspace{:width => "thickmathspace"}
                  %mi G
                  %mi Actions
                  %mo{:stretchy => "false"} (
                  %mi SimplicialSets
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\big(
                  SimplicialSets_{Qu}
                  \\big)_{/\overline{W} G}
                  \\;\simeq_{Qu}\;
                  G Actions(SimplicialSets)_{proj}
                  \\,.
          %p
            (
            %a{:href => "#DDK80"}> Dror, Dwyer &amp; Kan 1980
            ) See
            %a{:href => "Borel+model+structure#RelationToSliceOverSimplicialClassifyingSpace"} there
            for details. This is a model for the general abstract situation discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+loop+functor"} simplicial loop functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+of+classifying+space"} free loop space of classifying space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"}> simplicial principal bundle
                ,
                %a.existingWikiWord{:href => "/nlab/show/universal+simplicial+principal+bundle"} universal simplicial principal bundle
          %h2#references References
          %p
            The idea of constructing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{W}
            using the
            %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
            is due
          %ul
            %li#EilenbergMacLane53I
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"} Saunders Mac Lane
              = succeed "," do
                %em
                  On the Groups
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi Π
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} H(\Pi,n)
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/1969820"} jstor:1969820
          %p
            who apply it to
            %a.existingWikiWord{:href => "/nlab/show/simplicial+rings"} simplicial rings
            with the usual
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            operation. This was also later discussed in:
          %ul
            %li#MacLane54
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              = succeed "," do
                %em Constructions simpliciales acycliques
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/MacLaneConstructionsSimplicialesAcycliques.pdf", :title => "pdf"} pdf
          %p
            The first reference where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{W}
            is defined explicitly for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            and the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            between
            %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            and
            %a.existingWikiWord{:href => "/nlab/show/reduced+simplicial+sets"} reduced simplicial sets
            is explicitly spelled out:
          %ul
            %li#Kan58
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"}> Daniel Kan
              , Sections 10-11 in:
              = succeed "," do
                %em On homotopy theory and c.s.s. groups
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/1970042"} jstor:1970042
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/simplicial+loop+space"} simplicial loop space
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is also discussed by
            %a.existingWikiWord{:href => "/nlab/show/Kan"} Kan
            (there denoted “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            ”) in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+M.+Kan"}> Daniel M. Kan
              , §7 of:
              = succeed "," do
                %em A combinatorial definition of homotopy groups
              = succeed "." do
                %a{:href => "https://doi.org/10.2307/1970006"} doi
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            was established in
          %ul
            %li#Quillen69
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              , Section 2 of:
              = succeed "," do
                %em Rational homotopy theory
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/1970725"} jstor:1970725
          %p Textbook accounts:
          %ul
            %li#May67
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , p. 87-88 in:
                = succeed "," do
                  %em Simplicial objects in algebraic topology
                = succeed "," do
                  %a{:href => "https://press.uchicago.edu/ucp/books/book/chicago/S/bo5956688.html"} ISBN:9780226511818
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/Simp.djvu"} djvu
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/May_SimplicialObjectsInAlgebraicTopology.pdf", :title => "pdf"} pdf
            %li#GoerssJardine09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"} J. F. Jardine
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
                = succeed "," do
                  %a{:href => "https://link.springer.com/book/10.1007/978-3-0346-0189-4"} doi:10.1007/978-3-0346-0189-4
                = succeed ")" do
                  %a{:href => "http://web.archive.org/web/19990208220238/http://www.math.uwo.ca/~jardine/papers/simp-sets/"} webpage
          %p Streamlining:
          %ul
            %li#Stevenson11
              %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
              , around Lemma 15 of:
              = succeed "," do
                %em Décalage and Kan’s simplicial loop group functor
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1112.0474"} arXiv:1112.0474
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/26/28/26-28abs.html"} tac:26-28
          %p
            Identification of the
            %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} \overline{W}G
            with the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
          %ul
            %li#DDK80
              %a.existingWikiWord{:href => "/nlab/show/Emmanuel+Dror"}> Emmanuel Dror
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"} William Dwyer
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              = succeed "," do
                %em Equivariant maps which are self homotopy equivalences
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/2043448"} jstor:2043448
          %p
            Generalization to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"} simplicial groupoids
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the
            = succeed "-construction:" do
              %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+loop+groupoid"} Dwyer-Kan loop groupoid
          %ul
            %li#DwyerKan84
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              = succeed "," do
                %em Homotopy theory and simplicial groupoids
              %strong 87
              4 (1984) 379-385 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/1385-7258(84)90038-6"}> doi:10.1016/1385-7258(84)90038-6
              \&amp;rbrack;
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
          %ul
            %li#NSS12
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Principal+%E2%88%9E-bundles+--+theory%2C+presentations+and+applications"} Principal ∞-bundles – Presentations
              = succeed "," do
                %a{:href => "http://link.springer.com/article/10.1007/s40062-014-0077-4"} doi:10.1007/s40062-014-0077-4
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1207.0249"} arXiv:1207.0249
