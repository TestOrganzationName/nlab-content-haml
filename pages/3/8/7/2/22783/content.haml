                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        (\overline{W}G)_n
                        \\;\coloneqq\;
                        G_{n-1} \times \cdots \times G_1 \times G_0
                        \\,;
              %li
                %p face maps are given by:
                #eq:FaceMapsOfbarWG.maruku-equation
                  %span.maruku-eq-number (6)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
