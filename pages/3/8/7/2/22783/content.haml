                                %mspace{:width => "thinmathspace"}
                                %mi e
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi g
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mi i
                                    %mo −
                                    %mn 1
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %mi ⋯
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi g
                                  %mn 0
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \&amp;
                        s_i(g_n, g_{n-1}, \cdots, g_0)
                        \\\
                        \&amp;
                        \\;\coloneqq\;
                        \\big(
                        s_i(g_n),
                        \\,
                        s_{i - 1}(g_{n-1}),
                        \\,
                        \\cdots,
                        \\,
                        s_0(g_{n-i}),
                        \\,
                        e,
                        \\,
                        g_{n-i-1},
                        \\,
                        \\cdots,
                        \\,
                        g_0
                        \\big)
                        \\,,
                        \\end{aligned}
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                      %annotation{:encoding => "application/x-tex"} e
                  denotes the respective
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            %p
              This carries a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by left multiplication on the top degree component:
            #eq:GActionOnWG.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %mi W
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi h
                              %mi n
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mi n
                            %mo ,
                            %msub
                              %mi g
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi g
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mi n
                            %mo ⋅
                            %msub
                              %mi g
                              %mi n
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi g
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi g
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G \times W G &amp;\overset{}{\longrightarrow}&amp; W G
                    \\\
                    \\big(h_n, (g_n, g_{n-1}, \cdots, g_0)\big)
                    \&amp;\mapsto&amp;
                    (h_n \cdot g_n, \, g_{n-1}, \cdots, g_0)
                    \\mathrlap{\,.}
                    }
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              It is the straightforward simplicial incarnation of the left
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.maruku-eqref{:href => "#eq:GActionOnWG"} (3)
              that singles out the model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WGInComponents"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/groupal+model+for+universal+principal+simplicial+complex"} groupal model for universal principal simplicial complex
          %p
          #BarWGInComponents.num_defn
            %h6 Definition
            %p
              %strong (standard simplicial classifying complex)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %em standard simplicial classifying complex
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WGInComponents"}
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.maruku-eqref{:href => "#eq:GActionOnWG"} (3)
            #eq:OverlineWGAsQuotientOfWG.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W} G
                    \\;\coloneqq\;
                    (W G) / G
                    \\,.
            %p
              The corresponding quotient
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              is, manifestly,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            #eq:TheUniversalSimplicialPrincipalBundle.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo ↪
                              %mi fib
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi W
                              %mo ¯
                            %mi G
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo ≔
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mi G
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} /
                                %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\xhookrightarrow{fib}&amp; W G
                    \\\
                    \&amp;&amp; \big\downarrow
                    \\\
                    \&amp;&amp; \overline{W} G \mathrlap{\; \coloneqq (W G)/G}
                    }
            %p
              is known as the standard model for the simplicial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              (see
              = succeed ")." do
                %a{:href => "#ClassificationOfSimplicialPrincipalBundles"} below
            %p#StructureMapsOfSimplicialClassifyingComplex
              This means, under the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mi n
                    %mo ×
                    %msub
                      %mi G
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi G
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi G
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi G
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\overline{W}G
                    \\big)_{n}
                    \\;\coloneqq\;
                    (W G)_n/G_n
                    \\;\simeq\;
                    G_n/G_n \times G_{n-1} \times \cdots \times G_0
                    \\;\simeq\;
                    G_{n-1} \times \cdots \times G_{0}
                    \\,,
            %p
              that the above face maps
              %a.maruku-eqref{:href => "#eq:FaceMapsOfWG"} (1)
              and degeneracy maps
              %a.maruku-eqref{:href => "#eq:DegeneracyMapsOfWG"} (2)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              imply the following structure maps on the simplicial classifying complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
