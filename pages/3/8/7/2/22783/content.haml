                                              %mspace{:width => "thinmathspace"}
                                              %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \&amp;
                        s_i(g_{n-1}, \cdots, g_0)
                        \\\
                        \&amp;
                        \\;\coloneqq\;
                        \\left\{
                        \\array{
                        \\big(
                        e,
                        \\,
                        g_{n-1},
                        \\,
                        \\cdots,
                        \\,
                        g_0
                        \\big)
                        \&amp; \text{if} &amp;
                        i = 0
                        \\\
                        \\big(
                        s_{i - 1}(g_{n-1}),
                        \\,
                        \\cdots,
                        \\,
                        s_0(g_{n-i}),
                        \\,
                        e,
                        \\,
                        g_{n-i-1},
                        \\,
                        \\cdots,
                        \\,
                        g_0
                        \\big)
                        \&amp; \text{if} &amp;
                        0 \lt i
                        \\mathrlap{\,.}
                        }
                        \\right.
                        \\end{aligned}
            %p
          %p
            (This goes back to
            = succeed "," do
              %a{:href => "#MacLane54"} MacLane 1954, p. 3
            = succeed ";" do
              %a{:href => "#Kan58"} Kan 1958, Def. 10.3
            = succeed ".)" do
              %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 1999/2009, p. 269
          %p
            More generally:
          #BarWForSimplicialGroupoid.num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              a Dwyer-Kan
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \overline{W}\mathcal{G}
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              with
            %ol
              %li
                %p
                  set of vertices (0-cells) equal to the set of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %li
                %p
                  set of
                  %a.existingWikiWord{:href => "/nlab/show/n-simplex"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-simplices
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n \geq 1
                  equal to sequences of morphisms of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi n
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %msub
                          %mi x
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mrow
                                %mi n
                                %mo −
                                %mn 2
                        %msub
                          %mi x
                          %mrow
                            %mi n
                            %mo −
                            %mn 2
                        %mo →
                        %mi ⋯
                        %mo →
                        %msub
                          %mi x
                          %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mn 0
                        %msub
                          %mi x
                          %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        x_n
                        \\overset{f_{n-1}}{\longrightarrow}
                        x_{n-1}
                        \\overset{f_{n-2}}{\longrightarrow}
                        x_{n-2}
                        \\to \cdots \to
                        x_1
                        \\overset{f_{0}}{\longrightarrow}
                        x_0
                %p where
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi x
                              %mi i
                            %mo ∈
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒢
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} x_i \in Obj(\mathcal{G})
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi f
                              %mi k
                            %mo ∈
                            %mi Mor
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒢
                              %mi k
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} f_k \in Mor(\mathcal{G}_k)
            %p
          \&amp;lbrack;
          %a{:href => "#DwyerKan84"}> Dwyer &amp; Kan 1984, §3.2
          \&amp;rbrack;
          %p
          #Decalage.num_remark
            %h6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"}> décalage
                )
              %br/
              Conversely, comparison of Def.
              %a.maruku-ref{:href => "#BarWGInComponents"}
              with Def.
              %a.maruku-ref{:href => "#WGInComponents"}
              shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              is obtained from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W} G
              by shifting down in degree and discarding the 0th face- and degeneracy maps:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (W G)_{n} \;\simeq\; (\overline{W}G)_{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi d
                              %mi i
                              %mrow
                                %mi W
                                %mi G
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi d
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                              %mrow
                                %mover
                                  %mi W
                                  %mo ¯
                                %mi G
                        %mtr
                          %mtd
                            %msubsup
                              %mi s
                              %mi i
                              %mrow
                                %mi W
                                %mi G
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi s
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                              %mrow
                                %mover
                                  %mi W
                                  %mo ¯
                                %mi G
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d^{W G}_i &amp; \;=\; d^{ \overline{W}G }_{i+1}
                    \\\
                    s^{W G}_i &amp; \;=\; s^{\overline{W}G}_{i + 1}
                    \\mathrlap{\,.}
                    \\end{aligned}
            %p
              One refers to this relation as saying that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"} décalage
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi W
                        %mo ¯
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \overline{W}G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Dec
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W G \;=\; Dec^0\big( \overline{W}G  \big)
                    \\,.
            %p
              See the example
              = succeed "." do
                %a{:href => "decalage#ExampleForSimplicialClassifyingSpaces"} there
            %p
          %p
