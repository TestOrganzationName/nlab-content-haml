                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi SimplicialSets
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W}G
                    \\;\;\;
                    \\in
                    \\;
                    SimplicialSets
            %ul
              %li
                %p underlying sets are
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi W
                          %mo ¯
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} )
