                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{W}(-)
            is
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the standard
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+loop+space"} simplicial loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (here denoted by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            to avoid a clash of notations).
          %p
            This pair of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SimplicialGroups
                  %munderover
