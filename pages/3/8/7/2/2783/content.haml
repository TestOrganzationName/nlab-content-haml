                )
          %ul#Shulman
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
              , “Exact completions and small sheaves”.
              = succeed "," do
                %em Theory and Applications of Categories
              %a{:href => "http://www.tac.mta.ca/tac/volumes/27/7/27-07abs.html"} Free online
          %ul#vdB
            %li
              %a.existingWikiWord{:href => "/nlab/show/Benno+van+den+Berg"}> Benno van den Berg
              ,
              = succeed "," do
                %em Inductive types and exact completion
              = succeed ")" do
                %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.18.5456&rep=rep1&type=pdf"} online .pdf file
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  For example, let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %msup
                          %mi Set
                          %mrow
                            %mo •
                            %mo ⇉
                            %mo •
                      %annotation{:encoding => "application/x-tex"} C = Set^{\bullet \rightrightarrows \bullet}
                  be the topos of
                  = succeed "." do
