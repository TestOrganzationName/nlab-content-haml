                = succeed "," do
                  %em Regular and exact completions
                %strong 125
                1–3 (1998) 79-116 (
                %a{:href => "https://doi.org/10.1016/S0022-4049(96)00115-6"}> doi:10.1016/S0022-4049(96)00115-6
                )
