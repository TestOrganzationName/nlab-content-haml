          %h2#idea Idea
          %p
            A
            %em
              super
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            is an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            modeled on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
          %p
            The notion subsumes and generalizes that of
            %em bare
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+groups"} super groups
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+groups"} super Lie groups
            %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
            sitting over the base of super
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h2#definition Definition
          #SuperInfinityGroupoids.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperPoints
                  %annotation{:encoding => "application/x-tex"} SuperPoints
              be the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with trivial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperPoint
                  %annotation{:encoding => "application/x-tex"} SuperPoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Super
                    %mn ∞
                    %mi Grpd
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Super\infty Grpd := Sh_{(\infty,1)}(SuperPoint)
            %p
              we call the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of
              = succeed "." do
                %strong
                  super
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %h2#properties Properties
          %h3#InfinitesimalCohesion Infinitesimal cohesion
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Super
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} Super\infty Grpd
              = succeed "," do
                %a.maruku-ref{:href => "#SuperInfinityGroupoids"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesive+%28%E2%88%9E%2C1%29-topos"} infinitesimal cohesive (∞,1)-topos
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          .proof
            %h6#proof Proof
            %p
              Being an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              the constant
              = succeed "-presheaf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn ∞
                    %mi Grpd
                    %mo ⟶
                    %mi Super
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    Disc \;\colon\; \infty Grpd \longrightarrow Super \infty Grpd
            %p
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              given by forming
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              and a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperPoints
                  %annotation{:encoding => "application/x-tex"} SuperPoints
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              (the point
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0|0}
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is just given by evaluation at that object.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi X
                      %mo ≃
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma X \simeq X(\ast)
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ∘
                    %mi Disc
                    %mo ≃
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} \Gamma\circ Disc \simeq Id
              and hence (by the discussion at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
            %p
              Moreover, evaluation preserves
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              (since for
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
              there are computed objectwise for each object of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor+theorem"} adjoint (∞,1)-functor theorem
              there does exist a further
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                      %mo{:lspace => "verythinmathspace"} :
                      %mn ∞
                      %mi Grpd
                      %mo ↪
                      %mi Super
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} coDisc \colon \infty Grpd \hookrightarrow Super \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              and by
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjointness
              this sends an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mi Super
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    coDisc(X)
                    \\;\colon\;
                    \\mathbb{R}^{0|q}
                    \\;\mapsto\;
                    Super\infty Grpd(\mathbb{R}^{0|q}, coDisc(X))
                    \\simeq
                    \\infty Grpd(\Gamma(\mathbb{R}^{0|q}), X)
                    \\,.
            %p
