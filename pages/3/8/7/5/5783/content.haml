                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0|q}
            %p
              Over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
