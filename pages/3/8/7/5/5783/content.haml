                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Proper+Orbifold+Cohomology"} Proper Orbifold Cohomology
                (
                %a{:href => "https://arxiv.org/abs/2008.01101"}> arXiv:2008.01101
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
