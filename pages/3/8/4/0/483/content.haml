                    %mo ≤
                    %mi r
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \leq r
          %p
            If such a definition exists, it may need to use
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/filtered+topological+space"} filtered topological space
          %p
            Even in the absence of a homotopy-theoretic definition of
            = succeed "-directed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            and
            %em define
            a (nice)
            = succeed "-directed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,r)-category
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            to
            %em define
            a nice
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            to be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
            for more on that.
          %h2#variants Variants
          %h3#spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            \-Spaces
          %p
            A
            %strong directed topological space
            or
            %strong d-space
            is pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi d
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, d X)
            consisting of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi X
                  %mo ⊂
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d X \subset C(I,X)
            of continuous maps from the interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0,1]
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – called
            %em directed paths
            or d-paths – satisfying the following conditions:
          %ol
            %li
              %p
                (constant paths) every constant map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} I\to X
                is directed,
            %li
              %p
                (reparametrisation)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dX
                    %annotation{:encoding => "application/x-tex"} dX
                is closed under composition with increasing maps
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo →
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I\to I
            %li
              %p
                (concatenation)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dX
                    %annotation{:encoding => "application/x-tex"} dX
                is closed under path concatenation: if the d-paths
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a, b
                are consecutive in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a(1) = b(0))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a+b
                is also a d-path
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo +
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mtext if
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (a+b)(t) = a(2t),\,\text{if}\, 0\le t\le \frac{1}{2},
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo +
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi b
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi t
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mtext if
                  %mspace{:width => "thinmathspace"}
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a+b)(t) = b(2t-1),\,\text{if}\, \frac{1}{2}\le t\le 1.
          %p
            A
            %strong morphism of directed topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi d
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi d
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : (X, d X)\to (Y , d Y)
            is a morphism of topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            which preserves directed paths, in that, for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi I
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma: I \to X
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi X
                  %annotation{:encoding => "application/x-tex"} d X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi γ
                  %mo :
                  %mi I
                  %mover
                    %mo →
                    %mi γ
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f_* \gamma : I \stackrel{\gamma}{\to} X \stackrel{f}{\to} Y
            is in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} d Y
          %p
          .num_remark
            %h6 Example
            %p
              Basic examples of
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            %ul
              %li
                %p
                  The
                  %em standard directed interval
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi d
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi d
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I_d = ([0,1], d I)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi I
                      %annotation{:encoding => "application/x-tex"} d I
                  the set of all
                  %em monotonic
                  continuous maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [0,1] \to [0,1]
              %li
                %p
                  Any
                  %a.existingWikiWord{:href => "/nlab/show/pospace"} pospace
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  gives rise to a d-space by taking the directed paths to be, well, directed paths, i.e., continuous order-preserving maps from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi d
                      %annotation{:encoding => "application/x-tex"} I_d
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p Many other example can be found in the references.
          %h3#streams Streams
          %p
            A different definition comes from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Sanjeevi+Krishnan"} Sanjeevi Krishnan
            = succeed "," do
              %em A Convenient Category of Locally Preordered Spaces
            = succeed "):" do
              %a{:href => "https://arxiv.org/abs/0709.3646"} arxiv
          %p
            %strong Definition
            A
            %strong stream
            is a tuple
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %msub
                      %mo ≤
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X, \leq_{-}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ≤
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} \leq_{-}
            assigns to each open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            a preorder
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ≤
                      %mi U
                  %annotation{:encoding => "application/x-tex"} \leq_U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ≤
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                        %mi i
                      %msub
                        %mi U
                        %mi i
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mi i
                  %msub
                    %mo ≤
                    %mrow
                      %msub
                        %mi U
                        %mi i
                %annotation{:encoding => "application/x-tex"} \leq_{\bigcup_i U_i} = \bigvee_i \leq_{U_i}
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ,
                  %mi i
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} U_i, i \in I
            is a collection of open sets, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                %annotation{:encoding => "application/x-tex"} \bigvee
            is the pointwise
            %em or
            of relations.
          %p
            %em Remarks
          %ul
            %li
              Morally, a point in a stream is less or equal to another point if it is less or equal in any open set. The relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ≤
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \leq_X
              for the whole space does not hold much information.
            %li
              In the typical example of the clockwise oriented circle, each point is less or equal to every other one in the relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ≤
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \leq_{S^1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} U \subset S^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is less or equal than
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              can be reached from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in a monotonous clockwise path.
            %li The defining equation of a stream can be thought of as a (co)sheaf condition, and there is indeed a cosheafification result.
            %li Every d-space gives rise to a stream.
            %li The category of streams has good properties. In particular, there is an further notion of compactly flowing streams_ extending the notion of compactly generated Hausdorff spaces, and indeed the forgetful functor creates limits and colimits.
            %li The category of compactly flowing streams is Cartesian closed.
          %h3#framed_spaces Framed spaces
          %h4#motivation Motivation
          %p
            Another way to endow spaces with directions is via
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/frame+of+a+vector+space"} framings
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/projection#in_linear_algebra"} projections
          %p
          .num_remark
            %h6 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              with an
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are equivalent.
            %ul
              %li
                An orthonormal frame of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                      %annotation{:encoding => "application/x-tex"} v_i
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi i
                        %mo ≤
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mi i
                        %mo ,
                        %msub
                          %mi v
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi δ
                          %mi ij
                      %annotation{:encoding => "application/x-tex"} g(v_i,v_j)=\delta_{ij}
              %li
                A sequence of surjections
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi i
                        %mo →
                        %msub
                          %mi V
                          %mrow
                            %mi i
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} V_i \to V_{i-1}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi i
                        %mo ≤
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi i
                    %annotation{:encoding => "application/x-tex"} V_i
                is an oriented
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi n
                        %mo =
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V_n = V
            %p
              The two structures are related by setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i
              to be the unit vector spanning
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo →
                    %msub
                      %mi V
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ker(V_i \to V_{i-1})
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo ⊕
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_{i-1} \oplus v_i
              recovers the orientation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_i
              (note that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_i
              canonically embed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              as the orthogonal complement of the kernel of the composite map
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %msub
                        %mi V
                        %mi i
                    %annotation{:encoding => "application/x-tex"} V \to V_i
            %p
              In the absence of inner products, one cannot speak of orthonormal frames any longer. However, sequences of projections can still be defined, and may be regarded as playing the role of “metric-free orthonormal” frames. (A vaguely analogous line of thinking is that a
              %a.existingWikiWord{:href => "/nlab/show/Morse+function"} Morse function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} M \to \mathbb{R}
              provides useful “direction” information on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
          %p
          .num_remark
            %h6 Example
            %p
              The standard orthonormal frame of
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              consists for the ordered sequence of vectors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 0
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e_1 = (1,0,...,0)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 2
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 0
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e_2 = (0,1,0,...,0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi n
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e_n = (0,...,0,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo :
                    %msup
                      %mi ℝ
                      %mi i
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo ×
                    %mi ℝ
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_i : \mathbb{R}^i = \mathbb{R}^{i-1} \times \mathbb{R} \to \mathbb{R}^{i-1}
              (each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^i
              being endowed with standard orientation).
          %p
            When forgetting basepoints, then the previous remark and example equally apply to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            (or rather
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            patches of it, that interact nicely with the projections, see below) as our “local models” for framed spaces one may define global framed spaces and their maps.
          %h4#definition Definition
          %p
          .num_defn
            %h6 Terminology
            %p
              Inductively in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-framed patch
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}^n
              is a non-empty subspace of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              with the property that its projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(U)
              is an
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo :
                    %mi U
                    %mo →
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n : U \to \pi_n(U)
              has fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}_n(x)
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mo −
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi γ
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\gamma_-(u),\gamma_+(u)]
              for two continuous sections
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mo ±
                      %mo :
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \gamma_\pm : \pi_n(U) \to \pi_n(U) \times \mathbb{R}
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %em
                (partial)
                = succeed "-framed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi U
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} F : U \to V
              is a (partial) continuous map which descends along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \pi_n
              to a (partial)
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo :
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{n-1} : \pi_n (U) \to \pi_n(V)
              such that mappings of fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msubsup
                      %mi π
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi π
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : \pi^{-1}_n(x) \to \pi^{-1}_n(F_{n-1}(x))
              are monotone.
          %p
            Note that
            = succeed "-framed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            and
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            spaces.
          %p
          .num_remark
            %h6 Example
            %p
              The standard example of an
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mi n
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi n
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbf{I}^n = [-1,1]^n \subset \mathbb{R}^n
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-dimensional\u201D:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \{0\} \times \mathbf{I}^{n-1}
              of the
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-directed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mi k
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbf{I}_k := \{0\}^{k-1} \times \mathbf{I} \times \{0\}^{n-k}
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a topological space. Fix
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ul
              %li
                %p
                  An
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-framed chart
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (U,\gamma)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is an embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo :
                        %mi U
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \gamma : U \hookrightarrow \mathbb{R}^n
                  of a subspace
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  whose image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \im(\gamma)
                  is an
                  = succeed "-framed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  Two
                  = succeed "-framed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi γ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (U,\gamma)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V,\rho)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  are
                  %em compatible
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo ∘
                        %msup
                          %mi γ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \rho \circ \gamma^{-1}
                  is a partial map of
                  = succeed "-framed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-framed space
              is a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              endowed with an
              = succeed "-framing" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ,
                    %msub
                      %mi γ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(U_i,\gamma_i)\}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              are a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite"} locally finite
              cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
          .num_remark
            %h6 Remark
            %p
              The condition for covers to be locally finite is convenient as it describes the situation of locally finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complexes
          %p Maps of framed spaces could be defined along the following lines.
          %p
          .num_defn
            %h6 Definition
            %p
              Given spaces with
              = succeed "-framing" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\mathcal{A}) \to (Y,\mathcal{B})
              then a
              %strong framed map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} F : X \to Y
              is a map such that for any charts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} (U,\gamma) \in \mathcal{A}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} (V,\rho) \in \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              yields a partial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∘
                    %mi F
                    %mo ∘
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi{:mathvariant => "normal"} im
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} im
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \circ F \circ \gamma^{-1} : \mathrm{im}(\gamma) \to \mathrm{im}(\rho)
              of
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
            Framed spaces and framed maps are, in a sense, “very rigid” variants of directed spaces. Nonetheless, they are interesting to study as they turn out to have a rich
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/framed+combinatorial+topology"} combinatorial theory associated to them
            %a.existingWikiWord{:href => "/nlab/show/manifold+diagram"} manifold diagrams
            in the language of framed spaces.
          %p
          .num_remark
            %h6 Example
            %p
              Realizations of
              %a.existingWikiWord{:href => "/nlab/show/geometric+computad"} geometric computads
              (resp. their functors) have the structure of framed spaces (resp. of framed maps), see
              = succeed "." do
                %a{:href => "#Dorn23"} Dorn23
          %h4#comparison_to_spaces
            Comparison to
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %p
          .num_remark
            %h6 Remark
            %p
              One may want to define directed paths in an
              = succeed "-framed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              different framed intervals, corresponding to the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              possible directions of
              = succeed "-framings." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-patches" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbf{I}_k
              mentioned in a previous example. Note, there is a framed bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mi k
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \mathbf{I}_k \to \mathbf{I}_j
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi j
                  %annotation{:encoding => "application/x-tex"} k \leq j
              (in particular, directions aren’t interchangeable at all: analogously, note that in an
              %a.existingWikiWord{:href => "/nlab/show/n-category"} n-category
              a
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-k)
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-j)
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mi j
                    %annotation{:encoding => "application/x-tex"} k \leq j
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi k
                      %mi X
                      %mo =
                      %msub
                        %mi{:mathvariant => "normal"} Map
                        %mi{:mathvariant => "normal"} fr
                      %mo{:stretchy => "false"} (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mi k
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_k X = \mathrm{Map}_{\mathrm{fr}}(\mathbf{I}_k, (X,\mathcal{A}))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi n
                    %mi X
                    %mo ⊂
                    %msub
                      %mi d
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi X
                    %mo ⊂
                    %mo .
                    %mo .
                    %mo .
                    %mo ⊂
                    %msub
                      %mi d
                      %mn 1
                    %mi X
                    %mo ⊂
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Map
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d_n X \subset d_{n-1} X \subset ... \subset d_1 X \subset \Map(\mathbf{I},X)
            %p
              instead of a single path subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dX
                      %mo ⊂
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Map
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} dX \subset \Map(\mathbf{I},X)
              = succeed "-spaces." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
