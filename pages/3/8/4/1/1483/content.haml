                    %path{:d => "M 6.179461 -29.106198 L 6.183377 18.195991 ", :style => "fill:none;stroke-width:1.83812;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(100%,100%,100%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997493,0,0,-0.997493,103.976657,42.115214)"}
                  %path{:d => "M -1.551902 3.06837 C -0.800017 1.447118 1.228506 0.0569138 2.387662 -0.00182719 C 1.228506 -0.0566521 -0.800017 -1.446856 -1.551902 -3.068109 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0,-0.997493,-0.997493,0,110.142709,23.963707)"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "113.649345", "xlink:href" => "#LJEcnwARqBQEDj-V4xWgSbaDnHc=-glyph1-6", :y => "51.187411"}
          %p
            In the case of a topological space, and sheaves of sets (or algebras of some kind), there is another description in terms of stalks, namely comorphisms may be described as certain
            %a.existingWikiWord{:href => "/nlab/show/multivalued+function"} multi-valued maps
            between stalks. More precisely, given a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            and sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msup
                    %mi f
                    %mo ♯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,f^\sharp)
            is a collection of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi f
                    %mi x
                    %mo ♯
                  %mo :
                  %msub
                    %mi G
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mi x
                %annotation{:encoding => "application/x-tex"} f^\sharp_x : G_{f(x)}\to F_{x}
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x\in X
            such that for any
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s\in G(V)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi{:mathvariant => "normal"} open
                  %mo ⊂
                  %mi Y
                %annotation{:encoding => "application/x-tex"} V^{\mathrm{open}}\subset Y
            the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msubsup
                    %mi f
                    %mi x
                    %mo ♯
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\mapsto f^\sharp_x(s(f(x)))
            is a section of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi f
                    %mi x
                    %mo ♯
                %annotation{:encoding => "application/x-tex"} f^{\sharp}_x
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\in f^{-1}(y)
            for a fixed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            as a single multi-valued map of stalks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi y
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi F
                    %mi x
                %annotation{:encoding => "application/x-tex"} G_y\to \coprod_{x\in f^{-1}(y)} F_x
            satisfying the continuity constraint mentioned.
          %h2#remarks Remarks
          %ol
            %li
              %p
                Notice that by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msub
                        %mi f
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G\to f_* F
                of sheaves of sets over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                corresponds to a unique morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mi G
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} f^* G\to F
                of sheaves of sets over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                In the case of sheaves of sets, the
                = succeed "-component" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi G
                      %mo :
                      %mi G
                      %mo →
                      %msub
                        %mi f
                        %mo *
                      %msup
                        %mi f
                        %mo *
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \eta_G :G\to f_* f^* G
                is clearly a comorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msup
                        %mi f
                        %mo *
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G\to f^* G
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi G
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} (f,k):G\to F
                (i.e.
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo :
                        %mi G
                        %mo →
                        %msub
                          %mi f
                          %mo *
                        %mi F
                      %annotation{:encoding => "application/x-tex"} k:G\to f_* F
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi η
                            %mi G
                      %msup
                        %mi f
                        %mo *
                      %mi G
                      %mover
                        %mo →
                        %mrow
                          %mi k
                          %mo ∘
                          %msubsup
                            %mi η
                            %mi G
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mi F
                    %annotation{:encoding => "application/x-tex"}
                      G\stackrel{\eta_G}\to f^* G\stackrel{k\circ\eta_G^{-1}}\to F
              %p
                where the first map is a (canonical) comorphism over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and the second map is a morphism of sheaves over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "-comorphism" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                of sheaves of sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G\to F
                into a compositon of an
                = succeed "-comorphism" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msup
                        %mi f
                        %mo *
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G\to f^*G
                and a morphism of sheaves of sets over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msub
                        %mi f
                        %mo *
                      %mi F
                      %mo →
                      %mi F
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      G\to f_* F\to F,
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %msub
                        %mi f
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G\to f_*F
                is a morphism and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mi F
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} f_* F\to F
                is a comorphism over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mover
                        %mo →
                        %mrow
                          %msup
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo ∘
                          %mi k
                      %msub
                        %mi f
                        %mo *
                      %mi F
                      %mover
                        %mo →
                        %mi i
                      %mi F
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      G\stackrel{i^{-1}\circ k}\to f_* F\stackrel{i}\to F,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is the
                = succeed "-comorphism" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mi F
                        %mo →
                        %msub
                          %mi f
                          %mo *
                        %mi F
                      %annotation{:encoding => "application/x-tex"} f_*F\to f_* F
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mo ⊣
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*\dashv f_*
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mo *
                      %mi G
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi{:mathvariant => "normal"} cohom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %msub
                        %mi f
                        %mo *
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathrm{Hom}_X(f^*G,F)\cong \mathrm{cohom}_f(G,F)\cong\mathrm{Hom}_Y(G,f_* F).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ringed+space"}> ringed space
                ,
                %a.existingWikiWord{:href => "/nlab/show/ringed+topos"} ringed topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+ringed+space"} locally ringed space
          %h2#references References
          %p
            In the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ringed+toposes"} ringed toposes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Verdier"} Jean-Louis Verdier
              = succeed "," do
                %em Morphisme de topos annelés
              %a.existingWikiWord{:href => "/nlab/show/M.+Artin"} M. Artin
              et al.,
              = succeed "," do
                %em Théorie des topos et cohomologie étale des schémas. Tome 1: Théorie des topos
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/SGA+4"} SGA 4
              = succeed "," do
                %strong 269
              = succeed "," do
                %a{:href => "https://link.springer.com/book/10.1007/BFb0081551"} doi:10.1007/BFb0081551
              = succeed "&rbrack;" do
                %a{:href => "http://www.cmls.polytechnique.fr/perso/laszlo/sga4/SGA4-1/sga41.pdf"} pdf
          %p
            See also the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/ringed+topos"} ringed topos
