          #SheafConditionAsLocality.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
                as
                %a.existingWikiWord{:href => "/nlab/show/local-to-global+principle"} local-to-global principle
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+spaces"} generalized spaces
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              are thought of as
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              of sorts, as in Remark
              = succeed "," do
                %a.maruku-ref{:href => "#PresaheavesAsGeneralizedSpaces"}
              %em locality
              in these spaces, reflected by a notion of what it means to
              %em
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              a given space by (“smaller”) spaces (a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.maruku-ref{:href => "#Coverage"}
              below).
            %p
              But if a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              is covered, say by two other spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_1 &amp;&amp; &amp;&amp; U_2
                    \\\
                    \&amp; {}_{\mathllap{i_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{i_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              then this must be reflected in the behaviour of the probes of any generalized space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              (in the sense of Remark
              = succeed ")" do
                %a.maruku-ref{:href => "#PresaheavesAsGeneralizedSpaces"}
            %p
              For ease of discussion, suppose that there is a sense in which these two patches above
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersect
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to form a space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %msub
                        %mo ∩
                        %mi X
                      %msub
                        %mi U
                        %mn 2
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} U_1 \cap_X U_2 \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_2
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              such that these maps agree on the intersection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %msub
                        %mo ∩
                        %mi X
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_1 \cap_X U_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext locality
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mtext maps from
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi U
                                %mn 1
                              %mspace{:width => "thinmathspace"}
                              %mtext and
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi U
                                %mn 2
                              %mspace{:width => "thinmathspace"}
                              %mtext to
                              %mspace{:width => "thinmathspace"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Y
                          %mtr
                            %mtd
                              %mtext that coincide on
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi U
                                %mn 1
                              %msub
                                %mo ∩
                                %mi X
                              %msub
                                %mi U
                                %mn 2
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtext maps from
                      %mspace{:width => "thinmathspace"}
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mtext into
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\text{locality}
                    \\;:\;
                    \\left\{
                    \\array{
                    \\text{maps from}\,U_1\,\text{and}\,U_2\,\text{to}\,\mathbf{Y}
                    \\\
                    \\text{that coincide on}\,U_1 \cap_X U_2
                    }
                    \\right\}
                    \\;\simeq\;
                    \\left\{
                    \\text{maps from}\,X\,\text{into}\,\mathbf{Y}
                    \\right\}
            %p
              One could call this the condition of
              = succeed "." do
                %em
                  locality of probes of generalized spaces probeable by objects of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
                  %a.maruku-eqref{:href => "#eq:SheafCondition"} (6)
                  on
                  %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %em
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              (Def.
              %a.maruku-ref{:href => "#Sheaf"}
              below).
          .num_remark
            %h6#remark_2 Remark
            %p
              %strong Warning
            %p
              Most (if not all) introductions to
              %a.existingWikiWord{:href => "/nlab/show/sheaf+theory"} sheaf theory
              insist on motivating the concept from the special case of
              %a.existingWikiWord{:href => "/nlab/show/sheaves+on+topological+spaces"} sheaves on topological spaces
              (Example
              %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
              below). This is good motivation for what Grothendieck called “
              %a.existingWikiWord{:href => "/nlab/show/petit+topos"}> petit topos
              ”-theory. The motivation above, instead, naturally leads to the “
              %a.existingWikiWord{:href => "/nlab/show/gros+topos"}> gros topos
              ”-perspective, as in Example
              %a.maruku-ref{:href => "#SmoothSetAnnounced"}
              below, which is more useful for discussing the
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic
              %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} supergeometry
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %em
                %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorial geometry
              that has been highlighted since
              = succeed "," do
                %a{:href => "functorial+geometry#Grothendieck65"} Grothendieck 65
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We now first introduce the
            = succeed "-condition" do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            = succeed ")" do
              %a.maruku-ref{:href => "#Sheaf"}
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
            %a.maruku-ref{:href => "#CompatibleElements"}
            below). Then we show (Prop.
            %a.maruku-ref{:href => "#CechGroupoidCoRepresents"}
            below) how this is equivalently expressed in terms of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoids"} Cech groupoids
            (Example
            %a.maruku-ref{:href => "#CechGroupoid"}
            below). This second formulation is convenient for understanding and handling various constructions in ordinary
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            (for instance the definition of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+sites"} cohesive sites
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"} higher topos theory
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#descent Descent
          %p
            Here we introduce the
            = succeed "-condition" do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %a.maruku-ref{:href => "#Sheaf"}
            below) in its component-description via
            %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
            (Def.
            %a.maruku-ref{:href => "#CompatibleElements"}
            below). Then we consider some of the general key properties of the resulting
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            %a.maruku-ref{:href => "#PropertiesOfSheafToposes"}
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Coverage.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SmallCategory"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ul
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
                  of
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  into
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
