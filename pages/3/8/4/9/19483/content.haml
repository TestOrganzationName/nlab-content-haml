                %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"}> comparison lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mover
                      %mo ↪
                      %mi ι
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{D} \overset{\iota}{\hookrightarrow} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
              inclusion (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DenseSubsite"}
              %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Sheaf"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
