          #OrdinarySpacesAreGeneratorsAndRelationsForGeneralizedSpaces.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (ordinary
                %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
                and their
                %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                are
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+spaces"} generalized spaces
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialCoverage"}
              %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
              of the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#FreeCocompletion"}
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} freely
              forming
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (“gluing”) of objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              In contrast, the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}) \hookrightarrow [\mathcal{C}^{op}, Set]
              enforces
              %em relations
              between these free colimits.
            %p
              Therefore in total we may think of a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
              as obtained by
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
              from the
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of its
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %ul
              %li
                %p
                  the objects of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  are the generators;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
