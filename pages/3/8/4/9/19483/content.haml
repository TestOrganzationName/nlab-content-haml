          #Sheafification.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/plus+construction"} plus construction
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Coverage"}
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %a.maruku-eqref{:href => "#eq:FullSubcategoryOfSheaves"} (7)
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mi L
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(\mathcal{C})
                    \\underoverset
                    {\underset{\phantom{AA} \iota \phantom{AA}}{\hookrightarrow}}
                    {\overset{ L }{\longleftarrow}}
                    {\bot}
                    [\mathcal{C}^{op}, Set]
                    \\,.
            %p
              An explicit formula for
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              is given by applying the following “
              %a.existingWikiWord{:href => "/nlab/show/plus+construction"}> plus construction
              ”
              = succeed ":" do
                %em twice
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L(\mathbf{Y}) \simeq (\mathbf{Y}^+)^+
                    \\,.
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/plus+construction"} plus construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (-)^+
                    \\;\colon\;
                    [\mathcal{C}^{op}, Set]
                    \\longrightarrow
                    [\mathcal{C}^{op}, Set]
            %p
              is given by forming
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of sets of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompatibleElements"}
              %a.existingWikiWord{:href => "/nlab/show/covers"} covers
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ι
                            %mi i
                      %mi X
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thickmathspace"}
                      %mtext covering
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mi ϕ
                      %mo ∈
                      %mi Match
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo )
                      %mo }
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y}^+(X)
                    \\;\coloneqq\;
                    \\left\{
                    \\{U_i \overset{\iota_i}{\to} X\}
                    \\; \text{covering}
                    \\;,
                    \\phi \in Match\left( \{U_i\}, \mathbf{Y}  \right)
                    \\right\}/\sim
            %p
              under the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              which identifies two such
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              if the two covers have a joint refinement such that the restriction of the two matching families to that joint refinement coincide.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #InducedCoverage.num_example
            %h6#example_10 Example
            %p
              %strong
