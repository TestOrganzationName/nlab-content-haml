                          %mi ι
                          %mo{:stretchy => "false"} (
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mi d
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{\underset{d}{\longrightarrow}}{\lim} \mathbf{X}_d
                        \\;\simeq\;
                        L\left(
                        \\underset{\underset{d}{\longleftarrow}}{\lim} \iota(\mathbf{X}_d)
                        \\right)
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
                  (Example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CartesianMonoidalCategory"}
                  = succeed "-structure" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
                  %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
                  from Example
                  %a.maruku-ref{:href => "#CartesianClosedMonoidalnessOfCategoriesOfPresheaves"}
                  restricts to sheaves:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mrow
                          %munder
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mstyle{:mathvariant => "bold"}
                                %mi X
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                          %mover
                            %mo ⟵
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi X
                              %mo ×
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Sh(\mathcal{C})
                        \\underoverset
                        {\underset{[\mathbf{X}, -]}{\longrightarrow}}
                        {\overset{\mathbf{X} \times (-)}{\longleftarrow}}
                        {}
                        Sh(\mathcal{C})
                %p
                  In particular, for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo ∈
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{X}, \mathbf{Y} \in Sh(\mathcal{C})
                  two
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [\mathbf{X}, \mathbf{Y}] \in Sh(\mathcal{C})
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                  given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi U
                        %mspace{:width => "thickmathspace"}
                        %mo ↦
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mrow
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        [\mathbf{X}, \mathbf{Y}]
                        \\;\colon\;
                        U
                        \\;\mapsto\;
                        Hom_{Sh(\mathcal{C})}( y(U) \mathbf{X}, \mathbf{Y} )
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y(U)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} presheaf represented
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} U \in \mathcal{C}
                  (Example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#RepresentablePresheaves"}
            %p
              This may be summarized by saying that every
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              (in particular every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialCoverage"}
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              for
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Cosmos"}
          #LocalEpimorphism.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"}> local epimorphism
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mi f
                        %mphantom
                          %mi AA
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y} \overset{\phantom{AA}f\phantom{AA}}{\longrightarrow} \mathbf{X}
                    \\;\;\;
                    \\in [\mathcal{S}^{op}, Set]
            %p
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
              if for every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} U \in \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} y(U) \longrightarrow \mathbf{X}
              out of its
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} represented presheaf
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#RepresentablePresheaves"}
              %em
                local
                %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in that there is a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi i
                    %mi U
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"} \big\{ U_i \overset{\iota_i}{\to} U \big\}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ∃
                                %mphantom
                                  %mi AA
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi y
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ι
                                    %mi i
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mphantom
                                %mi AAAA
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    y(U_i)
                    \&amp;\overset{\phantom{AA}\exists\phantom{AA}}{\longrightarrow}&amp;
                    \\mathbf{Y}
                    \\\
                    {}^{\mathllap{y(\iota_i)}} \Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow{}^{\mathrlap{ f }}
                    \\\
                    y(U) &amp;\underset{\phantom{AAAA}}{\longrightarrow}&amp; \mathbf{X}
                    }
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#codescent Codescent
          %p
            In order to understand the sheaf condition
            %a.maruku-eqref{:href => "#eq:SheafCondition"} (6)
            better, it is useful to consider
            %a.existingWikiWord{:href => "/nlab/show/Cech+groupoids"} Cech groupoids
            (Def.
            %a.maruku-ref{:href => "#CechGroupoid"}
            below). These are really
            %em
              %a.existingWikiWord{:href => "/nlab/show/presheaves+of+groupoids"} presheaves of groupoids
            (Def.
            %a.maruku-ref{:href => "#PresheafOfGroupoids"}
            below), a special case of the general concept of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched presheaves
            %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
            is that it co-represents the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
            (Prop.
            %a.maruku-ref{:href => "#CechGroupoidCoRepresents"}
            below). It is in this incarnation that the concept of sheaf seamlessly generalizes to
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            via “
            %a.existingWikiWord{:href => "/nlab/show/higher+stacks"}> higher stacks
            ”.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #PresheafOfGroupoids.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/presheaves+of+groupoids"}> presheaves of groupoids
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmallCategory"}
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              of
              %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoriesOfSmallCategories"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, Grpd]
                    \\,.
            %p
              By Example
              %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              we may regard
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              as a
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo ↪
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Set \hookrightarrow Grpd
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ReflectiveSubcategoryInclusionOfSetsIntoGroupoids"}
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/cosmoi"} cosmoi
              (Example
              = succeed ")," do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              may be thought of as a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op} \to Grpd
              is equivalently a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
            %p
              This means that the plain
              %a.existingWikiWord{:href => "/nlab/show/category+of+functors"} category of functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Grpd]
              enriches to
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched presheaves
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#EnrichedPresheaf"}
            %p
              Hence we may speak of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/presheaves+of+groupoids"} presheaves of groupoids
          #PresheavesOfGroupoidsAsInternalGroupoidsInPresheaves.num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/presheaves+of+groupoids"} presheaves of groupoids
                as
                %a.existingWikiWord{:href => "/nlab/show/internal+groupoids"} internal groupoids
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            %p
              From every
              %a.existingWikiWord{:href => "/nlab/show/presheaf+of+groupoids"} presheaf of groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Grpd]
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#PresheafOfGroupoids"}
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              of sets (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            %ul
              %li
                %p
                  %em presheaf of objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Obj
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        Obj_{\mathbf{Y}(-)}
                        \\in
                        [\mathcal{C}^{op}, Set]
              %li
                %p
                  the
