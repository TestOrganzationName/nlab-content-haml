            #eq:GluingCondition.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi κ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi κ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y}(\kappa_i)(\phi_i)
                    \\;=\;
                    \\mathbf{Y}(\kappa_j)(\phi_j)
                    \\,.
            %p We write
            #eq:SetOfMatching.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Match
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⊂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Match\big(
                    \\{U_i\}_{i \in I}
                    \\,,\,
                    \\mathbf{Y}
                    \\big)
                    \\subset
                    \\underset{i}{\prod} \mathbf{Y}(U_i)
                    \\;\in\;
                    Set
            %p
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              for the given presheaf and covering.
            %p
              This is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              for
              %em
                %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              along the
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ι
                            %mi i
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to}X\}
          #MatchingFamiliesThatGlue.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                that glue)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              equipped with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              and a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ι
                              %mi i
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
              of it (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Coverage"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\in\; \mathbf{Y}(X)
            %p
              induces a
              %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompatibleElements"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big( \mathbf{Y}(\iota_i)(\phi)  \big)_{i \in I}
                    \\,.
            %p
              (That this indeed satisfies the matching condition follows immediately by the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
              of
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
            %p
              This construction provides a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of the form
            #eq:SheafComparison.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Match
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y}(X)
                    \\longrightarrow
                    Match\big(
                    \\{U_i\}_{i \in I}
                    \\,,\,
                    \\mathbf{Y}
                    \\big)
            %p
              The matching families in the image of this function are hence those
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of probes of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              by the patches
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which
              %em glue
              to a global probe out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #Sheaf.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              equipped with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              The presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              if for every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              and every
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ι
                              %mi i
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %em
                  all
                  %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                  glue uniquely
              %a.maruku-eqref{:href => "#eq:SheafComparison"} (5)
              is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            #eq:SheafCondition.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Match
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y}(X)
                    \\overset{\simeq}{\longrightarrow}
                    Match\big(
                    \\{U_i\}_{i \in I}
                    \\,,\,
                    \\mathbf{Y}
                    \\big)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#FullSubcategoryOnClassOfObjects"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over a given
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            #eq:FullSubcategoryOfSheaves.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi AA
                        %mi ι
                        %mphantom
                          %mi AA
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(\mathcal{C})
                    \\overset{\phantom{AA} \iota \phantom{AA}}{\hookrightarrow}
                    [\mathcal{C}^{op}, Set]
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              which is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              is called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_2
              two such sheaf toposes, a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 1
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; \mathbf{H}_1 \to \mathbf{H}_2
              between them, called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            #eq:GeometricMorphism.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 1
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mi f
                            %mo *
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %msup
                            %mi f
                            %mo *
                          %mphantom
                            %mi AA
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_1
                    \\underoverset
                    {\underset{ \phantom{AA} f_\ast \phantom{AA} }{\longrightarrow}}
                    \\overset{ \phantom{AA} f^\ast \phantom{AA} }{\longleftarrow}
                    {}
                    \\mathbf{H}_2
            %p such that
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^\ast
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %p
              Hence there is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              and whose
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
          #GlobalSectionsGeometricMorphism.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Sheaf"}
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %a.maruku-eqref{:href => "#eq:GeometricMorphism"} (8)
              to the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              (Example
              = succeed ")," do
                %a.maruku-ref{:href => "#CategoryOfSets"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#NaturalTransformations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi Γ
                          %mphantom
                            %mi AA
                      %mover
                        %mo ↩
                        %mi L
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\underoverset
                    {\underset{\phantom{AA}\Gamma\phantom{AA}}{\longrightarrow}}
                    {\overset{L}{\hookleftarrow}}
                    {\bot}
                    Set
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is called
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/global+sections"}> global sections
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .proof
            %h6#proof Proof
            %p
              Notice that every
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \ast \in Set
              (
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \;\simeq\; \underset{s \in S}{\coprod} \ast
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              this
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is assumed to preserve
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is the empty
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              (Example
              = succeed ")," do
                %a.maruku-ref{:href => "#TerminalObjectIsEmptyLimit"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is fixed, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi L
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %mo *
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L(S)
                    \&amp; \simeq
                    L \left( \underset{s \in S}{\coprod} \ast  \right)
                    \\\
                    \&amp; \simeq
                    \\underset{s \in S}{\coprod} L(\ast)
                    \\\
                    \&amp; \simeq
                    \\underset{s \in S}{\coprod} \ast
                    }
                    \\,.
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              exists and uniquely so, up to natural isomorphism. This implies the essential uniqueness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              by uniqueness of adjoints (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#UniquenessOfAdjoints"}
          #TrivialCoverage.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/trivial+coverage"}> trivial coverage
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmallCategory"}
              %em trivial coverage
              on it is the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              families at all, meaning that the
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              is empty, in that
              %em every
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              is a
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              for this coverage.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op},Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi triv
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{triv}
              with trivial coverage is already the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mrow
                      %mo (
                      %msub
                        %mi 𝒞
                        %mi triv
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh\left( \mathcal{C}_{triv}\right)
                    \\;\simeq\;
                    [\mathcal{C}^{op}, Set]
                    \\,.
          .num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                on the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                are plain
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+coverage"} trivial coverage
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialCoverage"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              on this
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              (Example
              = succeed "):" do
                %a.maruku-ref{:href => "#CategoryOfSets"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(\ast) \;\simeq\; Set
                    \\,.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
          #SheafOnATopologicalSpace.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sheaves+on+a+topological+space"} sheaves on a topological space
                –
                %a.existingWikiWord{:href => "/nlab/show/spatial+topos"} spatial
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/petit+toposes"} petit toposes
            %p
              In the literature, the concept of (pre-)sheaf (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Op(X)
              from Example
              = succeed "," do
                %a.maruku-ref{:href => "#CanonicalCoverageOnTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              given by the usual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+on+a+topological+space"} sheaf on this topological space
              = succeed "," do
                %a.maruku-ref{:href => "#Sheaf"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AA
                    %mo{:stretchy => "false"} [
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Sh(X)
                    \\;\coloneqq\;
                    Sh(Op(X))
                    \\overset{\phantom{AA}}{\hookrightarrow}
                    [Op(X)^{op}, Set]
                    \\,,
            %p
              for short. The
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              arising this way are also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spatial+toposes"} spatial toposes
          #LocalicReflection.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/localic+reflection"}> localic reflection
                )
            %p
              The construction of
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves+on+a+topological+space"} categories of sheaves on a topological space
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %em
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              and
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              between them (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %em
                %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
              of
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              and
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
              between them (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mo ⟶
                    %mi Topos
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(-)
                    \\;\colon\;
                    Top \longrightarrow Topos
                    \\,.
            %p
              Moreover, when restricted to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              = succeed ")" do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SoberTop
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi Topos
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(-)
                    \\;\colon\;
                    SoberTop \overset{\phantom{AAA}}{\hookrightarrow} Topos
                    \\,.
            %p
              More generally, this holds for
              %em
                %a.existingWikiWord{:href => "/nlab/show/locales"} locales
              (i.e. for “
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
              not necessarily supported on points”), in which case it becomes a
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              = succeed ")" do
                %a.maruku-ref{:href => "#ReflectiveSubcategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Locale
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mphantom
                          %mi AAAA
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"}
                    Locale
                    \\underoverset
                    {\underset{\phantom{AA} Sh(-) \phantom{AA} }{\hookrightarrow}}
                    {\overset{\phantom{AAAA}}{\longleftarrow}}
                    {\bot}
                    Topos
            %p
              This says that
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves+on+topological+spaces"} categories of sheaves on topological spaces
              are but a reflection of soper topological spaces (generally: locales) and nothing more, whence they are also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/petit+toposes"} petit toposes
          #AbelianSheaves.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"}> abelian sheaves
                )
            %p
              In the literature, sometimes sheaves are understood by default as taking values not in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
              this means that some authors really mean “sheaf of abelian groups of the site of opens of a topological space”, when they write just “sheaf”.
            %p
              But for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} mathematical structure
              = succeed "-structured" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to the
