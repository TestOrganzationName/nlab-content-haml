                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},\tau)
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocallyPresentableCategory"}
              %li
                %p
                  the reflector
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:lspace => "verythinmathspace"} :
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L \colon PSh(\mathcal{C})  \to Sh(\mathcal{C})
                  (which is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Sheafification"}
                  %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
                  (“lex”) in that it
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %p
              Conversely, every
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              arises this way. Hence
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              are equivalently the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflectively
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              of
              %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
              over some
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            #eq:SheafToposAsLexReflection.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi acc
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi lex
                          %mphantom
                            %mi AA
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\underoverset
                    {\underset{\phantom{AA}acc\phantom{AA}}{\hookrightarrow}}
                    {\overset{\phantom{AA}lex\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    PSh(\mathcal{C})
          %p
            (e.g.
            = succeed "," do
              %a{:href => "sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes#Borceux94"} Borceux 94, prop. 3.5.4, cor. 3.5.5
            = succeed ")" do
              %a{:href => "sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes#Johnstone"} Johnstone, C.2.1.11
          .num_example
            %h6#remark_5 Remark
            %p
              %strong
                (left exact reflections of
                %a.existingWikiWord{:href => "/nlab/show/categories+of+presheaves"} categories of presheaves
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
            %p
              In the characterization of
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes"} sheaf toposes as left exact reflections of categories of presheaves
              in Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SheafToposViaLexReflection"}
              %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessibility
              of the inclusion, equivalently the
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} local presentability
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocallyPresentableCategory"}
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SheafToposAsLexReflection"} (14)
