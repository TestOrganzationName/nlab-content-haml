          %h1#indexed_monoidal_categories Indexed monoidal categories
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#indexed_monoidal_category"} Indexed monoidal category
                %li
