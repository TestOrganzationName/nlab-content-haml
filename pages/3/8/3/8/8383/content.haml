              %a.existingWikiWord{:href => "/nlab/show/parametrized+spectra"} parametrized spectra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
