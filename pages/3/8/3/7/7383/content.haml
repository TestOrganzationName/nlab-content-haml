          %h2#idea Idea
          %p
            The
            %em dendroidal homotopy coherent nerve
            is an
            %a.existingWikiWord{:href => "/nlab/show/operad"} operadic
            generalization of the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hcN
                    %mi d
                  %mo :
                  %mi Top
                  %mi Operad
                  %mo →
                  %mi dSet
                %annotation{:encoding => "application/x-tex"}
                  hcN_d : Top Operad \to dSet
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/operads"} operads
            to that of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+sets"} dendroidal sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hcsN
                    %mi d
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mo ↦
                  %mi dSet
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  hcsN_d(P) : T \mapsto dSet(W_H(T), P)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is an object of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tree+category"} tree category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+operad"} symmetric operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_H(T)
            is its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
          %h2#definition Definition
          %p
            Throughout, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            equipped with an
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            as discussed at
            %em
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
            and at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            (
            %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategories"}> symmetric multicategories
            ) enriched in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            Standard examples are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{E} =
