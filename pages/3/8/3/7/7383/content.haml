            %a.existingWikiWord{:href => "/nlab/show/topological+operads"} topological operads
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+operads"} simplicial operads
          %h3#BVResolutionOfTrees BV resolution of trees
          %p
            We discuss in detail what the
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            of
            %a.existingWikiWord{:href => "/nlab/show/operads"} operads
            free on an object in the
            %a.existingWikiWord{:href => "/nlab/show/tree+category"} tree category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is like (see
            %em
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
            for details on trees as operads).
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Symm
                  %mo :
                  %mi ℰ
                  %msub
                    %mi Operad
                    %mi planar
                  %mo →
                  %mi ℰ
                  %mi Operad
                %annotation{:encoding => "application/x-tex"}
                  Symm : \mathcal{E} Operad_{planar} \to \mathcal{E} Operad
          %p
            be the symmetrization functor, the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            from
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/planar+operads"} planar operads
          .num_prop
            %h6#proposition Proposition
            %p
              The BV resolution commutes with symmetrization: if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi Symm
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi T
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T = Symm(\bar T)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Symm
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W(T) = Symm(W(\bar T))
                    \\,.
          %p Therefore we describe in the following explicitly the BV-resolution of planar trees, that of non-planar trees then being the symmetrization of that construction.
          #ComponentDescriptionofBVofTrees.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∈
                      %msub
                        %mi Ω
                        %mi planar
                    %annotation{:encoding => "application/x-tex"} T \in \Omega_{planar}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ;
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_1, \cdots, e_n; e)
              a tuple of colours (edges) of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(e_1, \cdots, e_n, e)
              is the set of those subtrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi T
                  %annotation{:encoding => "application/x-tex"} V \subset T
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e_1, \cdots, e_n\}
              is the set of leaves and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is the root of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              First regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              as a
              %a.existingWikiWord{:href => "/nlab/show/topological+operad"} topological operad
              (with a
              %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
              of operations in each degree). The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(T)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the topological operad whose
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of operations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ;
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(T)(e_1, \cdots, e_n; e)
              is the space of
              %em labeled trees
              as follows.
            %p
              A point is a set of
              %em lengths
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \ell(e) \in [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e \in I(T)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ;
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi V
                        %mo ∈
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi e
                          %mi n
                        %mo ;
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ×
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    W(T)(e_1, \cdots, e_n; e)
                    \\simeq
                    \\coprod_{V \in T(e_1, \cdots, e_n; e)}
                    (\Delta^1)^{\times i(V)}
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              ranges over the set of subtrees
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(V)
              is the set of inner edges of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Regard then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+operad"} simplicial operad
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(T)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the simplicial operad whose
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              of operations are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ;
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi V
                        %mo ∈
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi e
                          %mi n
                        %mo ;
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ×
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W(T)(e_1, \cdots, e_n; e)
                    \=
                    \\coprod_{V \in T(e_1, \cdots, e_n; e)}
                    \\Delta[1]^{\times i(V)}
                    \\,.
            %p
              In general, when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is regarded as an
              = succeed "-operad," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi e
                      %mi n
                    %mo ;
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi V
                        %mo ∈
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi e
                          %mi n
                        %mo ;
                        %mi e
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi H
                      %mrow
                        %mo ⊗
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    W(T)(e_1, \cdots, e_n; e)
                    \=
                    \\coprod_{V \in T(e_1, \cdots, e_n; e)}
                    H^{\otimes i(V)}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is the given
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
          #CompositioninWT.num_prop
            %h6#observation Observation
            %p
              The composition operations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(T)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi e
                              %mi n
                            %mo ;
                            %msub
                              %mi e
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi f
                              %mi k
                            %mo ;
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ∘
                                    %mi i
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi e
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi f
                              %mi k
                            %mo ,
                            %msub
                              %mi e
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi e
                              %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    W(T)(e_1, \cdots, e_n; e_0) \otimes W(T)(f_1, \cdots, f_k; e_i)
                    \\\
                    \\downarrow^{\mathrlap{\circ_i}}
                    \\\
                    W(T)(e_1, \cdots, e_{i-1}, f_1, \cdots, f_k, e_{i+1}, \cdots, e_n)
                    }
            %p
              correspond to grafting of trees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi σ
                    %mo ,
                    %msub
                      %mi T
                      %mi ρ
                    %mo ⊂
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T_\sigma, T_\rho \subset T
              and “assigning unit length to the new inner edge”. On the components as discussed above it is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi σ
                                %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi ρ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi σ
                                %msub
                                  %mo ∘
                                  %mi i
                                %msub
                                  %mi T
                                  %mi ρ
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi σ
                                %mo{:stretchy => "false"} )
                                %mo ∪
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi ρ
                                %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi id
                                %mo ⊗
                                %msub
                                  %mi i
                                  %mn 1
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi σ
                                %mo{:stretchy => "false"} )
                                %mo ∪
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi T
                                  %mi ρ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H^{\otimes i(T_\sigma)} \otimes H^{\otimes i(T_\rho)}
                    \&amp;&amp;
                    H^{\otimes i(T_\sigma \circ_i T_\rho)}
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{\simeq}}
                    \\\
                    H^{\otimes i(T_\sigma) \cup i(T_\rho)} \otimes I
                    \&amp;\stackrel{id \otimes i_1}{\to}&amp;
                    H^{\otimes (i(T_\sigma) \cup i(T_\rho))} \otimes H
                    }
          #BVResolutionAsFunctorOnOmega.num_prop
            %h6#proposition_3 Proposition
            %p
              The BV-resolution of trees extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on the category of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+operad"} simplicial operad
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo :
                    %mi Ω
                    %mo →
                    %mi sSet
                    %mi Operad
                  %annotation{:encoding => "application/x-tex"}
                    W : \Omega \to sSet Operad
            %p as follows
            %ul
              %li
                %p
                  on an inner face map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mi e
                        %mo :
                        %msup
                          %mo ∂
                          %mi e
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \delta_e : \partial^e\Omega[T] \to \Omega[T]
                  the component of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi δ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\delta)
                  on a subtree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  that contains the edge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                      %annotation{:encoding => "application/x-tex"} e
                  is the product of the inclusion
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo :
                        %mi I
                        %mo →
                        %mi H
                      %annotation{:encoding => "application/x-tex"}
                        i_0 : I \to H
                %p
                  with the identity on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo{:stretchy => "false"} {
                            %mi e
                            %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} H^{i(V)-\{e\}}
                %p (meaning: if the label of an inner edge in a tree is 0, then the operations that it connects may be composed);
              %li
                %p
                  on a degenracy map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  that sends two given unary vertices to a single one, the component of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\sigma)
                  on subtrees containing these removes one of the factors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  by the map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊗
                        %mi H
                        %mo →
                        %mi H
                      %annotation{:encoding => "application/x-tex"}
                        H \otimes H \to H
                %p
                  given by the
                  %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+operads"} simplicial operads
                  and
                  %a.existingWikiWord{:href => "/nlab/show/topological+operads"} topological operads
                  this may be taken to be the map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi max
                        %mo :
                        %msup
                          %mi Δ
                          %mn 1
                        %mo ×
                        %msup
                          %mi Δ
                          %mn 1
                        %mo →
                        %msup
                          %mi Δ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        max : \Delta^1 \times \Delta^1 \to \Delta^1
                %p
                  that sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x,y)
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi max
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} max(x,y)
          %p
            This is discussed in section 4.2 of (
            %a{:href => "#CisinskiMoerdijk"}> Cisinski-Moerdijk
            ).
          %h3#the_homotopy_coherent_nerve The homotopy coherent nerve
          %p
            By the general discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo :
                  %mi Ω
                  %mo →
                  %mi sSet
                  %mi Operad
                %annotation{:encoding => "application/x-tex"}
                  W
                  \:
                  \\Omega
                  \\to
                  sSet Operad
          %p
            from prop.
            %a.maruku-ref{:href => "#BVResolutionAsFunctorOnOmega"}
            induces a
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            functor as follows.
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong dendroidal homotopy coherent nerve
              functor is the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hcN
                      %mi d
                    %mo :
                    %mi sSet
                    %mi Cat
                    %mo →
                    %mi dSet
                  %annotation{:encoding => "application/x-tex"}
                    hcN_d : sSet Cat \to dSet
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ↦
                    %mi sSet
                    %mi Operad
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \mapsto ( T \mapsto sSet Operad(W(T), P) )
                    \\,.
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              (the corresponding “
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"}> geometric realization
              ”) we denote
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                    %mo :
                    %mi dSet
                    %mo →
                    %mi sSet
                    %mi Operad
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W_! : dSet \to sSet Operad
                    \\,.
          %h2#properties Properties
          %h3#specialization_to_categories Specialization to categories
          .num_prop
            %h6#proposition_4 Proposition
            %p
              When restricted to
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              of enriched categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℰ
                            %mi Cat
                          %mtd
                            %mo ↪
                          %mtd
                            %mi ℰ
                            %mi Operad
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi hcN
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi hcN
                                    %mi d
                        %mtr
                          %mtd
                            %mi sSet
                          %mtd
                            %mo ↪
                          %mtd
                            %mi dSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E} Cat &amp;\hookrightarrow&amp; \mathcal{E} Operad
                    \\\
                    {}^{\mathllap{hcN}}\downarrow &amp;&amp; \downarrow^{\mathrlap{hcN_d}}
                    \\\
                    sSet &amp;\hookrightarrow&amp; dSet
                    }
                    \\,.
            %p
              In particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} =
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              \/
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              it reproduces the original definition of homotopy coherent nerve.
          %h3#DendroidalInnerKanComplexes Dendroidal inner Kan complexes
          #hcNOfLocllyFibrantOperadIsFibrant.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi ℰ
                    %mi Operad
                  %annotation{:encoding => "application/x-tex"} P \in \mathcal{E} Operad
              be such that each object of operations is fibrant in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hcN_d(P)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dendroidal+sets"} dendroidal inner Kan complex
          %p
            This is (
            %a{:href => "#MoerdijkWeiss"}> Moerdijk-Weiss, theorem 7.1
            ). This statement will also follow as a corollary from prop.
            %a.maruku-ref{:href => "#WIsLeftQuillen"}
            below.
          .proof
            %h6#proof Proof
            %p
              Consider a tree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and an inner edge
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of it. For each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msup
                      %mi Λ
                      %mi e
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi : \Lambda^e[T] \to X
              we need to find a filler
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Λ
                              %mi e
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi hcN
                              %mi d
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi ψ
                        %mtr
                          %mtd
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda^e[T] &amp;\to&amp; hcN_d(X)
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\psi}}
                    \\\
                    \\Omega[T]
                    }
                    \\,.
            %p
              Write
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi e
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msub
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ≠
                          %mi e
                      %msup
                        %mo ∂
                        %mrow
                          %mi i
                          %mo ≠
                          %mi e
                      %mi Ω
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^e[T] = \cup_{i \neq e}\partial^{i \neq e} \Omega[T]
            %p By the definition of dendroidal nerve, this is equivalently a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ≠
                                %mi e
                            %mi W
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∂
                              %mi i
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ψ
                                  %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cup_{i \neq e } W(\partial^i \Omega[T]) &amp;\to&amp; X
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\hat \psi}}
                    \\\
                    W(\Omega[T])
                    }
                    \\,.
            %p
              The undetermined component to fill is that corresponding to the subtree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              itself. According to prop.
              %a.maruku-ref{:href => "#ComponentDescriptionofBVofTrees"}
              on this the operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\Omega[T])
              has the component
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo ⊗
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mo ⊗
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                    %mo ⊗
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{\otimes i(\tau)} \simeq H^{\otimes i(\tau)- \{e\}}\otimes H
                    \\,.
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \psi
              has to send this into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              while being compatible with the given faces. By prop.
              %a.maruku-ref{:href => "#BVResolutionAsFunctorOnOmega"}
              this means that its precomposition with all the inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi id
                    %mo ,
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %mi id
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi id
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi id
                    %mo :
                    %mi H
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %mi H
                    %mo ⊗
                    %mi I
                    %mo ⊗
                    %mi H
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %mi H
                    %mo ⊗
                    %mi H
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mo ⊗
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                    %mo ⊗
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    (id, \cdots, id, i_0, id, \cdots, id) \otimes id
                    \:
                    H \otimes \cdots \otimes H \otimes I \otimes H \otimes \cdots \otimes H \otimes H
                    \\to
                    H^{\otimes i(\tau)- \{e\}}\otimes H
            %p
              is fixed. Moreover, the assignment needs to be compatible with the composition operations, which by prop.
              %a.maruku-ref{:href => "#CompositioninWT"}
              means that also the precomposition with all the maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi id
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %mi id
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi H
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %mi H
                    %mo ⊗
                    %mi I
                    %mo ⊗
                    %mi H
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %mi H
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mo ⊗
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (id, \cdots, id, i_1, id, \cdots, id)
                    \:
                    H \otimes \cdots \otimes H \otimes I \otimes H \otimes \cdots \otimes H
                    \\to
                    H^{\otimes i(\tau)}
            %p
              is fixed. In total this means that the components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \psi
              need to form an extension of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo ∂
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mo{:stretchy => "false"} {
                                %mi e
                                %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi H
                            %mo ∪
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mo{:stretchy => "false"} {
                                %mi e
                                %mo{:stretchy => "false"} }
                            %mo ⊗
                            %mi I
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi τ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo ⊗
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi τ
                                %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\partial H^{\otimes i(\tau)- \{e\}})
                    \\otimes H
                    \\cup
                    H^{\otimes i(\tau) - \{e\}}\otimes I
                    \&amp;\to&amp; X(\tau)
                    \\\
                    \\downarrow &amp; \nearrow
                    \\\
                    H^{\otimes i(\tau)}
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msup
                      %mi H
                      %mi n
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi id
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi ⋯
                    %msup
                      %mi H
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial H^n :=
                    (I \coprod I) \otimes H^{n-1}
                    \\coprod
                    H (I \coprod I) \otimes H^{n-2}
                    \\coprod
                    \\cdots
                    \\stackrel{(i_0,i_1)\otimes id \coprod \cdots}{\to}
                    H^n
                    \\,.
            %p
              One sees that the left vertical morphism is an acyclic cofibration, by the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(\tau)
              is fibrant, such a lift does exist.
          %h3#LeftAdjoint Left adjoint
          .num_defn
            %h6#definition_3 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                    %mo :
                    %mi dSet
                    %mo →
                    %mi sSet
                    %mi Operad
                  %annotation{:encoding => "application/x-tex"}
                    W_! : dSet \to sSet Operad
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo ↪
                    %mi Operad
                    %mo ↪
                    %mi sSet
                    %mi Operad
                    %mover
                      %mo →
                      %mi W
                    %mi sSet
                    %mi Operad
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega \hookrightarrow Operad \hookrightarrow sSet Operad \stackrel{W}{\to} sSet Operad
                    \\,;
            %p
              hence for the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+sets"} dendroidal sets
              to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+operads"} simplicial operads
            %ul
              %li
                %p
                  preserves
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %li
                %p
                  on trees
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mo ↪
                        %mi Operad
                        %mo ↪
                        %mi sSet
                        %mi Operad
                      %annotation{:encoding => "application/x-tex"} \Omega \hookrightarrow Operad \hookrightarrow sSet Operad
                  is given by the
                  %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
                  as discussed
                  = succeed "." do
                    %a{:href => "#BVResolutionOfTrees"} above
          %p
            By the general lore of
            %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            we have
          .num_prop
            %h6#proposition_6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                  %annotation{:encoding => "application/x-tex"} W_!
              is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hcN
                      %mi d
                  %annotation{:encoding => "application/x-tex"} hcN_d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mo !
                    %mo ⊣
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi sSet
                    %mi Operad
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi hcN
                            %mi d
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi N
                            %mi d
                    %mi dSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (W_! \dashv hcN_d)
                    \:
                    sSet Operad
                    \\stackrel{\overset{N_d}{\leftarrow}}{\underset{hcN_d}{\to}}
                    dSet
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ∈
                      %mi sSet
                      %mi Operad
                    %annotation{:encoding => "application/x-tex"} P \in sSet Operad
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    W_! hcN_d (P) \to P
            %p
              is essentially the
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %p
              For a cofibrant and fibrant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi dSet
                    %annotation{:encoding => "application/x-tex"} X \in dSet
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi hcN
                      %mi d
                    %msub
                      %mi W
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \to hcN_d W_!(X)
            %p
              may be viewed as a “strictification” of the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-operad"} (infinity,1)-operad
              given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mo !
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_!(X)
          %h3#relation_to_ordinary_dendroidal_nerve Relation to ordinary dendroidal nerve
          %p
            By the general properties of the
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            (but also immediately checked directly) we have
          #CounitOfResolutionOnTrees.num_prop
            %h6#proposition_7 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi W
                    %mo ⇒
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Ω
                    %mo →
                    %mi sSet
                    %mi Operad
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon : W \Rightarrow \Omega(-) : \Omega \to sSet Operad
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi T
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon_T : W(T) \to T
            %p
              (natural in the tree
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∈
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} T \in \Omega
              %a.maruku-ref{:href => "#ComponentDescriptionofBVofTrees"}
              the canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[1]^{i(V)} \to *
                    \\,.
            %p
              Each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \epsilon_T
              is hence a weak equivalence of simplicial operads. In particular
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(W(T)) \to T
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This induces hence a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mo !
                  %mo ⇒
                  %msub
                    %mi τ
                    %mi d
                  %mo :
                  %mi dSet
                  %mo →
                  %mi sSet
                  %mi Operad
                %annotation{:encoding => "application/x-tex"}
                  W_! \Rightarrow \tau_d : dSet \to sSet Operad
          %p
            to the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi d
                %annotation{:encoding => "application/x-tex"} \tau_d
            of the ordinary
            %a.existingWikiWord{:href => "/nlab/show/dendroidal+nerve"} dendroidal nerve
            (the “fundamental operad” construction).
          .num_prop
            %h6#proposition_8 Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi W
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi τ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi τ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 W_!(X) \to \pi_0 \tau_d (X) = \tau_d(X)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of simplicial operads.
          %p
            This appears as
            = succeed "." do
              %a{:href => "#CisinskiMoerdijk"} Cisinski-Moerdijk, prop. 4.4
          .proof
            %h6#proof_2 Proof
            %p
              The functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi W
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \pi_0 W_!
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \tau_d
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X = \Omega[T]
              a tree. There it is prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CounitOfResolutionOnTrees"}
          %h3#quillen_equivalence Quillen equivalence
          .num_theorem
            %h6#theorem Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mo !
                    %mo ⊣
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_! \dashv hcN_d)
              from
              %a{:href => "#LeftAdjoint"} above
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
              over
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dendroidal+sets"} model structure on dendroidal sets
          %p We discuss some input to this statement.
          #WIsLeftQuillen.num_prop
            %h6#proposition_9 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                    %mo :
                    %mi dSet
                    %mo →
                    %mi sSet
                    %mi Operad
                  %annotation{:encoding => "application/x-tex"} W_! : dSet \to sSet Operad
              sends normal monomorphisms to cofibrations, and inner
              %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
              to
              %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-operads"} model structure on sSet-operads
          %p
            This appears as
            = succeed "." do
              %a{:href => "#CisinskiMoerdijk"} Cisinski-Moerdijk, prop. 4.5
          .proof
            %h6#proof_3 Proof
            %p
              Observe that the morphism classes in question are, as discussed at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                  %annotation{:encoding => "application/x-tex"} W_!
              is left adjoint, it therefore suffices to check the statement on these generating inclusions. Moreover, by construction, on trees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                  %annotation{:encoding => "application/x-tex"} W_!
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
              of the operads free on these trees.
            %p
              It follows that the generating inclusions are sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                  %annotation{:encoding => "application/x-tex"} W_!
              to morphisms of simplicial operads which are
            %ul
              %li
                %p bijective on objects;
              %li
                %p isomorphisms on all but one simplicial set of operations: that corresponding to the maximal subtree;
              %li
                %p on this remaining simplicial set of operations a product of identities with cofibrations of simplicial sets (monomorphisms), and following through the combinatorics shows that these are acyclic for the case of anodyne extensions.
            %p
              It follows that these morphisms of simplicial operads have the left lifting property again operation-object-wise
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              (there is no further composition to be respected, since the maximal subtree operation has no further non-trivial composites), and hence against the fibrations of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-operads"} model structure on sSet-operads
          .num_remark
            %h6#remark_2 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#hcNOfLocllyFibrantOperadIsFibrant"}
              is, in turn, a direct consequence of this.
          %h3#resolution_and_rectification Resolution and rectification
          .num_prop
            %h6#proposition_10 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be an
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed "-operad." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mo !
                      %mo ⊣
                      %msub
                        %mi hcN
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (W_! \dashv hcN_d)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mo !
                    %msub
                      %mi N
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi W
                      %mo !
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    W_! N_d(P) = W_! hcN_d (P) \to P
            %p
              is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W_H(P)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %p
              In particular, therefore, there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi ℰ
                        %mi Operad
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi dSet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi hcN
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{E}Operad}(W_H(P), Q)
                    \\simeq
                    Hom_{dSet}(N_d(P), hcN_d(Q))
                    \\,.
          %p
            (Here we are using that on a discrete operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            the homotopy coherent dendroidal nerve trivially coincides with the ordinary dendroidal nerve
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi d
                  %annotation{:encoding => "application/x-tex"} N_d
          .proof
            %h6#proof_4 Proof
            %p By inspection of the relevant formulas.
          .num_prop
            %h6#proposition_11 Proposition
            %p
              For a cofibrant and fibrant dendroidal set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mo !
                      %mo ⊣
                      %msub
                        %mi hcN
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (W_! \dashv hcN_d)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi hcN
                      %mi d
                    %msub
                      %mi W
                      %mo !
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \to hcN_d W_! X
            %p is an equivalence.
          .num_remark
            %h6#remark_3 Remark
            %p
              Since composition of operations in a simplicial operad is strictly associative, this may be understood as producing a semi-strictification of the
              = succeed "-operad" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
