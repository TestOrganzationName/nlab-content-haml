            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/3-manifolds"} 3-manifolds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Blau"}> Matthias Blau
              , George Thompson,
              = succeed "," do
                %em On the Relationship between the Rozansky-Witten and the 3-Dimensional Seiberg-Witten Invariants
              = succeed ")" do
