                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+weight+systems+are+cohomology+of+loop+space+of+configuration+space"} horizontal weight systems are cohomology of loop space of configuration space
          %h2#references References
          %h3#general General
          %p Original articles:
          %ul
            %li#RozanskyWitten96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lev+Rozansky"}> Lev Rozansky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em Hyper-Kähler geometry and invariants of 3-manifolds
                %strong 3
                (1997), 401–458 (
                %a{:href => "https://arxiv.org/abs/hep-th/9612216"}> arXiv:hep-th/9612216
                ,
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/s000290050016"} doi:10.1007/s000290050016
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=98m:57041"} MR98m:57041
            %li#Kapranov99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Rozansky–Witten invariants via Atiyah classes
                %strong 115
                (1999), no. 1, 71–113,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2000h:57056"} MR2000h:57056
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1023/A:1000664527238"} doi
                %a{:href => "http://arxiv.org/abs/alg-geom/9704009"} alg-geom/9704009
          %p
            Unified description of
            %a.existingWikiWord{:href => "/nlab/show/Rozansky-Witten+weight+systems"} Rozansky-Witten weight systems
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            %a.existingWikiWord{:href => "/nlab/show/Wheels+theorem"} Wheels theorem
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+objects"} Lie algebra objects
          %ul
            %li#RobertsWillerton10
              %a.existingWikiWord{:href => "/nlab/show/Justin+Roberts"}> Justin Roberts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Simon+Willerton"} Simon Willerton
              = succeed "," do
                %em On the Rozansky-Witten weight systems
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/0602653"} arXiv:math/0602653
          %p Review:
          %ul
            %li#Roberts01
              %a.existingWikiWord{:href => "/nlab/show/Justin+Roberts"}> Justin Roberts
              ,
              %em Rozansky-Witten theory
              (
              %a{:href => "https://arxiv.org/abs/math/0112209"}> arXiv:math/0112209
              )
          %h3#relation_to_seibergwitten_invariants Relation to Seiberg-Witten invariants
          %p
