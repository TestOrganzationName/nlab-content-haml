                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(p_S)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\pi_1(p_S)) \coloneqq \pi_1(p_T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                  %annotation{:encoding => "application/x-tex"} a:T
              is contractible. But by the uniqueness principle of contractible types, it suffices to prove it for the center of contraction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(p_T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              is in the fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(p_T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(p_S)
              is the center of contraction of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(p_T)
              is contractible, and thus the fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                  %annotation{:encoding => "application/x-tex"} a:T
              is contractible. Thus,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an equivalence of types between the contractible types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
          .num_lemma
            %h6 Lemma
            %p The positive and negative unit types are equivalent to each other.
          %p
          .proof
            %h6 Proof
            %p Since the negative unit type is contractible by definition, and the positive unit type is contractible, they are equivalent to each other.
          %h4#extensionality_principle Extensionality principle
          %p Then we could derive the extensionality principle for the unit type:
          %p
          .num_lemma
            %h6 Lemma
            %p
              Given elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi 𝟙
                    %annotation{:encoding => "application/x-tex"} y:\mathbb{1}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo =
                      %mi 𝟙
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} (x =_\mathbb{1} y) \simeq \mathbb{1}
              between the
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo =
                      %mi 𝟙
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x =_\mathbb{1} y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
              itself.
          %p
          .proof
            %h6 Proof
            %p
              Since every identity type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo =
                      %mi 𝟙
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x =_\mathbb{1} y
              is contractible for elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi 𝟙
                    %annotation{:encoding => "application/x-tex"} y:\mathbb{1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
              itself is contractible, this implies that every identity type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo =
                      %mi 𝟙
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x =_\mathbb{1} y
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟙
                    %annotation{:encoding => "application/x-tex"} \mathbb{1}
          %h4#the_unit_type_as_a_univalent_universe The unit type as a univalent universe
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %a.existingWikiWord{:href => "/nlab/show/size+issues"} size issues
            in
            %a.existingWikiWord{:href => "/nlab/show/strongly+predicative"} strongly predicative
            and
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/weakly+predicative"} weakly predicative
            %a.existingWikiWord{:href => "/nlab/show/impredicative"} impredicative
            mathematics respectively. Some definitions of regular and inaccessible cardinals do not have a requirement that the cardinals be infinite; thus finite cardinals such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            could be considered to be regular and inaccessible cardinals. Univalent universes in type theory which are closed under
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            are the type theoretic equivalent of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinals"} regular cardinals
            %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
            are the type theoretic equivalent of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inaccessible+cardinals"} inaccessible cardinals
          %p
            We
            %a.existingWikiWord{:href => "/nlab/show/inductive+definition"} inductively define
            the type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi 𝟙
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} x:\mathbb{1} \vdash \mathrm{El}_\mathbb{1}(x) \; \mathrm{type}
            by defining
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathrm{El}_\mathbb{1}(*) \coloneqq \mathbb{1}
          %p
            The extensionality principle for the unit type then is simply the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ext
                    %mi 𝟙
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi 𝟙
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi 𝟙
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ext}_\mathbb{1}:\prod_{x:\mathbb{1}} \prod_{y:\mathbb{1}} (x =_\mathbb{1} y) \simeq (\mathrm{El}_\mathbb{1}(x) \simeq \mathrm{El}_\mathbb{1}(y))
          %p
            The unit type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            represents the trivial universe, the universe with only one element up to identification, where every type in the universe is a
            %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            and thus every contractible type is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+type"}
                essentially
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝟙
                      %annotation{:encoding => "application/x-tex"} \mathbb{1}
            %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
            between the two contractible types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{El}_\mathbb{1}(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{El}_\mathbb{1}(y)
            is itself contractible and thus equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            itself. As proven in the previous section,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo =
                    %mi 𝟙
                  %mi y
                %annotation{:encoding => "application/x-tex"} x =_\mathbb{1} y
            for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} x:\mathbb{1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} y:\mathbb{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            is true.
          %p
            In addition, given any type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} A \to \mathbb{1}
            are families of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+types"} contractible types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝟙
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi 𝟙
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{1}, \mathrm{El}_\mathbb{1})
            is also closed under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} p:B \to \mathbb{1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi 𝟙
                    %msub
                      %mi{:mathvariant => "normal"} El
                      %mi 𝟙
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo ≃
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \left(\sum_{x:\mathbb{1}} \mathrm{El}_\mathbb{1}(B(x))\right) \simeq \mathbb{1}
          %p
            This makes the unit type into a
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            representing a finite regular cardinal.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            also has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} p:B \to \mathbb{1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi 𝟙
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo ≃
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \left(\prod_{x:\mathbb{1}} B(x)\right) \simeq \mathbb{1}
          %p
            making the unit type into a
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            representing a finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product-regular+cardinal"} product-regular cardinal
          %p
            As a universe, the unit type also satisfies
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/propositional+resizing"} propositional resizing
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weakly+Tarski+universe"} weakly Tarski universe
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
            exist in the unit type, making the unit type impredicative: power sets are just
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            into the unit type. This makes the unit type into a
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            representing a finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inaccessible+cardinal"} inaccessible cardinal
          %p
            The unit type is also the only universe which contains itself, as any univalent universe which contains the
            %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            and itself makes the entire
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            inconsistent.
          %h3#in_lambdacalculus In lambda-calculus
          %p In lambda-calculus, for both the positive unit type and the negative unit type, the rule for building the unit type is the same, namely “it exists”:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                    %mrow
                      %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                %annotation{:encoding => "application/x-tex"} \frac{ }{1\colon Type}
          %h4#as_a_positive_type_2 As a positive type
          %p
            Regarded as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+type"} positive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ()
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tt
                  %annotation{:encoding => "application/x-tex"} tt
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{ }{() \colon 1 }
          %p
            The eliminator now says that to use something of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo ⊢
                      %mi c
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                    %mrow
                      %mi u
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                      %mo ⊢
                      %mi let
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi u
                      %mi in
                      %mi c
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                %annotation{:encoding => "application/x-tex"} \frac{\vdash c\colon C}{u\colon 1 \vdash let () = u in c \;\colon C}
          %p
            Obviously this is not very interesting, but this is what we get from the general rules of type theory in this degenerate case. In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to depend on the unit type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            We then have the
            %span.newWikiWord
              ∞-reduction
              %a{:href => "/nlab/new/%E2%88%9E-reduction"} ?
            rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mi in
                  %mi c
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %mi c
                %annotation{:encoding => "application/x-tex"} let () = () in c \;\to_\beta\; c
          %p
            and (if we wish) the
            %span.newWikiWord
              ∞-reduction
              %a{:href => "/nlab/new/%E2%88%9E-reduction"} ?
            rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mi in
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi u
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} let () = u in c[()/z] \;\to_\eta\; c[u/z].
          %p
            The
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is an expression involving a variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ()
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and use that (with the eliminator) to define a term involving another term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            directly.
          %p
            The positive presentation of the unit type is naturally expressed as an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            syntax:
          %pre
            %code
              :preserve
                Inductive unit : Type :=
                | tt : unit.          %p
            (Coq then implements beta-reduction, but not eta-reduction. However, eta-equivalence is provable with the internally defined
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %h4#as_a_negative_type_2 As a negative type
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative type
            is characterized by its eliminators, which is a little subtle for the unit type. But by analogy with binary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \pi_2
            when presented negatively, the negative unit type (a
            %a.existingWikiWord{:href => "/nlab/show/zero"} nullary
            product) should have
            = succeed "." do
              %em no eliminators at all
          %p
            To derive the constructors from this, we follow the general rule for negative types that to construct an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em are
            no eliminators, this means we have nothing to do; thus we have exactly one way to construct an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{ }{()\colon 1}
          %p
            There is no
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %em is
            an
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %span.newWikiWord
              redex
              %a{:href => "/nlab/new/redex"} ?
            consists of a constructor whose inputs are all obtained from eliminators. Here we have a constructor which has no inputs, so it is not a problem that we have no eliminators to fill them in with. Thus, the term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mn 1
                %annotation{:encoding => "application/x-tex"} ()\colon 1
            is an “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            \-redex”, and it “reduces” to
            %em any
            term of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            at all:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi u
                %annotation{:encoding => "application/x-tex"} () \;\to_\eta\; u
          %p
            This is obviously not a well-defined “operation”, so in this case it is better to view
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed ":" do
              %em expansion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} u \;\to_\eta\; ().
          %h4#positive_versus_negative_2 Positive versus negative
          %p In ordinary “nonlinear” type theory, the positive and negative unit types are equivalent. They manifestly have the same constructor, while we can define the positive eliminator in a trivial way as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mi in
                  %mi c
                  %mspace{:width => "1em"}
                  %mo ≔
                  %mspace{:width => "1em"}
                  %mi c
                %annotation{:encoding => "application/x-tex"} let () = u in c  \quad \coloneqq\quad c
          %p
            Note that just as for binary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            %em dependent
            eliminator in dependent type theory, we need to assume the
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed ")." do
              %a{:href => "/nlab/show/eta-conversion#Propositional"} propositionally
          %p
            Of course, the positive
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
          %p
            For the
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mi in
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} let () = u in c[()/z]
            is precisely
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} c[()/z]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi u
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} c[u/z]
            by the negative
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ↔
                      %mi η
                    %mspace{:width => "thickmathspace"}
                    %mi u
                  %annotation{:encoding => "application/x-tex"} () \;\leftrightarrow_\eta\; u
          %p Conversely, if we start from the positive presentation, then we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ↔
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mi in
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ↔
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi u
                %annotation{:encoding => "application/x-tex"}
                  ()
                  \\;\leftrightarrow_\eta\; let () = u in ()
                  \\;\leftrightarrow_\eta\; u
          %p
            where in the first conversion we use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c \coloneqq ()
            and in the second we use
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ≔
                    %mi z
                  %annotation{:encoding => "application/x-tex"} c\coloneqq z
          %p
            As in the case of binary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction rule
            and the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening rule
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            these rules are disallowed, and therefore the positive and negative unit types become different. The positive product becomes “one”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
          %h2#categorical_semantics Categorical semantics
          %p There are two interpretations of the unit type, corresponding to the positive and negative unit types. Namely:
          %ul
            %li
              %p
                The negative unit type corresponds to a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                in a category
            %li
              %p
                The positive unit type with both
                = succeed "-conversion" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
                = succeed "-conversion" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                with a point, a morphism from some unit object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                to the object corresponding to the unit type, in a category.
          %p
            These two conditions are the same if the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
            and the
            %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "," do
