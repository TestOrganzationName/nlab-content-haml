          %h2#idea Idea
          %p
            A
            %strong building
            (also
            = succeed "," do
              %strong Tits building
            = succeed ")" do
              %strong Bruhat–Tits building
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/flag+manifold"} flag manifold
            = succeed "s," do
