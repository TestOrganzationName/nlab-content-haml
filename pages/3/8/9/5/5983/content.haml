          %h3#line_bundles_with_connection Line bundles with connection
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi ℬ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X = \mathcal{B} U(1) \simeq K(\mathbb{Z},2)
            be the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            that is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
            for
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo :
                  %mo =
                  %mi Id
                  %mo :
                  %mi ℬ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℬ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota := Id : \mathcal{B}U(1) \to \mathcal{B}U(1) \simeq K(\mathbb{Z},2)
            representing in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^2(X,\mathbb{Z})
            the class of the universal complex
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} L \to X
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Accordingly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi S
                  %mo →
                  %mi ℬ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c : S\to \mathcal{B}U(1)
            a continuous map, we have the corresponding line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mo *
                  %mi L
                %annotation{:encoding => "application/x-tex"} c^* L
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            One checks (…details…Example 2.7 in HopSin) that a refinement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to a differential function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi ω
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,\omega,h)
            corresponds to equipping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mo *
                  %mi L
                %annotation{:encoding => "application/x-tex"} c^* L
            with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} smooth connection
          %p
            Now consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi ω
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi ω
                  %mo ′
                  %mo ,
                  %mi h
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi filt
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℬ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Id
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi S
                %annotation{:encoding => "application/x-tex"} ((c,\omega,h) \to (c',\omega', h')) \in filt_0  (\mathcal{B}U(1),Id)^S
            a morphism between two such
            = succeed "-differential" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Id
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{B}U(1),Id)
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi L
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat L
            with connection on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi Diff
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S \times \Delta^i_{Diff}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ^
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Diff
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat \omega \in \Omega^2(S \times \Delta^1_{Diff})
            is of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mover
                      %mi ω
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} g \cdot \tilde \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde \omega
            is a 2-form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is a smooth function on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Diff
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1_{Diff}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Diff
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S \times \Delta^1_{Diff}
            and multiplied there.
          %p
            But since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \omega
            is necessarily
            %em closed
            it follows with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∧
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi d
                  %mi t
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi g
                    %mrow
                      %mo ∂
                      %mi t
                  %mo ∧
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ˜
                  %mo +
                  %mi g
                  %mo ∧
                  %msub
                    %mi d
                    %mi S
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} d (g \wedge \tilde \omega) = d t \frac{\partial g}{\partial t} \wedge \tilde \omega + g \wedge d_{S} \tilde \omega
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is actually constant.
          %p
            This means that that the parallel transoport of the connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∇
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \nabla
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Diff
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S \times \Delta^1_{Diff}
            induces a insomorphism between the two line bundles on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            over the endpoints of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Diff
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S \times \Delta^1_{Diff}
            that respects the connections.
          %p …
          %h3#differential_kcocycles Differential K-cocycles
          %p (…)
          %h3#higher_filtration_degree Higher filtration degree
          #HigherFilteringOfOrdinaryDiffCoh.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} E = H \mathbb{Z}
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %a.maruku-ref{:href => "#LoopObjectsOfDiffFunctionComplexes"}
              states that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi filt
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi H
                    %msup
                      %mi ℤ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ;
                    %msub
                      %mi ι
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi S
                  %annotation{:encoding => "application/x-tex"} filt_{1}(H \mathbb{Z}^{n+1}; \iota_{n})^S
              is an
              %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
              such that the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
