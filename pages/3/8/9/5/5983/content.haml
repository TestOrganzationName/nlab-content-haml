                        %mi X
                        %mo ,
                        %mi ι
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi S
                        %mo ⊂
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ι
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi S
                      %annotation{:encoding => "application/x-tex"} filt_s (X,\iota)^S \subset (X,\iota)^S
                %p
                  for the sub-simplicial set of those differential functions whose differential form component is in
                  = succeed "." do
