                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ×
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} filt_s \Omega^\bullet(U \times \Delta^k)
          %p
            This is (
            %a{:href => "#HopkinsSinger"}> HopkinsSinger, def. 4.5
            ).
          .num_prop
            %h6#proposition Proposition
            %p
              The complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi filt
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi ι
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi U
                  %annotation{:encoding => "application/x-tex"} filt_s (E,\iota)^U
              is (up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi filt
                              %mi s
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %mi ι
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi U
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi filt
                              %mi s
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi Δ
                              %mo •
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Sing
                            %msup
                              %mi E
                              %mi U
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Z
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi Δ
                              %mo •
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    filt_s (E,\iota)^U &amp;\to&amp;
                    filt_s \Omega^n_{cl}(U \times \Delta^\bullet, \mathcal{V})
                    \\\
