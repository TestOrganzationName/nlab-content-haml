                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            has along the simplices.
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} s \in \mathbb{N}
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi filt
