                      %mi Top
                      %mi k
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi ι
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U \times \Delta^k_{Top} \to (E,\iota)
                    \\,.
          %p
            For applications one needs certain sub-complex of this, filtered by the number of legs that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
