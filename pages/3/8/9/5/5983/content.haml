                the
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
                spectrum,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
