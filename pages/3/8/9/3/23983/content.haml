                                  %mi A
                                  %mo ,
                                  %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo ⊢
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ,
                              %mi y
                              %mo ,
                              %mi z
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mi{:mathvariant => "normal"} type
                          %mtr
                            %mtd
                              %mi Γ
                              %mo ⊢
                              %mi t
                              %mo :
