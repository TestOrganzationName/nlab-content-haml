                              %mi a
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi y
                              %mo :
                              %mi B
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi z
                              %mo :
                              %mi B
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi q
                              %mo :
                              %msub
                                %mi{:mathvariant => "normal"} hId
                                %mrow
                                  %mi A
                                  %mo ,
                                  %mi B
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi b
