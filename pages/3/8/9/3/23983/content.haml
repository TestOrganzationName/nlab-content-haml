                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t:\prod_{a:A} \prod_{y:B(a)} C(a,a,\mathrm{refl}_A(x),y,y,\mathrm{hrefl}_{A, B}(a, y))
            into the eliminator along heterogeneous
            %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexivity
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            yields an element equal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t(a, y)
            itself. Normally “equal” here means
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            (a.k.a. definitional equality), but it is also possible for it to mean
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            (a.k.a. typal equality), so there are two possible computation rules.
          %p Computation rules for indexed heterogeneous identity types:
          %ul
            %li
              %p Judgmental computational rule
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mi Γ
                              %mo ⊢
