          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %strong indexed heterogeneous identity type
            or
            %strong indexed dependent identity type
            is a version of the
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            where given a
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %a.existingWikiWord{:href => "/nlab/show/terms"} terms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p:a =_A b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y:B(a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z:B(b)
            is a type whose elements witness that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            are “equal” over or modulo the identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %h3#note_on_terminology Note on terminology
          %p There are many different names used for this particular dependent type, as well as many different names used for the terms of this dependent type. These include the following:
          %table
            %thead
              %tr
                %th name of type
                %th name of terms
            %tbody
              %tr
                %td{:style => "text-align: left;"} indexed heterogeneous identity type
                %td{:style => "text-align: left;"} indexed heterogeneous identities
              %tr
                %td{:style => "text-align: left;"} indexed heterogeneous path type
                %td{:style => "text-align: left;"} indexed heterogeneous paths
              %tr
                %td{:style => "text-align: left;"} indexed heterogeneous identification type
                %td{:style => "text-align: left;"} indexed heterogeneous identifications
              %tr
                %td{:style => "text-align: left;"} indexed heterogeneous equality type
                %td{:style => "text-align: left;"} indexed heterogeneous equalities
          %p These four names have different reasons behind the use of the name:
          %ul
            %li
              %p
                The name “indexed heterogeneous identity type” comes from the fact that the indexed dependent identity type is the canonical
                %a.existingWikiWord{:href => "/nlab/show/one-to-one+correspondence"} one-to-one correspondence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi y
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} Id
                        %mi B
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:B(a), y:B(b) \vdash \mathrm{Id}_B^p(x, y)
                of the
                %a.existingWikiWord{:href => "/nlab/show/transport"} transport
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+type+theory"} equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} tr
                        %mi B
                        %mi p
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{tr}_B^p:B(a) \simeq B(b)
                on a type family
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
                and an identification
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi a
                        %msub
                          %mo =
                          %mi A
                        %mi b
                      %annotation{:encoding => "application/x-tex"} p:a =_A b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo :
                      %mi A
                      %mo ≃
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathrm{id}_A:A \simeq A
            %li
              %p
                The name “indexed heterogeneous path type” comes from the fact that, in a context where terms of ordinary identity types can be represented as functions from an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
                %a.existingWikiWord{:href => "/nlab/show/dependent+functions"} dependent functions
                from the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
          %h2#definitions Definitions
          %h3#using_identity_types Using identity types
          %p
            There are many different ways to define indexed heterogeneous identity types. The simplest definition states that given a
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %a.existingWikiWord{:href => "/nlab/show/inductive+family"} inductive family
            of
            %a.existingWikiWord{:href => "/nlab/show/types"} types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                  %mo ,
                  %mi b
                  %mo :
                  %mi A
                  %mo ,
                  %mi p
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi z
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi p
                  %mo ,
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a:A, b:A, p:\mathrm{Id}_A(a, b), y:B(a), z:B(b) \vdash \mathrm{hId}_{A, B}(a, b, p, y, z)
          %p generated by the family of elements called “heterogeneous reflexivity”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                  %mo ,
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} hrefl
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi a
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi y
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a:A, y:B(a) \vdash \mathrm{hrefl}_{A, B}(a, y):\mathrm{hId}_{A, B}(a, a, \mathrm{refl}_A(a), y, y)
          %h4#inference_rules Inference rules
          %p
            The inference rules for forming indexed heterogeneous identity types and terms are as follows. First the inference rule that defines the indexed heterogeneous identity type itself, as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p Formation rule for indexed heterogeneous identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi a
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi b
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi p
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi y
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi z
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} hId
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{
                  \\begin{array}{l}
                  \\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A \vdash B(x) \; \mathrm{type} \\
                  \\Gamma \vdash a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \quad \Gamma \vdash y:B(a) \quad \Gamma \vdash z:B(b)
                  \\end{array}
                  }{\Gamma \vdash \mathrm{hId}_{A, B}(a, b, p, y, z) \; \mathrm{type}}
          %p Now the basic “introduction” rule, which says that everything is equal to itself in a canonical way.
          %p Introduction rule for indexed heterogeneous identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
