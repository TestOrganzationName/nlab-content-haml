                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi z
                              %mo :
                              %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi q
                              %mo :
                              %msub
                                %mi{:mathvariant => "normal"} hId
