                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t:\prod_{a:A} \prod_{y:B(a)} C(a,a,\mathrm{refl}_A(x),y,y,\mathrm{hrefl}_{A, B}(a, y))
          %p
            then we can construct a canonically defined term called the
            %em eliminator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
