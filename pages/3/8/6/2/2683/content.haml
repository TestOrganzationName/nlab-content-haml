          %h2#definition Definition
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo −
                    %mn 1
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} d-1 \in \mathbb{N}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %em Minkowski space
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
            whose underlying
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi d
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
            and whose
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
            is at each point the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
          %p
