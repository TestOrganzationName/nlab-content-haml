                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T^k_i T^k_j = q_{ij} T^k_j T^k_i, &amp; i \lt j \\
                  T^k_i T^l_i = p_{kl} T^l_i T^k_i, &amp; k \lt l \\
                  q_{ij} T^k_j T^l_i = p_{kl} T^l_i  T^k_j, &amp; i\lt j,\,\,\,\,k\lt l \\
                  T^k_i T^l_j - q_{ij} q^{-1}_{kl} T^l_j T^k_i
                  \= (q_{ij}-p_{ij}^{-1}) T^k_j T^l_i,&amp; i\lt j,\,\,\,\,k\lt l
                  }
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mo =
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mrow
                      %mi P
                      %mo ,
                      %mi Q
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M} = \mathcal{O}(M_{P,Q}(F,n))
            is a bialgebra with respect to the “matrix” comultiplication which is the unique algebra homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mi ℳ
                  %mo →
                  %mi ℳ
                  %mo ⊗
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"}
                  \\Delta : \mathcal{M}
                  \\to\mathcal{M} \otimes\mathcal{M}
            extending the formulas which are written in the matrix form as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %msubsup
                    %mi T
                    %mi j
                    %mi i
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %msubsup
                    %mi T
                    %mi k
                    %mi i
                  %mo ⊗
                  %msubsup
                    %mi T
                    %mi j
                    %mi k
                %annotation{:encoding => "application/x-tex"} \Delta T^i_j = \sum T^i_k \otimes T^k_j
            with counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %msubsup
                    %mi T
                    %mi j
                    %mi i
                  %mo =
                  %msubsup
                    %mi δ
                    %mi j
                    %mi i
