                        %mo ,
                        %mi j
                        %mo =
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \{T^i_j\}_{i,j=1,\ldots,n}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            In these conventions, the 1-parametric version
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msub
