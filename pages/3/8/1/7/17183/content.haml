          %h2#idea Idea
          %p
            %strong Quantum linear semigroups
            are
            %a.existingWikiWord{:href => "/nlab/show/bialgebras"} bialgebras
            which are
            %a.existingWikiWord{:href => "/nlab/show/deformations"} deformations
            of bialgebras of
            %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
            on the
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n\times n
            %a.existingWikiWord{:href => "/nlab/show/invertible+matrices"} invertible matrices
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "." do
              %span.newWikiWord
                matrix bialgebras
                %a{:href => "/nlab/new/matrix+bialgebras"} ?
          %p
            The usual notation for the one-parametric version is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{O}(M_q(n))
            or sometimes simply
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℳ
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}_q(n)
          %p
            Suppose we are given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n\times n
            matrices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi ij
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P = (p_{ij})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi q
                    %mi ij
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q = (q_{ij})
            with invertible entries in the ground field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi ij
                  %msub
                    %mi q
                    %mi ij
                  %mo =
                  %msup
                    %mi q
                    %mn 2
                  %mo ,
                  %msub
                    %mi q
                    %mi ij
                  %mo =
