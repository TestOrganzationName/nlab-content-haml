                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p_{ij} q_{ij} = q^2, q_{ij} = q^{-1}_{ji},\,\,\,\,\,i \lt j,\,\,and \,\,\,\,\,\,
                  q_{ii} = p_{ii},\,\,\,\,\,\,\, for\,\,\, all\,\,\,\, i.
          %p
            The multiparametric quantized matrix bialgebra (synonym: multiparametric quantum linear semigroup)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mrow
                        %mi P
                        %mo ,
                        %mi Q
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} ⟨
                    %msubsup
                      %mi T
                      %mi j
                      %mi i
                    %mo ,
                    %mi i
                    %mo ,
                    %mi j
                    %mo =
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(M_{P,Q}(F,n)):= F \langle T^i_j , i,j = 1,\ldots, n\rangle/I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the ideal spanned by the relations
