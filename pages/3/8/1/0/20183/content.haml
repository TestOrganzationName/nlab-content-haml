          #SullivanModelForSphericalFibration.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
            #eq:SphericalFibration.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^n &amp;\longrightarrow&amp; E
                    \\\
                    \&amp;&amp; \big\downarrow
                    \\\
                    \&amp;&amp; X
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              admits a
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi X
                      %mo ∈
                      %mi dgcAlg
                    %annotation{:encoding => "application/x-tex"} A_X \in dgcAlg
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi E
                  %annotation{:encoding => "application/x-tex"} A_E
              for the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is of the following form:
            %p
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                odd
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 2k+1
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd number
            #eq:SullivanModelForOddDimensionalSphericalFibration.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mi X
                    %mo ⊗
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi d
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_E
                    \\;=\;
                    A_X
                    \\otimes
                    \\mathbb{Q}\big[
                    \\omega_{2k+1}
                    \\big]
                    \/
                    \\big(
                    d \omega_{2k+1} = c_{2k+2}
                    \\big)
            %p for some
            #eq:RationalEulerClass.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
                    %mo ∈
                    %msub
                      %mi A
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    c_{2k+2} \in A_X
            %p
              being the rational
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
            %p
              In particular, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = S(V)
              is the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              of a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi χ
                  %annotation{:encoding => "application/x-tex"}
                    [c_{2k}] = \chi
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
              of that vector bundle and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \omega_{2k+1}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cochain"} cochain
              on the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(E)
              which on the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              of any
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2k+1)-sphere
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              evaluates to minus unity:
            #eq:FiberIntegrationOfOddGenerator.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %msub
                        %mi ω
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo ,
                      %mrow
                        %mo [
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                        %mo ]
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle
                    \\omega_{2k+1},
                    \\left[
                    S^{2k+1}
                    \\right]
                    \\right\rangle
                    \\;=\;
                    \-1
                    \\,.
            %p
              %br/
            %p
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                even
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/even+number"} even number
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi E
                  %annotation{:encoding => "application/x-tex"} A_E
              for a rank-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 2k
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
              over some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi X
                  %annotation{:encoding => "application/x-tex"} A_X
              is
            #eq:FibS2kModel.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mi X
                    %mo ⊗
                    %mi ℚ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi k
                    %mo ,
                    %msub
                      %mi ω
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ω
                                %mrow
                                  %mn 2
                                  %mi k
                            %mtd
                              %mo =
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mi d
                              %msub
                                %mi ω
                                %mrow
                                  %mn 4
                                  %mi k
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo =
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi ω
                                %mrow
                                  %mn 2
                                  %mi k
                              %mo ∧
                              %msub
                                %mi ω
                                %mrow
                                  %mn 2
                                  %mi k
                              %mo +
                              %msub
                                %mi c
                                %mrow
                                  %mn 4
                                  %mi k
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    A_E
                    \\;=\;
                    A_X
                    \\otimes
                    \\mathbb{Q}
                    \\Big[
                    \\omega_{2k} , \omega_{4k-1}
                    \\Big]
                    \/
                    \\left(
                    \\array{
                    d
                    \\,
                    \\omega_{2k}
                    \&amp;=&amp;
                    0
                    \\\
                    d \omega_{4k-1}
                    \&amp; =&amp;
                    \-
                    \\omega_{2k} \wedge \omega_{2k}
                    +
                    c_{4k}
                    }
                    \\right)
            %p where
            %ol
              %li
                %p
                  the new generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mrow
                            %mn 2
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \omega_{2k}
                  evaluates to unity on the
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+classes"} fundamental classes
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2k-sphere
                  %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                        %mo ≃
                        %msub
                          %mi E
                          %mi x
                        %mo ↪
                        %mi E
                      %annotation{:encoding => "application/x-tex"} S^{2k} \simeq E_x \hookrightarrow E
                  over each point
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %msub
                          %mi ω
                          %mrow
                            %mn 2
                            %mi k
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\big\langle  \omega_{2k}, [S^{2k}] \big\rangle
                        \\;=\;
                        1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mrow
                            %mn 4
                            %mi k
                        %mo ∈
                        %msub
                          %mi A
                          %mi X
                      %annotation{:encoding => "application/x-tex"} c_{4k} \in A_X
                  is some element in the base algebra, which by
                  %a.maruku-eqref{:href => "#eq:FibS2kModel"} (5)
                  is closed and represents the rational
                  %a.existingWikiWord{:href => "/nlab/show/cohomology+class"} cohomology class
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup
                  square of the class of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mrow
                              %mn 2
                              %mi k
                        %annotation{:encoding => "application/x-tex"} \omega_{2k}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msub
                          %mi c
                          %mrow
                            %mn 4
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msub
                          %mi ω
                          %mrow
                            %mn 2
                            %mi k
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mrow
                            %mn 4
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ,
                        %mi ℚ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\big[
                        c_{4k}
                        \\big]
                        \\;=\;
                        \\big[
                        \\omega_{2k}
                        \\big]^2
                        \\;\in\;
                        H^{4k}
                        \\big(
                        X, \mathbb{Q}
                        \\big)
                %p and this class classifies the spherical fibration, rationally.
            %p
              Moreover, if the
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              happens to be the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = S(V)
              of a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V \to X
            %ol
              %li
                %p
                  the class of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mrow
                            %mn 2
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \omega_{2k}
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 1/2
                  the rationalized
                  %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi V
                          %mo ^
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi(\widehat V)
                  of the corresponding (…) rank
                  %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi V
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat V
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msub
                          %mi ω
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mi χ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mover
                          %mi V
                          %mo ^
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ,
                        %mi ℚ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\big[ \omega_{2k} \big]
                        \\;=\;
                        \\tfrac{1}{2}\chi\big( \widehat V \big)
                        \\;\in\;
                        H^{2k}\big( X, \mathbb{Q} \big)
              %li
                %p
                  the class of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mrow
                            %mn 4
                            %mi k
                      %annotation{:encoding => "application/x-tex"} c_{4k}
                  is
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} 1/4
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p_k(V)
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msub
                          %mi c
                          %mrow
                            %mn 4
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 4
                        %msub
                          %mi p
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mrow
                            %mn 4
                            %mi k
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ,
                        %mi ℚ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\big[
                        c_{4k}
                        \\big]
                        \\;=\;
                        \\tfrac{1}{4}
                        p_k(V)
                        \\;\in\;
                        H^{4k}\big( X, \mathbb{Q}\big)
                        \\,.
          %p
            This may be found as
            = succeed "," do
              %a{:href => "#FelixHalperinThomas00"} Félix-Halperin-Thomas 00, 15, Example 4, p. 202
            = succeed "." do
              %a{:href => "#FelixOpreaTanre16"} Félix-Oprea-Tanré 16, Prop. 2.3
            %a.maruku-eqref{:href => "#eq:FiberIntegrationOfOddGenerator"} (4)
            follows by
            = succeed "." do
              %a{:href => "Euler+class#TrivializationOfEulerFormOnUnitSphereBundle"} this Prop.
          #NonMinimalityOfSullivanModels.num_remark
            %h6#remark Remark
            %p
              Beware that the Sullivan models for spherical fibrations in Prop.
              %a.maruku-ref{:href => "#SullivanModelForSphericalFibration"}
              are not in general
              %em minimal
              Sullivan models.
            %p
              For example over the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %span.newWikiWord
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B SO(8)
                %a{:href => "/nlab/new/BSO%28n%29"} ?
              of
              %a.existingWikiWord{:href => "/nlab/show/SO%288%29"} SO(8)
              with indecomposable
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
              generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} \chi_8
              the equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi ω
                      %mn 7
                    %mo =
                    %msub
                      %mi χ
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} d \omega_7 = \chi_8
              %a.maruku-eqref{:href => "#eq:SullivanModelForOddDimensionalSphericalFibration"} (2)
              for the univeral 7-sperical fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mo ⫽
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^7 \sslash SO(8) \to B SO(8)
              violates the Sullivan minimality condition (which requires that the right hand side is at least a binary wedge product of generators, or equivalently that the degree of the new generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \omega_7
              is greater than that of any previous generators).
            %p
              But the Sullivan models in Prop.
              %a.maruku-ref{:href => "#SullivanModelForSphericalFibration"}
              are
              %em relative
              minimal models, relative to the Sullivan model for the base.
            %p
              This means in particular that the new generators of these models reflect non-
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
              = succeed "," do
                %span.newWikiWord
                  relative homotopy groups
                  %a{:href => "/nlab/new/relative+homotopy+groups"} ?
          %h3#relation_to_rational_mapping_space_of_spheres Relation to rational mapping space of spheres
          %p
            By general facts (see at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            %a.maruku-eqref{:href => "#eq:SphericalFibration"} (6)
            is classified by a map to the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B Aut(S^n)
            of the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msup
                    %mi S
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(S^n) \hookrightarrow Maps(S^n, S^n)
            inside the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n
            to itself, which is those
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            corresponding to
            %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ±
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \pm 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Maps
                    %mrow
                      %mo ±
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msup
                    %mi S
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Aut(S^n) \;=\; Maps_{\pm 1}\big( S^n, S^n\big)
                  \\,.
          %p
            Hence the spherical fibration is given by the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          #eq:SphericalFibration.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mi n
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi E
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi S
                            %mi n
                          %mo ⫽
                          %mi Aut
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                          %msub
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                        %mtd
                          %munder
                            %mo ⟶
                            %mi c
                        %mtd
                          %mi B
                          %mi Aut
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S^n
                  \&amp;\longrightarrow&amp;
                  E
                  \&amp;\longrightarrow&amp;
                  S^{n}\sslash Aut(S^n)
                  \\\
                  \&amp;&amp;
                  \\big\downarrow
                  \&amp;{}_{(pb)}&amp;
                  \\big\downarrow
                  \\\
                  \&amp;&amp;
                  X
                  \&amp;\underset{c}{\longrightarrow}&amp;
                  B Aut(S^n)
                  }
          %p
            of the universal spherical fibration along a classifying map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            The rational homotopy type of these
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            of the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            are given by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+models+of+mapping+spaces"} Sullivan models of mapping spaces
          #RationalTypeOfMappingSpaceSnToSn.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              be a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \colon S^n \to S^n
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              from the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              to itself. Then the
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} Maps_f\big( S^n, S^n\big)
              of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              which contains this map has the following
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            #eq:RationalHomotopyTypeOfMappingSpacesSnToSn.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mi ℚ
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mi n
                              %mo ×
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mn 2
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo ≠
                              %mn 0
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mi n
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                  %annotation{:encoding => "application/x-tex"}
                    Maps_f\big( S^n, S^n\big)
                    \\;\simeq_{\mathbb{Q}}\;
                    \\left\{
                    \\array{
                    S^n \times S^{n-1} &amp;\vert&amp; n\,\text{even}\,, deg(f) = 0
                    \\\
                    S^{2n-1} &amp;\vert&amp; n \, \text{even}\,, deg(f) \neq 0
                    \\\
                    S^n &amp;\vert&amp; n\, \text{odd}
                    }
                    \\right.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} deg(f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %p
            (
            %a{:href => "#MollerRaussen85"}> Møller-Raussen 85, Example 2.5
            ,
            = succeed ")" do
              %a{:href => "#CohenVoronov05"} Cohen-Voronov 05, Lemma 5.3.5
          .num_remark
            %h6#remark_2 Remark
            %p
              Here Prop.
              %a.maruku-ref{:href => "#RationalTypeOfMappingSpaceSnToSn"}
              and Prop.
              %a.maruku-ref{:href => "#SullivanModelForSphericalFibration"}
              are two aspects of the same situation:
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 2k+1
              an
              %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd number
              the rational
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
              %a.maruku-eqref{:href => "#eq:RationalEulerClass"} (3)
              of the spherical fibration is the class of the rational classifying map to the shift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2k+1}
              in
              = succeed ";" do
                %a.maruku-eqref{:href => "#eq:RationalHomotopyTypeOfMappingSpacesSnToSn"} (7)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              an
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even number
              the rational
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
              %a.maruku-eqref{:href => "#eq:RationalPontryaginClass"} (?)
              of the spherical fibration is the class of the rational classifying map to the shift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{4k-1}
              in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:RationalHomotopyTypeOfMappingSpacesSnToSn"} (7)
          %h2#related_concepts Related concepts
          %div
            %p
              %strong
                Examples of
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+models"} Sullivan models
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %ul
              %li
                %p
