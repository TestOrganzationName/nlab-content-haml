                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                2-form of the
                %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
                has vanishing bispinorial component:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mi α
                          %mi β
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      F_{\alpha \beta} = 0
              %p
                (this is the
                %a.existingWikiWord{:href => "/nlab/show/10d+super+Yang-Mills+theory"} 10d super Yang-Mills theory
                sector)
          %p
            This is due to (
            %a{:href => "#Witten86"}> Witten 86 (5)+(27)
            ), see also (
            %a{:href => "#AtickDharRatra86"}> Atick-Dhar-Ratra 86 (4.1)
            ). These authors do not state explicitly that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mi α
                        %mi β
                    %mo ∝
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi λ
                      %mi α
                    %msup
                      %mi λ
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi^{\alpha \beta} \propto tr(\lambda^\alpha \lambda^\beta) - tr (T T)
            = succeed ")." do
              %a{:href => "#CandielloLechner93"} Candiello-Lechner 93 (2.5) with (2.29)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mi a
                    %mi ψ
                    %mo ∧
                    %msup
                      %mi e
                      %mi a
                    %mo )
                  %mo ∝
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %munder
                    %munder
                      %mrow
                        %mrow
                          %mo (
                          %mover
                            %mi ψ
                            %mo ¯
                          %msub
                            %mi Γ
                            %mi a
                          %msup
                            %mi χ
                            %mi i
                          %mo )
                        %mo ∧
                        %msup
                          %mi e
                          %mi a
                      %mo ⏟
                    %mrow
                      %mo =
                      %msubsup
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mi i
                  %mo ∧
                  %munder
                    %munder
                      %mrow
                        %mrow
                          %mo (
                          %mover
                            %mrow
                              %msup
                                %mi χ
                                %mi i
                            %mo ¯
                          %msub
                            %mi Γ
                            %mi b
                          %mi ψ
                          %mo )
                        %mo ∧
                        %msup
                          %mi e
                          %mi b
                      %mo ⏟
                    %mrow
                      %mo =
                      %msubsup
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mi i
                  %mo −
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mi R
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  d
                  \\left(
                  \\overline{\psi}
                  \\wedge
                  \\Gamma_a
                  \\psi
                  \\wedge e^a
                  \\right)
                  \\propto
                  \\underset{i}{\sum}
                  \\underset{= F^i_{(1,1)}}{
                  \\underbrace{
                  \\left(
                  \\overline{\psi} \Gamma_a \chi^i
                  \\right)
                  \\wedge e^a
                  }
                  }
                  \\wedge
                  \\underset{ = F^i_{(1,1)}}{
                  \\underbrace{
                  \\left(
                  \\overline{\chi^i}
                  \\Gamma_b
                  \\psi
                  \\right)
                  \\wedge e^b
                  }
                  }
                  \- tr(R R)_{(2,2)}
          %p
            where we used the relation (
            %a{:href => "#Witten86"}> Witten 86 (8)
            ) (recalled for instance in
            = succeed "," do
              %a{:href => "#BonoraBregolaLechnerPastiTonin87"} Bonora-Bregola-Lechner-Pasti-Tonin 87 (2.28)
            = succeed ")." do
              %a{:href => "#LechnerTonin08"} Lechner-Tonin 08 (2.13)
          %p
            According to (
            %a{:href => "#BonoraBregolaLechnerPastiTonin90"}> Bonora-Bregola-Lechner-Pasti-Tonin 90
            ) in fact all these constraints follow from just
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mrow
                        %mi α
                        %mi β
                      %mi a
                    %mo ∝
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi α
                        %mi β
                      %mi a
                  %annotation{:encoding => "application/x-tex"} T^a_{\alpha \beta}  \propto \Gamma^a_{\alpha \beta}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/CR+manifold"} CR manifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fre formulation of supergravity
          %h2#references References
          %h3#general General
          %p The formulation of supergravity equations of motion in terms of constraints on the torsion tensor goes back to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Julius+Wess"} Julius Wess
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Zumino"} Bruno Zumino
              = succeed "," do
                %em Superspace formulation of supergravity
          %p
            A mathematical formulation in terms of
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion-full
            %a.existingWikiWord{:href => "/nlab/show/first-order+integrable+G-structure"} first-order integrable
            %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            on
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            (for low dimensional supergravity theories) is given in
          %ul
            %li#Lott01
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"}> John Lott
                ,
                %em The Geometry of Supergravity Torsion Constraints
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0108125"}> arXiv:0108125
                \&amp;rbrack;
              %p following:
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"}> John Lott
                ,
                = succeed "," do
                  %em Torsion constraints in supergeometry
                %strong 133
                (1990) 563-615 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF02097010"}> doi:10.1007/BF02097010
                \&amp;rbrack;
          %p which is followed up in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michel+Egeileh"}> Michel Egeileh
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Fida+El+Chami"} Fida El Chami
              = succeed "," do
                %em Some remarks on the geometry of superspace supergravity
              %strong 62
              (2012) 53-60 &amp;lbrack;
              %a{:href => "http://inspirehep.net/record/1333125"}> spire:1333125
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.geomphys.2011.09.008"} doi:10.1016/j.geomphys.2011.09.008
          %h3#for_11d_supergravity For 11d supergravity
          %p
            Discussion of torsion constrains for
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            from the point of view of consistency of the
            %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+action+functional"} Green-Schwarz action functional
            is in
          %ul
            %li#BergshoeffSezginTownsend87
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em Supermembranes and eleven dimensional supergravity
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Duff"} Mike Duff
              %em
                %a.existingWikiWord{:href => "/nlab/show/The+World+in+Eleven+Dimensions"} The World in Eleven Dimensions
              69-72 (
              %a{:href => "http://streaming.ictp.trieste.it/preprints/P/87/010.pdf"}> pdf
              ,
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/248230?ln=en"} spire
          %p
            The claim that this torsion constraint in
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            is already equivalent to all of the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            is due to
          %ul
            %li#CandielloLechner93
              %p
                A. Candiello,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %em Duality in Supergravity Theories
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9309143"} arXiv:hep-th/9309143
            %li#Howe97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                \:
                = succeed "," do
                  %em Weyl Superspace
                %strong 415
                2 (1997) 149-155 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9707184"}> arXiv:hep-th/9707184
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(97)01261-6"} doi:10.1016/S0370-2693(97)01261-6
          %p concisely reviewed in
          %ul
            %li#CederwallGranNilssonTsimpis04
              %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Gran"} Ulf Gran
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
              = succeed "," do
                %em Supersymmetric Corrections to Eleven-Dimensional Supergravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/hep-th/0409107"} arXiv:hep-th/0409107
          %p
            For commentary see also (
            %a{:href => "#Nilsson00"}> Nilsson 00, section 2
            ) and
          %ul
            %li#CGNN00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Gran"} Ulf Gran
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                = succeed "," do
                  %em Manifestly supersymmetric M-theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0007035"} arXiv:hep-th/0007035
            %li#HoweSezgin05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em The supermembrane revisited
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0412245"} arXiv:hep-th/0412245
          %p also
          %ul
            %li#BrinkHowe80
              %a.existingWikiWord{:href => "/nlab/show/Lars+Brink"}> Lars Brink
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"} Paul Howe
              = succeed "," do
                %em Eleven-dimensional supergravity on the mass shell in superspace
          %p
            Discussion of possible deformations of the torsion constraint (
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            corrections) includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Gran"} Ulf Gran
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                = succeed "," do
                  %em Generalised 11-dimensional supergravity
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0010042"} arXiv:hep-th/0010042
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
                = succeed "," do
                  %em On higher-order corrections in M theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0305129"} arXiv:hep-th/0305129
          %h3#for_10d_heterotic_supergravity For 10d heterotic supergravity
          %p
            Discussion of torsion constraints for
            %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            goes back to (
            %a{:href => "Green-Schwarz+action+functional#Nilsson81"}> Nilsson 81
            ) and includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                , A. Umerski,
                = succeed "," do
                  %em On superspace supergravity in ten dimensions
            %li#AtickDharRatra86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Atick"}> Joseph Atick
                , Avinash Dhar, and Bharat Ratra,
                = succeed "," do
                  %em Superspace formulation of ten-dimensional N=1 supergravity coupled to N=1 super Yang-Mills theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1103/PhysRevD.33.2824"} doi.org/10.1103/PhysRevD.33.2824
            %li#Witten86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Twistor-like transform in ten dimensions
            %li#BonoraBregolaLechnerPastiTonin87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Loriano+Bonora"}> Loriano Bonora
                , M. Bregola;
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Anomaly-free supergravity and super-Yang-Mills theories in ten dimensions
              %p
                Volume 296, Issue 4, 25 January 1988 (
                %a{:href => "http://dx.doi.org/10.1016/0550-3213(88)90402-6"}> doi:10.1016/0550-3213(88)90402-6
                )
            %li#BonoraBregolaLechnerPastiTonin90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Loriano+Bonora"}> Loriano Bonora
                , M. Bregola;
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em
                    A discussion of the constraints in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} N=1
                    SUGRA-SYM in 10-D
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0217751X90000222"} doi:10.1142/S0217751X90000222
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                %em Heterotic supergeometry revisited
                (
                %a{:href => "http://arxiv.org/abs/0805.2893"}> arXiv:0805.2893
                )
            %li#Nilsson00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"}> Bengt Nilsson
                ,
                %em A superspace approach to branes and supergravity
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0007017"}> arXiv:hep-th/0007017
                )
            %li#LechnerTonin08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"}> Kurt Lechner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Superspace formulations of ten-dimensional supergravity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0802.3869"} arXiv:0802.3869
          %h3#ReferencesFor4d For 4d supergravity
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/d%3D4+N%3D1+supergravity"} d=4 N=1 supergravity
            the torsion is again constrained to be equal to the left-invariant torsion of super-Minkowski spacetime, see for instance
          %ul
            %li#CastellaniDAuriaFre
              %p
                %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
            %li
              %p
                Daniel Patrick Butter, section 2.2.5 of
                = succeed "," do
                  %em On conformal superspace and the One-Loop Effective Action in Supergravity
                = succeed ")" do
                  %a{:href => "http://digitalassets.lib.berkeley.edu/etd/ucb/text/Butter_berkeley_0028E_10582.pdf"} pdf
          %h3#for_2d_supergravity__superstring_worldsheets__super_riemann_surfaces For 2d supergravity / superstring worldsheets / super Riemann surfaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Suresh+Govindarajan"}> Suresh Govindarajan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
              = succeed "," do
                %em
                  A geometric interpretation for the torsion constrains of
                  = succeed "-heterotic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (2,0)
              = succeed ")" do
                %a{:href => "http://www.physics.iitm.ac.in/~suresh/sgtalk/talk_html/torsion.pdf"} pdf
        .revisedby
          %p
