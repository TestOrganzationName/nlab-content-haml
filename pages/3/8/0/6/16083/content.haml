            (e.g.
            %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
