                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbf{d} E^a + \omega^{a}{}_b \wedge E^b - \bar \psi \Gamma^a \psi  = 0
            as well as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi Ψ
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
