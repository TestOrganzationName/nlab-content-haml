                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (0,1] \times S^k \to D^{k+1}
              this defines a form on the
              = succeed "-ball," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
