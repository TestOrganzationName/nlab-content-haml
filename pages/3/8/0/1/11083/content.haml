                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %a.existingWikiWord{:href => "/nlab/show/Steenrod-Wockel+approximation+theorem"} Steenrod-Wockel approximation theorem
              the diffeomorphism from this
              = succeed "-thickening" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
