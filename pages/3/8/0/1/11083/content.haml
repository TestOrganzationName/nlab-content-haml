                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S^k \times [1,1-\epsilon]
              inside the
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
