                  %mrow
                    %mi A
                    %mo :
                    %mo =
                    %mi P
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} A := P\omega
              is a solution of the differential equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi A
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} d A=\omega
              depending smoothly on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
          %h4#integrating_the_string_lie_2algebra_to_the_string_lie_2group Integrating the string Lie 2-algebra to the string Lie 2-group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo =
                  %msub
                    %mi 𝔤
                    %mi μ
                %annotation{:encoding => "application/x-tex"} \mathfrak{string} = \mathfrak{g}_\mu
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔤
                    %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g}_\mu)
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                %annotation{:encoding => "application/x-tex"} \mathbf{B}String
          %ul
            %li
              %p with a single object;
            %li
              %p
                whose morphisms are based paths in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                whose 2-morphisms are equivalence class of pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Sigma,c)
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                          %mo :
                          %msubsup
                            %mi D
                            %mo *
                            %mn 2
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \Sigma : D^2_*  \to G
                    is a smooth based map (where we use a
                    %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi D
                            %mn 2
                          %mo ≃
                          %msup
                            %mi Δ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} D^2 \simeq \Delta^2
                    which away from the corners is smooth, so that forms with sitting instants there do not see any non-smoothness, and the basepoint of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi D
                            %mo *
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} D^2_*
                    is the 0-vertex of
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Δ
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} \Delta^2
                %li
                  %p
                    and
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo ∈
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} c \in U(1)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo :
                          %msup
                            %mi D
                            %mn 3
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \phi : D^3 \to G
                    filling them the labels
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi c
                            %mn 1
                          %mo ,
                          %msub
                            %mi c
                            %mn 2
                          %mo ∈
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} c_1, c_2 \in U(1)
                    differ by the integral
                    = succeed ",," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi D
                                  %mn 3
                            %msup
                              %mi ϕ
                              %mo *
                            %mi μ
                            %mo{:stretchy => "false"} (
                            %mi θ
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi ℤ
                          %annotation{:encoding => "application/x-tex"} \int_{D^3} \phi^* \mu(\theta) \;\; mod \;\; \mathbb{Z}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi θ
                  %mo ∧
                  %mo{:stretchy => "false"} [
                  %mi θ
                  %mo ∧
                  %mi θ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \mu(\theta) = \langle \theta\wedge [\theta \wedge \theta]\rangle
            the 3-form obtained by plugging it into the cocycle.
