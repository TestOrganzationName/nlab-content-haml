                              %mtd
                                %mo ↗
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi f
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi ℝ
                                        %mrow
                                          %msub
                                            %mi n
                                            %mn 1
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi X
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo{:stretchy => "false"} )
