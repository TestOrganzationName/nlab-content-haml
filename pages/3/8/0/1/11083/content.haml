              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
