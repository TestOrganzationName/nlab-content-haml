              for the
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/smooth+infinity-groupoid#CircleLienGroup"} smooth line (n+1)-group
          .num_prop
            %h6#observation Observation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
              underlying
