                    \\,.
          .proof
            %h6#proof_9 Proof
            %p First we observe that the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mo •
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                        %mo ,
                        %mi cl
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mi k
                    %mi ω
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^\bullet}
                    \:
                    (\omega \in \Omega^n_{si,vert,cl}(U \times \Delta^k))
                    \\mapsto
                    \\int_{\Delta^k} \omega \in C^\infty(U, \mathbb{R})
            %p
              is a morphism of
