                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo ∫
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \exp(\int - )
                    \:
                    \\mathbf{cosk}_3 \exp(\mathfrak{g})
                    \\simeq
                    \\mathbf{cosk}_2 \exp(\mathfrak{g}) \simeq \mathbf{B}G_c
                    \\,.
          %p
            This follows from the
            %a.existingWikiWord{:href => "/nlab/show/Steenrod-Wockel+approximation+theorem"} Steenrod-Wockel approximation theorem
            and the following observation.
          .num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_0 \in X
              a basepoint, there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi C
                      %mo *
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1_{flat}(X,\mathfrak{g}) \simeq C^\infty_*(X,G)
            %p
              between the set of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form vanishes, and the set of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X\to G
              that take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              to the neutral element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} e \in G
          .proof
            %h6#proof_8 Proof
            %p
              The bijection is given as follows. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1_{flat}(X,\mathfrak{g})
              a flat 1-form, the corresponding function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi A
                    %mo :
                    %mi X
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} f_A : X \to G
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              to the
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              along any path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x_0 \to x
              from the base point to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi A
                    %mo :
                    %mi x
                    %mo ↦
                    %msub
                      %mi tra
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo →
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_A : x \mapsto tra_A(x_0 \to x)
                    \\,.
            %p
              Because of the assumption that the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              vanishes and the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %p
              Conversely, for every such function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} f : X \to G
              we recover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as the pullback of the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A = f^* \theta
                    \\,.
          %p From this we obtain
          .proof
            %h6#proof_of_the_proposition Proof of the proposition
            %p
              The
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_2 \exp(\mathfrak{g})
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              with a single object (no non-trivial 1-form on the point) whose morphisms are equivalence classes of smooth based paths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Delta^1 \to G
              (with sitting instants), where two of these are taken to be equivalent if there is a smooth
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mn 2
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} D^2 \to G
              (with sitting instant) between them.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_remark
            %h6#remark_16 Remark
            %p
              We do not need to fall back to classical
              %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
              to obtain
