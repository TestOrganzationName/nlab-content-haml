            of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ,
                  %msub
                    %mi x
                    %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r,x_r)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo &lt;
                  %mi r
                  %mo &lt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \lt r \lt 1
            and where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi r
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi D
                      %mi r
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x_r \in X(D^n_r)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %msub
                        %mi r
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 2
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r_1, x_{r_1})\sim (r_2, x_{r_2})
            precisely if there is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mn 0
                  %mo &lt;
                  %msub
                    %mi r
                    %mn 1
                  %mo ,
                  %msub
                    %mi r
                    %mn 2
                %annotation{:encoding => "application/x-tex"} r_0 \lt r_1,r_2
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %msub
                        %mi r
                        %mn 1
                %annotation{:encoding => "application/x-tex"} x_{r_1}
            becomes equal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                %annotation{:encoding => "application/x-tex"} x_{r_2}
            after restriction to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi D
                      %mrow
                        %msub
                          %mi r
                          %mn 0
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n_{r_0}
          #LocalWeakEquivalence.num_defn
            %h6#definition_10 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              of pre-smooth groupoids, def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
              %em
                local
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              if for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              = succeed "-stalk," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.maruku-ref{:href => "#Stalks"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ((D^n)^* f) \colon (D^n)^* X \stackrel{}{\longrightarrow} (D^n)^* Y
                    \\,.
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟶
                    %mo ≃
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\stackrel{\simeq}{\longrightarrow} Y
            for local weak equivalences of pre-smooth groupoids. We will mostly just say
            %em weak equivalence
            for short.
          #CoveringMapIsLocalWeakEquivalence.num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              for it, then the canonical morphism from the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidOfCover"}
              = succeed "." do
                %a.maruku-ref{:href => "#LocalWeakEquivalence"}
          .proof
            %h6#proof_4 Proof
            %p
              The
              = succeed "-stalk" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              regarded as a presheaf is the set of equivalence classes of maps from open pointed
              = succeed "-disks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %em
                %a.existingWikiWord{:href => "/nlab/show/germs"} germs
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (but beware that this terminology is typically used for something a little bit more restrictive, namely for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is the dimension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and that all maps from the disks into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are required to be
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/embeddings"} embeddings
            %p
              On the other hand the
              = succeed "-stalk" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is the groupoid whose set of objects is the set of germs, in this sense, of the disjoint union
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \underset{i}{\coprod} U_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \underset{i,j}{\coprod} U_i \underset{X}{\times} U_j
            %p
              But now since the cover is by
              %em
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              subsets, it follows that for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} (x,i,j) \in \underset{i,j}{\coprod} U_i \underset{X}{\times} U_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [g]
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,i)
              has a representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              that factors through this double intersection charts:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %msubsup
                        %mi D
                        %mi r
                        %mi n
                      %mo →
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi u
                    %annotation{:encoding => "application/x-tex"} g \colon D^n_r \to U_i \underset{X}{\times} U_j \to \underset{i}{\coprod} U_u
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,j)
            %p
              This means that the groupoid of
              = succeed "-stalks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to the point.
            %p
              Now the canonical cover projection sends each of these connected components to the germ that it corresponds to. Hence this is a an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
          %h4#hypercovers Hypercovers
          #SplitHypercover.num_defn
            %h6#definition_11 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon Y \longrightarrow X
              of pre-smooth groupoids is called a
              %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  is
                %ol
                  %li
                    %p
                      degreewise a
                      %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                      of
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                  %li
                    %p such that the degenerate elements split off as a dijoint summand.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a weak equivalence, def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LocalWeakEquivalence"}
          #GoodCechCoverIsSplitHypercover.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
              from the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidOfCover"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good
          .proof
            %h6#proof_5 Proof
            %p
              For every cover the map is a weak equivalence, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CoveringMapIsLocalWeakEquivalence"}
            %p
              For the Cech groupoid the condition of cofibrancy in def.
              %a.maruku-ref{:href => "#SplitHypercover"}
              means that every non-empty finite intersection of patches is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          %h4#the_category_of_smooth_groupoids
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
          %p
            The
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            of genuine smooth groupoids is that obtained from that of pre-smooth groupoids, def.
            %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
            by “universally turning local
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            = succeed "," do
              %a.maruku-ref{:href => "#LocalWeakEquivalence"}
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            %a.maruku-ref{:href => "#SmoothGroupoidsBySimplicialLocalization"}
            below, but for many applications in practice certain concrete presentations of what this means concretely are well sufficient, one of these we state below in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves"}
          #SmoothGroupoidsBySimplicialLocalization.num_defn
            %h6#definition_12 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo ≔
                    %msub
                      %mi L
                      %mi lwe
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type
                    \\coloneqq
                    L_{lwe} PreSmooth1Type
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              which is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of groupoid-valued presheaves at the local weak equivalences, def.
              = succeed "." do
                %a.maruku-ref{:href => "#LocalWeakEquivalence"}
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X \in Smooth1Type
              we call a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
              or
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/smooth+homotopy+type"} smooth homotopy 1-type
          #HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves.num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X,A \in PreSmooth1Type
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              satisfies descent, def.
              = succeed "." do
                %a.maruku-ref{:href => "#DescentForPreSmoothGroupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.maruku-ref{:href => "#SplitHypercover"}
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,A)
                    \\simeq
                    PreSmooth1Type(Y,A)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              of smooth groupoids from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            Such statements follow with
            %a.existingWikiWord{:href => "/nlab/show/model+structures+on+simplicial+presheaves"} model structures on simplicial presheaves
            after embedding the present situation in the more general context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
          #NotationForLocalization.num_remark
            %h6#remark_7 Remark
            %p There is a canonical localization functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo ⟶
                    %msub
                      %mi L
                      %mi lwe
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo =
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PreSmooth1Type
                    \\longrightarrow
                    L_{lwe} PreSmooth1Type
                    \=
                    Smooth1Type
                    \\,.
            %p
              which is really just the identity as a functor. Instead of doing anything to the objects, passing along this functor just means to change the definition of the hom-groupoids from the direct definition of def.
              %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
              to the localized definition.
            %p
              When a pre-smooth groupoid is given by an
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              in
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#ExternalYonedaEmbeddingsIntoPreSmooth1Type"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} Smooth1Type
              it no longer makes sense to ask what the space of 0-cells and of 1-cells of an object is, as these are concepts not invariant under local weak equivalence.
            %p
              In particular this means that we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              for the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_\bullet
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Smooth
                      %mn 1
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} Smooth1Type
          #StackMapsFromXtoDeloopingOfG.num_prop
            %h6#proposition_10 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopedGroupAsPreSmoothGroupoid"}
              = succeed ")." do
                %a.maruku-ref{:href => "#NotationForLocalization"}
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,\mathbf{B}G)
                    \\simeq
                    G Bund(X)
            %p
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#bfBGbulletSatisfiesDescent"}
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_\bullet
              satisfies descent on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              a differentiably
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %a.maruku-ref{:href => "#GoodCechCoverIsSplitHypercover"}
              the correspoding
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              = succeed "." do
                %a.maruku-ref{:href => "#SplitHypercover"}
              = succeed "," do
                %a.maruku-ref{:href => "#HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,\mathbf{B}G)
                    \\simeq
                    PreSmooth1Type(C(\{U_i\}), (\mathbf{B}G)_\bullet)
                    \\,.
            %p
              The groupoid on the right is, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CechCoyclesAsSmoothMaps"}
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech 1-cocycles and coboundaries
              with values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              relative to a good open cover. This is equivalently the groupoid of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_remark
            %h6#remark_8 Remark
            %p
              The content of prop.
              %a.maruku-ref{:href => "#StackMapsFromXtoDeloopingOfG"}
              is in common jargon that:
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo ∈
                      %mi SmoothGrpd
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in SmoothGrpd
                is the
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "\u201C." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
          %h2#smooth_groupoids
            Smooth
            = succeed "-Groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p (…under construction…)
          %h3#simplicial_presheaves Simplicial presheaves
          %p
            We need structures a bit richer than just bare
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is to remember the rule which for each test space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            produces the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            we could test with each
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} U = \mathbb{R}^n
            and find the
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(U)
            of smooth
            = succeed "-parameter" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            This data of
            = succeed "-families" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            with values in Kan complexes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi KanCplx
                  %mo ↪
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  K : C^{op} \to KanCplx \hookrightarrow sSet
          %p
            hence with values in simplicial sets. This is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            of sets. The
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the category of test objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            serves as a model for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-structure." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            While there are no
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/higher+morphism"} higher morphism
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            %em all
            these higher morphisms (up to equivalence!) is just the information of which morphisms of simplicial presheaves would become invertible if we were keeping track of higher morphism. These would-be invertible morphisms are called
            %em weak equivalences
            and denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 1
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi K
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} K_1 \stackrel{\simeq}{\to} K_2
          %p
            For common choices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            there is a well-understood way to define the weak equivalences
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi mor
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} W \subset mor [C^{op}, sSet]
            %em
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            \. There is a well-developed but somewhat intricate theory of how exactly this 1-cagtegorical data models the full higher category of structured groupoids that we are after, but for our purposes we essentially only need to work inside the
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            of a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} on simplicial presheaves
          %ol
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"}> ∞-anafunctor
                  s
                – A morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
                between
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\to Y
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                of such ordinary morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi X
                                %mo{:stretchy => "false"} ^
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mo ≃
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\hat X &amp;\to&amp; Y
                      \\\
                      \\downarrow^{\mathrlap{\simeq}}
                      \\\
                      X
                      }
              %p
                where the left leg is a weak equivalence. This is sometimes called an
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-anafunctor
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                – For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                      %mover
                        %mo ←
                        %mi p
                      %mi C
                    %annotation{:encoding => "application/x-tex"} A \to B \stackrel{p}{\leftarrow} C
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
                of it is the ordinary
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                of a replacement diagram
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                        %mover
                          %mo ←
                          %mover
                            %mi p
                            %mo{:stretchy => "false"} ^
                        %mover
                          %mi C
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} A \to B \stackrel{\hat p}{\leftarrow} \hat C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi p
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat p
                is a
                %em good replacement
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                in the sense of the following factorization lemma.
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                – For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi C
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} p : C \to B
                a morphism in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                %em good replacement
