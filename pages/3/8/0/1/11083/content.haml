                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi ϵ
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0 \lt \epsilon \in \mathbb{R}
              and construct the
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
