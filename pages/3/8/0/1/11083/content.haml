                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in a way depending smoothly on the the
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %p
              One way of achieving this is using
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+theory"} Hodge theory
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              be the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              the projection on the space of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/harmonic+forms"} harmonic forms
              %a{:href => "http://ncatlab.org/nlab/show/Hodge+theory#ResultsOverRiemannianManifold"} central result of Hodge theory
              for
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              to itself, is a cochain map
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
              to the identity, via an explicit homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mo =
                    %msup
                      %mi d
                      %mo *
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P := d^* G
              expressed in terms of the adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mo *
                  %annotation{:encoding => "application/x-tex"} d^*
              of the de Rham differential and of the
              %a.existingWikiWord{:href => "/nlab/show/Green+operator"} Green operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is exact its projection on
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/harmonic+form"} harmonic form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
