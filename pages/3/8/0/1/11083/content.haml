                      %mi dR
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(T X) = (\Omega^\bullet(X), d_{dR})
                    \\,.
          #kPath.num_defn
            %h6#definition_18 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              for the standard
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
              and
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} with corners
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-path
              in the
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              is a morphism of
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %msup
                      %mi Δ
                      %mi k
                    %mo ⟶
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma \; \coloneqq \; T \Delta^k \longrightarrow \mathfrak{a}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} T \Delta^k
              of the standard smooth
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\Delta^k) \longleftarrow CE(\mathfrak{a}) \;\colon\; \Sigma^*
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              to the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \Delta^d
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+forms+on+simplices"} differential forms on simplices
          .num_remark
            %h6#remark_11 Remark
            %p
              A
              = succeed "-path" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              = succeed "," do
                %a.maruku-ref{:href => "#kPath"}
            %ol
              %li
                %p
                  a
                  %em flat
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                  %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebroid+valued+differential+form"} valued differential form
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Δ
                            %mi k
                        %annotation{:encoding => "application/x-tex"} \Delta^k
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+element"} Maurer-Cartan element
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^k)\otimes \mathfrak{a}
          %p
            The Lie integration of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            is essentially the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            whose
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            of the simplex:
          .num_defn
            %h6#definition_19 Definition
            %p
              Regard the smooth simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              as embedded into the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{k+1}
              in the standard way, and equip
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              with the
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              structure induced this way.
            %p
              A smooth
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              is said to have
              %strong sitting instants
              along the boundary if, for every
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo &lt;
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (r \lt k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              there is an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi F
                  %annotation{:encoding => "application/x-tex"} U_F
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is constant in the directions perpendicular to the
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              More generally, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              a smooth differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U \times\Delta^k
              is said to have sitting instants if there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi ϵ
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0 \lt \epsilon \in \mathbb{R}
              such that for all points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mo *
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} u : * \to U
              the pullback along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi{:mathvariant => "normal"} Id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi k
                    %mo →
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (u, \mathrm{Id}) : \Delta^k \to U \times \Delta^k
              is a form with sitting instants on
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} neighbourhood
            %p
              Smooth forms with sitting instants clearly form a sub-dg-algebra of all smooth forms. We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{si}(U \times \Delta^k)
              for this sub-dg-algebra.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega_{si,vert}^\bullet(U \times \Delta^k)
              for the further sub-dg-algebra of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical differential form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} p : U \times \Delta^k \to U
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo ⟶
                        %mn 0
                      %mover
                        %mo ⟶
                        %mrow
                          %msup
                            %mi p
                            %mo *
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U)
                    \\stackrel{\stackrel{p^*}{\longrightarrow}}{\underset{0}{\longrightarrow}}
                    \\Omega^\bullet_{si}(U \times \Delta^k)
                    \\to
                    \\Omega^\bullet_{si, vert}(U \times \Delta^k)
                    \\,.
          .num_remark
            %h6#remark_12 Remark
            %p
              The dimension of the normal direction to a face depends on the dimension of the face: there is one perpendicular direction to a codimension-1 face, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              perpendicular directions to a vertex.
          .num_example
            %h6#examples_2 Examples
            %ul
              %li
                %p
                  A smooth 0-form (a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Delta^1
                  if in a neighbourhood of the endpoints it is constant.
                %p
                  A smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi U
                        %mo ×
                        %msup
                          %mi Δ
                          %mn 1
                        %mo →
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} f : U \times \Delta^1 \to \mathbb{R}
                  is in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi{:mathvariant => "normal"} vert
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ×
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega^0_{\mathrm{vert}}(U \times \Delta^1)
                  if there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo &lt;
                        %mi ϵ
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} 0 \lt \epsilon \in \mathbb{R}
                  such that for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ∈
                        %mi U
                      %annotation{:encoding => "application/x-tex"} u \in U
                  the function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msup
                          %mi Δ
                          %mn 1
                        %mo ≃
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} f(u,-) : \Delta^1  \simeq [0,1] \to \mathbb{R}
                  is constant on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo −
                          %mi ϵ
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} [0,\epsilon) \coprod (1-\epsilon,1)
              %li
                %p
                  A smooth 1-form has sitting instants on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Delta^1
                  if in a neighbourhood of the endpoints it vanishes.
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ∈
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega \in \Omega^\bullet(X)
                  be a smooth differential form. Let
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi Δ
                          %mi k
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\phi \colon \Delta^k \to X
                %p
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  that has
                  %a.existingWikiWord{:href => "/nlab/show/sitting+instants"} sitting instants
                  as a function: towards any
                  = succeed "-face" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Delta^k
                  it eventually becomes perpendicularly constant.
                %p
                  Then the
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                  form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mo *
                        %mi ω
                        %mo ∈
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \phi^* \omega \in \Omega^\bullet(\Delta^k)
                  is a form with sitting instants.
          .num_remark
            %h6#remark_13 Remark
            %p
              The condition of sitting instants serves to make smooth differential forms not be affected by the boundaries and corners of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta^k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi j
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_j \in \Omega^\bullet(\Delta^{k-1})
              a collection of forms with sitting instants on the
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Lambda^k_i
              that coincide on adjacent boundaries, and for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi k
                    %mo →
                    %msubsup
                      %mi Λ
                      %mi i
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    p \colon \Delta^k \to \Lambda^{k-1}_i
            %p
              a standard piecewise smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullbacks
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi ω
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    p^* \omega_i
            %p
              glue to a single smooth differential form (with sitting instants) on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta^k
          .num_remark
            %h6#remark_14 Remark
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^\bullet(\Delta^k)
              having sitting instants does not imply that there is a neighbourhood of the boundary of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k
              on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is entirely constant. It is important for the following constructions that in the vicinity of the boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is allowed to vary parallel to the boundary, just not perpendicular to it.
          %h4#higher_lie_integration Higher Lie integration
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            is a process that assigns to a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            – or more generally to an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E-algebra"} ∞-Lie algebra
            or
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            – a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            – or more generally
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            – that is
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimally
            modeled by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
          %p
            Classically, Lie integration of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            is part of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie%27s+three+theorems"} Lie's three theorems
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            Lie group integrating a given finite-dimensional Lie algebra.
          %p
            One may observe that the
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            integrating a (finite-dimensional) Lie algebra is equivalently realized as the collection of
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued 1-forms
            on the interval where two such are identified if they are interpolated by a
            %em flat
            Lie-algebra valued 1-form on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disk"} disk
            = succeed "," do
              %a{:href => "Lie+integration#DuistermaatKolk00"} Duistermaat-Kolk 00, section 1.14
            = succeed ")." do
              %a{:href => "Lie+intgeration#LieAlgebrasToLieGroups"} below
          %p
            This
            %em path method
            of Lie integration stands out as having natural generalizations to
            %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
            (
            %a{:href => "Lie+integration#Severa01"}> Ševera 01
            ).
          %p
            In its evident generalization from
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+forms"} Lie algebra valued differential forms
            to
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+valued+differential+forms"} Lie algebroid valued differential forms
            this provides a means for Lie integration of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            (e.g.
            = succeed ")." do
              %a{:href => "Lie+integration#Crainic"} Crainic-Fernandes 01
          %p
            In another direction, one may observe that
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            are
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dually
            incarnated by their
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
            is essentially the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+construction"} Sullivan construction
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            = succeed "," do
              %a{:href => "Lie+integration#Hinich97"} Hinich 97
            = succeed ")." do
              %a{:href => "Lie+integration#Getzler04"} Getzler 04
            %a.existingWikiWord{:href => "/nlab/show/geometrically+discrete+%E2%88%9E-groupoid"} geometrically discrete
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            underlying what should be the Lie integration to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
            (
            %a{:href => "Lie+integration#Henriques"}> Henriques 08
            ,
            = succeed "," do
              %a{:href => "Lie+integration#Roytenberg09"} Roytenberg 09
            = succeed ")." do
              %a{:href => "Lie+integration#FSS12"} FSS 12
          %p
            Both these directions may be combined via the evident concept of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
            to yield a Lie integration of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroids"} ∞-Lie algebroids
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
          %p
            While the construction exists and behaves as expected in examples, there is to date no good general theory providing higher analogs of, say,
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie%27s+three+theorems"} Lie's three theorems
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            (for instance a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            or an
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E-algebra"} L-∞-algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            naturally form a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            varies:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi bare
                        %mtd
                          %mo ≔
                          %mrow
                            %mo (
                            %mi ⋯
                            %msub
                              %mi Hom
                              %mrow
                                %mn ∞
                                %mi LieAlgd
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi Δ
                              %mn 2
                            %mo ,
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                            %mover
                              %mover
                                %mo ⟶
                                %mo ⟶
                              %mo ⟶
                            %msub
                              %mi Hom
                              %mrow
                                %mn ∞
                                %mi LieAlgd
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ,
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo ⟶
                              %mo ⟶
                            %msub
                              %mi Hom
                              %mrow
                                %mn ∞
                                %mi LieAlgd
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi Δ
                              %mn 0
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %msub
                            %mi Hom
                            %mi dgAlg
                          %mo{:stretchy => "false"} (
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mover
                            %mover
                              %mo ⟶
                              %mo ⟶
                            %mo ⟶
                          %msub
                            %mi Hom
                            %mi dgAlg
                          %mo{:stretchy => "false"} (
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ⟶
                            %mo ⟶
                          %msub
                            %mi Hom
                            %mi dgAlg
                          %mo{:stretchy => "false"} (
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\exp(\mathfrak{a})_{bare}
                  \&amp; \coloneqq
                  \\left(
                  \\cdots
                  Hom_{\infty LieAlgd}(T \Delta^2, \mathfrak{a})
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  Hom_{\infty LieAlgd}(T \Delta^1, \mathfrak{a})
                  \\stackrel{\longrightarrow}{\longrightarrow}
                  Hom_{\infty LieAlgd}(T \Delta^0, \mathfrak{g})
                  \\right)
                  \\\
                  \&amp; =
                  (
                  \\cdots
                  Hom_{dgAlg}(CE(\mathfrak{a}), \Omega^\bullet(\Delta^2))
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  Hom_{dgAlg}(CE(\mathfrak{a}), \Omega^\bullet(\Delta^1))
                  \\stackrel{\longrightarrow}{\longrightarrow}
                  Hom_{dgAlg}(CE(\mathfrak{a}), \Omega^\bullet(\Delta^0))
                  )
                  \\end{aligned}
                  \\,.
          %p (We are indicating only the face maps, not the degeneracy maps, just for notational simplicity).
          %p
            If here instead of smooth differential forms one uses
            %a.existingWikiWord{:href => "/nlab/show/polynomial+differential+forms"} polynomial differential forms
            then this is precisely the
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+construction"} Sullivan construction
            of
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            applied to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
            on this and hence realize this as an object in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
          %p
            We now discuss Lie integration of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi CartSp
                    %mi smooth
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj,loc}
            over the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
          %p
            For the following definition recall the
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
            by the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            over the
