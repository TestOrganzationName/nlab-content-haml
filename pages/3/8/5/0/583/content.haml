                  \\,.
          %p
            The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi U
                  %mo ↦
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo{:stretchy => "false"} |
                            %mi if
                            %mi U
                            %mo ⊂
                            %mi V
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  hom(-,V) : U \mapsto
                  \\left\{
                  \\array{
                  {*} &amp; | if U \subset V
                  \\\
                  \\emptyset &amp; otherwise
                  }
                  \\right.
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in Op(X)
          .num_remark
            %h6#remark Remark
            %p
              In the
              %em
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(Op(X))= Func(Op(X)^{op},Set)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              are arbitrary
              %a.existingWikiWord{:href => "/nlab/show/sieves"} sieves
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              there is a sieve consisting of all open sets contained in either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∪
                      %mi V
                    %annotation{:encoding => "application/x-tex"} U\cup V
              %em sheaf
              topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(X)
              that the representables are precisely the subobjects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            itself:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L = Op(X)
                  \\,.
          %ul
            %li
              %p
                The logical operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AND
                    %annotation{:encoding => "application/x-tex"} AND
                is the
                %a.existingWikiWord{:href => "/nlab/show/product"} product
                in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Op
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Op(X)
                %strong intersection
                of open subsets.
            %li
              %p
                The logical operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi OR
                    %annotation{:encoding => "application/x-tex"} OR
                is the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Op
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Op(X)
                %strong union
                of open subsets.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi U
                        %mi c
                      %mo ∨
                      %mi V
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"}
                      hom(U,V) = (U^c \vee V)^\circ
              %p
                (the interior of the union of the complement of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                with V).
              %p
                So
                %strong negation
                is given by sending an open subset to the interior of its complement:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi U
                      %mo =
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi U
                        %mi c
                      %mo ∨
                      %mi ∅
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi U
                        %mi c
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\not U = hom(U,\emptyset)
                      \= (U^c \vee \emptyset)^\circ = (U^c)^\circ
                      \\,.
          %p
            In particular we find that in the internal logic of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(X)
            the law of the
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            fails in general, as in general we do not have that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mi U
                  %mo =
                  %mi true
                %annotation{:encoding => "application/x-tex"}
                  (\not U) \vee U = true
          %p
            because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi U
                  %mo ∨
                  %mi U
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi U
                    %mi c
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mo ∪
                  %mi U
                  %mo =
                  %mi X
                  %mo \
                  %mo ∂
                  %mi U
                %annotation{:encoding => "application/x-tex"} \not U \vee U = (U^c)^\circ \cup U = X \backslash \partial U
            is the total space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            without the boundary (frontier) of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi true
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} true = X
          %p
            Thus, the internal logic of this
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} sheaf topos
            is (in general)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/internal+logic+of+set+theory"} internal logic of set theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/type+theory"}> type theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relation+between+category+theory+and+type+theory"} relation between category theory and type theory
          %h2#references References
          %h3#general General
          %p Most books on topos theory develop some internal logic, at least in the context of a topos. For example:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"} Saunders Mac Lane
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
            %li
              %p
                Goldblatt,
                %em Topoi: the categorial analysis of logic
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Section 6 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                = succeed "," do
                  %em Categories of Sheaves
                %strong 50
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                , Part D of:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p is comprehensive.
          %p
            Phoa has a presentation of the internal logic of a topos over a dependent type theory, as opposed to other systems which use simple type theory. This is system is not minimal, but close to what is used in practice
            = succeed "." do
              %a{:href => "http://www.lfcs.inf.ed.ac.uk/reports/92/ECS-LFCS-92-208/ECS-LFCS-92-208.ps.gz"} PS
          %p The book
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"}> Bart Jacobs
              ,
              %em Categorical Logic and Type Theory
          %p
            works in the even more general context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an arbitrary poset instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sub
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sub(A)
          %p The book
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"}> Paul Taylor
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Practical+Foundations+of+Mathematics"} Practical Foundations of Mathematics
          %p
            is arguably all about this subject (although you wouldn't know it until about Chapter VIII), but from a different perspective. In particular, Taylor allows us to replace having
            %em all
            pullbacks with pullbacks along a pullback-stable class of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/display+morphisms"} display morphisms
          %p
            A discussion of
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            as the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+categories"} locally cartesian closed categories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/R.+A.+G.+Seely"}> R. A. G. Seely
              ,
              = succeed "," do
                %em Locally cartesian closed categories and type theory
              = succeed ")" do
                %a{:href => "http://www.math.mcgill.ca/rags/LCCC/LCCC.pdf"} pdf
          %p
            The observation that the poset of open subsets of a topological space serve as a model for
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            is apparently originally due to
          %ul
            %li#Tarski
              %a.existingWikiWord{:href => "/nlab/show/Alfred+Tarski"}> Alfred Tarski
              ,
              = succeed "," do
                %em Der Aussagenkalkül und die Topologie
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-categories"}
              locally cartesian closed
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            being
            %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+dependent+type+theory"} Martin-Löf dependent type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/El+Mehdi+Cherradi"}> El Mehdi Cherradi
              ,
              %em
                Internal languages of locally cartesian closed
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2509.03371"}> arXiv:2509.03371
              \&amp;rbrack;
          %h3#Applications Applications
          %p
            Discussion of fundamental constructions of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            from the perspective of the internal logic of the
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            over a
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            (
            %a.existingWikiWord{:href => "/nlab/show/Zariski+topos"}> Zariski topos
            ,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/etale+topos"} etale topos
          %ul
            %li#Blechschmidt15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ingo+Blechschmidt"}> Ingo Blechschmidt
                ,
                = succeed "," do
                  %em Using the internal language of toposes in algebraic geometry
                = succeed "," do
                  %a{:href => "https://indico.math.cnrs.fr/event/747/"} Toposes at IHES
                = succeed "," do
                  %a{:href => "https://github.com/iblech/internal-methods/blob/master/slides-ihes2015.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=7S8--bIKaWQ"} recording
            %li#Blechschmidt16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ingo+Blechschmidt"}> Ingo Blechschmidt
                ,
                = succeed "," do
                  %em Using the internal language of toposes in algebraic geometry
                = succeed ")" do
                  %a{:href => "http://rawgit.com/iblech/internal-methods/master/notes.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ingo+Blechschmidt"}> Ingo Blechschmidt
                ,
                %em Internal methods
                %a{:href => "https://github.com/iblech/internal-methods"} github repository
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            for
            %a.existingWikiWord{:href => "/nlab/show/comprehension+categories"} comprehension categories
            is developed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Niyousha+Najmaei"}> Niyousha Najmaei
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Niels+van+der+Weide"} Niels van der Weide
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Benedikt+Ahrens"} Benedikt Ahrens
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paige+Randall+North"} Paige Randall North
              %em A Type Theory for Comprehension Categories with Applications to Subtyping
              (
              %a{:href => "https://arxiv.org/abs/2503.10868"}> arXiv:2503.10868
              )
        .revisedby
          %p
