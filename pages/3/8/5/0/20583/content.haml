                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} (F, \phi) \colon \mathbf{A} \rightarrow \mathbf{B}
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Ob
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo →
                  %mi Ob
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} F \colon Ob\mathbf{A} \rightarrow Ob\mathbf{B}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
