            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams+modulo+4T+are+Jacobi+diagrams+modulo+STU"} chord diagrams modulo 4T are Jacobi diagrams modulo STU
            – the required
            %a.existingWikiWord{:href => "/nlab/show/STU-relations"} STU-relations
            translate into the structural equations satisfied by
            %a.existingWikiWord{:href => "/nlab/show/Lie+modules"} Lie modules
            (
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            and
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+action+property"} Lie action property
            = succeed "," do
              %a{:href => "#RobertsWillerton06"} Roberts &amp; Willerton 06, Theorem 3.1
            = succeed "," do
              %a{:href => "#Vaintrob94"} Vaintrob 94
            %a{:href => "#Vogel11"} Vogel 11
            following
            = succeed "," do
              %a{:href => "#BarNatan95"} Bar-Natan 95, 2.4
            %a{:href => "#BarNatan96"} Bar-Natan 96
            following
            = succeed "." do
              %a{:href => "#Kontsevich94"} Kontsevich 94
          %p
