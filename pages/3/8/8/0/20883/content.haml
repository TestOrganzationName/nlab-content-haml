                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\Big\langle
                  tr
                  \\big(
                  Z Z Z Z
                  \\big)
                  \\Big\rangle
                  \&amp;
                  \=
                  \\big\langle
                  Z_{i_1}
                  Z_{i_2}
                  Z_{i_3}
                  Z_{i_4}
                  \\big\rangle
                  \\cdot
                  tr
                  \\big(
                  \\rho^{i_1}
                  \\cdot
                  \\rho^{i_2}
                  \\cdot
                  \\rho^{i_3}
                  \\cdot
                  \\rho^{i_4}
                  \\big)
                  \\\
                  \&amp; =
                  \\phantom{+\;}
                  k_{i_1 i_2} \, k_{i_3 i_4}
                  \\cdot
                  tr
                  \\big(
