          %p
            which respect the
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
            and satisfy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mrow
                      %msub
                        %mi q
                        %mn 2
                  %mo ∘
                  %msup
                    %mi ψ
                    %mrow
                      %msub
                        %mi q
                        %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ψ
                    %mrow
                      %msub
                        %mi q
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi q
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\psi^{q_2} \circ \psi^{q_1}
                  \\;=\;
                  \\psi^{q_1 \cdot q_2}
          %p
            and as such are (dually) analogous to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
            on
            = succeed "." do
