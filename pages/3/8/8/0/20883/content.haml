                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mphantom
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mspace{:width => "thickmathspace"}
                          %msub
                            %mi k
                            %mrow
                              %msub
                                %mi i
                                %mn 1
                              %msub
                                %mi i
                                %mn 2
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi k
                            %mrow
                              %msub
                                %mi i
                                %mn 3
                              %msub
                                %mi i
                                %mn 4
                          %mo ⋅
                          %mi tr
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi ρ
                            %mrow
                              %msub
                                %mi i
                                %mn 1
                          %mo ⋅
                          %msup
                            %mi ρ
                            %mrow
                              %msub
