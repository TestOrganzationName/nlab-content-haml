            )
            %a.existingWikiWord{:href => "/nlab/show/chord+diagram"} chord diagram
            as a
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            in the evident way, and then labeling it by the structure morphisms of a
            %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebra"} metric
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+object"} Lie algebra object
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representation"} metric
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
            a suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
          %center
            %img{:src => "https://ncatlab.org/nlab/files/LieAlgebraWeightSystemAssignment.jpg", :width => "600"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p
