                    %annotation{:encoding => "application/x-tex"} K \in A Mod
            %p
              To that end, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo •
                  %annotation{:encoding => "application/x-tex"} I^\bullet
              be an
              %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
