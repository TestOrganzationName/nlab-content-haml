          .proof
            %h6#proof_7 Proof
            %p The desired natural homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
