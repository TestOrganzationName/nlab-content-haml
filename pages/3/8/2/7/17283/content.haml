                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (id,d) ( \Psi(x_i)  )
                    \&amp; =
                    (id,d) ( x_i \otimes 1 + 1 \otimes x_i )
                    \\\
                    \&amp; =
                    \\underset{= 0}{x_i  \otimes \underbrace{(d 1)} }
                    +
