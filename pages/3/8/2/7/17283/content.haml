          %h2#idea Idea
          %p
            A
            %em commutative Hopf algebroid
            is a
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebroid"} Hopf algebroid
            where all multiplication operations (as opposed to the
            %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
            operation) is required to be commutative. This concept is the
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            to
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoids"} internal groupoids
            in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
          %p
            A commutative Hopf algebroid is in particular a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hopf+algebroid+over+a+commutative+base"} Hopf algebroid over a commutative base
          %p
            Commutative Hopf algebroids appear prominently in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            as the
            %a.existingWikiWord{:href => "/nlab/show/dual+Steenrod+algebras"} dual Steenrod algebras
            of certain classes of
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology+theories"} generalized homology theories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
          %h2#definition Definition
          %h3#commutative_hopf_algebroids Commutative Hopf algebroids
          #CommutativeHopfAlgebroid.num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              is an
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              in the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi op
                  %annotation{:encoding => "application/x-tex"} {}^{op}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              structure.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, def. A1.1.1
          #CommutativeHopfAlgebroidSpelledOut.num_remark
            %h6#remark Remark
            %p
              We unwind def.
              = succeed "." do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∈
                      %mi CRing
                    %annotation{:encoding => "application/x-tex"} R \in CRing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(R)
              for same same object, but regarded as an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CRing
                        %mi op
                    %annotation{:encoding => "application/x-tex"} CRing^{op}
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CRing
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CRing^{op}
              is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CRing
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CRing^{op}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi Spec
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∘
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi s
                            %mo{:stretchy => "false"} ↓
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi i
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi t
                        %mtr
                          %mtd
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Spec(\Gamma) \underset{Spec(A)}{\times} Spec(\Gamma)
                    \\\
                    \\downarrow^{\mathrlap{\circ}}
                    \\\
                    Spec(\Gamma)
                    \\\
                    {}^{\mathllap{s}}\downarrow \; \uparrow^{\mathrlap{i}} \downarrow^{\mathrlap{t}}
                    \\\
                    Spec(A)
                    }
                    \\,,
            %p
              (where the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              at the top is over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              on the left and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              on the right) such that the pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
              defines an
              %a.existingWikiWord{:href => "/nlab/show/associativity+law"} associative
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(A)
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              if it is furthemore equipped with a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    inv \;\colon\; Spec(\Gamma) \longrightarrow Spec(\Gamma)
            %p
              acting as assigning
              %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                    %annotation{:encoding => "application/x-tex"} \circ
            %p
              The key basic fact to use now is that
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of commutative rings exhibits the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CRing
                        %mi op
                    %annotation{:encoding => "application/x-tex"} CRing^{op}
              = succeed ":" do
                %em
                  %a{:href => "CRing#CocartesianComnonoidalStructure"} CRing – Properties – Cocartesian comonoidal structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi R
                          %mn 3
                        %mo{:stretchy => "false"} )
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi R
                          %mn 3
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spec(R_1) \underset{Spec(R_3)}{\times} Spec(R_2)
                    \\simeq
                    Spec(R_1 \otimes_{R_3} R_2)
                    \\,.
            %p
              This means that the above is equivalently a diagram in
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                            %munder
                              %mo ⊗
                              %mi A
                            %mi Γ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi Ψ
                        %mtr
                          %mtd
                            %mi Γ
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi L
                            %mo{:stretchy => "false"} ↑
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϵ
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi R
                        %mtr
                          %mtd
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma \underset{A}{\otimes} \Gamma
                    \\\
                    \\uparrow^{\mathrlap{\Psi}}
                    \\\
                    \\Gamma
                    \\\
                    {}^{\mathllap{\eta_L}}\uparrow
                    \\downarrow^{\mathrlap{\epsilon}} \;
                    \\uparrow^{\mathrlap{\eta_R}}
                    \\\
                    A
                    }
            %p as well as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    c \; \colon \; \Gamma \longrightarrow \Gamma
            %p
              and satisfying
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
              conditions, spelled out as def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              below. Here
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi L
                        %mo ,
                        %msub
                          %mi η
                          %mi R
                      %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R
                  are called the left and right
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                      maps
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  is called the
                  = succeed ";" do
                    %em co-unit
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ψ
                      %annotation{:encoding => "application/x-tex"} \Psi
                  is called the
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/antipode"} antipode
                  or
                  %em conjugation
          #HopfAlgebrasAsHopfAlgebroids.num_remark
            %h6#remark_2 Remark
            %p
              Generally, in a commutative Hopf algebroid, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                    %mo ,
                    %msub
                      %mi η
                      %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R\colon A \to \Gamma
              from remark
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
              need not coincide, they make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              genuinely into a
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              that appears in remark
              = succeed "." do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %munder
                        %mo ⟶
                        %mi t
                      %mover
                        %mo ⟶
                        %mi s
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{\overset{s}{\longrightarrow}}{\underset{t}{\longrightarrow}}
              for which the
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              and
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              morphisms coincide,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"} s = t
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
            %p
              Dually, a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mover
                      %munder
                        %mo ⟵
                        %mrow
                          %msub
                            %mi η
                            %mi R
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi η
                            %mi L
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \stackrel{\overset{\eta_L}{\longleftarrow}}{\underset{\eta_R}{\longleftarrow}} A
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \eta_L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \eta_R
              happen to coincide is equivalently a
              %strong
                commutative
                %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            Writing out the formally dual axioms of an
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
            as in remark
            %a.maruku-ref{:href => "#CommutativeHopfAlgebroidSpelledOut"}
            yields the following equivalent but maybe more explicit definition of commutative Hopf algebroids, def.
            %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
          #CommutativeHopfAlgebroidDefinitionInExplicitComponents.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              is
            %ol
              %li
                %p
                  two
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  ring
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                %ol
                  %li
                    %p (left/right unit)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi η
                              %mi L
                            %mo ,
                            %msub
                              %mi η
                              %mi R
                            %mo{:lspace => "verythinmathspace"} :
                            %mi A
                            %mo ⟶
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \eta_L,\eta_R \colon A \longrightarrow \Gamma
                      ;
                  %li
                    %p (comultiplication)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi Ψ
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi Γ
                            %munder
                              %mo ⊗
                              %mi A
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Psi \colon \Gamma \longrightarrow \Gamma \underset{A}{\otimes} \Gamma
                      ;
                  %li
                    %p (counit)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi ϵ
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi A
                          %annotation{:encoding => "application/x-tex"} \epsilon \colon \Gamma \longrightarrow A
                      ;
                  %li
                    %p (conjugation)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Γ
                            %mo ⟶
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} c \colon \Gamma \longrightarrow \Gamma
            %p such that
            %ol
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                  )
                %ol
                  %li
                    %p (identity morphisms respect source and target)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi ϵ
                            %mo ∘
                            %msub
                              %mi η
                              %mi L
                            %mo =
                            %mi ϵ
                            %mo ∘
                            %msub
                              %mi η
                              %mi R
                            %mo =
                            %msub
                              %mi id
                              %mi A
                          %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta_L = \epsilon \circ \eta_R = id_A
                      ;
                  %li
                    %p (identity morphisms are units for composition)
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %msub
                              %mo ⊗
                              %mi A
                            %msub
                              %mi id
                              %mi Γ
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi Ψ
                            %mo =
                            %msub
                              %mi id
                              %mi Γ
                          %annotation{:encoding => "application/x-tex"} (id_\Gamma \otimes_A \epsilon) \circ \Psi  = (\epsilon \otimes_A id_\Gamma) \circ \Psi = id_\Gamma
                      ;
                  %li
                    %p (composition respects source and target)
                    %ol
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                            %semantics
                              %mrow
                                %mi Ψ
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi R
                                %mo =
                                %mo{:stretchy => "false"} (
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mi A
                                %msub
                                  %mi η
                                  %mi R
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi R
                              %annotation{:encoding => "application/x-tex"} \Psi \circ \eta_R = (id \otimes_A \eta_R) \circ \eta_R
                          ;
                      %li
                        %p
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi Ψ
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi L
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi η
                                  %mi L
                                %msub
                                  %mo ⊗
                                  %mi A
                                %mi id
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %msub
                                  %mi η
                                  %mi L
                              %annotation{:encoding => "application/x-tex"} \Psi \circ \eta_L = (\eta_L \otimes_A id) \circ \eta_L
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
                  )
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi id
                            %mi Γ
                          %msub
                            %mo ⊗
                            %mi A
                          %mi Ψ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi Ψ
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi Ψ
                          %msub
                            %mo ⊗
                            %mi A
                          %msub
                            %mi id
                            %mi Γ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi Ψ
                        %annotation{:encoding => "application/x-tex"} (id_\Gamma \otimes_A \Psi) \circ \Psi = (\Psi \otimes_A id_\Gamma) \circ \Psi
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/inverses"}> inverses
                  )
                %ol
                  %li
                    %p (inverting twice is the identity)
                    %p
