          #CategoryOfHopfComodulesIsAbelianIfHopfAlgebroidIsFlat.num_prop
            %h6#proposition_5 Proposition
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              is such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                    %mo ,
                    %msub
                      %mi η
                      %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R \colon A \longrightarrow \Gamma
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
            %ol
              %li
                %p
                  every co-free
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
                  = succeed "," do
                    %a.maruku-ref{:href => "#CoFreeComodules"}
                  %a.existingWikiWord{:href => "/nlab/show/injective+module"} injective module
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
