                        %msub
                          %mo □
                          %mi Γ
                        %msub
                          %mi N
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %msub
                          %mi N
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        A \Box_\Gamma N_2
                        \\;\simeq\;
                        Hom_\Gamma(A,N_2)
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, lemma A1.1.6
          .num_remark
            %h6#remark_3 Remark
            %p
              In computing the second page of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
              %a.maruku-ref{:href => "#ComoduleHomInTermsOfCotensorProduct"}
              is the key translation that makes the comodule
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed "-groups." do
                %a.existingWikiWord{:href => "/nlab/show/Cotor"} Cotor
              %a.existingWikiWord{:href => "/nlab/show/Lambda-algebra"} Lambda-algebra
              or via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/May+spectral+sequence"} May spectral sequence
          %h3#HomologicalAlgebraOfHopfComodules Homological algebra of comodules
          %p
            We discuss aspects of the
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            in
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of comodules over commutative Hopf algebroids, def.
            = succeed "." do
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
          #CategoryOfHopfComodulesIsAbelianIfHopfAlgebroidIsFlat.num_prop
            %h6#proposition_4 Proposition
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              is such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                    %mo ,
                    %msub
                      %mi η
                      %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R \colon A \longrightarrow \Gamma
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"} \Gamma CoMod
              of
              %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, theorem A1.1.3
          .proof
            %h6#proof_3 Proof
            %p
              It is clear that, without any condition the Hopf algebroid,
