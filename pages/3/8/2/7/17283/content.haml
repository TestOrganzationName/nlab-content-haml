                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi L
                    %mo ,
                    %msub
                      %mi η
                      %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta_L, \eta_R \colon A \longrightarrow \Gamma
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"} N \in \Gamma CoMod
              be a Hopf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              (a
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
