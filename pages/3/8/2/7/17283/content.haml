                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mover
                      %mo ⟶
                      %mi Ψ
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi N
                    %msub
                      %mo ⊗
                      %mi A
                    %mi Γ
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %msub
                          %mo ⊗
                          %mi A
                        %mi c
                    %mi N
                    %msub
                      %mo ⊗
                      %mi A
                    %mi Γ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\overset{\Psi}{\longrightarrow}
                    \\Gamma \otimes_A N
                    \\overset{\simeq}{\longrightarrow}
                    N \otimes_A \Gamma
                    \\overset{id \otimes_A c}{\longrightarrow}
                    N \otimes_A \Gamma
                    \\,,
            %p
              where the isomorphism in the middle the is
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Mod
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is the conjugation map of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              Dually, a right comodule
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              becoomes a left comodule with the coaction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mover
                      %mo ⟶
                      %mi Ψ
                    %mi N
                    %msub
                      %mo ⊗
                      %mi A
                    %mi Γ
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                    %mover
                      %mo ⟶
                      %mrow
                        %mi c
                        %msub
                          %mo ⊗
                          %mi A
                        %mi id
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\overset{\Psi}{\longrightarrow}
                    N \otimes_A \Gamma
                    \\overset{\simeq}{\longrightarrow}
                    \\Gamma \otimes_A N
                    \\overset{c \otimes_A id}{\longrightarrow}
                    \\Gamma \otimes_A N
                    \\,.
          #CotensorProductOfComodules.num_defn
            %h6#definition_6 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              a right
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              a left comodule (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo □
                      %mi Γ
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1 \Box_\Gamma N_2
              is the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the difference of the two coaction morphisms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo □
                      %mi Γ
                    %msub
                      %mi N
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ker
                    %mrow
                      %mo (
                      %msub
                        %mi N
                        %mn 1
                      %msub
                        %mo ⊗
                        %mi A
                      %msub
                        %mi N
                        %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Ψ
                            %mrow
                              %msub
                                %mi N
                                %mn 1
                          %msub
                            %mo ⊗
                            %mi A
                          %mi id
                          %mo −
                          %mi id
                          %msub
                            %mo ⊗
                            %mi A
                          %msub
                            %mi Ψ
                            %mrow
                              %msub
                                %mi N
                                %mn 2
                      %msub
                        %mi N
                        %mn 1
                      %msub
                        %mo ⊗
                        %mi A
                      %mi Γ
                      %msub
                        %mo ⊗
                        %mi A
                      %msub
                        %mi N
                        %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_1 \Box_\Gamma N_2
                    \\;\coloneqq\;
                    ker
                    \\left(
                    N_1 \otimes_A N_2
                    \\overset{\Psi_{N_1}\otimes_{A} id - id \otimes_A \Psi_{N_2} }{\longrightarrow}
                    N_1 \otimes_A \Gamma \otimes_A N_2
                    \\right)
                    \\,.
            %p
              If both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              are left comodules, then their cotensor product is the cotensor product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              regarded as a right comodule via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LeftComodulesToRightComodules"}
          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, def. A1.1.4
            ).
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1, N_2
              two left
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CotensorProductOfComodules"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo □
                    %msub
                      %mi N
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mn 2
                    %mo □
                    %msub
                      %mi N
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_1 \Box N_2 \;\simeq\; N_2 \Box N_1
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, prop. A1.1.5
          #ComoduleHomInTermsOfCotensorProduct.num_lemma
            %h6#lemma Lemma
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1, N_2
              two left
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              is
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective
              as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
            %ol
              %li
                %p The morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mi f
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi id
                            %msub
                              %mo ⊗
                              %mi A
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi Ψ
                              %mrow
                                %msub
                                  %mi N
                                  %mn 1
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi A
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"}
                        Hom_A(N_1, A)
                        \\overset{f \mapsto (id \otimes_A f) \circ \Psi_{N_1}}{\longrightarrow}
                        Hom_A(N_1, \Gamma \otimes_A A)
                        \\simeq
                        Hom_A(N_1, \Gamma)
                        \\simeq
                        Hom_A(N_1, A) \otimes_A \Gamma
                %p
                  gives
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_A(N_1,A)
                  the structure of a right
                  = succeed "-comodule;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CotensorProductOfComodules"}
                  = succeed "-comodules:" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo □
                          %mi Γ
                        %msub
                          %mi N
                          %mn 2
                        %mo ≃
