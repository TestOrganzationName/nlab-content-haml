            %p
              Then (assuming the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              = succeed "," do
                %a.maruku-ref{:href => "#CoFreeComodules"}
              = succeed "-" do
