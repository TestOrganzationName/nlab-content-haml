          #FlatnessOfEImpliesKeyConsequence.num_prop
            %h6#proposition_7 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
