          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, def. A1.1.1
            )
          %h3#comodules Comodules
          #HopfComoduleRing.num_defn
            %h6#definition_4 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CRing
                        %mi op
                    %annotation{:encoding => "application/x-tex"} CRing^{op}
              %strong comodule ring
              over it is an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CRing
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CRing^{op}
              of that internal groupoid.
          %p
            In the same spirit, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
            over a commutative Hopf algebroid (not necessarily a comodule ring) is a
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
            on the corresponding
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
            (regarded as a (
            %a.existingWikiWord{:href => "/nlab/show/algebraic+stack"}> algebraic
            )
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            = succeed ")." do
              %a{:href => "#Hopkins99"} Hopkins 99, prop. 11.6
          #CommutativeHopfAlgebroidComodule.num_defn
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %strong
                left
                %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is
            %ol
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  (co-action)
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Ψ
                          %mi N
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mo ⟶
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi N
                      %annotation{:encoding => "application/x-tex"} \Psi_N \;\colon\; N \longrightarrow \Gamma \otimes_A N
                  ;
            %p such that
            %ol
              %li
                %p
                  (co-
                  %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                  )
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi id
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                        %mo =
                        %msub
                          %mi id
                          %mi N
                      %annotation{:encoding => "application/x-tex"} (\epsilon \otimes_A id_N) \circ \Psi_N = id_N
                  ;
              %li
                %p (co-action property)
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ψ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi id
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %msub
                          %mi Ψ
                          %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi Ψ
                          %mi N
                      %annotation{:encoding => "application/x-tex"} (\Psi \otimes_A id_N) \circ \Psi_N = (id_\Gamma \otimes_A \Psi_N)\circ \Psi_N
                  \.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between comodules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1 \to N_2
              is a homomorphism of underlying
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              with the co-action morphism. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma CoMod
            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of (left) comodules over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
          #ComoduleStructureOnGroundRing.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              becomes a left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi R
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mspace{:width => "thinmathspace"}
