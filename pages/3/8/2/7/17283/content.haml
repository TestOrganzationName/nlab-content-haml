                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext_\Gamma(A,A) \simeq A[\{x_i\}_{i \in I}]
                    \\,.
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.1.9
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 3.7.5
          .proof
            %h6#proof_6 Proof
            %p
              Consider the co-free left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a{:href => "commutative+Hopf+algebroid#CoFreeComodules"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
