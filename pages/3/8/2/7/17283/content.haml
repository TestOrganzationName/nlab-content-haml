              is flat over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              it is an
              %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \Gamma \otimes_A K
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi CoMod
                    %annotation{:encoding => "application/x-tex"} \Gamma CoMod
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi R
                              %mrow
                                %mo •
                                %mo ≥
                                %mn 1
                            %msub
                              %mi Hom
                              %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo ,
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi K
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mrow
                                %mo •
                                %mo ≥
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo ,
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %msup
                              %mi I
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mrow
                                %mo •
                                %mo ≥
                                %mn 1
                            %mo{:stretchy => "false"} (
