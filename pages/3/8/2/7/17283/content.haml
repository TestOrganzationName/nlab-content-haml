                %em
                  %a{:href => "Adams+spectral+sequence#TheE2TermOfTheEAdamsSpectralSequence"} Adams spectral sequence – The second page
          %h3#extgroups Ext-groups
          #CoModuleExtFromAToAForPrimitivelyGeneratedExteriorAlgebra.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              graded commutative Hopf algebra such that
            %ol
              %li
                %p the underlying algebra is free graded commutative;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \eta \colon A \to \Gamma
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  is generated by
                  %a.existingWikiWord{:href => "/nlab/show/primitive+elements"} primitive elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi x
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{x_i\}_{i\in I}
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              of
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and itself is the (graded) polynomial algbra on these generators:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
