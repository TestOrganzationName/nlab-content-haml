                    \\\
                    \&amp; \simeq H_{\bullet \geq 1}( Hom_A(N, I^\bullet) )
                    \\\
                    \&amp; \simeq 0
                    \\end{aligned}
                    \\,.
            %p
              Here the second equivalence is the cofree/forgetful adjunction isomorphism of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CoFreeComodules"}
              = succeed "-module" do
