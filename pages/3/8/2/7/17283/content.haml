            %h6#proof_4 Proof
            %p
              First of all, assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Mod
              has
              %a.existingWikiWord{:href => "/nlab/show/enough+injectives"} enough injectives
              (see
              = succeed ")." do
                %a{:href => "injective+object#AbHasEnoughInjectives"} this proposition
              %a.maruku-ref{:href => "#CoFreeComodules"}
              we have the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi forget
                      %mover
                        %mo ⟵
                        %mrow
                          %mi co
                          %mo −
                          %mi free
                    %mi A
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma CoMod
                    \\underoverset
                    {\underset{forget}{\longrightarrow}}
                    {\overset{co-free}{\longleftarrow}}
                    {\bot}
                    A Mod
                    \\,.
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              is a
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              (being a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfHopfComodulesIsAbelianIfHopfAlgebroidIsFlat"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
              = succeed ")" do
                %a{:href => "injective+object#TransferOfEnoughInjectivesAlongAdjunctions"} here
            %ol
              %li
                %p
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo ∈
                        %mi A
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} I \in A Mod
                  an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/injective+module"} injective module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi I
                      %annotation{:encoding => "application/x-tex"} \Gamma \otimes_A I
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mi CoMod
                        %annotation{:encoding => "application/x-tex"} \Gamma CoMod
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ∈
                        %mi Γ
                        %mi CoMod
                      %annotation{:encoding => "application/x-tex"} N \in \Gamma CoMod
                  any object, and for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \colon U(N) \hookrightarrow I
                  a monomorphism of
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  = succeed "-module," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi i
                          %mo{:stretchy => "false"} ˜
                        %mo{:lspace => "verythinmathspace"} :
                        %mi N
                        %mo ↪
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi I
                      %annotation{:encoding => "application/x-tex"} \tilde i \colon N \hookrightarrow \Gamma\otimes_A I
                  is a monomorphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mi CoMod
                      %annotation{:encoding => "application/x-tex"} \Gamma CoMod
                  (and into an injective comodule).
          #CoFreeHopfComodulesAreHomNAcyclicForProjectiveN.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              be a
