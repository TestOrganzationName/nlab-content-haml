                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  A \to \hat G \to G \to \mathbf{B}A \to \mathbf{B}\hat G \to \mathbf{B}G \stackrel{c}{\to}
                  \\mathbf{B}^2 A
          %p
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\hat G
            as the bundle gerbe over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            (in
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            of the point, if you wish) with Dixmier-Douady class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %h3#tautological_bundle_gerbe Tautological bundle gerbe
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi cl
                      %mo ,
                      %mi int
                %annotation{:encoding => "application/x-tex"} H \in \Omega^3(X)_{cl, int}
            a degree 3
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            with integral periods.
          %p
            We may think of this a cocycle in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+cohomology"} ∞-Lie algebroid cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %msup
                    %mi b
                    %mn 2
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H : T X \to b^2 \mathbb{R}
                  \\,.
          %p
            By a slight variant of
            %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#IntegrationOfCocycles"} Lie integration of oo-Lie algebroid cocycles
            we obtain from this a bundle gerbe on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by the following construction
          %ul
            %li
              %p
                pick any point
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 0
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x_0 \in X
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %msub
                        %mi P
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Y = P_* X
                be the based smooth
                %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo →
                      %mi Y
                      %msub
                        %mo ×
                        %mi X
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} L \to Y \times_X Y
                be the
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi γ
                        %mn 1
                      %mo ,
                      %msub
                        %mi γ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\gamma_1,\gamma_2)
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %msub
                        %mo ×
                        %mi X
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y \times_X Y
                – which is a
                %em loop
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                assigns the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                whose elements are equivalence class of pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Sigma,c)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a surface cobounding the loop and where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c \in U(1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %msup
                        %mi D
                        %mn 3
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi : D^3 \to X
                cobounding two such surfaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \Sigma_2
                we have that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma_1,c_1)
                is equivalent to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mn 2
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma_2, c_2)
                the difference of the labels differs by the
                %a.existingWikiWord{:href => "/nlab/show/integral"} integral
                of the 3-form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                      %msubsup
                        %mi c
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi D
                            %mn 3
                      %msup
                        %mi ϕ
                        %mo *
                      %mi H
                      %mo ∈
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      c_2 c_1^{-1} = \int_{D^3} \phi^* H \in \mathbb{R}/\mathbb{Z}
                      \\,.
            %li
              %p
                the composition operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 12
                        %mo *
                      %mi L
                      %mo ⊗
                      %msubsup
                        %mi π
                        %mn 23
                        %mo *
                      %mi L
                      %mo →
                      %msubsup
                        %mi π
                        %mn 13
                        %mo *
                      %mi L
                    %annotation{:encoding => "application/x-tex"} \pi_{12}^* L \otimes \pi_{23}^* L \to \pi_{13}^* L
                is loop-wise the evident operation that on loops removes from a figure-8 the inner bit and whch is group multiplication of the labels.
          %p
            This produces a bundle gerbe whose class in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X,\mathbb{Z})
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi H
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [H]
            as its image in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/centrally+extended+groupoid"} centrally extended groupoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/line+2-bundle"}> line 2-bundle
                ,
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+line+2-bundle"} holomorphic line 2-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+bundle+gerbes"} transgression of bundle gerbes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle+gerbe"} connection on a bundle gerbe
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/discrete+torsion"} discrete torsion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fusion+bundle"} fusion bundle
          %p and
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
                \/
                %strong bundle gerbe
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+3-bundle"} principal 3-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
          %p especially
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"}> circle n-bundle with connection
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            For applications in
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            see also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/B-field"}> B-field
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
          %h2#references References
          %p
            The notion of
            %em bundle gerbe
            as such was introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
              ,
              = succeed "," do
                %em Bundle gerbes
              %strong 54
              (1996) pp. 403-416 (
              %a{:href => "http://arxiv.org/abs/dg-ga/9407015"}> arXiv:dg-ga/9407015
              )
          %p Early texts also include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Chatterjee"}> David Chatterjee
              ,
              = succeed "," do
                %em On Gerbs
              = succeed ")" do
                %a{:href => "https://people.maths.ox.ac.uk/hitchin/files/StudentsTheses/chatterjee.pdf"} pdf
          %p (notice that the title here suppresses one “e” intentionally);
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              = succeed "," do
                %em Bundle gerbes: stable isomorphism and local theory
              %strong 62
              (2000) 925-937 arXiv:
              %a{:href => "https://arxiv.org/abs/math/9908135"} math/9908135
          %p
            A general picture of bundle
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle (n+1)-bundles with connection
            classified by
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pawel+Gajer"}> Pawel Gajer
              ,
              = succeed "," do
                %em Geometry of Deligne cohomology
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/alg-geom/9601025"} arXiv:alg-geom/9601025
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/s002220050118"} doi:10.1007/s002220050118
          %p Reviews are in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"}> Nigel Hitchin
                ,
                = succeed "," do
                  %em What is… a gerbe?
                %strong 50
                no. 2 (2003) pp 218-219
                %a{:href => "http://www.ams.org/notices/200302/what-is.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
                ,
                = succeed "," do
                  %em An Introduction to Bundle Gerbes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Salamon"} Simon Salamon
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1093/acprof:oso/9780199534920.001.0001"} 10.1093/acprof:oso/9780199534920.001.0001
                %a{:href => "https://arxiv.org/abs/0712.1651"} 0712.1651
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Severin+Bunk"}> Severin Bunk
                ,
                = succeed "," do
                  %em Gerbes in geometry, field Theory, and quantisation
                %strong 8
                1 (2021) 150-182 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2102.10406"}> arXiv:2102.10406
                \&amp;rbrack;
          %p
            With emphasis on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/surface+holonomy"} surface holonomy
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"}> Jürgen Fuchs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"} Konrad Waldorf
              %em Bundle Gerbes and Surface Holonomy
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0901.2085"}> arXiv:0901.2085
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://inspirehep.net/literature/1511182"} spire:1511182
          %p
            Bundle gerbes over
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            (cf. the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/basic+bundle+gerbe"} basic bundle gerbe
          %ul
            %li#Brylinski00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
                ,
                %em Gerbes on complex reductive Lie groups
                (
                %a{:href => "https://arxiv.org/abs/math/0002158"}> arXiv:math/0002158
                )
            %li#Meinrenken02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
                ,
                = succeed "," do
                  %em The basic gerbe over a compact simple Lie group
                %strong 49
                3-4 (2003) 307–333 (
                %a{:href => "https://arxiv.org/abs/math/0209194"}> arXiv:math/0209194
                ,
                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.5169/seals-66691"} doi:10.5169/seals-66691
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"}> Christoph Schweigert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"} Konrad Waldorf
                = succeed "," do
                  %em Gerbes and Lie Groups
                = succeed "," do
                  %em Developments and Trends in Infinite-Dimensional Lie Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/0710.5467"} arXiv:0710.5467
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-0-8176-4741-4_10"} doi:10.1007/978-0-8176-4741-4_10
            %li#Krepski17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Derek+Krepski"}> Derek Krepski
                ,
                = succeed "," do
                  %em Basic equivariant gerbes on non-simply connected compact simple Lie groups
                %strong 133
                (2018) 30-41 (
                %a{:href => "https://arxiv.org/abs/1712.08294"}> arXiv:1712.08294
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.geomphys.2018.06.016"} doi:10.1016/j.geomphys.2018.06.016
          %p#ReferencesEquivariant
            On
            = succeed ":" do
              %span.newWikiWord
                equivariant bundle gerbes
                %a{:href => "/nlab/new/equivariant+infinity-bundle"} ?
          %p with a restrictive notion of equivariance (“strong” equivariance):
          %ul
            %li
              %p
                %a{:href => "#Brylinski00"} Brylinski 2000, from p. 28
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
                = succeed "," do
                  %em Chern character in twisted K-theory: equivariant and holomorphic cases
                %strong 236
                161-186, 2003 (
                %a{:href => "https://arxiv.org/abs/hep-th/0201010"}> arXiv:hep-th/0201010
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-003-0807-7"} doi:10.1007/s00220-003-0807-7
            %li
              %p
                %a{:href => "#Meinrenken02"} Meinrenken 2002, Sec. 2.4
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiyonori+Gomi"}> Kiyonori Gomi
                ,
                %em Reduction of strongly equivariant bundle gerbes with connection and curving
                (
                %a{:href => "https://arxiv.org/abs/math/0406144"}> arXiv:math/0406144
                )
          %p with a general notion of higher equivariance:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiyonori+Gomi"}> Kiyonori Gomi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yuji+Terashima"} Yuji Terashima
                = succeed "," do
                  %em Discrete Torsion Phases as Topological Actions
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-009-0736-1"} doi:10.1007/s00220-009-0736-1
              %blockquote
                %p
