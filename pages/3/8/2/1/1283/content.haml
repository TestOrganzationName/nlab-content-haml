                                  %mi p
                          %mtr
                            %mtd
                              %mi Y
                              %msub
                                %mo ×
                                %mi X
                              %mi Y
                            %mtd
                              %mover
                                %munder
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi π
                                      %mn 2
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi π
                                      %mn 1
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi π
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      L
                      \\\
                      \\downarrow^{\mathrlap{p}}
                      \\\
                      Y \times_X Y &amp;\stackrel{\overset{\pi_1}{\rightarrow}}{\underset{\pi_2}{\rightarrow}}&amp; Y
                      \\\
                      \&amp;&amp; \downarrow^{\mathrlap{\pi}}
                      \\\
                      \&amp;&amp;
                      X
                      }
                      \\,,
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
