                      %msubsup
                        %mi π
                        %mn 12
                        %mo *
                      %mi L
                      %mo ⊗
                      %msubsup
                        %mi π
                        %mn 23
                        %mo *
                      %mi L
                      %mo →
                      %msubsup
                        %mi π
                        %mn 13
                        %mo *
                      %mi L
                    %annotation{:encoding => "application/x-tex"}
                      \\mu :
                      \\pi_{12}^*L \otimes
                      \\pi_{23}^*L
                      \\to
                      \\pi_{13}^* L
              %p
                of
                = succeed "-bundles" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %msub
                        %mo ×
                        %mi X
                      %mi Y
                      %msub
                        %mo ×
                        %mi X
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y \times_X Y \times_X Y
            %li
              %p
                such that this satisfies the evident associativity condition on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %msub
                          %mo ×
                          %mi X
                        %mi Y
                        %msub
                          %mo ×
                          %mi X
                        %mi Y
                        %msub
                          %mo ×
                          %mi X
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y\times_X Y \times_X Y \times_X Y
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 12
                  %mo ,
                  %msub
                    %mi π
                    %mn 23
                  %mo ,
                  %msub
                    %mi π
                    %mn 13
                %annotation{:encoding => "application/x-tex"} \pi_{12}, \pi_{23}, \pi_{13}
            are the three maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 3
                      %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mover
                      %mo →
                      %mo →
                  %msup
                    %mi Y
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Y^{[3]} \stackrel{\stackrel{\rightarrow}{\rightarrow}}{\rightarrow}
                  Y^{[2]}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+gerbe"} nonabelian bundle gerbe
            the bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is generalized to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
          %h2#Interpretation Interpretation
          %p
            A bundle gerbe may be understood as a specific model for the total space
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          %p We first describe this Lie groupoid in
          %ul
            %li
              %a{:href => "#AsGroupoidExtension"} As a groupoid extension
          %p and then describe how this is the total space of a principal 2-bundle in
          %ul
            %li
              %a{:href => "#AsTotalSpace"}> As the total space of a 2-bundle
              \.
          %h3#AsGroupoidExtension As a groupoid extension
          %p
            Give a surjective submersion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi : Y \to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mrow
                    %mo (
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mover
                      %mo →
                      %mo →
                    %mi Y
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  C(Y) := \left(
                  Y \times_X Y \stackrel{\to}{\to} Y
                  \\right)
          %p
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself, in that the canonical projection is a weak equivalence (see
            %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+groupoid"} infinity-Lie groupoid
            for details)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C(Y)
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
                  \\,.
          %p
            The data of a bundle gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi L
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,L,\mu)
            induces a
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi L
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_{(Y,L,\mu)}
            which is a
            = succeed "-extension" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(Y)
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi P
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi L
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}U(1) \to P_{(Y,L,\mu)} \to X
                  \\,.
          %p
            This Lie groupoid is the groupoid whose space of morphisms is the total space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            of the
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi L
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mi L
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                          %mo ∘
                          %mi p
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo ∘
                          %mi p
                    %mi Y
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  P_{(Y,L,\mu)} =
                  \\left(
                  L \stackrel{\overset{\pi_1 \circ p}{\to}}{\underset{\pi_2 \circ p}{\to}} Y
                  \\right)
          %p with composition given by the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %msub
                    %mo ×
                    %mrow
                      %mi s
                      %mo ,
                      %mi t
                  %mi L
                  %mover
                    %mo →
                    %mo ≃
                  %msubsup
                    %mi π
                    %mn 12
                    %mo *
                  %mi L
                  %mo ×
                  %msubsup
                    %mi π
                    %mn 23
                    %mn 3
                  %mo *
                  %mi L
                  %mover
                    %mo →
                    %mrow
                  %msubsup
                    %mi π
                    %mn 12
                    %mo *
                  %mi L
                  %mo ⊗
                  %msubsup
                    %mi π
                    %mn 23
                    %mn 3
                  %mo *
                  %mi L
                  %mover
                    %mo →
                    %mi μ
                  %msubsup
                    %mi π
                    %mn 13
                    %mo *
                  %mi L
                  %mo →
                  %mi L
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L \times_{s,t} L
                  \\stackrel{\simeq}{\to}
                  \\pi_{12}^* L \times \pi_{23}^3* L
                  \\stackrel{}{\to}
                  \\pi_{12}^* L \otimes \pi_{23}^3* L
                  \\stackrel{\mu}{\to}
                  \\pi_{13}^* L
                  \\to
                  L
                  \\,.
          %h3#AsTotalSpace As the total space of a principal 2-bundle
          %p
            We discuss how a bundle gerbe, regarded as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"} principal infinity-bundle
            that the total
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            2-bundle space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            classified by a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B} G
            is simply the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of that cocycle. This we compute now.
          %p
            (For more along these lines see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory+introduction"} infinity-Chern-Weil theory introduction
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+gerbe"} nonabelian bundle gerbe
          .num_prop
            %h6#proposition Proposition
            %p
              The Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi L
                        %mo ,
                        %mi μ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_{(Y,L,\mu)}
              defined by a bundle gerbe is in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
              the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi P
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi L
                                %mo ,
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P_{(Y,L,\mu)} &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                    \\\
                    X &amp;\stackrel{g}{\to}&amp; \mathbf{B}^2 U(1)
                    }
            %p
              of a
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 2
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi H
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [g] \in H(X,\mathbf{B}^2 U(1)) \simeq H^3(X,\mathbb{Z})
          %p In fact a somewhat stronger statement is true, as shown in the following proof.
          .proof
            %h6#proof Proof
            %p
              We can assume without restriction that the bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              in the data of the bundle gerbe is actually the trivial
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L = Y \times_X Y \times U(1)
              by refining, if necessary, the surjective submersion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              by a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              with a
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu : Y \times_X Y \times_X Y  \to U(1)
            %p
              which in turn we may identify with a smooth 2-
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi μ
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(U) &amp;\stackrel{\mu}{\to}&amp; \mathbf{B}^2 U(1)
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    X
                    }
                    \\,.
            %p
              From here on the computation is a special case of the general theory of
              %a.existingWikiWord{:href => "/nlab/show/groupoid+cohomology"} groupoid cohomology
              and the extensions classified by it.
            %p
              Then recall from
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundle"} universal principal infinity-bundle
              that we model the
              = succeed "-pullbacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-principal" do
