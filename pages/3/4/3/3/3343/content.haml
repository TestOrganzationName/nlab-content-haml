          %title Selected writings
          %p
            %strong Branislav Jurčo
            is a Czech
            %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physicist
            (
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            theory,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+groups"} quantum groups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integrable+systems"} integrable systems
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cocycle"} nonabelian cocycle
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Batalin-Vilkovisky+formalism"} Batalin-Vilkovisky formalism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gerbes"} gerbes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theories
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            = succeed "s)," do
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
          %ul
            %li
              %p
                %a{:href => "https://www.mff.cuni.cz/en/faculty/organizational-structure/people?hdl=5368"} institute page
            %li
              %p
                %a{:href => "https://scholar.google.de/citations?user=05IMCCwAAAAJ&hl=de"} GoogleScholar page
            %li
              %p
                %a{:href => "https://inspirehep.net/authors/2280915"} InSpire page
            %li
              %p
                %a{:href => "https://www.mathgenealogy.org/id.php?id=193829"} MathGenealogy page
          %h2#selected_writings Selected writings
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+optics"} quantum optics
          %ul
            %li
              Jan Peřina, Zdeněk Hradil, Branislav Jurčo,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quantum+optics+and+fundamentals+of+physics"} Quantum optics and fundamentals of physics
          %p
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integrable+systems"} integrable systems
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"}> Branislav Jurčo
              ,
              = succeed "," do
                %em On quantum integrable models related to nonlinear quantum optics. An algebraic Bethe ansatz approach
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1063/1.528262"} doi:10.1063/1.528262
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Yang-Baxter+equation"} Yang-Baxter equation
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integrable+systems"} integrable systems
          %ul
            %li
              Branislav Jurčo,
              = succeed "," do
                %em
                  Classical Yang-Baxter equations and quantum integrable systems (
                  %a.existingWikiWord{:href => "/nlab/show/Gaudin+models"}> Gaudin models
                  )
              %strong 370
              (1990)
              %a{:href => "http://dx.doi.org/10.1007/3-540-53503-9"} doi
          %p
            A model for the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+2-gerbe"} nonabelian
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbes"} bundle 2-gerbes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Aschieri"}> Paolo Aschieri
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"} Branislav Jurčo
              = succeed "," do
                %em
                  Gerbes, M5-Brane Anomalies and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 8
                      %annotation{:encoding => "application/x-tex"} E_8
                  Gauge Theory
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/hep-th/0409200"} arXiv:hep-th/0409200
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1088/1126-6708/2004/10/068"} doi:10.1088/1126-6708/2004/10/068
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
            (
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"}> principal bundles
            ,
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            applications to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dale+Husem%C3%B6ller"}> Dale Husemöller
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Joachim"} Michael Joachim
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"} Branislav Jurčo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Schottenloher"} Martin Schottenloher
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Basic+Bundle+Theory+and+K-Cohomology+Invariants"} Basic Bundle Theory and K-Cohomology Invariants
              = succeed "," do
                %strong 726
              = succeed "," do
                %a{:href => "http://www.mathematik.uni-muenchen.de/~schotten/Texte/978-3-540-74955-4_Book_LNP726.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/10.1007/978-3-540-74956-1"} doi:10.1007/978-3-540-74956-1
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bakovi%C4%87"}> Igor Baković
              , Branislav Jurčo,
              = succeed "," do
                %em The classifying topos of a topological bicategory
              %a{:href => "http://www.intlpress.com/HHA/v12/n1/a14"} published files
              %a{:href => "https://arxiv.org/abs/0902.1750"} arxiv/0902.1750
              %a{:href => "http://golem.ph.utexas.edu/category/2009/02/bakovi_and_juro_on_classifying.html"} cafe
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+2-gerbes"} nonabelian bundle 2-gerbes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"}> Branislav Jurčo
              ,
              = succeed "," do
                %em Nonabelian bundle 2-gerbes
              %strong 08
              01 (2011) 49-78 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/0911.1552"}> arXiv:0911.1552
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/S0219887811004963"} doi:10.1142/S0219887811004963
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
          %ul
            %li
              Branislav Jurčo, Korbinian Muenster,
              = succeed "," do
                %em Type II superstring field theory: geometric approach and operadic description
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1303.2323"} arXiv/1303.2323
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1007/JHEP04(2013)126"} doi
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
            in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebras
          %ul
            %li#DoubekJurcoMuenster13
              %a.existingWikiWord{:href => "/nlab/show/Martin+Doubek"}> Martin Doubek
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"} Branislav Jurčo
              = succeed "," do
                %em Modular operads and the quantum open-closed homotopy algebra
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1308.3223"} arXiv:1308.3223
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/JHEP12(2015)158"} doi:10.1007/JHEP12(2015)158
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"} Riemannian geometry
            on
            %a.existingWikiWord{:href => "/nlab/show/Courant+algebroids"} Courant algebroids
            and relation to
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"}> Branislav Jurčo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jan+Vysoky"} Jan Vysoky
              = succeed "," do
