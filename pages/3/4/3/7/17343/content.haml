                                    %mi X
                                    %mrow
                                      %msub
                                        %mi δ
                                        %mn 0
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %msup
                              %mi Y
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
