          %p
            The following says that for computing the hom-sets in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
          #HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory.num_lemma
            %h6#lemma_12 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              fibrant, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P, Q
              fibrant/cofibrant replacement functors as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
