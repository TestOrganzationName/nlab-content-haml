            %p
          %p
            (
            %a{:href => "#Quillen67"}> Quillen 67, I.4 theorem 3
            )
          .proof
            %h6#proof_26 Proof
            %p
              By def.
              %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
              and lemma
              %a.maruku-ref{:href => "#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}
              it is sufficient to see that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              fibrant, then there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi R
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(L X , Y)/_\sim
                    \\simeq
                    Hom_{\mathcal{D}}(X, R Y)/_\sim
                    \\,.
            %p
              Since by the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction isomorphism
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
