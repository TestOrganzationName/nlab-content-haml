                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\alpha' \colon &amp; S^{n-1} &amp;\overset{(id,\delta_0)}{\longrightarrow}&amp; S^{n-1}\times I &amp;\overset{\tilde \eta}{\longrightarrow}&amp; X
                    \\\
                    \&amp; \downarrow^{\iota_n} &amp;&amp; \downarrow^{\mathrlap{(\iota_n,id)}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \&amp; D^n &amp;\overset{(id,\delta_0)}{\longrightarrow}&amp; D^n \times I &amp;\overset{\eta}{\longrightarrow}&amp; Y
                    \\\
                    \&amp; \downarrow &amp;&amp; &amp;&amp;  \downarrow
                    \\\
                    \&amp; \ast &amp;&amp; \overset{y}{\longrightarrow} &amp;&amp; Y
                    }
                    \\,.
            %p
              The commutativity of the outer square says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f_\ast \alpha'
              is constant, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              is entirely contained in the fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
