                                    %mo{:stretchy => "false"} (
                                    %mi F
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒟
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp; \mathcal{C}_c &amp;\hookrightarrow&amp; \mathcal{C} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}
                        \\\
                        \&amp;
                        {}^{\mathllap{\gamma}_{\mathcal{C}_f}}\downarrow
                        \&amp;&amp;
                        \\swArrow_{\simeq}
                        \&amp;&amp;
                        \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                        \\\
                        \\mathbb{L} F \colon &amp; \mathcal{C}_c[W^{-1}] &amp;\simeq&amp; Ho(\mathcal{C})
                        \&amp;\underset{Ho(F)}{\longrightarrow}&amp; Ho(\mathcal{D})
                        }
                        \\,,
                %p
                  where again we use corollary
                  = succeed "." do
                    %a.maruku-ref{:href => "#HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects"}
          %p
            The key fact that makes def.
            %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
            practically relevant is the following:
          #KenBrownLemma.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"}> Ken Brown's lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              with
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                    %mo ,
                    %msub
                      %mi 𝒞
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f, \mathcal{C}_c
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} of fibrant objects
              and
              %a.existingWikiWord{:href => "/nlab/show/cofibration+category"} of cofibrant objects
              respectively (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  out of the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝒞
                          %mi f
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
                        F \;\colon\; \mathcal{C}_f \longrightarrow \mathcal{D}
                %p
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
                  = succeed "," do
                    %a.maruku-ref{:href => "#HomotopicalFunctor"}
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  out of the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+cofibrant+objects"} category of cofibrant objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝒞
                          %mi c
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
                        F \;\colon\; \mathcal{C}_c \longrightarrow \mathcal{D}
                %p
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
                  = succeed "," do
                    %a.maruku-ref{:href => "#HomotopicalFunctor"}
          %p
            The following proof refers to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
            = succeed ")." do
              %a.maruku-ref{:href => "#FactorizationLemma"}
          .proof
            %h6#proof_22 Proof
            %p
              We discuss the case of a functor on a
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              = succeed "." do
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(X)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi Fib
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi p
                                    %mn 1
                                    %mo *
                                  %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Path(f) &amp;\underset{\in W \cap Fib}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{p_1^\ast f}}_{\mathllap{\in W}}\downarrow
                    \&amp;(pb)&amp;
                    \\downarrow^{\mathrlap{f}}_{\mathrlap{\in W}}
                    \\\
                    Path(Y) &amp;\overset{p_1}{\underset{\in W \cap Fib}{\longrightarrow}}&amp; Y
                    \\\
                    {}^{\mathllap{p_0}}_{\mathllap{\in W \cap Fib}}\downarrow
                    \\\
                    Y
                    }
                    \\,,
            %p
              where the square is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(f)
              on the top left is our notation for the universal
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              object. (Below we discuss this in more detail, it is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocone"} mapping cocone
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed ")." do
                %a.maruku-ref{:href => "#MappingConeAndMappingCocone"}
            %p Here:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi i
                      %annotation{:encoding => "application/x-tex"} p_i
                  are both acyclic fibrations, by lemma
                  = succeed ";" do
                    %a.maruku-ref{:href => "#ComponentMapsOfCylinderAndPathSpaceInGoodSituation"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Path
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Path(f) \to X
                  is an acyclic fibration because it is the pullback of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} p_1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi p
                          %mn 1
                          %mo *
                        %mi f
                      %annotation{:encoding => "application/x-tex"} p_1^\ast f
                  is a weak equivalence, because the
                  %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                  %a.maruku-ref{:href => "#FactorizationLemma"}
                  states that the composite vertical morphism factors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  through a weak equivalence, hence if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a weak equivalence, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi p
                          %mn 1
                          %mo *
                        %mi f
                      %annotation{:encoding => "application/x-tex"} p_1^\ast f
                  is by
                  %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
            %p
              Now apply the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to this diagram and use the assumption that it sends acyclic fibrations to weak equivalences to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mi p
                                    %mn 1
                                    %mo *
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi p
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi p
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(Path(f)) &amp;\underset{\in W }{\longrightarrow}&amp; F(X)
                    \\\
                    {}^{\mathllap{F(p_1^\ast f)}}_{\mathllap{}}\downarrow &amp;&amp; \downarrow^{\mathrlap{F(f)}}
                    \\\
                    F(Path(Y)) &amp;\overset{F(p_1)}{\underset{\in W }{\longrightarrow}}&amp; F(Y)
                    \\\
                    {}^{\mathllap{F(p_0)}}_{\mathllap{\in W}}\downarrow
                    \\\
                    Y
                    }
                    \\,.
            %p
              But the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FactorizationLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 0
                    %mo ∘
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} p_0 \circ p_1^\ast f
              is a fibration, hence an acyclic fibration by the above. Therefore also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 0
                    %mo ∘
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(p_0 \circ p_1^\ast f)
              is a weak equivalence. Now the claim that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(f)
              is a weak equivalence follows with applying
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
          #LeftAndRightDerivedFunctors.num_cor
            %h6#corollary_3 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D}
              be
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              and consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow \mathcal{D}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves cofibrant objects and acyclic cofibrations between these, then its
                  %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕃
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \mathbb{L}F
                  exists, fitting into a
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝒞
                                  %mi c
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi F
                              %mtd
                                %msub
                                  %mi 𝒟
                                  %mi c
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi 𝒞
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mo ≃
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi 𝒟
                            %mtr
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒞
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi 𝕃
                                    %mi F
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒟
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{C}_{c} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}_{c}
                        \\\
                        {}^{\mathllap{\gamma_{\mathcal{C}}}}\downarrow
                        \&amp;\swArrow_{\simeq}&amp;
                        \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                        \\\
                        Ho(\mathcal{C}) &amp;\overset{\mathbb{L}F}{\longrightarrow}&amp; Ho(\mathcal{D})
                        }
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
