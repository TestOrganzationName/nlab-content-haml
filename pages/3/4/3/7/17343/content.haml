                    \\,.
          .proof
            %h6#proof_55 Proof
            %p
              First consider the underlying diagram of functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi i
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} F_i^\circ
              where the topology on the
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              has been forgotten. Then one finds
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %msubsup
                      %mi F
                      %mi i
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi F
                      %mi i
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (\underset{\longleftarrow}{\lim}_i F^\circ_i)(c) \simeq \underset{\longleftarrow}{\lim}_i (F^\circ_i(c)) \;\;\in Set
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi i
                    %msubsup
                      %mi F
                      %mi i
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi F
                      %mi i
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (\underset{\longrightarrow}{\lim}_i F^\circ _i)(c) \simeq \underset{\longrightarrow}{\lim}_i (F^\circ_i(c)) \;\; \in Set
            %p
              by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of limits and colimits. (Given a morphism of diagrams then a unique compatible morphism between their limits or colimits, respectively, is induced as the universal factorization of the morphism of diagrams regarded as a cone or cocone, respectvely, over the codomain or domain diagram, respectively).
            %p
              Hence it only remains to see that equipped with topology, these limits and colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              become limits and colimits in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              %a.maruku-ref{:href => "#DescriptionOfLimitsAndColimitsInTop"}
