                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
