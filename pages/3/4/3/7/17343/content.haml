                %a.maruku-ref{:href => "#ModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↦
                      %mi Ω
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X\mapsto \Omega X
              %a.maruku-ref{:href => "#SuspensionAndLoopSpaceObject"}
              (which on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
