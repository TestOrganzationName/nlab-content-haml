            %p is a weak equivalence.
            %p
          .proof
            %h6#proof_28 Proof
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ConditionsForQuillenAdjunctionAreIndeedEquivalent"}
