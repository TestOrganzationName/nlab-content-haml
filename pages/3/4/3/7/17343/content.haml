          #ProjectiveModelStructureOnTopologicalFunctors.num_theorem
            %h6#theorem_5 Theorem
            %p
              The classes of morphisms in def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsInTheProjectiveModelStructureOnTopEnrichedFunctors"}
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
