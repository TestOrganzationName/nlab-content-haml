                    }{ (X \wedge Y)\times \{z\} \sqcup \{[x] = [y]\} \times Z}
                    \\\
                    \&amp; \simeq
                    \\frac{\frac{X \times Y \times Z}{X \times \{y\}\times Z \sqcup \{x\}\times Y \times Z}}{
                    X \times Y \times \{z\}
                    }
                    \\\
