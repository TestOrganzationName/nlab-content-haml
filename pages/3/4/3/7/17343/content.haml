                    \\,,
            %p
              which says that any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              comes from a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Q
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat f \colon X \to Q Y
              under postcomposition with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi Y
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mi Y
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Q Y \overset{p_Y}{\to} Y
            %p
              Second, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %msub
                      %mi p
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(id_X, p_Y)
              is injective is the lifting property in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
