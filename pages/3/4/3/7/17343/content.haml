              a chain in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo &lt;
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T,\lt)
              (a subset on which the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
              restricts to a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/total+order"} total order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              given by the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
