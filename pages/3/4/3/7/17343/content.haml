                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp; {}^{\mathllap{f}}\nearrow &amp; \uparrow^{\mathrlap{X^{\delta_0}}}
                    \\\
                    X &amp;\stackrel{\eta}{\longrightarrow}&amp; Y^I
                    \\\
                    \&amp; {}_{\mathllap{g}}\searrow &amp; \downarrow^{\mathrlap{Y^{\delta_1}}}
                    \\\
                    \&amp;&amp; Y
