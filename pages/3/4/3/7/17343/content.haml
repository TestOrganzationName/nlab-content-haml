                    Y
                    \\,.
          .proof
            %h6#proof_30 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I_{Top} = \{S^{n-1}\hookrightarrow D^n\}
              of topological
              = succeed "," do
