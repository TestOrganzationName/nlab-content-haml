              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              First, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
