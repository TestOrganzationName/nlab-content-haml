                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id_A \colon &amp; A &amp;\longrightarrow&amp; C &amp;\longrightarrow&amp; A
                    \\\
                    \&amp; \downarrow^{\mathrlap{j}} &amp;&amp; \downarrow^{\mathrlap{i}}_{\mathrlap{\in K Proj}} &amp;&amp; \downarrow^{\mathrlap{j}}
                    \\\
                    id_B \colon &amp; B &amp;\longrightarrow&amp; D &amp;\longrightarrow&amp; B
                    }
                    \\,.
            %p Then for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi j
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{j}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}_{\mathrlap{\in K}}
                    \\\
                    B &amp;\longrightarrow&amp; Y
                    }
            %p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite with that retract diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi C
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Proj
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi D
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; C &amp;\longrightarrow&amp; A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow^{\mathrlap{j}} &amp;&amp; \downarrow^{\mathrlap{i}}_{\mathrlap{\in K Proj}} &amp;&amp; \downarrow^{\mathrlap{j}} &amp;&amp; \downarrow^{\mathrlap{f}}_{\mathrlap{\in K}}
                    \\\
                    B &amp;\longrightarrow&amp; D &amp;\longrightarrow&amp; B &amp;\longrightarrow &amp; Y
                    }
                    \\,.
            %p Here the pasting composite of the two squares on the right has a lift, by assumption:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi C
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi D
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; C &amp;\longrightarrow&amp; A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow^{\mathrlap{j}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{i}}_{}
                    \&amp;&amp;
                    \\nearrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f}}_{\mathrlap{\in K}}
                    \\\
                    B &amp;\longrightarrow&amp; D &amp;\longrightarrow&amp; B &amp;\longrightarrow &amp; Y
                    }
                    \\,.
            %p
              By composition, this is also a lift in the total outer rectangle, hence in the original square. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              has the left lifting property against all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} p \in K
              and hence is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} K Proj
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
            %p
              %strong closure under pushout and pullback
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi K
                    %mi Inj
                  %annotation{:encoding => "application/x-tex"} p \in K Inj
              and and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                                  %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Z \times_f X &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{{f^* p}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Z &amp;\stackrel{f}{\longrightarrow} &amp; Y
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi p
                  %annotation{:encoding => "application/x-tex"} f^* p
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              with respect to all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} i \in K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                                    %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; Z \times_f X
                    \\\
                    {}^{\mathllap{i}}_{\mathllap{\in K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathrlap{f^* p}}}
                    \\\
                    B &amp;\stackrel{g}{\longrightarrow}&amp; Z
                    }
            %p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite with the pullback square from above to obtain the commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                                  %mi p
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; Z \times_f X &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{i}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f^* p}}
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    B &amp;\stackrel{g}{\longrightarrow}&amp; Z &amp;\stackrel{f}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              By the right lifting property of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mi g
                                  %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mi g
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow^{\mathrlap{i}} &amp;{}^{\hat {(f g)}}\nearrow&amp;  \downarrow^{\mathrlap{p}}
                    \\\
                    B &amp;\stackrel{f g}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              this gives rise to the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                                  %mi p
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Z \times_f X &amp;\longrightarrow&amp; X
                    \\\
                    \&amp;{}^{\hat g} \nearrow&amp; \downarrow^{\mathrlap{f^* p}}
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    B &amp;\stackrel{g}{\longrightarrow}&amp; Z &amp;\stackrel{f}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              In order for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              to qualify as the intended lift of the total diagram, it remains to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                            %mo ↗
                        %mtr
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; Z \times_f X
                    \\\
                    \\downarrow^{\mathrlap{i}} &amp; {}^{\hat g}\nearrow
                    \\\
                    B
                    }
            %p
              commutes. To do so we notice that we obtain two
              %a.existingWikiWord{:href => "/nlab/show/cones"} cones
              with tip
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %ul
              %li
                %p one is given by the morphisms
                %ol
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo →
                          %mi Z
                          %msub
                            %mo ×
                            %mi f
                          %mi X
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} A \to Z \times_f X \to X
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mover
                            %mo →
                            %mi i
                          %mi B
                          %mover
                            %mo →
                            %mi g
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{g}{\to} Z
                %p with universal morphism into the pullback being
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo →
                          %mi Z
                          %msub
                            %mo ×
                            %mi f
                          %mi X
                        %annotation{:encoding => "application/x-tex"} A \to Z \times_f X
              %li
                %p the other by
                %ol
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mover
                            %mo →
                            %mi i
                          %mi B
                          %mover
                            %mo →
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                          %mi Z
                          %msub
                            %mo ×
                            %mi f
                          %mi X
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{\hat g}{\to} Z \times_f X \to X
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi A
                          %mover
                            %mo →
                            %mi i
                          %mi B
                          %mover
                            %mo →
                            %mi g
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{g}{\to} Z
                    \.
                %p with universal morphism into the pullback being
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi A
                          %mover
                            %mo →
                            %mi i
                          %mi B
                          %mover
                            %mo →
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                          %mi Z
                          %msub
                            %mo ×
                            %mi f
                          %mi X
                        %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{\hat g}{\to} Z \times_f X
                    \.
            %p
              The commutativity of the diagrams that we have established so far shows that the first and second morphisms here equal each other, respectively. By the fact that the universal morphism into a pullback diagram is
              %em unique
              this implies the required identity of morphisms.
            %p
              The other case is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              %strong closure under (co-)products
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
