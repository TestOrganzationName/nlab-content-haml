                            %mo ⇒
                          %mtd
                            %msub
                              %mi Cof
                              %mi cl
                          %mtd
                            %mtext has LLP against
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi W
                              %mi cl
                            %mo ∩
                            %msub
                              %mi Fib
                              %mi cl
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi Cof
                                  %mi cl
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %msub
                              %mi Cof
                              %mi cl
                            %mo □
                            %msub
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} Cof
                              %mi cl
                          %mtd
                            %mtext has LLP against
                          %mtd
                            %msub
                              %mi W
                              %mi cl
                            %mo ∩
                            %msub
                              %mi Fib
                              %mi cl
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; I_{Top} \Box I_{Top} &amp; \text{has LLP against} &amp; W_{cl} \cap Fib_{cl}
                    \\\
                    \\Leftrightarrow
                    \&amp; I_{Top} &amp; \text{has LLP against} &amp; (W_{cl} \cap Fib_{cl})^{\Box I_{Top}}
                    \\\
                    \\Rightarrow
                    \&amp; Cof_{cl} &amp; \text{has LLP against} &amp; (W_{cl} \cap Fib_{cl})^{\Box I_{Top}}
                    \\\
                    \\Leftrightarrow
                    \&amp;
                    I_{Top} \Box Cof_{cl} &amp; \text{has LLP against} &amp; W_{cl} \cap Fib_{cl}
                    \\\
                    \\Leftrightarrow
                    \&amp;
                    I_{Top} &amp; \text{has LLP against} &amp; (W_{cl} \cap Fib_{cl})^{Cof_{cl}}
                    \\\
                    \\Rightarrow
                    \&amp; Cof_{cl} &amp; \text{has LLP against} &amp; (W_{cl} \cap Fib_{cl})^{Cof_{cl}}
                    \\\
                    \\Leftrightarrow
                    \&amp; Cof_{cl} \Box \Cof_{cl}  &amp; \text{has LLP against} &amp; W_{cl} \cap Fib_{cl}
                    }
                    \\,,
            %p
              where all logical equivalences used are those of prop.
              %a.maruku-ref{:href => "#JoyalTierneyCalculus"}
              and where all implications appearing are by the closure property of lifting problems, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
            %p
              Regarding the second point: By example
              %a.maruku-ref{:href => "#PushoutProductOfITopwithITopAndJTop"}
              we moreover have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                    %mo □
                    %msub
                      %mi J
                      %mi Top
                    %mo ⊂
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    I_{Top} \Box J_{Top} \subset J_{Top}
            %p and the conclusion follows by the same kind of reasoning.
          .num_remark
            %h6#remark_23 Remark
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              theory the property in proposition
              %a.maruku-ref{:href => "#PushoutProductInTopCGSendsCofCofToCof"}
              is referred to as saying that the model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
              from theorem
              %a.maruku-ref{:href => "#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}
            %ol
              %li
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
                  with respect to the
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Top
                            %mi cg
                        %annotation{:encoding => "application/x-tex"} Top_{cg}
              %li
                %p
                  is an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
          %p A key point of what this entails is the following:
          #HomProductAdjunctionForCofibrantObjectInTopCGIsQuillen.num_prop
            %h6#proposition_30 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} X \in (Top_{cg})_{Quillen}
              cofibrant (a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianClosureOfTopcg"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi X
                      %mover
                        %mo ⟵
                        %mrow
                          %mi X
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Top_{cg})_{Quillen}
                    \\underoverset
                    \\underset{(-)^X}{\longrightarrow}
                    \\overset{X \times (-)}{\longleftarrow}
                    {\bot}
                    (Top_{cg})_{Quillen}
                    \\,.
          .proof
            %h6#proof_53 Proof
            %p
              By example
              %a.maruku-ref{:href => "#PushoutProductWithInitialMorphism"}
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functor is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
              functor with the initial morphism of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo □
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \times (-)
                    \\simeq
                    (\emptyset \to X) \Box (-)
                    \\,.
            %p
              By assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\emptyset \to X)
              is a cofibration, and hence prop.
              %a.maruku-ref{:href => "#PushoutProductInTopCGSendsCofCofToCof"}
              says that this is a left Quillen functor.
          %p
            The statement and proof of prop.
            %a.maruku-ref{:href => "#HomProductAdjunctionForCofibrantObjectInTopCGIsQuillen"}
            has a direct analogue in
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
          #HomProductAdjunctionForCofibrantObjectInPointedTopCGIsQuillen.num_prop
            %h6#proposition_31 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} X \in (Top^{\ast/}_{cg})_{Quillen}
              cofibrant with respect to the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              (theorem
              = succeed "," do
                %a.maruku-ref{:href => "#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              with non-degenerate basepoint, remark
              = succeed ")" do
                %a.maruku-ref{:href => "#NonDegenerateBasepointAsCofibrantObjects"}
              %a.maruku-ref{:href => "#SmashHomAdjunctionOnPointedCompactlyGeneratedTopologicalSpaces"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi Maps
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %mi X
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Top^{\ast/}_{cg})_{Quillen}
                    \\underoverset
                    \\underset{Maps(X,-)_\ast}{\longrightarrow}
                    \\overset{X \wedge (-)}{\longleftarrow}
                    {\bot}
                    (Top^{\ast/}_{cg})_{Quillen}
                    \\,.
          .proof
            %h6#proof_54 Proof
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo □
                      %mo ∧
                  %annotation{:encoding => "application/x-tex"} \Box_\wedge
              denote the
              %strong smash pushout product
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo □
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)^{\Box(-)}
              the
              %strong smash pullback powering
              defined as in def.
              %a.maruku-ref{:href => "#PushoutProduct"}
              and def.
              = succeed "," do
                %a.maruku-ref{:href => "#PullbackPowering"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              replaced by
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              replaced by pointed mapping spaces (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PointedMappingSpace"}
            %p
              By theorem
              %a.maruku-ref{:href => "#CofibrantGenerationOfPointedTopologicalSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top_{cg}^{\ast/})_{Quillen}
              is
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} I_{Top^{\ast/}} = (I_{Top})_+
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi J
                        %mi Top
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                    %annotation{:encoding => "application/x-tex"} J_{Top^{\ast/}}= (J_{Top})_+
              %a.maruku-ref{:href => "#WedgeAndSmashOfBasePointAdjoinedTopologicalSpaces"}
              gives that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mo ∈
                    %msub
                      %mi I
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} i_n \in I_{Top}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi n
                    %mo ∈
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} j_n \in J_{Top}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %msub
                      %mo □
                      %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"}
                    (i_{n_1})_+ \Box_\wedge (i_{n_2})_+ \simeq (i_{n_1 + n_2})_+
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %msub
                      %mo ∧
                      %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (i_{n_1})_+ \wedge_\wedge (i_{n_2})_+ \simeq (i_{n_1 + n_2})_+
                    \\,.
            %p
              Hence the pointed analog of prop.
              %a.maruku-ref{:href => "#PushoutProductInTopCGSendsCofCofToCof"}
              holds and therefore so does the pointed analog of the conclusion in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#HomProductAdjunctionForCofibrantObjectInTopCGIsQuillen"}
          %h3#ModelStructureOnTopEnrichedFunctors Model structure on topological functors
          %p
            With classical topological homotopy theory in hand (theorem
            = succeed "," do
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            = succeed ")," do
              %a.maruku-ref{:href => "#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}
            = succeed "." do
              %em topological diagrams
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed ")." do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SequentialSpectraAsDiagramSpectra"} prop.
          %p
            Technically, “topological diagram” here means “
            %a.existingWikiWord{:href => "/nlab/show/Top"}> Top
            \-
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor"}> enriched functor
            ”. We now discuss what this means and then observe that as an immediate corollary of theorem
            %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            we obtain a model category structure on topological diagrams.
          %p
            As a by-product, we obtain the model category theory of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            in topological spaces, which will be useful.
          %p
            In the following we say
            %em
              %a.existingWikiWord{:href => "/nlab/show/Top"}> Top
              \-
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/Top"}> Top
              \-
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            etc. for what often is referred to as “
            %a.existingWikiWord{:href => "/nlab/show/topological+category"}> topological category
            ” and “
            %a.existingWikiWord{:href => "/nlab/show/topological+functor"}> topological functor
            ” etc. As discussed there, these latter terms are ambiguous.
          %p
            %strong Literature
            (
            %a.existingWikiWord{:href => "/nlab/show/Categorical+Homotopy+Theory"}> Riehl, chapter 3
            ) for basics of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            = succeed ")" do
              %a{:href => "classical+model+structure+on+topological+spaces#Piacenza91"} Piacenza 91
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+functors"} projective model structure on topological functors
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #TopEnrichedCategory.num_defn
            %h6#definition_52 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "," do
