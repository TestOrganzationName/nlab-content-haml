              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of squares, in the image of the
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \longrightarrow Ho(\mathcal{C})
              of a commuting square in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (i.e.: not just commuting up to homotopy).
          .proof
            %h6#proof_21 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
