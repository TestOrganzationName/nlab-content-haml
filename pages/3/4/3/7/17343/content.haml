                    \\frac{X\times Y \times Z}{X \times \{y\}\times Z \sqcup \{x\}\times Y \times Z \sqcup X \times Y \times \{z\}}
                    \\end{aligned}
                    \\,.
            %p
              The analogous reasoning applies to yield also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi Y
